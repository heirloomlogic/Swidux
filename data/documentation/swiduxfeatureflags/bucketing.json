{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiduxFeatureFlags\/documentation\/SwiduxFeatureFlags"]]},"topicSections":[{"identifiers":["doc:\/\/SwiduxFeatureFlags\/documentation\/SwiduxFeatureFlags\/Bucketing\/bucket(id:flagKey:)","doc:\/\/SwiduxFeatureFlags\/documentation\/SwiduxFeatureFlags\/Bucketing\/isInRollout(bucket:rollout:)","doc:\/\/SwiduxFeatureFlags\/documentation\/SwiduxFeatureFlags\/Bucketing\/variantIndex(bucket:weights:)"],"anchor":"Type-Methods","title":"Type Methods","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxfeatureflags\/bucketing"]}],"sections":[],"abstract":[{"text":"Pure functions for stable feature-flag bucketing.","type":"text"}],"kind":"symbol","metadata":{"modules":[{"name":"SwiduxFeatureFlags"}],"role":"symbol","externalID":"s:18SwiduxFeatureFlags9BucketingO","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Bucketing","kind":"identifier"}],"roleHeading":"Enumeration","symbolKind":"enum","navigatorTitle":[{"text":"Bucketing","kind":"identifier"}],"title":"Bucketing"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Bucketing","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"A bucket is the 32-bit FNV-1a hash of the UTF-8 bytes of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"id + \":\" + flagKey"},{"text":", passed through murmur3’s ","type":"text"},{"type":"codeVoice","code":"fmix32"},{"text":" finalizer and","type":"text"},{"text":" ","type":"text"},{"text":"taken modulo 10,000. Rollout and weight percentages cover 100 buckets per","type":"text"},{"text":" ","type":"text"},{"text":"point, so a 1% rollout is buckets ","type":"text"},{"type":"codeVoice","code":"0..<100"},{"text":". The same input always","type":"text"},{"text":" ","type":"text"},{"text":"produces the same bucket.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The finalizer keeps one ID’s buckets for different flags independent, so","type":"text"},{"text":" ","type":"text"},{"text":"two flags’ small cohorts overlap at the rate chance predicts. Without it,","type":"text"},{"text":" ","type":"text"},{"text":"the low bits of an FNV-1a hash depend only on the low bits of the input","type":"text"},{"text":" ","type":"text"},{"text":"bytes, and one flag’s bucket partly determines another’s.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This is not GrowthBook’s bucketing (different input layout, finalizer,","type":"text"},{"text":" ","type":"text"},{"text":"and string encoding), so buckets don’t carry over from GrowthBook.","type":"text"}]},{"style":"important","content":[{"inlineContent":[{"text":"Changing this function re-buckets every user and reshuffles","type":"text"},{"type":"text","text":" "},{"type":"text","text":"every running experiment, so it changes only in a major release."}],"type":"paragraph"}],"type":"aside","name":"Important"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiduxFeatureFlags\/documentation\/SwiduxFeatureFlags\/Bucketing","interfaceLanguage":"swift"},"references":{"doc://SwiduxFeatureFlags/documentation/SwiduxFeatureFlags":{"role":"collection","abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiduxFeatureFlags\/documentation\/SwiduxFeatureFlags","title":"SwiduxFeatureFlags","url":"\/documentation\/swiduxfeatureflags"},"doc://SwiduxFeatureFlags/documentation/SwiduxFeatureFlags/Bucketing/isInRollout(bucket:rollout:)":{"role":"symbol","abstract":[{"text":"Whether ","type":"text"},{"code":"bucket","type":"codeVoice"},{"text":" falls inside a ","type":"text"},{"code":"rollout","type":"codeVoice"},{"text":" percentage (0–100).","type":"text"}],"fragments":[{"kind":"keyw