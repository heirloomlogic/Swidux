xt"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"externalParam","text":"weights"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"]) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}],"title":"variantIndex(bucket:weights:)","kind":"symbol"},"doc://SwiduxFeatureFlags/documentation/SwiduxFeatureFlags/Bucketing/isInRollout(bucket:rollout:)":{"url":"\/documentation\/swiduxfeatureflags\/bucketing\/isinrollout(bucket:rollout:)","abstract":[{"type":"text","text":"Whether "},{"type":"codeVoice","code":"bucket"},{"type":"text","text":" falls inside a "},{"type":"codeVoice","code":"rollout"},{"type":"text","text":" percentage (0–100)."}],"role":"symbol","identifier":"doc:\/\/SwiduxFeatureFlags\/documentation\/SwiduxFeatureFlags\/Bucketing\/isInRollout(bucket:rollout:)","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isInRollout","kind":"identifier"},{"text":"(","kind":"text"},{"text":"bucket","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"rollout","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Si","text":"Int","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"title":"isInRollout(bucket:rollout:)","kind":"symbol"}}}