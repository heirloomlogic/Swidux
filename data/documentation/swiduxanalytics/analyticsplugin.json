{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin"},"abstract":[{"type":"text","text":"A Swidux plugin that observes the dispatch cycle and forwards events"},{"type":"text","text":" "},{"type":"text","text":"to a provider-agnostic "},{"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsService","isActive":true,"type":"reference"},{"type":"text","text":"."}],"hierarchy":{"paths":[["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics"]]},"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","doc:\/\/SwiduxAnalytics\/s8SendableP","doc:\/\/SwiduxAnalytics\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"metadata":{"navigatorTitle":[{"text":"AnalyticsPlugin","kind":"identifier"}],"roleHeading":"Class","externalID":"s:15SwiduxAnalytics0B6PluginC","symbolKind":"class","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnalyticsPlugin"}],"title":"AnalyticsPlugin","modules":[{"name":"SwiduxAnalytics"}],"role":"symbol"},"topicSections":[{"generated":true,"identifiers":["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/init(state:action:extractAction:service:mapper:identity:onConsentChange:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/afterReduce(state:action:)","doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush()","doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush(timeout:)","doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/reduce(state:action:)"],"anchor":"Instance-Methods","title":"Instance Methods"},{"generated":true,"identifiers":["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/Action","doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/State"],"anchor":"Type-Aliases","title":"Type Aliases"},{"generated":true,"identifiers":["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/SwiduxPlugin-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxanalytics\/analyticsplugin"]}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnalyticsPlugin"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"RootState"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"RootAction"},{"kind":"text","text":">"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two surfaces:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Mapper"}]},{"type":"text","text":" (passive): a "},{"type":"codeVoice","code":"(State, Action) -> [AnalyticsEvent]"},{"type":"text","text":" closure run"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action. Apps declare it once."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"AnalyticsAction"}]},{"type":"text","text":" (explicit): screen views, identify\/alias\/reset,"},{"type":"text","text":" "},{"type":"text","text":"ad-hoc tracks, opt-out toggling."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plus auto-identify via an optional "},{"type":"reference","identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsIdentity","isActive":true},{"type":"text","text":": the plugin"},{"type":"text","text":" "},{"type":"text","text":"re-evaluates "},{"code":"userID","type":"codeVoice"},{"type":"text","text":" and "},{"code":"userProperties","type":"codeVoice"},{"type":"text","text":" each non-analytics dispatch"},{"type":"text","text":" "},{"type":"text","text":"and fires "},{"code":"service.identify","type":"codeVoice"},{"type":"text","text":" whenever either side changes;"},{"type":"text","text":" "},{"code":"service.reset","type":"codeVoice"},{"type":"text","text":" fires on "},{"code":"userID → nil","type":"codeVoice"},{"type":"text","text":". An explicit"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsAction\/identify(userID:properties:)","isActive":true},{"type":"text","text":" naming a different user"},{"type":"text","text":" "},{"type":"text","text":"than the identity overrides it until the identity’s "},{"code":"userID","type":"codeVoice"},{"type":"text","text":" changes."}]},{"level":2,"anchor":"Queueing","type":"heading","text":"Queueing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch never waits for the service. Each service call joins a queue that"},{"type":"text","text":" "},{"type":"text","text":"one worker task drains off the main actor, one call at a time, in dispatch"},{"type":"text","text":" "},{"type":"text","text":"order; "},{"type":"reference","identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush()","isActive":true},{"type":"text","text":" waits for the queue. At most 1,000 "},{"code":"track","type":"codeVoice"},{"type":"text","text":" calls"},{"type":"text","text":" "},{"type":"text","text":"(explicit, screen-view, and mapped) wait at once — past that the oldest"},{"type":"text","text":" "},{"type":"text","text":"queued track is dropped, and nothing reports the drop. "},{"code":"identify","type":"codeVoice"},{"type":"text","text":", "},{"code":"alias","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"reset","type":"codeVoice"},{"type":"text","text":" are never dropped."}]},{"level":2,"anchor":"Consent","type":"heading","text":"Consent"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Opting out gates events "},{"type":"emphasis","inlineContent":[{"text":"plugin-side","type":"text"}]},{"type":"text","text":" — every dispatch path returns early,"},{"type":"text","text":" "},{"type":"text","text":"so nothing reaches the service — and removes every call still in the queue"},{"type":"text","text":" "},{"type":"text","text":"that needs consent (track, screen view, identify, alias) as the action"},{"type":"text","text":" "},{"type":"text","text":"reduces, releasing their payloads at once. A queued "},{"code":"reset","type":"codeVoice"},{"type":"text","text":" stays. A call"},{"type":"text","text":" "},{"type":"text","text":"already taken off the queue, running or about to run, is not removed and"},{"type":"text","text":" "},{"type":"text","text":"may still reach the service after the opt-out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That alone does not engage a vendor SDK’s own consent switch, which matters"},{"type":"text","text":" "},{"type":"text","text":"when the SDK tracks automatic events or still holds a queue of its own."},{"type":"text","text":" "},{"type":"text","text":"Supply "},{"code":"onConsentChange","type":"codeVoice"},{"type":"text","text":" to bridge the two:"}]},{"syntax":"swift","type":"codeListing","code":["AnalyticsPlugin(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { a } else { nil } },","    service: mixpanel,","    onConsentChange: { optedOut in","        if optedOut {","            await mixpanel.optOutTracking()","        } else {","            await mixpanel.optInTracking()","        }","    }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Seed "},{"type":"reference","identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsState\/isOptedOut","isActive":true},{"text":" from the app’s persisted consent before","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"creating the store, then dispatch that value once at launch. This applies"},{"type":"text","text":" "},{"type":"text","text":"the same initial value to a vendor SDK that has its own consent state."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsService","isActive":true,"type":"reference"},{"type":"text","text":" stays at five members: consent APIs vary too much"},{"type":"text","text":" "},{"type":"text","text":"between vendors to abstract, and only the app knows which it is using."}]}],"kind":"content"}],"kind":"symbol","references":{"doc://SwiduxAnalytics/documentation/SwiduxAnalytics":{"abstract":[],"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics","title":"SwiduxAnalytics","url":"\/documentation\/swiduxanalytics","kind":"symbol","role":"collection","type":"topic"},"doc://SwiduxAnalytics/documentation/SwiduxAnalytics/AnalyticsAction":{"kind":"symbol","url":"\/documentation\/swiduxanalytics\/analyticsaction","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnalyticsAction","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"AnalyticsAction","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsAction","title":"AnalyticsAction","abstract":[{"type":"text","text":"Explicit analytics actions for cases the passive mapper can’t cover."}]},"doc://SwiduxAnalytics/documentation/SwiduxAnalytics/AnalyticsPlugin/afterReduce(state:action:)":{"kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"afterReduce"},{"kind":"text","text":"("},{"kind":"externalParam","text":"state"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"RootState"},{"kind":"text","text":", "},{"kind":"externalParam","text":"action"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"RootAction"},{"kind":"text","text":")"}],"abstract":[{"type":"text","text":"Runs auto-identify and the mapper for every non-analytics action."},{"type":"text","text":" "},{"type":"text","text":"Skipped entirely when the action is an "},{"isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsAction","type":"reference"},{"text":" (those are","type":"text"},{"type":"text","text":" "},{"type":"text","text":"handled by "},{"code":"reduce","type":"codeVoice"},{"text":") or when the user is opted out.","type":"text"}],"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/afterReduce(state:action:)","url":"\/documentation\/swiduxanalytics\/analyticsplugin\/afterreduce(state:action:)","type":"topic","title":"afterReduce(state:action:)"},"doc://SwiduxAnalytics/documentation/SwiduxAnalytics/AnalyticsIdentity":{"navigatorTitle":[{"text":"AnalyticsIdentity","kind":"identifier"}],"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsIdentity","abstract":[{"text":"Declarative source-of-truth for the active user’s identity.","type":"text"}],"url":"\/documentation\/swiduxanalytics\/analyticsidentity","title":"AnalyticsIdentity","kind":"symbol","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnalyticsIdentity","kind":"identifier"}],"type":"topic"},"doc://SwiduxAn