{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxanalytics\/analyticsplugin"]}],"identifier":{"url":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin","interfaceLanguage":"swift"},"metadata":{"externalID":"s:15SwiduxAnalytics0B6PluginC","role":"symbol","roleHeading":"Class","title":"AnalyticsPlugin","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnalyticsPlugin"}],"symbolKind":"class","navigatorTitle":[{"text":"AnalyticsPlugin","kind":"identifier"}],"modules":[{"name":"SwiduxAnalytics"}]},"abstract":[{"text":"A Swidux plugin that observes the dispatch cycle and forwards events","type":"text"},{"text":" ","type":"text"},{"text":"to a provider-agnostic ","type":"text"},{"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsService","type":"reference","isActive":true},{"text":".","type":"text"}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","doc:\/\/SwiduxAnalytics\/s8SendableP","doc:\/\/SwiduxAnalytics\/s16SendableMetatypeP"],"type":"conformsTo"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnalyticsPlugin","kind":"identifier"},{"text":"<","kind":"text"},{"text":"RootState","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"RootAction","kind":"genericParameter"},{"kind":"text","text":">"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Two surfaces:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Mapper"}],"type":"strong"},{"text":" (passive): a ","type":"text"},{"code":"(State, Action) -> [AnalyticsEvent]","type":"codeVoice"},{"text":" closure run","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action. Apps declare it once.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"AnalyticsAction"}],"type":"strong"},{"text":" (explicit): screen views, identify\/alias\/reset,","type":"text"},{"text":" ","type":"text"},{"text":"ad-hoc tracks, opt-out toggling.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Plus auto-identify via an optional "},{"type":"reference","identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsIdentity","isActive":true},{"type":"text","text":": the plugin"},{"type":"text","text":" "},{"type":"text","text":"re-evaluates "},{"type":"codeVoice","code":"userID"},{"type":"text","text":" and "},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" each non-analytics dispatch"},{"type":"text","text":" "},{"type":"text","text":"and fires "},{"type":"codeVoice","code":"service.identify"},{"type":"text","text":" whenever either side changes;"},{"type":"text","text":" "},{"type":"codeVoice","code":"service.reset"},{"type":"text","text":" fires on "},{"type":"codeVoice","code":"userID → nil"},{"type":"text","text":". An explicit"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsAction\/identify(userID:properties:)","isActive":true},{"type":"text","text":" naming a different user"},{"type":"text","text":" "},{"type":"text","text":"than the identity overrides it until the identity’s "},{"type":"codeVoice","code":"userID"},{"type":"text","text":" changes."}],"type":"paragraph"},{"text":"Queueing","type":"heading","anchor":"Queueing","level":2},{"inlineContent":[{"type":"text","text":"Dispatch never waits for the service. Each service call joins a queue that"},{"type":"text","text":" "},{"type":"text","text":"one worker task drains off the main actor, one call at a time, in dispatch"},{"type":"text","text":" "},{"type":"text","text":"order; "},{"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush()","type":"reference","isActive":true},{"type":"text","text":" waits for the queue. At most 1,000 "},{"type":"codeVoice","code":"track"},{"type":"text","text":" calls"},{"type":"text","text":" "},{"type":"text","text":"(explicit, screen-view, and mapped) wait at once — past that the oldest"},{"type":"text","text":" "},{"type":"text","text":"queued track is dropped, and nothing reports the drop. "},{"type":"codeVoice","code":"identify"},{"type":"text","text":", "},{"code":"alias","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" are never dropped.","type":"text"}],"type":"paragraph"},{"text":"Consent","type":"heading","anchor":"Consent","level":2},{"inlineContent":[{"text":"Opting out gates events ","type":"text"},{"inlineContent":[{"type":"text","text":"plugin-side"}],"type":"emphasis"},{"text":" — every dispatch path returns early,","type":"text"},{"text":" ","type":"text"},{"text":"so nothing reaches the service — and removes every call still in the queue","type":"text"},{"text":" ","type":"text"},{"text":"that needs consent (track, screen view, identify, alias) as the action","type":"text"},{"text":" ","type":"text"},{"text":"reduces, releasing their payloads at once. A queued ","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" stays. A call","type":"text"},{"text":" ","type":"text"},{"text":"already taken off the queue, running or about to run, is not removed and","type":"text"},{"text":" ","type":"text"},{"text":"may still reach the service after the opt-out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That alone does not engage a vendor SDK’s own consent switch, which matters"},{"type":"text","text":" "},{"type":"text","text":"when the SDK tracks automatic events or still holds a queue of its own."},{"type":"text","text":" "},{"type":"text","text":"Supply "},{"code":"onConsentChange","type":"codeVoice"},{"type":"text","text":" to bridge the two:"}],"type":"paragraph"},{"type":"codeListing","code":["AnalyticsPlugin(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { a } else { nil } },","    service: mixpanel,","    onConsentChange: { optedOut in","        if optedOut {","            await mixpanel.optOutTracking()","        } else {","            await mixpanel.optInTracking()","        }","    }",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Seed ","type":"text"},{"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsState\/isOptedOut","isActive":true,"type":"reference"},{"text":" from the app’s persisted consent before","type":"text"},{"type":"text","text":" "},{"type":"text","text":"creating the store, then dispatch that value once at launch. This applies"},{"type":"text","text":" "},{"type":"text","text":"the same initial value to a vendor SDK that has its own consent state."}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsService"},{"type":"text","text":" stays at five members: consent APIs vary too much"},{"type":"text","text":" "},{"type":"text","text":"between vendors to abstract, and only the app knows which it is using."}]}]}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/init(state:action:extractAction:service:map