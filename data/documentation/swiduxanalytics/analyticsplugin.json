text":" "},{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnalyticsPlugin"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"RootState"},{"kind":"text","text":", "},{"kind":"genericParameter","text":"RootAction"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"Two surfaces:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Mapper","type":"text"}],"type":"strong"},{"type":"text","text":" (passive): a "},{"type":"codeVoice","code":"(State, Action) -> [AnalyticsEvent]"},{"type":"text","text":" closure run"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action. Apps declare it once."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"AnalyticsAction"}],"type":"strong"},{"type":"text","text":" (explicit): screen views, identify\/alias\/reset,"},{"type":"text","text":" "},{"type":"text","text":"ad-hoc tracks, opt-out toggling."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Plus auto-identify via an optional ","type":"text"},{"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsIdentity","isActive":true,"type":"reference"},{"text":": the plugin","type":"text"},{"text":" ","type":"text"},{"text":"re-evaluates ","type":"text"},{"code":"userID","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"userProperties","type":"codeVoice"},{"text":" each non-analytics dispatch","type":"text"},{"text":" ","type":"text"},{"text":"and fires ","type":"text"},{"code":"service.identify","type":"codeVoice"},{"text":" whenever either side changes;","type":"text"},{"text":" ","type":"text"},{"code":"service.reset","type":"codeVoice"},{"text":" fires on ","type":"text"},{"code":"userID → nil","type":"codeVoice"},{"text":". An explicit","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsAction\/identify(userID:properties:)","isActive":true,"type":"reference"},{"text":" naming a different user","type":"text"},{"text":" ","type":"text"},{"text":"than the identity overrides it until the identity’s ","type":"text"},{"code":"userID","type":"codeVoice"},{"text":" changes.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Queueing","type":"heading","text":"Queueing"},{"inlineContent":[{"text":"Dispatch never waits for the service. Each service call joins a queue that","type":"text"},{"text":" ","type":"text"},{"text":"one worker task drains off the main actor, one call at a time, in dispatch","type":"text"},{"text":" ","type":"text"},{"text":"order; ","type":"text"},{"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush()","isActive":true,"type":"reference"},{"text":" waits for the queue. At most 1,000 ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" calls","type":"text"},{"text":" ","type":"text"},{"text":"(explicit, screen-view, and mapped) wait at once — past that the oldest","type":"text"},{"text":" ","type":"text"},{"text":"queued track is dropped, and nothing reports the drop. ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":", ","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" are never dropped.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Consent","type":"heading","text":"Consent"},{"inlineContent":[{"text":"Opting out gates events ","type":"text"},{"inlineContent":[{"text":"plugin-side","type":"text"}],"type":"emphasis"},{"text":" — every dispatch path returns early,","type":"text"},{"text":" ","type":"text"},{"text":"so nothing reaches the service — and removes every call still in the queue","type":"text"},{"text":" ","type":"text"},{"text":"that needs consent (track, screen view, identify, alias) as the action","type":"text"},{"text":" ","type":"text"},{"text":"reduces, releasing their payloads at once. A queued ","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" stays. A call","type":"text"},{"text":" ","type":"text"},{"text":"already taken off the queue, running or about to run, is not removed and","type":"text"},{"text":" ","type":"text"},{"text":"may still reach the service after the opt-out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"That alone does not engage a vendor SDK’s own consent switch, which matters","type":"text"},{"text":" ","type":"text"},{"text":"when the SDK tracks automatic events or still holds a queue of its own.","type":"text"},{"text":" ","type":"text"},{"text":"Supply ","type":"text"},{"code":"onConsentChange","type":"codeVoice"},{"text":" to bridge the two:","type":"text"}],"type":"paragraph"},{"code":["AnalyticsPlugin(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { a } else { nil } },","    service: mixpanel,","    onConsentChange: { optedOut in","        if optedOut {","            await mixpanel.optOutTracking()","        } else {","            await mixpanel.optInTracking()","        }","    }",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Seed ","type":"text"},{"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsState\/isOptedOut","isActive":true,"type":"reference"},{"text":" from the app’s persisted consent before","type":"text"},{"text":" ","type":"text"},{"text":"creating the store, then dispatch that value once at launch. This applies","type":"text"},{"text":" ","type":"text"},{"text":"the same initial value to a vendor SDK that has its own consent state.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsService","isActive":true,"type":"reference"},{"text":" stays at five members: consent APIs vary too much","type":"text"},{"text":" ","type":"text"},{"text":"between vendors to abstract, and only the app knows which it is using.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"A Swidux plugin that observes the dispatch cycle and forwards events","type":"text"},{"text":" ","type":"text"},{"text":"to a provider-agnostic ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsService"},{"text":".","type":"text"}],"kind":"symbol","identifier":{"url":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin","interfaceLanguage":"swift"},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","doc:\/\/SwiduxAnalytics\/s8SendableP","doc:\/\/SwiduxAnalytics\/s16SendableMetatypeP"],"type":"conformsTo"}],"references":{"doc://SwiduxAnalytics/documentation/SwiduxAnalytics/AnalyticsAction":{"kind":"symbol","navigatorTitle":[{"text":"AnalyticsAction","kind":"identifier"}],"title":"AnalyticsAction","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnalyticsAction","kind":"identifier"}],"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsAction","url":"\/documentation\/swiduxanalytics\/analyticsaction","abstract":[{"text":"Explicit analytics actions for cases the passive mapper can’t cover.","type":"text"}],"role":"symbol","type":"topic"},"doc://SwiduxAnalytics/documentation/SwiduxAnalytics/AnalyticsPlugin/flush(timeout:)":{"role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"flush","kind":"identifier"},{"text":"(","kind":"text"},{"text":"timeout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"title":"flush(timeout:)","abstract":[{"text":"As ","type":"text"},{"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush()","isActive":true,"type":"reference"},{"text":", but gives up once ","type":"text"},{"type":"codeVoice","code":"timeout"},{"text":" elapses. Work still in","type":"text"},{"text":" ","type":"text"},{"text":"flight when it fires continues in the background — nothing is","type":"text"},{"text":" ","type":"text"},{"text":"cancelled, the wait just stops blocking the caller. Recommended for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"applicationWillTerminate"},{"text":", where an unbounded wait risks the watchdog.","type":"text"}],"url":"\/documentation\/swiduxanalytics\/analyticsplugin\/flush(timeout:)","identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush(timeout:)","kind":"symbol"},"doc://SwiduxAnalytics/documentation/SwiduxAnalytics/AnalyticsState/isOptedOut":{"role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isOptedOut"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"title":"isOptedOut","abstract":[{"type":"codeVoice","code":"true"},{"text":" when the user has opted out of analytics. Mapper events are","type":"text"},{"text":" ","type":"text"},{"text":"dropped, explicit ","type":"text"},{"type":"codeVoice","code":"track"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"identify"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"alias"},{"text":" actions become no-ops,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and auto-identify is paused while opted out."}],"url":