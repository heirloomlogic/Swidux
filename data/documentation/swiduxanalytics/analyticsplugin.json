{"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics"]]},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/init(state:action:extractAction:service:mapper:identity:onConsentChange:)"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/afterReduce(state:action:)","doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush()","doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush(timeout:)","doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/reduce(state:action:)"],"generated":true},{"anchor":"Type-Aliases","title":"Type Aliases","identifiers":["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/Action","doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/State"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/SwiduxPlugin-Implementations"],"generated":true}],"metadata":{"roleHeading":"Class","title":"AnalyticsPlugin","externalID":"s:15SwiduxAnalytics0B6PluginC","modules":[{"name":"SwiduxAnalytics"}],"symbolKind":"class","navigatorTitle":[{"kind":"identifier","text":"AnalyticsPlugin"}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"AnalyticsPlugin","kind":"identifier"}]},"kind":"symbol","abstract":[{"text":"A Swidux plugin that observes the dispatch cycle and forwards events","type":"text"},{"text":" ","type":"text"},{"text":"to a provider-agnostic ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsService","type":"reference"},{"text":".","type":"text"}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","doc:\/\/SwiduxAnalytics\/s8SendableP","doc:\/\/SwiduxAnalytics\/s16SendableMetatypeP"],"type":"conformsTo"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"text":" ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"AnalyticsPlugin","kind":"identifier"},{"text":"<","kind":"text"},{"text":"RootState","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"RootAction","kind":"genericParameter"},{"text":">","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two surfaces:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Mapper","type":"text"}]},{"type":"text","text":" (passive): a "},{"type":"codeVoice","code":"(State, Action) -> [AnalyticsEvent]"},{"type":"text","text":" closure run"},{"type":"text","text":" "},{"type":"text","text":"in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action. Apps declare it once."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"AnalyticsAction","type":"codeVoice"}]},{"type":"text","text":" (explicit): screen views, identify\/alias\/reset,"},{"type":"text","text":" "},{"type":"text","text":"ad-hoc tracks, opt-out toggling."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plus auto-identify via an optional "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsIdentity"},{"type":"text","text":": the plugin"},{"type":"text","text":" "},{"type":"text","text":"re-evaluates "},{"type":"codeVoice","code":"userID"},{"type":"text","text":" and "},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" each non-analytics dispatch"},{"type":"text","text":" "},{"type":"text","text":"and fires "},{"type":"codeVoice","code":"service.identify"},{"type":"text","text":" whenever either side changes;"},{"type":"text","text":" "},{"type":"codeVoice","code":"service.reset"},{"type":"text","text":" fires on "},{"type":"codeVoice","code":"userID → nil"},{"type":"text","text":". An explicit"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsAction\/identify(userID:properties:)"},{"type":"text","text":" naming a different user"},{"type":"text","text":" "},{"type":"text","text":"than the identity overrides it until the identity’s "},{"type":"codeVoice","code":"userID"},{"type":"text","text":" changes."}]},{"type":"heading","level":2,"anchor":"Queueing","text":"Queueing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch never waits for the service. Each service call joins a queue that"},{"type":"text","text":" "},{"type":"text","text":"one worker task drains off the main actor, one call at a time, in dispatch"},{"type":"text","text":" "},{"type":"text","text":"order; "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush()"},{"type":"text","text":" waits for the queue. At most 1,000 "},{"type":"codeVoice","code":"track"},{"type":"text","text":" calls"},{"type":"text","text":" "},{"type":"text","text":"(explicit, screen-view, and mapped) wait at once — past that the oldest"},{"type":"text","text":" "},{"type":"text","text":"queued track is dropped, and nothing reports the drop. "},{"type":"codeVoice","code":"identify"},{"type":"text","text":", "},{"type":"codeVoice","code":"alias"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"reset"},{"type":"text","text":" are never dropped."}]},{"type":"heading","level":2,"anchor":"Consent","text":"Consent"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Opting out gates events "},{"type":"emphasis","inlineContent":[{"text":"plugin-side","type":"text"}]},{"type":"text","text":" — every dispatch path returns early,"},{"type":"text","text":" "},{"type":"text","text":"so nothing reaches the service — and removes every call still in the queue"},{"type":"text","text":" "},{"type":"text","text":"that needs consent (track, screen view, identify, alias) as the action"},{"type":"text","text":" "},{"type":"text","text":"reduces, releasing their payloads at once. A queued "},{"type":"codeVoice","code":"reset"},{"type":"text","text":" stays. A call"},{"type":"text","text":" "},{"type":"text","text":"already taken off the queue, running or about to run, is not removed and"},{"type":"text","text":" "},{"type":"text","text":"may still reach the service after the opt-out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That alone does not engage a vendor SDK’s own consent switch, which matters"},{"type":"text","text":" "},{"type":"text","text":"when the SDK tracks automatic events or still holds a queue of its own."},{"type":"text","text":" "},{"type":"text","text":"Supply "},{"type":"codeVoice","code":"onConsentChange"},{"type":"text","text":" to bridge the two:"}]},{"type":"codeListing","code":["AnalyticsPlugin(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { a } else { nil } },","    service: mixpanel,","    onConsentChange: { optedOut in","        if optedOut {","            await mixpanel.optOutTracking()","        } else {","            await mixpanel.optInTracking()","        }","    }",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Seed "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsState\/isOptedOut"},{"type":"text","text":" from the app’s persisted consent before"},{"type":"text","text":" "},{"type":"text","text":"creating the store, then dispatch that value once at launch. This applies"},{"type":"text","text":" "},{"type":"text","text":"the same initial value to a vendor SDK that has its own consent state."}]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsService"},{"type":"text","text":" stays at five members: consent APIs vary too much"},{"type":"text","text":" "},{"type":"text","text":"between vendors to abstract, and only the app knows which it is using."}]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/swiduxanalytics\/analyticsplugin"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiduxAnalytics/documentation/SwiduxAnalytics":{"abstract":[],"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics","role":"collection","url":"\/documentation\/swiduxanalytics","title":"SwiduxAnalytics"},"doc://SwiduxAnalytics/s8SendableP":{"identifier":"doc:\/\/SwiduxAnalytics\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://SwiduxAnalytics/documentation/SwiduxAnalytics/AnalyticsService":{"url":"\/documentation\/swiduxanalytics\/analyticsservice","abstract":[{"text":"Provider-agnostic analytics backend.","type":"text"}],"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsService","role":"symbol","kind":"symbol","title":"AnalyticsService","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnalyticsService","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"AnalyticsService","kind":"identifier"}]},"doc://SwiduxAnalytics/documentation/SwiduxAnalytics/AnalyticsPlugin/flush(timeout:)":{"title":"flush(timeout:)","abstract":[{"type":"text","text":"As "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush()"},{"type":"text","text":", but gives up once "},{"type":"codeVoice","code":"timeout"},{"type":"text","text":" elapses. Work still in"},{"type":"text","text":" "},{"type":"text","text":"flight when it fires continues in the background — nothing is"},{"type":"text","text":" "},{"type":"text","text":"cancelled, the wait just stops blocking the caller. Recommended for"},{"type":"text","text":" "},{"type":"codeVoice","code":"applicationWillTerminate"},{"type":"text","text":", where an unbounded wait risks the watchdog."}],"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush(timeout:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"flush","kind":"identifier"},{"text":"(","kind":"text"},{"text":"timeout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"url":"\/documentation\/swiduxanalytics\/analyticsplugin\/flush(timeout:)"},"doc://SwiduxAnalytics/documentation/SwiduxAnalytics/AnalyticsPlugin":{"url":"\/documentation\/swiduxanalytics\/analyticsplugin","abstract":[{"text":"A Swidux plugin that observes the dispatch cycle and forwards events","type":"text"},{"text":" ","type":"text"},{"text":"to a provider-agnostic ","type":"text"},{"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsService","type":"reference","isActive":true},{"text":".","type":"text"}],"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin","role":"symbol","kind":"symbol","title":"AnalyticsPlugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnalyticsPlugin","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"AnalyticsPlugin","kind":"identifier"}]},"doc://SwiduxAnalytics/documentation/SwiduxAnalytics/AnalyticsPlugin/reduce(state:action:)":{"title":"reduce(state:action:)","abstract":[{"type":"text","text":"Routes "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsAction"},{"type":"text","text":" cases and queues their service calls."},{"type":"text","text":" "},{"type":"text","text":"Always returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":": the calls run on the plugin’s worker, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush()"},{"type":"text","text":" is the way to wait for them. Non-analytics actions are"},{"type":"text","text":" "},{"type":"text","text":"left to "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" (mapper and auto-identify)."}],"kind":"symbol","role":"symbol","type":"topic","identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/reduce(state:action:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reduce","kind":"identifier"},{"text":"(","kind":"text"},{"text":"state","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RootState","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"action","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"RootAction","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Effect","preciseIdentifier":"s:6Swidux6EffectV","kind":"typeIdentifier"},{"text":"<","kind":"te