iseIdentifier":"s:6Swidux6EffectV","text":"Effect","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"RootAction","kind":"typeIdentifier"},{"text":">?","kind":"text"}]},"doc://SwiduxAnalytics/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/SwiduxAnalytics\/s8SendableP"},"doc://SwiduxAnalytics/documentation/SwiduxAnalytics/AnalyticsPlugin/flush(timeout:)":{"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush(timeout:)","url":"\/documentation\/swiduxanalytics\/analyticsplugin\/flush(timeout:)","role":"symbol","type":"topic","abstract":[{"type":"text","text":"As "},{"isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush()","type":"reference"},{"type":"text","text":", but gives up once "},{"type":"codeVoice","code":"timeout"},{"type":"text","text":" elapses. Work still in"},{"type":"text","text":" "},{"type":"text","text":"flight when it fires continues in the background — nothing is"},{"type":"text","text":" "},{"type":"text","text":"cancelled, the wait just stops blocking the caller. Recommended for"},{"type":"text","text":" "},{"type":"codeVoice","code":"applicationWillTerminate"},{"type":"text","text":", where an unbounded wait risks the watchdog."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"flush"},{"kind":"text","text":"("},{"kind":"externalParam","text":"timeout"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}],"title":"flush(timeout:)","kind":"symbol"},"doc://SwiduxAnalytics/documentation/SwiduxAnalytics/AnalyticsState/isOptedOut":{"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsState\/isOptedOut","abstract":[{"type":"codeVoice","code":"true"},{"type":"text","text":" when the user has opted out of analytics. Mapper events are"},{"type":"text","text":" "},{"type":"text","text":"dropped, explicit "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":" actions become no-ops,"},{"type":"text","text":" "},{"type":"text","text":"and auto-identify is paused while opted out."}],"role":"symbol","title":"isOptedOut","type":"topic","url":"\/documentation\/swiduxanalytics\/analyticsstate\/isoptedout","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isOptedOut","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"kind":"symbol"}}}