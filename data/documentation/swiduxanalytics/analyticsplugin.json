{"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","doc:\/\/SwiduxAnalytics\/s8SendableP","doc:\/\/SwiduxAnalytics\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"AnalyticsPlugin"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"RootState"},{"kind":"text","text":", "},{"text":"RootAction","kind":"genericParameter"},{"kind":"text","text":">"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two surfaces:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Mapper"}],"type":"strong"},{"text":" (passive): a ","type":"text"},{"code":"(State, Action) -> [AnalyticsEvent]","type":"codeVoice"},{"text":" closure run","type":"text"},{"text":" ","type":"text"},{"text":"in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action. Apps declare it once.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"AnalyticsAction"}],"type":"strong"},{"text":" (explicit): screen views, identify\/alias\/reset,","type":"text"},{"text":" ","type":"text"},{"text":"ad-hoc tracks, opt-out toggling.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plus auto-identify via an optional "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsIdentity"},{"type":"text","text":": the plugin"},{"type":"text","text":" "},{"type":"text","text":"re-evaluates "},{"code":"userID","type":"codeVoice"},{"type":"text","text":" and "},{"code":"userProperties","type":"codeVoice"},{"type":"text","text":" each non-analytics dispatch"},{"type":"text","text":" "},{"type":"text","text":"and fires "},{"code":"service.identify","type":"codeVoice"},{"type":"text","text":" whenever either side changes;"},{"type":"text","text":" "},{"code":"service.reset","type":"codeVoice"},{"type":"text","text":" fires on "},{"code":"userID → nil","type":"codeVoice"},{"type":"text","text":". An explicit"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsAction\/identify(userID:properties:)"},{"type":"text","text":" naming a different user"},{"type":"text","text":" "},{"type":"text","text":"than the identity overrides it until the identity’s "},{"code":"userID","type":"codeVoice"},{"type":"text","text":" changes."}]},{"type":"heading","level":2,"text":"Queueing","anchor":"Queueing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch never waits for the service. Each service call joins a queue that"},{"type":"text","text":" "},{"type":"text","text":"one worker task drains off the main actor, one call at a time, in dispatch"},{"type":"text","text":" "},{"type":"text","text":"order; "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush()"},{"type":"text","text":" waits for the queue. At most 1,000 "},{"code":"track","type":"codeVoice"},{"type":"text","text":" calls"},{"type":"text","text":" "},{"type":"text","text":"(explicit, screen-view, and mapped) wait at once — past that the oldest"},{"type":"text","text":" "},{"type":"text","text":"queued track is dropped, and nothing reports the drop. "},{"code":"identify","type":"codeVoice"},{"type":"text","text":", "},{"code":"alias","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"reset","type":"codeVoice"},{"type":"text","text":" are never dropped."}]},{"type":"heading","level":2,"text":"Consent","anchor":"Consent"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Opting out gates events "},{"inlineContent":[{"text":"plugin-side","type":"text"}],"type":"emphasis"},{"type":"text","text":" — every dispatch path returns early,"},{"type":"text","text":" "},{"type":"text","text":"so nothing reaches the service — and removes every call still in the queue"},{"type":"text","text":" "},{"type":"text","text":"that needs consent (track, screen view, identify, alias) as the action"},{"type":"text","text":" "},{"type":"text","text":"reduces, releasing their payloads at once. A queued "},{"code":"reset","type":"codeVoice"},{"type":"text","text":" stays. A call"},{"type":"text","text":" "},{"type":"text","text":"already taken off the queue, running or about to run, is not removed and"},{"type":"text","text":" "},{"type":"text","text":"may still reach the service after the opt-out."}]},{"type":"paragraph","inlineContent":[{"text":"That alone does not engage a vendor SDK’s own consent switch, which matters","type":"text"},{"text":" ","type":"text"},{"text":"when the SDK tracks automatic events or still holds a queue of its own.","type":"text"},{"text":" ","type":"text"},{"text":"Supply ","type":"text"},{"code":"onConsentChange","type":"codeVoice"},{"text":" to bridge the two:","type":"text"}]},{"code":["AnalyticsPlugin(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { a } else { nil } },","    service: mixpanel,","    onConsentChange: { optedOut in","        if optedOut {","            await mixpanel.optOutTracking()","        } else {","            await mixpanel.optInTracking()","        }","    }",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Seed ","type":"text"},{"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsState\/isOptedOut","type":"reference","isActive":true},{"text":" from the app’s persisted consent before","type":"text"},{"text":" ","type":"text"},{"text":"creating the store, then dispatch that value once at launch. This applies","type":"text"},{"text":" ","type":"text"},{"text":"the same initial value to a vendor SDK that has its own consent state.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsService","type":"reference","isActive":true},{"text":" stays at five members: consent APIs vary too much","type":"text"},{"text":" ","type":"text"},{"text":"between vendors to abstract, and only the app knows which it is using.","type":"text"}]}]}],"metadata":{"externalID":"s:15SwiduxAnalytics0B6PluginC","navigatorTitle":[{"kind":"identifier","text":"AnalyticsPlugin"}],"title":"AnalyticsPlugin","symbolKind":"class","roleHeading":"Class","modules":[{"name":"SwiduxAnalytics"}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnalyticsPlugin","kind":"identifier"}]},"variants":[{"paths":["\/documentation\/swiduxanalytics\/analyticsplugin"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"topicSections":[{"identifiers":["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/init(state:action:extractAction:service:mapper:identity:onConsentChange:)"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/afterReduce(state:action:)","doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush()","doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/flush(timeout:)","doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsPlugin\/reduce(state:ac