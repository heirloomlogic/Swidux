{"relationshipsSections":[{"title":"Inherits From","identifiers":["doc:\/\/SwiduxAnalytics\/s8SendableP","doc:\/\/SwiduxAnalytics\/s16SendableMetatypeP"],"kind":"relationships","type":"inheritsFrom"},{"title":"Conforming Types","kind":"relationships","identifiers":["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/ConsoleAnalyticsService","doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/MockAnalyticsService","doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/RecordingAnalyticsService"],"type":"conformingTypes"}],"abstract":[{"text":"Provider-agnostic analytics backend.","type":"text"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxanalytics\/analyticsservice"]}],"hierarchy":{"paths":[["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsService"},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"AnalyticsService"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Implementations handle their own batching, retry, network failure,","type":"text"},{"text":" ","type":"text"},{"text":"and offline queueing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch doesn’t wait for these calls, but the plugin serializes them:"},{"type":"text","text":" "},{"text":"each call starts only after the previous one returns, so they reach the","type":"text"},{"text":" ","type":"text"},{"text":"service in dispatch order. A call that awaits a netw