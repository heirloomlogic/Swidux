{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"AnalyticsService","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}],"platforms":["macOS"]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"Implementations handle their own batching, retry, network failure,","type":"text"},{"text":" ","type":"text"},{"text":"and offline queueing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Dispatch doesn’t wait for these calls, but the plugin serializes them:","type":"text"},{"text":" ","type":"text"},{"text":"each call starts only after the previous one returns, so they reach the","type":"text"},{"text":" ","type":"text"},{"text":"service in dispatch order. A call that awaits a network round trip","type":"text"},{"text":" ","type":"text"},{"text":"therefore holds back every later call. The plugin keeps at most 1,000","type":"text"},{"text":" ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" calls waiting behind a stalled one and then drops the oldest","type":"text"},{"text":" ","type":"text"},{"text":"queued ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":", ","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" are never dropped.","type":"text"},{"text":" ","type":"text"},{"text":"Enqueue the work (as vendor SDKs do) and return promptly; do network I\/O","type":"text"},{"text":" ","type":"text"},{"text":"in the service’s own background upload.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Mixpanel implementation lives in SwiduxMixpanelAnalytics:","st