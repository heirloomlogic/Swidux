{"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics"]]},"abstract":[{"text":"Analytics service that records every call it receives, for SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"previews and Swift Testing suites.","type":"text"}],"variants":[{"paths":["\/documentation\/swiduxanalytics\/recordinganalyticsservice"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"RecordingAnalyticsService"}],"platforms":["macOS"]}]},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tests written against the recorder don’t depend on the analytics vendor,"},{"type":"text","text":" "},{"type":"text","text":"so they stay the same when the app changes provider. Await the store’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" before reading, so every queued call has arrived. "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"its "},{"type":"codeVoice","code":"configured"},{"type":"text","text":" factory below belong to the app, not to this package:"}]},{"code":["let recorder = RecordingAnalyticsService()","let store = AppStore.configured(","    analyticsService: recorder,","    onConsentChange: { await recorder.setOptedOut($0) }",")","","store.send(.analytics(.setOptedOut(true)))","await store.flush()","","#expect(await recorder.calls == [.setOptedOut(true), .reset, .flush])"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/RecordingAnalyticsService\/calls"},{"type":"text","text":" holds every call in the order it arrived, which is what an"},{"type":"text","text":" "},{"type":"text","text":"assertion about sequencing needs, such as the consent hook running before"},{"type":"text","text":" "},{"type":"text","text":"the opt-out’s "},{"type":"codeVoice","code":"reset"},{"type":"text","text":". "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/RecordingAnalyticsService\/trackedEvents"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/RecordingAnalyticsService\/identifyCalls"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/RecordingAnalyticsService\/aliasCalls"},{"type":"text","text":", "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/RecordingAnalyticsService\/resetCount"},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/RecordingAnalyticsService\/flushCount"},{"type":"text","text":" read one kind of call"},{"type":"text","text":" "},{"type":"text","text":"from that log."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The recorder keeps everything, including calls a real service would"},{"type":"text","text":" "},{"type":"text","text":"drop, such as tracking while opted out. Assert consent through the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/RecordingAnalyticsService\/Call\/setOptedOut(_:)"},{"type":"text","text":" entries, not the absence of events."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The log grows without limit, so this is not a production"},{"type":"text","text":" "},{"type":"text","text":"service. It emits a fault at init in Release builds, as"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/ConsoleAnalyticsService"},{"type":"text","text":" does."}]}],"style":"warning","type":"aside","name":"Warning"}],"kind":"content"}],"relationshipsSections":[{"identifiers":["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/AnalyticsService","doc:\/\/SwiduxAnalytics\/s8SendableP","doc:\/\/SwiduxAnalytics\/s16SendableMetatypeP","doc:\/\/SwiduxAnalytics\/ScA"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"metadata":{"externalID":"s:15SwiduxAnalytics09RecordingB7ServiceC","symbolKind":"class","modules":[{"name":"SwiduxAnalytics"}],"fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"RecordingAnalyticsService"}],"title":"RecordingAnalyticsService","roleHeading":"Class","navigatorTitle":[{"text":"RecordingAnalyticsService","kind":"identifier"}],"role":"symbol"},"kind":"symbol","identifier":{"url":"doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/RecordingAnalyticsService","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"topicSections":[{"generated":true,"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/RecordingAnalyticsService\/AliasCall","doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/RecordingAnalyticsService\/IdentifyCall"]},{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/RecordingAnalyticsService\/init()"]},{"generated":true,"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/RecordingAnalyticsService\/aliasCalls","doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\/RecordingAnalyticsService\/calls","doc:\/\/SwiduxAnalytics\/documentation\/SwiduxAnalytics\