{"sections":[],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Every effect the store runs is already cancelled on teardown: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancelEffects()"},{"type":"text","text":" and the store’s "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" cancel all in-flight effect tasks. That is enough for cleanup, but it is "},{"inlineContent":[{"text":"all-or-nothing","type":"text"}],"type":"emphasis"},{"type":"text","text":" — you cannot cancel one specific effect while others keep running."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Keyed cancellation adds that. You give an effect a "},{"inlineContent":[{"text":"cancel id","type":"text"}],"type":"strong"},{"type":"text","text":" with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)"},{"type":"text","text":", and later cancel every effect running under that id with the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)"},{"type":"text","text":" effect or the imperative "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancel(id:)"},{"type":"text","text":" method. Identity lives outside the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect"},{"type":"text","text":" type — it is still a plain closure — so nothing about reducer signatures changes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Reach for this when an effect outlives the action that started it: cancelling text-to-speech when the user skips, debouncing a search field, or tearing down a long-lived listener when a screen disappears."}],"type":"paragraph"},{"text":"Choosing an id","type":"heading","level":2,"anchor":"Choosing-an-id"},{"inlineContent":[{"type":"text","text":"A cancel id is any "},{"type":"codeVoice","code":"Hashable & Sendable"},{"type":"text","text":" value. Distinct ids are independent; effects sharing an id are cancelled together. A dedicated empty type reads well and can’t collide with another feature’s id:"}],"type":"paragraph"},{"code":["private enum SearchID: Hashable, Sendable {}","private enum SpeechID: Hashable, Sendable {}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Strings and enums work too — pick whatever is unambiguous in your domain."}],"type":"paragraph"},{"text":"Cancel from inside a reducer","type":"heading","level":2,"anchor":"Cancel-from-inside-a-reducer"},{"inlineContent":[{"type":"text","text":"Return "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)"},{"type":"text","text":" to tag the work, and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)"},{"type":"text","text":" to stop it:"}],"type":"paragraph"},{"code":["case .startSpeaking(let text):","    return cancellable(id: SpeechID()) { send in","        for await word in speech.speak(text) {","            await send(.spokeWord(word))","        }","    }","","case .skip:","    \/\/ Stop any in-flight speech immediately.","    return cancel(id: SpeechID())"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"When the speaking effect is cancelled, its "},{"type":"codeVoice","code":"for await"},{"type":"text","text":" loop ends at the next suspension point, exactly as it would on teardown."}],"type":"paragraph"},{"text":"Debounce with `cancelInFlight`","type":"heading","level":2,"anchor":"Debounce-with-cancelInFlight"},{"inlineContent":[{"type":"text","text":"Passing "},{"type":"codeVoice","code":"cancelInFlight: true"},{"type":"text","text":" cancels any effect already running under the id "},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"type":"text","text":" starting the new one — the whole of debounce in one line:"}],"type":"paragraph"},{"code":["case .queryChanged(let query):","    return cancellable(id: SearchID(), cancelInFlight: true) { send in","        try await Task.sleep(for: .milliseconds(300))","        let results = try await api.search(query)","        await send(.results(results))","    }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each keystroke re-dispatches "},{"type":"codeVoice","code":".queryChanged"},{"type":"text","text":"; the new effect cancels the previous sleeping one, so only the last query in a burst reaches the network."}],"type":"paragraph"},{"text":"Cancel from view or scene code","type":"heading","level":2,"anchor":"Cancel-from-view-or-scene-code"},{"inlineContent":[{"type":"text","text":"When there is no reducer action to hang the cancellation on — a screen disappearing, a sheet dismissing — call "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancel(id:)"},{"type":"text","text":" directly:"}],"type":"paragraph"},{"code":[".onDisappear {","    store.cancel(id: SearchID())","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Ids with nothing running are ignored, so it is always safe to call."}],"type":"paragraph"},{"text":"What it does not replace","type":"heading","level":2,"anchor":"What-it-does-not-replace"},{"inlineContent":[{"type":"text","text":"Keyed cancellation is not a substitute for resource cleanup. An effect holding a file handle, a network connection, or an "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" continuation should still release it — use "},{"type":"codeVoice","code":"withTaskCancellationHandler"},{"type":"text","text":" or a "},{"type":"codeVoice","code":"defer"},{"type":"text","text":". Cancellation ends the task; it does not close what the task opened."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Effects that terminate on their own (a "},{"type":"codeVoice","code":"for await"},{"type":"text","text":" loop whose stream finishes) need no id at all. Only reach for a cancel id when something "},{"inlineContent":[{"text":"else","type":"text"}],"type":"emphasis"},{"type":"text","text":" has to stop the effect early."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"kind":"article","abstract":[{"text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code.","type":"text"}],"seeAlsoSections":[{"title":"How-to Guides","anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtocanceleffects"]}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","title":"Cancel Effects","roleHeading":"Article"},"references":{"doc://Swidux/documentation/Swidux/Effect":{"type":"topic","role":"symbol","navigatorTitle":[{"text":"Effect","kind":"identifier"}],"title":"Effect","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Effect","kind":"identifier"}],"kind":"symbol","url":"\/documentation\/swidux\/effect","abstract":[{"type":"text","text":"An async unit of work returned by a reducer."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect"},"doc://Swidux/documentation/Swidux/Store/cancel(id:)":{"type":"topic","title":"cancel(id:)","url":"\/documentation\/swidux\/store\/cancel(id:)","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancel(id:)","role":"symbol","kind":"symbol","abstract":[{"text":"Cancels every in-flight effect tagged with ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" via","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)","isActive":true},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"cancel","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"id"},{"text":": ","kind":"text"},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"},{"kind":"text","text":")"}]},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","role":"article","title":"Add a Paywall","kind":"article","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},"doc://Swidux/documentation/Swidux/cancel(id:)":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancel"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Action"},{"kind":"text","text":">("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Effect","preciseIdentifier":"s:6Swidux6Effecta"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">"}],"title":"cancel(id:)","kind":"symbol","url":"\/documentation\/swidux\/cancel(id:)","abstract":[{"text":"An effect that cancels every in-flight effect running under ","type":"text"},{"type":"codeVoice","code":"id"},{"text":".","type":"text"}]},"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","role":"article","title":"Using the Swidux Agent Skill","kind":"article","url":"\/documentation\/swidux\/agentskill","abstract":[{"text":"Install the bundled ","type":"text"},{"type":"codeVoice","code":"swidux-ref"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"},"doc://Swidux/documentation/Swidux/cancellable(id:cancelInFlight:_:)":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancellable"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Action"},{"kind":"text","text":">("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"},{"kind":"text","text":", "},{"kind":"externalParam","text":"cancelInFlight"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Effect","preciseIdentifier":"s:6Swidux6Effecta"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">) -> "},{"kind":"typeIdentifier","text":"Effect","preciseIdentifier":"s:6Swidux6Effecta"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">"}],"title":"cancellable(id:cancelInFlight:_:)","kind":"symbol","url":"\/documentation\/swidux\/cancellable(id:cancelinflight:_:)","abstract":[{"text":"Tags an effect with a cancellation identity so it can later be cancelled by","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)","isActive":true},{"text":" or ","type":"text"},{"type":"codeVoice","code":"Store.cancel(id:)"},{"text":".","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","role":"article","title":"Add a Parental Gate","url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","title":"Building a Domain Plugin","url":"\/documentation\/swidux\/buildingadomainplugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","role":"article","kind":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}]},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"type":"topic","role":"article","title":"Add Feature Flags","kind":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"type":"topic","role":"article","title":"Add Persistence","url":"\/documentation\/swidux\/howtoaddpersistence","kind":"article","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence"},"doc://Swidux/documentation/Swidux/Store/cancelEffects()":{"type":"topic","role":"symbol","title":"cancelEffects()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancelEffects"},{"kind":"text","text":"()"}],"url":"\/documentation\/swidux\/store\/canceleffects()","kind":"symbol","abstract":[{"text":"Cancels all in-flight effects.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancelEffects()"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"type":"topic","role":"article","title":"Add iCloud Sync","kind":"article","url":"\/documentation\/swidux\/howtoaddicloudsync","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},"doc://Swidux/documentation/Swidux":{"title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","type":"topic","role":"collection","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"kind":"symbol"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"type":"topic","role":"article","title":"Add Analytics","kind":"article","url":"\/documentation\/swidux\/howtoaddanalytics","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"type":"topic","role":"article","title":"Add a Version Killswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","kind":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch"}}}