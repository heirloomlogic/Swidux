{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","interfaceLanguage":"swift"},"kind":"article","metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"title":"Cancel Effects","role":"article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"seeAlsoSections":[{"anchor":"How-to-Guides","generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides"}],"sections":[],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Every effect the store runs is already cancelled on teardown: ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancelEffects()","isActive":true,"type":"reference"},{"text":" and the store’s ","type":"text"},{"code":"deinit","type":"codeVoice"},{"text":" cancel all in-flight effect tasks. That is enough for cleanup, but it is ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"all-or-nothing","type":"text"}]},{"text":" — you cannot cancel one specific effect while others keep running.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Keyed cancellation adds that. You give an effect a ","type":"text"},{"type":"strong","inlineContent":[{"text":"cancel id","type":"text"}]},{"text":" with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)","isActive":true,"type":"reference"},{"text":", and later cancel every effect running under that id with the ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)","isActive":true,"type":"reference"},{"text":" effect or the imperative ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancel(id:)","isActive":true,"type":"reference"},{"text":" method. Identity lives outside the ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","isActive":true,"type":"reference"},{"text":" type — it is still a plain closure — so nothing about reducer signatures changes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Reach for this when an effect outlives the action that started it: cancelling text-to-speech when the user skips, debouncing a search field, or tearing down a long-lived listener when a screen disappears.","type":"text"}]},{"type":"heading","anchor":"Choosing-an-id","text":"Choosing an id","level":2},{"type":"paragraph","inlineContent":[{"text":"A cancel id is any ","type":"text"},{"code":"Hashable & Sendable","type":"codeVoice"},{"text":" value. Distinct ids are independent; effects sharing an id are cancelled together. A dedicated empty type reads well and can’t collide with another feature’s id:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["private enum SearchID: Hashable, Sendable {}","private enum SpeechID: Hashable, Sendable {}"]},{"type":"paragraph","inlineContent":[{"text":"Strings and enums work too — pick whatever is unambiguous in your domain.","type":"text"}]},{"type":"heading","anchor":"Cancel-from-inside-a-reducer","text":"Cancel from inside a reducer","level":2},{"type":"paragraph","inlineContent":[{"text":"Return ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)","isActive":true,"type":"reference"},{"text":" to tag the work, and ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)","isActive":true,"type":"reference"},{"text":" to stop it:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["case .startSpeaking(let text):","    return cancellable(id: SpeechID()) { send in","        for await word in speech.speak(text) {","            await send(.spokeWord(word))","        }","    }","","case .skip:","    \/\/ Stop any in-flight speech immediately.","    return cancel(id: SpeechID())"]},{"type":"paragraph","inlineContent":[{"text":"When the speaking effect is cancelled, its ","type":"text"},{"code":"for await","type":"codeVoice"},{"text":" loop ends at the next suspension point, exactly as it would on teardown.","type":"text"}]},{"type":"heading","anchor":"Debounce-with-cancelInFlight","text":"Debounce with `cancelInFlight`","level":2},{"type":"paragraph","inlineContent":[{"text":"Passing ","type":"text"},{"code":"cancelInFlight: true","type":"codeVoice"},{"text":" cancels any effect already running under the id ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"text":" starting the new one — the whole of debounce in one line:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["case .queryChanged(let query):","    return cancellable(id: SearchID(), cancelInFlight: true) { send in","        try await Task.sleep(for: .milliseconds(300))","        let results = try await api.search(query)","        await send(.results(results))","    }"]},{"type":"paragraph","inlineContent":[{"text":"Each keystroke re-dispatches ","type":"text"},{"code":".queryChanged","type":"codeVoice"},{"text":"; the new effect cancels the previous sleeping one, so only the last query in a burst reaches the network.","type":"text"}]},{"type":"heading","anchor":"Cancel-from-view-or-scene-code","text":"Cancel from view or scene code","level":2},{"type":"paragraph","inlineContent":[{"text":"When there is no reducer action to hang the cancellation on — a screen disappearing, a sheet dismissing — call ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancel(id:)","isActive":true,"type":"reference"},{"text":" directly:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".onDisappear {","    store.cancel(id: SearchID())","}"]},{"type":"paragraph","inlineContent":[{"text":"Ids with nothing running are ignored, so it is always safe to call.","type":"text"}]},{"type":"heading","anchor":"What-it-does-not-replace","text":"What it does not replace","level":2},{"type":"paragraph","inlineContent":[{"text":"Keyed cancellation is not a substitute for resource cleanup. An effect holding a file handle, a network connection, or an ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" continuation should still release it — use ","type":"text"},{"code":"withTaskCancellationHandler","type":"codeVoice"},{"text":" or a ","type":"text"},{"code":"defer","type":"codeVoice"},{"text":". Cancellation ends the task; it does not close what the task opened.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Effects that terminate on their own (a ","type":"text"},{"code":"for await","type":"codeVoice"},{"text":" loop whose stream finishes) need no id at all. Only reach for a cancel id when something ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"else","type":"text"}]},{"text":" has to stop the effect early.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtocanceleffects"]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify.","type":"text"}],"kind":"article","url":"\/documentation\/swidux\/howtoaddanalytics","type":"topic","title":"Add Analytics"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"title":"Add Persistence","url":"\/documentation\/swidux\/howtoaddpersistence","type":"topic","kind":"article","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":" plugin and the "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" macro — no hand-written "},{"code":"@Model","type":"codeVoice"},{"type":"text","text":" classes, database actors, or "},{"code":"StateWriter","type":"codeVoice"},{"type":"text","text":" closures."}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","title":"Building a Domain Plugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","kind":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"url":"\/documentation\/swidux\/buildingadomainplugin","role":"article"},"doc://Swidux/documentation/Swidux/cancel(id:)":{"title":"cancel(id:)","url":"\/documentation\/swidux\/cancel(id:)","type":"topic","kind":"symbol","abstract":[{"text":"An effect that cancels every in-flight effect running under ","type":"text"},{"code":"id","type":"codeVoice"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancel"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Action"},{"kind":"text","text":">("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"},{"kind":"text","text":" & "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:6Swidux6Effecta","kind":"typeIdentifier","text":"Effect"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">"}],"role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)"},"doc://Swidux/documentation/Swidux/Store/cancelEffects()":{"title":"cancelEffects()","url":"\/documentation\/swidux\/store\/canceleffects()","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Cancels all in-flight effects."}],"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancelEffects"},{"kind":"text","text":"()"}],"role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancelEffects()"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"title":"Add Feature Flags","url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","title":"Using the Swidux Agent Skill","url":"\/documentation\/swidux\/agentskill","kind":"article","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","identifier":"doc:\/\/Swidux\/documentat