ble"},{"kind":"text","text":")"}],"title":"cancel(id:)","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancel(id:)"},"doc://Swidux/documentation/Swidux/Effect":{"navigatorTitle":[{"text":"Effect","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","title":"Effect","url":"\/documentation\/swidux\/effect","type":"topic","abstract":[{"text":"An async unit of work returned by a reducer.","type":"text"}],"role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Effect","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/Store/cancelEffects()":{"role":"symbol","abstract":[{"type":"text","text":"Cancels all in-flight effects."}],"type":"topic","url":"\/documentation\/swidux\/store\/canceleffects()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancelEffects","kind":"identifier"},{"text":"()","kind":"text"}],"title":"cancelEffects()","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancelEffects()"},"doc://Swidux/documentation/Swidux":{"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux","url":"\/documentation\/swidux","type":"topic","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"role":"collection"}}}