nd":"symbol","navigatorTitle":[{"text":"Effect","kind":"identifier"}],"type":"topic","fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"text":"Effect","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","title":"Effect","abstract":[{"text":"An async unit of work returned by a reducer.","type":"text"}],"role":"symbol"},"doc://Swidux/documentation/Swidux/cancel(id:)":{"url":"\/documentation\/swidux\/cancel(id:)","kind":"symbol","abstract":[{"text":"An effect that cancels every in-flight effect running under ","type":"text"},{"code":"id","type":"codeVoice"},{"text":".","type":"text"}],"title":"cancel(id:)","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancel"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Action"},{"text":">(","kind":"text"},{"text":"id","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"text":" ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"},{"text":") -> ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:6Swidux6Effecta","text":"Effect"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">"}]}}}