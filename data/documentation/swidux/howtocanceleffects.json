"Effect","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux6Effecta"},{"text":"<","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"cancellable(id:cancelInFlight:_:)","abstract":[{"type":"text","text":"Tags an effect with a cancellation identity so it can later be cancelled by"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Store.cancel(id:)"},{"type":"text","text":"."}],"type":"topic"},"doc://Swidux/documentation/Swidux/cancel(id:)":{"url":"\/documentation\/swidux\/cancel(id:)","kind":"symbol","role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Action","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"},{"text":" & ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"},{"text":") -> ","kind":"text"},{"text":"Effect","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux6Effecta"},{"text":"<","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">","kind":"text"}],"title":"cancel(id:)","type":"topic","abstract":[{"text":"An effect that cancels every in-flight effect running under ","type":"text"},{"code":"id","type":"codeVoice"},{"text":".","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"kind":"article","type":"topic","url":"\/documentation\/swidux\/howtoadda