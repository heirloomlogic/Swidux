{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"Cancel Effects","role":"article","roleHeading":"Article","modules":[{"name":"Swidux"}]},"seeAlsoSections":[{"title":"How-to Guides","anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true}],"abstract":[{"text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Every effect the store runs is already cancelled on teardown: ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancelEffects()","isActive":true},{"text":" and the store’s ","type":"text"},{"type":"codeVoice","code":"deinit"},{"text":" cancel all in-flight effect tasks. That is enough for cleanup, but it is ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"all-or-nothing","type":"text"}]},{"text":" — you cannot cancel one specific effect while others keep running.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Keyed cancellation adds that. You give an effect a ","type":"text"},{"type":"strong","inlineContent":[{"text":"cancel id","type":"text"}]},{"text":" with ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)","isActive":true},{"text":", and later cancel every effect running under that id with the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)","isActive":true},{"text":" effect or the imperative ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancel(id:)","isActive":true},{"text":" method. Identity lives outside the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","isActive":true},{"text":" type — it is still a plain closure — so nothing about reducer signatures changes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Reach for this when an effect outlives the action that started it: cancelling text-to-speech when the user skips, debouncing a search field, or tearing down a long-lived listener when a screen disappears.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Choosing an id","anchor":"Choosing-an-id","type":"heading"},{"inlineContent":[{"text":"A cancel id is any ","type":"text"},{"type":"codeVoice","code":"Hashable & Sendable"},{"text":" value. Distinct ids are independent; effects sharing an id are cancelled together. A dedicated empty type reads well and can’t collide with another feature’s id:","type":"text"}],"type":"paragraph"},{"code":["private enum SearchID: Hashable, Sendable {}","private enum SpeechID: Hashable, Sendable {}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Strings and enums work too — pick whatever is unambiguous in your domain.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Cancel from inside a reducer","anchor":"Cancel-from-inside-a-reducer","type":"heading"},{"inlineContent":[{"text":"Return ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)","isActive":true},{"text":" to tag the work, and ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)","isActive":true},{"text":" to stop it:","type":"text"}],"type":"paragraph"},{"code":["case .startSpeaking(let text):","    return cancellable(id: SpeechID()) { send in","        for await word in speech.speak(text) {","            await send(.spokeWord(word))","        }","    }","","case .skip:","    \/\/ Stop any in-flight speech immediately.","    return cancel(id: SpeechID())"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When the speaking effect is cancelled, its ","type":"text"},{"type":"codeVoice","code":"for await"},{"text":" loop ends at the next suspension point, exactly as it would on teardown.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Debounce with `cancelInFlight`","anchor":"Debounce-with-cancelInFlight","type":"heading"},{"inlineContent":[{"text":"Passing ","type":"text"},{"type":"codeVoice","code":"cancelInFlight: true"},{"text":" cancels any effect already running under the id ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"text":" starting the new one — the whole of debounce in one line:","type":"text"}],"type":"paragraph"},{"code":["case .queryChanged(let query):","    return cancellable(id: SearchID(), cancelInFlight: true) { send in","        try await Task.sleep(for: .milliseconds(300))","        let results = try await api.search(query)","        await send(.results(results))","    }"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Each keystroke re-dispatches ","type":"text"},{"type":"codeVoice","code":".queryChanged"},{"text":"; the new effect cancels the previous sleeping one, so only the last query in a burst reaches the network.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Cancel from view or scene code","anchor":"Cancel-from-view-or-scene-code","type":"heading"},{"inlineContent":[{"text":"When there is no reducer action to hang the cancellation on — a screen disappearing, a sheet dismissing — call ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancel(id:)","isActive":true},{"text":" directly:","type":"text"}],"type":"paragraph"},{"code":[".onDisappear {","    store.cancel(id: SearchID())","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Ids with nothing running are ignored, so it is always safe to call.","type":"text"}],"type":"paragraph"},{"level":2,"text":"What it does not replace","anchor":"What-it-does-not-replace","type":"heading"},{"inlineContent":[{"text":"Keyed cancellation is not a substitute for resource cleanup. An effect holding a file handle, a network connection, or an ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"text":" continuation should still release it — use ","type":"text"},{"type":"codeVoice","code":"withTaskCancellationHandler"},{"text":" or a ","type":"text"},{"type":"codeVoice","code":"defer"},{"text":". Cancellation ends the task; it does not close what the task opened.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Effects that terminate on their own (a ","type":"text"},{"type":"codeVoice","code":"for await"},{"text":" loop whose stream finishes) need no id at all. Only reach for a cancel id when something ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"else","type":"text"}]},{"text":" has to stop the effect early.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtocanceleffects"]}],"kind":"article","references":{"doc://Swidux/documentation/Swidux/Effect":{"role":"symbol","title":"Effect","navigatorTitle":[{"kind":"identifier","text":"Effect"}],"kind":"symbol","abstract":[{"type":"text","text":"An async unit of work returned by a reducer."}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Effect"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","url":"\/documentation\/swidux\/effect","type":"topic"},"doc://Swidux/documentation/Swidux/cancellable(id:cancelInFlight:_:)":{"role":"symbol","title":"cancellable(id:cancelInFlight:_:)","kind":"symbol","abstract":[{"type":"text","text":"Tags an effect with a cancellation identity so it can later be cancelled by"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)"},{"type":"text","text":" or "},{"code":"Store.cancel(id:)","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancellable"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Action"},{"kind":"text","text":">("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"},{"kind":"text","text":" & "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"},{"kind":"text","text":", "},{"kind":"externalParam","text":"cancelInFlight"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", "},{"preciseIdentifier":"s:6Swidux6Effecta","kind":"typeIdentifier","text":"Effect"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">) -> "},{"preciseIdentifier":"s:6Swidux6Effecta","kind":"typeIdentifier","text":"Effect"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)","url":"\/documentation\/swidux\/cancellable(id:cancelinflight:_:)","type":"topic"},"doc://Swidux/documentation/Swidux/cancel(id:)":{"role":"symbol","title":"cancel(id:)","kind":"symbol","abstract":[{"type":"text","text":"An effect that cancels every in-flight effect running under "},{"code":"id","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancel"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Action"},{"kind":"text","text":">("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"preciseIdentifier":"s:SH","kind":"typeIdentifier","text":"Hashable"},{"kind":"text","text":" & "},{"preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier","text":"Sendable"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:6Swidux6Effecta","kind":"typeIdentifier","text":"Effect"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)","url":"\/documentation\/swidux\/cancel(id:)","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"title":"Add Feature Flags","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","url":"\/documentation\/swidux\/howtoaddicloudsync","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"title":"Add iCloud Sync","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"role":"article","title":"Add a Paywall","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"role":"article","title":"Add Persistence","kind":"article","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","url":"\/documentation\/swidux\/howtoaddpersistence","type":"topic"},"doc://Swidux/documentation/Swidux/Store/cancelEffects()":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancelEffects()","url":"\/documentation\/swidux\/store\/canceleffects()","abstract":[{"text":"Cancels all in-flight effects.","type":"text"}],"title":"cancelEffects()","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancelEffects","kind":"identifier"},{"text":"()","kind":"text"}]},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","role":"collection","type":"topic","kind":"symbol"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"role":"article","title":"Building a Domain Plugin","kind":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","url":"\/documentation\/swidux\/buildingadomainplugin","type":"topic"},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"title":"Using the Swidux Agent Skill","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"title":"Add a Version Killswitch","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/Store/cancel(id:)":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancel(id:)","url":"\/documentation\/swidux\/store\/cancel(id:)","abstract":[{"text":"Cancels every in-flight effect tagged with ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" via","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)","isActive":true},{"text":".","type":"text"}],"title":"cancel(id:)","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"},{"text":" & ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"title":"Add a Parental Gate","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","url":"\/documentation\/swidux\/howtoaddanalytics","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"title":"Add Analytics","role":"article","type":"topic","kind":"article"}}}