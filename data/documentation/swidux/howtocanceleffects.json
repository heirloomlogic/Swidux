gle JSON config."}],"type":"topic"},"doc://Swidux/documentation/Swidux/Store/cancel(id:)":{"abstract":[{"text":"Cancels every in-flight effect tagged with ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" via","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)","isActive":true,"type":"reference"},{"text":".","type":"text"}],"role":"symbol","title":"cancel(id:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hashable","preciseIdentifier":"s:SH","kind":"typeIdentifier"},{"text":" & ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"},{"text":")","kind":"text"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancel(id:)","kind":"symbol","url":"\/documentation\/swidux\/store\/cancel(id:)"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","role":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","title":"Add a Parental Gate","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"type":"topic"}}}