{"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/swidux\/howtocanceleffects"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Swidux"}],"title":"Cancel Effects"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","interfaceLanguage":"swift"},"kind":"article","abstract":[{"text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code.","type":"text"}],"seeAlsoSections":[{"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"anchor":"How-to-Guides"}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"Every effect the store runs is already cancelled on teardown: "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancelEffects()","isActive":true},{"type":"text","text":" and the store’s "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" cancel all in-flight effect tasks. That is enough for cleanup, but it is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"all-or-nothing"}]},{"type":"text","text":" — you cannot cancel one specific effect while others keep running."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Keyed cancellation adds that. You give an effect a "},{"type":"strong","inlineContent":[{"type":"text","text":"cancel id"}]},{"type":"text","text":" with "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)","type":"reference","isActive":true},{"type":"text","text":", and later cancel every effect running under that id with the "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)","type":"reference","isActive":true},{"type":"text","text":" effect or the imperative "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancel(id:)","type":"reference","isActive":true},{"type":"text","text":" method. Identity lives outside the "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","type":"reference","isActive":true},{"type":"text","text":" type — it is still a plain closure — so nothing about reducer signatures changes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Reach for this when an effect outlives the action that started it: cancelling text-to-speech when the user skips, debouncing a search field, or tearing down a long-lived listener when a screen disappears."}],"type":"paragraph"},{"text":"Choosing an id","level":2,"type":"heading","anchor":"Choosing-an-id"},{"inlineContent":[{"type":"text","text":"A cancel id is any "},{"type":"codeVoice","code":"Hashable & Sendable"},{"type":"text","text":" value. Distinct ids are independent; effects sharing an id are cancelled together. A dedicated empty type reads well and can’t collide with another feature’s id:"}],"type":"paragraph"},{"code":["private enum SearchID: Hashable, Sendable {}","private enum SpeechID: Hashable, Sendable {}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Strings and enums work too — pick whatever is unambiguous in your domain."}],"type":"paragraph"},{"text":"Cancel from inside a reducer","level":2,"type":"heading","anchor":"Cancel-from-inside-a-reducer"},{"inlineContent":[{"type":"text","text":"Return "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)","type":"reference","isActive":true},{"type":"text","text":" to tag the work, and "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)","type":"reference","isActive":true},{"type":"text","text":" to stop it:"}],"type":"paragraph"},{"code":["case .startSpeaking(let text):","    return cancellable(id: SpeechID()) { send in","        for await word in speech.speak(text) {","            await send(.spokeWord(word))","        }","    }","","case .skip:","    \/\/ Stop any in-flight speech immediately.","    return cancel(id: SpeechID())"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"When the speaking effect is cancelled, its "},{"type":"codeVoice","code":"for await"},{"type":"text","text":" loop ends at the next suspension point, exactly as it would on teardown."}],"type":"paragraph"},{"text":"Debounce with `cancelInFlight`","level":2,"type":"heading","anchor":"Debounce-with-cancelInFlight"},{"inlineContent":[{"type":"text","text":"Passing "},{"type":"codeVoice","code":"cancelInFlight: true"},{"type":"text","text":" cancels any effect already running under the id "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" starting the new one — the whole of debounce in one line:"}],"type":"paragraph"},{"code":["case .queryChanged(let query):","    return cancellable(id: SearchID(), cancelInFlight: true) { send in","        try await Task.sleep(for: .milliseconds(300))","        let results = try await api.search(query)","        await send(.results(results))","    }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Each keystroke re-dispatches "},{"type":"codeVoice","code":".queryChanged"},{"type":"text","text":"; the new effect cancels the previous sleeping one, so only the last query in a burst reaches the network."}],"type":"paragraph"},{"text":"Cancel from view or scene code","level":2,"type":"heading","anchor":"Cancel-from-view-or-scene-code"},{"inlineContent":[{"type":"text","text":"When there is no reducer action to hang the cancellation on — a screen disappearing, a sheet dismissing — call "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancel(id:)","type":"reference","isActive":true},{"type":"text","text":" directly:"}],"type":"paragraph"},{"code":[".onDisappear {","    store.cancel(id: SearchID())","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Ids with nothing running are ignored, so it is always safe to call."}],"type":"paragraph"},{"text":"What it does not replace","level":2,"type":"heading","anchor":"What-it-does-not-replace"},{"inlineContent":[{"type":"text","text":"Keyed cancellation is not a substitute for resource cleanup. An effect holding a file handle, a network connection, or an "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" continuation should still release it — use "},{"type":"codeVoice","code":"withTaskCancellationHandler"},{"type":"text","text":" or a "},{"type":"codeVoice","code":"defer"},{"type":"text","text":". Cancellation ends the task; it does not close what the task opened."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Effects that terminate on their own (a "},{"type":"codeVoice","code":"for await"},{"type":"text","text":" loop whose stream finishes) need no id at all. Only reach for a cancel id when something "},{"type":"emphasis","inlineContent":[{"type":"text","text":"else"}]},{"type":"text","text":" has to stop the effect early."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","role":"article","kind":"article","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"title":"Add a Paywall"},"doc://Swidux/documentation/Swidux":{"abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux","role":"collection","url":"\/documentation\/swidux"},"doc://Swidux/documentation/Swidux/Effect":{"fragments":[{"kind":"keyword","text":"typealias"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Effect"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Effect"}],"kind":"symbol","url":"\/documentation\/swidux\/effect","abstract":[{"text":"An async unit of work returned by a reducer.","type":"text"}],"title":"Effect"},"doc://Swidux/documentation/Swidux/AgentSkill":{"abstract":[{"text":"Install the bundled ","type":"text"},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","title":"Using the Swidux Agent Skill","role":"article","url":"\/documentation\/swidux\/agentskill"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","role":"article","kind":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"title":"Add Feature Flags"},"doc://Swidux/documentation/Swidux/cancel(id:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancel"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"Action"},{"text":">(","kind":"text"},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Effect","preciseIdentifier":"s:6Swidux6Effecta"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"An effect that cancels every in-flight effect running under "},{"type":"codeVoice","code":"id"},{"type":"text","text":"."}],"url":"\/documentation\/swidux\/cancel(id:)","title":"cancel(id:)"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"url":"\/documentation\/swidux\/howtoaddpersistence","role":"article","title":"Add Persistence","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","role":"article","kind":"article","url":"\/documentation\/swidux\/howtoaddanalytics","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify.","type":"text"}],"title":"Add Analytics"},"doc://Swidux/documentation/Swidux/cancellable(id:cancelInFlight:_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancellable"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Action"},{"kind":"text","text":">("},{"kind":"externalParam","text":"id"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:SH","text":"Hashable"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"},{"kind":"text","text":", "},{"kind":"externalParam","text":"cancelInFlight"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Swidux6Effecta","text":"Effect"},{"kind":"text","text":"<"},{"text":"Action","kind":"typeIdentifier"},{"text":">) -> ","kind":"text"},{"text":"Effect","preciseIdentifier":"s:6Swidux6Effecta","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"kind":"text","text":">"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)","role":"symbol","kind":"symbol","abstract":[{"text":"Tags an effect with a cancellation identity so it can later be cancelled by","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)","type":"reference"},{"text":" or ","type":"text"},{"code":"Store.cancel(id:)","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/swidux\/cancellable(id:cancelinflight:_:)","title":"cancellable(id:cancelInFlight:_:)"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","role":"article","kind":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"title":"Add a Parental Gate"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","role":"article","kind":"article","url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"title":"Building a Domain Plugin"},"doc://Swidux/documentation/Swidux/Store/cancelEffects()":{"url":"\/documentation\/swidux\/store\/canceleffects()","role":"symbol","title":"cancelEffects()","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancelEffects()","abstract":[{"type":"text","text":"Cancels all in-flight effects."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancelEffects","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","role":"article","kind":"article","url":"\/documentation\/swidux\/howtoaddicloudsync","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"title":"Add iCloud Sync"},"doc://Swidux/documentation/Swidux/Store/cancel(id:)":{"url":"\/documentation\/swidux\/store\/cancel(id:)","role":"symbol","title":"cancel(id:)","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancel(id:)","abstract":[{"type":"text","text":"Cancels every in-flight effect tagged with "},{"type":"codeVoice","code":"id"},{"type":"text","text":" via"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)","isActive":true},{"type":"text","text":"."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identifier"},{"text":"(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"Hashable","preciseIdentifier":"s:SH"},{"kind":"text","text":" & "},{"kind":"typeIdentifier","text":"Sendable","preciseIdentifier":"s:s8SendableP"},{"kind":"text","text":")"}],"type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","title":"Add a Version Killswitch","role":"article","url":"\/documentation\/swidux\/howtoaddaversionkillswitch"}}}