"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"role":"article","kind":"article","title":"Add iCloud Sync","url":"\/documentation\/swidux\/howtoaddicloudsync"},"doc://Swidux/documentation/Swidux/Store/cancelEffects()":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/cancelEffects()","url":"\/documentation\/swidux\/store\/canceleffects()","kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"cancelEffects"},{"kind":"text","text":"()"}],"abstract":[{"type":"text","text":"Cancels all in-flight effects."}],"title":"cancelEffects()"},"doc://Swidux/documentation/Swidux/cancel(id:)":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)","abstract":[{"text":"An effect that cancels every in-flight effect running under ","type":"text"},{"type":"codeVoice","code":"id"},{"text":".","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"cancel","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Action","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"id","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"some","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Hashable","kind":"typeIdentifier","preciseIdentifier":"s:SH"},{"text":" & ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Effect","preciseIdentifier":"s:6Swidux6Effecta","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">","kind":"text"}],"role":"symbol","kind":"symbol","title":"cancel(id:)","url":"\/documentation\/swidux\/cancel(id:)"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"title":"Add Feature Flags","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"role":"article","kind":"article","title":"Add a Paywall","url":"\/documentation\/swidux\/howtoaddapaywall"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"role":"article","kind":"article","title":"Building a Domain Plugin","url":"\/documentation\/swidux\/buildingadomainplugin"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"role":"article","kind":"article","title":"Add a Version Killswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch"},"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"role":"article","kind":"article","title":"Using the Swidux Agent Skill","url":"\/documentation\/swidux\/agentskill"},"doc://Swidux/documentation/Swidux/Effect":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","abstract":[{"text":"An async unit of work returned by a reducer.","type":"text"}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Effect"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Effect"}],"title":"Effect","url":"\/documentation\/swidux\/effect"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"role":"article","kind":"article","title":"Add Analytics","url":"\/documentation\/swidux\/howtoaddanalytics"},"doc://Swidux/documentation/Swidux":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"role":"collection","kind":"symbol","title":"Swidux","url":"\/documentation\/swidux"}}}