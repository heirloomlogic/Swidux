fier":"s:s8SendableP"},{"kind":"text","text":")"}]},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"title":"Add iCloud Sync","url":"\/documentation\/swidux\/howtoaddicloudsync","type":"topic","kind":"article","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":" with the "},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"kind":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","type":"topic","title":"Add a Parental Gate"},"doc://Swidux/documentation/Swidux":{"abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","url":"\/documentation\/swidux","title":"Swidux","type":"topic","kind":"symbol"}}}