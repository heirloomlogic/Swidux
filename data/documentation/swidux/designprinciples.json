{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"type":"text","text":"The 10 rules that shape every Swidux app, and the reasoning behind them."}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","doc:\/\/Swidux\/documentation\/Swidux\/BuildingYourFirstApp"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Explanation","anchor":"Explanation","generated":true}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swidux’s surface area looks small — a "},{"code":"Store","type":"codeVoice"},{"type":"text","text":", a reducer protocol, a plugin protocol — but the API is opinionated. These principles explain "},{"type":"emphasis","inlineContent":[{"type":"text","text":"why"}]},{"type":"text","text":" the API has the shape it does, so you can extend it correctly."}]},{"type":"heading","anchor":"1-State-is-a-value-observation-is-a-class","text":"1. State is a value, observation is a class","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"State is a struct. Mutations go through "},{"code":"inout State","type":"codeVoice"},{"type":"text","text":", which is predictable, snapshottable, and testable. SwiftUI observation needs an "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" reference type. Reconciling these two requires a class that mirrors the struct."}]},{"type":"paragraph","inlineContent":[{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" generates that class for you ("},{"code":"<StructName>Observer","type":"codeVoice"},{"type":"text","text":") and wires up the "},{"code":"SwiduxObservable","type":"codeVoice"},{"type":"text","text":" conformance that bridges the two. Don’t hand-write the observer. The "},{"code":"pack → reduce → unpack-diff → observe","type":"codeVoice"},{"type":"text","text":" cycle is what gives you per-property re-renders without coupling reducers to a class."}]},{"type":"paragraph","inlineContent":[{"code":"@Slice","type":"codeVoice"},{"type":"text","text":" extends this to nested struct slices: each slice gets its own observer class so observation stays granular even across composition."}]},{"type":"heading","anchor":"2-Reducers-are-pure-and-synchronous","text":"2. Reducers are pure and synchronous","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reducers take "},{"code":"inout State","type":"codeVoice"},{"type":"text","text":" and an "},{"code":"Action","type":"codeVoice"},{"type":"text","text":", mutate state in place, and return an optional "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","type":"reference","isActive":true},{"type":"text","text":". They never "},{"code":"await","type":"codeVoice"},{"type":"text","text":", never "},{"code":"throw","type":"codeVoice"},{"type":"text","text":", and never call I\/O directly."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Why: pure synchronous mutations are trivially testable, deterministic, and snapshot-friendly. When you need async work (network, disk, timers), return an effect — a "},{"code":"@Sendable","type":"codeVoice"},{"type":"text","text":" async closure that runs off the MainActor and dispatches follow-up actions back through "},{"code":"send","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","anchor":"3-Effects-run-off-MainActor-sends-hop-back","text":"3. Effects run off MainActor; sends hop back","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","type":"reference","isActive":true},{"type":"text","text":" is "},{"code":"@Sendable (Send) async -> Void","type":"codeVoice"},{"type":"text","text":". The "},{"code":"Store","type":"codeVoice"},{"type":"text","text":" runs effects in "},{"code":"Task { @concurrent in }","type":"codeVoice"},{"type":"text","text":" so they don’t block UI. "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Send","type":"reference","isActive":true},{"type":"text","text":" is "},{"code":"@MainActor @Sendable (Action) -> Void","type":"codeVoice"},{"type":"text","text":", so dispatching from inside an effect always lands back on MainActor — no manual hops, no race conditions on state."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The split is deliberate: effects own the work, the reducer owns the state."}]},{"type":"heading","anchor":"4-Persistence-is-invisible","text":"4. Persistence is invisible","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reducers mutate "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":" properties; "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":" records every change in a "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","type":"reference","isActive":true},{"type":"text","text":"; "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"type":"text","text":" debounces and drains those changesets through "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/StateWriter","type":"reference","isActive":true},{"type":"text","text":" closures."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You never write "},{"code":"db.save()","type":"codeVoice"},{"type":"text","text":" in a feature. A reducer that adds an item is identical whether the entity is persisted to SwiftData, SQLite, or nowhere — register or don’t register a writer. This is the principle that makes Swidux apps feel small: persistence stops being a concern of feature code."}]},{"type":"heading","anchor":"5-Synchronous-state-async-persistence","text":"5. Synchronous state, async persistence","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"State updates synchronously inside the reducer for instant UI feedback. Persistence happens asynchronously: "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":" change tracking is in-memory and free; the debounced persistence flush coalesces rapid mutations into a single batched write."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tap-tap-tap-tap on an increment button updates the UI on every tap and produces one DB write a moment later. Reducers stay synchronous; storage stays cheap."}]},{"type":"heading","anchor":"6-Plugins-are-the-single-extension-point","text":"6. Plugins are the single extension point","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Everything that hangs off the dispatch cycle is a "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","type":"reference","isActive":true},{"type":"text","text":". Persistence, undo, killswitch, parental gate, paywall — same protocol, same lifecycle hooks. You can add your own without forking Swidux."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two structural patterns:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Core middleware","type":"text"}]},{"type":"text","text":" ("},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true},{"type":"text","text":", "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":") — action-agnostic. Doesn’t know your action type. Couples only to state shape ("},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" for undo; "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" keypaths for persistence)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Domain plugins","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"code":"KillswitchPlugin","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ParentalGatePlugin","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":", your own) — owns a state slice and an action enum. Wires into your root types via keypath + action lifter + extractor.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The decision rule: "},{"type":"emphasis","inlineContent":[{"text":"does this need to know your action type?","type":"text"}]},{"type":"text","text":" If no, write core middleware and use "},{"type":"codeVoice","code":"willReduce"},{"type":"text","text":" or "},{"code":"afterReduce","type":"codeVoice"},{"text":". If yes, write a domain plugin and use ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"7-Bind-to-the-store-not-to-State","level":2,"type":"heading","text":"7. Bind to the store, not to `@State`"},{"inlineContent":[{"text":"Form inputs read from the store and dispatch on write. Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/binding(_:sending:)","type":"reference"},{"text":" for the common case (read one property, dispatch one action), and fall back to ","type":"text"},{"code":"Binding(get:set:)","type":"codeVoice"},{"text":" when the read is a transformation (optional unwraps, derived values) or the setter wraps the dispatch in animation or branching. Don’t buffer mutable form state in ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" and write back on a button.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Why: every mutation flows through the reducer, which means undo\/redo, persistence, and any plugin that watches the dispatch cycle sees every keystroke (subject to coalescing). If you stash state in ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":", those plugins are blind to it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The trade-off is more dispatches per keystroke. Coalescing — see "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference"},{"text":" — collapses bursts of the same action into a single undo step.","type":"text"}],"type":"paragraph"},{"anchor":"8-Registration-order-matters-at-the-boundaries","level":2,"type":"heading","text":"8. Registration order matters at the boundaries"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference"},{"text":" snapshots in ","type":"text"},{"code":"willReduce","type":"codeVoice"},{"text":", so it must run ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"text":" any plugin or reducer mutates state — register it first. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference"},{"type":"text","text":" drains changelogs in "},{"code":"afterReduce","type":"codeVoice"},{"text":", so it wants the post-mutation state — register it after undo. Domain plugins use only ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":", so their relative order rarely matters.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The recommended order:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["plugins.register(undoPlugin)         \/\/ 1. snapshots first","plugins.register(persistencePlugin)  \/\/ 2. drains after reducer","plugins.register(killswitchPlugin)   \/\/ 3. domain plugins","plugins.register(paywallPlugin)","plugins.register(parentalGatePlugin)"]},{"type":"heading","level":2,"anchor":"9-Strict-concurrency-on-purpose","text":"9. Strict concurrency, on purpose"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swidux is built for "},{"type":"codeVoice","code":"swiftLanguageMode(.v6)"},{"type":"text","text":" and assumes Swift 6 strict concurrency throughout. State must be "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":". The macros mark generated code carefully. Effects use explicit isolation ("},{"code":"@Sendable","type":"codeVoice"},{"type":"text","text":", "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":", "},{"code":"@concurrent","type":"codeVoice"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is friction at first — you’ll get warnings about "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" types. Honour them. The result is a state-management layer that composes safely with "},{"code":"async\/await","type":"codeVoice"},{"type":"text","text":" and SwiftData without the surprise data races you get from pre-Swift 6 designs."}]},{"level":2,"type":"heading","text":"10. The store is opinionated; your app is not","anchor":"10-The-store-is-opinionated-your-app-is-not"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swidux gives you a "},{"code":"Store","type":"codeVoice"},{"type":"text","text":", a reducer protocol, a plugin protocol, and three optional plugins. It does not give you:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A dependency-injection container (write your own ","type":"text"},{"type":"codeVoice","code":"AppEnvironment"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A navigation library (use SwiftUI navigation).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A network layer (use ","type":"text"},{"type":"codeVoice","code":"URLSession"},{"text":", structured concurrency, or whatever you want).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An opinion on database (SwiftData, GRDB, SQLite, Core Data — register a ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"text":" and Swidux doesn’t care).","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The store owns one job: take an action, produce a new state, run effects. Everything else is yours."}]},{"level":2,"type":"heading","text":"Anti-patterns","anchor":"Anti-patterns"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"❌ ","type":"text"},{"type":"codeVoice","code":"await"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"try"},{"text":" inside a reducer — return an effect instead.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"❌ Hand-writing the observer class when you could use ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"❌ Calling ","type":"text"},{"type":"codeVoice","code":"db.save()"},{"text":" from inside a reducer — use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/StateWriter","type":"reference"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"❌ Mutating state from inside an effect — effects dispatch actions; the reducer mutates."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"❌ Owning the store with "},{"type":"codeVoice","code":"@StateObject"},{"type":"text","text":" — use "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" ("},{"type":"codeVoice","code":"Store"},{"type":"text","text":" is "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":", not "},{"type":"codeVoice","code":"ObservableObject"},{"type":"text","text":")."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"❌ Buffering form state in "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" and committing on submit — bind to the store directly."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"❌ Registering "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"type":"text","text":" before "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":" — snapshot must precede mutation."}],"type":"paragraph"}]}]}]}],"metadata":{"title":"Design Principles","modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/designprinciples"]}],"kind":"article","references":{"doc://Swidux/documentation/Swidux/Effect":{"url":"\/documentation\/swidux\/effect","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Effect","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"text":"An async unit of work returned by a reducer.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"Effect","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","title":"Effect"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"abstract":[{"text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system.","type":"text"}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","url":"\/documentation\/swidux\/architectureguide","type":"topic","title":"Architecture & Performance","role":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"title":"Plugin Architecture","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","url":"\/documentation\/swidux\/pluginarchitecture"},"doc://Swidux/documentation/Swidux/EntityStore":{"navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"role":"symbol","type":"topic","url":"\/documentation\/swidux\/entitystore","kind":"symbol","title":"EntityStore","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/ChangeSet":{"type":"topic","title":"ChangeSet","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","abstract":[{"text":"Tracks which entity IDs have been created\/updated or deleted.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChangeSet"}],"role":"symbol","url":"\/documentation\/swidux\/changeset","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ChangeSet"}]},"doc://Swidux/documentation/Swidux/BuildingYourFirstApp":{"abstract":[{"text":"Build a counter app from scratch and meet the four moving parts of a Swidux project: state, action, reducer, and store.","type":"text"}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingYourFirstApp","url":"\/documentation\/swidux\/buildingyourfirstapp","type":"topic","title":"Build Your First Swidux App","role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"url":"\/documentation\/swidux\/undoplugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","title":"UndoPlugin"},"doc://Swidux/documentation/Swidux":{"title":"Swidux","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"role":"collection","url":"\/documentation\/swidux","kind":"symbol"},"doc://Swidux/documentation/Swidux/Store/binding(_:sending:)":{"abstract":[{"type":"text","text":"Creates a SwiftUI "},{"code":"Binding","type":"codeVoice"},{"type":"text","text":" that reads a property through the"},{"type":"text","text":" "},{"type":"text","text":"observer tree and dispatches an action when written."}],"role":"symbol","type":"topic","kind":"symbol","title":"binding(_:sending:)","url":"\/documentation\/swidux\/store\/binding(_:sending:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"binding","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":">(","kind":"text"},{"preciseIdentifier":"s:s7KeyPathC","text":"KeyPath","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":".","kind":"text"},{"preciseIdentifier":"s:6Swidux0A10ObservableP8ObserverQa","text":"Observer","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"sending","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:7SwiftUI7BindingV","text":"Binding","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":">","kind":"text"}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"State","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"SwiduxObservable","type":"codeVoice"},{"type":"text","text":"."}]},"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/binding(_:sending:)"},"doc://Swidux/documentation/Swidux/StateWriter":{"title":"StateWriter","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/StateWriter","abstract":[{"type":"text","text":"Accumulates entity snapshots and produces batched async persistence work."}],"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"StateWriter"}],"role":"symbol","url":"\/documentation\/swidux\/statewriter","kind":"symbol","navigatorTitle":[{"text":"StateWriter","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/Send":{"abstract":[{"type":"text","text":"A function for dispatching actions back to the store from within an effect."}],"title":"Send","type":"topic","fragments":[{"kind":"keyword","text":"typealias"},{"text":" ","kind":"text"},{"kind":"identifier","text":"Send"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Send"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Send","url":"\/documentation\/swidux\/send"},"doc://Swidux/documentation/Swidux/PersistencePlugin":{"url":"\/documentation\/swidux\/persistenceplugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistencePlugin","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"text":"Coalescing persistence plugin.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"PersistencePlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","title":"PersistencePlugin"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"role":"symbol","url":"\/documentation\/swidux\/swiduxplugin","title":"SwiduxPlugin","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiduxPlugin"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","abstract":[{"type":"text","text":"A plugin that participates in the Swidux dispatch cycle."}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"SwiduxPlugin"}],"type":"topic"}}}