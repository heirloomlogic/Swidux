{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"anchor":"Essentials","title":"Essentials"}],"variants":[{"paths":["\/documentation\/swidux\/designprinciples"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"The philosophy behind Swidux’s approach to state management and persistence.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"Swidux is built around a small set of principles that keep persistence invisible and state management predictable.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Persistence-Is-Invisible","text":"Persistence Is Invisible"},{"inlineContent":[{"text":"Reducers mutate ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"text":" properties; the middleware handles database writes and load\/loaded action pairs. You never write ","type":"text"},{"type":"codeVoice","code":"db.save()"},{"text":" in a feature.","type":"text"}],"type":"paragraph"},{"text":"Synchronous State, Async Persistence","type":"heading","level":2,"anchor":"Synchronous-State-Async-Persistence"},{"inlineContent":[{"type":"text","text":"State updates synchronously in the reducer for instant UI feedback. Persistence happens asynchronously — rapid mutations coalesce behind a debounce timer so rapid taps produce a single database write."}],"type":"paragraph"},{"text":"Reducers Are Pure","type":"heading","level":2,"anchor":"Reducers-Are-Pure"},{"inlineContent":[{"text":"Reducers are pure state transformations. They accept ","type":"text"},{"type":"codeVoice","code":"inout State"},{"text":" and return an optional ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","type":"reference","isActive":true},{"text":" for async work. Side effects live in effects, not reducers.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Bind-to-the-Store-Not-to-State","text":"Bind to the Store, Not to @State"},{"inlineContent":[{"text":"Form inputs bind to the store via ","type":"text"},{"type":"codeVoice","code":"Binding(get:set:)"},{"text":" rather than ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" buffering. This keeps the store as the single source of truth and ensures every mutation flows through the reducer.","type":"text"}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples"},"kind":"article","sections":[],"metadata":{"title":"Design Principles","modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article"},"references":{"doc://Swidux/documentation/Swidux/GettingStarted":{"title":"Getting Started with Swidux","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","kind":"article","url":"\/documentation\/swidux\/gettingstarted","role":"article"},"doc://Swidux/documentation/Swidux/EntityStore":{"title":"EntityStore","navigatorTitle":[{"kind":"identifier","text":"EntityStore"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityStore"}],"type":"topic","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","url":"\/documentation\/swidux\/entitystore","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux/Effect":{"abstract":[{"type":"text","text":"An async unit of work returned by a reducer."}],"fragments":[{"kind":"keyword","text":"typealias"},{"kind":"text","text":" "},{"kind":"identifier","text":"Effect"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","type":"topic","kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"Effect"}],"title":"Effect","url":"\/documentation\/swidux\/effect"},"doc://Swidux/documentation/Swidux":{"title":"Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI with built-in persistence."}],"role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","url":"\/documentation\/swidux","type":"topic"}}}