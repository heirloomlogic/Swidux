dux/documentation/Swidux/ChangeSet":{"navigatorTitle":[{"text":"ChangeSet","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","title":"ChangeSet","abstract":[{"type":"text","text":"Tracks which entity IDs have been created\/updated or deleted."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChangeSet"}],"role":"symbol","type":"topic","url":"\/documentation\/swidux\/changeset"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"title":"UndoPlugin","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"role":"symbol","type":"topic","url":"\/documentation\/swidux\/undoplugin"},"doc://Swidux/documentation/Swidux/Store/binding(_:sending:)":{"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/binding(_:sending:)","title":"binding(_:sending:)","abstract":[{"text":"Creates a SwiftUI ","type":"text"},{"type":"codeVoice","code":"Binding"},{"text":" that reads a property through the","type":"text"},{"text":" ","type":"text"},{"text":"observer tree and dispatches an action when written.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"binding"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">("},{"preciseIdentifier":"s:s7KeyPathC","kind":"typeIdentifier","text":"KeyPath"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":"."},{"preciseIdentifier":"s:6Swidux0A10ObservableP8ObserverQa","kind":"typeIdentifier","text":"Observer"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"sending"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":") -> "},{"preciseIdentifier":"s:7SwiftUI7BindingV","kind":"typeIdentifier","text":"Binding"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">"}],"role":"symbol","type":"topic","conformance":{"constraints":[{"type":"codeVoice","code":"State"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"SwiduxObservable"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"url":"\/documentation\/swidux\/store\/binding(_:sending:)"},"doc://Swidux/documentation/Swidux/BuildingYourFirstApp":{"type":"topic","abstract":[{"text":"Build a counter app from scratch and meet the four moving parts of a Swidux project: state, action, reducer, and store.","type":"text"}],"title":"Build Your First Swidux App","role":"article","url":"\/documentation\/swidux\/buildingyourfirstapp","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingYourFirstApp","kind":"article"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"type":"topic","abstract":[{"text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system.","type":"text"}],"title":"Architecture & Performance","role":"article","url":"\/documentation\/swidux\/architectureguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","kind":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","title":"Plugin Architecture","url":"\/documentation\/swidux\/pluginarchitecture","type":"topic"},"doc://Swidux/documentation/Swidux/EntityStore":{"navigatorTitle":[{"kind":"identifier","text":"EntityStore"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","title":"EntityStore","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityStore"}],"role":"symbol","type":"topic","url":"\/documentation\/swidux\/entitystore"}}}