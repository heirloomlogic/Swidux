{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/designprinciples"]}],"kind":"article","identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","interfaceLanguage":"swift"},"abstract":[{"text":"The 10 rules that shape every Swidux app, and the reasoning behind them.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","doc:\/\/Swidux\/documentation\/Swidux\/BuildingYourFirstApp"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Explanation","generated":true,"title":"Explanation"}],"metadata":{"title":"Design Principles","role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Swidux’s surface area looks small — a "},{"type":"codeVoice","code":"Store"},{"type":"text","text":", a reducer protocol, a plugin protocol — but the API is opinionated. These principles explain "},{"type":"emphasis","inlineContent":[{"type":"text","text":"why"}]},{"type":"text","text":" the API has the shape it does, so you can extend it correctly."}],"type":"paragraph"},{"level":2,"anchor":"1-State-is-a-value-observation-is-a-class","text":"1. State is a value, observation is a class","type":"heading"},{"inlineContent":[{"type":"text","text":"State is a struct. Mutations go through "},{"type":"codeVoice","code":"inout State"},{"type":"text","text":", which is predictable, snapshottable, and testable. SwiftUI observation needs an "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" reference type. Reconciling these two requires a class that mirrors the struct."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" generates that class for you ("},{"type":"codeVoice","code":"<StructName>Observer"},{"type":"text","text":") and wires up the "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":" conformance that bridges the two. Don’t hand-write the observer. The "},{"type":"codeVoice","code":"pack → reduce → unpack-diff → observe"},{"type":"text","text":" cycle is what gives you per-property re-renders without coupling reducers to a class."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" extends this to nested struct slices: each slice gets its own observer class so observation stays granular even across composition."}],"type":"paragraph"},{"level":2,"anchor":"2-Reducers-are-pure-and-synchronous","text":"2. Reducers are pure and synchronous","type":"heading"},{"inlineContent":[{"type":"text","text":"Reducers take "},{"type":"codeVoice","code":"inout State"},{"type":"text","text":" and an "},{"type":"codeVoice","code":"Action"},{"type":"text","text":", mutate state in place, and return an optional "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","isActive":true},{"type":"text","text":". They never "},{"type":"codeVoice","code":"await"},{"type":"text","text":", never "},{"type":"codeVoice","code":"throw"},{"type":"text","text":", and never call I\/O directly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Why: pure synchronous mutations are trivially testable, deterministic, and snapshot-friendly. When you need async work (network, disk, timers), return an effect — a "},{"type":"codeVoice","code":"@Sendable"},{"type":"text","text":" async closure that runs off the MainActor and dispatches follow-up actions back through "},{"type":"codeVoice","code":"send"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"3-Effects-run-off-MainActor-sends-hop-back","text":"3. Effects run off MainActor; sends hop back","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"@Sendable (Send) async -> Void"},{"type":"text","text":". The "},{"type":"codeVoice","code":"Store"},{"type":"text","text":" runs effects in "},{"type":"codeVoice","code":"Task { @concurrent in }"},{"type":"text","text":" so they don’t block UI. "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Send","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"@MainActor @Sendable (Action) -> Void"},{"type":"text","text":", so dispatching from inside an effect always lands back on MainActor — no manual hops, no race conditions on state."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The split is deliberate: effects own the work, the reducer owns the state."}],"type":"paragraph"},{"level":2,"anchor":"4-Persistence-is-invisible","text":"4. Persistence is invisible","type":"heading"},{"inlineContent":[{"type":"text","text":"Reducers mutate "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" properties; "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" records every change in a "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","isActive":true},{"type":"text","text":"; "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true},{"type":"text","text":" debounces and drains those changesets through "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/StateWriter","isActive":true},{"type":"text","text":" closures."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You never write "},{"type":"codeVoice","code":"db.save()"},{"type":"text","text":" in a feature. A reducer that adds an item is identical whether the entity is persisted to SwiftData, SQLite, or nowhere — register or don’t register a writer. This is the principle that makes Swidux apps feel small: persistence stops being a concern of feature code."}],"type":"paragraph"},{"level":2,"anchor":"5-Synchronous-state-async-persistence","text":"5. Synchronous state, async persistence","type":"heading"},{"inlineContent":[{"type":"text","text":"State updates synchronously inside the reducer for instant UI feedback. Persistence happens asynchronously: "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" change tracking is in-memory and free; the debounced persistence flush coalesces rapid mutations into a single batched write."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Tap-tap-tap-tap on an increment button updates the UI on every tap and produces one DB write a moment later. Reducers stay synchronous; storage stays cheap."}],"type":"paragraph"},{"level":2,"anchor":"6-Plugins-are-the-single-extension-point","text":"6. Plugins are the single extension point","type":"heading"},{"inlineContent":[{"type":"text","text":"Everything that hangs off the dispatch cycle is a "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","isActive":true},{"type":"text","text":". Persistence, undo, killswitch, parental gate, paywall — same protocol, same lifecycle hooks. You can add your own without forking Swidux."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two structural patterns:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Core middleware"}],"type":"strong"},{"text":" (","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"text":", ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":") — action-agnostic. Doesn’t know your action type. Couples only to state shape (","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" for undo; ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" keypaths for persistence).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Domain plugins"}],"type":"strong"},{"text":" (","type":"text"},{"type":"codeVoice","code":"KillswitchPlugin"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ParentalGatePlugin"},{"text":", ","type":"text"},{"type":"codeVoice","code":"PaywallPlugin"},{"text":", your own) — owns a state slice and an action enum. Wires into your root types via keypath + action lifter + extractor.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"The decision rule: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"does this need to know your action type?"}]},{"type":"text","text":" If no, write core middleware and use "},{"type":"codeVoice","code":"willReduce"},{"type":"text","text":" or "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":". If yes, write a domain plugin and use "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"7-Bind-to-the-store-not-to-State","text":"7. Bind to the store, not to `@State`","type":"heading"},{"inlineContent":[{"type":"text","text":"Form inputs read from the store and dispatch on write. Use "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/binding(_:sending:)","isActive":true},{"type":"text","text":" for the common case (read one property, dispatch one action), and fall back to "},{"type":"codeVoice","code":"Binding(get:set:)"},{"type":"text","text":" when the read is a transformation (optional unwraps, derived values) or the setter wraps the dispatch in animation or branching. Don’t buffer mutable form state in "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" and write back on a button."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Why: every mutation flows through the reducer, which means undo\/redo, persistence, and any plugin that watches the dispatch cycle sees every keystroke (subject to coalescing). If you stash state in "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", those plugins are blind to it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The trade-off is more dispatches per keystroke. Coalescing — see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":" — collapses bursts of the same action into a single undo step."}],"type":"paragraph"},{"level":2,"anchor":"8-Registration-order-matters-at-the-boundaries","text":"8. Registration order matters at the boundaries","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":" snapshots in "},{"type":"codeVoice","code":"willReduce"},{"type":"text","text":", so it must run "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" any plugin or reducer mutates state — register it first. "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true},{"type":"text","text":" drains changelogs in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":", so it wants the post-mutation state — register it after undo. Domain plugins use only "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":", so their relative order rarely matters."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The recommended order:"}],"type":"paragraph"},{"code":["plugins.register(undoPlugin)         \/\/ 1. snapshots first","plugins.register(persistencePlugin)  \/\/ 2. drains after reducer","plugins.register(killswitchPlugin)   \/\/ 3. domain plugins","plugins.register(paywallPlugin)","plugins.register(parentalGatePlugin)"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"9-Strict-concurrency-on-purpose","text":"9. Strict concurrency, on purpose","type":"heading"},{"inlineContent":[{"type":"text","text":"Swidux is built for "},{"type":"codeVoice","code":"swiftLanguageMode(.v6)"},{"type":"text","text":" and assumes Swift 6 strict concurrency throughout. State must be "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":". The macros mark generated code carefully. Effects use explicit isolation ("},{"type":"codeVoice","code":"@Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":", "},{"type":"codeVoice","code":"@concurrent"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is friction at first — you’ll get warnings about "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" types. Honour them. The result is a state-management layer that composes safely with "},{"type":"codeVoice","code":"async\/await"},{"type":"text","text":" and SwiftData without the surprise data races you get from pre-Swift 6 designs."}],"type":"paragraph"},{"level":2,"anchor":"10-The-store-is-opinionated-your-app-is-not","text":"10. The store is opinionated; your app is not","type":"heading"},{"inlineContent":[{"type":"text","text":"Swidux gives you a "},{"type":"codeVoice","code":"Store"},{"type":"text","text":", a reducer protocol, a plugin protocol, and three optional plugins. It does not give you:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A dependency-injection container (write your own ","type":"text"},{"type":"codeVoice","code":"AppEnvironment"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A navigation library (use SwiftUI navigation).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A network layer (use ","type":"text"},{"type":"codeVoice","code":"URLSession"},{"text":", structured concurrency, or whatever you want).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"An opinion on database (SwiftData, GRDB, SQLite, Core Data — register a ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"text":" and Swidux doesn’t care).","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"The store owns one job: take an action, produce a new state, run effects. Everything else is yours."}],"type":"paragraph"},{"level":2,"anchor":"Anti-patterns","text":"Anti-patterns","type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"❌ ","type":"text"},{"type":"codeVoice","code":"await"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"try"},{"text":" inside a reducer — return an effect instead.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"❌ Hand-writing the observer class when you could use ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"❌ Calling ","type":"text"},{"type":"codeVoice","code":"db.save()"},{"text":" from inside a reducer — use ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/StateWriter"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"❌ Mutating state from inside an effect — effects dispatch actions; the reducer mutates.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"❌ Owning the store with ","type":"text"},{"type":"codeVoice","code":"@StateObject"},{"text":" — use ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" (","type":"text"},{"type":"codeVoice","code":"Store"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":", not ","type":"text"},{"type":"codeVoice","code":"ObservableObject"},{"text":").","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"❌ Buffering form state in ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" and committing on submit — bind to the store directly.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"❌ Registering ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"text":" before ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":" — snapshot must precede mutation.","type":"text"}]}]}]}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"references":{"doc://Swidux/documentation/Swidux/StateWriter":{"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"StateWriter","kind":"identifier"}],"title":"StateWriter","navigatorTitle":[{"text":"StateWriter","kind":"identifier"}],"abstract":[{"type":"text","text":"Accumulates entity snapshots and produces batched async persistence work."}],"url":"\/documentation\/swidux\/statewriter","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/StateWriter","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux/Store/binding(_:sending:)":{"type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"binding"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"KeyPath","preciseIdentifier":"s:s7KeyPathC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Observer","preciseIdentifier":"s:6Swidux0A10ObservableP8ObserverQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"sending"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Binding","preciseIdentifier":"s:7SwiftUI7BindingV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">"}],"title":"binding(_:sending:)","abstract":[{"type":"text","text":"Creates a SwiftUI "},{"code":"Binding","type":"codeVoice"},{"type":"text","text":" that reads a property through the"},{"type":"text","text":" "},{"type":"text","text":"observer tree and dispatches an action when written."}],"url":"\/documentation\/swidux\/store\/binding(_:sending:)","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/binding(_:sending:)","conformance":{"constraints":[{"code":"State","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"SwiduxObservable","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux":{"type":"topic","title":"Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"url":"\/documentation\/swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","role":"collection"},"doc://Swidux/documentation/Swidux/Send":{"type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Send","kind":"identifier"}],"title":"Send","navigatorTitle":[{"text":"Send","kind":"identifier"}],"abstract":[{"type":"text","text":"A function for dispatching actions back to the store from within an effect."}],"url":"\/documentation\/swidux\/send","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Send","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"title":"UndoPlugin","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"url":"\/documentation\/swidux\/undoplugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","title":"Plugin Architecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"url":"\/documentation\/swidux\/pluginarchitecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/ChangeSet":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","title":"ChangeSet","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Tracks which entity IDs have been created\/updated or deleted."}],"url":"\/documentation\/swidux\/changeset","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ChangeSet","kind":"identifier"}],"navigatorTitle":[{"text":"ChangeSet","kind":"identifier"}],"role":"symbol"},"doc://Swidux/documentation/Swidux/BuildingYourFirstApp":{"title":"Build Your First Swidux App","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingYourFirstApp","abstract":[{"text":"Build a counter app from scratch and meet the four moving parts of a Swidux project: state, action, reducer, and store.","type":"text"}],"type":"topic","kind":"article","url":"\/documentation\/swidux\/buildingyourfirstapp","role":"article"},"doc://Swidux/documentation/Swidux/PersistencePlugin":{"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistencePlugin","kind":"identifier"}],"title":"PersistencePlugin","navigatorTitle":[{"text":"PersistencePlugin","kind":"identifier"}],"abstract":[{"text":"Coalescing persistence plugin.","type":"text"}],"url":"\/documentation\/swidux\/persistenceplugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiduxPlugin"}],"title":"SwiduxPlugin","navigatorTitle":[{"kind":"identifier","text":"SwiduxPlugin"}],"abstract":[{"type":"text","text":"A plugin that participates in the Swidux dispatch cycle."}],"url":"\/documentation\/swidux\/swiduxplugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"type":"topic","title":"Architecture & Performance","abstract":[{"type":"text","text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system."}],"url":"\/documentation\/swidux\/architectureguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/Effect":{"type":"topic","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Effect","kind":"identifier"}],"title":"Effect","navigatorTitle":[{"text":"Effect","kind":"identifier"}],"abstract":[{"type":"text","text":"An async unit of work returned by a reducer."}],"url":"\/documentation\/swidux\/effect","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux/EntityStore":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}],"title":"EntityStore","navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"abstract":[{"type":"text","text":"An ordered, keyed collection of identifiable entities that silently records"},{"type":"text","text":" "},{"type":"text","text":"every mutation for downstream persistence."}],"url":"\/documentation\/swidux\/entitystore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","kind":"symbol","role":"symbol"}}}