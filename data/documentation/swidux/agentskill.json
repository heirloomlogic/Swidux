{"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article","title":"Using the Swidux Agent Skill"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"Swidux ships a companion agent skill (","type":"text"},{"type":"codeVoice","code":"swidux-ref"},{"text":") for AI coding assistants like Claude Code. It contains the architecture rules, conventions, and code templates an assistant needs to generate correct Swidux code without you re-explaining the patterns.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The skill is published in ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/skills"},{"text":" — Heirloom Logic’s public skills repo — alongside any future Heirloom skills. Two files:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SKILL.md"},{"type":"text","text":" — architecture rules (the 10 rules, the dispatch lifecycle, plugin shapes, anti-patterns)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"swidux-patterns.md","type":"codeVoice"},{"type":"text","text":" — copy-pasteable code templates for "},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", reducers, "},{"code":"AppStore","type":"codeVoice"},{"text":" factory, views, plugin wiring, and Swift Testing reducer tests.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Installing-the-skill","type":"heading","level":2,"text":"Installing the skill"},{"text":"GitHub CLI (recommended)","level":3,"anchor":"GitHub-CLI-recommended","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Requires ","type":"text"},{"code":"gh","type":"codeVoice"},{"text":" ≥ v2.90.0 (","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/cli.g