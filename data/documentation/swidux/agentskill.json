{"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Swidux ships a companion agent skill (","type":"text"},{"type":"codeVoice","code":"swidux-ref"},{"text":") for AI coding assistants like Claude Code. It contains the architecture rules, conventions, and code templates an assistant needs to generate correct Swidux code without you re-explaining the patterns.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The skill is published in ","type":"text"},{"identifier":"https:\/\/github.com\/heirloomlogic\/skills","isActive":true,"type":"reference"},{"text":" — Heirloom Logic’s public skills repo — alongside any future Heirloom skills. Two files:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"SKILL.md","type":"codeVoice"},{"text":" — architecture rules (the 10 rules, the dispatch lifecycle, plugin shapes, anti-patterns).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"swidux-patterns.md","type":"codeVoice"},{"text":" — copy-pasteable code templates for ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", reducers, "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" factory, views, plugin wiring, and Swift Testing reducer tests."}]}]}]},{"text":"Installing the skill","type":"heading","level":2,"anchor":"Installing-the-skill"},{"text":"GitHub CLI (recommended)","type":"heading","level":3,"anchor":"GitHub-CLI-recommended"},{"inlineContent":[{"text":"Requires ","type":"text"},{"type":"codeVoice","code":"gh"},{"text":" ≥ v2.90.0 (","type":"text"},{"identifier":"https:\/\/cli.github.com","type":"reference","isActive":true},{"text":").","type":"text"}],"type":"paragraph"},{"code":["gh skill install heirloomlogic\/skills swidux-ref --agent claude-code --scope user"],"type":"codeListing","syntax":"bash"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"--scope user"},{"type":"text","text":" installs to "},{"type":"codeVoice","code":"~\/.claude\/skills\/swidux-ref\/"},{"type":"text","text":" (loads in every project)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"--scope project"},{"type":"text","text":" installs to "},{"type":"codeVoice","code":"<cwd>\/.claude\/skills\/swidux-ref\/"},{"type":"text","text":" (commit it so the whole team gets it)."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Pin a version with "},{"type":"codeVoice","code":"swidux-ref@v1.2.3"},{"type":"text","text":". List tags with "},{"type":"codeVoice","code":"git ls-remote --tags https:\/\/github.com\/heirloomlogic\/skills"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Other agents: pass "},{"type":"codeVoice","code":"--agent codex"},{"type":"text","text":", "},{"type":"codeVoice","code":"--agent cursor"},{"type":"text","text":", "},{"code":"--agent gemini-cli","type":"codeVoice"},{"text":", etc. Run ","type":"text"},{"code":"gh skill install --help","type":"codeVoice"},{"text":" for the full list.","type":"text"}]}]}],"type":"unorderedList"},{"level":3,"text":"skills.sh","type":"heading","anchor":"skillssh"},{"syntax":"bash","type":"codeListing","code":["npx skillsadd heirloomlogic\/skills"]},{"type":"paragraph","inlineContent":[{"text":"Indexes the same source repo. Works without a GitHub CLI install.","type":"text"}]},{"level":3,"text":"Manual (no `gh`, no `npx`)","type":"heading","anchor":"Manual-no-gh-no-npx"},{"type":"paragraph","inlineContent":[{"text":"Claude Code uses ","type":"text"},{"type":"codeVoice","code":".claude\/skills\/"},{"text":". Codex, Cursor, Gemini CLI, and others use ","type":"text"},{"type":"codeVoice","code":"