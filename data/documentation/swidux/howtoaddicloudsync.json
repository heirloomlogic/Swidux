e":["import SwiduxPersistence","import SwiduxCloudKitSync","","let containerID = \"iCloud.com.yourcompany.yourapp\"","let mode = resolveDesiredSyncMode(from: env.keyValue)   \/\/ default .iCloud (opt-out)","","let container = try CloudContainerFactory.makeContainer(","    models: [CardModel.self],","    mode: mode,","    cloudKitContainerID: containerID",")","","let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container",")","plugins.register(persistence.corePlugin)","await persistence.hydrate(into: &initial)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"resolveDesiredSyncMode(from:)","type":"codeVoice"},{"text":" reads the persisted ","type":"text"},{"code":"KVKey.syncMode","type":"codeVoice"},{"text":". The default is ","type":"text"},{"inlineContent":[{"text":"sync-on with opt-out","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"code":".iCloud","type":"codeVoice"},{"text":") for any app that links this product; pass ","type":"text"},{"code":"default: .localOnly","type":"codeVoice"},{"text":" to make sync strictly opt-in instead.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Step 5: Wire the sync toggle","level":2,"anchor":"Step-5-Wire-the-sync-toggle"},{"type":"paragraph","inlineContent":[{"code":"SyncCoordinator","type":"codeVoice"},{"text":" owns the runtime toggle. Give it the persistence coordinator, the model list, the preflight probe, and your ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["let sync = SyncCoordinator<AppState, AppAction>(","    persistence: persistence,","    models: [CardModel.self],","    mode: mode,","    preflight: .live(containerID: containerID),","    keyValue: env.keyValue,","    cloudKitContainerID: containerID",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"From a Settings toggle, call "},{"type":"codeVoice","code":"setSyncEnabled(_:into:)"},{"type":"text","text":":"}]},{"code":["let status = await sync.setSyncEnabled(isOn, into: &state)","state.persistence.syncMode = sync.mode","state.persistence.syncStatus = status"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"setSyncEnabled","type":"codeVoice"},{"type":"text","text":" flushes pending writes, resolves availability, rebuilds the container in the "},{"type":"emphasis","inlineContent":[{"text":"effective","type":"text"}]},{"type":"text","text":" mode (CloudKit only when actually usable, else a local fallback), swaps the active database behind the coordinator’s handle, persists the user’s choice, and re-hydrates via "},{"code":"merge","type":"codeVoice"},{"type":"text","text":" (never replace). It returns the resolved "},{"code":"SyncStatus","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","text":"Step 6: Detect availability and degrade gracefully","level":2,"anchor":"Step-6-Detect-availability-and-degrade-gracefully"},{"type":"paragraph","inlineContent":[{"code":"SyncPreflightService","type":"codeVoice"},{"type":"text","text":" probes "},{"type":"codeVoice","code":"FileManager.ubiquityIdentityToken"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CKContainer.accountStatus"},{"type":"text","text":"; "},{"type":"codeVoice","code":"SyncStatus.resolve(desired:entitled:account:)"},{"type":"text","text":" maps the result to a verdict-in-state enum:"}]},{"type":"table","rows":[[[{"inlineContent":[{"code":"SyncStatus","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Meaning"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Response"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".localOnlyByChoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"User opted out"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Healthy; running on-device."}],"type":"