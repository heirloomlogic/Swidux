:"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":", used for analytics device-id) is a separate, always-present capability — it stays detected where it is and is not folded into the sync preflight.","type":"text"}]},{"type":"heading","level":2,"text":"Step 7: Observe remote changes","anchor":"Step-7-Observe-remote-changes"},{"type":"paragraph","inlineContent":[{"text":"Start a ","type":"text"},{"code":"RemoteChangeObserver","type":"codeVoice"},{"text":" while in cloud mode to pull in changes from other devices:","type":"text"}]},{"type":"codeListing","code":["let observer = RemoteChangeObserver(debounce: .seconds(2)) {","    await persistence.rehydrate(into: &state)   \/\/ merge, never replace","}","observer.start()"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":".NSPersistentStoreRemoteChange"},{"type":"text","text":" also fires for the app’s "},{"type":"emphasis","inlineContent":[{"text":"own","type":"text"}]},{"type":"text","text":" local saves. Because re-hydration always "},{"type":"strong","inlineContent":[{"type":"text","text":"merges preferring in-memory state"}]},{"type":"text","text":", feeding the app its own writes is a no-op — the rule-#8 data-loss trap is neutralized by construction. Call "},{"type":"codeVoice","code":"observer.stop()"},{"type":"text","text":" before a sync toggle (the coordinator rebuilds the container)."}],"type":"paragraph"},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":"The same merge rule makes mid-session sync "},{"type":"strong","inlineContent":[{"type":"text","text":"additive-only"}]},{"type":"text","text":". Rows created on another device appear live; remote "},{"type":"emphasis","inlineContent":[{"type":"text","text":"edits"}]},{"type":"text","text":" to entities already in memory and remote "},{"type":"emphasis","inlineContent":[{"text":"deletions","type":"text"}]},{"type":"text","text":" do "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" surface until the next launch (the in-memory value always wins, and a merge never removes). This is the deliberate trade against clobbering unflushed writes and live UI edits — set expectations accordingly in your UI, and don’t chase “stale until relaunch” reports as bugs."}],"type":"paragraph"}]},{"anchor":"What-the-privacy-toggle-does-and-doesnt","type":"heading","level":2,"text":"What the privacy toggle does (and doesn’t)"},{"type":"paragraph","inlineContent":[{"text":"Be accurate about CloudKit semantics in your UI copy:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Turning sync ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"off"}]},{"text":" is reversible and ","type":"text"},{"type":"strong","inlineContent":[{"text":"non-destructive","type":"text"}]},{"text":": it stops further syncing and keeps data on this device. Data already in the user’s private CloudKit database stays there until an explicit, confirmed delete — opt-out is ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" deletion."}]}]},{"content":[{"inlineContent":[{"text":"Turning sync ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"on"}]},{"text":" later merges local and server rows; it never clobbers.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Example UI copy: "},{"type":"emphasis","inlineContent":[{"type":"text","text":"“By default your data is stored only on this device. If you turn on iCloud Sync it is stored in your private iCloud account and synced across your devices. Turning it off stops syncing and keeps your data on-device; data already in iCloud remains in your account until you delete it.”"}]}]},{"level":2,"type":"heading","anchor":"Testing","text":"Testing"},{"type":"paragraph","inlineContent":[{"text":"The