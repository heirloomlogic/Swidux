{"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"],"anchor":"Related-Documentation"},{"generated":true,"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"sections":[],"variants":[{"paths":["\/documentation\/swidux\/howtoaddicloudsync"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","role":"article","title":"Add iCloud Sync","modules":[{"name":"Swidux"}]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"type":"text","text":" adds CloudKit mirroring to the persistence stack from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence"},{"type":"text","text":". The same generated "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" models and the same "},{"code":"PersistenceCoordinator","type":"codeVoice"},{"type":"text","text":" are reused; this works precisely because "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" generates "},{"type":"strong","inlineContent":[{"text":"CloudKit-safe","type":"text"}]},{"type":"text","text":" models — every non-optional attribute carries a default and every relationship is optional, so the schema validates when SwiftData builds the container with "},{"code":"cloudKitDatabase","type":"codeVoice"},{"type":"text","text":" set (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence"},{"type":"text","text":" for the default\/optionality rules and their diagnostics). Sync only changes how the "},{"code":"ModelContainer","type":"codeVoice"},{"type":"text","text":" is built ("},{"code":"cloudKitDatabase","type":"codeVoice"},{"type":"text","text":" set vs "},{"code":".none","type":"codeVoice"},{"type":"text","text":") and adds three things:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"a "},{"type":"strong","inlineContent":[{"text":"runtime sync toggle","type":"text"}]},{"type":"text","text":" ("},{"code":"SyncCoordinator","type":"codeVoice"},{"type":"text","text":") — because SwiftData fixes "},{"code":"cloudKitDatabase","type":"codeVoice"},{"type":"text","text":" at container creation, toggling rebuilds the container and swaps the active database behind the coordinator’s handle, never moving local rows;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"entitlement & account detection","type":"text"}]},{"type":"text","text":" ("},{"code":"SyncPreflightService","type":"codeVoice"},{"type":"text","text":" → "},{"code":"SyncStatus","type":"codeVoice"},{"type":"text","text":") — degrade to local-only and surface a status rather than crash;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"a "},{"type":"strong","inlineContent":[{"text":"merge-based remote-change observer","type":"text"}]},{"type":"text","text":" that ignores the app’s own saves."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Linking this product is the single signal that an app needs the iCloud \/ CloudKit \/ background-remote-notification entitlement family.","type":"text"}]},{"type":"text","text":" A local-only app links only "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Step-1-Configure-the-App-ID-iCloud-container-and-Push","level":2,"text":"Step 1: Configure the App ID, iCloud container, and Push"},{"type":"paragraph","inlineContent":[{"type":"text","text":"CloudKit sync requires capabilities on your App ID and a CloudKit container, configured in the Apple Developer portal at "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/account\/resources\/identifiers"},{"type":"text","text":"."}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Open Identifiers","type":"text"}]},{"type":"text","text":" at "},{"overridingTitle":"https:\/\/developer.apple.com\/account\/resources\/identifiers","identifier":"https:\/\/developer.apple.com\/account\/resources\/identifiers","type":"reference","overridingTitleInlineContent":[{"text":"https:\/\/developer.apple.com\/account\/resources\/identifiers","type":"text"}],"isActive":true},{"type":"text","text":". Select your app’s "},{"type":"strong","inlineContent":[{"text":"App ID","type":"text"}]},{"type":"text","text":" (or create one matching your bundle id, e.g. "},{"code":"com.yourcompany.yourapp","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Enable iCloud","type":"text"}]},{"type":"text","text":" in the App ID’s capability list, and choose "},{"type":"strong","inlineContent":[{"text":"Include CloudKit support","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Enable Push Notifications","type":"text"}]},{"type":"text","text":" on the same App ID. CloudKit delivers remote-change notifications over APNs, which is what drives "},{"code":".NSPersistentStoreRemoteChange","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Switch the Identifiers filter to "},{"type":"strong","inlineContent":[{"text":"iCloud Containers","type":"text"}]},{"type":"text","text":" and create a container named "},{"code":"iCloud.<your-bundle-id>","type":"codeVoice"},{"type":"text","text":" (e.g. "},{"code":"iCloud.com.yourcompany.yourapp","type":"codeVoice"},{"type":"text","text":"). Back on the App ID, "},{"type":"strong","inlineContent":[{"text":"assign that container","type":"text"}]},{"type":"text","text":" to it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Save. Xcode will regenerate the provisioning profile with these capabilities the next time it signs the app."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The resulting entitlements your built app must carry:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Entitlement","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Value","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"com.apple.developer.icloud-container-identifiers","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"[iCloud.com.yourcompany.yourapp]","type":"codeVoice"},{"text":" — ","type":"text"},{"inlineContent":[{"type":"text","text":"non-empty"}],"type":"strong"},{"text":", matching the id you pass in code","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"com.apple.developer.icloud-services","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"[CloudKit]","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"aps-environment","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"development","type":"codeVoice"},{"text":" in dev builds, ","type":"text"},{"code":"production","type":"codeVoice"},{"type":"text","text":" in release archives"}]}]]]},{"name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"An "},{"inlineContent":[{"type":"text","text":"empty"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"icloud-container-identifiers"},{"type":"text","text":" array paired with a "},{"type":"codeVoice","code":"CloudKit"},{"type":"text","text":" services line is misconfiguration, not sync — "},{"type":"codeVoice","code":"SyncPreflightService"},{"type":"text","text":" will report the app as unavailable. The container id in the portal, the entitlement, and the "},{"type":"codeVoice","code":"cloudKitContainerID"},{"type":"text","text":" you pass in code must all match."}]}],"type":"aside"},{"level":2,"text":"Step 2: Add the capabilities in Xcode","anchor":"Step-2-Add-the-capabilities-in-Xcode","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"In your app target’s ","type":"text"},{"inlineContent":[{"type":"text","text":"Signing & Capabilities"}],"type":"strong"},{"text":" tab:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"+ Capability → iCloud.","type":"text"}]},{"type":"text","text":" Check "},{"type":"strong","inlineContent":[{"text":"CloudKit","type":"text"}]},{"type":"text","text":", then select the "},{"type":"codeVoice","code":"iCloud.<your-bundle-id>"},{"type":"text","text":" container you created."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"+ Capability → Background Modes.","type":"text"}]},{"text":" Check ","type":"text"},{"type":"strong","inlineContent":[{"text":"Remote notifications","type":"text"}]},{"text":" so the app can receive CloudKit’s silent push that fires ","type":"text"},{"type":"codeVoice","code":".NSPersistentStoreRemoteChange"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Push Notifications"}],"type":"strong"},{"type":"text","text":" is added automatically with CloudKit; confirm it’s present."}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"For a SwiftPM-defined app, add the matching keys to your "},{"code":".entitlements","type":"codeVoice"},{"type":"text","text":" file and reference it from the target’s "},{"code":"CODE_SIGN_ENTITLEMENTS","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Step 3: Add the dependency","type":"heading","anchor":"Step-3-Add-the-dependency"},{"syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPersistence\",","        \"SwiduxCloudKitSync\",","    ]",")"],"type":"codeListing"},{"level":2,"text":"Step 4: Build a sync-mode container at launch","type":"heading","anchor":"Step-4-Build-a-sync-mode-container-at-launch"},{"inlineContent":[{"type":"text","text":"Read the user’s desired mode "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" building the container (the mode determines the "},{"code":"ModelConfiguration","type":"codeVoice"},{"type":"text","text":"), then build with "},{"code":"CloudContainerFactory","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxPersistence","import SwiduxCloudKitSync","","let containerID = \"iCloud.com.yourcompany.yourapp\"","let mode = resolveDesiredSyncMode(from: env.keyValue)   \/\/ default .iCloud (opt-out)","","let container = try CloudContainerFactory.makeContainer(","    models: [CardModel.self],","    mode: mode,","    cloudKitContainerID: containerID",")","","let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container",")","plugins.register(persistence.corePlugin)","await persistence.hydrate(into: &initial)"],"type":"codeListing"},{"inlineContent":[{"code":"resolveDesiredSyncMode(from:)","type":"codeVoice"},{"type":"text","text":" reads the persisted "},{"code":"KVKey.syncMode","type":"codeVoice"},{"type":"text","text":". The default is "},{"type":"strong","inlineContent":[{"type":"text","text":"sync-on with opt-out"}]},{"type":"text","text":" ("},{"code":".iCloud","type":"codeVoice"},{"type":"text","text":") for any app that links this product; pass "},{"code":"default: .localOnly","type":"codeVoice"},{"type":"text","text":" to make sync strictly opt-in instead."}],"type":"paragraph"},{"level":2,"text":"Step 5: Wire the sync toggle","type":"heading","anchor":"Step-5-Wire-the-sync-toggle"},{"inlineContent":[{"code":"SyncCoordinator","type":"codeVoice"},{"type":"text","text":" owns the runtime toggle. Give it the persistence coordinator, the model list, the preflight probe, and your "},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let sync = SyncCoordinator<AppState, AppAction>(","    persistence: persistence,","    models: [CardModel.self],","    mode: mode,","    preflight: .live(containerID: containerID),","    keyValue: env.keyValue,","    cloudKitContainerID: containerID",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"From a Settings toggle, call "},{"code":"setSyncEnabled(_:into:)","type":"codeVoice"},{"type":"text","text":" with the "},{"type":"strong","inlineContent":[{"type":"text","text":"store"}]},{"type":"text","text":", then record the result with a normal dispatch:"}]},{"type":"codeListing","syntax":"swift","code":["let status = await sync.setSyncEnabled(isOn, into: store)","store.send(.syncSettingsChanged(mode: sync.mode, status: status))"]},{"type":"paragraph","inlineContent":[{"code":"setSyncEnabled","type":"codeVoice"},{"text":" flushes pending writes, resolves availability, rebuilds the container in the ","type":"text"},{"inlineContent":[{"type":"text","text":"effective"}],"type":"emphasis"},{"type":"text","text":" mode (CloudKit only when actually usable, else a local fallback), swaps the active database behind the coordinator’s handle, persists the user’s choice, and re-hydrates via "},{"code":"merge","type":"codeVoice"},{"type":"text","text":" (never replace). It returns the resolved "},{"code":"SyncStatus","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It takes the store rather than "},{"type":"codeVoice","code":"inout State"},{"type":"text","text":" because all of that is asynchronous. Every one of those "},{"code":"await","type":"codeVoice"},{"type":"text","text":"s is a window in which the user can keep editing, and a caller holding a state snapshot across them would overwrite whatever landed. Here the flush, preflight, and rebuild all complete first; only then does one suspension-free step pack a fresh snapshot, merge, and unpack. Nothing can interleave between that pack and the follow-up "},{"code":"send","type":"codeVoice"},{"type":"text","text":" either — the main actor can only be re-entered at a suspension point, and there is none."}]},{"level":2,"type":"heading","text":"Step 6: Detect availability and degrade gracefully","anchor":"Step-6-Detect-availability-and-degrade-gracefully"},{"type":"paragraph","inlineContent":[{"code":"SyncPreflightService","type":"codeVoice"},{"type":"text","text":" probes "},{"code":"FileManager.ubiquityIdentityToken","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CKContainer.accountStatus","type":"codeVoice"},{"type":"text","text":"; "},{"code":"SyncStatus.resolve(desired:entitled:account:)","type":"codeVoice"},{"type":"text","text":" maps the result to a verdict-in-state enum:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"code":"SyncStatus","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Meaning","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Response","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".localOnlyByChoice","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"User opted out","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Healthy; running on-device.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".syncing","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Entitled, signed in, active","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Healthy.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".unavailableNotSignedIn","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Entitled, no iCloud account","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Show a gentle “Sign in to iCloud” banner; never assert.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".unavailableRestricted","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"MDM\/parental restriction","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Inform; run local-only.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".misconfiguredNoEntitlement","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Sync requested but ","type":"text"},{"inlineContent":[{"text":"not entitled","type":"text"}],"type":"strong"},{"text":" — a build\/signing bug","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Degrade to local-only; ","type":"text"},{"code":"assertionFailure","type":"codeVoice"},{"text":" in ","type":"text"},{"inlineContent":[{"text":"DEBUG only","type":"text"}],"type":"strong"},{"text":", never crash release.","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Run the probe at launch and on "},{"code":"scenePhase → .active","type":"codeVoice"},{"type":"text","text":", and disable the Settings toggle when the status isn’t actionable by the user:"}]},{"code":["let status = await sync.currentStatus()","state.persistence.syncStatus = status"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Keychain "},{"code":"−34018","type":"codeVoice"},{"type":"text","text":" condition (from "},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":", used for analytics device-id) is a separate, always-present capability — it stays detected where it is and is not folded into the sync preflight."}]},{"level":2,"type":"heading","text":"Step 7: Observe remote changes","anchor":"Step-7-Observe-remote-changes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start a "},{"code":"RemoteChangeObserver","type":"codeVoice"},{"type":"text","text":" while in cloud mode to pull in changes from other devices:"}]},{"code":["let observer = RemoteChangeObserver(debounce: .seconds(2)) { [weak store] in","    guard let store else { return }","    await persistence.mergeChanges(into: store)   \/\/ merge, never replace","}","observer.start()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Capture the store "},{"type":"strong","inlineContent":[{"text":"weakly","type":"text"}]},{"type":"text","text":": the observer usually outlives the view layer, and is typically held by the same object that holds the store."}]},{"type":"paragraph","inlineContent":[{"code":"mergeChanges(into:)","type":"codeVoice"},{"type":"text","text":" reads the store’s persistent-history log to find out "},{"type":"emphasis","inlineContent":[{"text":"which","type":"text"}]},{"type":"text","text":" rows changed since the last tick and merges only those, so a tick on an N-row table where k rows changed costs O(k) rather than re-reading every table. A tick with nothing behind it costs one history fetch and stops there."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It falls back to a full "},{"code":"rehydrate(into:)","type":"codeVoice"},{"type":"text","text":" for any window it can’t fully account for — the first tick after launch or a container rebuild, an expired or failed history read, a deletion recorded before "},{"code":"@Attribute(.preserveValueOnDeletion)","type":"codeVoice"},{"type":"text","text":" shipped, or more than one store behind the container. The fallback is not a weakening: it keeps the empty-snapshot guard, and it re-establishes the watermark on the way through. Watch "},{"code":"PersistenceDiagnostic\/Kind\/historyUnavailable","type":"codeVoice"},{"type":"text","text":" if you want to know when it happens; seeing it on every tick means something is stopping the watermark advancing, and "},{"code":"fallbackReason","type":"codeVoice"},{"type":"text","text":" says what."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The watermark lives for one session and is discarded whenever the container is swapped. There is nothing to persist across launches: state starts empty, so launch does a full "},{"code":"hydrate(into:)","type":"codeVoice"},{"type":"text","text":" read regardless, and a stored token could only ever describe rows that never reached memory."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calling "},{"code":"rehydrate(into:)","type":"codeVoice"},{"type":"text","text":" from the observer instead still works and is still correct — it is just O(N) per tick."}]},{"type":"paragraph","inlineContent":[{"code":".NSPersistentStoreRemoteChange","type":"codeVoice"},{"type":"text","text":" also fires for the app’s "},{"type":"emphasis","inlineContent":[{"text":"own","type":"text"}]},{"type":"text","text":" local saves. Feeding the app its own writes is a no-op: the rows it reads back are the ones it just wrote, and anything still pending is exempt from the merge, so the rule-#8 data-loss trap is neutralized by construction. Call "},{"code":"observer.stop()","type":"codeVoice"},{"type":"text","text":" before a sync toggle (the coordinator rebuilds the container)."}]},{"type":"aside","style":"warning","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"text":"Do not hand-roll this by snapshotting state around the ","type":"text"},{"code":"await","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","code":["var snapshot = AppState(observer: store.observer)   \/\/ ← packed BEFORE the awaits","await persistence.rehydrate(into: &snapshot)        \/\/ ← the user keeps typing here…","AppState.apply(snapshot, to: store.observer)        \/\/ ← …and those edits are gone"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"That loses every write dispatched while the flush and fetches are in flight, and it surfaces as intermittently vanishing keystrokes rather than as an obvious failure. ","type":"text"},{"code":"rehydrate(into:)","type":"codeVoice"},{"text":" takes the store precisely so this shape has no reason to exist; for your own async work, use ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"By default ("},{"code":"MergePolicy.preferRemote","type":"codeVoice"},{"type":"text","text":") remote creations, edits, "},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" deletions all surface mid-session. An ID is exempt whenever the local side still has something to say about it — an un-drained edit, a drained-but-unflushed write, a pending deletion, or a write whose save failed. Those always win, and that guarantee is not configurable."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three things are worth knowing:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"An empty snapshot never removes anything."}],"type":"strong"},{"text":" Zero rows is indistinguishable from a store that is rebuilt, mid-import, or unreadable, so absence is only treated as deletion when the snapshot is non-empty. Toggling sync uses ","type":"text"},{"code":".preferRemoteAdditive","type":"codeVoice"},{"text":" for the same reason: the rebuilt container is a ","type":"text"},{"inlineContent":[{"type":"text","text":"different"}],"type":"emphasis"},{"text":" store, so what it lacks proves nothing. This applies to the whole-table read, where absence is the only evidence there is. ","type":"text"},{"code":"mergeChanges(into:)","type":"codeVoice"},{"text":" reads deletions from history tombstones, which ","type":"text"},{"inlineContent":[{"type":"text","text":"are"}],"type":"emphasis"},{"text":" evidence, so it needs no such guard and can remove the last surviving row.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"An edit that hasn’t been dispatched yet is invisible."}],"type":"strong"},{"text":" A value still sitting in a view’s local ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" is unknown to the store, so a remote value can land underneath it. Declare it with an editing hold — see below.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Undo can’t resurrect a remote deletion."}],"type":"strong"},{"text":" Once a deletion made elsewhere surfaces, ","type":"text"},{"code":"restore(from:)","type":"codeVoice"},{"text":" skips that ID — otherwise an older undo snapshot would write the row back as a ","type":"text"},{"inlineContent":[{"type":"text","text":"creation"}],"type":"emphasis"},{"text":" and re-seed every peer. The ID becomes undoable again if the user recreates it or the row returns to disk. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"level":3,"type":"heading","text":"Protecting an edit in progress","anchor":"Protecting-an-edit-in-progress"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every exemption above is inferred from something the store has seen. A value a view is holding in local "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" — a half-typed title, a slider mid-drag — is not one of those, and by default the merge writes over it. Three answers, cheapest first."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Dispatch on write.","type":"text"}]},{"type":"text","text":" "},{"code":"store.binding(_:sending:)","type":"codeVoice"},{"type":"text","text":" sends an action on every change, which makes the value a drained-but-unflushed write and covers it already. That is enough for a stepper, a toggle, a picker."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Hold the entity for the length of the edit.","type":"text"}]},{"type":"text","text":" In a text editor, where a dispatch per keystroke is too much, declare the edit instead:"}]},{"code":["TextEditor(text: $draft)","    .holdsEntity(note.id, in: persistence.editing)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The hold is taken when the editor appears and given back when it goes away, so there is no release to forget. Pass "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to hold nothing, and a "},{"code":"@FocusState","type":"codeVoice"},{"type":"text","text":"-driven id arms and disarms the hold as focus moves. "},{"code":"persistence.editing.hold(_:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"release(_:)","type":"codeVoice"},{"type":"text","text":" are there for an editing session that isn’t a view’s lifetime; they refcount, so two views editing one entity compose rather than cancel."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A hold "},{"type":"strong","inlineContent":[{"text":"defers a remote change, it does not veto one.","type":"text"}]},{"type":"text","text":" Release it and the next merge applies whatever storage holds, deletions included, so the worst a leaked hold can do is strand one row at a stale value. It won’t do that quietly either: a merge that actually withheld a differing value reports "},{"code":".mergeWithheld","type":"codeVoice"},{"type":"text","text":" on the diagnostic channel."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Turn remote-wins off for the whole collection.","type":"text"}]},{"type":"text","text":" The blunt instrument, for a store where a remote edit arriving under the cursor is always worse than a stale row:"}]},{"code":[".entity(\\.documents, policy: .preferInMemory)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"That one is permanent and collection-wide — no document ever takes a remote edit mid-session. Register it when that is what you want, not as a stand-in for a hold."}]},{"level":2,"type":"heading","text":"Step 8: Duplicates (optional)","anchor":"Step-8-Duplicates-optional"},{"type":"paragraph","inlineContent":[{"type":"text","text":"CloudKit forbids unique constraints, so "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" generates none — and two devices can legitimately end up holding two rows for the same entity. This is handled for you by default: writes update every matching row, deletions remove every matching row, and reads collapse to one value per "},{"code":"id","type":"codeVoice"},{"type":"text","text":". Duplicates cost storage and nothing else, so most apps can stop here."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two situations are worth an explicit resolver:"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Duplicate ","type":"text"},{"code":"id","type":"codeVoice"},{"text":"s.","type":"text"}]},{"type":"text","text":" Converge them on a winner you choose:"}]},{"code":[".entity(\\.cards, collapse: EntityCollapse.byID { $0.updatedAt >= $1.updatedAt ? $0 : $1 })"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Singletons.","type":"text"}]},{"type":"text","text":" An entity your app holds exactly one of — app settings, a profile — created independently on two fresh installs has two "},{"type":"emphasis","inlineContent":[{"text":"different","type":"text"}]},{"type":"text","text":" UUIDs, so nothing pairs them and no "},{"code":"id","type":"codeVoice"},{"type":"text","text":"-keyed resolver can ever see the conflict. Merge them by hand:"}]},{"code":[".entity(\\.settings, collapse: { rows in","    guard rows.count > 1 else { return rows }","    \/\/ `id` is replicated, so min-by-UUID is the same choice on every device.","    let winner = rows.min { $0.id.uuidString < $1.id.uuidString }!","    return [rows.dropFirst().reduce(winner) { $0.merging($1) }]","})"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Resolvers run on hydration and re-hydration; call "},{"code":"persistence.collapseDuplicates(into:)","type":"codeVoice"},{"type":"text","text":" for an on-demand “repair my data” action."}]},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"A resolver must be a pure function of ","type":"text"},{"inlineContent":[{"text":"replicated content","type":"text"}],"type":"strong"},{"text":" — never ","type":"text"},{"code":"persistentModelID","type":"codeVoice"},{"text":", a local timestamp, or array position — so every device computes the same answer. It must also be idempotent (asserted in debug builds).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note what a resolver can and cannot remove. Dropping an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" deletes it everywhere, and that is safe because ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" is replicated: every device independently decides to delete the same thing. Rows that ","type":"text"},{"inlineContent":[{"text":"share","type":"text"}],"type":"emphasis"},{"text":" a surviving ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" are converged onto the winner’s value but never deleted — nothing replicated distinguishes them, so two devices could each keep a different physical row, tombstone the other’s, and lose both.","type":"text"}]}]},{"level":2,"type":"heading","text":"What the privacy toggle does (and doesn’t)","anchor":"What-the-privacy-toggle-does-and-doesnt"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Be accurate about CloudKit semantics in your UI copy:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Turning sync ","type":"text"},{"inlineContent":[{"type":"text","text":"off"}],"type":"strong"},{"text":" is reversible and ","type":"text"},{"inlineContent":[{"type":"text","text":"non-destructive"}],"type":"strong"},{"text":": it stops further syncing and keeps data on this device. Data already in the user’s private CloudKit database stays there until an explicit, confirmed delete — opt-out is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" deletion.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Turning sync ","type":"text"},{"inlineContent":[{"type":"text","text":"on"}],"type":"strong"},{"text":" later merges local and server rows; it never clobbers.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Example UI copy: "},{"type":"emphasis","inlineContent":[{"text":"“By default your data is stored only on this device. If you turn on iCloud Sync it is stored in your private iCloud account and synced across your devices. Turning it off stops syncing and keeps your data on-device; data already in iCloud remains in your account until you delete it.”","type":"text"}]}]},{"level":2,"type":"heading","text":"Testing","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The pure parts are unit-testable without entitlements: "},{"code":"SyncStatus.resolve(desired:entitled:account:)","type":"codeVoice"},{"type":"text","text":" (truth table), "},{"code":"SyncPreflightService.mock(ubiquityToken:account:)","type":"codeVoice"},{"type":"text","text":", the "},{"code":"KVKey.syncMode","type":"codeVoice"},{"type":"text","text":" round-trip, and the opt-out toggle path against an in-memory container. Real two-device CloudKit mirroring requires entitlements and a signed-in device, so cover it with a manual smoke test: two-device sync, opt-out keeps data local, opt-in merges, signed-out iCloud degrades with a banner, and a build missing the entitlement trips the DEBUG assertion."}]}]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},"references":{"doc://Swidux/documentation/Swidux/UndoPlugin":{"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","title":"UndoPlugin","url":"\/documentation\/swidux\/undoplugin","type":"topic","abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","title":"Add Persistence","url":"\/documentation\/swidux\/howtoaddpersistence","type":"topic","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"role":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","title":"EntityStore","url":"\/documentation\/swidux\/entitystoreguide","type":"topic","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","title":"KeyValueStore","url":"\/documentation\/swidux\/keyvaluestoreguide","type":"topic","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"role":"collectionGroup"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","title":"Add Analytics","url":"\/documentation\/swidux\/howtoaddanalytics","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"role":"article"},"doc://Swidux/documentation/Swidux":{"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux","url":"\/documentation\/swidux","type":"topic","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"role":"collection"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","title":"Cancel Effects","url":"\/documentation\/swidux\/howtocanceleffects","type":"topic","abstract":[{"text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code.","type":"text"}],"role":"article"},"https://developer.apple.com/account/resources/identifiers":{"type":"link","title":"https:\/\/developer.apple.com\/account\/resources\/identifiers","identifier":"https:\/\/developer.apple.com\/account\/resources\/identifiers","titleInlineContent":[{"type":"text","text":"https:\/\/developer.apple.com\/account\/resources\/identifiers"}],"url":"https:\/\/developer.apple.com\/account\/resources\/identifiers"},"doc://Swidux/documentation/Swidux/AgentSkill":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","title":"Using the Swidux Agent Skill","url":"\/documentation\/swidux\/agentskill","type":"topic","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","title":"Add a Parental Gate","url":"\/documentation\/swidux\/howtoaddaparentalgate","type":"topic","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"role":"article"},"doc://Swidux/documentation/Swidux/Store/mutate(awaiting:merging:)":{"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","title":"mutate(awaiting:merging:)","url":"\/documentation\/swidux\/store\/mutate(awaiting:merging:)","type":"topic","abstract":[{"text":"Runs async work that must not hold state across its suspensions, then","type":"text"},{"text":" ","type":"text"},{"text":"folds the result into a ","type":"text"},{"inlineContent":[{"text":"freshly packed","type":"text"}],"type":"strong"},{"text":" snapshot in one","type":"text"},{"text":" ","type":"text"},{"text":"suspension-free step.","type":"text"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mutate","kind":"identifier"},{"text":"<","kind":"text"},{"text":"Value","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"awaiting","kind":"externalParam"},{"text":": () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"merging","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rethrows","kind":"keyword"}]},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","title":"Add Feature Flags","url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"role":"article"},"doc://Swidux/documentation/Swidux/UndoRedo":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","title":"Undo \/ Redo","url":"\/documentation\/swidux\/undoredo","type":"topic","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":".","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"role":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"type":"topic","url":"\/documentation\/swidux\/buildingadomainplugin","title":"Building a Domain Plugin","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","title":"Add a Version Killswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","type":"topic","abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"role":"article"}}}