eflightService","type":"codeVoice"},{"type":"text","text":" → "},{"code":"SyncStatus","type":"codeVoice"},{"type":"text","text":") — degrade to local-only and surface a status rather than crash;"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"merge-based remote-change observer"}]},{"text":" that ignores the app’s own saves.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"inlineContent":[{"text":"Linking this product is the single signal that an app needs the iCloud \/ CloudKit \/ background-remote-notification entitlement family.","type":"text"}],"type":"strong"},{"text":" A local-only app links only ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Step 1: Configure the App ID, iCloud container, and Push","anchor":"Step-1-Configure-the-App-ID-iCloud-container-and-Push","type":"heading"},{"inlineContent":[{"type":"text","text":"CloudKit sync requires capabilities on your App ID and a CloudKit container, configured in the Apple Developer portal at "},{"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/account\/resources\/identifiers"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Open Identifiers"}]},{"type":"text","text":" at "},{"overridingTitleInlineContent":[{"type":"text","text":"https:\/\/developer.apple.com\/account\/resources\/identifiers"}],"type":"reference","isActive":true,"identifier":"https:\/\/developer.apple.com\/account\/resources\/identifiers","overridingTitle":"https:\/\/developer.apple.com\/account\/resources\/identifiers"},{"type":"text","text":". Select your app’s "},{"type":"strong","inlineContent":[{"type":"text","text":"App ID"}]},{"type":"text","text":" (or create one matching your bundle id, e.g. "},{"type":"codeVoice","code":"com.yourcompany.yourapp"},{"type":"text","text":")."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Enable iCloud"}],"type":"strong"},{"text":" in the App ID’s capability list, and choose ","type":"text"},{"inlineContent":[{"type":"text","text":"Include CloudKit support"}],"type":"strong"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Enable Push Notifications","type":"text"}]},{"type":"text","text":" on the same App ID. CloudKit delivers remote-change notifications over APNs, which is what drives "},{"type":"codeVoice","code":".NSPersistentStoreRemoteChange"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Switch the Identifiers filter to "},{"inlineContent":[{"text":"iCloud Containers","type":"text"}],"type":"strong"},{"type":"text","text":" and create a container named "},{"type":"codeVoice","code":"iCloud.<your-bundle-id>"},{"type":"text","text":" (e.g. "},{"type":"codeVoice","code":"iCloud.com.yourcompany.yourapp"},{"type":"text","text":"). Back on the App ID, "},{"inlineContent":[{"type":"text","text":"assign that container"}],"type":"strong"},{"type":"text","text":" to it."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Save. Xcode will regenerate the provisioning profile with these capabilities the next time it signs the app."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The resulting entitlements your built app must carry:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Entitlement","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Value","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"com.apple.developer.icloud-container-identifiers"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"[iCloud.com.yourcompany.yourapp]"},{"type":"te