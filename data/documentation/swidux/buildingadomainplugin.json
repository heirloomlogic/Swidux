{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/buildingadomainplugin"]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"metadata":{"title":"Building a Domain Plugin","roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article"},"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"Domain plugins follow a consistent pattern: define feature state and actions, implement the ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","type":"reference","isActive":true},{"text":" protocol using the ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" hook, and wire the plugin into the host app at registration time. This guide walks through building a plugin from scratch.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The example builds a fictional “Announcements” plugin that fetches a remote message and displays it."}],"type":"paragraph"},{"text":"The Three Wiring Pieces","level":2,"anchor":"The-Three-Wiring-Pieces","type":"heading"},{"inlineContent":[{"text":"Every domain plugin stores three closures that bridge its local types to the host app’s root types:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"State keypath","type":"text"}]},{"type":"text","text":" — "},{"code":"WritableKeyPath<RootState, FeatureState>","type":"codeVoice"},{"type":"text","text":" locates the plugin’s state slice within root state."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action lifter"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"(FeatureAction) -> RootAction"},{"type":"text","text":" wraps local actions into the root action enum."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Action extractor"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"(RootAction) -> FeatureAction?","type":"codeVoice"},{"text":" downcasts root actions to the plugin’s local type, returning ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for actions that belong to other features.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"These are closures, not protocols. The host app provides them at init — no associated-type gymnastics or conformance wiring needed."}]},{"type":"heading","anchor":"Step-1-Define-Feature-State","level":2,"text":"Step 1: Define Feature State"},{"type":"codeListing","code":["public struct AnnouncementState: Sendable, Equatable {","    public var message: String?","    public var isLoading: Bool","    public var error: String?","","    public init(","        message: String? = nil,","        isLoading: Bool = false,","        error: String? = nil","    ) {","        self.message = message","        self.isLoading = isLoading","        self.error = error","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep state minimal — only what the UI needs to render and the reducer needs to decide."}]},{"type":"heading","anchor":"Step-2-Define-Feature-Actions","level":2,"text":"Step 2: Define Feature Actions"},{"type":"codeListing","code":["public enum AnnouncementAction: Sendable {","    case fetch","    case messageReceived(String?)","    case fetchFailed(String)","    case dismiss","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Actions are the plugin’s public API. The host app dispatches them by wrapping in the root action enum.","type":"text"}]},{"type":"heading","anchor":"Step-3-Define-the-Service","level":2,"text":"Step 3: Define the Service"},{"type":"paragraph","inlineContent":[{"text":"Inject async dependencies as a struct with closure properties. This makes testing trivial — swap closures instead of subclassing or mocking protocols.","type":"text"}]},{"code":["public struct AnnouncementService: Sendable {","    public var fetch: @Sendable () async throws -> String?","","    public init(fetch: @escaping @Sendable () async throws -> String?) {","        self.fetch = fetch","    }","","    public static func mock(message: String? = \"Test\") -> Self {","        AnnouncementService { message }","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-4-Implement-the-Plugin","level":2,"type":"heading","text":"Step 4: Implement the Plugin"},{"code":["import Swidux","","@MainActor","public struct AnnouncementPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    private let stateKeyPath: WritableKeyPath<RootState, AnnouncementState>","    private let toRootAction: @Sendable (AnnouncementAction) -> RootAction","    private let extractAction: @Sendable (RootAction) -> AnnouncementAction?","    private let service: AnnouncementService","","    public init(","        state: WritableKeyPath<RootState, AnnouncementState>,","        action toRootAction: @escaping @Sendable (AnnouncementAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> AnnouncementAction?,","        service: AnnouncementService","    ) {","        self.stateKeyPath = state","        self.toRootAction = toRootAction","        self.extractAction = extractAction","        self.service = service","    }","","    public func reduce(","        state: inout RootState,","        action: RootAction","    ) -> Effect<RootAction>? {","        guard let local = extractAction(action) else { return nil }","        let localEffect = reduceLocal(","            state: &state[keyPath: stateKeyPath],","            action: local","        )","        guard let localEffect else { return nil }","        let lift = toRootAction","        return { send in","            await localEffect { localAction in","                send(lift(localAction))","            }","        }","    }","","    private func reduceLocal(","        state: inout AnnouncementState,","        action: AnnouncementAction","    ) -> Effect<AnnouncementAction>? {","        switch action {","        case .fetch:","            state.isLoading = true","            let service = self.service","            return { send in","                do {","                    let message = try await service.fetch()","                    await send(.messageReceived(message))","                } catch {","                    await send(.fetchFailed(error.localizedDescription))","                }","            }","","        case .messageReceived(let message):","            state.message = message","            state.isLoading = false","            state.error = nil","","        case .fetchFailed(let message):","            state.isLoading = false","            state.error = message","","        case .dismiss:","            state.message = nil","        }","        return nil","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The public ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" method follows a fixed pattern: guard-extract the local action, delegate to a private ","type":"text"},{"code":"reduceLocal","type":"codeVoice"},{"text":", and lift any returned effect. The private ","type":"text"},{"code":"reduceLocal","type":"codeVoice"},{"text":" is where feature logic lives — it looks like any standard Swidux reducer.","type":"text"}],"type":"paragraph"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Domain plugins implement only ","type":"text"},{"type":"codeVoice","code":"reduce"},{"type":"text","text":". The "},{"type":"codeVoice","code":"willReduce"},{"type":"text","text":" and "},{"type":"codeVoice","code":"afterReduce"},{"text":" hooks are reserved for action-agnostic infrastructure like undo and persistence. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":" for the full distinction.","type":"text"}]}],"type":"aside"},{"text":"Step 5: Wire Into the Host App","anchor":"Step-5-Wire-Into-the-Host-App","type":"heading","level":2},{"text":"Add state and action","anchor":"Add-state-and-action","type":"heading","level":3},{"code":["@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    \/\/ ...","    var announcements = AnnouncementState()","}","","enum AppAction: Sendable {","    case items(ItemAction)","    \/\/ ...","    case announcements(AnnouncementAction)","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"Register the plugin","anchor":"Register-the-plugin"},{"code":["plugins.register(AnnouncementPlugin(","    state: \\.announcements,","    action: AppAction.announcements,","    extractAction: {","        if case .announcements(let a) = $0 { return a }","        return nil","    },","    service: .init { try await api.fetchAnnouncement() }","))"],"type":"codeListing","syntax":"swift"},{"text":"Dispatch from views","anchor":"Dispatch-from-views","type":"heading","level":3},{"code":["store.send(.announcements(.fetch))"],"type":"codeListing","syntax":"swift"},{"text":"The Effect Lifting Pattern","anchor":"The-Effect-Lifting-Pattern","type":"heading","level":2},{"inlineContent":[{"text":"The lift pattern bridges ","type":"text"},{"type":"codeVoice","code":"Effect<FeatureAction>"},{"type":"text","text":" to "},{"type":"codeVoice","code":"Effect<RootAction>"},{"text":". It appears in every domain plugin’s ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" method:","type":"text"}],"type":"paragraph"},{"code":["let lift = toRootAction","return { send in                        \/\/ send: Send<RootAction>","    await localEffect { localAction in  \/\/ localAction: FeatureAction","        send(lift(localAction))         \/\/ lift: (FeatureAction) -> RootAction","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"localEffect","type":"codeVoice"},{"text":" expects a ","type":"text"},{"type":"codeVoice","code":"Send<FeatureAction>"},{"text":" callback, but ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"text":" expects ","type":"text"},{"type":"codeVoice","code":"Effect<RootAction>"},{"text":". The lift closure wraps each local action in the root enum before dispatching.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Capture ","type":"text"},{"code":"toRootAction","type":"codeVoice"},{"text":" into a local ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" before the closure to avoid capturing ","type":"text"},{"code":"self","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Testing Domain Plugins","anchor":"Testing-Domain-Plugins","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Test plugins without a real app store. Define minimal "},{"type":"codeVoice","code":"TestState"},{"type":"text","text":" and "},{"type":"codeVoice","code":"TestAction"},{"type":"text","text":" types, instantiate the plugin with test wiring, and assert on state mutations and effect presence."}],"type":"paragraph"},{"code":["@Suite(\"AnnouncementPlugin\")","@MainActor","struct AnnouncementPluginTests {","    struct TestState: Sendable, Equatable {","        var announcements = AnnouncementState()","    }","","    enum TestAction: Sendable {","        case announcements(AnnouncementAction)","        case unrelated","    }","","    func makePlugin(","        service: AnnouncementService = .mock()","    ) -> AnnouncementPlugin<TestState, TestAction> {","        AnnouncementPlugin(","            state: \\.announcements,","            action: TestAction.announcements,","            extractAction: {","                if case .announcements(let a) = $0 { return a }","                return nil","            },","            service: service","        )","    }","","    @Test(\"ignores unrelated actions\")","    func ignoresUnrelated() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(state: &state, action: .unrelated)","        #expect(effect == nil)","    }","","    @Test(\"messageReceived updates state\")","    func messageReceived() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.messageReceived(\"Hello\"))","        )","        #expect(effect == nil)","        #expect(state.announcements.message == \"Hello\")","        #expect(state.announcements.isLoading == false)","    }","","    @Test(\"fetch returns an effect\")","    func fetchReturnsEffect() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.fetch)","        )","        #expect(effect != nil)","        #expect(state.announcements.isLoading == true)","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"TestState"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"TestAction"},{"type":"text","text":" harness is lightweight and reusable. Each plugin’s test suite defines its own pair, keeping tests isolated from the real app’s types."}]},{"type":"heading","text":"Next Steps","anchor":"Next-Steps","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":" — Understand the lifecycle hooks and core-vs-domain distinction","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide"},{"text":" — The snapshot pattern and ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" performance"}]}]}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides","title":"How-to Guides","generated":true}],"references":{"doc://Swidux/documentation/Swidux/PluginHost":{"abstract":[{"text":"Ordered registry of plugins that drives the dispatch lifecycle.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","title":"PluginHost","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PluginHost"}],"url":"\/documentation\/swidux\/pluginhost","navigatorTitle":[{"kind":"identifier","text":"PluginHost"}],"type":"topic"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","kind":"symbol","url":"\/documentation\/swidux\/swiduxplugin","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiduxPlugin","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"A plugin that participates in the Swidux dispatch cycle."}],"title":"SwiduxPlugin","type":"topic","navigatorTitle":[{"text":"SwiduxPlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","url":"\/documentation\/swidux","role":"collection","type":"topic","title":"Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","kind":"article","url":"\/documentation\/swidux\/howtoaddanalytics","role":"article","type":"topic","title":"Add Analytics","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify.","type":"text"}]},"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","title":"Using the Swidux Agent Skill","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","title":"Add a Parental Gate","url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","kind":"article","url":"\/documentation\/swidux\/howtoaddapaywall","role":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"title":"Add a Paywall","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","title":"Add a Version Killswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"title":"Add Feature Flags","type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"kind":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","title":"Plugin Architecture","role":"article","url":"\/documentation\/swidux\/pluginarchitecture","type":"topic"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","kind":"article","url":"\/documentation\/swidux\/architectureguide","role":"article","type":"topic","abstract":[{"type":"text","text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system."}],"title":"Architecture & Performance"}}}