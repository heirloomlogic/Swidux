{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/buildingadomainplugin"]}],"metadata":{"role":"article","title":"Building a Domain Plugin","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides","generated":true}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Domain plugins follow a consistent pattern: define feature state and actions, implement the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin"},{"type":"text","text":" protocol using the "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" hook, and wire the plugin into the host app at registration time. This guide walks through building a plugin from scratch."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The example builds a fictional “Announcements” plugin that fetches a remote message and displays it."}],"type":"paragraph"},{"level":2,"type":"heading","text":"The Three Wiring Pieces","anchor":"The-Three-Wiring-Pieces"},{"inlineContent":[{"type":"text","text":"Every domain plugin stores three closures that bridge its local types to the host app’s root types:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State keypath"}]},{"type":"text","text":" — "},{"code":"WritableKeyPath<RootState, FeatureState>","type":"codeVoice"},{"text":" locates the plugin’s state slice within root state.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Action lifter"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"(FeatureAction) -> RootAction","type":"codeVoice"},{"text":" wraps local actions into the root action enum.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Action extractor","type":"text"}],"type":"strong"},{"type":"text","text":" — "},{"type":"codeVoice","code":"(RootAction) -> FeatureAction?"},{"type":"text","text":" downcasts root actions to the plugin’s local type, returning "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for actions that belong to other features."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"These are closures, not protocols. The host app provides them at init — no associated-type gymnastics or conformance wiring needed.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 1: Define Feature State","anchor":"Step-1-Define-Feature-State"},{"syntax":"swift","type":"codeListing","code":["public struct AnnouncementState: Sendable, Equatable {","    public var message: String?","    public var isLoading: Bool","    public var error: String?","","    public init(","        message: String? = nil,","        isLoading: Bool = false,","        error: String? = nil","    ) {","        self.message = message","        self.isLoading = isLoading","        self.error = error","    }","}"]},{"inlineContent":[{"text":"Keep state minimal — only what the UI needs to render and the reducer needs to decide.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 2: Define Feature Actions","anchor":"Step-2-Define-Feature-Actions"},{"syntax":"swift","type":"codeListing","code":["public enum AnnouncementAction: Sendable {","    case fetch","    case messageReceived(String?)","    case fetchFailed(String)","    case dismiss","}"]},{"inlineContent":[{"text":"Actions are the plugin’s public API. The host app dispatches them by wrapping in the root action enum.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 3: Define the Service","anchor":"Step-3-Define-the-Service"},{"inlineContent":[{"text":"Inject async dependencies as a struct with closure properties. This makes testing trivial — swap closures instead of subclassing or mocking protocols.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public struct AnnouncementService: Sendable {","    public var fetch: @Sendable () async throws -> String?","","    public init(fetch: @escaping @Sendable () async throws -> String?) {","        self.fetch = fetch","    }","","    public static func mock(message: String? = \"Test\") -> Self {","        AnnouncementService { message }","    }","}"]},{"level":2,"type":"heading","text":"Step 4: Implement the Plugin","anchor":"Step-4-Implement-the-Plugin"},{"syntax":"swift","type":"codeListing","code":["import Swidux","","@MainActor","public struct AnnouncementPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    private let stateKeyPath: WritableKeyPath<RootState, AnnouncementState>","    private let toRootAction: @Sendable (AnnouncementAction) -> RootAction","    private let extractAction: @Sendable (RootAction) -> AnnouncementAction?","    private let service: AnnouncementService","","    public init(","        state: WritableKeyPath<RootState, AnnouncementState>,","        action toRootAction: @escaping @Sendable (AnnouncementAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> AnnouncementAction?,","        service: AnnouncementService","    ) {","        self.stateKeyPath = state","        self.toRootAction = toRootAction","        self.extractAction = extractAction","        self.service = service","    }","","    public func reduce(","        state: inout RootState,","        action: RootAction","    ) -> Effect<RootAction>? {","        guard let local = extractAction(action) else { return nil }","        let localEffect = reduceLocal(","            state: &state[keyPath: stateKeyPath],","            action: local","        )","        guard let localEffect else { return nil }","        let lift = toRootAction","        return { send in","            await localEffect { localAction in","                send(lift(localAction))","            }","        }","    }","","    private func reduceLocal(","        state: inout AnnouncementState,","        action: AnnouncementAction","    ) -> Effect<AnnouncementAction>? {","        switch action {","        case .fetch:","            state.isLoading = true","            let service = self.service","            return { send in","                do {","                    let message = try await service.fetch()","                    await send(.messageReceived(message))","                } catch {","                    await send(.fetchFailed(error.localizedDescription))","                }","            }","","        case .messageReceived(let message):","            state.message = message","            state.isLoading = false","            state.error = nil","","        case .fetchFailed(let message):","            state.isLoading = false","            state.error = message","","        case .dismiss:","            state.message = nil","        }","        return nil","    }","}"]},{"inlineContent":[{"text":"The public ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" method follows a fixed pattern: guard-extract the local action, delegate to a private ","type":"text"},{"type":"codeVoice","code":"reduceLocal"},{"text":", and lift any returned effect. The private ","type":"text"},{"type":"codeVoice","code":"reduceLocal"},{"text":" is where feature logic lives — it looks like any standard Swidux reducer.","type":"text"}],"type":"paragraph"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Domain plugins implement only "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":". The "},{"type":"codeVoice","code":"willReduce"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" hooks are reserved for action-agnostic infrastructure like undo and persistence. See "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"type":"text","text":" for the full distinction."}]}],"type":"aside","style":"important"},{"level":2,"type":"heading","text":"Step 5: Wire Into the Host App","anchor":"Step-5-Wire-Into-the-Host-App"},{"level":3,"type":"heading","text":"Add state and action","anchor":"Add-state-and-action"},{"syntax":"swift","type":"codeListing","code":["@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    \/\/ ...","    var announcements = AnnouncementState()","}","","enum AppAction: Sendable {","    case items(ItemAction)","    \/\/ ...","    case announcements(AnnouncementAction)","}"]},{"level":3,"type":"heading","text":"Register the plugin","anchor":"Register-the-plugin"},{"syntax":"swift","type":"codeListing","code":["plugins.register(AnnouncementPlugin(","    state: \\.announcements,","    action: AppAction.announcements,","    extractAction: {","        if case .announcements(let a) = $0 { return a }","        return nil","    },","    service: .init { try await api.fetchAnnouncement() }","))"]},{"text":"Dispatch from views","type":"heading","anchor":"Dispatch-from-views","level":3},{"syntax":"swift","code":["store.send(.announcements(.fetch))"],"type":"codeListing"},{"text":"The Effect Lifting Pattern","type":"heading","anchor":"The-Effect-Lifting-Pattern","level":2},{"inlineContent":[{"type":"text","text":"The lift pattern bridges "},{"type":"codeVoice","code":"Effect<FeatureAction>"},{"type":"text","text":" to "},{"type":"codeVoice","code":"Effect<RootAction>"},{"type":"text","text":". It appears in every domain plugin’s "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" method:"}],"type":"paragraph"},{"syntax":"swift","code":["let lift = toRootAction","return { send in                        \/\/ send: Send<RootAction>","    await localEffect { localAction in  \/\/ localAction: FeatureAction","        send(lift(localAction))         \/\/ lift: (FeatureAction) -> RootAction","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"localEffect"},{"text":" expects a ","type":"text"},{"type":"codeVoice","code":"Send<FeatureAction>"},{"text":" callback, but ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference","isActive":true},{"type":"text","text":" expects "},{"type":"codeVoice","code":"Effect<RootAction>"},{"type":"text","text":". The lift closure wraps each local action in the root enum before dispatching."}],"type":"paragraph"},{"inlineContent":[{"text":"Capture ","type":"text"},{"type":"codeVoice","code":"toRootAction"},{"text":" into a local ","type":"text"},{"type":"codeVoice","code":"let"},{"text":" before the closure to avoid capturing ","type":"text"},{"code":"self","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Testing Domain Plugins","anchor":"Testing-Domain-Plugins"},{"inlineContent":[{"text":"Test plugins without a real app store. Define minimal ","type":"text"},{"type":"codeVoice","code":"TestState"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"TestAction"},{"text":" types, instantiate the plugin with test wiring, and assert on state mutations and effect presence.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@Suite(\"AnnouncementPlugin\")","@MainActor","struct AnnouncementPluginTests {","    struct TestState: Sendable, Equatable {","        var announcements = AnnouncementState()","    }","","    enum TestAction: Sendable {","        case announcements(AnnouncementAction)","        case unrelated","    }","","    func makePlugin(","        service: AnnouncementService = .mock()","    ) -> AnnouncementPlugin<TestState, TestAction> {","        AnnouncementPlugin(","            state: \\.announcements,","            action: TestAction.announcements,","            extractAction: {","                if case .announcements(let a) = $0 { return a }","                return nil","            },","            service: service","        )","    }","","    @Test(\"ignores unrelated actions\")","    func ignoresUnrelated() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(state: &state, action: .unrelated)","        #expect(effect == nil)","    }","","    @Test(\"messageReceived updates state\")","    func messageReceived() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.messageReceived(\"Hello\"))","        )","        #expect(effect == nil)","        #expect(state.announcements.message == \"Hello\")","        #expect(state.announcements.isLoading == false)","    }","","    @Test(\"fetch returns an effect\")","    func fetchReturnsEffect() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.fetch)","        )","        #expect(effect != nil)","        #expect(state.announcements.isLoading == true)","    }","}"]},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"TestState"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"TestAction"},{"type":"text","text":" harness is lightweight and reusable. Each plugin’s test suite defines its own pair, keeping tests isolated from the real app’s types."}],"type":"paragraph"},{"text":"Next Steps","level":2,"anchor":"Next-Steps","type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":" — Understand the lifecycle hooks and core-vs-domain distinction","type":"text"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","isActive":true,"type":"reference"},{"type":"text","text":" — The snapshot pattern and "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" performance"}],"type":"paragraph"}]}]}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","url":"\/documentation\/swidux\/pluginarchitecture","title":"Plugin Architecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic","kind":"article","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","kind":"article","role":"article","title":"Add a Version Killswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}]},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"url":"\/documentation\/swidux\/howtoaddfeatureflags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","role":"article","kind":"article","title":"Add Feature Flags","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}]},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","url":"\/documentation\/swidux\/howtoaddapaywall","kind":"article","role":"article","title":"Add a Paywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}]},"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","kind":"article","role":"article","title":"Using the Swidux Agent Skill","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}]},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","url":"\/documentation\/swidux\/architectureguide","kind":"article","role":"article","title":"Architecture & Performance","abstract":[{"type":"text","text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system."}]},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","url":"\/documentation\/swidux\/swiduxplugin","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"SwiduxPlugin","kind":"identifier"}],"title":"SwiduxPlugin","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiduxPlugin","kind":"identifier"}],"abstract":[{"type":"text","text":"A plugin that participates in the Swidux dispatch cycle."}]},"doc://Swidux/documentation/Swidux/PluginHost":{"url":"\/documentation\/swidux\/pluginhost","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PluginHost","kind":"identifier"}],"kind":"symbol","title":"PluginHost","navigatorTitle":[{"text":"PluginHost","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}]},"doc://Swidux/documentation/Swidux":{"role":"collection","url":"\/documentation\/swidux","title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","type":"topic","kind":"symbol","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","url":"\/documentation\/swidux\/howtoaddanalytics","kind":"article","role":"article","title":"Add Analytics","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}]},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","role":"article","title":"Add a Parental Gate","abstract":[{"type":"text","text":"Gate sensitive actions — purch