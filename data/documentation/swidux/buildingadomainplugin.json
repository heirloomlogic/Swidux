duxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"title":"Add Analytics","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"title":"Add Feature Flags","role":"article","kind":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"title":"Architecture & Performance","role":"article","kind":"article","url":"\/documentation\/swidux\/architectureguide","type":"topic","abstract":[{"type":"text","text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","title":"Plugin Architecture","role":"article","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"kind":"article","url":"\/documentation\/swidux\/pluginarchitecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"}}}