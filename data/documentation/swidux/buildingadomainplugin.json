{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","interfaceLanguage":"swift"},"kind":"article","primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Domain plugins follow a consistent pattern: define feature state and actions, implement the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin"},{"text":" protocol using the ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" hook, and wire the plugin into the host app at registration time. This guide walks through building a plugin from scratch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The example builds a fictional “Announcements” plugin that fetches a remote message and displays it.","type":"text"}]},{"level":2,"type":"heading","text":"The Three Wiring Pieces","anchor":"The-Three-Wiring-Pieces"},{"type":"paragraph","inlineContent":[{"text":"Every domain plugin stores three closures that bridge its local types to the host app’s root types:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State keypath"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"WritableKeyPath<RootState, FeatureState>"},{"type":"text","text":" locates the plugin’s state slice within root state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action lifter"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"(FeatureAction) -> RootAction"},{"type":"text","text":" wraps local actions into the root action enum."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action extractor"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"(RootAction) -> FeatureAction?"},{"type":"text","text":" downcasts root actions to the plugin’s local type, returning "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for actions that belong to other features."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"These are closures, not protocols. The host app provides them at init — no associated-type gymnastics or conformance wiring needed.","type":"text"}]},{"anchor":"Step-1-Define-Feature-State","text":"Step 1: Define Feature State","type":"heading","level":2},{"type":"codeListing","syntax":"swift","code":["public struct AnnouncementState: Sendable, Equatable {","    public var message: String?","    public var isLoading: Bool","    public var error: String?","","    public init(","        message: String? = nil,","        isLoading: Bool = false,","        error: String? = nil","    ) {","        self.message = message","        self.isLoading = isLoading","        self.error = error","    }","}"]},{"inlineContent":[{"type":"text","text":"Keep state minimal — only what the UI needs to render and the reducer needs to decide."}],"type":"paragraph"},{"anchor":"Step-2-Define-Feature-Actions","text":"Step 2: Define Feature Actions","type":"heading","level":2},{"type":"codeListing","syntax":"swift","code":["public enum AnnouncementAction: Sendable {","    case fetch","    case messageReceived(String?)","    case fetchFailed(String)","    case dismiss","}"]},{"inlineContent":[{"type":"text","text":"Actions are the plugin’s public API. The host app dispatches them by wrapping in the root action enum."}],"type":"paragraph"},{"anchor":"Step-3-Define-the-Service","text":"Step 3: Define the Service","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Inject async dependencies as a struct with closure properties. This makes testing trivial — swap closures instead of subclassing or mocking protocols. (Reach for a protocol instead only when third parties will implement the backend — see the service-shapes principle in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples"},{"type":"text","text":".)"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public struct AnnouncementService: Sendable {","    public var fetch: @Sendable () async throws -> String?","","    public init(fetch: @escaping @Sendable () async throws -> String?) {","        self.fetch = fetch","    }","","    public static func mock(message: String? = \"Test\") -> Self {","        AnnouncementService { message }","    }","}"]},{"anchor":"Step-4-Implement-the-Plugin","text":"Step 4: Implement the Plugin","type":"heading","level":2},{"type":"codeListing","syntax":"swift","code":["import Swidux","","@MainActor","public struct AnnouncementPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    private let stateKeyPath: WritableKeyPath<RootState, AnnouncementState>","    private let toRootAction: @Sendable (AnnouncementAction) -> RootAction","    private let extractAction: @Sendable (RootAction) -> AnnouncementAction?","    private let service: AnnouncementService","","    public init(","        state: WritableKeyPath<RootState, AnnouncementState>,","        action toRootAction: @escaping @Sendable (AnnouncementAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> AnnouncementAction?,","        service: AnnouncementService","    ) {","        self.stateKeyPath = state","        self.toRootAction = toRootAction","        self.extractAction = extractAction","        self.service = service","    }","","    public func reduce(","        state: inout RootState,","        action: RootAction","    ) -> Effect<RootAction>? {","        guard let local = extractAction(action) else { return nil }","        let localEffect = reduceLocal(","            state: &state[keyPath: stateKeyPath],","            action: local","        )","        guard let localEffect else { return nil }","        let lift = toRootAction","        return { send in","            await localEffect { localAction in","                send(lift(localAction))","            }","        }","    }","","    private func reduceLocal(","        state: inout AnnouncementState,","        action: AnnouncementAction","    ) -> Effect<AnnouncementAction>? {","        switch action {","        case .fetch:","            state.isLoading = true","            let service = self.service","            return { send in","                do {","                    let message = try await service.fetch()","                    await send(.messageReceived(message))","                } catch {","                    await send(.fetchFailed(error.localizedDescription))","                }","            }","","        case .messageReceived(let message):","            state.message = message","            state.isLoading = false","            state.error = nil","","        case .fetchFailed(let message):","            state.isLoading = false","            state.error = message","","        case .dismiss:","            state.message = nil","        }","        return nil","    }","}"]},{"inlineContent":[{"type":"text","text":"The public "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" method follows a fixed pattern: guard-extract the local action, delegate to a private "},{"type":"codeVoice","code":"reduceLocal"},{"type":"text","text":", and lift any returned effect. The private "},{"type":"codeVoice","code":"reduceLocal"},{"type":"text","text":" is where feature logic lives — it looks like any standard Swidux reducer."}],"type":"paragraph"},{"name":"Important","style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Domain plugins implement only ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"willReduce"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":" hooks are reserved for action-agnostic infrastructure like undo and persistence. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"text":" for the full distinction.","type":"text"}]}]},{"text":"Step 5: Wire Into the Host App","type":"heading","anchor":"Step-5-Wire-Into-the-Host-App","level":2},{"text":"Add state and action","type":"heading","anchor":"Add-state-and-action","level":3},{"type":"codeListing","syntax":"swift","code":["@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    \/\/ ...","    var announcements = AnnouncementState()","}","","enum AppAction: Sendable {","    case items(ItemAction)","    \/\/ ...","    case announcements(AnnouncementAction)","}"]},{"text":"Register the plugin","type":"heading","anchor":"Register-the-plugin","level":3},{"type":"codeListing","syntax":"swift","code":["plugins.register(AnnouncementPlugin(","    state: \\.announcements,","    action: AppAction.announcements,","    extractAction: {","        if case .announcements(let a) = $0 { return a }","        return nil","    },","    service: .init { try await api.fetchAnnouncement() }","))"]},{"text":"Dispatch from views","type":"heading","anchor":"Dispatch-from-views","level":3},{"type":"codeListing","syntax":"swift","code":["store.send(.announcements(.fetch))"]},{"text":"The Effect Lifting Pattern","type":"heading","anchor":"The-Effect-Lifting-Pattern","level":2},{"inlineContent":[{"type":"text","text":"The lift pattern bridges "},{"type":"codeVoice","code":"Effect<FeatureAction>"},{"type":"text","text":" to "},{"type":"codeVoice","code":"Effect<RootAction>"},{"type":"text","text":". It appears in every domain plugin’s "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" method:"}],"type":"paragraph"},{"type":"codeListing","code":["let lift = toRootAction","return { send in                        \/\/ send: Send<RootAction>","    await localEffect { localAction in  \/\/ localAction: FeatureAction","        send(lift(localAction))         \/\/ lift: (FeatureAction) -> RootAction","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"localEffect"},{"type":"text","text":" expects a "},{"type":"codeVoice","code":"Send<FeatureAction>"},{"type":"text","text":" callback, but "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"type":"text","text":" expects "},{"type":"codeVoice","code":"Effect<RootAction>"},{"type":"text","text":". The lift closure wraps each local action in the root enum before dispatching."}]},{"inlineContent":[{"type":"text","text":"Capture "},{"type":"codeVoice","code":"toRootAction"},{"type":"text","text":" into a local "},{"type":"codeVoice","code":"let"},{"type":"text","text":" before the closure to avoid capturing "},{"type":"codeVoice","code":"self"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Testing Domain Plugins","anchor":"Testing-Domain-Plugins"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Test plugins without a real app store. Define minimal "},{"type":"codeVoice","code":"TestState"},{"type":"text","text":" and "},{"type":"codeVoice","code":"TestAction"},{"type":"text","text":" types, instantiate the plugin with test wiring, and assert on state mutations and effect presence."}]},{"type":"codeListing","syntax":"swift","code":["@Suite(\"AnnouncementPlugin\")","@MainActor","struct AnnouncementPluginTests {","    struct TestState: Sendable, Equatable {","        var announcements = AnnouncementState()","    }","","    enum TestAction: Sendable {","        case announcements(AnnouncementAction)","        case unrelated","    }","","    func makePlugin(","        service: AnnouncementService = .mock()","    ) -> AnnouncementPlugin<TestState, TestAction> {","        AnnouncementPlugin(","            state: \\.announcements,","            action: TestAction.announcements,","            extractAction: {","                if case .announcements(let a) = $0 { return a }","                return nil","            },","            service: service","        )","    }","","    @Test(\"ignores unrelated actions\")","    func ignoresUnrelated() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(state: &state, action: .unrelated)","        #expect(effect == nil)","    }","","    @Test(\"messageReceived updates state\")","    func messageReceived() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.messageReceived(\"Hello\"))","        )","        #expect(effect == nil)","        #expect(state.announcements.message == \"Hello\")","        #expect(state.announcements.isLoading == false)","    }","","    @Test(\"fetch returns an effect\")","    func fetchReturnsEffect() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.fetch)","        )","        #expect(effect != nil)","        #expect(state.announcements.isLoading == true)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"TestState"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"TestAction"},{"text":" harness is lightweight and reusable. Each plugin’s test suite defines its own pair, keeping tests isolated from the real app’s types.","type":"text"}]},{"anchor":"Next-Steps","text":"Next Steps","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"type":"text","text":" — Understand the lifecycle hooks and core-vs-domain distinction"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","type":"reference","isActive":true},{"text":" — The snapshot pattern and ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" performance","type":"text"}]}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/buildingadomainplugin"]}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides","anchor":"How-to-Guides"}],"sections":[],"abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"metadata":{"role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"Building a Domain Plugin"},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","role":"article","kind":"article","url":"\/documentation\/swidux\/architectureguide","title":"Architecture & Performance","type":"topic","abstract":[{"type":"text","text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system."}]},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"url":"\/documentation\/swidux\/designprinciples","type":"topic","kind":"article","abstract":[{"type":"text","text":"The 10 rules that shape every Swidux app, and the reasoning behind them."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","title":"Design Principles","role":"article"},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","role":"article","kind":"article","url":"\/documentation\/swidux\/agentskill","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"type":"topic","title":"Using the Swidux Agent Skill"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"url":"\/documentation\/swidux\/howtoaddpersistence","type":"topic","kind":"article","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","title":"Add Persistence","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"url":"\/documentation\/swidux\/howtoaddanalytics","type":"topic","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","title":"Add Analytics","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","role":"article"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","role":"article","kind":"article","url":"\/documentation\/swidux\/howtocanceleffects","title":"Cancel Effects","type":"topic","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}]},"doc://Swidux/documentation/Swidux":{"type":"topic","url":"\/documentation\/swidux","kind":"symbol","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux","role":"collection"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","title":"Add Feature Flags","role":"article"},"doc://Swidux/documentation/Swidux/PluginHost":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PluginHost"}],"navigatorTitle":[{"kind":"identifier","text":"PluginHost"}],"url":"\/documentation\/swidux\/pluginhost","title":"PluginHost","type":"topic","abstract":[{"text":"Ordered registry of plugins that drives the dispatch lifecycle.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"url":"\/documentation\/swidux\/howtoaddaparentalgate","type":"topic","kind":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","title":"Add a Parental Gate","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"url":"\/documentation\/swidux\/howtoaddaversionkillswitch","type":"topic","kind":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","title":"Add a Version Killswitch","role":"article"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiduxPlugin"}],"navigatorTitle":[{"kind":"identifier","text":"SwiduxPlugin"}],"url":"\/documentation\/swidux\/swiduxplugin","abstract":[{"text":"A plugin that participates in the Swidux dispatch cycle.","type":"text"}],"title":"SwiduxPlugin","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"url":"\/documentation\/swidux\/howtoaddicloudsync","type":"topic","kind":"article","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","title":"Add iCloud Sync","role":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","role":"article","kind":"article","url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"title":"Plugin Architecture","type":"topic"}}}