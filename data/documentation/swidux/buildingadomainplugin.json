{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","interfaceLanguage":"swift"},"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"Domain plugins follow a consistent pattern: define feature state and actions, implement the ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","type":"reference","isActive":true},{"text":" protocol using the ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" hook, and wire the plugin into the host app at registration time. This guide walks through building a plugin from scratch.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The example builds a fictional “Announcements” plugin that fetches a remote message and displays it.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"The Three Wiring Pieces","level":2,"anchor":"The-Three-Wiring-Pieces"},{"inlineContent":[{"text":"Every domain plugin stores three closures that bridge its local types to the host app’s root types:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"State keypath"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"WritableKeyPath<RootState, FeatureState>","type":"codeVoice"},{"text":" locates the plugin’s state slice within root state.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Action lifter"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"(FeatureAction) -> RootAction","type":"codeVoice"},{"text":" wraps local actions into the root action enum.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Action extractor"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"(RootAction) -> FeatureAction?","type":"codeVoice"},{"text":" downcasts root actions to the plugin’s local type, returning ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for actions that belong to other features.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"These are closures, not protocols. The host app provides them at init — no associated-type gymnastics or conformance wiring needed.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Step 1: Define Feature State","level":2,"anchor":"Step-1-Define-Feature-State"},{"type":"codeListing","syntax":"swift","code":["public struct AnnouncementState: Sendable, Equatable {","    public var message: String?","    public var isLoading: Bool","    public var error: String?","","    public init(","        message: String? = nil,","        isLoading: Bool = false,","        error: String? = nil","    ) {","        self.message = message","        self.isLoading = isLoading","        self.error = error","    }","}"]},{"inlineContent":[{"text":"Keep state minimal — only what the UI needs to render and the reducer needs to decide.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Step 2: Define Feature Actions","level":2,"anchor":"Step-2-Define-Feature-Actions"},{"type":"codeListing","syntax":"swift","code":["public enum AnnouncementAction: Sendable {","    case fetch","    case messageReceived(String?)","    case fetchFailed(String)","    case dismiss","}"]},{"inlineContent":[{"text":"Actions are the plugin’s public API. The host app dispatches them by wrapping in the root action enum.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Step 3: Define the Service","level":2,"anchor":"Step-3-Define-the-Service"},{"inlineContent":[{"text":"Inject async dependencies as a struct with closure properties. This makes testing trivial — swap closures instead of subclassing or mocking protocols. (Reach for a protocol instead only when third parties will implement the backend — see the service-shapes principle in ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","type":"reference","isActive":true},{"text":".)","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public struct AnnouncementService: Sendable {","    public var fetch: @Sendable () async throws -> String?","","    public init(fetch: @escaping @Sendable () async throws -> String?) {","        self.fetch = fetch","    }","","    public static func mock(message: String? = \"Test\") -> Self {","        AnnouncementService { message }","    }","}"]},{"type":"heading","text":"Step 4: Implement the Plugin","level":2,"anchor":"Step-4-Implement-the-Plugin"},{"type":"codeListing","syntax":"swift","code":["import Swidux","","@MainActor","public struct AnnouncementPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    private let stateKeyPath: WritableKeyPath<RootState, AnnouncementState>","    private let toRootAction: @Sendable (AnnouncementAction) -> RootAction","    private let extractAction: @Sendable (RootAction) -> AnnouncementAction?","    private let service: AnnouncementService","","    public init(","        state: WritableKeyPath<RootState, AnnouncementState>,","        action toRootAction: @escaping @Sendable (AnnouncementAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> AnnouncementAction?,","        service: AnnouncementService","    ) {","        self.stateKeyPath = state","        self.toRootAction = toRootAction","        self.extractAction = extractAction","        self.service = service","    }","","    public func reduce(","        state: inout RootState,","        action: RootAction","    ) -> Effect<RootAction>? {","        guard let local = extractAction(action) else { return nil }","        let localEffect = reduceLocal(","            state: &state[keyPath: stateKeyPath],","            action: local","        )","        guard let localEffect else { return nil }","        let lift = toRootAction","        return { send in","            await localEffect { localAction in","                send(lift(localAction))","            }","        }","    }","","    private func reduceLocal(","        state: inout AnnouncementState,","        action: AnnouncementAction","    ) -> Effect<AnnouncementAction>? {","        switch action {","        case .fetch:","            state.isLoading = true","            let service = self.service","            return { send in","                do {","                    let message = try await service.fetch()","                    await send(.messageReceived(message))","                } catch {","                    await send(.fetchFailed(error.localizedDescription))","                }","            }","","        case .messageReceived(let message):","            state.message = message","            state.isLoading = false","            state.error = nil","","        case .fetchFailed(let message):","            state.isLoading = false","            state.error = message","","        case .dismiss:","            state.message = nil","        }","        return nil","    }","}"]},{"inlineContent":[{"text":"The public ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" method follows a fixed pattern: guard-extract the local action, delegate to a private ","type":"text"},{"type":"codeVoice","code":"reduceLocal"},{"text":", and lift any returned effect. The private ","type":"text"},{"type":"codeVoice","code":"reduceLocal"},{"text":" is where feature logic lives — it looks like any standard Swidux reducer.","type":"text"}],"type":"paragraph"},{"type":"aside","name":"Important","style":"important","content":[{"inlineContent":[{"type":"text","text":"Domain plugins implement only "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":". The "},{"type":"codeVoice","code":"willReduce"},{"type":"text","text":" and "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" hooks are reserved for action-agnostic infrastructure like undo and persistence. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":" for the full distinction."}],"type":"paragraph"}]},{"type":"heading","text":"Step 5: Wire Into the Host App","level":2,"anchor":"Step-5-Wire-Into-the-Host-App"},{"type":"heading","text":"Add state and action","level":3,"anchor":"Add-state-and-action"},{"type":"codeListing","syntax":"swift","code":["@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    \/\/ ...","    var announcements = AnnouncementState()","}","","enum AppAction: Sendable {","    case items(ItemAction)","    \/\/ ...","    case announcements(AnnouncementAction)","}"]},{"type":"heading","text":"Register the plugin","level":3,"anchor":"Register-the-plugin"},{"type":"codeListing","syntax":"swift","code":["plugins.register(AnnouncementPlugin(","    state: \\.announcements,","    action: AppAction.announcements,","    extractAction: {","        if case .announcements(let a) = $0 { return a }","        return nil","    },","    service: .init { try await api.fetchAnnouncement() }","))"]},{"type":"heading","text":"Dispatch from views","level":3,"anchor":"Dispatch-from-views"},{"type":"codeListing","syntax":"swift","code":["store.send(.announcements(.fetch))"]},{"type":"heading","text":"The Effect Lifting Pattern","level":2,"anchor":"The-Effect-Lifting-Pattern"},{"inlineContent":[{"text":"The lift pattern bridges ","type":"text"},{"type":"codeVoice","code":"Effect<FeatureAction>"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"Effect<RootAction>"},{"text":". It appears in every domain plugin’s ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" method:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let lift = toRootAction","return { send in                        \/\/ send: Send<RootAction>","    await localEffect { localAction in  \/\/ localAction: FeatureAction","        send(lift(localAction))         \/\/ lift: (FeatureAction) -> RootAction","    }","}"]},{"inlineContent":[{"type":"codeVoice","code":"localEffect"},{"text":" expects a ","type":"text"},{"type":"codeVoice","code":"Send<FeatureAction>"},{"text":" callback, but ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference","isActive":true},{"text":" expects ","type":"text"},{"type":"codeVoice","code":"Effect<RootAction>"},{"text":". The lift closure wraps each local action in the root enum before dispatching.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Capture ","type":"text"},{"type":"codeVoice","code":"toRootAction"},{"text":" into a local ","type":"text"},{"type":"codeVoice","code":"let"},{"text":" before the closure to avoid capturing ","type":"text"},{"type":"codeVoice","code":"self"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Testing Domain Plugins","level":2,"anchor":"Testing-Domain-Plugins"},{"inlineContent":[{"text":"Test plugins without a real app store. Define minimal ","type":"text"},{"type":"codeVoice","code":"TestState"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"TestAction"},{"text":" types, instantiate the plugin with test wiring, and assert on state mutations and effect presence.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@Suite(\"AnnouncementPlugin\")","@MainActor","struct AnnouncementPluginTests {","    struct TestState: Sendable, Equatable {","        var announcements = AnnouncementState()","    }","","    enum TestAction: Sendable {","        case announcements(AnnouncementAction)","        case unrelated","    }","","    func makePlugin(","        service: AnnouncementService = .mock()","    ) -> AnnouncementPlugin<TestState, TestAction> {","        AnnouncementPlugin(","            state: \\.announcements,","            action: TestAction.announcements,","            extractAction: {","                if case .announcements(let a) = $0 { return a }","                return nil","            },","            service: service","        )","    }","","    @Test(\"ignores unrelated actions\")","    func ignoresUnrelated() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(state: &state, action: .unrelated)","        #expect(effect == nil)","    }","","    @Test(\"messageReceived updates state\")","    func messageReceived() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.messageReceived(\"Hello\"))","        )","        #expect(effect == nil)","        #expect(state.announcements.message == \"Hello\")","        #expect(state.announcements.isLoading == false)","    }","","    @Test(\"fetch returns an effect\")","    func fetchReturnsEffect() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.fetch)","        )","        #expect(effect != nil)","        #expect(state.announcements.isLoading == true)","    }","}"]},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"TestState"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"TestAction"},{"text":" harness is lightweight and reusable. Each plugin’s test suite defines its own pair, keeping tests isolated from the real app’s types.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Next Steps","level":2,"anchor":"Next-Steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":" — Understand the lifecycle hooks and core-vs-domain distinction","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","isActive":true,"type":"reference"},{"text":" — The snapshot pattern and ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" performance","type":"text"}],"type":"paragraph"}]}]}]}],"metadata":{"role":"article","roleHeading":"Article","title":"Building a Domain Plugin","modules":[{"name":"Swidux"}]},"abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"seeAlsoSections":[{"generated":true,"title":"How-to Guides","anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/buildingadomainplugin"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"references":{"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"title":"Add a Parental Gate","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"title":"Add Feature Flags","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"topic"},"doc://Swidux/documentation/Swidux/AgentSkill":{"url":"\/documentation\/swidux\/agentskill","kind":"article","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"title":"Using the Swidux Agent Skill","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"url":"\/documentation\/swidux\/howtoaddpersistence","kind":"article","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"title":"Add Persistence","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","type":"topic"},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"url":"\/documentation\/swidux\/designprinciples","kind":"article","abstract":[{"type":"text","text":"The 10 rules that shape every Swidux app, and the reasoning behind them."}],"title":"Design Principles","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","type":"topic"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","kind":"symbol","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"title":"Swidux","role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux","type":"topic"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"url":"\/documentation\/swidux\/howtocanceleffects","kind":"article","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"title":"Cancel Effects","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"role":"article","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","kind":"article","title":"Add Analytics","url":"\/documentation\/swidux\/howtoaddanalytics","type":"topic"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"url":"\/documentation\/swidux\/swiduxplugin","kind":"symbol","abstract":[{"type":"text","text":"A plugin that participates in the Swidux dispatch cycle."}],"title":"SwiduxPlugin","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"SwiduxPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"SwiduxPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","kind":"article","title":"Add a Version Killswitch","type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"url":"\/documentation\/swidux\/architectureguide","kind":"article","abstract":[{"text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system.","type":"text"}],"title":"Architecture & Performance","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","type":"topic"},"doc://Swidux/documentation/Swidux/PluginHost":{"url":"\/documentation\/swidux\/pluginhost","kind":"symbol","abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}],"title":"PluginHost","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PluginHost"}],"navigatorTitle":[{"kind":"identifier","text":"PluginHost"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"url":"\/documentation\/swidux\/howtoaddapaywall","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"title":"Add a Paywall","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"topic"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","kind":"article","title":"Plugin Architecture","url":"\/documentation\/swidux\/pluginarchitecture","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"kind":"article","url":"\/documentation\/swidux\/howtoaddicloudsync","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"title":"Add iCloud Sync","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"topic"}}}