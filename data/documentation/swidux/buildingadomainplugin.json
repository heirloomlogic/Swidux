{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"generated":true,"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"]}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Domain plugins follow a consistent pattern: define feature state and actions, implement the ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","type":"reference","isActive":true},{"text":" protocol using the ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" hook, and wire the plugin into the host app at registration time. This guide walks through building a plugin from scratch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The example builds a fictional “Announcements” plugin that fetches a remote message and displays it.","type":"text"}]},{"type":"heading","level":2,"text":"The Three Wiring Pieces","anchor":"The-Three-Wiring-Pieces"},{"type":"paragraph","inlineContent":[{"text":"Every domain plugin stores three closures that bridge its local types to the host app’s root types:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"State keypath","type":"text"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"WritableKeyPath<RootState, FeatureState>"},{"type":"text","text":" locates the plugin’s state slice within root state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Action lifter","type":"text"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"(FeatureAction) -> RootAction"},{"type":"text","text":" wraps local actions into the root action enum."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Action extractor","type":"text"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"(RootAction) -> FeatureAction?"},{"type":"text","text":" downcasts root actions to the plugin’s local type, returning "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for actions that belong to other features."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"These are closures, not protocols. The host app provides them at init — no associated-type gymnastics or conformance wiring needed.","type":"text"}]},{"type":"heading","level":2,"text":"Step 1: Define Feature State","anchor":"Step-1-Define-Feature-State"},{"type":"codeListing","code":["public struct AnnouncementState: Sendable, Equatable {","    public var message: String?","    public var isLoading: Bool","    public var error: String?","","    public init(","        message: String? = nil,","        isLoading: Bool = false,","        error: String? = nil","    ) {","        self.message = message","        self.isLoading = isLoading","        self.error = error","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Keep state minimal — only what the UI needs to render and the reducer needs to decide.","type":"text"}]},{"type":"heading","level":2,"text":"Step 2: Define Feature Actions","anchor":"Step-2-Define-Feature-Actions"},{"type":"codeListing","code":["public enum AnnouncementAction: Sendable {","    case fetch","    case messageReceived(String?)","    case fetchFailed(String)","    case dismiss","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Actions are the plugin’s public API. The host app dispatches them by wrapping in the root action enum.","type":"text"}]},{"type":"heading","level":2,"text":"Step 3: Define the Service","anchor":"Step-3-Define-the-Service"},{"type":"paragraph","inlineContent":[{"text":"Inject async dependencies as a struct with closure properties. This makes testing trivial — swap closures instead of subclassing or mocking protocols. (Reach for a protocol instead only when third parties will implement the backend — see the service-shapes principle in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","type":"reference"},{"text":".)","type":"text"}]},{"type":"codeListing","code":["public struct AnnouncementService: Sendable {","    public var fetch: @Sendable () async throws -> String?","","    public init(fetch: @escaping @Sendable () async throws -> String?) {","        self.fetch = fetch","    }","","    public static func mock(message: String? = \"Test\") -> Self {","        AnnouncementService { message }","    }","}"],"syntax":"swift"},{"type":"heading","level":2,"text":"Step 4: Implement the Plugin","anchor":"Step-4-Implement-the-Plugin"},{"type":"codeListing","code":["import Swidux","","@MainActor","public struct AnnouncementPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    private let stateKeyPath: WritableKeyPath<RootState, AnnouncementState>","    private let toRootAction: @Sendable (AnnouncementAction) -> RootAction","    private let extractAction: @Sendable (RootAction) -> AnnouncementAction?","    private let service: AnnouncementService","","    public init(","        state: WritableKeyPath<RootState, AnnouncementState>,","        action toRootAction: @escaping @Sendable (AnnouncementAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> AnnouncementAction?,","        service: AnnouncementService","    ) {","        self.stateKeyPath = state","        self.toRootAction = toRootAction","        self.extractAction = extractAction","        self.service = service","    }","","    public func reduce(","        state: inout RootState,","        action: RootAction","    ) -> Effect<RootAction>? {","        guard let local = extractAction(action) else { return nil }","        let localEffect = reduceLocal(","            state: &state[keyPath: stateKeyPath],","            action: local","        )","        guard let localEffect else { return nil }","        let lift = toRootAction","        return { send in","            await localEffect { localAction in","                send(lift(localAction))","            }","        }","    }","","    private func reduceLocal(","        state: inout AnnouncementState,","        action: AnnouncementAction","    ) -> Effect<AnnouncementAction>? {","        switch action {","        case .fetch:","            state.isLoading = true","            let service = self.service","            return { send in","                do {","                    let message = try await service.fetch()","                    await send(.messageReceived(message))","                } catch {","                    await send(.fetchFailed(error.localizedDescription))","                }","            }","","        case .messageReceived(let message):","            state.message = message","            state.isLoading = false","            state.error = nil","","        case .fetchFailed(let message):","            state.isLoading = false","            state.error = message","","        case .dismiss:","            state.message = nil","        }","        return nil","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The public ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" method follows a fixed pattern: guard-extract the local action, delegate to a private ","type":"text"},{"code":"reduceLocal","type":"codeVoice"},{"text":", and lift any returned effect. The private ","type":"text"},{"code":"reduceLocal","type":"codeVoice"},{"text":" is where feature logic lives — it looks like any standard Swidux reducer.","type":"text"}]},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":"Domain plugins implement only "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":". The "},{"type":"codeVoice","code":"willReduce"},{"type":"text","text":" and "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" hooks are reserved for action-agnostic infrastructure like undo and persistence. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":" for the full distinction."}],"type":"paragraph"}]},{"type":"heading","level":2,"text":"Step 5: Wire Into the Host App","anchor":"Step-5-Wire-Into-the-Host-App"},{"type":"heading","level":3,"text":"Add state and action","anchor":"Add-state-and-action"},{"type":"codeListing","code":["@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    \/\/ ...","    var announcements = AnnouncementState()","}","","enum AppAction: Sendable {","    case items(ItemAction)","    \/\/ ...","    case announcements(AnnouncementAction)","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"Register the plugin","anchor":"Register-the-plugin"},{"type":"codeListing","code":["plugins.register(AnnouncementPlugin(","    state: \\.announcements,","    action: AppAction.announcements,","    extractAction: {","        if case .announcements(let a) = $0 { return a }","        return nil","    },","    service: .init { try await api.fetchAnnouncement() }","))"],"syntax":"swift"},{"type":"heading","level":3,"text":"Dispatch from views","anchor":"Dispatch-from-views"},{"type":"codeListing","code":["store.send(.announcements(.fetch))"],"syntax":"swift"},{"type":"heading","level":2,"text":"The Effect Lifting Pattern","anchor":"The-Effect-Lifting-Pattern"},{"type":"paragraph","inlineContent":[{"text":"The lift pattern bridges ","type":"text"},{"code":"Effect<FeatureAction>","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"Effect<RootAction>","type":"codeVoice"},{"text":". It appears in every domain plugin’s ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" method:","type":"text"}]},{"type":"codeListing","code":["let lift = toRootAction","return { send in                        \/\/ send: Send<RootAction>","    await localEffect { localAction in  \/\/ localAction: FeatureAction","        send(lift(localAction))         \/\/ lift: (FeatureAction) -> RootAction","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"localEffect","type":"codeVoice"},{"text":" expects a ","type":"text"},{"code":"Send<FeatureAction>","type":"codeVoice"},{"text":" callback, but ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference"},{"text":" expects ","type":"text"},{"code":"Effect<RootAction>","type":"codeVoice"},{"text":". The lift closure wraps each local action in the root enum before dispatching.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Capture ","type":"text"},{"code":"toRootAction","type":"codeVoice"},{"text":" into a local ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" before the closure to avoid capturing ","type":"text"},{"code":"self","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","level":2,"text":"Testing Domain Plugins","anchor":"Testing-Domain-Plugins"},{"type":"paragraph","inlineContent":[{"text":"Test plugins without a real app store. Define minimal ","type":"text"},{"code":"TestState","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"TestAction","type":"codeVoice"},{"text":" types, instantiate the plugin with test wiring, and assert on state mutations and effect presence.","type":"text"}]},{"type":"codeListing","code":["@Suite(\"AnnouncementPlugin\")","@MainActor","struct AnnouncementPluginTests {","    struct TestState: Sendable, Equatable {","        var announcements = AnnouncementState()","    }","","    enum TestAction: Sendable {","        case announcements(AnnouncementAction)","        case unrelated","    }","","    func makePlugin(","        service: AnnouncementService = .mock()","    ) -> AnnouncementPlugin<TestState, TestAction> {","        AnnouncementPlugin(","            state: \\.announcements,","            action: TestAction.announcements,","            extractAction: {","                if case .announcements(let a) = $0 { return a }","                return nil","            },","            service: service","        )","    }","","    @Test(\"ignores unrelated actions\")","    func ignoresUnrelated() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(state: &state, action: .unrelated)","        #expect(effect == nil)","    }","","    @Test(\"messageReceived updates state\")","    func messageReceived() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.messageReceived(\"Hello\"))","        )","        #expect(effect == nil)","        #expect(state.announcements.message == \"Hello\")","        #expect(state.announcements.isLoading == false)","    }","","    @Test(\"fetch returns an effect\")","    func fetchReturnsEffect() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.fetch)","        )","        #expect(effect != nil)","        #expect(state.announcements.isLoading == true)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"TestState","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"TestAction","type":"codeVoice"},{"text":" harness is lightweight and reusable. Each plugin’s test suite defines its own pair, keeping tests isolated from the real app’s types.","type":"text"}]},{"type":"heading","level":2,"text":"Next Steps","anchor":"Next-Steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"text":" — Understand the lifecycle hooks and core-vs-domain distinction","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","isActive":true},{"text":" — The snapshot pattern and ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" performance","type":"text"}]}]}]}],"kind":"content"}],"metadata":{"role":"article","title":"Building a Domain Plugin","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/buildingadomainplugin"]}],"references":{"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","title":"Plugin Architecture","role":"article","url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}]},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"kind":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"title":"Add Feature Flags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","role":"article"},"doc://Swidux/documentation/Swidux/PluginHost":{"navigatorTitle":[{"text":"PluginHost","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PluginHost","kind":"identifier"}],"abstract":[{"text":"Ordered registry of plugins that drives the dispatch lifecycle.","type":"text"}],"title":"PluginHost","type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","url":"\/documentation\/swidux\/pluginhost"},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"abstract":[{"text":"The 10 rules that shape every Swidux app, and the reasoning behind them.","type":"text"}],"title":"Design Principles","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","url":"\/documentation\/swidux\/designprinciples"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"type":"topic","url":"\/documentation\/swidux\/howtoaddicloudsync","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","kind":"article","role":"article","title":"Add iCloud Sync"},"doc://Swidux/documentation/Swidux":{"type":"topic","url":"\/documentation\/swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","role":"collection","title":"Swidux"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","title":"Add Analytics","role":"article","url":"\/documentation\/swidux\/howtoaddanalytics","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}]},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"type":"topic","url":"\/documentation\/swidux\/howtoaddpersistence","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","kind":"article","role":"article","title":"Add Persistence"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"abstract":[{"text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code.","type":"text"}],"kind":"article","type":"topic","title":"Cancel Effects","url":"\/documentation\/swidux\/howtocanceleffects","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","role":"article"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"type":"topic","url":"\/documentation\/swidux\/swiduxplugin","abstract":[{"text":"A plugin that participates in the Swidux dispatch cycle.","type":"text"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiduxPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"SwiduxPlugin","kind":"identifier"}],"title":"SwiduxPlugin"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","title":"Add a Parental Gate","role":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}]},"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","title":"Using the Swidux Agent Skill","role":"article","url":"\/documentation\/swidux\/agentskill","abstract":[{"text":"Install the bundled ","type":"text"},{"type":"codeVoice","code":"swidux-ref"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}]},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"type":"topic","url":"\/documentation\/swidux\/architectureguide","abstract":[{"text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","kind":"article","role":"article","title":"Architecture & Performance"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"kind":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","title":"Add a Version Killswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","role":"article","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}]}}}