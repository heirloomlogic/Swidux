{"sections":[],"metadata":{"title":"Building a Domain Plugin","roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/buildingadomainplugin"]}],"seeAlsoSections":[{"title":"How-to Guides","anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Domain plugins follow a consistent pattern: define feature state and actions, implement the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin"},{"type":"text","text":" protocol using the "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" hook, and wire the plugin into the host app at registration time. This guide walks through building a plugin from scratch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The example builds a fictional “Announcements” plugin that fetches a remote message and displays it."}]},{"type":"heading","anchor":"The-Three-Wiring-Pieces","level":2,"text":"The Three Wiring Pieces"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every domain plugin stores three closures that bridge its local types to the host app’s root types:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"State keypath"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"WritableKeyPath<RootState, FeatureState>","type":"codeVoice"},{"text":" locates the plugin’s state slice within root state.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Action lifter"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"(FeatureAction) -> RootAction","type":"codeVoice"},{"text":" wraps local actions into the root action enum.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Action extractor"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"(RootAction) -> FeatureAction?","type":"codeVoice"},{"text":" downcasts root actions to the plugin’s local type, returning ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for actions that belong to other features.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These are closures, not protocols. The host app provides them at init — no associated-type gymnastics or conformance wiring needed."}]},{"type":"heading","anchor":"Step-1-Define-Feature-State","level":2,"text":"Step 1: Define Feature State"},{"type":"codeListing","syntax":"swift","code":["public struct AnnouncementState: Sendable, Equatable {","    public var message: String?","    public var isLoading: Bool","    public var error: String?","","    public init(","        message: String? = nil,","        isLoading: Bool = false,","        error: String? = nil","    ) {","        self.message = message","        self.isLoading = isLoading","        self.error = error","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep state minimal — only what the UI needs to render and the reducer needs to decide."}]},{"type":"heading","anchor":"Step-2-Define-Feature-Actions","level":2,"text":"Step 2: Define Feature Actions"},{"type":"codeListing","syntax":"swift","code":["public enum AnnouncementAction: Sendable {","    case fetch","    case messageReceived(String?)","    case fetchFailed(String)","    case dismiss","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Actions are the plugin’s public API. The host app dispatches them by wrapping in the root action enum."}]},{"type":"heading","anchor":"Step-3-Define-the-Service","level":2,"text":"Step 3: Define the Service"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject async dependencies as a struct with closure properties. This makes testing trivial — swap closures instead of subclassing or mocking protocols. (Reach for a protocol instead only when third parties will implement the backend — see the service-shapes principle in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples"},{"type":"text","text":".)"}]},{"type":"codeListing","syntax":"swift","code":["public struct AnnouncementService: Sendable {","    public var fetch: @Sendable () async throws -> String?","","    public init(fetch: @escaping @Sendable () async throws -> String?) {","        self.fetch = fetch","    }","","    public static func mock(message: String? = \"Test\") -> Self {","        AnnouncementService { message }","    }","}"]},{"type":"heading","anchor":"Step-4-Implement-the-Plugin","level":2,"text":"Step 4: Implement the Plugin"},{"type":"codeListing","syntax":"swift","code":["import Swidux","","@MainActor","public struct AnnouncementPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    private let stateKeyPath: WritableKeyPath<RootState, AnnouncementState>","    private let toRootAction: @Sendable (AnnouncementAction) -> RootAction","    private let extractAction: @Sendable (RootAction) -> AnnouncementAction?","    private let service: AnnouncementService","","    public init(","        state: WritableKeyPath<RootState, AnnouncementState>,","        action toRootAction: @escaping @Sendable (AnnouncementAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> AnnouncementAction?,","        service: AnnouncementService","    ) {","        self.stateKeyPath = state","        self.toRootAction = toRootAction","        self.extractAction = extractAction","        self.service = service","    }","","    public func reduce(","        state: inout RootState,","        action: RootAction","    ) -> Effect<RootAction>? {","        guard let local = extractAction(action) else { return nil }","        let localEffect = reduceLocal(","            state: &state[keyPath: stateKeyPath],","            action: local","        )","        guard let localEffect else { return nil }","        let lift = toRootAction","        return { send in","            await localEffect { localAction in","                send(lift(localAction))","            }","        }","    }","","    private func reduceLocal(","        state: inout AnnouncementState,","        action: AnnouncementAction","    ) -> Effect<AnnouncementAction>? {","        switch action {","        case .fetch:","            state.isLoading = true","            let service = self.service","            return { send in","                do {","                    let message = try await service.fetch()","                    await send(.messageReceived(message))","                } catch {","                    await send(.fetchFailed(error.localizedDescription))","                }","            }","","        case .messageReceived(let message):","            state.message = message","            state.isLoading = false","            state.error = nil","","        case .fetchFailed(let message):","            state.isLoading = false","            state.error = message","","        case .dismiss:","            state.message = nil","        }","        return nil","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The public "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" method follows a fixed pattern: guard-extract the local action, delegate to a private "},{"type":"codeVoice","code":"reduceLocal"},{"type":"text","text":", and lift any returned effect. The private "},{"type":"codeVoice","code":"reduceLocal"},{"type":"text","text":" is where feature logic lives — it looks like any standard Swidux reducer."}]},{"type":"aside","name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Domain plugins implement only ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":". The ","type":"text"},{"code":"willReduce","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" hooks are reserved for action-agnostic infrastructure like undo and persistence. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":" for the full distinction.","type":"text"}]}]},{"type":"heading","anchor":"Step-5-Wire-Into-the-Host-App","level":2,"text":"Step 5: Wire Into the Host App"},{"type":"heading","anchor":"Add-state-and-action","level":3,"text":"Add state and action"},{"type":"codeListing","syntax":"swift","code":["@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    \/\/ ...","    var announcements = AnnouncementState()","}","","enum AppAction: Sendable {","    case items(ItemAction)","    \/\/ ...","    case announcements(AnnouncementAction)","}"]},{"type":"heading","anchor":"Register-the-plugin","level":3,"text":"Register the plugin"},{"type":"codeListing","syntax":"swift","code":["plugins.register(AnnouncementPlugin(","    state: \\.announcements,","    action: AppAction.announcements,","    extractAction: {","        if case .announcements(let a) = $0 { return a }","        return nil","    },","    service: .init { try await api.fetchAnnouncement() }","))"]},{"type":"heading","anchor":"Dispatch-from-views","level":3,"text":"Dispatch from views"},{"type":"codeListing","syntax":"swift","code":["store.send(.announcements(.fetch))"]},{"type":"heading","anchor":"The-Effect-Lifting-Pattern","level":2,"text":"The Effect Lifting Pattern"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The lift pattern bridges "},{"type":"codeVoice","code":"Effect<FeatureAction>"},{"type":"text","text":" to "},{"type":"codeVoice","code":"Effect<RootAction>"},{"type":"text","text":". It appears in every domain plugin’s "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" method:"}]},{"type":"codeListing","syntax":"swift","code":["let lift = toRootAction","return { send in                        \/\/ send: Send<RootAction>","    await localEffect { localAction in  \/\/ localAction: FeatureAction","        send(lift(localAction))         \/\/ lift: (FeatureAction) -> RootAction","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"localEffect"},{"type":"text","text":" expects a "},{"type":"codeVoice","code":"Send<FeatureAction>"},{"type":"text","text":" callback, but "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"type":"text","text":" expects "},{"type":"codeVoice","code":"Effect<RootAction>"},{"type":"text","text":". The lift closure wraps each local action in the root enum before dispatching."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Capture "},{"type":"codeVoice","code":"toRootAction"},{"type":"text","text":" into a local "},{"type":"codeVoice","code":"let"},{"type":"text","text":" before the closure to avoid capturing "},{"type":"codeVoice","code":"self"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Testing-Domain-Plugins","level":2,"text":"Testing Domain Plugins"},{"type":"paragraph","inlineContent":[{"text":"Test plugins without a real app store. Define minimal ","type":"text"},{"code":"TestState","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"TestAction","type":"codeVoice"},{"text":" types, instantiate the plugin with test wiring, and assert on state mutations and effect presence.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Suite(\"AnnouncementPlugin\")","@MainActor","struct AnnouncementPluginTests {","    struct TestState: Sendable, Equatable {","        var announcements = AnnouncementState()","    }","","    enum TestAction: Sendable {","        case announcements(AnnouncementAction)","        case unrelated","    }","","    func makePlugin(","        service: AnnouncementService = .mock()","    ) -> AnnouncementPlugin<TestState, TestAction> {","        AnnouncementPlugin(","            state: \\.announcements,","            action: TestAction.announcements,","            extractAction: {","                if case .announcements(let a) = $0 { return a }","                return nil","            },","            service: service","        )","    }","","    @Test(\"ignores unrelated actions\")","    func ignoresUnrelated() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(state: &state, action: .unrelated)","        #expect(effect == nil)","    }","","    @Test(\"messageReceived updates state\")","    func messageReceived() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.messageReceived(\"Hello\"))","        )","        #expect(effect == nil)","        #expect(state.announcements.message == \"Hello\")","        #expect(state.announcements.isLoading == false)","    }","","    @Test(\"fetch returns an effect\")","    func fetchReturnsEffect() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.fetch)","        )","        #expect(effect != nil)","        #expect(state.announcements.isLoading == true)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"TestState","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"TestAction","type":"codeVoice"},{"type":"text","text":" harness is lightweight and reusable. Each plugin’s test suite defines its own pair, keeping tests isolated from the real app’s types."}]},{"type":"heading","anchor":"Next-Steps","level":2,"text":"Next Steps"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"text":" — Understand the lifecycle hooks and core-vs-domain distinction","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","isActive":true,"type":"reference"},{"type":"text","text":" — The snapshot pattern and "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" performance"}]}]}],"type":"unorderedList"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"references":{"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"title":"Architecture & Performance","abstract":[{"text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","kind":"article","url":"\/documentation\/swidux\/architectureguide","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"kind":"article","role":"article","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"title":"Add a Parental Gate","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","url":"\/documentation\/swidux\/howtoaddaparentalgate","type":"topic"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"title":"Cancel Effects","abstract":[{"text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code.","type":"text"}],"type":"topic","kind":"article","url":"\/documentation\/swidux\/howtocanceleffects","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"title":"Add Analytics","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","kind":"article","url":"\/documentation\/swidux\/howtoaddanalytics","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/PluginHost":{"title":"PluginHost","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PluginHost","kind":"identifier"}],"navigatorTitle":[{"text":"PluginHost","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","abstract":[{"text":"Ordered registry of plugins that drives the dispatch lifecycle.","type":"text"}],"url":"\/documentation\/swidux\/pluginhost","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux":{"title":"Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection"},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"title":"Design Principles","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","abstract":[{"type":"text","text":"The 10 rules that shape every Swidux app, and the reasoning behind them."}],"url":"\/documentation\/swidux\/designprinciples","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"kind":"article","role":"article","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"title":"Add Feature Flags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"title":"Add iCloud Sync","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddicloudsync","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"kind":"article","role":"article","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"title":"Add a Paywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"title":"Plugin Architecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","kind":"article","url":"\/documentation\/swidux\/pluginarchitecture","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"kind":"symbol","role":"symbol","abstract":[{"text":"A plugin that participates in the Swidux dispatch cycle.","type":"text"}],"title":"SwiduxPlugin","navigatorTitle":[{"kind":"identifier","text":"SwiduxPlugin"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","url":"\/documentation\/swidux\/swiduxplugin","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiduxPlugin"}],"type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"kind":"article","role":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"title":"Add a Version Killswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"title":"Add Persistence","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":" classes, database actors, or ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","kind":"article","url":"\/documentation\/swidux\/howtoaddpersistence","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/AgentSkill":{"title":"Using the Swidux Agent Skill","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","abstract":[{"text":"Install the bundled ","type":"text"},{"code":"swidux-ref","type":"codeVoice"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"url":"\/documentation\/swidux\/agentskill","kind":"article","role":"article"}}}