{"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"Building a Domain Plugin"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Domain plugins follow a consistent pattern: define feature state and actions, implement the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin"},{"type":"text","text":" protocol using the "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" hook, and wire the plugin into the host app at registration time. This guide walks through building a plugin from scratch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The example builds a fictional “Announcements” plugin that fetches a remote message and displays it."}]},{"level":2,"text":"The Three Wiring Pieces","type":"heading","anchor":"The-Three-Wiring-Pieces"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every domain plugin stores three closures that bridge its local types to the host app’s root types:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"State keypath","type":"text"}]},{"type":"text","text":" — "},{"code":"WritableKeyPath<RootState, FeatureState>","type":"codeVoice"},{"type":"text","text":" locates the plugin’s state slice within root state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Action lifter","type":"text"}]},{"type":"text","text":" — "},{"code":"(FeatureAction) -> RootAction","type":"codeVoice"},{"type":"text","text":" wraps local actions into the root action enum."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Action extractor","type":"text"}]},{"type":"text","text":" — "},{"code":"(RootAction) -> FeatureAction?","type":"codeVoice"},{"type":"text","text":" downcasts root actions to the plugin’s local type, returning "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for actions that belong to other features."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These are closures, not protocols. The host app provides them at init — no associated-type gymnastics or conformance wiring needed."}]},{"level":2,"text":"Step 1: Define Feature State","type":"heading","anchor":"Step-1-Define-Feature-State"},{"code":["public struct AnnouncementState: Sendable, Equatable {","    public var message: String?","    public var isLoading: Bool","    public var error: String?","","    public init(","        message: String? = nil,","        isLoading: Bool = false,","        error: String? = nil","    ) {","        self.message = message","        self.isLoading = isLoading","        self.error = error","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep state minimal — only what the UI needs to render and the reducer needs to decide."}]},{"level":2,"text":"Step 2: Define Feature Actions","type":"heading","anchor":"Step-2-Define-Feature-Actions"},{"code":["public enum AnnouncementAction: Sendable {","    case fetch","    case messageReceived(String?)","    case fetchFailed(String)","    case dismiss","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Actions are the plugin’s public API. The host app dispatches them by wrapping in the root action enum."}]},{"level":2,"text":"Step 3: Define the Service","type":"heading","anchor":"Step-3-Define-the-Service"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject async dependencies as a struct with closure properties. This makes testing trivial — swap closures instead of subclassing or mocking protocols."}]},{"code":["public struct AnnouncementService: Sendable {","    public var fetch: @Sendable () async throws -> String?","","    public init(fetch: @escaping @Sendable () async throws -> String?) {","        self.fetch = fetch","    }","","    public static func mock(message: String? = \"Test\") -> Self {","        AnnouncementService { message }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Step 4: Implement the Plugin","type":"heading","anchor":"Step-4-Implement-the-Plugin"},{"code":["import Swidux","","@MainActor","public struct AnnouncementPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    private let stateKeyPath: WritableKeyPath<RootState, AnnouncementState>","    private let toRootAction: @Sendable (AnnouncementAction) -> RootAction","    private let extractAction: @Sendable (RootAction) -> AnnouncementAction?","    private let service: AnnouncementService","","    public init(","        state: WritableKeyPath<RootState, AnnouncementState>,","        action toRootAction: @escaping @Sendable (AnnouncementAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> AnnouncementAction?,","        service: AnnouncementService","    ) {","        self.stateKeyPath = state","        self.toRootAction = toRootAction","        self.extractAction = extractAction","        self.service = service","    }","","    public func reduce(","        state: inout RootState,","        action: RootAction","    ) -> Effect<RootAction>? {","        guard let local = extractAction(action) else { return nil }","        let localEffect = reduceLocal(","            state: &state[keyPath: stateKeyPath],","            action: local","        )","        guard let localEffect else { return nil }","        let lift = toRootAction","        return { send in","            await localEffect { localAction in","                send(lift(localAction))","            }","        }","    }","","    private func reduceLocal(","        state: inout AnnouncementState,","        action: AnnouncementAction","    ) -> Effect<AnnouncementAction>? {","        switch action {","        case .fetch:","            state.isLoading = true","            let service = self.service","            return { send in","                do {","                    let message = try await service.fetch()","                    await send(.messageReceived(message))","                } catch {","                    await send(.fetchFailed(error.localizedDescription))","                }","            }","","        case .messageReceived(let message):","            state.message = message","            state.isLoading = false","            state.error = nil","","        case .fetchFailed(let message):","            state.isLoading = false","            state.error = message","","        case .dismiss:","            state.message = nil","        }","        return nil","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The public "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" method follows a fixed pattern: guard-extract the local action, delegate to a private "},{"type":"codeVoice","code":"reduceLocal"},{"type":"text","text":", and lift any returned effect. The private "},{"type":"codeVoice","code":"reduceLocal"},{"type":"text","text":" is where feature logic lives — it looks like any standard Swidux reducer."}]},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Domain plugins implement only "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":". The "},{"type":"codeVoice","code":"willReduce"},{"type":"text","text":" and "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" hooks are reserved for action-agnostic infrastructure like undo and persistence. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":" for the full distinction."}]}]},{"level":2,"text":"Step 5: Wire Into the Host App","type":"heading","anchor":"Step-5-Wire-Into-the-Host-App"},{"level":3,"text":"Add state and action","type":"heading","anchor":"Add-state-and-action"},{"code":["@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    \/\/ ...","    var announcements = AnnouncementState()","}","","enum AppAction: Sendable {","    case items(ItemAction)","    \/\/ ...","    case announcements(AnnouncementAction)","}"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Register the plugin","type":"heading","anchor":"Register-the-plugin"},{"code":["plugins.register(AnnouncementPlugin(","    state: \\.announcements,","    action: AppAction.announcements,","    extractAction: {","        if case .announcements(let a) = $0 { return a }","        return nil","    },","    service: .init { try await api.fetchAnnouncement() }","))"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Dispatch from views","type":"heading","anchor":"Dispatch-from-views"},{"code":["store.send(.announcements(.fetch))"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"The Effect Lifting Pattern","type":"heading","anchor":"The-Effect-Lifting-Pattern"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The lift pattern bridges "},{"type":"codeVoice","code":"Effect<FeatureAction>"},{"type":"text","text":" to "},{"type":"codeVoice","code":"Effect<RootAction>"},{"type":"text","text":". It appears in every domain plugin’s "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" method:"}]},{"code":["let lift = toRootAction","return { send in                        \/\/ send: Send<RootAction>","    await localEffect { localAction in  \/\/ localAction: FeatureAction","        send(lift(localAction))         \/\/ lift: (FeatureAction) -> RootAction","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"localEffect"},{"type":"text","text":" expects a "},{"type":"codeVoice","code":"Send<FeatureAction>"},{"type":"text","text":" callback, but "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"type":"text","text":" expects "},{"type":"codeVoice","code":"Effect<RootAction>"},{"type":"text","text":". The lift closure wraps each local action in the root enum before dispatching."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Capture "},{"type":"codeVoice","code":"toRootAction"},{"type":"text","text":" into a local "},{"type":"codeVoice","code":"let"},{"type":"text","text":" before the closure to avoid capturing "},{"type":"codeVoice","code":"self"},{"type":"text","text":"."}]},{"level":2,"text":"Testing Domain Plugins","type":"heading","anchor":"Testing-Domain-Plugins"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Test plugins without a real app store. Define minimal "},{"type":"codeVoice","code":"TestState"},{"type":"text","text":" and "},{"type":"codeVoice","code":"TestAction"},{"type":"text","text":" types, instantiate the plugin with test wiring, and assert on state mutations and effect presence."}]},{"code":["@Suite(\"AnnouncementPlugin\")","@MainActor","struct AnnouncementPluginTests {","    struct TestState: Sendable, Equatable {","        var announcements = AnnouncementState()","    }","","    enum TestAction: Sendable {","        case announcements(AnnouncementAction)","        case unrelated","    }","","    func makePlugin(","        service: AnnouncementService = .mock()","    ) -> AnnouncementPlugin<TestState, TestAction> {","        AnnouncementPlugin(","            state: \\.announcements,","            action: TestAction.announcements,","            extractAction: {","                if case .announcements(let a) = $0 { return a }","                return nil","            },","            service: service","        )","    }","","    @Test(\"ignores unrelated actions\")","    func ignoresUnrelated() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(state: &state, action: .unrelated)","        #expect(effect == nil)","    }","","    @Test(\"messageReceived updates state\")","    func messageReceived() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.messageReceived(\"Hello\"))","        )","        #expect(effect == nil)","        #expect(state.announcements.message == \"Hello\")","        #expect(state.announcements.isLoading == false)","    }","","    @Test(\"fetch returns an effect\")","    func fetchReturnsEffect() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.fetch)","        )","        #expect(effect != nil)","        #expect(state.announcements.isLoading == true)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"TestState"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"TestAction"},{"type":"text","text":" harness is lightweight and reusable. Each plugin’s test suite defines its own pair, keeping tests isolated from the real app’s types."}]},{"level":2,"text":"Next Steps","type":"heading","anchor":"Next-Steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":" — Understand the lifecycle hooks and core-vs-domain distinction"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide"},{"type":"text","text":" — The snapshot pattern and "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" performance"}],"type":"paragraph"}]}]}]}],"seeAlsoSections":[{"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true}],"variants":[{"paths":["\/documentation\/swidux\/buildingadomainplugin"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"references":{"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","url":"\/documentation\/swidux\/architectureguide","title":"Architecture & Performance","abstract":[{"text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/AgentSkill":{"abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","type":"topic","title":"Using the Swidux Agent Skill","role":"article","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"kind":"article","role":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","title":"Add a Parental Gate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"kind":"article","role":"article","url":"\/documentation\/swidux\/howtoaddicloudsync","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","title":"Add iCloud Sync","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","url":"\/documentation\/swidux\/pluginarchitecture","type":"topic","title":"Plugin Architecture","role":"article","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"kind":"article","role":"article","url":"\/documentation\/swidux\/howtoaddpersistence","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","title":"Add Persistence","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/PluginHost":{"kind":"symbol","role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","url":"\/documentation\/swidux\/pluginhost","title":"PluginHost","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PluginHost","kind":"identifier"}],"abstract":[{"text":"Ordered registry of plugins that drives the dispatch lifecycle.","type":"text"}],"navigatorTitle":[{"text":"PluginHost","kind":"identifier"}],"type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","title":"Add a Version Killswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"kind":"article","role":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","title":"Add Feature Flags","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"kind":"article","role":"article","url":"\/documentation\/swidux\/howtoaddapaywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":