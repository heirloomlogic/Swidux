{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides","anchor":"How-to-Guides"}],"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"Building a Domain Plugin"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/buildingadomainplugin"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Domain plugins follow a consistent pattern: define feature state and actions, implement the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","type":"reference"},{"text":" protocol using the ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" hook, and wire the plugin into the host app at registration time. This guide walks through building a plugin from scratch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The example builds a fictional “Announcements” plugin that fetches a remote message and displays it.","type":"text"}]},{"type":"heading","anchor":"The-Three-Wiring-Pieces","level":2,"text":"The Three Wiring Pieces"},{"type":"paragraph","inlineContent":[{"text":"Every domain plugin stores three closures that bridge its local types to the host app’s root types:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"State keypath","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"WritableKeyPath<RootState, FeatureState>","type":"codeVoice"},{"text":" locates the plugin’s state slice within root state.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Action lifter","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"(FeatureAction) -> RootAction","type":"codeVoice"},{"text":" wraps local actions into the root action enum.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Action extractor","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"(RootAction) -> FeatureAction?","type":"codeVoice"},{"text":" downcasts root actions to the plugin’s local type, returning ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for actions that belong to other features.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These are closures, not protocols. The host app provides them at init — no associated-type gymnastics or conformance wiring needed."}]},{"type":"heading","level":2,"text":"Step 1: Define Feature State","anchor":"Step-1-Define-Feature-State"},{"type":"codeListing","syntax":"swift","code":["public struct AnnouncementState: Sendable, Equatable {","    public var message: String?","    public var isLoading: Bool","    public var error: String?","","    public init(","        message: String? = nil,","        isLoading: Bool = false,","        error: String? = nil","    ) {","        self.message = message","        self.isLoading = isLoading","        self.error = error","    }","}"]},{"inlineContent":[{"text":"Keep state minimal — only what the UI needs to render and the reducer needs to decide.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Step 2: Define Feature Actions","type":"heading","anchor":"Step-2-Define-Feature-Actions"},{"code":["public enum AnnouncementAction: Sendable {","    case fetch","    case messageReceived(String?)","    case fetchFailed(String)","    case dismiss","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Actions are the plugin’s public API. The host app dispatches them by wrapping in the root action enum."}],"type":"paragraph"},{"level":2,"text":"Step 3: Define the Service","type":"heading","anchor":"Step-3-Define-the-Service"},{"inlineContent":[{"text":"Inject async dependencies as a struct with closure properties. This makes testing trivial — swap closures instead of subclassing or mocking protocols. (Reach for a protocol instead only when third parties will implement the backend — see the service-shapes principle in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","type":"reference"},{"text":".)","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public struct AnnouncementService: Sendable {","    public var fetch: @Sendable () async throws -> String?","","    public init(fetch: @escaping @Sendable () async throws -> String?) {","        self.fetch = fetch","    }","","    public static func mock(message: String? = \"Test\") -> Self {","        AnnouncementService { message }","    }","}"]},{"level":2,"text":"Step 4: Implement the Plugin","type":"heading","anchor":"Step-4-Implement-the-Plugin"},{"type":"codeListing","syntax":"swift","code":["import Swidux","","@MainActor","public struct AnnouncementPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    private let stateKeyPath: WritableKeyPath<RootState, AnnouncementState>","    private let toRootAction: @Sendable (AnnouncementAction) -> RootAction","    private let extractAction: @Sendable (RootAction) -> AnnouncementAction?","    private let service: AnnouncementService","","    public init(","        state: WritableKeyPath<RootState, AnnouncementState>,","        action toRootAction: @escaping @Sendable (AnnouncementAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> AnnouncementAction?,","        service: AnnouncementService","    ) {","        self.stateKeyPath = state","        self.toRootAction = toRootAction","        self.extractAction = extractAction","        self.service = service","    }","","    public func reduce(","        state: inout RootState,","        action: RootAction","    ) -> Effect<RootAction>? {","        guard let local = extractAction(action) else { return nil }","        let localEffect = reduceLocal(","            state: &state[keyPath: stateKeyPath],","            action: local","        )","        guard let localEffect else { return nil }","        let lift = toRootAction","        return { send in","            await localEffect { localAction in","                send(lift(localAction))","            }","        }","    }","","    private func reduceLocal(","        state: inout AnnouncementState,","        action: AnnouncementAction","    ) -> Effect<AnnouncementAction>? {","        switch action {","        case .fetch:","            state.isLoading = true","            let service = self.service","            return { send in","                do {","                    let message = try await service.fetch()","                    await send(.messageReceived(message))","                } catch {","                    await send(.fetchFailed(error.localizedDescription))","                }","            }","","        case .messageReceived(let message):","            state.message = message","            state.isLoading = false","            state.error = nil","","        case .fetchFailed(let message):","            state.isLoading = false","            state.error = message","","        case .dismiss:","            state.message = nil","        }","        return nil","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The public ","type":"text"},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" method follows a fixed pattern: guard-extract the local action, delegate to a private "},{"code":"reduceLocal","type":"codeVoice"},{"type":"text","text":", and lift any returned effect. The private "},{"type":"codeVoice","code":"reduceLocal"},{"type":"text","text":" is where feature logic lives — it looks like any standard Swidux reducer."}]},{"type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Domain plugins implement only ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"willReduce"},{"type":"text","text":" and "},{"code":"afterReduce","type":"codeVoice"},{"type":"text","text":" hooks are reserved for action-agnostic infrastructure like undo and persistence. See "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":" for the full distinction.","type":"text"}]}],"name":"Important"},{"type":"heading","level":2,"text":"Step 5: Wire Into the Host App","anchor":"Step-5-Wire-Into-the-Host-App"},{"type":"heading","level":3,"text":"Add state and action","anchor":"Add-state-and-action"},{"code":["@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    \/\/ ...","    var announcements = AnnouncementState()","}","","enum AppAction: Sendable {","    case items(ItemAction)","    \/\/ ...","    case announcements(AnnouncementAction)","}"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Register the plugin","type":"heading","anchor":"Register-the-plugin"},{"code":["plugins.register(AnnouncementPlugin(","    state: \\.announcements,","    action: AppAction.announcements,","    extractAction: {","        if case .announcements(let a) = $0 { return a }","        return nil","    },","    service: .init { try await api.fetchAnnouncement() }","))"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Dispatch from views","type":"heading","anchor":"Dispatch-from-views"},{"code":["store.send(.announcements(.fetch))"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"The Effect Lifting Pattern","type":"heading","anchor":"The-Effect-Lifting-Pattern"},{"inlineContent":[{"text":"The lift pattern bridges ","type":"text"},{"code":"Effect<FeatureAction>","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"Effect<RootAction>","type":"codeVoice"},{"text":". It appears in every domain plugin’s ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" method:","type":"text"}],"type":"paragraph"},{"code":["let lift = toRootAction","return { send in                        \/\/ send: Send<RootAction>","    await localEffect { localAction in  \/\/ localAction: FeatureAction","        send(lift(localAction))         \/\/ lift: (FeatureAction) -> RootAction","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"localEffect","type":"codeVoice"},{"text":" expects a ","type":"text"},{"code":"Send<FeatureAction>","type":"codeVoice"},{"text":" callback, but ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"type":"text","text":" expects "},{"type":"codeVoice","code":"Effect<RootAction>"},{"type":"text","text":". The lift closure wraps each local action in the root enum before dispatching."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Capture "},{"type":"codeVoice","code":"toRootAction"},{"type":"text","text":" into a local "},{"type":"codeVoice","code":"let"},{"type":"text","text":" before the closure to avoid capturing "},{"type":"codeVoice","code":"self"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Testing-Domain-Plugins","text":"Testing Domain Plugins"},{"type":"paragraph","inlineContent":[{"text":"Test plugins without a real app store. Define minimal ","type":"text"},{"code":"TestState","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"TestAction"},{"type":"text","text":" types, instantiate the plugin with test wiring, and assert on state mutations and effect presence."}]},{"type":"codeListing","syntax":"swift","code":["@Suite(\"AnnouncementPlugin\")","@MainActor","struct AnnouncementPluginTests {","    struct TestState: Sendable, Equatable {","        var announcements = AnnouncementState()","    }","","    enum TestAction: Sendable {","        case announcements(AnnouncementAction)","        case unrelated","    }","","    func makePlugin(","        service: AnnouncementService = .mock()","    ) -> AnnouncementPlugin<TestState, TestAction> {","        AnnouncementPlugin(","            state: \\.announcements,","            action: TestAction.announcements,","            extractAction: {","                if case .announcements(let a) = $0 { return a }","                return nil","            },","            service: service","        )","    }","","    @Test(\"ignores unrelated actions\")","    func ignoresUnrelated() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(state: &state, action: .unrelated)","        #expect(effect == nil)","    }","","    @Test(\"messageReceived updates state\")","    func messageReceived() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.messageReceived(\"Hello\"))","        )","        #expect(effect == nil)","        #expect(state.announcements.message == \"Hello\")","        #expect(state.announcements.isLoading == false)","    }","","    @Test(\"fetch returns an effect\")","    func fetchReturnsEffect() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.fetch)","        )","        #expect(effect != nil)","        #expect(state.announcements.isLoading == true)","    }","}"]},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"TestState"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"TestAction"},{"type":"text","text":" harness is lightweight and reusable. Each plugin’s test suite defines its own pair, keeping tests isolated from the real app’s types."}],"type":"paragraph"},{"text":"Next Steps","anchor":"Next-Steps","level":2,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"text":" — Understand the lifecycle hooks and core-vs-domain distinction","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","isActive":true},{"text":" — The snapshot pattern and ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" performance","type":"text"}]}]}],"type":"unorderedList"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://Swidux/documentation/Swidux/PluginArchitecture":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic","kind":"article","title":"Plugin Architecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"url":"\/documentation\/swidux\/pluginarchitecture","role":"article"},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"kind":"article","type":"topic","title":"Design Principles","url":"\/documentation\/swidux\/designprinciples","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","abstract":[{"text":"The 10 rules that shape every Swidux app, and the reasoning behind them.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"topic","kind":"article","title":"Add a Paywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddapaywall","role":"article"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"url":"\/documentation\/swidux\/howtocanceleffects","type":"topic","title":"Cancel Effects"},"doc://Swidux/documentation/Swidux":{"abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","kind":"symbol","role":"collection","title":"Swidux"},"doc://Swidux/documentation/Swidux/PluginHost":{"url":"\/documentation\/swidux\/pluginhost","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PluginHost"}],"navigatorTitle":[{"kind":"identifier","text":"PluginHost"}],"title":"PluginHost","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}],"kind":"symbol"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"kind":"article","title":"Add a Version Killswitch","type":"topic"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiduxPlugin","kind":"identifier"}],"abstract":[{"type":"text","text":"A plugin that participates in the Swidux dispatch cycle."}],"type":"topic","title":"SwiduxPlugin","role":"symbol","navigatorTitle":[{"text":"SwiduxPlugin","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","url":"\/documentation\/swidux\/swiduxplugin"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","type":"topic","kind":"article","title":"Add Analytics","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddanalytics","role":"article"},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","type":"topic","kind":"article","title":"Using the Swidux Agent Skill","abstract":[{"text":"Install the bundled ","type":"text"},{"type":"codeVoice","code":"swidux-ref"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"url":"\/documentation\/swidux\/agentskill","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"url":"\/documentation\/swidux\/howtoaddpersistence","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","title":"Add Persistence","role":"article","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" plugin and the ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" macro — no hand-written ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":" classes, database actors, or ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"text":" closures.","type":"text"}],"type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"url":"\/documentation\/swidux\/howtoaddaparentalgate","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","title":"Add a Parental Gate","role":"article","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"topic","kind":"article","title":"Add iCloud Sync","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddicloudsync","role":"article"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","title":"Architecture & Performance","url":"\/documentation\/swidux\/architectureguide","type":"topic","abstract":[{"text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system.","type":"text"}],"kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"topic","kind":"article","title":"Add Feature Flags","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddfeatureflags","role":"article"}}}