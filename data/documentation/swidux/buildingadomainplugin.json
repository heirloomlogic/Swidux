rsion Killswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"role":"article","url":"\/documentation\/swidux\/howtoaddapaywall","kind":"article","type":"topic","title":"Add a Paywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},"doc://Swidux/documentation/Swidux/PluginHost":{"type":"topic","title":"PluginHost","abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}],"navigatorTitle":[{"kind":"identifier","text":"PluginHost"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PluginHost"}],"url":"\/documentation\/swidux\/pluginhost","role":"symbol"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":" with the "},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"role":"article","url":"\/documentation\/swidux\/howtoaddicloudsync","kind":"article","type":"topic","title":"Add iCloud Sync","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","abstract":[{"type":"text","text":"The 10 rules that shape every Swidux app, and the reasoning behind them."}],"role":"article","kind":"article","type":"topic","url":"\/documentation\/swidux\/designprinciples","title":"Design Principles"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"role":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article","type":"topic","title":"Add Feature Flags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"role":"article","url":"\/documentation\/swidux\/howtoaddanalytics","kind":"article","type":"topic","title":"Add Analytics","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"role":"article","kind":"article","type":"topic","url":"\/documentation\/swidux\/agentskill","title":"Using the Swidux Agent Skill"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"role":"article","kind":"article","type":"topic","url":"\/documentation\/swidux\/howtocanceleffects","title":"Cancel Effects"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"role":"article","kind":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddpersistence","title":"Add Persistence"}}}