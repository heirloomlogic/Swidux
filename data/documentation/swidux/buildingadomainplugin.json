{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/buildingadomainplugin"]}],"abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Domain plugins follow a consistent pattern: define feature state and actions, implement the "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","type":"reference","isActive":true},{"type":"text","text":" protocol using the "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" hook, and wire the plugin into the host app at registration time. This guide walks through building a plugin from scratch."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The example builds a fictional “Announcements” plugin that fetches a remote message and displays it."}],"type":"paragraph"},{"level":2,"text":"The Three Wiring Pieces","type":"heading","anchor":"The-Three-Wiring-Pieces"},{"inlineContent":[{"type":"text","text":"Every domain plugin stores three closures that bridge its local types to the host app’s root types:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"State keypath","type":"text"}],"type":"strong"},{"type":"text","text":" — "},{"type":"codeVoice","code":"WritableKeyPath<RootState, FeatureState>"},{"type":"text","text":" locates the plugin’s state slice within root state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Action lifter","type":"text"}],"type":"strong"},{"type":"text","text":" — "},{"type":"codeVoice","code":"(FeatureAction) -> RootAction"},{"type":"text","text":" wraps local actions into the root action enum."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Action extractor","type":"text"}],"type":"strong"},{"type":"text","text":" — "},{"type":"codeVoice","code":"(RootAction) -> FeatureAction?"},{"type":"text","text":" downcasts root actions to the plugin’s local type, returning "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for actions that belong to other features."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"These are closures, not protocols. The host app provides them at init — no associated-type gymnastics or conformance wiring needed."}],"type":"paragraph"},{"level":2,"text":"Step 1: Define Feature State","type":"heading","anchor":"Step-1-Define-Feature-State"},{"syntax":"swift","code":["public struct AnnouncementState: Sendable, Equatable {","    public var message: String?","    public var isLoading: Bool","    public var error: String?","","    public init(","        message: String? = nil,","        isLoading: Bool = false,","        error: String? = nil","    ) {","        self.message = message","        self.isLoading = isLoading","        self.error = error","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Keep state minimal — only what the UI needs to render and the reducer needs to decide."}],"type":"paragraph"},{"level":2,"text":"Step 2: Define Feature Actions","type":"heading","anchor":"Step-2-Define-Feature-Actions"},{"syntax":"swift","code":["public enum AnnouncementAction: Sendable {","    case fetch","    case messageReceived(String?)","    case fetchFailed(String)","    case dismiss","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Actions are the plugin’s public API. The host app dispatches them by wrapping in the root action enum."}],"type":"paragraph"},{"level":2,"text":"Step 3: Define the Service","type":"heading","anchor":"Step-3-Define-the-Service"},{"inlineContent":[{"type":"text","text":"Inject async dependencies as a struct with closure properties. This makes testing trivial — swap closures instead of subclassing or mocking protocols."}],"type":"paragraph"},{"syntax":"swift","code":["public struct AnnouncementService: Sendable {","    public var fetch: @Sendable () async throws -> String?","","    public init(fetch: @escaping @Sendable () async throws -> String?) {","        self.fetch = fetch","    }","","    public static func mock(message: String? = \"Test\") -> Self {","        AnnouncementService { message }","    }","}"],"type":"codeListing"},{"level":2,"text":"Step 4: Implement the Plugin","type":"heading","anchor":"Step-4-Implement-the-Plugin"},{"syntax":"swift","code":["import Swidux","","@MainActor","public struct AnnouncementPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    private let stateKeyPath: WritableKeyPath<RootState, AnnouncementState>","    private let toRootAction: @Sendable (AnnouncementAction) -> RootAction","    private let extractAction: @Sendable (RootAction) -> AnnouncementAction?","    private let service: AnnouncementService","","    public init(","        state: WritableKeyPath<RootState, AnnouncementState>,","        action toRootAction: @escaping @Sendable (AnnouncementAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> AnnouncementAction?,","        service: AnnouncementService","    ) {","        self.stateKeyPath = state","        self.toRootAction = toRootAction","        self.extractAction = extractAction","        self.service = service","    }","","    public func reduce(","        state: inout RootState,","        action: RootAction","    ) -> Effect<RootAction>? {","        guard let local = extractAction(action) else { return nil }","        let localEffect = reduceLocal(","            state: &state[keyPath: stateKeyPath],","            action: local","        )","        guard let localEffect else { return nil }","        let lift = toRootAction","        return { send in","            await localEffect { localAction in","                send(lift(localAction))","            }","        }","    }","","    private func reduceLocal(","        state: inout AnnouncementState,","        action: AnnouncementAction","    ) -> Effect<AnnouncementAction>? {","        switch action {","        case .fetch:","            state.isLoading = true","            let service = self.service","            return { send in","                do {","                    let message = try await service.fetch()","                    await send(.messageReceived(message))","                } catch {","                    await send(.fetchFailed(error.localizedDescription))","                }","            }","","        case .messageReceived(let message):","            state.message = message","            state.isLoading = false","            state.error = nil","","        case .fetchFailed(let message):","            state.isLoading = false","            state.error = message","","        case .dismiss:","            state.message = nil","        }","        return nil","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The public "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" method follows a fixed pattern: guard-extract the local action, delegate to a private "},{"code":"reduceLocal","type":"codeVoice"},{"type":"text","text":", and lift any returned effect. The private "},{"code":"reduceLocal","type":"codeVoice"},{"type":"text","text":" is where feature logic lives — it looks like any standard Swidux reducer."}],"type":"paragraph"},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"text":"Domain plugins implement only ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":". The ","type":"text"},{"code":"willReduce","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" hooks are reserved for action-agnostic infrastructure like undo and persistence. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":" for the full distinction.","type":"text"}],"type":"paragraph"}]},{"level":2,"text":"Step 5: Wire Into the Host App","type":"heading","anchor":"Step-5-Wire-Into-the-Host-App"},{"level":3,"text":"Add state and action","type":"heading","anchor":"Add-state-and-action"},{"syntax":"swift","code":["@SwiduxState","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    \/\/ ...","    var announcements = AnnouncementState()","}","","enum AppAction: Sendable {","    case items(ItemAction)","    \/\/ ...","    case announcements(AnnouncementAction)","}"],"type":"codeListing"},{"level":3,"text":"Register the plugin","type":"heading","anchor":"Register-the-plugin"},{"syntax":"swift","code":["plugins.register(AnnouncementPlugin(","    state: \\.announcements,","    action: AppAction.announcements,","    extractAction: {","        if case .announcements(let a) = $0 { return a }","        return nil","    },","    service: .init { try await api.fetchAnnouncement() }","))"],"type":"codeListing"},{"level":3,"text":"Dispatch from views","type":"heading","anchor":"Dispatch-from-views"},{"syntax":"swift","code":["store.send(.announcements(.fetch))"],"type":"codeListing"},{"level":2,"text":"The Effect Lifting Pattern","type":"heading","anchor":"The-Effect-Lifting-Pattern"},{"inlineContent":[{"type":"text","text":"The lift pattern bridges "},{"code":"Effect<FeatureAction>","type":"codeVoice"},{"type":"text","text":" to "},{"code":"Effect<RootAction>","type":"codeVoice"},{"text":". It appears in every domain plugin’s ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" method:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let lift = toRootAction","return { send in                        \/\/ send: Send<RootAction>","    await localEffect { localAction in  \/\/ localAction: FeatureAction","        send(lift(localAction))         \/\/ lift: (FeatureAction) -> RootAction","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"localEffect","type":"codeVoice"},{"text":" expects a ","type":"text"},{"code":"Send<FeatureAction>","type":"codeVoice"},{"text":" callback, but ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","isActive":true,"type":"reference"},{"text":" expects ","type":"text"},{"code":"Effect<RootAction>","type":"codeVoice"},{"text":". The lift closure wraps each local action in the root enum before dispatching.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Capture ","type":"text"},{"code":"toRootAction","type":"codeVoice"},{"text":" into a local ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" before the closure to avoid capturing ","type":"text"},{"code":"self","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Testing Domain Plugins","type":"heading","anchor":"Testing-Domain-Plugins"},{"inlineContent":[{"text":"Test plugins without a real app store. Define minimal ","type":"text"},{"code":"TestState","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"TestAction","type":"codeVoice"},{"text":" types, instantiate the plugin with test wiring, and assert on state mutations and effect presence.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Suite(\"AnnouncementPlugin\")","@MainActor","struct AnnouncementPluginTests {","    struct TestState: Sendable, Equatable {","        var announcements = AnnouncementState()","    }","","    enum TestAction: Sendable {","        case announcements(AnnouncementAction)","        case unrelated","    }","","    func makePlugin(","        service: AnnouncementService = .mock()","    ) -> AnnouncementPlugin<TestState, TestAction> {","        AnnouncementPlugin(","            state: \\.announcements,","            action: TestAction.announcements,","            extractAction: {","                if case .announcements(let a) = $0 { return a }","                return nil","            },","            service: service","        )","    }","","    @Test(\"ignores unrelated actions\")","    func ignoresUnrelated() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(state: &state, action: .unrelated)","        #expect(effect == nil)","    }","","    @Test(\"messageReceived updates state\")","    func messageReceived() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.messageReceived(\"Hello\"))","        )","        #expect(effect == nil)","        #expect(state.announcements.message == \"Hello\")","        #expect(state.announcements.isLoading == false)","    }","","    @Test(\"fetch returns an effect\")","    func fetchReturnsEffect() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.fetch)","        )","        #expect(effect != nil)","        #expect(state.announcements.isLoading == true)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"TestState","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"TestAction","type":"codeVoice"},{"text":" harness is lightweight and reusable. Each plugin’s test suite defines its own pair, keeping tests isolated from the real app’s types.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Next Steps","type":"heading","anchor":"Next-Steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":" — Understand the lifecycle hooks and core-vs-domain distinction","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","isActive":true,"type":"reference"},{"text":" — The snapshot pattern and ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" performance","type":"text"}],"type":"paragraph"}]}]}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","interfaceLanguage":"swift"},"kind":"article","sections":[],"metadata":{"roleHeading":"Article","title":"Building a Domain Plugin","modules":[{"name":"Swidux"}],"role":"article"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"title":"How-to Guides"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://Swidux/documentation/Swidux/PluginHost":{"type":"topic","title":"PluginHost","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"PluginHost","kind":"identifier"}],"navigatorTitle":[{"text":"PluginHost","kind":"identifier"}],"url":"\/documentation\/swidux\/pluginhost","abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"title":"Add a Paywall","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"topic"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"role":"article","kind":"article","abstract":[{"text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system.","type":"text"}],"title":"Architecture & Performance","url":"\/documentation\/swidux\/architectureguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","type":"topic"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiduxPlugin"}],"abstract":[{"text":"A plugin that participates in the Swidux dispatch cycle.","type":"text"}],"navigatorTitle":[{"text":"SwiduxPlugin","kind":"identifier"}],"title":"SwiduxPlugin","url":"\/documentation\/swidux\/swiduxplugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","title":"Add a Version Killswitch"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","kind":"article","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"title":"Plugin Architecture","url":"\/documentation\/swidux\/pluginarchitecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic"},"doc://Swidux/documentation/Swidux/AgentSkill":{"role":"article","kind":"article","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"title":"Using the Swidux Agent Skill","url":"\/documentation\/swidux\/agentskill","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","type":"topic"},"doc://Swidux/documentation/Swidux":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"title":"Swidux","kind":"symbol","url":"\/documentation\/swidux","role":"collection"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"title":"Add a Parental Gate","url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","type":"topic"}}}