{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Domain plugins follow a consistent pattern: define feature state and actions, implement the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin"},{"text":" protocol using the ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" hook, and wire the plugin into the host app at registration time. This guide walks through building a plugin from scratch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The example builds a fictional “Announcements” plugin that fetches a remote message and displays it.","type":"text"}]},{"anchor":"The-Three-Wiring-Pieces","level":2,"type":"heading","text":"The Three Wiring Pieces"},{"type":"paragraph","inlineContent":[{"text":"Every domain plugin stores three closures that bridge its local types to the host app’s root types:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State keypath"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"WritableKeyPath<RootState, FeatureState>"},{"type":"text","text":" locates the plugin’s state slice within root state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action lifter"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"(FeatureAction) -> RootAction"},{"type":"text","text":" wraps local actions into the root action enum."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action extractor"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"(RootAction) -> FeatureAction?"},{"type":"text","text":" downcasts root actions to the plugin’s local type, returning "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for actions that belong to other features."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"These are closures, not protocols. The host app provides them at init — no associated-type gymnastics or conformance wiring needed.","type":"text"}]},{"anchor":"Step-1-Define-Feature-State","level":2,"type":"heading","text":"Step 1: Define Feature State"},{"syntax":"swift","type":"codeListing","code":["public struct AnnouncementState: Sendable, Equatable {","    public var message: String?","    public var isLoading: Bool","    public var error: String?","","    public init(","        message: String? = nil,","        isLoading: Bool = false,","        error: String? = nil","    ) {","        self.message = message","        self.isLoading = isLoading","        self.error = error","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Keep state minimal — only what the UI needs to render and the reducer needs to decide.","type":"text"}]},{"anchor":"Step-2-Define-Feature-Actions","level":2,"type":"heading","text":"Step 2: Define Feature Actions"},{"syntax":"swift","type":"codeListing","code":["public enum AnnouncementAction: Sendable {","    case fetch","    case messageReceived(String?)","    case fetchFailed(String)","    case dismiss","}"]},{"type":"paragraph","inlineContent":[{"text":"Actions are the plugin’s public API. The host app dispatches them by wrapping in the root action enum.","type":"text"}]},{"anchor":"Step-3-Define-the-Service","level":2,"type":"heading","text":"Step 3: Define the Service"},{"type":"paragraph","inlineContent":[{"text":"Inject async dependencies as a struct with closure properties. This makes testing trivial — swap closures instead of subclassing or mocking protocols. (Reach for a protocol instead only when third parties will implement the backend — see the service-shapes principle in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples"},{"text":".)","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["public struct AnnouncementService: Sendable {","    public var fetch: @Sendable () async throws -> String?","","    public init(fetch: @escaping @Sendable () async throws -> String?) {","        self.fetch = fetch","    }","","    public static func mock(message: String? = \"Test\") -> Self {","        AnnouncementService { message }","    }","}"]},{"anchor":"Step-4-Implement-the-Plugin","level":2,"type":"heading","text":"Step 4: Implement the Plugin"},{"syntax":"swift","type":"codeListing","code":["import Swidux","","@MainActor","public struct AnnouncementPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    private let stateKeyPath: WritableKeyPath<RootState, AnnouncementState>","    private let toRootAction: @Sendable (AnnouncementAction) -> RootAction","    private let extractAction: @Sendable (RootAction) -> AnnouncementAction?","    private let service: AnnouncementService","","    public init(","        state: WritableKeyPath<RootState, AnnouncementState>,","        action toRootAction: @escaping @Sendable (AnnouncementAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> AnnouncementAction?,","        service: AnnouncementService","    ) {","        self.stateKeyPath = state","        self.toRootAction = toRootAction","        self.extractAction = extractAction","        self.service = service","    }","","    public func reduce(","        state: inout RootState,","        action: RootAction","    ) -> Effect<RootAction>? {","        guard let local = extractAction(action) else { return nil }","        let localEffect = reduceLocal(","            state: &state[keyPath: stateKeyPath],","            action: local","        )","        guard let localEffect else { return nil }","        let lift = toRootAction","        return { send in","            await localEffect { localAction in","                send(lift(localAction))","            }","        }","    }","","    private func reduceLocal(","        state: inout AnnouncementState,","        action: AnnouncementAction","    ) -> Effect<AnnouncementAction>? {","        switch action {","        case .fetch:","            state.isLoading = true","            let service = self.service","            return { send in","                do {","                    let message = try await service.fetch()","                    await send(.messageReceived(message))","                } catch {","                    await send(.fetchFailed(error.localizedDescription))","                }","            }","","        case .messageReceived(let message):","            state.message = message","            state.isLoading = false","            state.error = nil","","        case .fetchFailed(let message):","            state.isLoading = false","            state.error = message","","        case .dismiss:","            state.message = nil","        }","        return nil","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The public ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" method follows a fixed pattern: guard-extract the local action, delegate to a private ","type":"text"},{"code":"reduceLocal","type":"codeVoice"},{"text":", and lift any returned effect. The private ","type":"text"},{"code":"reduceLocal","type":"codeVoice"},{"text":" is where feature logic lives — it looks like any standard Swidux reducer.","type":"text"}]},{"style":"important","name":"Important","content":[{"inlineContent":[{"text":"Domain plugins implement only ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"willReduce"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":" hooks are reserved for action-agnostic infrastructure like undo and persistence. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":" for the full distinction.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"anchor":"Step-5-Wire-Into-the-Host-App","level":2,"type":"heading","text":"Step 5: Wire Into the Host App"},{"anchor":"Add-state-and-action","level":3,"type":"heading","text":"Add state and action"},{"syntax":"swift","type":"codeListing","code":["@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    \/\/ ...","    var announcements = AnnouncementState()","}","","enum AppAction: Sendable {","    case items(ItemAction)","    \/\/ ...","    case announcements(AnnouncementAction)","}"]},{"anchor":"Register-the-plugin","level":3,"type":"heading","text":"Register the plugin"},{"syntax":"swift","type":"codeListing","code":["plugins.register(AnnouncementPlugin(","    state: \\.announcements,","    action: AppAction.announcements,","    extractAction: {","        if case .announcements(let a) = $0 { return a }","        return nil","    },","    service: .init { try await api.fetchAnnouncement() }","))"]},{"anchor":"Dispatch-from-views","level":3,"type":"heading","text":"Dispatch from views"},{"syntax":"swift","type":"codeListing","code":["store.send(.announcements(.fetch))"]},{"anchor":"The-Effect-Lifting-Pattern","level":2,"type":"heading","text":"The Effect Lifting Pattern"},{"type":"paragraph","inlineContent":[{"text":"The lift pattern bridges ","type":"text"},{"code":"Effect<FeatureAction>","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"Effect<RootAction>","type":"codeVoice"},{"text":". It appears in every domain plugin’s ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" method:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let lift = toRootAction","return { send in                        \/\/ send: Send<RootAction>","    await localEffect { localAction in  \/\/ localAction: FeatureAction","        send(lift(localAction))         \/\/ lift: (FeatureAction) -> RootAction","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"localEffect","type":"codeVoice"},{"text":" expects a ","type":"text"},{"code":"Send<FeatureAction>","type":"codeVoice"},{"text":" callback, but ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"text":" expects ","type":"text"},{"code":"Effect<RootAction>","type":"codeVoice"},{"text":". The lift closure wraps each local action in the root enum before dispatching.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Capture ","type":"text"},{"code":"toRootAction","type":"codeVoice"},{"text":" into a local ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" before the closure to avoid capturing ","type":"text"},{"code":"self","type":"codeVoice"},{"text":".","type":"text"}]},{"anchor":"Testing-Domain-Plugins","level":2,"type":"heading","text":"Testing Domain Plugins"},{"type":"paragraph","inlineContent":[{"text":"Test plugins without a real app store. Define minimal ","type":"text"},{"code":"TestState","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"TestAction","type":"codeVoice"},{"text":" types, instantiate the plugin with test wiring, and assert on state mutations and effect presence.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@Suite(\"AnnouncementPlugin\")","@MainActor","struct AnnouncementPluginTests {","    struct TestState: Sendable, Equatable {","        var announcements = AnnouncementState()","    }","","    enum TestAction: Sendable {","        case announcements(AnnouncementAction)","        case unrelated","    }","","    func makePlugin(","        service: AnnouncementService = .mock()","    ) -> AnnouncementPlugin<TestState, TestAction> {","        AnnouncementPlugin(","            state: \\.announcements,","            action: TestAction.announcements,","            extractAction: {","                if case .announcements(let a) = $0 { return a }","                return nil","            },","            service: service","        )","    }","","    @Test(\"ignores unrelated actions\")","    func ignoresUnrelated() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(state: &state, action: .unrelated)","        #expect(effect == nil)","    }","","    @Test(\"messageReceived updates state\")","    func messageReceived() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.messageReceived(\"Hello\"))","        )","        #expect(effect == nil)","        #expect(state.announcements.message == \"Hello\")","        #expect(state.announcements.isLoading == false)","    }","","    @Test(\"fetch returns an effect\")","    func fetchReturnsEffect() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.fetch)","        )","        #expect(effect != nil)","        #expect(state.announcements.isLoading == true)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"TestState","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"TestAction","type":"codeVoice"},{"text":" harness is lightweight and reusable. Each plugin’s test suite defines its own pair, keeping tests isolated from the real app’s types.","type":"text"}]},{"anchor":"Next-Steps","level":2,"type":"heading","text":"Next Steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":" — Understand the lifecycle hooks and core-vs-domain distinction"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","isActive":true},{"type":"text","text":" — The snapshot pattern and "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" performance"}],"type":"paragraph"}]}]}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"seeAlsoSections":[{"generated":true,"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"]}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","title":"Building a Domain Plugin","roleHeading":"Article"},"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/swidux\/buildingadomainplugin"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"role":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","type":"topic","title":"Add a Parental Gate","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"identifier":"doc:\/\/Swidux\/do