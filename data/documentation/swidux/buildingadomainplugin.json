{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","interfaceLanguage":"swift"},"metadata":{"role":"article","title":"Building a Domain Plugin","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"Domain plugins follow a consistent pattern: define feature state and actions, implement the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin"},{"text":" protocol using the ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" hook, and wire the plugin into the host app at registration time. This guide walks through building a plugin from scratch.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The example builds a fictional “Announcements” plugin that fetches a remote message and displays it.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"The-Three-Wiring-Pieces","text":"The Three Wiring Pieces"},{"inlineContent":[{"text":"Every domain plugin stores three closures that bridge its local types to the host app’s root types:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"State keypath"}],"type":"strong"},{"type":"text","text":" — "},{"code":"WritableKeyPath<RootState, FeatureState>","type":"codeVoice"},{"type":"text","text":" locates the plugin’s state slice within root state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action lifter"}]},{"type":"text","text":" — "},{"code":"(FeatureAction) -> RootAction","type":"codeVoice"},{"type":"text","text":" wraps local actions into the root action enum."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action extractor"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"(RootAction) -> FeatureAction?"},{"type":"text","text":" downcasts root actions to the plugin’s local type, returning "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for actions that belong to other features."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"These are closures, not protocols. The host app provides them at init — no associated-type gymnastics or conformance wiring needed."}],"type":"paragraph"},{"level":2,"text":"Step 1: Define Feature State","anchor":"Step-1-Define-Feature-State","type":"heading"},{"code":["public struct AnnouncementState: Sendable, Equatable {","    public var message: String?","    public var isLoading: Bool","    public var error: String?","","    public init(","        message: String? = nil,","        isLoading: Bool = false,","        error: String? = nil","    ) {","        self.message = message","        self.isLoading = isLoading","        self.error = error","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Keep state minimal — only what the UI needs to render and the reducer needs to decide."}],"type":"paragraph"},{"type":"heading","text":"Step 2: Define Feature Actions","anchor":"Step-2-Define-Feature-Actions","level":2},{"syntax":"swift","code":["public enum AnnouncementAction: Sendable {","    case fetch","    case messageReceived(String?)","    case fetchFailed(String)","    case dismiss","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Actions are the plugin’s public API. The host app dispatches them by wrapping in the root action enum."}],"type":"paragraph"},{"level":2,"text":"Step 3: Define the Service","anchor":"Step-3-Define-the-Service","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Inject async dependencies as a struct with closure properties. This makes testing trivial — swap closures instead of subclassing or mocking protocols. (Reach for a protocol instead only when third parties will implement the backend — see the service-shapes principle in ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","type":"reference","isActive":true},{"text":".)","type":"text"}]},{"code":["public struct AnnouncementService: Sendable {","    public var fetch: @Sendable () async throws -> String?","","    public init(fetch: @escaping @Sendable () async throws -> String?) {","        self.fetch = fetch","    }","","    public static func mock(message: String? = \"Test\") -> Self {","        AnnouncementService { message }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Step 4: Implement the Plugin","type":"heading","anchor":"Step-4-Implement-the-Plugin","level":2},{"code":["import Swidux","","@MainActor","public struct AnnouncementPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    private let stateKeyPath: WritableKeyPath<RootState, AnnouncementState>","    private let toRootAction: @Sendable (AnnouncementAction) -> RootAction","    private let extractAction: @Sendable (RootAction) -> AnnouncementAction?","    private let service: AnnouncementService","","    public init(","        state: WritableKeyPath<RootState, AnnouncementState>,","        action toRootAction: @escaping @Sendable (AnnouncementAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> AnnouncementAction?,","        service: AnnouncementService","    ) {","        self.stateKeyPath = state","        self.toRootAction = toRootAction","        self.extractAction = extractAction","        self.service = service","    }","","    public func reduce(","        state: inout RootState,","        action: RootAction","    ) -> Effect<RootAction>? {","        guard let local = extractAction(action) else { return nil }","        let localEffect = reduceLocal(","            state: &state[keyPath: stateKeyPath],","            action: local","        )","        guard let localEffect else { return nil }","        let lift = toRootAction","        return { send in","            await localEffect { localAction in","                send(lift(localAction))","            }","        }","    }","","    private func reduceLocal(","        state: inout AnnouncementState,","        action: AnnouncementAction","    ) -> Effect<AnnouncementAction>? {","        switch action {","        case .fetch:","            state.isLoading = true","            let service = self.service","            return { send in","                do {","                    let message = try await service.fetch()","                    await send(.messageReceived(message))","                } catch {","                    await send(.fetchFailed(error.localizedDescription))","                }","            }","","        case .messageReceived(let message):","            state.message = message","            state.isLoading = false","            state.error = nil","","        case .fetchFailed(let message):","            state.isLoading = false","            state.error = message","","        case .dismiss:","            state.message = nil","        }","        return nil","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The public ","type":"text"},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" method follows a fixed pattern: guard-extract the local action, delegate to a private "},{"code":"reduceLocal","type":"codeVoice"},{"type":"text","text":", and lift any returned effect. The private "},{"code":"reduceLocal","type":"codeVoice"},{"type":"text","text":" is where feature logic lives — it looks like any standard Swidux reducer."}],"type":"paragraph"},{"name":"Important","content":[{"inlineContent":[{"type":"text","text":"Domain plugins implement only "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":". The "},{"code":"willReduce","type":"codeVoice"},{"type":"text","text":" and "},{"code":"afterReduce","type":"codeVoice"},{"type":"text","text":" hooks are reserved for action-agnostic infrastructure like undo and persistence. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":" for the full distinction.","type":"text"}],"type":"paragraph"}],"style":"important","type":"aside"},{"level":2,"type":"heading","anchor":"Step-5-Wire-Into-the-Host-App","text":"Step 5: Wire Into the Host App"},{"level":3,"type":"heading","anchor":"Add-state-and-action","text":"Add state and action"},{"syntax":"swift","code":["@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    \/\/ ...","    var announcements = AnnouncementState()","}","","enum AppAction: Sendable {","    case items(ItemAction)","    \/\/ ...","    case announcements(AnnouncementAction)","}"],"type":"codeListing"},{"level":3,"text":"Register the plugin","anchor":"Register-the-plugin","type":"heading"},{"syntax":"swift","code":["plugins.register(AnnouncementPlugin(","    state: \\.announcements,","    action: AppAction.announcements,","    extractAction: {","        if case .announcements(let a) = $0 { return a }","        return nil","    },","    service: .init { try await api.fetchAnnouncement() }","))"],"type":"codeListing"},{"level":3,"text":"Dispatch from views","anchor":"Dispatch-from-views","type":"heading"},{"syntax":"swift","code":["store.send(.announcements(.fetch))"],"type":"codeListing"},{"level":2,"text":"The Effect Lifting Pattern","anchor":"The-Effect-Lifting-Pattern","type":"heading"},{"inlineContent":[{"type":"text","text":"The lift pattern bridges "},{"code":"Effect<FeatureAction>","type":"codeVoice"},{"type":"text","text":" to "},{"code":"Effect<RootAction>","type":"codeVoice"},{"type":"text","text":". It appears in every domain plugin’s "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" method:"}],"type":"paragraph"},{"syntax":"swift","code":["let lift = toRootAction","return { send in                        \/\/ send: Send<RootAction>","    await localEffect { localAction in  \/\/ localAction: FeatureAction","        send(lift(localAction))         \/\/ lift: (FeatureAction) -> RootAction","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"localEffect","type":"codeVoice"},{"type":"text","text":" expects a "},{"code":"Send<FeatureAction>","type":"codeVoice"},{"type":"text","text":" callback, but "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"type":"text","text":" expects "},{"code":"Effect<RootAction>","type":"codeVoice"},{"type":"text","text":". The lift closure wraps each local action in the root enum before dispatching."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Capture "},{"code":"toRootAction","type":"codeVoice"},{"type":"text","text":" into a local "},{"code":"let","type":"codeVoice"},{"type":"text","text":" before the closure to avoid capturing "},{"code":"self","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Testing Domain Plugins","anchor":"Testing-Domain-Plugins","type":"heading"},{"inlineContent":[{"type":"text","text":"Test plugins without a real app store. Define minimal "},{"code":"TestState","type":"codeVoice"},{"type":"text","text":" and "},{"code":"TestAction","type":"codeVoice"},{"type":"text","text":" types, instantiate the plugin with test wiring, and assert on state mutations and effect presence."}],"type":"paragraph"},{"syntax":"swift","code":["@Suite(\"AnnouncementPlugin\")","@MainActor","struct AnnouncementPluginTests {","    struct TestState: Sendable, Equatable {","        var announcements = AnnouncementState()","    }","","    enum TestAction: Sendable {","        case announcements(AnnouncementAction)","        case unrelated","    }","","    func makePlugin(","        service: AnnouncementService = .mock()","    ) -> AnnouncementPlugin<TestState, TestAction> {","        AnnouncementPlugin(","            state: \\.announcements,","            action: TestAction.announcements,","            extractAction: {","                if case .announcements(let a) = $0 { return a }","                return nil","            },","            service: service","        )","    }","","    @Test(\"ignores unrelated actions\")","    func ignoresUnrelated() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(state: &state, action: .unrelated)","        #expect(effect == nil)","    }","","    @Test(\"messageReceived updates state\")","    func messageReceived() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.messageReceived(\"Hello\"))","        )","        #expect(effect == nil)","        #expect(state.announcements.message == \"Hello\")","        #expect(state.announcements.isLoading == false)","    }","","    @Test(\"fetch returns an effect\")","    func fetchReturnsEffect() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.fetch)","        )","        #expect(effect != nil)","        #expect(state.announcements.isLoading == true)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"code":"TestState","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"TestAction","type":"codeVoice"},{"type":"text","text":" harness is lightweight and reusable. Each plugin’s test suite defines its own pair, keeping tests isolated from the real app’s types."}],"type":"paragraph"},{"level":2,"text":"Next Steps","anchor":"Next-Steps","type":"heading"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"text":" — Understand the lifecycle hooks and core-vs-domain distinction","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","type":"reference","isActive":true},{"text":" — The snapshot pattern and ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" performance","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"sections":[],"variants":[{"paths":["\/documentation\/swidux\/buildingadomainplugin"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides","generated":true,"anchor":"How-to-Guides"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"role":"article","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"title":"Add Persistence","type":"topic","url":"\/documentation\/swidux\/howtoaddpersistence","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence"},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"title":"Design Principles","type":"topic","url":"\/documentation\/swidux\/designprinciples","abstract":[{"type":"text","text":"The 10 rules that shape every Swidux app, and the reasoning behind them."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","role":"article"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"role":"article","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"title":"Cancel Effects","type":"topic","url":"\/documentation\/swidux\/howtocanceleffects","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"type":"topic","title":"Swidux","role":"collection","kind":"symbol","url":"\/documentation\/swidux"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"url":"\/documentation\/swidux\/howtoaddapaywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"topic","title":"Add a Paywall","role":"article","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}]},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"role":"article","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"title":"Add iCloud Sync","type":"topic","url":"\/documentation\/swidux\/howtoaddicloudsync","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"role":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"title":"Add Analytics","type":"topic","url":"\/documentation\/swidux\/howtoaddanalytics","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},"doc://Swidux/documentation/Swidux/AgentSkill":{"role":"article","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"title":"Using the Swidux Agent Skill","type":"topic","url":"\/documentation\/swidux\/agentskill","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"role":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"title":"Add a Parental Gate","type":"topic","url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"title":"Add a Version Killswitch","type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"title":"Architecture & Performance","type":"topic","url":"\/documentation\/swidux\/architectureguide","abstract":[{"type":"text","text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"role":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"title":"Add Feature Flags","type":"topic","url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"title":"Plugin Architecture","type":"topic","url":"\/documentation\/swidux\/pluginarchitecture","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},"doc://Swidux/documentation/Swidux/PluginHost":{"type":"topic","title":"PluginHost","abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PluginHost"}],"role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","url":"\/documentation\/swidux\/pluginhost","navigatorTitle":[{"kind":"identifier","text":"PluginHost"}]},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiduxPlugin"}],"title":"SwiduxPlugin","type":"topic","url":"\/documentation\/swidux\/swiduxplugin","abstract":[{"type":"text","text":"A plugin that participates in the Swidux dispatch cycle."}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"SwiduxPlugin"}]}}}