{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"Swidux"}],"role":"article","title":"Building a Domain Plugin","roleHeading":"Article"},"seeAlsoSections":[{"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"anchor":"How-to-Guides"}],"abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Domain plugins follow a consistent pattern: define feature state and actions, implement the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin"},{"type":"text","text":" protocol using the "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" hook, and wire the plugin into the host app at registration time. This guide walks through building a plugin from scratch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The example builds a fictional “Announcements” plugin that fetches a remote message and displays it."}]},{"anchor":"The-Three-Wiring-Pieces","text":"The Three Wiring Pieces","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every domain plugin stores three closures that bridge its local types to the host app’s root types:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State keypath"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"WritableKeyPath<RootState, FeatureState>"},{"type":"text","text":" locates the plugin’s state slice within root state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action lifter"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"(FeatureAction) -> RootAction"},{"type":"text","text":" wraps local actions into the root action enum."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action extractor"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"(RootAction) -> FeatureAction?"},{"type":"text","text":" downcasts root actions to the plugin’s local type, returning "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for actions that belong to other features."}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"These are closures, not protocols. The host app provides them at init — no associated-type gymnastics or conformance wiring needed."}]},{"anchor":"Step-1-Define-Feature-State","text":"Step 1: Define Feature State","type":"heading","level":2},{"syntax":"swift","type":"codeListing","code":["public struct AnnouncementState: Sendable, Equatable {","    public var message: String?","    public var isLoading: Bool","    public var error: String?","","    public init(","        message: String? = nil,","        isLoading: Bool = false,","        error: String? = nil","    ) {","        self.message = message","        self.isLoading = isLoading","        self.error = error","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep state minimal — only what the UI needs to render and the reducer needs to decide."}]},{"anchor":"Step-2-Define-Feature-Actions","text":"Step 2: Define Feature Actions","type":"heading","level":2},{"syntax":"swift","type":"codeListing","code":["public enum AnnouncementAction: Sendable {","    case fetch","    case messageReceived(String?)","    case fetchFailed(String)","    case dismiss","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Actions are the plugin’s public API. The host app dispatches them by wrapping in the root action enum."}]},{"anchor":"Step-3-Define-the-Service","text":"Step 3: Define the Service","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject async dependencies as a struct with closure properties. This makes testing trivial — swap closures instead of subclassing or mocking protocols. (Reach for a protocol instead only when third parties will implement the backend — see the service-shapes principle in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples"},{"type":"text","text":".)"}]},{"syntax":"swift","type":"codeListing","code":["public struct AnnouncementService: Sendable {","    public var fetch: @Sendable () async throws -> String?","","    public init(fetch: @escaping @Sendable () async throws -> String?) {","        self.fetch = fetch","    }","","    public static func mock(message: String? = \"Test\") -> Self {","        AnnouncementService { message }","    }","}"]},{"anchor":"Step-4-Implement-the-Plugin","text":"Step 4: Implement the Plugin","type":"heading","level":2},{"syntax":"swift","type":"codeListing","code":["import Swidux","","@MainActor","public struct AnnouncementPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    private let stateKeyPath: WritableKeyPath<RootState, AnnouncementState>","    private let toRootAction: @Sendable (AnnouncementAction) -> RootAction","    private let extractAction: @Sendable (RootAction) -> AnnouncementAction?","    private let service: AnnouncementService","","    public init(","        state: WritableKeyPath<RootState, AnnouncementState>,","        action toRootAction: @escaping @Sendable (AnnouncementAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> AnnouncementAction?,","        service: AnnouncementService","    ) {","        self.stateKeyPath = state","        self.toRootAction = toRootAction","        self.extractAction = extractAction","        self.service = service","    }","","    public func reduce(","        state: inout RootState,","        action: RootAction","    ) -> Effect<RootAction>? {","        guard let local = extractAction(action) else { return nil }","        let localEffect = reduceLocal(","            state: &state[keyPath: stateKeyPath],","            action: local","        )","        guard let localEffect else { return nil }","        let lift = toRootAction","        return { send in","            await localEffect { localAction in","                send(lift(localAction))","            }","        }","    }","","    private func reduceLocal(","        state: inout AnnouncementState,","        action: AnnouncementAction","    ) -> Effect<AnnouncementAction>? {","        switch action {","        case .fetch:","            state.isLoading = true","            let service = self.service","            return { send in","                do {","                    let message = try await service.fetch()","                    await send(.messageReceived(message))","                } catch {","                    await send(.fetchFailed(error.localizedDescription))","                }","            }","","        case .messageReceived(let message):","            state.message = message","            state.isLoading = false","            state.error = nil","","        case .fetchFailed(let message):","            state.isLoading = false","            state.error = message","","        case .dismiss:","            state.message = nil","        }","        return nil","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The public "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" method follows a fixed pattern: guard-extract the local action, delegate to a private "},{"type":"codeVoice","code":"reduceLocal"},{"type":"text","text":", and lift any returned effect. The private "},{"type":"codeVoice","code":"reduceLocal"},{"type":"text","text":" is where feature logic lives — it looks like any standard Swidux reducer."}]},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Domain plugins implement only ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":". The ","type":"text"},{"type":"codeVoice","code":"willReduce"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":" hooks are reserved for action-agnostic infrastructure like undo and persistence. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":" for the full distinction.","type":"text"}]}]},{"anchor":"Step-5-Wire-Into-the-Host-App","text":"Step 5: Wire Into the Host App","type":"heading","level":2},{"anchor":"Add-state-and-action","text":"Add state and action","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    \/\/ ...","    var announcements = AnnouncementState()","}","","enum AppAction: Sendable {","    case items(ItemAction)","    \/\/ ...","    case announcements(AnnouncementAction)","}"]},{"anchor":"Register-the-plugin","text":"Register the plugin","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["plugins.register(AnnouncementPlugin(","    state: \\.announcements,","    action: AppAction.announcements,","    extractAction: {","        if case .announcements(let a) = $0 { return a }","        return nil","    },","    service: .init { try await api.fetchAnnouncement() }","))"]},{"anchor":"Dispatch-from-views","text":"Dispatch from views","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["store.send(.announcements(.fetch))"]},{"anchor":"The-Effect-Lifting-Pattern","text":"The Effect Lifting Pattern","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The lift pattern bridges "},{"type":"codeVoice","code":"Effect<FeatureAction>"},{"type":"text","text":" to "},{"type":"codeVoice","code":"Effect<RootAction>"},{"type":"text","text":". It appears in every domain plugin’s "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" method:"}]},{"syntax":"swift","type":"codeListing","code":["let lift = toRootAction","return { send in                        \/\/ send: Send<RootAction>","    await localEffect { localAction in  \/\/ localAction: FeatureAction","        send(lift(localAction))         \/\/ lift: (FeatureAction) -> RootAction","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"localEffect"},{"type":"text","text":" expects a "},{"type":"codeVoice","code":"Send<FeatureAction>"},{"type":"text","text":" callback, but "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"type":"text","text":" expects "},{"type":"codeVoice","code":"Effect<RootAction>"},{"type":"text","text":". The lift closure wraps each local action in the root enum before dispatching."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Capture "},{"type":"codeVoice","code":"toRootAction"},{"type":"text","text":" into a local "},{"type":"codeVoice","code":"let"},{"type":"text","text":" before the closure to avoid capturing "},{"type":"codeVoice","code":"self"},{"type":"text","text":"."}]},{"anchor":"Testing-Domain-Plugins","text":"Testing Domain Plugins","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Test plugins without a real app store. Define minimal "},{"type":"codeVoice","code":"TestState"},{"type":"text","text":" and "},{"type":"codeVoice","code":"TestAction"},{"type":"text","text":" types, instantiate the plugin with test wiring, and assert on state mutations and effect presence."}]},{"syntax":"swift","type":"codeListing","code":["@Suite(\"AnnouncementPlugin\")","@MainActor","struct AnnouncementPluginTests {","    struct TestState: Sendable, Equatable {","        var announcements = AnnouncementState()","    }","","    enum TestAction: Sendable {","        case announcements(AnnouncementAction)","        case unrelated","    }","","    func makePlugin(","        service: AnnouncementService = .mock()","    ) -> AnnouncementPlugin<TestState, TestAction> {","        AnnouncementPlugin(","            state: \\.announcements,","            action: TestAction.announcements,","            extractAction: {","                if case .announcements(let a) = $0 { return a }","                return nil","            },","            service: service","        )","    }","","    @Test(\"ignores unrelated actions\")","    func ignoresUnrelated() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(state: &state, action: .unrelated)","        #expect(effect == nil)","    }","","    @Test(\"messageReceived updates state\")","    func messageReceived() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.messageReceived(\"Hello\"))","        )","        #expect(effect == nil)","        #expect(state.announcements.message == \"Hello\")","        #expect(state.announcements.isLoading == false)","    }","","    @Test(\"fetch returns an effect\")","    func fetchReturnsEffect() {","        let plugin = makePlugin()","        var state = TestState()","        let effect = plugin.reduce(","            state: &state,","            action: .announcements(.fetch)","        )","        #expect(effect != nil)","        #expect(state.announcements.isLoading == true)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"TestState"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"TestAction"},{"type":"text","text":" harness is lightweight and reusable. Each plugin’s test suite defines its own pair, keeping tests isolated from the real app’s types."}]},{"anchor":"Next-Steps","text":"Next Steps","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":" — Understand the lifecycle hooks and core-vs-domain distinction"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","isActive":true},{"type":"text","text":" — The snapshot pattern and "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" performance"}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/buildingadomainplugin"]}],"kind":"article","references":{"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"title":"Add Feature Flags","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"url":"\/documentation\/swidux\/pluginarchitecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","kind":"article","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"role":"article","type":"topic","title":"Plugin Architecture"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","url":"\/documentation\/swidux\/howtoaddicloudsync","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"title":"Add iCloud Sync","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"role":"article","title":"Add Persistence","kind":"article","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","url":"\/documentation\/swidux\/howtoaddpersistence","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"role":"article","title":"Add a Paywall","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic"},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","url":"\/documentation\/swidux\/designprinciples","abstract":[{"type":"text","text":"The 10 rules that shape every Swidux app, and the reasoning behind them."}],"title":"Design Principles","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","url":"\/documentation\/swidux\/architectureguide","abstract":[{"type":"text","text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system."}],"title":"Architecture & Performance","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","role":"collection","type":"topic","kind":"symbol"},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"title":"Using the Swidux Agent Skill","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"title":"Add a Version Killswitch","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","url":"\/documentation\/swidux\/howtocanceleffects","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"title":"Cancel Effects","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","url":"\/documentation\/swidux\/swiduxplugin","navigatorTitle":[{"kind":"identifier","text":"SwiduxPlugin"}],"abstract":[{"type":"text","text":"A plugin that participates in the Swidux dispatch cycle."}],"title":"SwiduxPlugin","role":"symbol","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiduxPlugin"}]},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"title":"Add a Parental Gate","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/PluginHost":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","url":"\/documentation\/swidux\/pluginhost","navigatorTitle":[{"kind":"identifier","text":"PluginHost"}],"abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}],"title":"PluginHost","role":"symbol","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PluginHost"}]},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","url":"\/documentation\/swidux\/howtoaddanalytics","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"title":"Add Analytics","role":"article","type":"topic","kind":"article"}}}