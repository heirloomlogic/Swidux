\/swidux\/howtoaddanalytics","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"url":"\/documentation\/swidux\/howtoaddpersistence","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"role":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","kind":"article","title":"Add Persistence"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"abstract":[{"text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","type":"topic","url":"\/documentation\/swidux\/architectureguide","title":"Architecture & Performance","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux":{"abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux","url":"\/documentation\/swidux","type":"topic","kind":"symbol","role":"collection"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"kind":"article","type":"topic","title":"Add a Version Killswitch","abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux