{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"KeyValueStore"},{"text":" backed by the system Keychain.","type":"text"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeychainKeyValueStore"}],"languages":["swift"]}]},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Values are JSON-encoded as "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" and stored as "},{"type":"codeVoice","code":"kSecClassGenericPassword"},{"type":"text","text":" "},{"type":"text","text":"items keyed by "},{"type":"codeVoice","code":"(service, account)"},{"type":"text","text":" where "},{"type":"codeVoice","code":"service"},{"type":"text","text":" is supplied at init"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"account"},{"type":"text","text":" is "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey\/name"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The primary use case is anonymous device identity that should survive app"},{"type":"text","text":" "},{"type":"text","text":"reinstall — a UUID that lets analytics correlate sessions for an app that"},{"type":"text","text":" "},{"type":"text","text":"has no user account system. Hydrate once at launch into "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"feed "},{"type":"codeVoice","code":"AnalyticsIdentity(userID: \\.deviceID, …)"},{"type":"text","text":", and never read the"},{"type":"text","text":" "},{"type":"text","text":"Keychain again at steady state."}]},{"type":"codeListing","code":["extension KVKey where Value == String {","    static let deviceID = KVKey<String>(\"device-id\")","}","","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.value(.deviceID) ?? {","    let new = UUID().uuidString","    kv.setValue(new, for: .deviceID)","    return new","}()"],"syntax":"swift"},{"level":2,"type":"heading","text":"Accessibility","anchor":"Accessibility"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore\/Accessibility\/afterFirstUnlockThisDeviceOnly"},{"type":"text","text":" is tuned for"},{"type":"text","text":" "},{"type":"text","text":"device-bound identifiers: items stay accessible in the background after"},{"type":"text","text":" "},{"type":"text","text":"first unlock but are excluded from iCloud Keychain sync and device-to-device"},{"type":"text","text":" "},{"type":"text","text":"migration. Choose a stricter level ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore\/Accessibility\/whenUnlockedThisDeviceOnly"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore\/Accessibility\/whenPasscodeSetThisDeviceOnly"},{"type":"text","text":") for sensitive material;"},{"type":"text","text":" "},{"type":"text","text":"the protocol’s "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" surface is fine for short opaque tokens but not"},{"type":"text","text":" "},{"type":"text","text":"designed for secrets that require Face ID \/ Touch ID gating."}]},{"level":2,"type":"heading","text":"Sandboxing & entitlements (macOS)","anchor":"Sandboxing--entitlements-macOS"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This store uses the data-protection keychain"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"kSecUseDataProtectionKeychain"},{"type":"text","text":"), so it "},{"type":"strong","inlineContent":[{"type":"text","text":"never"}]},{"type":"text","text":" triggers a user-facing"},{"type":"text","text":" "},{"type":"text","text":"prompt: no legacy “Always Allow \/ Deny” dialog, no prompt on a locked"},{"type":"text","text":" "},{"type":"text","text":"keychain, and — because no "},{"type":"codeVoice","code":"kSecAttrAccessControl"},{"type":"text","text":" is requested — no"},{"type":"text","text":" "},{"type":"text","text":"Touch ID \/ Face ID \/ password challenge."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"sandboxed"}]},{"type":"text","text":" macOS app must still be entitled to use that keychain. It"},{"type":"text","text":" "},{"type":"text","text":"needs either an "},{"type":"codeVoice","code":"application-identifier"},{"type":"text","text":" entitlement (Xcode adds this"},{"type":"text","text":" "},{"type":"text","text":"automatically for provisioning-profile–signed builds) or an explicit"},{"type":"text","text":" "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entry. Without one, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore\/setValue(_:for:)"},{"type":"text","text":" fails"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"type":"text","text":" ("},{"type":"codeVoice","code":"OSStatus"},{"type":"text","text":" −34018). This is a"},{"type":"text","text":" "},{"type":"text","text":"build\/signing condition surfaced at runtime, "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" a user prompt:"}]},{"type":"codeListing","code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"],"syntax":"xml"},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS \/ iPadOS \/ tvOS \/ watchOS only have the data-protection keychain and"},{"type":"text","text":" "},{"type":"text","text":"supply the access group implicitly — no extra entitlement is required."}]},{"level":3,"type":"heading","text":"Which entitlement, for privacy","anchor":"Which-entitlement-for-privacy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Encryption, this-device-only accessibility, iCloud-sync exclusion, and"},{"type":"text","text":" "},{"type":"text","text":"backup exclusion are identical whichever path you take — the access group"},{"type":"text","text":" "},{"type":"text","text":"only governs "},{"type":"emphasis","inlineContent":[{"type":"text","text":"which of your own apps"}]},{"type":"text","text":" can read an item, never third"},{"type":"text","text":" "},{"type":"text","text":"parties or the cloud. For app-private identifiers, in order of strictness:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Most private:"}],"type":"strong"},{"type":"text","text":" a provisioning-profile–signed build with"},{"type":"text","text":" "},{"type":"codeVoice","code":"accessGroup: nil"},{"type":"text","text":", relying on the implicit "},{"type":"codeVoice","code":"application-identifier"},{"type":"text","text":" "},{"type":"text","text":"group ("},{"type":"codeVoice","code":"<TeamPrefix>.<bundle-id>"},{"type":"text","text":"). No other app — even one you sign"},{"type":"text","text":" "},{"type":"text","text":"under the same team — can ever be entitled to it. Mirrors the iOS"},{"type":"text","text":" "},{"type":"text","text":"default exactly; zero sharing surface."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Practically equivalent:"}],"type":"strong"},{"type":"text","text":" a "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" array whose"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"only"}],"type":"emphasis"},{"type":"text","text":" entry is the team-prefixed bundle id (the snippet above). Use"},{"type":"text","text":" "},{"type":"text","text":"this when a profile-signed build isn’t available (unsigned local \/ CI"},{"type":"text","text":" "},{"type":"text","text":"dev, where −34018 bites). The one delta from (1): another app you sign"},{"type":"text","text":" "},{"type":"text","text":"under the same team could also declare that string and read the items."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Intentional sharing only:"}],"type":"strong"},{"type":"text","text":" a deliberately shared group string. The"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"first"}],"type":"emphasis"},{"type":"text","text":" element of "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" becomes the default group"},{"type":"text","text":" "},{"type":"text","text":"for new items, so never put a shared group first for private data."}]}]}]},{"level":2,"type":"heading","text":"Sendable","anchor":"Sendable"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Marked "},{"type":"codeVoice","code":"@unchecked Sendable"},{"type":"text","text":". The "},{"type":"codeVoice","code":"Security"},{"type":"text","text":" framework’s "},{"type":"codeVoice","code":"SecItem*"},{"type":"text","text":" calls"},{"type":"text","text":" "},{"type":"text","text":"are thread-safe; the struct’s stored properties are all themselves"},{"type":"text","text":" "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" or treated so. Matches the pattern of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore"},{"type":"text","text":"."}]}],"kind":"content"}],"metadata":{"title":"KeychainKeyValueStore","fragments":[{"kind":"keyword","text":"str