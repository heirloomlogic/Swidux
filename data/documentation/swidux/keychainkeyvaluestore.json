,"text":" "},{"type":"text","text":"Keychain again at steady state."}]},{"code":["extension KVKey where Value == String {","    static let deviceID = KVKey<String>(\"device-id\")","}","","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.value(.deviceID) ?? {","    let new = UUID().uuidString","    kv.setValue(new, for: .deviceID)","    return new","}()"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"anchor":"Accessibility","text":"Accessibility"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore\/Accessibility\/afterFirstUnlockThisDeviceOnly","isActive":true},{"type":"text","text":" is tuned for"},{"type":"text","text":" "},{"type":"text","text":"device-bound identifiers: items stay accessible in the background after"},{"type":"text","text":" "},{"type":"text","text":"first unlock but are excluded from iCloud Keychain sync and device-to-device"},{"type":"text","text":" "},{"type":"text","text":"migration. Choose a stricter level ("},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore\/Accessibility\/whenUnlockedThisDeviceOnly","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore\/Accessibility\/whenPasscodeSetThisDeviceOnly","isActive":true},{"type":"text","text":") for sensitive material;"},{"type":"text","text":" "},{"type":"text","text":"the protocol’s "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" surface is fine for short opaque tokens but not"},{"type":"text","text":" "},{"type":"text","text":"designed for secrets that require Face ID \/ Touch ID gating."}]},{"type":"heading","level":2,"anchor":"Sandboxing--entitlements-macOS","text":"Sandboxing & entitlements (macOS)"},{"type":"paragraph","inlineContent":[{"type":"t