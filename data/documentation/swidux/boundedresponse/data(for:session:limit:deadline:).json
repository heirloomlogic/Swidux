"inlineContent":[{"text":"A non-2xx status throws ","type":"text"},{"code":"URLError.badServerResponse","type":"codeVoice"},{"text":", with the status","type":"text"},{"text":" ","type":"text"},{"text":"in its description, ","type":"text"},{"inlineContent":[{"text":"before the body is read at all","type":"text"}],"type":"strong"},{"text":" — an error","type":"text"},{"text":" ","type":"text"},{"text":"page is not a config, however well it decodes.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A declared ","type":"text"},{"code":"Content-Length","type":"codeVoice"},{"text":" above the cap throws","type":"text"},{"text":" ","type":"text"},{"code":"URLError.dataLengthExceedsMaximum","type":"codeVoice"},{"text":" immediately, without transferring","type":"text"},{"text":" ","type":"text"},{"text":"the body.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Otherwise bytes accumulate and the transfer is abandoned as soon as","type":"text"},{"text":" ","type":"text"},{"text":"the count exceeds ","type":"text"},{"code":"limit","type":"codeVoice"},{"text":", so the process never holds more than the","type":"text"},{"text":" ","type":"text"},{"text":"cap plus one chunk.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The deadline covers the whole exchange, headers and body together.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"URLRequest.timeoutInterval"},{"text":" can’t do that job: it is an ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"idle","type":"text"}]},{"text":" timeout,","type":"text"},{"text":" ","type":"text"},{"text":"reset by every packet, so a response that trickles in a byte at a time","type":"text"},{"text":" ","type":"text"},{"text":"never trips it, and ","type":"text"},{"type":"codeVoice","code":"URLSession.shared"},{"text":" allows a transfer seven days.","type":"text"},{"text":" ","type":"text"},{"text":"When the deadline passes, the t