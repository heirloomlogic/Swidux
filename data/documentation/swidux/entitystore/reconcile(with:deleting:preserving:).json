{"sections":[],"abstract":[{"type":"text","text":"Reconciles this store against a snapshot covering only "},{"inlineContent":[{"text":"some","type":"text"}],"type":"emphasis"},{"type":"text","text":" of its IDs."}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"]]},"kind":"symbol","metadata":{"symbolKind":"method","externalID":"s:6Swidux11EntityStoreV9reconcile4with8deleting10preservingyACyxG_Shy10Foundation4UUIDVGALtF","modules":[{"name":"Swidux"}],"roleHeading":"Instance Method","title":"reconcile(with:deleting:preserving:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reconcile"},{"kind":"text","text":"("},{"kind":"externalParam","text":"with"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Swidux11EntityStoreV","kind":"typeIdentifier","text":"EntityStore"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"deleting"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:10Foundation4UUIDV","kind":"typeIdentifier","text":"UUID"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"preserving"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:10Foundation4UUIDV","kind":"typeIdentifier","text":"UUID"},{"kind":"text","text":">)"}],"role":"symbol"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"mutating","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reconcile","kind":"identifier"},{"text":"(","kind":"text"},{"text":"with","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"remote","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"EntityStore","preciseIdentifier":"s:6Swidux11EntityStoreV","kind":"typeIdentifier","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":"<","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"deleting","kind":"externalParam"},{"kind":"text","text":" "},{"text":"deletedIDs","kind":"internalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:10Foundation4UUIDV","text":"UUID","kind":"typeIdentifier"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"preserving"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:10Foundation4UUIDV","text":"UUID","kind":"typeIdentifier"},{"kind":"text","text":">)"}]}],"kind":"declarations"},{"parameters":[{"name":"remote","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The rows read from storage for the IDs in question. Rows for"},{"type":"text","text":" "},{"type":"text","text":"IDs the caller didn’t ask about are simply not here, and their"},{"type":"text","text":" "},{"type":"text","text":"absence means nothing."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"IDs storage reports as deleted elsewhere. Removed with"},{"type":"text","text":" "},{"type":"text","text":"the same origin a full reconcile uses, so no deletion is recorded and"},{"type":"text","text":" "},{"type":"text","text":"none is echoed back to the store it came from. An ID that "},{"code":"remote","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"still holds is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" removed however it is named here: a live row"},{"type":"text","text":" "},{"type":"text","text":"is positive evidence, and a tombstone can be stale."}],"type":"paragraph"}],"name":"deletedIDs"},{"content":[{"inlineContent":[{"text":"IDs the caller knows carry unflushed local intent, exactly","type":"text"},{"text":" ","type":"text"},{"text":"as in the full reconcile. ","type":"text"},{"type":"codeVoice","code":"remote"},{"text":" has no authority over them, and","type":"text"},{"type":"text","text":" "},{"text":"neither does ","type":"text"},{"type":"codeVoice","code":"deletedIDs"},{"text":". This store’s own un-drained ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/changes","isActive":true},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"folded in automatically."}],"type":"paragraph"}],"name":"preserving"}],"kind":"parameters"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The counterpart to "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/reconcile(with:preserving:removingMissing:)","isActive":true},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"partial read — a refresh of the rows a sync tick reported as changed,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"rather than of the whole table. Absorbing rows works identically; what"},{"type":"text","text":" "},{"text":"changes is where deletions come from.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A partial snapshot ","type":"text"},{"type":"strong","inlineContent":[{"text":"cannot","type":"text"}]},{"text":" infer deletion from absence. An ID missing","type":"text"},{"text":" ","type":"text"},{"text":"from it was not deleted, it was not asked for, and treating the two alike","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"would empty the store on the first partial merge. So removal is driven"},{"type":"text","text":" "},{"type":"text","text":"entirely by "},{"code":"deletedIDs","type":"codeVoice"},{"type":"text","text":", which the caller must have positive evidence"},{"type":"text","text":" "},{"type":"text","text":"for — a history tombstone, not an empty result."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"text":" record changes — this is a hydration operation, for the same","type":"text"},{"text":" ","type":"text"},{"text":"reason the full reconcile isn’t one.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/entitystore\/reconcile(with:deleting:preserving:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/reconcile(with:deleting:preserving:)"},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://Swidux/documentation/Swidux/EntityStore/reconcile(with:deleting:preserving:)":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/reconcile(with:deleting:preserving:)","abstract":[{"type":"text","text":"Reconciles this store against a snapshot covering only "},{"inlineContent":[{"type":"text","text":"some"}],"type":"emphasis"},{"type":"text","text":" of its IDs."}],"role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reconcile"},{"kind":"text","text":"("},{"kind":"externalParam","text":"with"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Swidux11EntityStoreV","text":"EntityStore"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"deleting"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4UUIDV","text":"UUID"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"preserving"},{"kind"