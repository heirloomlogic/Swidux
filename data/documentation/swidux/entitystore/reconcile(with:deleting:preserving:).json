xt":"is positive evidence, and a tombstone can be stale.","type":"text"}],"type":"paragraph"}],"name":"deletedIDs"},{"content":[{"inlineContent":[{"text":"IDs the caller knows carry unflushed local intent, exactly","type":"text"},{"text":" ","type":"text"},{"text":"as in the full reconcile. ","type":"text"},{"code":"remote","type":"codeVoice"},{"text":" has no authority over them, and","type":"text"},{"text":" ","type":"text"},{"text":"neither does ","type":"text"},{"code":"deletedIDs","type":"codeVoice"},{"text":". This store’s own un-drained ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/changes"},{"text":" are","type":"text"},{"text":" ","type":"text"},{"text":"folded in automatically.","type":"text"}],"type":"paragraph"}],"name":"preserving"}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"The counterpart to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/reconcile(with:preserving:removingMissing:)","type":"reference"},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"partial read — a refresh of the rows a sync tick reported as changed,","type":"text"},{"text":" ","type":"text"},{"text":"rather than of the whole table. Absorbing rows works identically; what","type":"text"},{"text":" ","type":"text"},{"text":"changes is where deletions come from.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A partial snapshot ","type":"text"},{"inlineContent":[{"text":"cannot","type":"text"}],"type":"strong"},{"text":" infer deletion from absence. An ID missing","type":"text"},{"text":" ","type":"text"},{"text":"from it was not deleted, it was not asked for, and treating the two alike","type":"text"},{"text":" ","type":"text"},{"text":"would empty the store on the first partial merge. So removal is driven","type":"text"},{"text":" ","type":"text"},{"text":"entirely by ","type":"text"},{"code":"deletedIDs","type":"codeVoice"},{"text":", which the caller must have positive evidence","type":"text"},{"text":" ","type":"text"},{"text":"for — a history tombstone, not an empty result.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" record changes — this is a hydration operation, for the same","type":"text"},{"text":" ","type":"text"},{"text":"reason the full reconcile isn’t one.","type":"text"}]}]}],"abstract":[{"text":"Reconciles this store against a snapshot covering only ","type":"text"},{"inlineContent":[{"text":"some","type":"text"}],"type":"emphasis"},{"text":" of its IDs.","type":"text"}],"sections":[],"kind":"symbol","references":{"doc://Swidux/documentation/Swidux/EntityStore/reconcile(with:deleting:preserving:)":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/reconcile(with:deleting:preserving:)","kind":"symbol","abstract":[{"type":"text","text":"Reconciles this store against a snapshot covering only "},{"inlineContent":[{"type":"text","text":"some"}],"type":"emphasis"},{"type":"text","text":" of its IDs."}],"title":"reconcile(with:deleting:preserving:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reconcile","kind":"identifier"},{"text":"(","kind":"text"},{"text":"with","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Swidux11EntityStoreV","text":"EntityStore","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"deleting","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:10Foundation4UUIDV","text":"UUID","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"preserving","kind":"externa