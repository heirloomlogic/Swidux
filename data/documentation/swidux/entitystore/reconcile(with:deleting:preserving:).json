{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/entitystore\/reconcile(with:deleting:preserving:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"mutating","kind":"keyword"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"reconcile","kind":"identifier"},{"kind":"text","text":"("},{"text":"with","kind":"externalParam"},{"kind":"text","text":" "},{"text":"remote","kind":"internalParam"},{"kind":"text","text":": "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","kind":"typeIdentifier","text":"EntityStore","preciseIdentifier":"s:6Swidux11EntityStoreV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Entity"},{"text":">, ","kind":"text"},{"text":"deleting","kind":"externalParam"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"deletedIDs"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV"},{"text":">, ","kind":"text"},{"kind":"externalParam","text":"preserving"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV","kind":"typeIdentifier"},{"kind":"text","text":">)"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"remote","content":[{"inlineContent":[{"text":"The rows read from storage for the IDs in question. Rows for","type":"text"},{"type":"text","text":" "},{"text":"IDs the caller didn’t ask about are simply not here, and their","type":"text"},{"type":"text","text":" "},{"text":"absence means nothing.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"IDs storage reports as deleted elsewhere. Removed with","type":"text"},{"text":" ","type":"text"},{"text":"the same origin a full reconcile uses, so no deletion is recorded and","type":"text"},{"text":" ","type":"text"},{"text":"none is echoed back to the store it came from. An ID that ","type":"text"},{"type":"codeVoice","code":"remote"},{"text":" ","type":"text"},{"text":"still holds is ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" removed however it is named here: a live row"},{"type":"text","text":" "},{"type":"text","text":"is positive evidence, and a tombstone can be stale."}],"type":"paragraph"}],"name":"deletedIDs"},{"content":[{"inlineContent":[{"type":"text","text":"IDs the caller knows carry unflushed local intent, exactly"},{"type":"text","text":" "},{"type":"text","text":"as in the full reconcile. "},{"code":"remote","type":"codeVoice"},{"type":"text","text":" has no authority over them, and"},{"type":"text","text":" "},{"type":"text","text":"neither does "},{"code":"deletedIDs","type":"codeVoice"},{"type":"text","text":". This store’s own un-drained "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/changes","isActive":true},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"folded in automatically."}],"type":"paragraph"}],"name":"preserving"}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The counterpart to "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/reconcile(with:preserving:removingMissing:)","isActive":true},{"type":"text","text":" for a"},{"type":"text","text":" "},{"type":"text","text":"partial read — a refresh of the rows a sync tick reported as changed,"},{"type":"text","text":" "},{"type":"text","text":"rather than of the whole table. Absorbing rows works identically; what"},{"type":"text","text":" "},{"type":"text","text":"changes is where deletions come from."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A partial snapshot "},{"inlineContent":[{"type":"text","text":"cannot"}],"type":"strong"},{"type":"text","text":" infer deletion from absence. An ID missing"},{"type":"text","text":" "},{"type":"text","text":"from it was not deleted, it was not asked for, and treating the two alike"},{"type":"text","text":" "},{"type":"text","text":"would empty the store on the first partial merge. So removal is driven"},{"type":"text","text":" "},{"type":"text","text":"entirely by "},{"code":"deletedIDs","type":"codeVoice"},{"type":"text","text":", which the caller must have positive evidence"},{"type":"text","text":" "},{"type":"text","text":"for — a history tombstone, not an empty result."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Does "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" record changes — this is a hydration operation, for the same"},{"type":"text","text":" "},{"type":"text","text":"reason the full reconcile isn’t one."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/reconcile(with:deleting:preserving:)"},"metadata":{"externalID":"s:6Swidux11EntityStoreV9reconcile4with8deleting10preservingyACyxG_Shy10Foundation4UUIDVGALtF","modules":[{"name":"Swidux"}],"roleHeading":"Instance Method","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"reconcile"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"with"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"EntityStore","preciseIdentifier":"s:6Swidux11EntityStoreV"},{"kind":"text","text":"<"},{"text":"Entity","kind":"typeIdentifier"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"deleting"},{"kind":"text","text":": "},{"kind":"