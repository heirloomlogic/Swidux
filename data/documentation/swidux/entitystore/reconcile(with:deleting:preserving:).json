{"abstract":[{"type":"text","text":"Reconciles this store against a snapshot covering only "},{"inlineContent":[{"text":"some","type":"text"}],"type":"emphasis"},{"type":"text","text":" of its IDs."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reconcile"},{"kind":"text","text":"("},{"kind":"externalParam","text":"with"},{"kind":"text","text":" "},{"kind":"internalParam","text":"remote"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Swidux11EntityStoreV","kind":"typeIdentifier","text":"EntityStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"deleting"},{"kind":"text","text":" "},{"kind":"internalParam","text":"deletedIDs"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"preserving"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV"},{"kind":"text","text":">)"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The rows read from storage for the IDs in question. Rows for"},{"type":"text","text":" "},{"type":"text","text":"IDs the caller didn’t ask about are simply not here, and their"},{"type":"text","text":" "},{"type":"text","text":"absence means nothing."}]}],"name":"remote"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"IDs storage reports as deleted elsewhere. Removed with"},{"type":"text","text":" "},{"type":"text","text":"the same origin a full reconcile uses, so no deletion is recorded and"},{"type":"text","text":" "},{"type":"text","text":"none is echoed back to the store it came from. An ID that "},{"code":"remote","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"still holds is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" removed however it is named here: a live row"},{"type":"text","text":" "},{"type":"text","text":"is positive evidence, and a tombstone can be stale."}]}],"name":"deletedIDs"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"IDs the caller knows carry unflushed local intent, exactly"},{"type":"text","text":" "},{"type":"text","text":"as in the full reconcile. "},{"code":"remote","type":"codeVoice"},{"type":"text","text":" has no authority over them, and"},{"type":"text","text":" "},{"type":"text","text":"neither does "},{"code":"deletedIDs","type":"codeVoice"},{"type":"text","text":". This store’s own un-drained "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/changes","isActive":true,"type":"reference"},{"type":"text","text":" are"},{"type":"text","text":" "},{"type":"text","text":"folded in automatically."}]}],"name":"preserving"}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"The counterpart to ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/reconcile(with:preserving:removingMissing:)","type":"reference","isActive":true},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"partial read — a refresh of the rows a sync tick reported as changed,","type":"text"},{"text":" ","type":"text"},{"text":"rather than of the whole table. Absorbing rows works identically; what","type":"text"},{"text":" ","type":"text"},{"text":"changes is where deletions come from.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A partial snapshot ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"cannot"}]},{"text":" infer deletion from absence. An ID missing","type":"text"},{"text":" ","type":"text"},{"text":"from it was not deleted, it was not asked for, and treating the two alike","type":"text"},{"text":" ","type":"text"},{"text":"would empty the store on the first partial merge. So removal is driven","type":"text"},{"text":" ","type":"text"},{"text":"entirely by ","type":"text"},{"type":"codeVoice","code":"deletedIDs"},{"text":", which the caller must have positive evidence","type":"text"},{"text":" ","type":"text"},{"text":"for — a history tombstone, not an empty result.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Does ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"text":" record changes — this is a hydration operation, for the same","type":"text"},{"text":" ","type":"text"},{"text":"reason the full reconcile isn’t one.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/swidux\/entitystore\/reconcile(with:deleting:preserving:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/reconcile(with:deleting:preserving:)","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"role":"symbol","modules":[{"name":"Swidux"}],"symbolKind":"method","title":"reconcile(with:deleting:preserving:)","roleHeading":"Instance Method","externalID":"s:6Swidux11EntityStoreV9reconcile4with8deleting10preservingyACyxG_Shy10Foundation4UUIDVGALtF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reconcile"},{"kind":"text","text":"("},{"kind":"externalParam","text":"with"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EntityStore","preciseIdent