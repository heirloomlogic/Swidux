,{"type":"text","text":"neither does "},{"type":"codeVoice","code":"deletedIDs"},{"type":"text","text":". This store’s own un-drained "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/changes"},{"text":" are","type":"text"},{"type":"text","text":" "},{"type":"text","text":"folded in automatically."}],"type":"paragraph"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The counterpart to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/reconcile(with:preserving:removingMissing:)","type":"reference"},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"partial read — a refresh of the rows a sync tick reported as changed,","type":"text"},{"text":" ","type":"text"},{"text":"rather than of the whole table. Absorbing rows works identically; what","type":"text"},{"text":" ","type":"text"},{"text":"changes is where deletions come from.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A partial snapshot ","type":"text"},{"inlineContent":[{"text":"cannot","type":"text"}],"type":"strong"},{"text":" infer deletion from absence. An ID missing","type":"text"},{"text":" ","type":"text"},{"text":"from it was not deleted, it was not asked for, and treating the two alike","type":"text"},{"text":" ","type":"text"},{"text":"would empty the store on the first partial merge. So removal is driven","type":"text"},{"text":" ","type":"text"},{"text":"entirely by ","type":"text"},{"code":"deletedIDs","type":"codeVoice"},{"text":", which the caller must have positive evidence","type":"text"},{"text":" ","type":"text"},{"text":"for — a history tombstone, not an empty result.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" record changes — this is a hy