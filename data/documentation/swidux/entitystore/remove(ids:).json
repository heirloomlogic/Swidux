{"abstract":[{"type":"text","text":"Removes the entities with the given IDs in a single pass."}],"variants":[{"paths":["\/documentation\/swidux\/entitystore\/remove(ids:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"remove"},{"kind":"text","text":"("},{"kind":"externalParam","text":"ids"},{"kind":"text","text":": "},{"kind":"keyword","text":"some"},{"kind":"text","text":" "},{"kind":"typeIdentifier","preciseIdentifier":"s:ST","text":"Sequence"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4UUIDV","text":"UUID"},{"kind":"text","text":">)"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each ID actually present records a deletion and cancels any pending"},{"type":"text","text":" "},{"type":"text","text":"upsert, exactly like "},{"type":"codeVoice","code":"store[id] = nil"},{"type":"text","text":". Unknown IDs (and duplicates)"},{"type":"text","text":" "},{"type":"text","text":"are ignored and record nothing. Survivor order is preserved."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefer this over a subscript loop for bulk deletion: each"},{"type":"text","text":" "},{"type":"codeVoice","code":"store[id] = nil"},{"type":"text","text":" shifts the array tail and reindexes (O(tail)), so"},{"type":"text","text":" "},{"type":"text","text":"k subscript deletes cost O(n·k); this removes everything in one pass"},{"type":"text","text":" "},{"type":"text","text":"with one index rebuild."}]}]}],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"remove"},{"kind":"text","text"