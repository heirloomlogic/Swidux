{"abstract":[{"type":"text","text":"Reconciles this store against an authoritative snapshot from storage."}],"variants":[{"paths":["\/documentation\/swidux\/entitystore\/reconcile(with:preserving:removingmissing:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"mutating"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reconcile"},{"kind":"text","text":"("},{"kind":"externalParam","text":"with"},{"kind":"text","text":" "},{"kind":"internalParam","text":"remote"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Swidux11EntityStoreV","kind":"typeIdentifier","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","text":"EntityStore"},{"text":"<","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"kind":"externalParam","text":"preserving"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"removingMissing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"name":"remote","content":[{"inlineContent":[{"type":"text","text":"The rows read from storage."}],"type":"paragraph"}]},{"name":"preserving","content":[{"inlineContent":[{"type":"text","text":"IDs the caller knows carry unflushed local intent — a"},{"type":"text","text":" "},{"type":"text","text":"drained-but-unflushed write, a write whose save failed, or a pending"},{"type":"text","text":" "},{"type":"text","text":"deletion. "},{"type":"codeVoice","code":"remote"},{"type":"text","text":" has no authority over them: they are neither"},{"type":"text","text":" "