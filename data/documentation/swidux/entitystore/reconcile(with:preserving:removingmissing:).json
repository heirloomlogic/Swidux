":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", IDs held here that are absent from"},{"type":"text","text":" "},{"type":"codeVoice","code":"remote"},{"type":"text","text":" and not preserved are removed — a deletion made on another"},{"type":"text","text":" "},{"type":"text","text":"device. When "},{"type":"codeVoice","code":"false"},{"type":"text","text":" the reconcile is additive: remote edits still"},{"type":"text","text":" "},{"type":"text","text":"land, but nothing is ever removed."}],"type":"paragraph"}],"name":"removingMissing"}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/merge(from:shouldReplace:)"},{"type":"text","text":" means "},{"inlineContent":[{"type":"text","text":"keep everything and absorb"},{"type":"text","text":" "},{"type":"text","text":"what’s new"}],"type":"emphasis"},{"type":"text","text":", this means "},{"inlineContent":[{"type":"text","text":"storage is authoritative except where you say"},{"type":"text","text":" "},{"type":"text","text":"otherwise"}],"type":"emphasis"},{"type":"text","text":" — which is what lets a remote edit or a remote deletion"},{"type":"text","text":" "},{"type":"text","text":"surface mid-session instead of waiting for the next launch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Does "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" record changes — this is a hydration operation, and every"},{"type":"text","text":" "},{"type":"text","text":"value it writes or removes already reflects what is in storage."},{"type":"text","text":" "},{"type":"text","text":"Recording them would echo each remote change straight back as a local"},{"type":"text","text":" "},{"type":"text","text":"write."}]}],"kind":"content"}],"schemaVersion":{"min