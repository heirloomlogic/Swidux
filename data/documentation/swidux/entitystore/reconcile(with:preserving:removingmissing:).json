:" — which is what lets a remote edit or a remote deletion","type":"text"},{"text":" ","type":"text"},{"text":"surface mid-session instead of waiting for the next launch.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" record changes — this is a hydration operation, and every","type":"text"},{"text":" ","type":"text"},{"text":"value it writes or removes already reflects what is in storage.","type":"text"},{"text":" ","type":"text"},{"text":"Recording them would echo each remote change straight back as a local","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swidux\/entitystore\/reconcile(with:preserving:removingmissing:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"symbol","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"reconcile"},{"kind":"text","text":"("},{"kind":"externalParam","text":"with"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EntityStore","preciseIdentifier":"s:6Swidux11EntityStoreV"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"preserving"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"removingMissing"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}],"title":"reconcile(with:preserving:removingMissing:)","modules":[{"name":"Swidux"}],"roleHeading":"Instance Method","externalID":"s:6Swidux11EntityStoreV9reconcile4with10preserving15removingMissingyACyxG_Sh