":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Does "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" record changes — this is a hydration operation, and every","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"value it writes or removes already reflects what is in storage."},{"text":" ","type":"text"},{"text":"Recording them would echo each remote change straight back as a local","type":"text"},{"text":" ","type":"text"},{"text":"write.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/reconcile(with:preserving:removingMissing:)","interfaceLanguage":"swift"},"metadata":{"symbolKind":"method","modules":[{"name":"Swidux"}],"role":"symbol","externalID":"s:6Swidux11EntityStoreV9reconcile4with10preserving15removingMissingyACyxG_Shy10Foundation4UUIDVGSbtF","roleHeading":"Instance Method","title":"reconcile(with:preserving:removingMissing:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"reconcile","kind":"identifier"},{"text":"(","kind":"text"},{"text":"with","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Swidux11EntityStoreV","text":"EntityStore","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"preserving","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:10Foundation4UUIDV","text":"UUID","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"removingMissing","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":")","kind":"text"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"]]},"kind":"symbol","schemaVersion":{"min