":"text"},{"text":"with","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"remote","kind":"internalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Swidux11EntityStoreV","text":"EntityStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"preserving"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:10Foundation4UUIDV","text":"UUID","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"removingMissing","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"kind":"text","text":")"}]}],"kind":"declarations"},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The rows read from storage."}]}],"name":"remote"},{"name":"preserving","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"IDs the caller knows carry unflushed local intent — a"},{"type":"text","text":" "},{"type":"text","text":"drained-but-unflushed write, a write whose save failed, or a pending"},{"type":"text","text":" "},{"type":"text","text":"deletion. "},{"type":"codeVoice","code":"remote"},{"type":"text","text":" has no authority over them: they are neither"},{"type":"text","text":" "},{"type":"text","text":"overwritten, nor inserted, nor removed. This store’s own un-drained"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/changes","isActive":true},{"type":"text","text":" are folded in automatically, so a pending local deletion"},{"type":"text","text":" "},{"type":"text","text":"is never resurrected even when "},{"type":"codeVoice","code":"preserving"},{"type":"text","text":" is empty."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"true"},{"type":"text","text":", IDs held here that are absent from"},{"type":"text","text":" "},{"type":"codeVoice","code":"remote"},{"type":"text","text":" and not preserved are removed — a deletion made on another"},{"type":"text","text":" "},{"type":"text","text":"device. When "},{"code":"false","type":"codeVoice"},{"type":"text","text":" the reconcile is additive: remote edits still"},{"type":"text","text":" "},{"type":"text","text":"land, but nothing is ever removed."}]}],"name":"removingMissing"}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Where "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/merge(from:shouldReplace:)"},{"type":"text","text":" means "},{"type":"emphasis","inlineContent":[{"text":"keep everything and absorb","type":"text"},{"text":" ","type":"text"},{"text":"what’s new","type":"text"}]},{"type":"text","text":", this means "},{"type":"emphasis","inlineContent":[{"text":"storage is authoritative except where you say","type":"text"},{"text":" ","type":"text"},{"text":"otherwise","type":"text"}]},{"type":"text","text":" — which is what lets a remote edit or a remote deletion"},{"type":"text","text":" "},{"type":"text","text":"surface mid-session instead of waiting for the next launch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" record changes — this is a hydration operation, and every"},{"type":"text","text":" "},{"type":"text","text":"value it writes or removes already reflects what is in storage."},{"type":"text","text":" "},{"type":"text","text":"Recording them would echo each remote change straight back as a local"},{"type":"text","text":" "},{"type":"text","text":"write."}]}],"kind":"