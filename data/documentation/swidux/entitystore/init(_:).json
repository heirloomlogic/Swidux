{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"initialEntities"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":"])"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" record changes — the data is already persisted."}],"type":"paragraph"},{"name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"This is ","type":"text"},{"inlineContent":[{"type":"text","text":"first-load"}],"type":"strong"},{"text":" hydration only. Do not use this initializer","type":"text"},{"text":" ","type":"text"},{"text":"to “refresh from disk” mid-session by assigning into a live ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(e.g. ","type":"text"},{"code":"state.items = EntityStore(fetched)","type":"codeVoice"},{"text":" from a CloudKit re-hydrate action).","type":"text"},{"text":" ","type":"text"},{"text":"In-memory state may hold unflushed writes or live UI bindings; wholesale","type":"text"},{"text":" ","type":"text"},{"text":"replacement silently drops them and surfaces as lost keystrokes. Use","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/merge(from:shouldReplace:)","isActive":true,"type":"reference"},{"text":" for that path — it records no changes and","type":"text"},{"text":" ","type":"text"},{"text":"lets you decide per-ID which side wins. Under ","type":"text"},{"code":"NSPersistentCloudKitContainer","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the gotcha is especially sharp: ","type":"text"},{"code":".NSPersistentStoreRemoteChange","type":"codeVoice"},{"text":" fires for","type":"text"},{"text":" ","type":"text"},{"text":"local saves too, so a naïve “refresh on remote change” observer feeds the","type":"text"},{"text":" ","type":"text"},{"text":"app its own writes.","type":"text"}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"Entities sharing an ID are collapsed to the first occurrence. A store"},{"type":"text","text":" "},{"type":"text","text":"cannot represent duplicates — "},{"code":"positions","type":"codeVoice"},{"type":"text","text":" holds one index per ID — and"},{"type":"text","text":" "},{"type":"text","text":"admitting them corrupts the index: the map would keep only the last"},{"type":"text","text":" "},{"type":"text","text":"index while the array kept every copy, so "},{"code":"count","type":"codeVoice"},{"type":"text","text":" over-reports and a"},{"type":"text","text":" "},{"type":"text","text":"later delete orphans the earlier copy with no "},{"code":"positions","type":"codeVoice"},{"type":"text","text":" entry at all,"},{"type":"text","text":" "},{"type":"text","text":"leaving a row that is visible in "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/values","type":"reference"},{"type":"text","text":" but invisible to"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/contains(_:)","type":"reference"},{"type":"text","text":" and the subscript. Persisted rows can legitimately"},{"type":"text","text":" "},{"type":"text","text":"share an ID (CloudKit forbids unique constraints), so this initializer"},{"type":"text","text":" "},{"type":"text","text":"has to be total rather than trusting its input."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swidux\/entitystore\/init(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstrac