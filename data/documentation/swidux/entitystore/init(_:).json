{"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"initialEntities"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":"])"}],"platforms":["macOS"]}]},{"content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Does "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" record changes — the data is already persisted."}]},{"content":[{"inlineContent":[{"type":"text","text":"This is "},{"type":"strong","inlineContent":[{"text":"first-load","type":"text"}]},{"type":"text","text":" hydration only. Do not use this initializer"},{"type":"text","text":" "},{"type":"text","text":"to “refresh from disk” mid-session by assigning into a live "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"type":"codeVoice","code":"state.items = EntityStore(fetched)"},{"type":"text","text":" from a CloudKit re-hydrate action)."},{"type":"text","text":" "},{"type":"text","text":"In-memory state may hold unflushed writes or live UI bindings; wholesale"},{"type":"text","text":" "},{"type":"text","text":"replacement silently drops them and surfaces as lost keystrokes. Use"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/merge(from:shouldReplace:)","isActive":true},{"type":"text","text":" for that path — it records no changes and"},{"type":"text","text":" "},{"type":"text","text":"lets you decide per-ID which side wins. Under "},{"type":"codeVoice","code":"NSPersistentCloudKitContainer"},{"type":"text","text":" "},{"type":"text","text":"the gotcha is especially sharp: "},{"type":"codeVoice","code":".NSPersistentStoreRemoteChange"},{"type":"text","text":" fires for"},{"type":"text","text":" "},{"type":"text","text":"local saves too, so a naïve “refresh on remote change” observer feeds the"},{"type":"text","text":" "},{"type":"text","text":"app its own writes."}],"type":"paragraph"}],"type":"aside","style":"important","name":"Important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Entities sharing an ID are collapsed to the first occurrence. A store"},{"type":"text","text":" "},{"type":"text","text":"cannot represent duplicates — "},{"type":"codeVoice","code":"positions"},{"type":"text","text":" holds one index per ID — and"},{"type":"text","text":" "},{"type":"text","text":"admitting them corrupts the index: the map would keep only the last"},{"type":"text","text":" "},{"type":"text","text":"index while the array kept every copy, so "},{"type":"codeVoice","code":"count"},{"type":"text","text":" over-reports and a"},{"type":"text","text":" "},{"type":"text","text":"later delete orphans the earlier copy with no "},{"type":"codeVoice","code":"positions"},{"type":"text","text":" entry at all,"},{"type":"text","text":" "},{"type":"text","text":"leaving a row that is visible in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/values"},{"type":"text","text":" but invisible to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/contains(_:)"},{"type":"text","text":" and the subscript. Persisted rows can legitimately"},{"type":"text","text":" "},{"type":"text","text":"share an ID (CloudKit forbids unique constraints), so this initializer"},{"type":"text","text":" "},{"type":"text","text":"has to be total rather than trusting its input."}]}],"kind":"content"}],"metadata":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":"])"}],"external