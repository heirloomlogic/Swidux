Store","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityStore"}],"navigatorTitle":[{"kind":"identifier","text":"EntityStore"}],"url":"\/documentation\/swidux\/entitystore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},"doc://Swidux/documentation/Swidux":{"title":"Swidux","kind":"symbol","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"role":"collection","url":"\/documentation\/swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","type":"topic"},"doc://Swidux/documentation/Swidux/EntityStore/merge(from:shouldReplace:)":{"kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"merge","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Swidux11EntityStoreV","text":"EntityStore","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"shouldReplace","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"Merges entities from another store. Entities only present in "},{"type":"codeVoice","code":"other"},{"type":"text","text":" "},{"type":"text","text":"are always added; for IDs present in both, "},{"type":"codeVoice","code":"shouldReplace"},{"type":"text","text":" decides"},{"type":"text","text":" "},{"type":"text","text":"whether the incoming value overwrites the one already in "},{"type":"codeVoice","code":"self"},{"type":"text","text":"."}],"title":"merge(from:shouldReplace:)","type":"topic","url":"\/documentation\/swidux\/entitystore\/merge(from:shouldreplace:)","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/merge(from:shouldReplace:)"},"doc://Swidux/documentation/Swidux/EntityStore/values":{"kind":"symbol","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"values","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"All entities in insertion order."}],"title":"values","type":"topic","url":"\/documentation\/swidux\/entitystore\/values","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/values"}}}