{"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Creates a store pre-populated from an array (e.g. first-load hydration at app launch).","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"initialEntities"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":"])"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"inlineContent":[{"text":"Does ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" record changes — the data is already persisted.","type":"text"}],"type":"paragraph"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"This is ","type":"text"},{"type":"strong","inlineContent":[{"text":"first-load","type":"text"}]},{"text":" hydration only. Do not use this initializer","type":"text"},{"text":" ","type":"text"},{"text":"to “refresh from disk” mid-session by assigning into a live ","type":"text"},{"type":"codeVoice","code":"EntityStore"},{"text":" ","type":"text"},{"text":"(e.g. ","type":"text"},{"type":"codeVoice","code":"state.items = EntityStore(fetched)"},{"text":" from a CloudKit re-hydrate action).","type":"text"},{"text":" ","type":"text"},{"text":"In-memory state may hold unflushed writes or live UI bindings; wholesale","type":"text"},{"text":" ","type":"text"},{"text":"replacement silently drops them and surfaces as lost keystrokes. Use","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/merge(from:shouldReplace:)","isActive":true},{"text":" for that path — it records no changes and","type":"text"},{"text":" ","type":"text"},{"text":"lets you decide per-ID which side wins. Under ","type":"text"},{"type":"codeVoice","code":"NSPersistentCloudKitContainer"},{"text":" ","type":"text"},{"text":"the gotcha is especially sharp: ","type":"text"},{"type":"codeVoice","code":".NSPersistentStoreRemoteChange"},{"text":" fires for","type":"text"},{"text":" ","type":"text"},{"text":"local saves too, so a naïve “refresh on remote change” observer feeds the","type":"text"},{"text":" ","type":"text"},{"text":"app its own writes.","type":"text"}]}],"type":"aside","style":"important"},{"inlineContent":[{"text":"Entities sharing an ID are collapsed to the first occurrence. A store","type":"text"},{"text":" ","type":"text"},{"text":"cannot represent duplicates — ","type":"text"},{"type":"codeVoice","code":"positions"},{"text":" holds one index per ID — and","type":"text"},{"text":" ","type":"text"},{"text":"admitting them corrupts the index: the map would keep only the last","type":"text"},{"text":" ","type":"text"},{"text":"index while the array kept every copy, so ","type":"text"},{"type":"codeVoice","code":"count"},{"text":" over-reports and a","type":"text"},{"text":" ","type":"text"},{"text":"later delete orphans the earlier copy with no ","type":"text"},{"type":"codeVoice","code":"positions"},{"text":" entry at all,","type":"text"},{"text":" ","type":"text"},{"text":"leaving a row that is visible in ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/values","type":"reference","isActive":true},{"text":" but invisible to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/contains(_:)","type":"reference","isActive":true},{"text":" and the subscript. Persisted rows can legitimately","type":"text"},{"text":" ","type":"text"},{"text":"share an ID (CloudKit forbids unique constraints), so this initializer","type":"text"},{"text":" ","type":"text"},{"text":"has to be total rather than trusting its input.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":