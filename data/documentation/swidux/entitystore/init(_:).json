":" ","type":"text"},{"text":"In-memory state may hold unflushed writes or live UI bindings; wholesale","type":"text"},{"text":" ","type":"text"},{"text":"replacement silently drops them and surfaces as lost keystrokes. Use","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/merge(from:shouldReplace:)","isActive":true,"type":"reference"},{"text":" for that path — it records no changes and","type":"text"},{"text":" ","type":"text"},{"text":"lets you decide per-ID which side wins. Under ","type":"text"},{"code":"NSPersistentCloudKitContainer","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the gotcha is especially sharp: ","type":"text"},{"code":".NSPersistentStoreRemoteChange","type":"codeVoice"},{"text":" fires for","type":"text"},{"text":" ","type":"text"},{"text":"local saves too, so a naïve “refresh on remote change” observer feeds the","type":"text"},{"text":" ","type":"text"},{"text":"app its own writes.","type":"text"}],"type":"paragraph"}]},{"inlineContent":[{"type":"text","text":"Entities sharing an ID are collapsed to the first occurrence. A store"},{"type":"text","text":" "},{"type":"text","text":"cannot represent duplicates — "},{"code":"positions","type":"codeVoice"},{"type":"text","text":" holds one index per ID — and"},{"type":"text","text":" "},{"type":"text","text":"admitting them corrupts the index: the map would keep only the last"},{"type":"text","text":" "},{"type":"text","text":"index while the array kept every copy, so "},{"code":"count","type":"codeVoice"},{"type":"text","text":" over-reports and a"},{"type":"text","text":" "},{"type":"text","text":"later delete orphans the earlier copy with no "},{"code":"positions","type":"codeVoice"},{"type":"text","text":" entry at all,"},{"type":"text","text":" "},{"type":"text","text":"leaving a row that is visible in "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/values","isActive":true,"type":"reference"},{"type":"text","text":" but invisible to"},{"type":"text","text":" "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/contains(_:)","isActive":true,"type":"reference"},{"type":"text","text":" and the subscript. Persisted rows can legitimately"},{"type":"text","text":" "},{"type":"text","text":"share an ID (CloudKit forbids unique constraints), so this initializer"},{"type":"text","text":" "},{"type":"text","text":"has to be total rather than trusting its input."}],"type":"paragraph"}]}],"kind":"symbol","schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Creates a store pre-populated from an array (e.g. first-load hydration at app launch).","type":"text"}],"references":{"doc://Swidux/documentation/Swidux/EntityStore/values":{"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"values","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"abstract":[{"type":"text","text":"All entities in insertion order."}],"type":"topic","title":"values","role":"symbol","url":"\/documentation\/swidux\/entitystore\/values","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/values"},"doc://Swidux/documentation/Swidux":{"title":"Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection"},"doc://Swidux/documentation/Swidux/EntityStore/merge(from:shouldReplace:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"merge","kind":"identifier"},{"text":"(","kind":"text"},{"text":"from","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"EntityStore","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux11EntityStor