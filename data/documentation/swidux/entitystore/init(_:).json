{"sections":[],"metadata":{"externalID":"s:6Swidux11EntityStoreVyACyxGSayxGcfc","symbolKind":"init","title":"init(_:)","roleHeading":"Initializer","role":"symbol","modules":[{"name":"Swidux"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":"])"}]},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/init(_:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"initialEntities","kind":"internalParam"},{"text":": [","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"text":"Does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" record changes — the data is already persisted.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"This is ","type":"text"},{"type":"strong","inlineContent":[{"text":"first-load","type":"text"}]},{"text":" hydration only. Do not use this initializer","type":"text"},{"type":"text","text":" "},{"text":"to “refresh from disk” mid-session by assigning into a live ","type":"text"},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"type":"codeVoice","code":"state.items = EntityStore(fetched)"},{"text":" from a CloudKit re-hydrate action).","type":"text"},{"text":" ","type":"text"},{"text":"In-memory state may hold unflushed writes or live UI bindings; wholesale","type":"text"},{"type":"text","text":" "},{"text":"replacement silently drops them and surfaces as lost keystrokes. Use","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/merge(from:shouldReplace:)"},{"type":"text","text":" for that path — it records no changes and"},{"text":" ","type":"text"},{"type":"text","text":"lets you decide per-ID which side wins. Under "},{"type":"codeVoice","code":"NSPersistentCloudKitContainer"},{"type":"text","text":" "},{"text":"the gotcha is especially sharp: ","type":"text"},{"type":"codeVoice","code":".NSPersistentStoreRemoteChange"},{"text":" fires for","type":"text"},{"text":" ","type":"text"},{"text":"local saves too, so a naïve “refresh on remote change” observer feeds the","type":"text"},{"text":" ","type":"text"},{"text":"app its own writes.","type":"text"}],"type":"paragraph"}],"style":"important","name":"Important","type":"aside"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Entities sharing an ID are collapsed to the first occurrence. A store"},{"text":" ","type":"text"},{"type":"text","text":"cannot represent duplicates — "},{"type":"codeVoice","code":"positions"},{"text":" holds one index per ID — and","type":"text"},{"text":" ","type":"text"},{"text":"admitting them corrupts the index: the map would keep only the last","type":"text"},{"type":"text","text":" "},{"type":"text","text":"index while the array kept every copy, so "},{"code":"count","type":"codeVoice"},{"text":" over-reports and a","type":"text"},{"text":" ","type":"text"},{"text":"later delete orphans the earlier copy with no ","type":"text"},{"code":"positions","type":"codeVoice"},{"text":" entry at all,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"leaving a row that is visible in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/values"},{"text":" but invisible to","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/contains(_:)","isActive":true},{"text":" and the subscript. Persisted rows can legitimately","type":"text"},{"text":" ","type":"text"},{"text":"share an ID (CloudKit forbids unique constraints), so this initializer","type":"text"},{"text":" ","type":"text"},{"text":"has to be total rather than trusting its input.","type":"text"}]}]}],"abstract":[{"type":"text","text":"Creates a store pre-populated from an array (e.g. first-load hydration at app launch)."}],"variants":[{"paths":["\/documentation\/swidux\/entitystore\/init(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Swidux/documentation/Swidux":{"kind":"symbol","type":"topic","url":"\/documentation\/swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux"},"doc://Swidux/documentation/Swidux/EntityStore/merge(from:shouldReplace:)":{"kind":"symbol","type":"topic","url":"\/documentation\/swidux\/entitystore\/merge(from:shouldreplace:)","abstract":[{"type":"text","text":"Merges entities from another store. Entities only present in "},{"type":"codeVoice","code":"other"},{"type":"text","text":" "},{"type":"text","text":"are always added; for IDs present in both, "},{"type":"codeVoice","code":"shouldReplace"},{"type":"text","text":" decides"},{"type":"text","text":" "},{"type":"text","text":"whether the incoming value overwrites the one already in "},{"type":"codeVoice","code":"self"},{"text":".","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"merge"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"preciseIdent