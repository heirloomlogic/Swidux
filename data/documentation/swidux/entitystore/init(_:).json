{"sections":[],"variants":[{"paths":["\/documentation\/swidux\/entitystore\/init(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"role":"symbol","roleHeading":"Initializer","externalID":"s:6Swidux11EntityStoreVyACyxGSayxGcfc","symbolKind":"init","fragments":[{"text":"init","kind":"identifier"},{"text":"([","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"modules":[{"name":"Swidux"}],"title":"init(_:)"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"initialEntities","kind":"internalParam"},{"text":": [","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":"])","kind":"text"}]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" record changes — the data is already persisted.","type":"text"}],"type":"paragraph"},{"name":"Important","content":[{"inlineContent":[{"type":"text","text":"This is "},{"type":"strong","inlineContent":[{"text":"first-load","type":"text"}]},{"type":"text","text":" hydration only. Do not use this initializer"},{"type":"text","text":" "},{"type":"text","text":"to “refresh from disk” mid-session by assigning into a live "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"type":"codeVoice","code":"state.items = EntityStore(fetched)"},{"type":"text","text":" from a CloudKit re-hydrate action)."},{"type":"text","text":" "},{"type":"text","text":"In-memory state may hold unflushed writes or live UI bindings; wholesale"},{"type":"text","text":" "},{"type":"text","text":"replacement silently drops them and surfaces as lost keystrokes. Use"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/merge(from:shouldReplace:)","isActive":true},{"type":"text","text":" for that path — it records no changes and"},{"type":"text","text":" "},{"type":"text","text":"lets you decide per-ID which side wins. Under "},{"type":"codeVoice","code":"NSPersistentCloudKitContainer"},{"type":"text","text":" "},{"type":"text","text":"the gotcha is especially sharp: "},{"type":"codeVoice","code":".NSPersistentStoreRemoteChange"},{"type":"text","text":" fires for"},{"type":"text","text":" "},{"type":"text","text":"local saves too, so a naïve “refresh on remote change” observer feeds the"},{"type":"text","text":" "},{"type":"text","text":"app its own writes."}],"type":"paragraph"}],"style":"important","type":"aside"},{"inlineContent":[{"text":"Entities sharing an ID are collapsed to the first occurrence. A store","type":"text"},{"text":" ","type":"text"},{"text":"cannot represent duplicates — ","type":"text"},{"code":"positions","type":"codeVoice"},{"text":" holds one index per ID — and","type":"text"},{"text":" ","type":"text"},{"text":"admitting them corrupts the index: the map would keep only the last","type":"text"},{"text":" ","type":"text"},{"text":"index while the array kept every copy, so ","type":"text"},{"code":"count","type":"codeVoice"},{"text":" over-reports and a","type":"text"},{"text":" ","type":"text"},{"text":"later delete orphans the earlier copy with no ","type":"text"},{"code":"positions","type":"codeVoice"},{"text":" entry at all,","type":"text"},{"text":" ","type":"text"},{"text":"leaving a row that is visible in ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/values","isActive":true,"type":"reference"},{"text":" but invisible to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/contains(_:)","isActive":true,"type":"reference"},{"text":" and the subscript. Persisted rows can legitimately","type":"text"},{"text":" ","type":"text"},{"text":"share an ID (CloudKit forbids unique constraints), so this initializer","type":"text"},{"text":" ","type":"text"},{"text":"has to be total rather than trusting its input.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/init(_:)","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"]]},"abstract":[{"text":"Creates a store pre-populated from an array (e.g. first-load hydration at app launch).","type":"text"}],"references":{"doc://Swidux/documentation/Swidux/EntityStore/init(_:)":{"url":"\/documentation\/swidux\/entitystore\/init(_:)","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"([","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"title":"init(_:)","kind":"symbol","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/init(_:)","abstract":[{"text":"Creates a store pre-populated from an array (e.g. first-load hydration at app launch).","type":"text"}]},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","role":"collection","title":"Swidux","kind":"symbol","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}]},"doc://Swidux/documentation/Swidux/EntityStore/contains(_:)":{"url":"\/documentation\/swidux\/entitystore\/contains(_:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contains","kind":"identifier"},{"text":"(","kind":"text"},{"preciseIdentifier":"s:10Foundation4UUIDV","text":"UUID","kind":"typeIdentifier"},{"text"