{"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"initialEntities","kind":"internalParam"},{"text":": [","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" record changes — the data is already persisted.","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":"This is "},{"inlineContent":[{"type":"text","text":"first-load"}],"type":"strong"},{"type":"text","text":" hydration only. Do not use this initializer"},{"type":"text","text":" "},{"type":"text","text":"to “refresh from disk” mid-session by assigning into a live "},{"code":"EntityStore","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"code":"state.items = EntityStore(fetched)","type":"codeVoice"},{"type":"text","text":" from a CloudKit re-hydrate action)."},{"type":"text","text":" "},{"type":"text","text":"In-memory state may hold unflushed writes or live UI bindings; wholesale"},{"type":"text","text":" "},{"type":"text","text":"replacement silently drops them and surfaces as lost keystrokes. Use"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/merge(from:shouldReplace:)","isActive":true},{"type":"text","text":" for that path — it records no changes and"},{"type":"text","text":" "},{"type":"text","text":"lets you decide per-ID which side wins. Under "},{"code":"NSPersistentCloudKitContainer","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"the gotcha is especially sharp: "},{"code":".NSPersistentStoreRemoteChange","type":"codeVoice"},{"type":"text","text":" fires for"},{"type":"text","text":" "},{"type":"text","text":"local saves too, so a naïve “refresh on remote change” observer feeds the"},{"type":"text","text":" "},{"type":"text","text":"app its own writes."}],"type":"paragraph"}],"type":"aside","style":"important","name":"Important"},{"type":"paragraph","inlineContent":[{"text":"Entities sharing an ID are collapsed to the first occurrence. A store","type":"text"},{"text":" ","type":"text"},{"text":"cannot represent duplicates — ","type":"text"},{"code":"positions","type":"codeVoice"},{"text":" holds one index per ID — and","type":"text"},{"text":" ","type":"text"},{"text":"admitting them corrupts the index: the map would keep only the last","type":"text"},{"text":" ","type":"text"},{"text":"index while the array kept every copy, so ","type":"text"},{"code":"count","type":"codeVoice"},{"text":" over-reports and a","type":"text"},{"text":" ","type":"text"},{"text":"later delete orphans the earlier copy with no ","type":"text"},{"code":"positions","type":"codeVoice"},{"text":" entry at all,","type":"text"},{"text":" ","type":"text"},{"text":"leaving a row that is visible in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/values"},{"text":" but invisible to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/contains(_:)"},{"text":" and the subscript. Persisted rows can legitimately","type":"text"},{"text":" ","type":"text"},{"text":"share an ID (CloudKit forbids unique constraints), so this initializer","type":"text"},{"text":" ","type":"text"},{"text":"has to be total rather than trusting its input.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/init(_:)"},"metadata":{"fragments":[{"text":"init","kind":"identifier"},{"text":"([","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"symbolKind":"init","roleHeading":"Initializer","modules":[{"name":"Swidux"}],"title":"init(_:)","externalID":"s:6Swidux11EntityStoreVyACyxGSayxGcfc","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"]]},"abstract":[{"type":"text","text":"Creates a store pre-populated from an array (e.g. first-load hydration at app launch)."}],"variants":[{"paths":["\/documentation\/swidux\/entitystore\/init(_:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"type":"topic","title":"Swidux","role":"collection","kind":"symbol","url":"\/documentation\/swidux"},"doc://Swidux/documentation/Swidux/EntityStore/contains(_:)":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/contains(_:)","abstract":[{"text":"Whether an entity with this ID exists.","type":"text"}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contains","kind":"identifier"},{"text":"(","kind":"text"},{"text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"contains(_:)","role":"symbol","kind":"symbol","url":"\/documentation\/swidux\/entitystore\/contains(_:)"},"doc://Swidux/documentation/Swidux/EntityStore/init(_:)":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/init(_:)","url":"\/documentation\/swidux\/entitystore\/init(_:)","type":"topic","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":"])"}],"title":"init(_:)","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Creates a store pre-populated from an array (e.g. first-load hydration at app launch)."}]},"doc://Swidux/documentation/Swidux/EntityStore/values":{"fragments":[{"kind":"keyword","text":"var"},{"text":" ","kind":"text"},{"text":"values","kind":"identifier"},{"text":": [","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"values","type":"topic","url":"\/documentation\/swidux\/entitystore\/values","abstract":[{"text":"All entities in insertion order.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/values","role":"symbol"},"doc://Swidux/documentation/Swidux/EntityStore/merge(from:shouldReplace:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"merge"},{"kind":"text","text":"("},{"kind":"externalParam","text":"from"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"EntityStore","preciseIdentifier":"s:6Swidux11EntityStoreV"},{"kind":"text","text":"<"},{"text":"Entity","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"shouldReplace","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":")"}],"title":"merge(from:shouldReplace:)","url":"\/documentation\/swidux\/entitystore\/merge(from:shouldreplace:)","type":"topic","abstract":[{"type":"text","text":"Merges entities from another store. Entities only present in "},{"code":"other","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"are always added; for IDs present in both, "},{"type":"codeVoice","code":"shouldReplace"},{"type":"text","text":" decides"},{"type":"text","text":" "},{"type":"text","text":"whether the incoming value overwrites the one already in "},{"code":"self","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/merge(from:shouldReplace:)","role":"symbol"},"doc://Swidux/documentation/Swidux/EntityStore":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}],"title":"EntityStore","navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"role":"symbol","kind":"symbol","url":"\/documentation\/swidux\/entitystore"}}}