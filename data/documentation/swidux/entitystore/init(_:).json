{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"]]},"abstract":[{"type":"text","text":"Creates a store pre-populated from an array (e.g. first-load hydration at app launch)."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/entitystore\/init(_:)"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"init","kind":"keyword"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"initialEntities","kind":"internalParam"},{"text":": [","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":"])","kind":"text"}]}]},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" record changes — the data is already persisted."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"This is ","type":"text"},{"inlineContent":[{"text":"first-load","type":"text"}],"type":"strong"},{"text":" hydration only. Do not use this initializer","type":"text"},{"text":" ","type":"text"},{"text":"to “refresh from disk” mid-session by assigning into a live ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(e.g. ","type":"text"},{"code":"state.items = EntityStore(fetched)","type":"codeVoice"},{"text":" from a CloudKit re-hydrate action).","type":"text"},{"text":" ","type":"text"},{"text":"In-memory state may hold unflushed writes or live UI bindings; wholesale","type":"text"},{"text":" ","type":"text"},{"text":"replacement silently drops them and surfaces as lost keystrokes. Use","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/merge(from:shouldReplace:)","isActive":true},{"text":" for that path — it records no changes and","type":"text"},{"text":" ","type":"text"},{"text":"lets you decide per-ID which side wins. Under ","type":"text"},{"code":"NSPersistentCloudKitContainer","type":"codeVoice"},{"text":" ","type":"text"},{"text":"the gotcha is especially sharp: ","type":"text"},{"code":".NSPersistentStoreRemoteChange","type":"codeVoice"},{"text":" fires for","type":"text"},{"text":" ","type":"text"},{"text":"local saves too, so a naïve “refresh on remote change” observer feeds the","type":"text"},{"text":" ","type":"text"},{"text":"app its own writes.","type":"text"}]}],"style":"important","name":"Important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Entities sharing an ID are collapsed to the first occurrence. A store"},{"type":"text","text":" "},{"type":"text","text":"cannot represent duplicates — "},{"type":"codeVoice","code":"positions"},{"type":"text","text":" holds one index per ID — and"},{"type":"text","text":" "},{"type":"text","text":"admitting them corrupts the index: the map would keep only the last"},{"type":"text","text":" "},{"type":"text","text":"index while the array kept every copy, so "},{"type":"codeVoice","code":"count"},{"type":"text","text":" over-reports and a"},{"type":"text","text":" "},{"type":"text","text":"later delete orphans the earlier copy with no "},{"type":"codeVoice","code":"positions"},{"type":"text","text":" entry at all,"},{"type":"text","text":" "},{"type":"text","text":"leaving a row that is visible in "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/values","isActive":true},{"type":"text","text":" but invisible to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/contains(_:)","isActive":true},{"type":"text","text":" and the subscript. Persisted rows can legitimately"},{"type":"text","text":" "},{"type":"text","text":"share an ID (CloudKit forbids unique constraints), so this initializer"},{"type":"text","text":" "},{"type":"text","text":"has to be total rather than trusting its input."}]}],"kind":"content"}],"metadata":{"fragments":[{"text":"init","kind":"identifier"},{"text":"([","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"modules":[{"name":"Swidux"}],"roleHeading":"Initializer","symbolKind":"init","title":"init(_:)","role":"symbol","externalID":"s:6Swidux11EntityStoreVyACyxGSayxGcfc"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/init(_:)"},"references":{"doc://Swidux/documentation/Swidux":{"abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","url":"\/documentation\/swidux","title":"Swidux","type":"topic","kind":"symbol"},"doc://Swidux/documentation/Swidux/EntityStore/contains(_:)":{"role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/contains(_:)","abstract":[{"text":"Whether an entity with this ID exists.","type":"text"}],"kind":"symbol","url":"\/documentation\/swidux\/entitystore\/contains(_:)","type":"topic","title":"contains(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"contains"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}]},"doc://Swidux/documentation/Swidux/EntityStore/init(_:)":{"role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"([","kind":"text"},{"text":"Entity","kind":"typeIdentifier"},{"text":"])","kind":"text"}],"ur