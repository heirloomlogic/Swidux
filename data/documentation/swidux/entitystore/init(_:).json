{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"initialEntities"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":"])"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Does "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" record changes — the data is already persisted."}],"type":"paragraph"},{"name":"Important","style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This is "},{"type":"strong","inlineContent":[{"type":"text","text":"first-load"}]},{"type":"text","text":" hydration only. Do not use this initializer"},{"type":"text","text":" "},{"type":"text","text":"to “refresh from disk” mid-session by assigning into a live "},{"code":"EntityStore","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(e.g. "},{"code":"state.items = EntityStore(fetched)","type":"codeVoice"},{"type":"text","text":" from a CloudKit re-hydrate action)."},{"type":"text","text":" "},{"type":"text","text":"In-memory state may hold unflushed writes or live UI bindings; wholesale"},{"type":"text","text":" "},{"type":"text","text":"replacement silently drops them and surfaces as lost keystrokes. Use"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/merge(from:shouldReplace:)","type":"reference"},{"type":"text","text":" for that path — it records no changes and"},{"type":"text","text":" "},{"type":"text","text":"lets you decide per-ID which side wins. Under "},{"code":"NSPersistentCloudKitContainer","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"the gotcha is especially sharp: "},{"code":".NSPersistentStoreRemoteChange","type":"codeVoice"},{"type":"text","text":" fires for"},{"type":"text","text":" "},{"type":"text","text":"local saves too, so a naïve “refresh on remote change” observer feeds the"},{"type":"text","text":" "},{"type":"text","text":"app its own writes."}]}]},{"type":"paragraph","inlineContent":[{"text":"Entities sharing an ID are collapsed to the first occurrence. A store","type":"text"},{"text":" ","type":"text"},{"text":"cannot represent duplicates — ","type":"text"},{"code":"positions","type":"codeVoice"},{"text":" holds one index per ID — and","type":"text"},{"text":" ","type":"text"},{"text":"admitting them corrupts the index: the map would keep only the last","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"index while the array kept every copy, so "},{"type":"codeVoice","code":"count"},{"type":"text","text":" over-reports and a"},{"type":"text","text":" "},{"type":"text","text":"later delete orphans the earlier copy with no "},{"type":"codeVoice","code":"positions"},{"type":"text","text":" entry at all,"},{"type":"text","text":" "},{"type":"text","text":"leaving a row that is visible in "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/values","isActive":true,"type":"reference"},{"type":"text","text":" but invisible to"},{"type":"text","text":" "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/contains(_:)","isActive":true,"type":"reference"},{"type":"text","text":" and the subscript. Persisted rows can legitimately"},{"type":"text","text":" "},{"type":"text","text":"share an ID (CloudKit forbids unique constraints), so this initializer"},{"type":"text","text":" "},{"type":"text","text":"has to be total rather than trusting its input."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/entitystore\/init(_:)"]}],"kind":"symbol","abstract":[{"text":"Creates a store pre-populated from an array (e.g. first-load hydration at app launch).","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/init(_:)"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"]]},"metadata":{"modules":[{"name":"Swidux"}],"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"(["},{"kind":"typeIdentifier","text":"Entity"},{"kind":"text","text":"])"}],"roleHeading":"Initializer","role":"symbol","symbolKind":"init","externalID":"s:6Swidux11EntityStoreVyACyxGSayxGcfc","title":"init(_:)"},"references":{"doc://Swidux/documentation/Swidux/EntityStore":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"An ordered, keyed collection of identifiable entities that silently records"},{"type":"text","text":" "},{"type":"text","text":"every mutation for downstream persistence."}],"type":"topic","title":"EntityStore","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"EntityStore","kind":"identifier"}],"navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"url":"\/documentation\/swidux\/entitystore"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","kind":"symbol","title":"Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection"},"doc://Swidux/documentation/Swidux/EntityStore/contains(_:)":{"title":"contains(_:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"contains","kind":"identifier"},{"text":"(","kind":"text"},{"text":"UUID","kind":"typeIdentifi