{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"title":"Add Persistence","roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article"},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides","anchor":"How-to-Guides","generated":true}],"abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" turns persistence into a declare-and-register concern. You annotate a domain entity with "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":"; the macro generates its SwiftData "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" “shadow” class, the value↔model converters, and the "},{"type":"codeVoice","code":"PersistableEntity"},{"type":"text","text":" conformance. A generic "},{"type":"codeVoice","code":"EntityDB"},{"type":"text","text":" actor and a "},{"type":"codeVoice","code":"PersistenceCoordinator"},{"type":"text","text":" build the container, synthesize one "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" per registered "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":", and reuse the core "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true},{"type":"text","text":" for debounced, batched writes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your reducers mutate plain value-type entities inside an "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":"; the plugin observes the changelog and writes through to SwiftData after a debounce. Reads happen once, at launch, into memory — the in-memory "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" is the source of truth."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For low-level manual wiring (writing your own "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":"), see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true},{"type":"text","text":". For the macro details, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","isActive":true},{"type":"text","text":". To add cross-device iCloud sync on top, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true},{"type":"text","text":"."}]},{"type":"heading","anchor":"Before-you-start","text":"Before you start","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes a Swidux app already exists — "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" are wired and the store is in the SwiftUI environment. If not, follow "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" is a local-only persistence layer. It needs "},{"type":"strong","inlineContent":[{"type":"text","text":"no iCloud, CloudKit, or Push entitlements"}]},{"type":"text","text":" — only the sandbox "},{"type":"codeVoice","code":"com.apple.security.network.client"},{"type":"text","text":" entitlement if your app also makes network calls (killswitch, analytics, feature flags). Adding sync entitlements to a local-only app is dead configuration and an App Review risk."}]},{"type":"heading","anchor":"Step-1-Add-the-dependency","text":"Step 1: Add the dependency","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPersistence\",","    ]",")"]},{"type":"heading","anchor":"Step-2-Annotate-your-domain-entity-with-Persisted","text":"Step 2: Annotate your domain entity with `@Persisted`","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A persisted entity is a value type that already satisfies "},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"type":"text","text":" with "},{"type":"codeVoice","code":"ID == UUID"},{"type":"text","text":" (the "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" contract). Add "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxPersistence","","@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","    var createdAt: Date","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This generates a "},{"type":"codeVoice","code":"CardModel: @Model"},{"type":"text","text":" class with "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"toDomain()"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"update(from:)"},{"type":"text","text":", plus "},{"type":"codeVoice","code":"extension Card: PersistableEntity { typealias Model = CardModel }"},{"type":"text","text":". By default every stored property is mirrored directly onto the model — SwiftData persists scalars "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" composites natively, so no manual blob columns are needed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The generated model is "},{"type":"strong","inlineContent":[{"type":"text","text":"CloudKit-safe by construction"}]},{"type":"text","text":", so the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"type":"text","text":" model backs both the local and the synced container (see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true},{"type":"text","text":"). SwiftData’s CloudKit mirroring requires every non-optional attribute to be optional or carry a default value, and every relationship to be optional — validated when the "},{"type":"codeVoice","code":"ModelContainer"},{"type":"text","text":" is created. "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" satisfies this automatically:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Non-optional mirrored attributes get a default."}],"type":"strong"},{"text":" If you wrote one on the domain property (","type":"text"},{"code":"var count: Int = 0","type":"codeVoice"},{"type":"text","text":"), it is propagated verbatim; otherwise the macro fills a canonical default for the known SwiftData primitives ("},{"type":"codeVoice","code":"String → \"\""},{"type":"text","text":", "},{"type":"codeVoice","code":"Bool → false"},{"type":"text","text":", integers\/floats "},{"type":"codeVoice","code":"→ 0"},{"type":"text","text":", "},{"type":"codeVoice","code":"Date → .distantPast"},{"type":"text","text":", "},{"type":"codeVoice","code":"Data → Data()"},{"type":"text","text":", "},{"type":"codeVoice","code":"UUID → UUID()"},{"type":"text","text":"). Defaults are inert locally — "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" overwrites them on every load."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Non-primitive, non-optional properties"}],"type":"strong"},{"type":"text","text":" (a custom "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" type, "},{"type":"codeVoice","code":"URL"},{"type":"text","text":", an enum) have no default the macro can invent. Give the property a default ("},{"type":"codeVoice","code":"= …"},{"type":"text","text":"), make it optional, or mark it "},{"code":"@Inline","type":"codeVoice"},{"type":"text","text":" — otherwise "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" emits a compile-time error."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Relationships are generated optional"}]},{"type":"text","text":" ("},{"code":"var tags: [TagModel]? = nil","type":"codeVoice"},{"type":"text","text":"); a non-optional to-one "},{"code":"@Relation","type":"codeVoice"},{"type":"text","text":" is a compile-time error (CloudKit forbids non-optional relationships)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"@Inline","type":"codeVoice"},{"type":"text","text":" blob columns"}],"type":"strong"},{"text":" default to ","type":"text"},{"type":"codeVoice","code":"Data()"},{"type":"text","text":", so any "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" type is CloudKit-safe through "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":". Because "},{"type":"codeVoice","code":"Data()"},{"type":"text","text":" is never decodable, a "},{"type":"strong","inlineContent":[{"type":"text","text":"non-optional"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" property must also carry a domain default ("},{"type":"codeVoice","code":"= …"},{"type":"text","text":") — the generated getter falls back to it when the blob is missing or undecodable (e.g. a row CloudKit materialized before the blob synced). Omitting the default is a compile-time error ("},{"type":"codeVoice","code":"inlineRequiresDefault"},{"type":"text","text":")."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" lives on the "},{"inlineContent":[{"type":"text","text":"entity"}],"type":"strong"},{"type":"text","text":"; "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" lives on "},{"inlineContent":[{"type":"text","text":"state containers"}],"type":"strong"},{"type":"text","text":" ("},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":" slices). They are different layers and never apply to the same type."}]},{"level":3,"anchor":"Marker-macros-for-non-trivial-properties","type":"heading","text":"Marker macros for non-trivial properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A macro can’t infer relationships, foreign keys, or which fields are derived. Four property markers (named to avoid SwiftData’s own "},{"type":"codeVoice","code":"@Relationship"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"@Transient"},{"type":"text","text":") tell "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" what to do:"}]},{"code":["@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","","    @Inline var styling: TextStyling = TextStyling()  \/\/ one opaque JSON Data column","    @ForeignKey var deckID: UUID                      \/\/ scalar parent reference","    @Relation(deleteRule: .cascade, inverse: \\TagModel.card)","    var tags: [Tag]                                   \/\/ SwiftData relationship","    @Ignored var renderedPreview: String?             \/\/ derived; omitted from the model","}"],"type":"codeListing","syntax":"swift"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Marker"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Effect"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"(none)"}],"type":"emphasis"}]}],[{"type":"paragraph","inlineContent":[{"text":"Mirror the property directly (SwiftData persists scalars and ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" composites).","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"@Inline","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Force a "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" value into a single JSON "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" column (keeps a CloudKit record compact; sidesteps SwiftData "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":"-attribute edge cases)."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"@ForeignKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Intent marker on a "},{"code":"UUID","type":"codeVoice"},{"type":"text","text":"; functionally a mirrored scalar column."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"@Relation(deleteRule:inverse:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A SwiftData relationship to another "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" entity. The property’s type references the "},{"inlineContent":[{"type":"text","text":"domain"}],"type":"emphasis"},{"type":"text","text":" type ("},{"code":"[Tag]","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Tag?","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Tag","type":"codeVoice"},{"type":"text","text":"); the model substitutes the "},{"code":"…Model","type":"codeVoice"},{"type":"text","text":" shadow. "},{"code":"inverse","type":"codeVoice"},{"type":"text","text":" is a key path on the generated model, e.g. "},{"code":"\\TagModel.card","type":"codeVoice"},{"type":"text","text":". "},{"code":"deleteRule","type":"codeVoice"},{"type":"text","text":" is a "},{"code":"SwiduxDeleteRule","type":"codeVoice"},{"type":"text","text":" ("},{"code":".cascade","type":"codeVoice"},{"type":"text","text":", "},{"code":".nullify","type":"codeVoice"},{"type":"text","text":", "},{"code":".noAction","type":"codeVoice"},{"type":"text","text":", "},{"code":".deny","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"@Ignored","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Exclude a derived\/denormalized property. Must be optional so it can be reconstructed as "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" on load."}],"type":"paragraph"}]]]},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" does not generate an "},{"code":"@Attribute(.unique)","type":"codeVoice"},{"type":"text","text":" on "},{"code":"id","type":"codeVoice"},{"type":"text","text":" — CloudKit forbids unique constraints. Identity is enforced by upsert-by-"},{"code":"id","type":"codeVoice"},{"type":"text","text":" inside "},{"code":"EntityDB","type":"codeVoice"},{"type":"text","text":", so the same generated model works for both local and synced containers."}],"type":"paragraph"}]},{"level":2,"type":"heading","text":"Step 3: Put the `EntityStore` on your state","anchor":"Step-3-Put-the-EntityStore-on-your-state"},{"code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var cards: EntityStore<Card> = .init()","    \/\/ ... your other slices","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Your reducers mutate ","type":"text"},{"code":"state.cards","type":"codeVoice"},{"text":" like any ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" — ","type":"text"},{"code":"state.cards[card.id] = card","type":"codeVoice"},{"text":", ","type":"text"},{"code":"state.cards.modify(id) { … }","type":"codeVoice"},{"text":", ","type":"text"},{"code":"state.cards[id] = nil","type":"codeVoice"},{"text":". Every change is recorded for the plugin to drain.","type":"text"}]},{"level":2,"type":"heading","text":"Step 4: Build the coordinator and register the plugin","anchor":"Step-4-Build-the-coordinator-and-register-the-plugin"},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":", build a local container, create a ","type":"text"},{"code":"PersistenceCoordinator","type":"codeVoice"},{"text":", register its plugin, and run first-load hydration before constructing the store:","type":"text"}]},{"code":["import SwiduxPersistence","","extension Store where State == AppState, Action == AppAction {","    static func configured() async -> AppStore {","        let container = try! ContainerFactory.makeLocalContainer(models: [CardModel.self])","","        let persistence = PersistenceCoordinator<AppState, AppAction>(","            entities: [.entity(\\.cards)],","            container: container,","            debounce: .milliseconds(250)","        )","","        let plugins = PluginHost<AppState, AppAction>()","        \/\/ Register UndoPlugin first if you use it — snapshots must precede writes.","        plugins.register(persistence.corePlugin)","","        var initial = AppState()","        await persistence.hydrate(into: &initial)   \/\/ first-load: fill EntityStores from disk","","        return Store(initialState: initial, reducer: { … }, plugins: plugins)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"hydrate(into:)","type":"codeVoice"},{"text":" is ","type":"text"},{"inlineContent":[{"type":"text","text":"first-load only"}],"type":"strong"},{"text":" — it replaces each ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" with the on-disk rows before any live edits exist. The only refresh path after launch is ","type":"text"},{"code":"rehydrate(into:)","type":"codeVoice"},{"text":", which always ","type":"text"},{"inlineContent":[{"type":"text","text":"merges"}],"type":"emphasis"},{"text":" (preferring in-memory values) so a “refresh from disk” can never clobber unflushed writes or in-progress UI edits.","type":"text"}]},{"level":3,"type":"heading","text":"Surfacing failures","anchor":"Surfacing-failures"},{"type":"paragraph","inlineContent":[{"text":"Every save and fetch failure is logged, and the coordinator accepts an optional ","type":"text"},{"code":"onFailure:","type":"codeVoice"},{"text":" handler to additionally surface it to your app (a failed ","type":"text"},{"inlineContent":[{"type":"text","text":"save"}],"type":"strong"},{"text":" means the in-memory data is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" on disk; a failed ","type":"text"},{"inlineContent":[{"type":"text","text":"hydrate fetch"}],"type":"strong"},{"text":" leaves that ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":" untouched rather than presenting an unreadable store as “no data”):","type":"text"}]},{"code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    onFailure: { failure in","        \/\/ e.g. dispatch an action that shows a \"couldn't save\" banner","    }",")"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Step 5: Flush on background","anchor":"Step-5-Flush-on-background"},{"type":"paragraph","inlineContent":[{"text":"Writes are debounced, so drain them when the app is backgrounded or terminates:","type":"text"}]},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await persistence.corePlugin.flush() }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Multiple entities and ordering","anchor":"Multiple-entities-and-ordering"},{"type":"paragraph","inlineContent":[{"text":"Register one ","type":"text"},{"code":".entity(\\.keyPath)","type":"codeVoice"},{"text":" per ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.decks), .entity(\\.cards), .entity(\\.tags)],","    container: try! ContainerFactory.makeLocalContainer(","        models: [DeckModel.self, CardModel.self, TagModel.self]","    )",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Pass every generated ","type":"text"},{"code":"…Model","type":"codeVoice"},{"text":" type to the container’s ","type":"text"},{"code":"models:","type":"codeVoice"},{"text":". Writers flush in registration order — if entity B holds a ","type":"text"},{"code":"@Relation","type":"codeVoice"},{"text":" to A, register A’s entity first.","type":"text"}]},{"level":2,"type":"heading","text":"Testing","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"The whole stack runs against an in-memory SwiftData store, so persistence is unit-testable with no disk and no CloudKit:","type":"text"}]},{"code":["let container = try ContainerFactory.makeInMemoryContainer(models: [CardModel.self])","let db = EntityDB(modelContainer: container)","","try await db.upsert(Card(id: id, quote: \"hi\", createdAt: .now), as: CardModel.self)","let all = try await db.fetchAll(CardModel.self)","#expect(all.first?.quote == \"hi\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"To prove the rule-#8 merge guarantee, seed the store, make a live in-memory edit, call ","type":"text"},{"code":"coordinator.rehydrate(into:)","type":"codeVoice"},{"text":", and assert the live edit survives.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/swidux\/howtoaddpersistence"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"url":"\/documentation\/swidux\/buildingadomainplugin","kind":"article","type":"topic","abstract":[{"text":"Create a s