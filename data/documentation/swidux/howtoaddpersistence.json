{"variants":[{"paths":["\/documentation\/swidux\/howtoaddpersistence"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"title":"Add Persistence","modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article"},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"title":"How-to Guides","anchor":"How-to-Guides"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" turns persistence into a declare-and-register concern. You annotate a domain entity with "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":"; the macro generates its SwiftData "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" “shadow” class, the value↔model converters, and the "},{"type":"codeVoice","code":"PersistableEntity"},{"type":"text","text":" conformance. A generic "},{"type":"codeVoice","code":"EntityDB"},{"type":"text","text":" actor and a "},{"type":"codeVoice","code":"PersistenceCoordinator"},{"type":"text","text":" build the container, synthesize one "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" per registered "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":", and reuse the core "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true},{"type":"text","text":" for debounced, batched writes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your reducers mutate plain value-type entities inside an "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":"; the plugin observes the changelog and writes through to SwiftData after a debounce. Reads happen once, at launch, into memory — the in-memory "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" is the source of truth."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For low-level manual wiring (writing your own "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":"), see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true},{"type":"text","text":". For the macro details, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","isActive":true},{"type":"text","text":". To add cross-device iCloud sync on top, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"Before you start","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes a Swidux app already exists — "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" are wired and the store is in the SwiftUI environment. If not, follow "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" is a local-only persistence layer. It needs "},{"inlineContent":[{"text":"no iCloud, CloudKit, or Push entitlements","type":"text"}],"type":"strong"},{"type":"text","text":" — only the sandbox "},{"type":"codeVoice","code":"com.apple.security.network.client"},{"type":"text","text":" entitlement if your app also makes network calls (killswitch, analytics, feature flags). Adding sync entitlements to a local-only app is dead configuration and an App Review risk."}]},{"level":2,"type":"heading","text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPersistence\",","    ]",")"]},{"level":2,"type":"heading","text":"Step 2: Annotate your domain entity with `@Persisted`","anchor":"Step-2-Annotate-your-domain-entity-with-Persisted"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A persisted entity is a value type that already satisfies "},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"type":"text","text":" with "},{"type":"codeVoice","code":"ID == UUID"},{"type":"text","text":" (the "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" contract). Add "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxPersistence","","@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","    var createdAt: Date","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This generates a "},{"type":"codeVoice","code":"CardModel: @Model"},{"type":"text","text":" class with "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"toDomain()"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"update(from:)"},{"type":"text","text":", plus "},{"type":"codeVoice","code":"extension Card: PersistableEntity { typealias Model = CardModel }"},{"type":"text","text":". By default every stored property is mirrored directly onto the model — SwiftData persists scalars "},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" composites natively, so no manual blob columns are needed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The generated model is "},{"inlineContent":[{"text":"CloudKit-safe by construction","type":"text"}],"type":"strong"},{"type":"text","text":", so the "},{"inlineContent":[{"text":"same","type":"text"}],"type":"emphasis"},{"type":"text","text":" model backs both the local and the synced container (see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true},{"type":"text","text":"). SwiftData’s CloudKit mirroring requires every non-optional attribute to be optional or carry a default value, and every relationship to be optional — validated when the "},{"type":"codeVoice","code":"ModelContainer"},{"type":"text","text":" is created. "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" satisfies this automatically:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Non-optional mirrored attributes get a default.","type":"text"}]},{"type":"text","text":" If you wrote one on the domain property ("},{"code":"var count: Int = 0","type":"codeVoice"},{"type":"text","text":"), it is propagated verbatim; otherwise the macro fills a canonical default for the known SwiftData primitives ("},{"code":"String → \"\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"Bool → false","type":"codeVoice"},{"type":"text","text":", integers\/floats "},{"code":"→ 0","type":"codeVoice"},{"type":"text","text":", "},{"code":"Date → .distantPast","type":"codeVoice"},{"type":"text","text":", "},{"code":"Data → Data()","type":"codeVoice"},{"type":"text","text":", "},{"code":"UUID → UUID()","type":"codeVoice"},{"type":"text","text":"). Defaults are inert locally — "},{"code":"init(from:)","type":"codeVoice"},{"type":"text","text":" overwrites them on every load."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Non-primitive, non-optional properties","type":"text"}]},{"type":"text","text":" (a custom "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" type, "},{"code":"URL","type":"codeVoice"},{"type":"text","text":", an enum) have no default the macro can invent. Give the property a default ("},{"code":"= …","type":"codeVoice"},{"type":"text","text":"), make it optional, or mark it "},{"code":"@Inline","type":"codeVoice"},{"type":"text","text":" — otherwise "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" emits a compile-time error."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Relationships are generated optional","type":"text"}]},{"type":"text","text":" ("},{"code":"var tags: [TagModel]? = nil","type":"codeVoice"},{"type":"text","text":"); a non-optional to-one "},{"code":"@Relation","type":"codeVoice"},{"type":"text","text":" is a compile-time error (CloudKit forbids non-optional relationships)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"@Inline","type":"codeVoice"},{"text":" blob columns","type":"text"}]},{"type":"text","text":" default to "},{"code":"Data()","type":"codeVoice"},{"type":"text","text":", so any "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" type is CloudKit-safe through "},{"code":"@Inline","type":"codeVoice"},{"type":"text","text":". Because "},{"code":"Data()","type":"codeVoice"},{"type":"text","text":" is never decodable, a "},{"type":"strong","inlineContent":[{"text":"non-optional","type":"text"}]},{"type":"text","text":" "},{"code":"@Inline","type":"codeVoice"},{"type":"text","text":" property must also carry a domain default ("},{"code":"= …","type":"codeVoice"},{"type":"text","text":") — the generated getter falls back to it when the blob is missing or undecodable (e.g. a row CloudKit materialized before the blob synced). Omitting the default is a compile-time error ("},{"code":"inlineRequiresDefault","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" lives on the "},{"inlineContent":[{"text":"entity","type":"text"}],"type":"strong"},{"type":"text","text":"; "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" lives on "},{"inlineContent":[{"text":"state containers","type":"text"}],"type":"strong"},{"type":"text","text":" ("},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" slices). They are different layers and never apply to the same type."}]},{"level":3,"type":"heading","text":"Marker macros for non-trivial properties","anchor":"Marker-macros-for-non-trivial-properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A macro can’t infer relationships, foreign keys, or which fields are derived. Four property markers (named to avoid SwiftData’s own "},{"type":"codeVoice","code":"@Relationship"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"@Transient"},{"type":"text","text":") tell "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" what to do:"}]},{"syntax":"swift","type":"codeListing","code":["@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","","    @Inline var styling: TextStyling = TextStyling()  \/\/ one opaque JSON Data column","    @ForeignKey var deckID: UUID                      \/\/ scalar parent reference","    @Relation(deleteRule: .cascade, inverse: \\TagModel.card)","    var tags: [Tag]                                   \/\/ SwiftData relationship","    @Ignored var renderedPreview: String?             \/\/ derived; omitted from the model","}"]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Marker","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Effect","type":"text"}]}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"(none)"}],"type":"emphasis"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Mirror the property directly (SwiftData persists scalars and ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" composites).","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"@Inline","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Force a "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" value into a single JSON "},{"code":"Data","type":"codeVoice"},{"text":" column (keeps a CloudKit record compact; sidesteps SwiftData ","type":"text"},{"code":"Codable","type":"codeVoice"},{"type":"text","text":"-attribute edge cases)."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"@ForeignKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Intent marker on a "},{"code":"UUID","type":"codeVoice"},{"type":"text","text":"; functionally a mirrored scalar column."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"@Relation(deleteRule:inverse:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A SwiftData relationship to another ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" entity. The property’s type references the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"domain"}]},{"type":"text","text":" type ("},{"code":"[Tag]","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Tag?","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Tag","type":"codeVoice"},{"type":"text","text":"); the model substitutes the "},{"code":"…Model","type":"codeVoice"},{"type":"text","text":" shadow. "},{"type":"codeVoice","code":"inverse"},{"type":"text","text":" is a key path on the generated model, e.g. "},{"type":"codeVoice","code":"\\TagModel.card"},{"type":"text","text":". "},{"type":"codeVoice","code":"deleteRule"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"SwiduxDeleteRule"},{"type":"text","text":" ("},{"type":"codeVoice","code":".cascade"},{"type":"text","text":", "},{"type":"codeVoice","code":".nullify"},{"type":"text","text":", "},{"type":"codeVoice","code":".noAction"},{"type":"text","text":", "},{"type":"codeVoice","code":".deny"},{"type":"text","text":")."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@Ignored"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Exclude a derived\/denormalized property. Must be optional so it can be reconstructed as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" on load.","type":"text"}]}]]],"type":"table","header":"row"},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" does not generate an "},{"type":"codeVoice","code":"@Attribute(.unique)"},{"type":"text","text":" on "},{"type":"codeVoice","code":"id"},{"type":"text","text":" — CloudKit forbids unique constraints — so the same generated model works for both local and synced containers. The cost is that rows sharing an "},{"type":"codeVoice","code":"id"},{"type":"text","text":" are possible. "},{"type":"codeVoice","code":"EntityDB"},{"type":"text","text":" handles them by converging rather than by assuming uniqueness: writes update every matching row, deletions remove every matching row, and "},{"type":"codeVoice","code":"fetchAll"},{"type":"text","text":" collapses to one value per "},{"type":"codeVoice","code":"id"},{"type":"text","text":". Nothing deletes a duplicate as a side effect of a write."}]}],"type":"aside"},{"level":2,"text":"Step 3: Put the `EntityStore` on your state","anchor":"Step-3-Put-the-EntityStore-on-your-state","type":"heading"},{"syntax":"swift","code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var cards: EntityStore<Card> = .init()","    \/\/ ... your other slices","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Your reducers mutate "},{"code":"state.cards","type":"codeVoice"},{"type":"text","text":" like any "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" — "},{"type":"codeVoice","code":"state.cards[card.id] = card"},{"type":"text","text":", "},{"type":"codeVoice","code":"state.cards.modify(id) { … }"},{"type":"text","text":", "},{"type":"codeVoice","code":"state.cards[id] = nil"},{"type":"text","text":". Every change is recorded for the plugin to drain."}],"type":"paragraph"},{"level":2,"text":"Step 4: Build the coordinator and register the plugin","anchor":"Step-4-Build-the-coordinator-and-register-the-plugin","type":"heading"},{"inlineContent":[{"type":"text","text":"In "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":", build a local container, create a "},{"code":"PersistenceCoordinator","type":"codeVoice"},{"type":"text","text":", register its plugin, and run first-load hydration before constructing the store:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxPersistence","","extension Store where State == AppState, Action == AppAction {","    static func configured() async -> AppStore {","        let container = try! ContainerFactory.makeLocalContainer(models: [CardModel.self])","","        let persistence = PersistenceCoordinator<AppState, AppAction>(","            entities: [.entity(\\.cards)],","            container: container,","            debounce: .milliseconds(250)","        )","","        let plugins = PluginHost<AppState, AppAction>()","        \/\/ Register UndoPlugin first if you use it — snapshots must precede writes.","        plugins.register(persistence.corePlugin)","","        var initial = AppState()","        await persistence.hydrate(into: &initial)   \/\/ first-load: fill EntityStores from disk","","        return Store(initialState: initial, reducer: { … }, plugins: plugins)","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"hydrate(into:)","type":"codeVoice"},{"type":"text","text":" is "},{"type":"strong","inlineContent":[{"type":"text","text":"first-load only"}]},{"type":"text","text":" — it replaces each "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" with the on-disk rows before any live edits exist. It takes "},{"code":"inout State","type":"codeVoice"},{"type":"text","text":" because it runs "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before the store is built"}]},{"type":"text","text":", so there is nothing to race with."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The only refresh path after launch is "},{"code":"rehydrate(into:)","type":"codeVoice"},{"type":"text","text":", which "},{"type":"emphasis","inlineContent":[{"type":"text","text":"reconciles"}]},{"type":"text","text":" rather than replaces: rows on disk are authoritative except for IDs that still carry unflushed local intent, which always win. So a “refresh from disk” can never clobber pending writes or in-progress UI edits, while remote edits and deletions still surface mid-session. Pass "},{"code":"policy:","type":"codeVoice"},{"type":"text","text":" — or register an entity with "},{"code":"policy:","type":"codeVoice"},{"type":"text","text":" — to narrow that; see "},{"code":"MergePolicy","type":"codeVoice"},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It takes the "},{"type":"strong","inlineContent":[{"type":"text","text":"store"}]},{"type":"text","text":", not "},{"code":"inout State","type":"codeVoice"},{"type":"text","text":": re-hydration is asynchronous, and a caller holding a state snapshot across those "},{"code":"await","type":"codeVoice"},{"type":"text","text":"s would discard everything dispatched while they were in flight. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","isActive":true},{"type":"text","text":" if edits are vanishing after a load."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you need to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"read"}]},{"type":"text","text":" rows without touching state, don’t re-hydrate into a throwaway "},{"code":"AppState()","type":"codeVoice"},{"type":"text","text":" — that idiom breaks silently the moment re-hydration starts reading the state it is handed. Use "},{"code":"fetchAll(of:)","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"snapshot(of:)","type":"codeVoice"},{"type":"text","text":" on the coordinator instead."}],"type":"paragraph"},{"level":3,"text":"Reading rows without touching state","anchor":"Reading-rows-without-touching-state","type":"heading"},{"inlineContent":[{"type":"text","text":"For exports, migrations, diagnostics, or any other “what’s actually on disk?” question, read directly — naming your domain type, not its generated shadow:"}],"type":"paragraph"},{"syntax":"swift","code":["let notes = try await persistence.fetchAll(of: Note.self)","let store = try await persistence.snapshot(of: Note.self)   \/\/ as an EntityStore"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Both flush the debounce window first by default, so they can’t return a stale row for something the user just edited; pass "},{"code":"flushPending: false","type":"codeVoice"},{"type":"text","text":" on a hot path where that doesn’t matter. Both report failures to "},{"code":"onFailure","type":"codeVoice"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" rethrow — there is no state to leave untouched here, so swallowing the error could only present an unreadable database as “no data”."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The entity does not have to be registered with the coordinator; reading a model that is in the container’s schema but not mirrored into state is fine."}],"type":"paragraph"},{"name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Don’t answer these questions by re-hydrating into a throwaway "},{"type":"codeVoice","code":"AppState()"},{"type":"text","text":". That reads like a pure fetch but is really a merge, and it breaks silently the moment re-hydration starts consulting the state it is handed."}]}],"type":"aside"},{"level":3,"text":"Surfacing failures","anchor":"Surfacing-failures","type":"heading"},{"inlineContent":[{"type":"text","text":"Every save and fetch failure is logged, and the coordinator accepts an optional "},{"type":"codeVoice","code":"onFailure:"},{"type":"text","text":" handler to additionally surface it to your app (a failed "},{"type":"strong","inlineContent":[{"text":"save","type":"text"}]},{"type":"text","text":" means the in-memory data is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" on disk; a failed "},{"inlineContent":[{"type":"text","text":"hydrate fetch"}],"type":"strong"},{"text":" leaves that ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":" untouched rather than presenting an unreadable store as “no data”):","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    onFailure: { failure in","        \/\/ e.g. dispatch an action that shows a \"couldn't save\" banner","    }",")"],"type":"codeListing"},{"level":2,"text":"Step 5: Flush on background","anchor":"Step-5-Flush-on-background","type":"heading"},{"inlineContent":[{"type":"text","text":"Writes are debounced, so drain them when the app is backgrounded or terminates:"}],"type":"paragraph"},{"syntax":"swift","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await persistence.corePlugin.flush() }","    }","}"],"type":"codeListing"},{"level":2,"text":"Multiple entities and ordering","anchor":"Multiple-entities-and-ordering","type":"heading"},{"inlineContent":[{"type":"text","text":"Register one "},{"type":"codeVoice","code":".entity(\\.keyPath)"},{"type":"text","text":" per "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.decks), .entity(\\.cards), .entity(\\.tags)],","    container: try! ContainerFactory.makeLocalContainer(","        models: [DeckModel.self, CardModel.self, TagModel.self]","    )",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Pass every generated "},{"type":"codeVoice","code":"…Model"},{"type":"text","text":" type to the container’s "},{"type":"codeVoice","code":"models:"},{"type":"text","text":". Writers flush in registration order — if entity B holds a "},{"type":"codeVoice","code":"@Relation"},{"type":"text","text":" to A, register A’s entity first."}],"type":"paragraph"},{"level":2,"text":"Testing","anchor":"Testing","type":"heading"},{"inlineContent":[{"type":"text","text":"The whole stack runs against an in-memory SwiftData store, so persistence is unit-testable with no disk and no CloudKit:"}],"type":"paragraph"},{"syntax":"swift","code":["let container = try ContainerFactory.makeInMemoryContainer(models: [CardModel.self])","let db = EntityDB(modelContainer: container)","","try await db.upsert(Card(id: id, quote: \"hi\", createdAt: .now), as: CardModel.self)","let all = try await db.fetchAll(CardModel.self)","#expect(all.first?.quote == \"hi\")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"To prove the rule-#8 merge guarantee, seed the store, make a live in-memory edit, call "},{"type":"codeVoice","code":"coordinator.rehydrate(into:)"},{"type":"text","text":", and assert the live edit survives."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice",