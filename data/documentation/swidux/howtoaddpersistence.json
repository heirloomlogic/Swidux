{"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}],"title":"Add Persistence"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" turns persistence into a declare-and-register concern. You annotate a domain entity with "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":"; the macro generates its SwiftData "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" “shadow” class, the value↔model converters, and the "},{"type":"codeVoice","code":"PersistableEntity"},{"text":" conformance. A generic ","type":"text"},{"type":"codeVoice","code":"EntityDB"},{"type":"text","text":" actor and a "},{"type":"codeVoice","code":"PersistenceCoordinator"},{"type":"text","text":" build the container, synthesize one "},{"code":"StateWriter","type":"codeVoice"},{"text":" per registered ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":", and reuse the core "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true,"type":"reference"},{"text":" for debounced, batched writes.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Your reducers mutate plain value-type entities inside an "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":"; the plugin observes the changelog and writes through to SwiftData after a debounce. Reads happen once, at launch, into memory — the in-memory "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":" is the source of truth."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"For low-level manual wiring (writing your own ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":"), see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true,"type":"reference"},{"text":". For the macro details, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"},{"type":"text","text":". To add cross-device iCloud sync on top, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},{"type":"text","text":"."}]},{"anchor":"Before-you-start","type":"heading","level":2,"text":"Before you start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes a Swidux app already exists — "},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"type":"text","text":" are wired and the store is in the SwiftUI environment. If not, follow "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true,"type":"reference"},{"text":" first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" is a local-only persistence layer. It needs ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"no iCloud, CloudKit, or Push entitlements"}]},{"type":"text","text":" — only the sandbox "},{"type":"codeVoice","code":"com.apple.security.network.client"},{"type":"text","text":" entitlement if your app also makes network calls (killswitch, analytics, feature flags). Adding sync entitlements to a local-only app is dead configuration and an App Review risk."}]},{"type":"heading","level":2,"anchor":"Step-1-Add-the-dependency","text":"Step 1: Add the dependency"},{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPersistence\",","    ]",")"]},{"type":"heading","text":"Step 2: Annotate your domain entity with `@Persisted`","level":2,"anchor":"Step-2-Annotate-your-domain-entity-with-Persisted"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A persisted entity is a value type that already satisfies "},{"code":"Identifiable & Equatable & Sendable","type":"codeVoice"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"ID == UUID"},{"type":"text","text":" (the "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":" contract). Add "},{"code":"@Persisted","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["import SwiduxPersistence","","@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","    var createdAt: Date","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This generates a "},{"type":"codeVoice","code":"CardModel: @Model"},{"text":" class with ","type":"text"},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" \/ "},{"code":"toDomain()","type":"codeVoice"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"update(from:)"},{"text":", plus ","type":"text"},{"type":"codeVoice","code":"extension Card: PersistableEntity { typealias Model = CardModel }"},{"text":". By default every stored property is mirrored directly onto the model — SwiftData persists scalars ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" composites natively, so no manual blob columns are needed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The generated model is "},{"type":"strong","inlineContent":[{"text":"CloudKit-safe by construction","type":"text"}]},{"type":"text","text":", so the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"type":"text","text":" model backs both the local and the synced container (see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true},{"type":"text","text":"). SwiftData’s CloudKit mirroring requires every non-optional attribute to be optional or carry a default value, and every relationship to be optional — validated when the "},{"code":"ModelContainer","type":"codeVoice"},{"type":"text","text":" is created. "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" satisfies this automatically:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Non-optional mirrored attributes get a default.","type":"text"}],"type":"strong"},{"type":"text","text":" If you wrote one on the domain property ("},{"type":"codeVoice","code":"var count: Int = 0"},{"type":"text","text":"), it is propagated verbatim; otherwise the macro fills a canonical default for the known SwiftData primitives ("},{"type":"codeVoice","code":"String → \"\""},{"type":"text","text":", "},{"type":"codeVoice","code":"Bool → false"},{"type":"text","text":", integers\/floats "},{"type":"codeVoice","code":"→ 0"},{"type":"text","text":", "},{"type":"codeVoice","code":"Date → .distantPast"},{"type":"text","text":", "},{"type":"codeVoice","code":"Data → Data()"},{"type":"text","text":", "},{"type":"codeVoice","code":"UUID → UUID()"},{"type":"text","text":"). Defaults are inert locally — "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" overwrites them on every load."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Non-primitive, non-optional properties"}],"type":"strong"},{"text":" (a custom ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" type, ","type":"text"},{"code":"URL","type":"codeVoice"},{"text":", an enum) have no default the macro can invent. Give the property a default (","type":"text"},{"code":"= …","type":"codeVoice"},{"text":"), make it optional, or mark it ","type":"text"},{"code":"@Inline","type":"codeVoice"},{"text":" — otherwise ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" emits a compile-time error.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Relationships are generated optional","type":"text"}]},{"type":"text","text":" ("},{"code":"var tags: [TagModel]? = nil","type":"codeVoice"},{"type":"text","text":"); a non-optional to-one "},{"type":"codeVoice","code":"@Relation"},{"type":"text","text":" is a compile-time error (CloudKit forbids non-optional relationships)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"@Inline","type":"codeVoice"},{"type":"text","text":" blob columns"}]},{"type":"text","text":" default to "},{"type":"codeVoice","code":"Data()"},{"type":"text","text":", so any "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" type is CloudKit-safe through "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":". Because "},{"type":"codeVoice","code":"Data()"},{"type":"text","text":" is never decodable, a "},{"type":"strong","inlineContent":[{"type":"text","text":"non-optional"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" property must also carry a domain default ("},{"type":"codeVoice","code":"= …"},{"type":"text","text":") — the generated getter falls back to it when the blob is missing or undecodable (e.g. a row CloudKit materialized before the blob synced). Omitting the default is a compile-time error ("},{"type":"codeVoice","code":"inlineRequiresDefault"},{"type":"text","text":")."}]}]}]},{"inlineContent":[{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" lives on the "},{"type":"strong","inlineContent":[{"type":"text","text":"entity"}]},{"type":"text","text":"; "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" lives on "},{"type":"strong","inlineContent":[{"type":"text","text":"state containers"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" slices). They are different layers and never apply to the same type."}],"type":"paragraph"},{"text":"Marker macros for non-trivial properties","anchor":"Marker-macros-for-non-trivial-properties","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"A macro can’t infer relationships, foreign keys, or which fields are derived. Four property markers (named to avoid SwiftData’s own "},{"code":"@Relationship","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"@Transient","type":"codeVoice"},{"type":"text","text":") tell "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" what to do:"}],"type":"paragraph"},{"syntax":"swift","code":["@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","","    @Inline var styling: TextStyling = TextStyling()  \/\/ one opaque JSON Data column","    @ForeignKey var deckID: UUID                      \/\/ scalar parent reference","    @Relation(deleteRule: .cascade, inverse: \\TagModel.card)","    var tags: [Tag]                                   \/\/ SwiftData relationship","    @Ignored var renderedPreview: String?             \/\/ derived; omitted from the model","}"],"type":"codeListing"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Marker"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Effect"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"emphasis","inlineContent":[{"text":"(none)","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Mirror the property directly (SwiftData persists scalars and "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" composites)."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"@Inline","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Force a ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" value into a single JSON ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":" column (keeps a CloudKit record compact; sidesteps SwiftData ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":"-attribute edge cases).","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@ForeignKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"Intent marker on a ","type":"text"},{"code":"UUID","type":"codeVoice"},{"text":"; functionally a mirrored scalar column.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"@Relation(deleteRule:inverse:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A SwiftData relationship to another "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" entity. The property’s type references the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"domain"}]},{"type":"text","text":" type ("},{"type":"codeVoice","code":"[Tag]"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Tag?"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Tag"},{"type":"text","text":"); the model substitutes the "},{"type":"codeVoice","code":"…Model"},{"type":"text","text":" shadow. "},{"code":"inverse","type":"codeVoice"},{"text":" is a key path on the generated model, e.g. ","type":"text"},{"code":"\\TagModel.card","type":"codeVoice"},{"text":". ","type":"text"},{"code":"deleteRule","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"SwiduxDeleteRule","type":"codeVoice"},{"text":" (","type":"text"},{"code":".cascade","type":"codeVoice"},{"text":", ","type":"text"},{"code":".nullify","type":"codeVoice"},{"text":", ","type":"text"},{"code":".noAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":".deny","type":"codeVoice"},{"text":").","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Ignored"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Exclude a derived\/denormalized property. Must be optional so it can be reconstructed as "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" on load."}]}]]],"type":"table"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" does not generate an "},{"type":"codeVoice","code":"@Attribute(.unique)"},{"type":"text","text":" on "},{"type":"codeVoice","code":"id"},{"type":"text","text":" — CloudKit forbids unique constraints. Identity is enforced by upsert-by-"},{"type":"codeVoice","code":"id"},{"type":"text","text":" inside "},{"type":"codeVoice","code":"EntityDB"},{"type":"text","text":", so the same generated model works for both local and synced containers."}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"level":2,"text":"Step 3: Put the `EntityStore` on your state","anchor":"Step-3-Put-the-EntityStore-on-your-state","type":"heading"},{"syntax":"swift","type":"codeListing","code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var cards: EntityStore<Card> = .init()","    \/\/ ... your other slices","}"]},{"inlineContent":[{"type":"text","text":"Your reducers mutate "},{"type":"codeVoice","code":"state.cards"},{"type":"text","text":" like any "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" — "},{"type":"codeVoice","code":"state.cards[card.id] = card"},{"type":"text","text":", "},{"type":"codeVoice","code":"state.cards.modify(id) { … }"},{"type":"text","text":", "},{"type":"codeVoice","code":"state.cards[id] = nil"},{"type":"text","text":". Every change is recorded for the plugin to drain."}],"type":"paragraph"},{"text":"Step 4: Build the coordinator and register the plugin","type":"heading","level":2,"anchor":"Step-4-Build-the-coordinator-and-register-the-plugin"},{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":", build a local container, create a "},{"type":"codeVoice","code":"PersistenceCoordinator"},{"type":"text","text":", register its plugin, and run first-load hydration before constructing the store:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiduxPersistence","","extension Store where State == AppState, Action == AppAction {","    static func configured() async -> AppStore {","        let container = try! ContainerFactory.makeLocalContainer(models: [CardModel.self])","","        let persistence = PersistenceCoordinator<AppState, AppAction>(","            entities: [.entity(\\.cards)],","            container: container,","            debounce: .milliseconds(250)","        )","","        let plugins = PluginHost<AppState, AppAction>()","        \/\/ Register UndoPlugin first if you use it — snapshots must precede writes.","        plugins.register(persistence.corePlugin)","","        var initial = AppState()","        await persistence.hydrate(into: &initial)   \/\/ first-load: fill EntityStores from disk","","        return Store(initialState: initial, reducer: { … }, plugins: plugins)","    }","}"]},{"inlineContent":[{"type":"codeVoice","code":"hydrate(into:)"},{"type":"text","text":" is "},{"type":"strong","inlineContent":[{"type":"text","text":"first-load only"}]},{"type":"text","text":" — it replaces each "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":" with the on-disk rows before any live edits exist. The only refresh path after launch is "},{"type":"codeVoice","code":"rehydrate(into:)"},{"type":"text","text":", which always "},{"type":"emphasis","inlineContent":[{"text":"merges","type":"text"}]},{"type":"text","text":" (preferring in-memory values) so a “refresh from disk” can never clobber unflushed writes or in-progress UI edits."}],"type":"paragraph"},{"text":"Surfacing failures","type":"heading","level":3,"anchor":"Surfacing-failures"},{"inlineContent":[{"type":"text","text":"Every save and fetch failure is logged, and the coordinator accepts an optional "},{"type":"codeVoice","code":"onFailure:"},{"type":"text","text":" handler to additionally surface it to your app (a failed "},{"type":"strong","inlineContent":[{"text":"save","type":"text"}]},{"type":"text","text":" means the in-memory data is "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" on disk; a failed "},{"type":"strong","inlineContent":[{"text":"hydrate fetch","type":"text"}]},{"type":"text","text":" leaves that "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":" untouched rather than presenting an unreadable store as “no data”):"}],"type":"paragraph"},{"code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    onFailure: { failure in","        \/\/ e.g. dispatch an action that shows a \"couldn't save\" banner","    }",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Step-5-Flush-on-background","level":2,"text":"Step 5: Flush on background","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Writes are debounced, so drain them when the app is backgrounded or terminates:"}]},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await persistence.corePlugin.flush() }","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Multiple-entities-and-ordering","level":2,"text":"Multiple entities and ordering","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register one "},{"type":"codeVoice","code":".entity(\\.keyPath)"},{"type":"text","text":" per "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":":"}]},{"code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.decks), .entity(\\.cards), .entity(\\.tags)],","    container: try! ContainerFactory.makeLocalContainer(","        models: [DeckModel.self, CardModel.self, TagModel.self]","    )",")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Pass every generated ","type":"text"},{"code":"…Model","type":"codeVoice"},{"text":" type to the container’s ","type":"text"},{"code":"models:","type":"codeVoice"},{"text":". Writers flush in registration order — if entity B holds a ","type":"text"},{"code":"@Relation","type":"codeVoice"},{"text":" to A, register A’s entity first.","type":"text"}]},{"anchor":"Testing","level":2,"text":"Testing","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The whole stack runs against an in-memory SwiftData store, so persistence is unit-testable with no disk and no CloudKit:"}]},{"code":["let container = try ContainerFactory.makeInMemoryContainer(models: [CardModel.self])","let db = EntityDB(modelContainer: container)","","try await db.upsert(Card(id: id, quote: \"hi\", createdAt: .now), as: CardModel.self)","let all = try await db.fetchAll(CardModel.self)","#expect(all.first?.quote == \"hi\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"To prove the rule-#8 merge guarantee, seed the store, make a live in-memory edit, call ","type":"text"},{"code":"coordinator.rehydrate(into:)","type":"codeVoice"},{"text":", and assert the live edit survives.","type":"text"}]}],"kind":"content"}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence"},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"anchor":"How-to-Guides","title":"How-to Guides"}],"variants":[{"paths":["\/documentation\/swidux\/howtoaddpersistence"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" macro — no hand-written "},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"references":{"doc://Swidux/documentation/Swidux/MacrosReference":{"url":"\/documentation\/swidux\/macrosreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","kind