:[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"role":"article","kind":"article","title":"Using the Swidux Agent Skill","url":"\/documentation\/swidux\/agentskill"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"role":"article","kind":"article","title":"Add a Version Killswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"title":"Persistence Middleware","kind":"article","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"url":"\/documentation\/swidux\/persistencemiddlewareguide","type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"role":"article","kind":"article","title":"Add a Paywall","url":"\/documentation\/swidux\/howtoaddapaywall"}}}