default the macro can invent. Give the property a default ("},{"type":"codeVoice","code":"= …"},{"type":"text","text":"), make it optional, or mark it "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" — otherwise "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" emits a compile-time error."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Relationships are generated optional"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"var tags: [TagModel]? = nil"},{"type":"text","text":"); a non-optional to-one "},{"type":"codeVoice","code":"@Relation"},{"type":"text","text":" is a compile-time error (CloudKit forbids non-optional relationships)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" blob columns"}]},{"type":"text","text":" default to "},{"type":"codeVoice","code":"Data()"},{"type":"text","text":", so any "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" type is CloudKit-safe through "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":". Because "},{"type":"codeVoice","code":"Data()"},{"type":"text","text":" is never decodable, a "},{"type":"strong","inlineContent":[{"type":"text","text":"non-optional"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" property must also carry a domain default ("},{"type":"codeVoice","code":"= …"},{"type":"text","text":") — the generated getter falls back to it when the blob is missing or undecodable (e.g. a row CloudKit materialized before the blob synced). Omitting the default is a compile-time error ("},{"type":"codeVoice","code":"inlineRequiresDefault"},{"type":"text","text":")."}]}]}]},{"type":"paragraph","inlineContent":[{"code":"@Persisted","type":"codeVoice"},{"text":" lives on the ","type":"text"},{"inlineContent":[{"type":"text","text":"entity"}],"type":"strong"},{"text":"; ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" lives on ","type":"text"},{"inlineContent":[{"type":"text","text":"state containers"}],"type":"strong"},{"text":" (","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" slices). They are different layers and never apply to the same type.","type":"text"}]},{"type":"heading","text":"Marker macros for non-trivial properties","level":3,"anchor":"Marker-macros-for-non-trivial-properties"},{"type":"paragraph","inlineContent":[{"text":"A macro can’t infer relationships, foreign keys, or which fields are derived. Four property markers (named to avoid SwiftData’s own ","type":"text"},{"code":"@Relationship","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"@Transient","type":"codeVoice"},{"text":") tell ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" what to do:","type":"text"}]},{"type":"codeListing","code":["@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","","    @Inline var styling: TextStyling = TextStyling()  \/\/ one opaque JSON Data column","    @ForeignKey var deckID: UUID                      \/\/ scalar parent reference","    @Relation(deleteRule: .cascade, inverse: \\TagModel.card)","    var tags: [Tag]                                   \/\/ SwiftData relationship","    @Ignored var renderedPreview: String?             \/\/ derived; omitted from the model","}"],"syntax":"swift"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Marker"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Effect"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"emphasis","inlineContent":[{"type":"text","text":"(none)"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Mirror the property directly (SwiftData persists scalars and "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" composites)."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"@Inline","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Force a "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" value into a single JSON "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" column (keeps a CloudKit record compact; sidesteps SwiftData "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":"-attribute edge cases)."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"@ForeignKey","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Intent marker on a "},{"code":"UUID","type":"codeVoice"},{"type":"text","text":"; functionally a mirrored scalar column."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"@Relation(deleteRule:inverse:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A SwiftData relationship to another "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" entity. The property’s type references the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"domain"}]},{"type":"text","text":" type ("},{"code":"[Tag]","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Tag?","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Tag","type":"codeVoice"},{"type":"text","text":"); the model substitutes the "},{"code":"…Model","type":"codeVoice"},{"type":"text","text":" shadow. "},{"code":"inverse","type":"codeVoice"},{"type":"text","text":" is a key path on the generated model, e.g. "},{"code":"\\TagModel.card","type":"codeVoice"},{"type":"text","text":". "},{"code":"deleteRule","type":"codeVoice"},{"type":"text","text":" is a "},{"code":"SwiduxDeleteRule","type":"codeVoice"},{"type":"text","text":" ("},{"code":".cascade","type":"codeVoice"},{"type":"text","text":", "},{"code":".nullify","type":"codeVoice"},{"type":"text","text":", "},{"code":".noAction","type":"codeVoice"},{"type":"text","text":", "},{"code":".deny","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"@Ignored","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Exclude a derived\/denormalized property. Must be optional so it can be reconstructed as "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" on load."}],"type":"paragraph"}]]],"header":"row"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":""},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" does not generate an "},{"code":"@Attribute(.unique)","type":"codeVoice"},{"type":"text","text":" on "},{"code":"id","type":"codeVoice"},{"type":"text","text":" — CloudKit forbids unique constraints. Identity is enforced by upsert-by-"},{"code":"id","type":"codeVoice"},{"type":"text","text":" inside "},{"code":"EntityDB","type":"codeVoice"},{"type":"text","text":", so the same generated model works for both local and synced containers."}],"type":"paragraph"}]},{"type":"heading","text":"Step 3: Put the `EntityStore` on your state","level":2,"anchor":"Step-3-Put-the-EntityStore-on-your-state"},{"type":"codeListing","code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var cards: EntityStore<Card> = .init()","    \/\/ ... your other slices","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Your reducers mutate ","type":"text"},{"code":"state.cards","type":"codeVoice"},{"text":" like any ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" — ","type":"text"},{"code":"state.cards[card.id] = card","type":"codeVoice"},{"text":", ","type":"text"},{"code":"state.cards.modify(id) { … }","type":"codeVoice"},{"text":", ","type":"text"},{"code":"state.cards[id] = nil","type":"codeVoice"},{"text":". Every change is recorded for the plugin to drain.","type":"text"}]},{"type":"heading","text":"Step 4: Build the coordinator and register the plugin","level":2,"anchor":"Step-4-Build-the-coordinator-and-register-the-plugin"},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":", build a local container, create a ","type":"text"},{"code":"PersistenceCoordinator","type":"codeVoice"},{"text":", register its plugin, and run first-load hydration before constructing the store:","type":"text"}]},{"type":"codeListing","code":["import SwiduxPersistence","","extension Store where State == AppState, Action == AppAction {","    static func configured() async -> AppStore {","        let container = try! ContainerFactory.makeLocalContainer(models: [CardModel.self])","","        let persistence = PersistenceCoordinator<AppState, AppAction>(","            entities: [.entity(\\.cards)],","            container: container,","            debounce: .milliseconds(250)","        )","","        let plugins = PluginHost<AppState, AppAction>()","        \/\/ Register UndoPlugin first if you use it — snapshots must precede writes.","        plugins.register(persistence.corePlugin)","","        var initial = AppState()","        await persistence.hydrate(into: &initial)   \/\/ first-load: fill EntityStores from disk","","        return Store(initialState: initial, reducer: { … }, plugins: plugins)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"hydrate(into:)","type":"codeVoice"},{"text":" is ","type":"text"},{"inlineContent":[{"type":"text","text":"first-load only"}],"type":"strong"},{"text":" — it replaces each ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" with the on-disk rows before any live edits exist. The only refresh path after launch is ","type":"text"},{"code":"rehydrate(into:)","type":"codeVoice"},{"text":", which always ","type":"text"},{"inlineContent":[{"type":"text","text":"merges"}],"type":"emphasis"},{"text":" (preferring in-memory values) so a “refresh from disk” can never clobber unflushed writes or in-progress UI edits.","type":"text"}]},{"type":"heading","text":"Surfacing failures","level":3,"anchor":"Surfacing-failures"},{"type":"paragraph","inlineContent":[{"text":"Every save and fetch failure is logged, and the coordinator accepts an optional ","type":"text"},{"code":"onFailure:","type":"codeVoice"},{"text":" handler to additionally surface it to your app (a failed ","type":"text"},{"inlineContent":[{"type":"text","text":"save"}],"type":"strong"},{"text":" means the in-memory data is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" on disk; a failed ","type":"text"},{"inlineContent":[{"type":"text","text":"hydrate fetch"}],"type":"strong"},{"text":" leaves that ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":" untouched rather than presenting an unreadable store as “no data”):","type":"text"}]},{"type":"codeListing","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    onFailure: { failure in","        \/\/ e.g. dispatch an action that shows a \"couldn't save\" banner","    }",")"],"syntax":"swift"},{"type":"heading","text":"Step 5: Flush on background","level":2,"anchor":"Step-5-Flush-on-background"},{"type":"paragraph","inlineContent":[{"text":"Writes are debounced, so drain them when the app is backgrounded or terminates:","type":"text"}]},{"type":"codeListing","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await persistence.corePlugin.flush() }","    }","}"],"syntax":"swift"},{"type":"heading","text":"Multiple entities and ordering","level":2,"anchor":"Multiple-entities-and-ordering"},{"type":"paragraph","inlineContent":[{"text":"Register one ","type":"text"},{"code":".entity(\\.keyPath)","type":"codeVoice"},{"text":" per ","type":"text"},{"i