ence","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"type":"topic","url":"\/documentation\/swidux\/howtoaddicloudsync","kind":"article","title":"Add iCloud Sync"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"type":"topic","url":"\/documentation\/swidux\/persistencemiddlewareguide","kind":"article","title":"Persistence Middleware"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"type":"topic","url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","title":"Add a Parental Gate"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"type":"topic","url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article","title":"Add Feature Flags"},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"type":"topic","u