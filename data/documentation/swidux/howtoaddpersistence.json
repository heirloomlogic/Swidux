{"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"Add Persistence"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence"},"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"],"title":"Related Documentation","anchor":"Related-Documentation"},{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides","anchor":"How-to-Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddpersistence"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" turns persistence into a declare-and-register concern. You annotate a domain entity with ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":"; the macro generates its SwiftData ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":" “shadow” class, the value↔model converters, and the ","type":"text"},{"type":"codeVoice","code":"PersistableEntity"},{"text":" conformance. A generic ","type":"text"},{"type":"codeVoice","code":"EntityDB"},{"text":" actor and a ","type":"text"},{"type":"codeVoice","code":"PersistenceCoordinator"},{"text":" build the container, synthesize one ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"text":" per registered ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"text":", and reuse the core ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true},{"text":" for debounced, batched writes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Your reducers mutate plain value-type entities inside an ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"text":"; the plugin observes the changelog and writes through to SwiftData after a debounce. Reads happen once, at launch, into memory — the in-memory ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"text":" is the source of truth.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For low-level manual wiring (writing your own ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":"), see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true},{"text":". For the macro details, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","isActive":true},{"text":". To add cross-device iCloud sync on top, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true},{"text":".","type":"text"}]},{"type":"heading","text":"Before you start","anchor":"Before-you-start","level":2},{"type":"paragraph","inlineContent":[{"text":"This guide assumes a Swidux app already exists — ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"AppStore"},{"text":" are wired and the store is in the SwiftUI environment. If not, follow ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"text":" first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" is a local-only persistence layer. It needs ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"no iCloud, CloudKit, or Push entitlements"}]},{"text":" — only the sandbox ","type":"text"},{"type":"codeVoice","code":"com.apple.security.network.client"},{"text":" entitlement if your app also makes network calls (killswitch, analytics, feature flags). Adding sync entitlements to a local-only app is dead configuration and an App Review risk.","type":"text"}]},{"type":"heading","text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency","level":2},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" product to your app target in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPersistence\",","    ]",")"]},{"type":"heading","text":"Step 2: Annotate your domain entity with `@Persisted`","anchor":"Step-2-Annotate-your-domain-entity-with-Persisted","level":2},{"type":"paragraph","inlineContent":[{"text":"A persisted entity is a value type that already satisfies ","type":"text"},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"ID == UUID"},{"text":" (the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"text":" contract). Add ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxPersistence","","@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","    var createdAt: Date","}"]},{"type":"paragraph","inlineContent":[{"text":"This generates a ","type":"text"},{"type":"codeVoice","code":"CardModel: @Model"},{"text":" class with ","type":"text"},{"type":"codeVoice","code":"init(from:)"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"toDomain()"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"update(from:)"},{"text":", plus ","type":"text"},{"type":"codeVoice","code":"extension Card: PersistableEntity { typealias Model = CardModel }"},{"text":". By default every stored property is mirrored directly onto the model — SwiftData persists scalars ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" composites natively, so no manual blob columns are needed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The generated model is "},{"type":"strong","inlineContent":[{"text":"CloudKit-safe by construction","type":"text"}]},{"type":"text","text":", so the "},{"type":"emphasis","inlineContent":[{"text":"same","type":"text"}]},{"type":"text","text":" model backs both the local and the synced container (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},{"type":"text","text":"). SwiftData’s CloudKit mirroring requires every non-optional attribute to be optional or carry a default value, and every relationship to be optional — validated when the "},{"type":"codeVoice","code":"ModelContainer"},{"type":"text","text":" is created. "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" satisfies this automatically:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Non-optional mirrored attributes get a default.","type":"text"}],"type":"strong"},{"text":" If you wrote one on the domain property (","type":"text"},{"code":"var count: Int = 0","type":"codeVoice"},{"text":"), it is propagated verbatim; otherwise the macro fills a canonical default for the known SwiftData primitives (","type":"text"},{"code":"String → \"\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Bool → false","type":"codeVoice"},{"text":", integers\/floats ","type":"text"},{"code":"→ 0","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Date → .distantPast","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Data → Data()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"UUID → UUID()","type":"codeVoice"},{"text":"). Defaults are inert locally — ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" overwrites them on every load.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Non-primitive, non-optional properties","type":"text"}],"type":"strong"},{"text":" (a custom ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" type, ","type":"text"},{"code":"URL","type":"codeVoice"},{"text":", an enum) have no default the macro can invent. Give the property a default (","type":"text"},{"code":"= …","type":"codeVoice"},{"text":"), make it optional, or mark it ","type":"text"},{"code":"@Inline","type":"codeVoice"},{"text":" — otherwise ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" emits a compile-time error.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Relationships are generated optional","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"code":"var tags: [TagModel]? = nil","type":"codeVoice"},{"text":"); a non-optional to-one ","type":"text"},{"code":"@Relation","type":"codeVoice"},{"text":" is a compile-time error (CloudKit forbids non-optional relationships).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"@Inline","type":"codeVoice"},{"text":" blob columns","type":"text"}],"type":"strong"},{"text":" default to ","type":"text"},{"code":"Data()","type":"codeVoice"},{"text":", so any ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" type is CloudKit-safe through ","type":"text"},{"code":"@Inline","type":"codeVoice"},{"text":". Because ","type":"text"},{"code":"Data()","type":"codeVoice"},{"text":" is never decodable, a ","type":"text"},{"inlineContent":[{"text":"non-optional","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"@Inline","type":"codeVoice"},{"text":" property must also carry a domain default (","type":"text"},{"code":"= …","type":"codeVoice"},{"text":") — the generated getter falls back to it when the blob is missing or undecodable (e.g. a row CloudKit materialized before the blob synced). Omitting the default is a compile-time error (","type":"text"},{"code":"inlineRequiresDefault","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" lives on the "},{"type":"strong","inlineContent":[{"text":"entity","type":"text"}]},{"type":"text","text":"; "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" lives on "},{"type":"strong","inlineContent":[{"text":"state containers","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" slices). They are different layers and never apply to the same type."}]},{"type":"heading","text":"Marker macros for non-trivial properties","anchor":"Marker-macros-for-non-trivial-properties","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A macro can’t infer relationships, foreign keys, or which fields are derived. Four property markers (named to avoid SwiftData’s own "},{"type":"codeVoice","code":"@Relationship"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"@Transient"},{"type":"text","text":") tell "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" what to do:"}]},{"syntax":"swift","type":"codeListing","code":["@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","","    @Inline var styling: TextStyling = TextStyling()  \/\/ one opaque JSON Data column","    @ForeignKey var deckID: UUID                      \/\/ scalar parent reference","    @Relation(deleteRule: .cascade, inverse: \\TagModel.card)","    var tags: [Tag]                                   \/\/ SwiftData relationship","    @Ignored var renderedPreview: String?             \/\/ derived; omitted from the model","}"]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Marker","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Effect","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"(none)","type":"text"}],"type":"emphasis"}]}],[{"type":"paragraph","inlineContent":[{"text":"Mirror the property directly (SwiftData persists scalars and ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" composites).","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"@Inline","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Force a ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" value into a single JSON ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" column (keeps a CloudKit record compact; sidesteps SwiftData ","type":"text"},{"code":"Codable","type":"codeVoice"},{"type":"text","text":"-attribute edge cases)."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"@ForeignKey","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Intent marker on a "},{"type":"codeVoice","code":"UUID"},{"text":"; functionally a mirrored scalar column.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"@Relation(deleteRule:inverse:)","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"A SwiftData relationship to another ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" entity. The property’s type references the ","type":"text"},{"inlineContent":[{"text":"domain","type":"text"}],"type":"emphasis"},{"text":" type (","type":"text"},{"code":"[Tag]","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Tag?"},{"text":" \/ ","type":"text"},{"code":"Tag","type":"codeVoice"},{"text":"); the model substitutes the ","type":"text"},{"type":"codeVoice","code":"…Model"},{"text":" shadow. ","type":"text"},{"code":"inverse","type":"codeVoice"},{"text":" is a key path on the generated model, e.g. ","type":"text"},{"code":"\\TagModel.card","type":"codeVoice"},{"text":". ","type":"text"},{"code":"deleteRule","type":"codeVoice"},{"type":"text","text":" is a "},{"code":"SwiduxDeleteRule","type":"codeVoice"},{"text":" (","type":"text"},{"code":".cascade","type":"codeVoice"},{"type":"text","text":", "},{"code":".nullify","type":"codeVoice"},{"type":"text","text":", "},{"code":".noAction","type":"codeVoice"},{"type":"text","text":", "},{"code":".deny","type":"codeVoice"},{"text":").","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"@Ignored","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Exclude a derived\/denormalized property. Must be optional so it can be reconstructed as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" on load.","type":"text"}]}]]]},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" does not generate an ","type":"text"},{"type":"codeVoice","code":"@Attribute(.unique)"},{"type":"text","text":" on "},{"type":"codeVoice","code":"id"},{"text":" — CloudKit forbids unique constraints — so the same generated model works for both local and synced containers. The cost is that rows sharing an ","type":"text"},{"code":"id","type":"codeVoice"},{"type":"text","text":" are possible. "},{"code":"EntityDB","type":"codeVoice"},{"type":"text","text":" handles them by converging rather than by assuming uniqueness: writes update every matching row, deletions remove every matching row, and "},{"type":"codeVoice","code":"fetchAll"},{"type":"text","text":" collapses to one value per "},{"type":"codeVoice","code":"id"},{"type":"text","text":". Nothing deletes a duplicate as a side effect of a write."}],"type":"paragraph"}]},{"anchor":"Step-3-Put-the-EntityStore-on-your-state","level":2,"type":"heading","text":"Step 3: Put the `EntityStore` on your state"},{"syntax":"swift","code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var cards: EntityStore<Card> = .init()","    \/\/ ... your other slices","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your reducers mutate "},{"type":"codeVoice","code":"state.cards"},{"type":"text","text":" like any "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":" — "},{"type":"codeVoice","code":"state.cards[card.id] = card"},{"type":"text","text":", "},{"type":"codeVoice","code":"state.cards.modify(id) { … }"},{"type":"text","text":", "},{"type":"codeVoice","code":"state.cards[id] = nil"},{"type":"text","text":". Every change is recorded for the plugin to drain."}]},{"level":2,"type":"heading","anchor":"Step-4-Build-the-coordinator-and-register-the-plugin","text":"Step 4: Build the coordinator and register the plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":", build a local container, create a "},{"code":"PersistenceCoordinator","type":"codeVoice"},{"type":"text","text":", register its plugin, and run first-load hydration before constructing the store:"}]},{"type":"codeListing","code":["import SwiduxPersistence","","extension Store where State == AppState, Action == AppAction {","    static func configured() async -> AppStore {","        let container = try! ContainerFactory.makeLocalContainer(models: [CardModel.self])","","        let persistence = PersistenceCoordinator<AppState, AppAction>(","            entities: [.entity(\\.cards)],","            container: container,","            debounce: .milliseconds(250)","        )","","        let plugins = PluginHost<AppState, AppAction>()","        \/\/ Register UndoPlugin first if you use it — snapshots must precede writes.","        plugins.register(persistence.corePlugin)","","        var initial = AppState()","        await persistence.hydrate(into: &initial)   \/\/ first-load: fill EntityStores from disk","","        return Store(initialState: initial, reducer: { … }, plugins: plugins)","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"hydrate(into:)"},{"type":"text","text":" is "},{"type":"strong","inlineContent":[{"type":"text","text":"first-load only"}]},{"type":"text","text":" — it replaces each "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" with the on-disk rows before any live edits exist. It takes "},{"type":"codeVoice","code":"inout State"},{"type":"text","text":" because it runs "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before the store is built"}]},{"type":"text","text":", so there is nothing to race with."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The only refresh path after launch is "},{"code":"rehydrate(into:)","type":"codeVoice"},{"type":"text","text":", which "},{"inlineContent":[{"type":"text","text":"reconciles"}],"type":"emphasis"},{"text":" rather than replaces: rows on disk are authoritative except for IDs that still carry unflushed local intent, which always win. So a “refresh from disk” can never clobber pending writes or in-progress UI edits, while remote edits and deletions still surface mid-session. Pass ","type":"text"},{"type":"codeVoice","code":"policy:"},{"text":" — or register an entity with ","type":"text"},{"type":"codeVoice","code":"policy:"},{"text":" — to narrow that; see ","type":"text"},{"type":"codeVoice","code":"MergePolicy"},{"type":"text","text":" and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It takes the "},{"type":"strong","inlineContent":[{"text":"store","type":"text"}]},{"type":"text","text":", not "},{"type":"codeVoice","code":"inout State"},{"type":"text","text":": re-hydration is asynchronous, and a caller holding a state snapshot across those "},{"type":"codeVoice","code":"await"},{"text":"s would discard everything dispatched while they were in flight. See ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"},{"text":" if edits are vanishing after a load.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you need to ","type":"text"},{"inlineContent":[{"text":"read","type":"text"}],"type":"emphasis"},{"type":"text","text":" rows without touching state, don’t re-hydrate into a throwaway "},{"type":"codeVoice","code":"AppState()"},{"type":"text","text":" — that idiom breaks silently the moment re-hydration starts reading the state it is handed. Use "},{"type":"codeVoice","code":"fetchAll(of:)"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"snapshot(of:)"},{"type":"text","text":" on the coordinator instead."}],"type":"paragraph"},{"anchor":"Reading-rows-without-touching-state","level":3,"type":"heading","text":"Reading rows without touching state"},{"inlineContent":[{"type":"text","text":"For exports, migrations, diagnostics, or any other “what’s actually on disk?” question, read directly — naming your domain type, not its generated shadow:"}],"type":"paragraph"},{"code":["let notes = try await persistence.fetchAll(of: Note.self)","let store = try await persistence.snapshot(of: Note.self)   \/\/ as an EntityStore"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Both flush the debounce window first by default, so they can’t return a stale row for something the user just edited; pass ","type":"text"},{"code":"flushPending: false","type":"codeVoice"},{"text":" on a hot path where that doesn’t matter. Both report failures to ","type":"text"},{"code":"onFailure","type":"codeVoice"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"text":" rethrow — there is no state to leave untouched here, so swallowing the error could only present an unreadable database as “no data”.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The entity does not have to be registered with the coordinator; reading a model that is in the container’s schema but not mirrored into state is fine.","type":"text"}],"type":"paragraph"},{"name":"Important","style":"important","content":[{"inlineContent":[{"type":"text","text":"Don’t answer these questions by re-hydrating into a throwaway "},{"type":"codeVoice","code":"AppState()"},{"type":"text","text":". That reads like a pure fetch but is really a merge, and it breaks silently the moment re-hydration starts consulting the state it is handed."}],"type":"paragraph"}],"type":"aside"},{"text":"Surfacing failures","level":3,"type":"heading","anchor":"Surfacing-failures"},{"inlineContent":[{"type":"text","text":"Every save and fetch failure is logged, and the coordinator accepts an optional "},{"code":"onFailure:","type":"codeVoice"},{"type":"text","text":" handler to additionally surface it to your app (a failed "},{"inlineContent":[{"text":"save","type":"text"}],"type":"strong"},{"type":"text","text":" means the in-memory data is "},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"type":"text","text":" on disk; a failed "},{"inlineContent":[{"text":"hydrate fetch","type":"text"}],"type":"strong"},{"type":"text","text":" leaves that "},{"code":"EntityStore","type":"codeVoice"},{"type":"text","text":" untouched rather than presenting an unreadable store as “no data”):"}],"type":"paragraph"},{"code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    onFailure: { failure in","        guard failure.isFinal else { return }   \/\/ earlier attempts may still succeed","        \/\/ e.g. dispatch an action that shows a \"couldn't save\" banner","    }",")"],"type":"codeListing","syntax":"swift"},{"text":"Retrying a failed save","level":3,"type":"heading","anchor":"Retrying-a-failed-save"},{"inlineContent":[{"type":"text","text":"A flush clears its buffers before the save runs, so a save that fails has nothing left to retry it — the write would reach disk only if the user happened to touch the same entity again. That is silent data loss, so the stack retries."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A failed batch goes "},{"inlineContent":[{"text":"back","type":"text"}],"type":"strong"},{"type":"text","text":" into the writer’s pending buffers, never over anything newer: a later edit to the same entity supersedes the restored value, and a deletion drained while the save was in flight cancels it. "},{"code":"PersistencePlugin","type":"codeVoice"},{"type":"text","text":" then re-attempts on a doubling backoff, independently of the debounce timer — a write has to land even if the user never touches the app again."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Retrying is bounded, because a write that can "},{"inlineContent":[{"text":"never","type":"text"}],"type":"emphasis"},{"type":"text","text":" succeed (disk full, a model the container can’t encode) must not keep the stack busy forever. Tune it with "},{"code":"retry:","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    retry: RetryPolicy(maxAttempts: 5, baseDelay: .milliseconds(500), maxDelay: .seconds(30)),","    onFailure: { failure in ... }",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"RetryPolicy.default","type":"codeVoice"},{"type":"text","text":" is that policy — five attempts over roughly seven seconds. "},{"code":"RetryPolicy.never","type":"codeVoice"},{"type":"text","text":" opts out of retrying without opting back into losing the write."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When the budget runs out you get one final "},{"code":"PersistenceFailure","type":"codeVoice"},{"type":"text","text":" with "},{"code":"isFinal == true","type":"codeVoice"},{"type":"text","text":". That is the one worth telling the user about: everything before it was “we’ll try again”. The batch is "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" discarded — it stays pending, so the next edit or an explicit "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" tries once more, and until then those IDs stay locally owned so a re-hydration can’t overwrite them with the stale stored row."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Every attempt is reported, so a handler that shows UI should gate on ","type":"text"},{"code":"isFinal","type":"codeVoice"},{"text":". Most ","type":"text"},{"code":".save","type":"codeVoice"},{"text":" failures are transient and are followed by a success the app never hears about.","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"text":"Diagnostics: what isn’t a failure","level":3,"type":"heading","anchor":"Diagnostics-what-isnt-a-failure"},{"inlineContent":[{"type":"text","text":"Some conditions are worth acting on but aren’t errors, so routing them through "},{"code":"onFailure","type":"codeVoice"},{"type":"text","text":" would be wrong. Duplicate rows are the clearest case: CloudKit forbids unique constraints, so several rows sharing an "},{"code":"id","type":"codeVoice"},{"type":"text","text":" are a legitimate on-disk state, not a fault. They go to "},{"code":"onDiagnostic:","type":"codeVoice"},{"type":"text","text":" instead:"}],"type":"paragraph"},{"code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards, collapse: EntityCollapse.byID { $0.updatedAt >= $1.updatedAt ? $0 : $1 })],","    container: container,","    onDiagnostic: { diagnostic in","        guard diagnostic.kind == .duplicateRowsCollapsed,","              let count = diagnostic.duplicateCount else { return }","        store.send(.offerDuplicateCleanup(count: count))","    }",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Three kinds ship today:"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Kind","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Means","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Payload","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".duplicateRowsCollapsed","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A read found rows sharing an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":". Without a ","type":"text"},{"code":"collapse:","type":"codeVoice"},{"text":" resolver they are harmless but permanent — this is what lets you ","type":"text"},{"inlineContent":[{"text":"offer","type":"text"}],"type":"emphasis"},{"text":" the cleanup.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"entityType","type":"codeVoice"},{"text":", ","type":"text"},{"code":"duplicateCount","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".possibleDispatchLoop","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"afterReduce","type":"codeVoice"},{"text":" fired far more often in one debounce interval than a user could cause. Usually an effect or plugin dispatching on every state change. Reported once per burst, not once per dispatch.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"drainCount","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".writesUnpersisted","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The set of IDs whose last flush failed changed. Fires again with an ","type":"text"},{"inlineContent":[{"text":"empty","type":"text"}],"type":"strong"},{"text":" set once they land, so an indicator can be cleared rather than guessed at.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"entityType","type":"codeVoice"},{"text":", ","type":"text"},{"code":"unpersistedIDs","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"code":"PersistenceDiagnostic","type":"codeVoice"},{"type":"text","text":" is a struct with static constructors rather than an enum, so a future kind can’t break an exhaustive "},{"code":"switch","type":"codeVoice"},{"type":"text","text":" in your code — match on "},{"code":"kind","type":"codeVoice"},{"type":"text","text":" and read the payload you expect. Duplicate reads and dispatch loops are logged whether or not you supply a handler; the unpersisted set has no log of its own, because the individual "},{"code":"PersistenceFailure","type":"codeVoice"},{"type":"text","text":"s behind it are already logged."}],"type":"paragraph"},{"text":"Step 5: Flush on background","level":2,"type":"heading","anchor":"Step-5-Flush-on-background"},{"inlineContent":[{"type":"text","text":"Writes are debounced, so drain them when the app is backgrounded or terminates:"}],"type":"paragraph"},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await persistence.corePlugin.flush() }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Multiple entities and ordering","level":2,"type":"heading","anchor":"Multiple-entities-and-ordering"},{"inlineContent":[{"type":"text","text":"Register one "},{"code":".entity(\\.keyPath)","type":"codeVoice"},{"type":"text","text":" per "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.decks), .entity(\\.cards), .entity(\\.tags)],","    container: try! ContainerFactory.makeLocalContainer(","        models: [DeckModel.self, CardModel.self, TagModel.self]","    )",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Pass every generated "},{"code":"…Model","type":"codeVoice"},{"type":"text","text":" type to the container’s "},{"code":"models:","type":"codeVoice"},{"type":"text","text":". Writers flush in registration order — if entity B holds a "},{"code":"@Relation","type":"codeVoice"},{"type":"text","text":" to A, register A’s entity first."}],"type":"paragraph"},{"text":"Testing","level":2,"type":"heading","anchor":"Testing"},{"inlineContent":[{"type":"text","text":"The whole stack runs against an in-memory SwiftData store, so persistence is unit-testable with no disk and no CloudKit:"}],"type":"paragraph"},{"code":["let container = try ContainerFactory.makeInMemoryContainer(models: [CardModel.self])","let db = EntityDB(modelContainer: container)","","try await db.upsert(Card(id: id, quote: \"hi\", createdAt: .now), as: CardModel.self)","let all = try await db.fetchAll(CardModel.self)","#expect(all.first?.quote == \"hi\")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"To prove the rule-#8 merge guarantee, seed the store, make a live in-memory edit, call "},{"code":"coordinator.rehydrate(into:)","type":"codeVoice"},{"type":"text","text":", and assert the live edit survives."}],"type":"paragraph"}]}],"references":{"doc://Swidux/documentation/Swidux/Troubleshooting":{"type":"topic","url":"\/documentation\/swidux\/troubleshooting","abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","kind":"article","role":"article","title":"Troubleshooting"},"doc://Swidux/documentation/Swidux/MacrosReference":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","title":"Macros","role":"article","url":"\/documentation\/swidux\/macrosreference","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":")."}]},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"type":"topic","url":"\/documentation\/swidux\/entitystoreguide","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","kind":"article","role":"article","title":"EntityStore"},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","url":"\/documentation\/swidux\/gettingstarted","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","kind":"article","role":"article","title":"Getting Started with Swidux"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"kind":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"title":"Add Feature Flags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"type":"topic","url":"\/documentation\/swidux\/howtoaddicloudsync","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","kind":"article","role":"article","title":"Add iCloud Sync"},"doc://Swidux/documentation/Swidux/PersistencePlugin":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","title":"PersistencePlugin","role":"symbol","navigatorTitle":[{"text":"PersistencePlugin","kind":"identifier"}],"url":"\/documentation\/swidux\/persistenceplugin","abstract":[{"type":"text","text":"Coalescing persistence plugin."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistencePlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux":{"type":"topic","url":"\/documentation\/swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","role":"collection","title":"Swidux"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","title":"Add Analytics","role":"article","url":"\/documentation\/swidux\/howtoaddanalytics","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}]},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"type":"topic","url":"\/documentation\/swidux\/persistencemiddlewareguide","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","kind":"article","role":"article","title":"Persistence Middleware"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","title":"Building a Domain Plugin","role":"article","url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}]},"doc://Swidux/documentation/Swidux/EntityStore":{"type":"topic","url":"\/documentation\/swidux\/entitystore","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"title":"EntityStore"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"abstract":[{"text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code.","type":"text"}],"kind":"article","type":"topic","title":"Cancel Effects","url":"\/documentation\/swidux\/howtocanceleffects","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","role":"article"},"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","title":"Using the Swidux Agent Skill","role":"article","url":"\/documentation\/swidux\/agentskill","abstract":[{"text":"Install the bundled ","type":"text"},{"type":"codeVoice","code":"swidux-ref"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","title":"Add a Parental Gate","role":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"kind":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","title":"Add a Version Killswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","role":"article","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}]}}}