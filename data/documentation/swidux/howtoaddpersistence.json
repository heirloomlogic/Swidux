{"variants":[{"paths":["\/documentation\/swidux\/howtoaddpersistence"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"],"anchor":"Related-Documentation"},{"generated":true,"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides"}],"abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Swidux"}],"title":"Add Persistence"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" turns persistence into a declare-and-register concern. You annotate a domain entity with ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":"; the macro generates its SwiftData ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" “shadow” class, the value↔model converters, and the ","type":"text"},{"code":"PersistableEntity","type":"codeVoice"},{"text":" conformance. A generic ","type":"text"},{"code":"EntityDB","type":"codeVoice"},{"text":" actor and a ","type":"text"},{"code":"PersistenceCoordinator","type":"codeVoice"},{"text":" build the container, synthesize one ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" per registered ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"text":", and reuse the core ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"text":" for debounced, batched writes.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your reducers mutate plain value-type entities inside an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":"; the plugin observes the changelog and writes through to SwiftData after a debounce. Reads happen once, at launch, into memory — the in-memory "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" is the source of truth."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For low-level manual wiring (writing your own "},{"code":"StateWriter","type":"codeVoice"},{"type":"text","text":" and "},{"code":"@Model","type":"codeVoice"},{"type":"text","text":"), see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},{"type":"text","text":". For the macro details, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"},{"type":"text","text":". To add cross-device iCloud sync on top, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},{"type":"text","text":"."}]},{"text":"Before you start","level":2,"type":"heading","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes a Swidux app already exists — ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"text":" are wired and the store is in the SwiftUI environment. If not, follow ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference","isActive":true},{"text":" first.","type":"text"}]},{"inlineContent":[{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" is a local-only persistence layer. It needs ","type":"text"},{"inlineContent":[{"type":"text","text":"no iCloud, CloudKit, or Push entitlements"}],"type":"strong"},{"text":" — only the sandbox ","type":"text"},{"code":"com.apple.security.network.client","type":"codeVoice"},{"text":" entitlement if your app also makes network calls (killswitch, analytics, feature flags). Adding sync entitlements to a local-only app is dead configuration and an App Review risk.","type":"text"}],"type":"paragraph"},{"text":"Step 1: Add the dependency","level":2,"anchor":"Step-1-Add-the-dependency","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":" product to your app target in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPersistence\",","    ]",")"]},{"text":"Step 2: Annotate your domain entity with `@Persisted`","level":2,"anchor":"Step-2-Annotate-your-domain-entity-with-Persisted","type":"heading"},{"inlineContent":[{"text":"A persisted entity is a value type that already satisfies ","type":"text"},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"ID == UUID"},{"text":" (the ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"text":" contract). Add ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiduxPersistence","","@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","    var createdAt: Date","}"]},{"inlineContent":[{"text":"This generates a ","type":"text"},{"code":"CardModel: @Model","type":"codeVoice"},{"text":" class with ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"toDomain()","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"update(from:)"},{"text":", plus ","type":"text"},{"type":"codeVoice","code":"extension Card: PersistableEntity { typealias Model = CardModel }"},{"text":". By default every stored property is mirrored directly onto the model — SwiftData persists scalars ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" composites natively, so no manual blob columns are needed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The generated model is "},{"type":"strong","inlineContent":[{"type":"text","text":"CloudKit-safe by construction"}]},{"type":"text","text":", so the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"type":"text","text":" model backs both the local and the synced container (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},{"type":"text","text":"). SwiftData’s CloudKit mirroring requires every non-optional attribute to be optional or carry a default value, and every relationship to be optional — validated when the "},{"type":"codeVoice","code":"ModelContainer"},{"type":"text","text":" is created. "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" satisfies this automatically:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Non-optional mirrored attributes get a default.","type":"text"}]},{"type":"text","text":" If you wrote one on the domain property ("},{"type":"codeVoice","code":"var count: Int = 0"},{"type":"text","text":"), it is propagated verbatim; otherwise the macro fills a canonical default for the known SwiftData primitives ("},{"type":"codeVoice","code":"String → \"\""},{"type":"text","text":", "},{"code":"Bool → false","type":"codeVoice"},{"text":", integers\/floats ","type":"text"},{"code":"→ 0","type":"codeVoice"},{"type":"text","text":", "},{"code":"Date → .distantPast","type":"codeVoice"},{"type":"text","text":", "},{"code":"Data → Data()","type":"codeVoice"},{"type":"text","text":", "},{"code":"UUID → UUID()","type":"codeVoice"},{"type":"text","text":"). Defaults are inert locally — "},{"code":"init(from:)","type":"codeVoice"},{"type":"text","text":" overwrites them on every load."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Non-primitive, non-optional properties"}],"type":"strong"},{"text":" (a custom ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" type, ","type":"text"},{"code":"URL","type":"codeVoice"},{"text":", an enum) have no default the macro can invent. Give the property a default (","type":"text"},{"code":"= …","type":"codeVoice"},{"text":"), make it optional, or mark it ","type":"text"},{"code":"@Inline","type":"codeVoice"},{"text":" — otherwise ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" emits a compile-time error.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Relationships are generated optional"}]},{"text":" (","type":"text"},{"code":"var tags: [TagModel]? = nil","type":"codeVoice"},{"text":"); a non-optional to-one ","type":"text"},{"code":"@Relation","type":"codeVoice"},{"type":"text","text":" is a compile-time error (CloudKit forbids non-optional relationships)."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" blob columns"}]},{"type":"text","text":" default to "},{"type":"codeVoice","code":"Data()"},{"type":"text","text":", so any "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" type is CloudKit-safe through "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":". Because "},{"type":"codeVoice","code":"Data()"},{"type":"text","text":" is never decodable, a "},{"type":"strong","inlineContent":[{"type":"text","text":"non-optional"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" property must also carry a domain default ("},{"type":"codeVoice","code":"= …"},{"type":"text","text":") — the generated getter falls back to it when the blob is missing or undecodable (e.g. a row CloudKit materialized before the blob synced). Omitting the default is a compile-time error ("},{"type":"codeVoice","code":"inlineRequiresDefault"},{"type":"text","text":")."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"code":"@Persisted","type":"codeVoice"},{"text":" lives on the ","type":"text"},{"type":"strong","inlineContent":[{"text":"entity","type":"text"}]},{"text":"; ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" lives on ","type":"text"},{"type":"strong","inlineContent":[{"text":"state containers","type":"text"}]},{"text":" (","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" slices). They are different layers and never apply to the same type.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Marker macros for non-trivial properties","anchor":"Marker-macros-for-non-trivial-properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A macro can’t infer relationships, foreign keys, or which fields are derived. Four property markers (named to avoid SwiftData’s own "},{"type":"codeVoice","code":"@Relationship"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"@Transient"},{"type":"text","text":") tell "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" what to do:"}]},{"type":"codeListing","syntax":"swift","code":["@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","","    @Inline var styling: TextStyling = TextStyling()  \/\/ one opaque JSON Data column","    @ForeignKey var deckID: UUID                      \/\/ scalar parent reference","    @Relation(deleteRule: .cascade, inverse: \\TagModel.card)","    var tags: [Tag]                                   \/\/ SwiftData relationship","    @Ignored var renderedPreview: String?             \/\/ derived; omitted from the model","}"]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Marker"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Effect"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"(none)","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Mirror the property directly (SwiftData persists scalars and "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" composites)."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@Inline"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Force a ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" value into a single JSON ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":" column (keeps a CloudKit record compact; sidesteps SwiftData ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":"-attribute edge cases).","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@ForeignKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Intent marker on a ","type":"text"},{"type":"codeVoice","code":"UUID"},{"type":"text","text":"; functionally a mirrored scalar column."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"@Relation(deleteRule:inverse:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A SwiftData relationship to another "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" entity. The property’s type references the "},{"inlineContent":[{"text":"domain","type":"text"}],"type":"emphasis"},{"type":"text","text":" type ("},{"code":"[Tag]","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Tag?","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Tag","type":"codeVoice"},{"type":"text","text":"); the model substitutes the "},{"code":"…Model","type":"codeVoice"},{"type":"text","text":" shadow. "},{"code":"inverse","type":"codeVoice"},{"type":"text","text":" is a key path on the generated model, e.g. "},{"code":"\\TagModel.card","type":"codeVoice"},{"type":"text","text":". "},{"code":"deleteRule","type":"codeVoice"},{"type":"text","text":" is a "},{"code":"SwiduxDeleteRule","type":"codeVoice"},{"type":"text","text":" ("},{"code":".cascade","type":"codeVoice"},{"type":"text","text":", "},{"code":".nullify","type":"codeVoice"},{"type":"text","text":", "},{"code":".noAction","type":"codeVoice"},{"type":"text","text":", "},{"code":".deny","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@Ignored"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Exclude a derived\/denormalized property. Must be optional so it can be reconstructed as ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" on load.","type":"text"}],"type":"paragraph"}]]]},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":""},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" does not generate an "},{"code":"@Attribute(.unique)","type":"codeVoice"},{"type":"text","text":" on "},{"code":"id","type":"codeVoice"},{"type":"text","text":" — CloudKit forbids unique constraints. Identity is enforced by upsert-by-"},{"code":"id","type":"codeVoice"},{"type":"text","text":" inside "},{"code":"EntityDB","type":"codeVoice"},{"type":"text","text":", so the same generated model works for both local and synced containers."}],"type":"paragraph"}],"type":"aside","style":"note"},{"anchor":"Step-3-Put-the-EntityStore-on-your-state","text":"Step 3: Put the `EntityStore` on your state","type":"heading","level":2},{"syntax":"swift","code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var cards: EntityStore<Card> = .init()","    \/\/ ... your other slices","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Your reducers mutate ","type":"text"},{"type":"codeVoice","code":"state.cards"},{"text":" like any ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"state.cards[card.id] = card"},{"text":", ","type":"text"},{"type":"codeVoice","code":"state.cards.modify(id) { … }"},{"text":", ","type":"text"},{"type":"codeVoice","code":"state.cards[id] = nil"},{"text":". Every change is recorded for the plugin to drain.","type":"text"}]},{"anchor":"Step-4-Build-the-coordinator-and-register-the-plugin","text":"Step 4: Build the coordinator and register the plugin","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":", build a local container, create a "},{"code":"PersistenceCoordinator","type":"codeVoice"},{"type":"text","text":", register its plugin, and run first-load hydration before constructing the store:"}]},{"code":["import SwiduxPersistence","","extension Store where State == AppState, Action == AppAction {","    static func configured() async -> AppStore {","        let container = try! ContainerFactory.makeLocalContainer(models: [CardModel.self])","","        let persistence = PersistenceCoordinator<AppState, AppAction>(","            entities: [.entity(\\.cards)],","            container: container,","            debounce: .milliseconds(250)","        )","","        let plugins = PluginHost<AppState, AppAction>()","        \/\/ Register UndoPlugin first if you use it — snapshots must precede writes.","        plugins.register(persistence.corePlugin)","","        var initial = AppState()","        await persistence.hydrate(into: &initial)   \/\/ first-load: fill EntityStores from disk","","        return Store(initialState: initial, reducer: { … }, plugins: plugins)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"hydrate(into:)","type":"codeVoice"},{"type":"text","text":" is "},{"inlineContent":[{"type":"text","text":"first-load only"}],"type":"strong"},{"type":"text","text":" — it replaces each "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"type":"text","text":" with the on-disk rows before any live edits exist. The only refresh path after launch is "},{"code":"rehydrate(into:)","type":"codeVoice"},{"type":"text","text":", which always "},{"inlineContent":[{"type":"text","text":"merges"}],"type":"emphasis"},{"type":"text","text":" (preferring in-memory values) so a “refresh from disk” can never clobber unflushed writes or in-progress UI edits."}]},{"anchor":"Surfacing-failures","text":"Surfacing failures","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Every save and fetch failure is logged, and the coordinator accepts an optional ","type":"text"},{"type":"codeVoice","code":"onFailure:"},{"text":" handler to additionally surface it to your app (a failed ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"save"}]},{"text":" means the in-memory data is ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"text":" on disk; a failed ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"hydrate fetch"}]},{"text":" leaves that ","type":"text"},{"type":"codeVoice","code":"EntityStore"},{"text":" untouched rather than presenting an unreadable store as “no data”):","type":"text"}]},{"code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    onFailure: { failure in","        \/\/ e.g. dispatch an action that shows a \"couldn't save\" banner","    }",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-5-Flush-on-background","text":"Step 5: Flush on background","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Writes are debounced, so drain them when the app is backgrounded or terminates:"}]},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await persistence.corePlugin.flush() }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Multiple entities and ordering","anchor":"Multiple-entities-and-ordering","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register one "},{"type":"codeVoice","code":".entity(\\.keyPath)"},{"type":"text","text":" per "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":":"}]},{"code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.decks), .entity(\\.cards), .entity(\\.tags)],","    container: try! ContainerFactory.makeLocalContainer(","        models: [DeckModel.self, CardModel.self, TagModel.self]","    )",")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass every generated "},{"type":"codeVoice","code":"…Model"},{"type":"text","text":" type to the container’s "},{"type":"codeVoice","code":"models:"},{"type":"text","text":". Writers flush in registration order — if entity B holds a "},{"type":"codeVoice","code":"@Relation"},{"type":"text","text":" to A, register A’s entity first."}]},{"level":2,"text":"Testing","anchor":"Testing","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The whole stack runs against an in-memory SwiftData store, so persistence is unit-testable with no disk and no CloudKit:"}]},{"code":["let container = try ContainerFactory.makeInMemoryContainer(models: [CardModel.self])","let db = EntityDB(modelContainer: container)","","try await db.upsert(Card(id: id, quote: \"hi\", createdAt: .now), as: CardModel.self)","let all = try await db.fetchAll(CardModel.self)","#expect(all.first?.quote == \"hi\")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To prove the rule-#8 merge guarantee, seed the store, make a live in-memory edit, call "},{"code":"coordinator.rehydrate(into:)","type":"codeVoice"},{"type":"text","text":", and assert the live edit survives."}]}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"role":"article","type":"topic","title":"Add Feature Flags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","kind":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}]},"doc://Swidux/documentation/Swidux/MacrosReference":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","title":"Macros","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":")."}],"url":"\/documentation\/swidux\/macrosreference","role":"article","type":"topic"},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","type":"topic","title":"Getting Started with Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","kind":"article","url":"\/documentation\/swidux\/gettingstarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}]},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","url":"\/documentation\/swidux\/howtocanceleffects","kind":"article","type":"topic","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"role":"article","title":"Cancel Effects"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","title":"Add iCloud Sync","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"url":"\/documentation\/swidux\/howtoaddicloudsync","role":"article","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","kind":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","title":"Add a Parental Gate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"title":"Add a Version Killswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"role":"article","type":"topic","title":"EntityStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","kind":"article","url":"\/documentation\/swidux\/entitystoreguide","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}]},"doc://Swidux/documentation/Swidux/EntityStore":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"topic","title":"EntityStore","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"EntityStore","ki