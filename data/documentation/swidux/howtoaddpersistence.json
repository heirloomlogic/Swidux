e":"strong"},{"text":" — it replaces each ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" with the on-disk rows before any live edits exist. The only refresh path after launch is ","type":"text"},{"type":"codeVoice","code":"rehydrate(into:)"},{"text":", which always ","type":"text"},{"inlineContent":[{"type":"text","text":"merges"}],"type":"emphasis"},{"text":" (preferring in-memory values) so a “refresh from disk” can never clobber unflushed writes or in-progress UI edits.","type":"text"}]},{"text":"Surfacing failures","type":"heading","level":3,"anchor":"Surfacing-failures"},{"type":"paragraph","inlineContent":[{"text":"Every save and fetch failure is logged, and the coordinator accepts an optional ","type":"text"},{"type":"codeVoice","code":"onFailure:"},{"text":" handler to additionally surface it to your app (a failed ","type":"text"},{"inlineContent":[{"type":"text","text":"save"}],"type":"strong"},{"text":" means the in-memory data is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" on disk; a failed ","type":"text"},{"inlineContent":[{"type":"text","text":"hydrate fetch"}],"type":"strong"},{"text":" leaves that ","type":"text"},{"type":"codeVoice","code":"EntityStore"},{"text":" untouched rather than presenting an unreadable store as “no data”):","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    onFailure: { failure in","        \/\/ e.g. dispatch an action that shows a \"couldn't save\" banner","    }",")"]},{"text":"Step 5: Flush on background","type":"heading","level":2,"anchor":"Step-5-Flush-on-background"},{"type":"paragraph","inlineContent":[{"text":"Writes are debounced, so drain them when the app is backgrounded or terminates:","type":"text"}]},{"syntax":"swift","type":"codeListi