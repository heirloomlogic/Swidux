he dependency","type":"heading","level":2,"anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" product to your app target in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPersistence\",","    ]",")"]},{"text":"Step 2: Annotate your domain entity with `@Persisted`","type":"heading","level":2,"anchor":"Step-2-Annotate-your-domain-entity-with-Persisted"},{"type":"paragraph","inlineContent":[{"text":"A persisted entity is a value type that already satisfies ","type":"text"},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"ID == UUID"},{"text":" (the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" contract). Add ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxPersistence","","@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","    var createdAt: Date","}"]},{"type":"paragraph","inlineContent":[{"text":"This generates a ","type":"text"},{"type":"codeVoice","code":"CardModel: @Model"},{"text":" class with ","type":"text"},{"type":"codeVoice","code":"init(from:)"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"toDomain()"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"update(from:)"},{"text":", plus ","type":"text"},{"type":"codeVoice","code":"extension Card: PersistableEntity { typealias Model = CardModel }"},{"text":". By default every stored property is mirrored directly onto the model — SwiftData persists scalars ","type":"text"},{"i