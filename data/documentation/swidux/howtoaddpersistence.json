codeVoice","code":"init(from:)"},{"type":"text","text":" overwrites them on every load."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Non-primitive, non-optional properties"}],"type":"strong"},{"type":"text","text":" (a custom "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" type, "},{"type":"codeVoice","code":"URL"},{"type":"text","text":", an enum) have no default the macro can invent. Give the property a default ("},{"type":"codeVoice","code":"= …"},{"type":"text","text":"), make it optional, or mark it "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" — otherwise "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" emits a compile-time error."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Relationships are generated optional"}],"type":"strong"},{"type":"text","text":" ("},{"type":"codeVoice","code":"var tags: [TagModel]? = nil"},{"type":"text","text":"); a non-optional to-one "},{"type":"codeVoice","code":"@Relation"},{"type":"text","text":" is a compile-time error (CloudKit forbids non-optional relationships)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" blob columns"}],"type":"strong"},{"type":"text","text":" default to "},{"type":"codeVoice","code":"Data()"},{"type":"text","text":", so any "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" type is CloudKit-safe through "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":". Because "},{"type":"codeVoice","code":"Data()"},{"type":"text","text":" is never decodable, a "},{"inlineContent":[{"type":"text","text":"non-optional"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" property must also carry a domain default ("},{"type":"codeVoice","code":"= …"},{"type":"text","text":") — the generated getter falls back to it when the blob is missing or undecodable (e.g. a row CloudKit materialized before the blob synced). Omitting the default is a compile-time error ("},{"type":"codeVoice","code":"inlineRequiresDefault"},{"type":"text","text":")."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Persisted"},{"text":" lives on the ","type":"text"},{"inlineContent":[{"type":"text","text":"entity"}],"type":"strong"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" lives on ","type":"text"},{"inlineContent":[{"type":"text","text":"state containers"}],"type":"strong"},{"text":" (","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" slices). They are different layers and never apply to the same type.","type":"text"}]},{"text":"Marker macros for non-trivial properties","type":"heading","level":3,"anchor":"Marker-macros-for-non-trivial-properties"},{"type":"paragraph","inlineContent":[{"text":"A macro can’t infer relationships, foreign keys, or which fields are derived. Four property markers (named to avoid SwiftData’s own ","type":"text"},{"type":"codeVoice","code":"@Relationship"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"@Transient"},{"text":") tell ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" what to do:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","","    @Inline var styling: TextStyling = TextStyling()  \/\/ one opaque JSON Data column","    @ForeignKey var deckID: UUID                      \/\/ scalar parent reference","    @Relation(deleteRule: .cascade, inverse: \\TagModel.card)","    var tags: [Tag]                                   \/\/ SwiftData relationship","    @Ignored var renderedPreview: String?             \/\/ derived; omitted from the model","}"]},{"type":"ta