{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence"},"abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides","anchor":"How-to-Guides","generated":true}],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"Add Persistence","role":"article","roleHeading":"Article","modules":[{"name":"Swidux"}]},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" turns persistence into a declare-and-register concern. You annotate a domain entity with ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":"; the macro generates its SwiftData ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" “shadow” class, the value↔model converters, and the ","type":"text"},{"code":"PersistableEntity","type":"codeVoice"},{"text":" conformance. A generic ","type":"text"},{"code":"EntityDB","type":"codeVoice"},{"text":" actor and a ","type":"text"},{"code":"PersistenceCoordinator","type":"codeVoice"},{"text":" build the container, synthesize one ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" per registered ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":", and reuse the core ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"text":" for debounced, batched writes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Your reducers mutate plain value-type entities inside an ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"text":"; the plugin observes the changelog and writes through to SwiftData after a debounce. Reads happen once, at launch, into memory — the in-memory ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"text":" is the source of truth.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For low-level manual wiring (writing your own ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":"), see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"reference","isActive":true},{"text":". For the macro details, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","type":"reference","isActive":true},{"text":". To add cross-device iCloud sync on top, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"heading","level":2,"text":"Before you start","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes a Swidux app already exists — ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" are wired and the store is in the SwiftUI environment. If not, follow "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" is a local-only persistence layer. It needs "},{"type":"strong","inlineContent":[{"text":"no iCloud, CloudKit, or Push entitlements","type":"text"}]},{"type":"text","text":" — only the sandbox "},{"type":"codeVoice","code":"com.apple.security.network.client"},{"type":"text","text":" entitlement if your app also makes network calls (killswitch, analytics, feature flags). Adding sync entitlements to a local-only app is dead configuration and an App Review risk."}]},{"type":"heading","level":2,"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPersistence\",","    ]",")"]},{"type":"heading","level":2,"text":"Step 2: Annotate your domain entity with `@Persisted`","anchor":"Step-2-Annotate-your-domain-entity-with-Persisted"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A persisted entity is a value type that already satisfies "},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"type":"text","text":" with "},{"type":"codeVoice","code":"ID == UUID"},{"type":"text","text":" (the "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" contract). Add "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxPersistence","","@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","    var createdAt: Date","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This generates a "},{"type":"codeVoice","code":"CardModel: @Model"},{"type":"text","text":" class with "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"toDomain()"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"update(from:)"},{"type":"text","text":", plus "},{"type":"codeVoice","code":"extension Card: PersistableEntity { typealias Model = CardModel }"},{"type":"text","text":". By default every stored property is mirrored directly onto the model — SwiftData persists scalars "},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" composites natively, so no manual blob columns are needed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The generated model is "},{"type":"strong","inlineContent":[{"text":"CloudKit-safe by construction","type":"text"}]},{"type":"text","text":", so the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"type":"text","text":" model backs both the local and the synced container (see "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"reference"},{"type":"text","text":"). SwiftData’s CloudKit mirroring requires every non-optional attribute to be optional or carry a default value, and every relationship to be optional — validated when the "},{"code":"ModelContainer","type":"codeVoice"},{"type":"text","text":" is created. "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" satisfies this automatically:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Non-optional mirrored attributes get a default.","type":"text"}],"type":"strong"},{"text":" If you wrote one on the domain property (","type":"text"},{"type":"codeVoice","code":"var count: Int = 0"},{"text":"), it is propagated verbatim; otherwise the macro fills a canonical default for the known SwiftData primitives (","type":"text"},{"type":"codeVoice","code":"String → \"\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"Bool → false"},{"text":", integers\/floats ","type":"text"},{"type":"codeVoice","code":"→ 0"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Date → .distantPast"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Data → Data()"},{"text":", ","type":"text"},{"type":"codeVoice","code":"UUID → UUID()"},{"text":"). Defaults are inert locally — ","type":"text"},{"type":"codeVoice","code":"init(from:)"},{"text":" overwrites them on every load.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Non-primitive, non-optional properties","type":"text"}],"type":"strong"},{"text":" (a custom ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" type, ","type":"text"},{"type":"codeVoice","code":"URL"},{"text":", an enum) have no default the macro can invent. Give the property a default (","type":"text"},{"type":"codeVoice","code":"= …"},{"text":"), make it optional, or mark it ","type":"text"},{"type":"codeVoice","code":"@Inline"},{"text":" — otherwise ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" emits a compile-time error.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Relationships are generated optional","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"type":"codeVoice","code":"var tags: [TagModel]? = nil"},{"text":"); a non-optional to-one ","type":"text"},{"type":"codeVoice","code":"@Relation"},{"text":" is a compile-time error (CloudKit forbids non-optional relationships).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"@Inline","type":"codeVoice"},{"text":" blob columns","type":"text"}],"type":"strong"},{"text":" default to ","type":"text"},{"type":"codeVoice","code":"Data()"},{"text":", so any ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" type is CloudKit-safe through ","type":"text"},{"code":"@Inline","type":"codeVoice"},{"text":". Because ","type":"text"},{"code":"Data()","type":"codeVoice"},{"text":" is never decodable, a ","type":"text"},{"inlineContent":[{"text":"non-optional","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@Inline"},{"text":" property must also carry a domain default (","type":"text"},{"type":"codeVoice","code":"= …"},{"text":") — the generated getter falls back to it when the blob is missing or undecodable (e.g. a row CloudKit materialized before the blob synced). Omitting the default is a compile-time error (","type":"text"},{"type":"codeVoice","code":"inlineRequiresDefault"},{"text":").","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" lives on the "},{"type":"strong","inlineContent":[{"text":"entity","type":"text"}]},{"type":"text","text":"; "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" lives on "},{"inlineContent":[{"type":"text","text":"state containers"}],"type":"strong"},{"text":" (","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" slices). They are different layers and never apply to the same type."}]},{"type":"heading","level":3,"text":"Marker macros for non-trivial properties","anchor":"Marker-macros-for-non-trivial-properties"},{"type":"paragraph","inlineContent":[{"text":"A macro can’t infer relationships, foreign keys, or which fields are derived. Four property markers (named to avoid SwiftData’s own ","type":"text"},{"code":"@Relationship","type":"codeVoice"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"@Transient"},{"type":"text","text":") tell "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" what to do:"}]},{"syntax":"swift","code":["@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","","    @Inline var styling: TextStyling = TextStyling()  \/\/ one opaque JSON Data column","    @ForeignKey var deckID: UUID                      \/\/ scalar parent reference","    @Relation(deleteRule: .cascade, inverse: \\TagModel.card)","    var tags: [Tag]                                   \/\/ SwiftData relationship","    @Ignored var renderedPreview: String?             \/\/ derived; omitted from the model","}"],"type":"codeListing"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Marker"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Effect"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"(none)"}],"type":"emphasis"}]}],[{"type":"paragraph","inlineContent":[{"text":"Mirror the property directly (SwiftData persists scalars and ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" composites).","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Inline"}]}],[{"inlineContent":[{"type":"text","text":"Force a "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" value into a single JSON "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" column (keeps a CloudKit record compact; sidesteps SwiftData "},{"type":"codeVoice","code":"Codable"},{"text":"-attribute edge cases).","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@ForeignKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Intent marker on a "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":"; functionally a mirrored scalar column."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@Relation(deleteRule:inverse:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"A SwiftData relationship to another ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" entity. The property’s type references the ","type":"text"},{"inlineContent":[{"type":"text","text":"domain"}],"type":"emphasis"},{"text":" type (","type":"text"},{"type":"codeVoice","code":"[Tag]"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Tag?"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Tag"},{"text":"); the model substitutes the ","type":"text"},{"type":"codeVoice","code":"…Model"},{"text":" shadow. ","type":"text"},{"type":"codeVoice","code":"inverse"},{"text":" is a key path on the generated model, e.g. ","type":"text"},{"type":"codeVoice","code":"\\TagModel.card"},{"text":". ","type":"text"},{"type":"codeVoice","code":"deleteRule"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"SwiduxDeleteRule"},{"text":" (","type":"text"},{"type":"codeVoice","code":".cascade"},{"text":", ","type":"text"},{"type":"codeVoice","code":".nullify"},{"text":", ","type":"text"},{"type":"codeVoice","code":".noAction"},{"text":", ","type":"text"},{"type":"codeVoice","code":".deny"},{"text":").","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Ignored"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Exclude a derived\/denormalized property. Must be optional so it can be reconstructed as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" on load."}]}]]],"type":"table"},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" does not generate an "},{"type":"codeVoice","code":"@Attribute(.unique)"},{"type":"text","text":" on "},{"type":"codeVoice","code":"id"},{"type":"text","text":" — CloudKit forbids unique constraints. Identity is enforced by upsert-by-"},{"type":"codeVoice","code":"id"},{"type":"text","text":" inside "},{"type":"codeVoice","code":"EntityDB"},{"type":"text","text":", so the same generated model works for both local and synced containers."}],"type":"paragraph"}]},{"anchor":"Step-3-Put-the-EntityStore-on-your-state","level":2,"type":"heading","text":"Step 3: Put the `EntityStore` on your state"},{"syntax":"swift","code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var cards: EntityStore<Card> = .init()","    \/\/ ... your other slices","}"],"type":"codeListing"},{"inlineContent":[{"text":"Your reducers mutate ","type":"text"},{"type":"codeVoice","code":"state.cards"},{"text":" like any ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"text":" — ","type":"text"},{"type":"codeVoice","code":"state.cards[card.id] = card"},{"text":", ","type":"text"},{"type":"codeVoice","code":"state.cards.modify(id) { … }"},{"text":", ","type":"text"},{"type":"codeVoice","code":"state.cards[id] = nil"},{"text":". Every change is recorded for the plugin to drain.","type":"text"}],"type":"paragraph"},{"anchor":"Step-4-Build-the-coordinator-and-register-the-plugin","text":"Step 4: Build the coordinator and register the plugin","type":"heading","level":2},{"inlineContent":[{"text":"In ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":", build a local container, create a ","type":"text"},{"type":"codeVoice","code":"PersistenceCoordinator"},{"text":", register its plugin, and run first-load hydration before constructing the store:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxPersistence","","extension Store where State == AppState, Action == AppAction {","    static func configured() async -> AppStore {","        let container = try! ContainerFactory.makeLocalContainer(models: [CardModel.self])","","        let persistence = PersistenceCoordinator<AppState, AppAction>(","            entities: [.entity(\\.cards)],","            container: container,","            debounce: .milliseconds(250)","        )","","        let plugins = PluginHost<AppState, AppAction>()","        \/\/ Register UndoPlugin first if you use it — snapshots must precede writes.","        plugins.register(persistence.corePlugin)","","        var initial = AppState()","        await persistence.hydrate(into: &initial)   \/\/ first-load: fill EntityStores from disk","","        return Store(initialState: initial, reducer: { … }, plugins: plugins)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"hydrate(into:)"},{"text":" is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"first-load only"}]},{"text":" — it replaces each ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"text":" with the on-disk rows before any live edits exist. The only refresh path after launch is ","type":"text"},{"type":"codeVoice","code":"rehydrate(into:)"},{"text":", which always ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"merges"}]},{"text":" (preferring in-memory values) so a “refresh from disk” can never clobber unflushed writes or in-progress UI edits.","type":"text"}],"type":"paragraph"},{"anchor":"Surfacing-failures","text":"Surfacing failures","type":"heading","level":3},{"inlineContent":[{"text":"Every save and fetch failure is logged, and the coordinator accepts an optional ","type":"text"},{"type":"codeVoice","code":"onFailure:"},{"type":"text","text":" handler to additionally surface it to your app (a failed "},{"type":"strong","inlineContent":[{"text":"save","type":"text"}]},{"type":"text","text":" means the in-memory data is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" on disk; a failed "},{"type":"strong","inlineContent":[{"text":"hydrate fetch","type":"text"}]},{"type":"text","text":" leaves that "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":" untouched rather than presenting an unreadable store as “no data”):"}],"type":"paragraph"},{"syntax":"swift","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    onFailure: { failure in","        \/\/ e.g. dispatch an action that shows a \"couldn't save\" banner","    }",")"],"type":"codeListing"},{"type":"heading","text":"Step 5: Flush on background","anchor":"Step-5-Flush-on-background","level":2},{"type":"paragraph","inlineContent":[{"text":"Writes are debounced, so drain them when the app is backgrounded or terminates:","type":"text"}]},{"type":"codeListing","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await persistence.corePlugin.flush() }","    }","}"],"syntax":"swift"},{"type":"heading","text":"Multiple entities and ordering","anchor":"Multiple-entities-and-ordering","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register one "},{"type":"codeVoice","code":".entity(\\.keyPath)"},{"type":"text","text":" per "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"text":":","type":"text"}]},{"type":"codeListing","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.decks), .entity(\\.cards), .entity(\\.tags)],","    container: try! ContainerFactory.makeLocalContainer(","        models: [DeckModel.self, CardModel.self, TagModel.self]","    )",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass every generated "},{"code":"…Model","type":"codeVoice"},{"type":"text","text":" type to the container’s "},{"type":"codeVoice","code":"models:"},{"text":". Writers flush in registration order — if entity B holds a ","type":"text"},{"type":"codeVoice","code":"@Relation"},{"text":" to A, register A’s entity first.","type":"text"}]},{"text":"Testing","level":2,"type":"heading","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"The whole stack runs against an in-memory SwiftData store, so persistence is unit-testable with no disk and no CloudKit:","type":"text"}]},{"code":["let container = try ContainerFactory.makeInMemoryContainer(models: [CardModel.self])","let db = EntityDB(modelContainer: container)","","try await db.upsert(Card(id: id, quote: \"hi\", createdAt: .now), as: CardModel.self)","let all = try await db.fetchAll(CardModel.self)","#expect(all.first?.quote == \"hi\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"To prove the rule-#8 merge guarantee, seed the store, make a live in-memory edit, call ","type":"text"},{"code":"coordinator.rehydrate(into:)","type":"codeVoice"},{"text":", and assert the live edit survives.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddpersistence"]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"url":"\/documentation\/swidux\/howtoaddfeatureflags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeat