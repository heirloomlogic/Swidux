{"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" turns persistence into a declare-and-register concern. You annotate a domain entity with ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":"; the macro generates its SwiftData ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":" “shadow” class, the value↔model converters, and the ","type":"text"},{"type":"codeVoice","code":"PersistableEntity"},{"text":" conformance. A generic ","type":"text"},{"type":"codeVoice","code":"EntityDB"},{"text":" actor and a ","type":"text"},{"type":"codeVoice","code":"PersistenceCoordinator"},{"text":" build the container, synthesize one ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" per registered ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":", and reuse the core ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"text":" for debounced, batched writes.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your reducers mutate plain value-type entities inside an "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":"; the plugin observes the changelog and writes through to SwiftData after a debounce. Reads happen once, at launch, into memory — the in-memory "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" is the source of truth."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For low-level manual wiring (writing your own "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Model"},{"text":"), see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true},{"text":". For the macro details, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","isActive":true},{"text":". To add cross-device iCloud sync on top, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true},{"type":"text","text":"."}]},{"level":2,"text":"Before you start","type":"heading","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes a Swidux app already exists — "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"text":" are wired and the store is in the SwiftUI environment. If not, follow ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"text":" first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" is a local-only persistence layer. It needs ","type":"text"},{"inlineContent":[{"type":"text","text":"no iCloud, CloudKit, or Push entitlements"}],"type":"strong"},{"text":" — only the sandbox ","type":"text"},{"code":"com.apple.security.network.client","type":"codeVoice"},{"text":" entitlement if your app also makes network calls (killswitch, analytics, feature flags). Adding sync entitlements to a local-only app is dead configuration and an App Review risk.","type":"text"}]},{"level":2,"text":"Step 1: Add the dependency","type":"heading","anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" product to your app target in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPersistence\",","    ]",")"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Step 2: Annotate your domain entity with `@Persisted`","type":"heading","anchor":"Step-2-Annotate-your-domain-entity-with-Persisted"},{"type":"paragraph","inlineContent":[{"text":"A persisted entity is a value type that already satisfies ","type":"text"},{"code":"Identifiable & Equatable & Sendable","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"ID == UUID","type":"codeVoice"},{"text":" (the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" contract). Add ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["import SwiduxPersistence","","@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","    var createdAt: Date","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This generates a ","type":"text"},{"code":"CardModel: @Model","type":"codeVoice"},{"text":" class with ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"toDomain()","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"update(from:)","type":"codeVoice"},{"text":", plus ","type":"text"},{"code":"extension Card: PersistableEntity { typealias Model = CardModel }","type":"codeVoice"},{"text":". By default every stored property is mirrored directly onto the model — SwiftData persists scalars ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" composites natively, so no manual blob columns are needed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The generated model is ","type":"text"},{"inlineContent":[{"type":"text","text":"CloudKit-safe by construction"}],"type":"strong"},{"text":", so the ","type":"text"},{"inlineContent":[{"type":"text","text":"same"}],"type":"emphasis"},{"text":" model backs both the local and the synced container (see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},{"text":"). SwiftData’s CloudKit mirroring requires every non-optional attribute to be optional or carry a default value, and every relationship to be optional — validated when the ","type":"text"},{"code":"ModelContainer","type":"codeVoice"},{"text":" is created. ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" satisfies this automatically:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Non-optional mirrored attributes get a default."}],"type":"strong"},{"text":" If you wrote one on the domain property (","type":"text"},{"code":"var count: Int = 0","type":"codeVoice"},{"text":"), it is propagated verbatim; otherwise the macro fills a canonical default for the known SwiftData primitives (","type":"text"},{"code":"String → \"\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Bool → false","type":"codeVoice"},{"text":", integers\/floats ","type":"text"},{"code":"→ 0","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Date → .distantPast","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Data → Data()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"UUID → UUID()","type":"codeVoice"},{"text":"). Defaults are inert locally — ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" overwrites them on every load.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Non-primitive, non-optional properties"}],"type":"strong"},{"text":" (a custom ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" type, ","type":"text"},{"code":"URL","type":"codeVoice"},{"text":", an enum) have no default the macro can invent. Give the property a default (","type":"text"},{"code":"= …","type":"codeVoice"},{"text":"), make it optional, or mark it ","type":"text"},{"code":"@Inline","type":"codeVoice"},{"text":" — otherwise ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" emits a compile-time error.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Relationships are generated optional"}],"type":"strong"},{"text":" (","type":"text"},{"code":"var tags: [TagModel]? = nil","type":"codeVoice"},{"text":"); a non-optional to-one ","type":"text"},{"code":"@Relation","type":"codeVoice"},{"text":" is a compile-time error (CloudKit forbids non-optional relationships).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" blob columns"}],"type":"strong"},{"text":" default to ","type":"text"},{"code":"Data()","type":"codeVoice"},{"text":", so any ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" type is CloudKit-safe through ","type":"text"},{"code":"@Inline","type":"codeVoice"},{"text":". Because ","type":"text"},{"code":"Data()","type":"codeVoice"},{"text":" is never decodable, a ","type":"text"},{"inlineContent":[{"type":"text","text":"non-optional"}],"type":"strong"},{"text":" ","type":"text"},{"code":"@Inline","type":"codeVoice"},{"text":" property must also carry a domain default (","type":"text"},{"code":"= …","type":"codeVoice"},{"text":") — the generated getter falls back to it when the blob is missing or undecodable (e.g. a row CloudKit materialized before the blob synced). Omitting the default is a compile-time error (","type":"text"},{"code":"inlineRequiresDefault","type":"codeVoice"},{"text":").","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"code":"@Persisted","type":"codeVoice"},{"text":" lives on the ","type":"text"},{"inlineContent":[{"type":"text","text":"entity"}],"type":"strong"},{"text":"; ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" lives on ","type":"text"},{"inlineContent":[{"type":"text","text":"state containers"}],"type":"strong"},{"text":" (","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" slices). They are different layers and never apply to the same type.","type":"text"}]},{"level":3,"text":"Marker macros for non-trivial properties","type":"heading","anchor":"Marker-macros-for-non-trivial-properties"},{"type":"paragraph","inlineContent":[{"text":"A macro can’t infer relationships, foreign keys, or which fields are derived. Four property markers (named to avoid SwiftData’s own ","type":"text"},{"code":"@Relationship","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"@Transient","type":"codeVoice"},{"text":") tell ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" what to do:","type":"text"}]},{"code":["@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","","    @Inline var styling: TextStyling = TextStyling()  \/\/ one opaque JSON Data column","    @ForeignKey var deckID: UUID                      \/\/ scalar parent reference","    @Relation(deleteRule: .cascade, inverse: \\TagModel.card)","    var tags: [Tag]                                   \/\/ SwiftData relationship","    @Ignored var renderedPreview: String?             \/\/ derived; omitted from the model","}"],"type":"codeListing","syntax":"swift"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Marker"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Effect"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"(none)","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Mirror the property directly (SwiftData persists scalars and "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" composites)."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@Inline"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Force a "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" value into a single JSON "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" column (keeps a CloudKit record compact; sidesteps SwiftData "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":"-attribute edge cases)."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@ForeignKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Intent marker on a "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":"; functionally a mirrored scalar column."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@Relation(deleteRule:inverse:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A SwiftData relationship to another "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" entity. The property’s type references the "},{"type":"emphasis","inlineContent":[{"text":"domain","type":"text"}]},{"type":"text","text":" type ("},{"type":"codeVoice","code":"[Tag]"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Tag?"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Tag"},{"type":"text","text":"); the model substitutes the "},{"type":"codeVoice","code":"…Model"},{"type":"text","text":" shadow. "},{"type":"codeVoice","code":"inverse"},{"type":"text","text":" is a key path on the generated model, e.g. "},{"type":"codeVoice","code":"\\TagModel.card"},{"type":"text","text":". "},{"type":"codeVoice","code":"deleteRule"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"SwiduxDeleteRule"},{"type":"text","text":" ("},{"type":"codeVoice","code":".cascade"},{"type":"text","text":", "},{"type":"codeVoice","code":".nullify"},{"type":"text","text":", "},{"type":"codeVoice","code":".noAction"},{"type":"text","text":", "},{"type":"codeVoice","code":".deny"},{"type":"text","text":")."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@Ignored"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Exclude a derived\/denormalized property. Must be optional so it can be reconstructed as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" on load."}],"type":"paragraph"}]]],"type":"table"},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" does not generate an "},{"type":"codeVoice","code":"@Attribute(.unique)"},{"type":"text","text":" on "},{"type":"codeVoice","code":"id"},{"type":"text","text":" — CloudKit forbids unique constraints. Identity is enforced by upsert-by-"},{"type":"codeVoice","code":"id"},{"type":"text","text":" inside "},{"type":"codeVoice","code":"EntityDB"},{"type":"text","text":", so the same generated model works for both local and synced containers."}],"type":"paragraph"}]},{"level":2,"text":"Step 3: Put the `EntityStore` on your state","type":"heading","anchor":"Step-3-Put-the-EntityStore-on-your-state"},{"code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var cards: EntityStore<Card> = .init()","    \/\/ ... your other slices","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Your reducers mutate ","type":"text"},{"code":"state.cards","type":"codeVoice"},{"text":" like any ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" — ","type":"text"},{"code":"state.cards[card.id] = card","type":"codeVoice"},{"text":", ","type":"text"},{"code":"state.cards.modify(id) { … }","type":"codeVoice"},{"text":", ","type":"text"},{"code":"state.cards[id] = nil","type":"codeVoice"},{"text":". Every change is recorded for the plugin to drain.","type":"text"}]},{"level":2,"text":"Step 4: Build the coordinator and register the plugin","type":"heading","anchor":"Step-4-Build-the-coordinator-and-register-the-plugin"},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":", build a local container, create a ","type":"text"},{"code":"PersistenceCoordinator","type":"codeVoice"},{"text":", register its plugin, and run first-load hydration before constructing the store:","type":"text"}]},{"code":["import SwiduxPersistence","","extension Store where State == AppState, Action == AppAction {","    static func configured() async -> AppStore {","        let container = try! ContainerFactory.makeLocalContainer(models: [CardModel.self])","","        let persistence = PersistenceCoordinator<AppState, AppAction>(","            entities: [.entity(\\.cards)],","            container: container,","            debounce: .milliseconds(250)","        )","","        let plugins = PluginHost<AppState, AppAction>()","        \/\/ Register UndoPlugin first if you use it — snapshots must precede writes.","        plugins.register(persistence.corePlugin)","","        var initial = AppState()","        await persistence.hydrate(into: &initial)   \/\/ first-load: fill EntityStores from disk","","        return Store(initialState: initial, reducer: { … }, plugins: plugins)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"hydrate(into:)","type":"codeVoice"},{"text":" is ","type":"text"},{"inlineContent":[{"type":"text","text":"first-load only"}],"type":"strong"},{"text":" — it replaces each ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" with the on-disk rows before any live edits exist. The only refresh path after launch is ","type":"text"},{"code":"rehydrate(into:)","type":"codeVoice"},{"text":", which always ","type":"text"},{"inlineContent":[{"type":"text","text":"merges"}],"type":"emphasis"},{"text":" (preferring in-memory values) so a “refresh from disk” can never clobber unflushed writes or in-progress UI edits.","type":"text"}]},{"level":3,"text":"Surfacing failures","type":"heading","anchor":"Surfacing-failures"},{"type":"paragraph","inlineContent":[{"text":"Every save and fetch failure is logged, and the coordinator accepts an optional ","type":"text"},{"code":"onFailure:","type":"codeVoice"},{"text":" handler to additionally surface it to your app (a failed ","type":"text"},{"inlineContent":[{"type":"text","text":"save"}],"type":"strong"},{"text":" means the in-memory data is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" on disk; a failed ","type":"text"},{"inlineContent":[{"type":"text","text":"hydrate fetch"}],"type":"strong"},{"text":" leaves that ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":" untouched rather than presenting an unreadable store as “no data”):","type":"text"}]},{"code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    onFailure: { failure in","        \/\/ e.g. dispatch an action that shows a \"couldn't save\" banner","    }",")"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Step 5: Flush on background","type":"heading","anchor":"Step-5-Flush-on-background"},{"type":"paragraph","inlineContent":[{"text":"Writes are debounced, so drain them when the app is backgrounded or terminates:","type":"text"}]},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await persistence.corePlugin.flush() }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Multiple entities and ordering","type":"heading","anchor":"Multiple-entities-and-ordering"},{"type":"paragraph","inlineContent":[{"text":"Register one ","type":"text"},{"code":".entity(\\.keyPath)","type":"codeVoice"},{"text":" per ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":":","type":"text"}]},{"code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.decks), .entity(\\.cards), .entity(\\.tags)],","    container: try! ContainerFactory.makeLocalContainer(","        models: [DeckModel.self, CardModel.self, TagModel.self]","    )",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Pass every generated ","type":"text"},{"code":"…Model","type":"codeVoice"},{"text":" type to the container’s ","type":"text"},{"code":"models:","type":"codeVoice"},{"text":". Writers flush in registration order — if entity B holds a ","type":"text"},{"code":"@Relation","type":"codeVoice"},{"text":" to A, register A’s entity first.","type":"text"}]},{"level":2,"text":"Testing","type":"heading","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The whole stack runs against an in-memory SwiftData store, so persistence is unit-testable with no disk and no CloudKit:"}]},{"code":["let container = try ContainerFactory.makeInMemoryContainer(models: [CardModel.self])","let db = EntityDB(modelContainer: container)","","try await db.upsert(Card(id: id, quote: \"hi\", createdAt: .now), as: CardModel.self)","let all = try await db.fetchAll(CardModel.self)","#expect(all.first?.quote == \"hi\")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"To prove the rule-#8 merge guarantee, seed the store, make a live in-memory edit, call ","type":"text"},