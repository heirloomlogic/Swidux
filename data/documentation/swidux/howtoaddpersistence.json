{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" turns persistence into a declare-and-register concern. You annotate a domain entity with ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":"; the macro generates its SwiftData ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":" “shadow” class, the value↔model converters, and the ","type":"text"},{"type":"codeVoice","code":"PersistableEntity"},{"type":"text","text":" conformance. A generic "},{"code":"EntityDB","type":"codeVoice"},{"type":"text","text":" actor and a "},{"code":"PersistenceCoordinator","type":"codeVoice"},{"type":"text","text":" build the container, synthesize one "},{"code":"StateWriter","type":"codeVoice"},{"type":"text","text":" per registered "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"type":"text","text":", and reuse the core "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"type":"text","text":" for debounced, batched writes."}]},{"type":"paragraph","inlineContent":[{"text":"Your reducers mutate plain value-type entities inside an ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":"; the plugin observes the changelog and writes through to SwiftData after a debounce. Reads happen once, at launch, into memory — the in-memory "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" is the source of truth.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For low-level manual wiring (writing your own ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Model","type":"codeVoice"},{"type":"text","text":"), see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true},{"type":"text","text":". For the macro details, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","isActive":true,"type":"reference"},{"type":"text","text":". To add cross-device iCloud sync on top, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"Before you start","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes a Swidux app already exists — "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" are wired and the store is in the SwiftUI environment. If not, follow "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"type":"text","text":" first."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" is a local-only persistence layer. It needs "},{"type":"strong","inlineContent":[{"type":"text","text":"no iCloud, CloudKit, or Push entitlements"}]},{"type":"text","text":" — only the sandbox "},{"type":"codeVoice","code":"com.apple.security.network.client"},{"type":"text","text":" entitlement if your app also makes network calls (killswitch, analytics, feature flags). Adding sync entitlements to a local-only app is dead configuration and an App Review risk."}]},{"level":2,"type":"heading","text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPersistence\",","    ]",")"],"type":"codeListing"},{"level":2,"type":"heading","text":"Step 2: Annotate your domain entity with `@Persisted`","anchor":"Step-2-Annotate-your-domain-entity-with-Persisted"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A persisted entity is a value type that already satisfies "},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"type":"text","text":" with "},{"type":"codeVoice","code":"ID == UUID"},{"type":"text","text":" (the "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" contract). Add "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":":"}]},{"syntax":"swift","code":["import SwiduxPersistence","","@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","    var createdAt: Date","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This generates a "},{"type":"codeVoice","code":"CardModel: @Model"},{"type":"text","text":" class with "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"toDomain()"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"update(from:)"},{"type":"text","text":", plus "},{"type":"codeVoice","code":"extension Card: PersistableEntity { typealias Model = CardModel }"},{"type":"text","text":". By default every stored property is mirrored directly onto the model — SwiftData persists scalars "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" composites natively, so no manual blob columns are needed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The generated model is "},{"type":"strong","inlineContent":[{"type":"text","text":"CloudKit-safe by construction"}]},{"type":"text","text":", so the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"type":"text","text":" model backs both the local and the synced container (see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true},{"type":"text","text":"). SwiftData’s CloudKit mirroring requires every non-optional attribute to be optional or carry a default value, and every relationship to be optional — validated when the "},{"type":"codeVoice","code":"ModelContainer"},{"type":"text","text":" is created. "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" satisfies this automatically:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Non-optional mirrored attributes get a default."}]},{"type":"text","text":" If you wrote one on the domain property ("},{"type":"codeVoice","code":"var count: Int = 0"},{"type":"text","text":"), it is propagated verbatim; otherwise the macro fills a canonical default for the known SwiftData primitives ("},{"type":"codeVoice","code":"String → \"\""},{"type":"text","text":", "},{"type":"codeVoice","code":"Bool → false"},{"type":"text","text":", integers\/floats "},{"type":"codeVoice","code":"→ 0"},{"type":"text","text":", "},{"code":"Date → .distantPast","type":"codeVoice"},{"type":"text","text":", "},{"code":"Data → Data()","type":"codeVoice"},{"type":"text","text":", "},{"code":"UUID → UUID()","type":"codeVoice"},{"type":"text","text":"). Defaults are inert locally — "},{"code":"init(from:)","type":"codeVoice"},{"type":"text","text":" overwrites them on every load."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Non-primitive, non-optional properties"}]},{"type":"text","text":" (a custom "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" type, "},{"code":"URL","type":"codeVoice"},{"type":"text","text":", an enum) have no default the macro can invent. Give the property a default ("},{"code":"= …","type":"codeVoice"},{"type":"text","text":"), make it optional, or mark it "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" — otherwise "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" emits a compile-time error."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Relationships are generated optional"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"var tags: [TagModel]? = nil"},{"type":"text","text":"); a non-optional to-one "},{"type":"codeVoice","code":"@Relation"},{"type":"text","text":" is a compile-time error (CloudKit forbids non-optional relationships)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" blob columns"}]},{"type":"text","text":" default to "},{"type":"codeVoice","code":"Data()"},{"type":"text","text":", so any "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" type is CloudKit-safe through "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" lives on the "},{"type":"strong","inlineContent":[{"text":"entity","type":"text"}]},{"type":"text","text":"; "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" lives on "},{"type":"strong","inlineContent":[{"type":"text","text":"state containers"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" slices). They are different layers and never apply to the same type."}]},{"level":3,"type":"heading","text":"Marker macros for non-trivial properties","anchor":"Marker-macros-for-non-trivial-properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A macro can’t infer relationships, foreign keys, or which fields are derived. Four property markers (named to avoid SwiftData’s own "},{"type":"codeVoice","code":"@Relationship"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"@Transient"},{"type":"text","text":") tell "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" what to do:"}]},{"type":"codeListing","syntax":"swift","code":["@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","","    @Inline var styling: TextStyling                 \/\/ one opaque JSON Data column","    @ForeignKey var deckID: UUID                      \/\/ scalar parent reference","    @Relation(deleteRule: .cascade, inverse: \\TagModel.card)","    var tags: [Tag]                                   \/\/ SwiftData relationship","    @Ignored var renderedPreview: String?             \/\/ derived; omitted from the model","}"]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Marker"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Effect"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"(none)","type":"text"}],"type":"emphasis"}]}],[{"type":"paragraph","inlineContent":[{"text":"Mirror the property directly (SwiftData persists scalars and ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" composites).","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"@Inline","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Force a "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" value into a single JSON "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" column (keeps a CloudKit record compact; sidesteps SwiftData "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":"-attribute edge cases)."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"@ForeignKey","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Intent marker on a "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":"; functionally a mirrored scalar column."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Relation(deleteRule:inverse:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A SwiftData relationship to another "},{"type":"codeVoice","code":"@Persisted"},{"text":" entity. The property’s type references the ","type":"text"},{"inlineContent":[{"text":"domain","type":"text"}],"type":"emphasis"},{"text":" type (","type":"text"},{"code":"[Tag]","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Tag?"},{"text":" \/ ","type":"text"},{"code":"Tag","type":"codeVoice"},{"text":"); the model substitutes the ","type":"text"},{"code":"…Model","type":"codeVoice"},{"text":" shadow. ","type":"text"},{"code":"inverse","type":"codeVoice"},{"text":" is a key path on the generated model, e.g. ","type":"text"},{"code":"\\TagModel.card","type":"codeVoice"},{"text":". ","type":"text"},{"code":"deleteRule","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"SwiduxDeleteRule","type":"codeVoice"},{"text":" (","type":"text"},{"code":".cascade","type":"codeVoice"},{"text":", ","type":"text"},{"code":".nullify","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":".noAction"},{"type":"text","text":", "},{"type":"codeVoice","code":".deny"},{"text":").","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"@Ignored","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Exclude a derived\/denormalized property. Must be optional so it can be reconstructed as "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" on load."}],"type":"paragraph"}]]],"type":"table"},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":""},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" does not generate an "},{"code":"@Attribute(.unique)","type":"codeVoice"},{"type":"text","text":" on "},{"code":"id","type":"codeVoice"},{"type":"text","text":" — CloudKit forbids unique constraints. Identity is enforced by upsert-by-"},{"code":"id","type":"codeVoice"},{"type":"text","text":" inside "},{"code":"EntityDB","type":"codeVoice"},{"type":"text","text":", so the same generated model works for both local and synced containers."}],"type":"paragraph"}],"type":"aside","style":"note"},{"anchor":"Step-3-Put-the-EntityStore-on-your-state","level":2,"type":"heading","text":"Step 3: Put the `EntityStore` on your state"},{"syntax":"swift","code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var cards: EntityStore<Card> = .init()","    \/\/ ... your other slices","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Your reducers mutate ","type":"text"},{"type":"codeVoice","code":"state.cards"},{"text":" like any ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"state.cards[card.id] = card"},{"type":"text","text":", "},{"type":"codeVoice","code":"state.cards.modify(id) { … }"},{"type":"text","text":", "},{"type":"codeVoice","code":"state.cards[id] = nil"},{"type":"text","text":". Every change is recorded for the plugin to drain."}]},{"anchor":"Step-4-Build-the-coordinator-and-register-the-plugin","level":2,"type":"heading","text":"Step 4: Build the coordinator and register the plugin"},{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":", build a local container, create a "},{"type":"codeVoice","code":"PersistenceCoordinator"},{"type":"text","text":", register its plugin, and run first-load hydration before constructing the store:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiduxPersistence","","extension Store where State == AppState, Action == AppAction {","    static func configured() async -> AppStore {","        let container = try! ContainerFactory.makeLocalContainer(models: [CardModel.self])","","        let persistence = PersistenceCoordinator<AppState, AppAction>(","            entities: [.entity(\\.cards)],","            container: container,","            debounce: .milliseconds(250)","        )","","        let plugins = PluginHost<AppState, AppAction>()","        \/\/ Register UndoPlugin first if you use it — snapshots must precede writes.","        plugins.register(persistence.corePlugin)","","        var initial = AppState()","        await persistence.hydrate(into: &initial)   \/\/ first-load: fill EntityStores from disk","","        return Store(initialState: initial, reducer: { … }, plugins: plugins)","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"hydrate(into:)","type":"codeVoice"},{"text":" is ","type":"text"},{"inlineContent":[{"type":"text","text":"first-load only"}],"type":"strong"},{"text":" — it replaces each ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" with the on-disk rows before any live edits exist. The only refresh path after launch is ","type":"text"},{"code":"rehydrate(into:)","type":"codeVoice"},{"text":", which always ","type":"text"},{"inlineContent":[{"type":"text","text":"merges"}],"type":"emphasis"},{"text":" (preferring in-memory values) so a “refresh from disk” can never clobber unflushed writes or in-progress UI edits.","type":"text"}]},{"type":"heading","text":"Step 5: Flush on background","level":2,"anchor":"Step-5-Flush-on-background"},{"type":"paragraph","inlineContent":[{"text":"Writes are debounced, so drain them when the app is backgrounded or terminates:","type":"text"}]},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await persistence.corePlugin.flush() }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Multiple entities and ordering","level":2,"anchor":"Multiple-entities-and-ordering"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register one "},{"code":".entity(\\.keyPath)","type":"codeVoice"},{"text":" per ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.decks), .entity(\\.cards), .entity(\\.tags)],","    container: try! ContainerFactory.makeLocalContainer(","        models: [DeckModel.self, CardModel.self, TagModel.self]","    )",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass every generated "},{"code":"…Model","type":"codeVoice"},{"text":" type to the container’s ","type":"text"},{"code":"models:","type":"codeVoice"},{"text":". Writers flush in registration order — if entity B holds a ","type":"text"},{"code":"@Relation","type":"codeVoice"},{"text":" to A, register A’s entity first.","type":"text"}]},{"anchor":"Testing","level":2,"type":"heading","text":"Testing"},{"type":"paragraph","inlineContent":[{"text":"The whole stack runs against an in-memory SwiftData store, so persistence is unit-testable with no disk and no CloudKit:","type":"text"}]},{"syntax":"swift","code":["let container = try ContainerFactory.makeInMemoryContainer(models: [CardModel.self])","let db = EntityDB(modelContainer: container)","","try await db.upsert(Card(id: id, quote: \"hi\", createdAt: .now), as: CardModel.self)","let all = try await db.fetchAll(CardModel.self)","#expect(all.first?.quote == \"hi\")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"To prove the rule-#8 merge guarantee, seed the store, make a live in-memory edit, call ","type":"text"},{"code":"coordinator.rehydrate(into:)","type":"codeVoice"},{"text":", and assert the live edit survives.","type":"text"}]}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence"},"abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"variants":[{"paths":["\/documentation\/swidux\/howtoaddpersistence"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"],"anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides","title":"How-to Guides","generated":true}],"kind":"article","metadata":{"roleHeading":"Article","title":"Add Persistence","role":"article","modules":[{"name":"Swidux"}]},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVe