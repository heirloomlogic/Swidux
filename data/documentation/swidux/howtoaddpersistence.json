{"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":" turns persistence into a declare-and-register concern. You annotate a domain entity with "},{"code":"@Persisted","type":"codeVoice"},{"text":"; the macro generates its SwiftData ","type":"text"},{"code":"@Model","type":"codeVoice"},{"type":"text","text":" “shadow” class, the value↔model converters, and the "},{"type":"codeVoice","code":"PersistableEntity"},{"type":"text","text":" conformance. A generic "},{"type":"codeVoice","code":"EntityDB"},{"text":" actor and a ","type":"text"},{"type":"codeVoice","code":"PersistenceCoordinator"},{"text":" build the container, synthesize one ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" per registered "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":", and reuse the core "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"type":"text","text":" for debounced, batched writes."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your reducers mutate plain value-type entities inside an "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":"; the plugin observes the changelog and writes through to SwiftData after a debounce. Reads happen once, at launch, into memory — the in-memory ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":" is the source of truth.","type":"text"}]},{"inlineContent":[{"text":"For low-level manual wiring (writing your own ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":"), see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true,"type":"reference"},{"text":". For the macro details, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","isActive":true,"type":"reference"},{"text":". To add cross-device iCloud sync on top, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Before-you-start","level":2,"type":"heading","text":"Before you start"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes a Swidux app already exists — ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"AppStore"},{"text":" are wired and the store is in the SwiftUI environment. If not, follow ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true,"type":"reference"},{"type":"text","text":" first."}]},{"inlineContent":[{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":" is a local-only persistence layer. It needs "},{"inlineContent":[{"text":"no iCloud, CloudKit, or Push entitlements","type":"text"}],"type":"strong"},{"text":" — only the sandbox ","type":"text"},{"type":"codeVoice","code":"com.apple.security.network.client"},{"type":"text","text":" entitlement if your app also makes network calls (killswitch, analytics, feature flags). Adding sync entitlements to a local-only app is dead configuration and an App Review risk."}],"type":"paragraph"},{"level":2,"anchor":"Step-1-Add-the-dependency","text":"Step 1: Add the dependency","type":"heading"},{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" product to your app target in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPersistence\",","    ]",")"]},{"level":2,"text":"Step 2: Annotate your domain entity with `@Persisted`","type":"heading","anchor":"Step-2-Annotate-your-domain-entity-with-Persisted"},{"type":"paragraph","inlineContent":[{"text":"A persisted entity is a value type that already satisfies ","type":"text"},{"code":"Identifiable & Equatable & Sendable","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"ID == UUID","type":"codeVoice"},{"type":"text","text":" (the "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" contract). Add "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":":"}]},{"code":["import SwiduxPersistence","","@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","    var createdAt: Date","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This generates a ","type":"text"},{"type":"codeVoice","code":"CardModel: @Model"},{"text":" class with ","type":"text"},{"type":"codeVoice","code":"init(from:)"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"toDomain()"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"update(from:)"},{"type":"text","text":", plus "},{"type":"codeVoice","code":"extension Card: PersistableEntity { typealias Model = CardModel }"},{"type":"text","text":". By default every stored property is mirrored directly onto the model — SwiftData persists scalars "},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" composites natively, so no manual blob columns are needed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The generated model is ","type":"text"},{"inlineContent":[{"type":"text","text":"CloudKit-safe by construction"}],"type":"strong"},{"type":"text","text":", so the "},{"inlineContent":[{"type":"text","text":"same"}],"type":"emphasis"},{"type":"text","text":" model backs both the local and the synced container (see "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"reference"},{"type":"text","text":"). SwiftData’s CloudKit mirroring requires every non-optional attribute to be optional or carry a default value, and every relationship to be optional — validated when the "},{"type":"codeVoice","code":"ModelContainer"},{"text":" is created. ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" satisfies this automatically:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Non-optional mirrored attributes get a default.","type":"text"}],"type":"strong"},{"text":" If you wrote one on the domain property (","type":"text"},{"code":"var count: Int = 0","type":"codeVoice"},{"text":"), it is propagated verbatim; otherwise the macro fills a canonical default for the known SwiftData primitives (","type":"text"},{"code":"String → \"\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Bool → false","type":"codeVoice"},{"type":"text","text":", integers\/floats "},{"code":"→ 0","type":"codeVoice"},{"type":"text","text":", "},{"code":"Date → .distantPast","type":"codeVoice"},{"type":"text","text":", "},{"code":"Data → Data()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"UUID → UUID()","type":"codeVoice"},{"text":"). Defaults are inert locally — ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"type":"text","text":" overwrites them on every load."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Non-primitive, non-optional properties"}],"type":"strong"},{"type":"text","text":" (a custom "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" type, "},{"code":"URL","type":"codeVoice"},{"type":"text","text":", an enum) have no default the macro can invent. Give the property a default ("},{"code":"= …","type":"codeVoice"},{"type":"text","text":"), make it optional, or mark it "},{"code":"@Inline","type":"codeVoice"},{"type":"text","text":" — otherwise "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" emits a compile-time error."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Relationships are generated optional","type":"text"}],"type":"strong"},{"type":"text","text":" ("},{"code":"var tags: [TagModel]? = nil","type":"codeVoice"},{"type":"text","text":"); a non-optional to-one "},{"code":"@Relation","type":"codeVoice"},{"type":"text","text":" is a compile-time error (CloudKit forbids non-optional relationships)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"@Inline","type":"codeVoice"},{"text":" blob columns","type":"text"}],"type":"strong"},{"type":"text","text":" default to "},{"code":"Data()","type":"codeVoice"},{"type":"text","text":", so any "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" type is CloudKit-safe through "},{"code":"@Inline","type":"codeVoice"},{"type":"text","text":". Because "},{"code":"Data()","type":"codeVoice"},{"type":"text","text":" is never decodable, a "},{"inlineContent":[{"text":"non-optional","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"code":"@Inline","type":"codeVoice"},{"type":"text","text":" property must also carry a domain default ("},{"code":"= …","type":"codeVoice"},{"type":"text","text":") — the generated getter falls back to it when the blob is missing or undecodable (e.g. a row CloudKit materialized before the blob synced). Omitting the default is a compile-time error ("},{"code":"inlineRequiresDefault","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" lives on the "},{"type":"strong","inlineContent":[{"text":"entity","type":"text"}]},{"type":"text","text":"; "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" lives on "},{"type":"strong","inlineContent":[{"text":"state containers","type":"text"}]},{"type":"text","text":" ("},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":" slices). They are different layers and never apply to the same type."}]},{"level":3,"anchor":"Marker-macros-for-non-trivial-properties","type":"heading","text":"Marker macros for non-trivial properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A macro can’t infer relationships, foreign keys, or which fields are derived. Four property markers (named to avoid SwiftData’s own "},{"code":"@Relationship","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"@Transient","type":"codeVoice"},{"type":"text","text":") tell "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" what to do:"}]},{"syntax":"swift","type":"codeListing","code":["@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","","    @Inline var styling: TextStyling = TextStyling()  \/\/ one opaque JSON Data column","    @ForeignKey var deckID: UUID                      \/\/ scalar parent reference","    @Relation(deleteRule: .cascade, inverse: \\TagModel.card)","    var tags: [Tag]                                   \/\/ SwiftData relationship","    @Ignored var renderedPreview: String?             \/\/ derived; omitted from the model","}"]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Marker","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Effect","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"(none)"}],"type":"emphasis"}]}],[{"type":"paragraph","inlineContent":[{"text":"Mirror the property directly (SwiftData persists scalars and ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" composites).","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Inline"}]}],[{"type":"paragraph","inlineContent":[{"text":"Force a ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" value into a single JSON ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":" column (keeps a CloudKit record compact; sidesteps SwiftData ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":"-attribute edge cases).","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@ForeignKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"Intent marker on a ","type":"text"},{"type":"codeVoice","code":"UUID"},{"text":"; functionally a mirrored scalar column.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Relation(deleteRule:inverse:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"A SwiftData relationship to another ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" entity. The property’s type references the ","type":"text"},{"inlineContent":[{"type":"text","text":"domain"}],"type":"emphasis"},{"text":" type (","type":"text"},{"type":"codeVoice","code":"[Tag]"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Tag?"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Tag"},{"text":"); the model substitutes the ","type":"text"},{"type":"codeVoice","code":"…Model"},{"text":" shadow. ","type":"text"},{"type":"codeVoice","code":"inverse"},{"text":" is a key path on the generated model, e.g. ","type":"text"},{"type":"codeVoice","code":"\\TagModel.card"},{"text":". ","type":"text"},{"type":"codeVoice","code":"deleteRule"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"SwiduxDeleteRule"},{"text":" (","type":"text"},{"type":"codeVoice","code":".cascade"},{"text":", ","type":"text"},{"type":"codeVoice","code":".nullify"},{"text":", ","type":"text"},{"type":"codeVoice","code":".noAction"},{"text":", ","type":"text"},{"type":"codeVoice","code":".deny"},{"text":").","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Ignored"}]}],[{"type":"paragraph","inlineContent":[{"text":"Exclude a derived\/denormalized property. Must be optional so it can be reconstructed as ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" on load.","type":"text"}]}]]],"header":"row"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" does not generate an ","type":"text"},{"type":"codeVoice","code":"@Attribute(.unique)"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" — CloudKit forbids unique constraints. Identity is enforced by upsert-by-","type":"text"},{"type":"codeVoice","code":"id"},{"text":" inside ","type":"text"},{"type":"codeVoice","code":"EntityDB"},{"text":", so the same generated model works for both local and synced containers.","type":"text"}],"type":"paragraph"}]},{"anchor":"Step-3-Put-the-EntityStore-on-your-state","level":2,"type":"heading","text":"Step 3: Put the `EntityStore` on your state"},{"code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var cards: EntityStore<Card> = .init()","    \/\/ ... your other slices","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your reducers mutate "},{"code":"state.cards","type":"codeVoice"},{"type":"text","text":" like any "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"text":" — ","type":"text"},{"type":"codeVoice","code":"state.cards[card.id] = card"},{"text":", ","type":"text"},{"type":"codeVoice","code":"state.cards.modify(id) { … }"},{"type":"text","text":", "},{"type":"codeVoice","code":"state.cards[id] = nil"},{"type":"text","text":". Every change is recorded for the plugin to drain."}]},{"type":"heading","text":"Step 4: Build the coordinator and register the plugin","anchor":"Step-4-Build-the-coordinator-and-register-the-plugin","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":", build a local container, create a "},{"code":"PersistenceCoordinator","type":"codeVoice"},{"type":"text","text":", register its plugin, and run first-load hydration before constructing the store:"}]},{"code":["import SwiduxPersistence","","extension Store where State == AppState, Action == AppAction {","    static func configured() async -> AppStore {","        let container = try! ContainerFactory.makeLocalContainer(models: [CardModel.self])","","        let persistence = PersistenceCoordinator<AppState, AppAction>(","            entities: [.entity(\\.cards)],","            container: container,","            debounce: .milliseconds(250)","        )","","        let plugins = PluginHost<AppState, AppAction>()","        \/\/ Register UndoPlugin first if you use it — snapshots must precede writes.","        plugins.register(persistence.corePlugin)","","        var initial = AppState()","        await persistence.hydrate(into: &initial)   \/\/ first-load: fill EntityStores from disk","","        return Store(initialState: initial, reducer: { … }, plugins: plugins)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"hydrate(into:)"},{"type":"text","text":" is "},{"type":"strong","inlineContent":[{"text":"first-load only","type":"text"}]},{"type":"text","text":" — it replaces each "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" with the on-disk rows before any live edits exist. The only refresh path after launch is "},{"type":"codeVoice","code":"rehydrate(into:)"},{"type":"text","text":", which always "},{"inlineContent":[{"text":"merges","type":"text"}],"type":"emphasis"},{"text":" (preferring in-memory values) so a “refresh from disk” can never clobber unflushed writes or in-progress UI edits.","type":"text"}]},{"type":"heading","text":"Surfacing failures","anchor":"Surfacing-failures","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every save and fetch failure is logged, and the coordinator accepts an optional "},{"code":"onFailure:","type":"codeVoice"},{"type":"text","text":" handler to additionally surface it to your app (a failed "},{"inlineContent":[{"text":"save","type":"text"}],"type":"strong"},{"type":"text","text":" means the in-memory data is "},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"type":"text","text":" on disk; a failed "},{"inlineContent":[{"type":"text","text":"hydrate fetch"}],"type":"strong"},{"text":" leaves that ","type":"text"},{"type":"codeVoice","code":"EntityStore"},{"text":" untouched rather than presenting an unreadable store as “no data”):","type":"text"}]},{"code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    onFailure: { failure in","        \/\/ e.g. dispatch an action that shows a \"couldn't save\" banner","    }",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Step 5: Flush on background","anchor":"Step-5-Flush-on-background","level":2},{"inlineContent":[{"text":"Writes are debounced, so drain them when the app is backgrounded or terminates:","type":"text"}],"type":"paragraph"},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await persistence.corePlugin.flush() }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Multiple entities and ordering","type":"heading","anchor":"Multiple-entities-and-ordering"},{"inlineContent":[{"type":"text","text":"Register one "},{"code":".entity(\\.keyPath)","type":"codeVoice"},{"type":"text","text":" per "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.decks), .entity(\\.cards), .entity(\\.tags)],","    container: try! ContainerFactory.makeLocalContainer(","        models: [DeckModel.self, CardModel.self, TagModel.self]","    )",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Pass every generated ","type":"text"},{"type":"codeVoice","code":"…Model"},{"text":" type to the container’s ","type":"text"},{"type":"codeVoice","code":"models:"},{"text":". Writers flush in registration order — if entity B holds a ","type":"text"},{"type":"codeVoice","code":"@Relation"},{"text":" to A, register A’s entity first.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Testing","type":"heading","anchor":"Testing"},{"inlineContent":[{"type":"text","text":"The whole stack runs against an in-memory SwiftData store, so persistence is unit-testable with no disk and no CloudKit:"}],"type":"paragraph"},{"code":["let container = try ContainerFactory.makeInMemoryContainer(models: [CardModel.self])","let db = EntityDB(modelContainer: container)","","try await db.upsert(Card(id: id, quote: \"hi\", createdAt: .now), as: CardModel.self)","let all = try await db.fetchAll(CardModel.self)","#expect(all.first?.quote == \"hi\")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"To prove the rule-#8 merge guarantee, seed the store, make a live in-memory edit, call "},{"code":"coordinator.rehydrate(into:)","type":"codeVoice"},{"type":"text","text":", and assert the live edit survives."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"seeAlsoSecti