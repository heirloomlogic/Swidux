ated model, e.g. "},{"type":"codeVoice","code":"\\TagModel.card"},{"type":"text","text":". "},{"type":"codeVoice","code":"deleteRule"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"SwiduxDeleteRule"},{"type":"text","text":" ("},{"type":"codeVoice","code":".cascade"},{"type":"text","text":", "},{"type":"codeVoice","code":".nullify"},{"type":"text","text":", "},{"type":"codeVoice","code":".noAction"},{"type":"text","text":", "},{"type":"codeVoice","code":".deny"},{"type":"text","text":")."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@Ignored"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Exclude a derived\/denormalized property. Must be optional so it can be reconstructed as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" on load."}],"type":"paragraph"}]]]},{"name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" does not generate an "},{"type":"codeVoice","code":"@Attribute(.unique)"},{"type":"text","text":" on "},{"type":"codeVoice","code":"id"},{"type":"text","text":" — CloudKit forbids unique constraints. Identity is enforced by upsert-by-"},{"type":"codeVoice","code":"id"},{"type":"text","text":" inside "},{"type":"codeVoice","code":"EntityDB"},{"type":"text","text":", so the same generated model works for both local and synced containers."}],"type":"paragraph"}],"style":"note"},{"text":"Step 3: Put the `EntityStore` on your state","type":"heading","level":2,"anchor":"Step-3-Put-the-EntityStore-on-your-state"},{"syntax":"swift","type":"codeListing","code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var cards: EntityStore<Card> = .init()","    \/\/ ... your other slices","}"]},{"type":"paragraph","inlineContent":[{"text":"Your reducers mutate ","type":"text"},{"type":"codeVoice","code":"state.cards"},{"text":" like any ","type":"text"},{"isActive":true,"type":"reference","ide