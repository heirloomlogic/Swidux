{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"]},{"generated":true,"title":"How-to Guides","anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"]}],"sections":[],"kind":"article","metadata":{"title":"Add Persistence","modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" turns persistence into a declare-and-register concern. You annotate a domain entity with ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":"; the macro generates its SwiftData ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":" “shadow” class, the value↔model converters, and the ","type":"text"},{"type":"codeVoice","code":"PersistableEntity"},{"text":" conformance. A generic ","type":"text"},{"type":"codeVoice","code":"EntityDB"},{"text":" actor and a ","type":"text"},{"type":"codeVoice","code":"PersistenceCoordinator"},{"text":" build the container, synthesize one ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"text":" per registered ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":", and reuse the core ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true,"type":"reference"},{"text":" for debounced, batched writes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Your reducers mutate plain value-type entities inside an ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":"; the plugin observes the changelog and writes through to SwiftData after a debounce. Reads happen once, at launch, into memory — the in-memory ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" is the source of truth.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For low-level manual wiring (writing your own ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":"), see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true,"type":"reference"},{"text":". For the macro details, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","isActive":true,"type":"reference"},{"text":". To add cross-device iCloud sync on top, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"level":2,"type":"heading","anchor":"Before-you-start","text":"Before you start"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes a Swidux app already exists — ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"AppStore"},{"text":" are wired and the store is in the SwiftUI environment. If not, follow ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true,"type":"reference"},{"text":" first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" is a local-only persistence layer. It needs ","type":"text"},{"inlineContent":[{"text":"no iCloud, CloudKit, or Push entitlements","type":"text"}],"type":"strong"},{"text":" — only the sandbox ","type":"text"},{"type":"codeVoice","code":"com.apple.security.network.client"},{"text":" entitlement if your app also makes network calls (killswitch, analytics, feature flags). Adding sync entitlements to a local-only app is dead configuration and an App Review risk.","type":"text"}]},{"level":2,"type":"heading","anchor":"Step-1-Add-the-dependency","text":"Step 1: Add the dependency"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" product to your app target in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}]},{"type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPersistence\",","    ]",")"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Step-2-Annotate-your-domain-entity-with-Persisted","text":"Step 2: Annotate your domain entity with `@Persisted`"},{"type":"paragraph","inlineContent":[{"text":"A persisted entity is a value type that already satisfies ","type":"text"},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"ID == UUID"},{"text":" (the ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" contract). Add ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":":","type":"text"}]},{"type":"codeListing","code":["import SwiduxPersistence","","@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","    var createdAt: Date","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This generates a ","type":"text"},{"type":"codeVoice","code":"CardModel: @Model"},{"text":" class with ","type":"text"},{"type":"codeVoice","code":"init(from:)"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"toDomain()"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"update(from:)"},{"text":", plus ","type":"text"},{"type":"codeVoice","code":"extension Card: PersistableEntity { typealias Model = CardModel }"},{"text":". By default every stored property is mirrored directly onto the model — SwiftData persists scalars ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" composites natively, so no manual blob columns are needed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The generated model is ","type":"text"},{"inlineContent":[{"text":"CloudKit-safe by construction","type":"text"}],"type":"strong"},{"text":", so the ","type":"text"},{"inlineContent":[{"text":"same","type":"text"}],"type":"emphasis"},{"text":" model backs both the local and the synced container (see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true,"type":"reference"},{"text":"). SwiftData’s CloudKit mirroring requires every non-optional attribute to be optional or carry a default value, and every relationship to be optional — validated when the ","type":"text"},{"type":"codeVoice","code":"ModelContainer"},{"text":" is created. ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" satisfies this automatically:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Non-optional mirrored attributes get a default.","type":"text"}]},{"type":"text","text":" If you wrote one on the domain property ("},{"type":"codeVoice","code":"var count: Int = 0"},{"type":"text","text":"), it is propagated verbatim; otherwise the macro fills a canonical default for the known SwiftData primitives ("},{"type":"codeVoice","code":"String → \"\""},{"type":"text","text":", "},{"type":"codeVoice","code":"Bool → false"},{"type":"text","text":", integers\/floats "},{"type":"codeVoice","code":"→ 0"},{"type":"text","text":", "},{"type":"codeVoice","code":"Date → .distantPast"},{"type":"text","text":", "},{"type":"codeVoice","code":"Data → Data()"},{"type":"text","text":", "},{"type":"codeVoice","code":"UUID → UUID()"},{"type":"text","text":"). Defaults are inert locally — "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" overwrites them on every load."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Non-primitive, non-optional properties","type":"text"}]},{"type":"text","text":" (a custom "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" type, "},{"type":"codeVoice","code":"URL"},{"type":"text","text":", an enum) have no default the macro can invent. Give the property a default ("},{"type":"codeVoice","code":"= …"},{"type":"text","text":"), make it optional, or mark it "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" — otherwise "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" emits a compile-time error."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Relationships are generated optional","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"var tags: [TagModel]? = nil"},{"type":"text","text":"); a non-optional to-one "},{"type":"codeVoice","code":"@Relation"},{"text":" is a compile-time error (CloudKit forbids non-optional relationships).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" blob columns"}],"type":"strong"},{"text":" default to ","type":"text"},{"code":"Data()","type":"codeVoice"},{"text":", so any ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" type is CloudKit-safe through ","type":"text"},{"code":"@Inline","type":"codeVoice"},{"text":". Because ","type":"text"},{"code":"Data()","type":"codeVoice"},{"text":" is never decodable, a ","type":"text"},{"inlineContent":[{"type":"text","text":"non-optional"}],"type":"strong"},{"type":"text","text":" "},{"code":"@Inline","type":"codeVoice"},{"type":"text","text":" property must also carry a domain default ("},{"code":"= …","type":"codeVoice"},{"text":") — the generated getter falls back to it when the blob is missing or undecodable (e.g. a row CloudKit materialized before the blob synced). Omitting the default is a compile-time error (","type":"text"},{"code":"inlineRequiresDefault","type":"codeVoice"},{"text":").","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Persisted"},{"text":" lives on the ","type":"text"},{"inlineContent":[{"type":"text","text":"entity"}],"type":"strong"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" lives on ","type":"text"},{"inlineContent":[{"text":"state containers","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" slices). They are different layers and never apply to the same type.","type":"text"}]},{"type":"heading","text":"Marker macros for non-trivial properties","level":3,"anchor":"Marker-macros-for-non-trivial-properties"},{"type":"paragraph","inlineContent":[{"text":"A macro can’t infer relationships, foreign keys, or which fields are derived. Four property markers (named to avoid SwiftData’s own ","type":"text"},{"type":"codeVoice","code":"@Relationship"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"@Transient"},{"text":") tell ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" what to do:","type":"text"}]},{"type":"codeListing","code":["@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","","    @Inline var styling: TextStyling = TextStyling()  \/\/ one opaque JSON Data column","    @ForeignKey var deckID: UUID                      \/\/ scalar parent reference","    @Relation(deleteRule: .cascade, inverse: \\TagModel.card)","    var tags: [Tag]                                   \/\/ SwiftData relationship","    @Ignored var renderedPreview: String?             \/\/ derived; omitted from the model","}"],"syntax":"swift"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Marker","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Effect","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"(none)","type":"text"}],"type":"emphasis"}]}],[{"type":"paragraph","inlineContent":[{"text":"Mirror the property directly (SwiftData persists scalars and ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" composites).","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Inline"}]}],[{"type":"paragraph","inlineContent":[{"text":"Force a ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" value into a single JSON ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":" column (keeps a CloudKit record compact; sidesteps SwiftData ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":"-attribute edge cases).","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@ForeignKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"Intent marker on a ","type":"text"},{"type":"codeVoice","code":"UUID"},{"text":"; functionally a mirrored scalar column.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Relation(deleteRule:inverse:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"A SwiftData relationship to another ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" entity. The property’s type references the ","type":"text"},{"inlineContent":[{"text":"domain","type":"text"}],"type":"emphasis"},{"text":" type (","type":"text"},{"type":"codeVoice","code":"[Tag]"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Tag?"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Tag"},{"text":"); the model substitutes the ","type":"text"},{"type":"codeVoice","code":"…Model"},{"text":" shadow. ","type":"text"},{"type":"codeVoice","code":"inverse"},{"text":" is a key path on the generated model, e.g. ","type":"text"},{"type":"codeVoice","code":"\\TagModel.card"},{"text":". ","type":"text"},{"type":"codeVoice","code":"deleteRule"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"SwiduxDeleteRule"},{"text":" (","type":"text"},{"type":"codeVoice","code":".cascade"},{"text":", ","type":"text"},{"type":"codeVoice","code":".nullify"},{"text":", ","type":"text"},{"type":"codeVoice","code":".noAction"},{"text":", ","type":"text"},{"type":"codeVoice","code":".deny"},{"text":").","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Ignored"}]}],[{"type":"paragraph","inlineContent":[{"text":"Exclude a derived\/denormalized property. Must be optional so it can be reconstructed as ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" on load.","type":"text"}]}]]],"header":"row"},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" does not generate an ","type":"text"},{"code":"@Attribute(.unique)","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" — CloudKit forbids unique constraints — so the same generated model works for both local and synced containers. The cost is that rows sharing an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" are possible. ","type":"text"},{"code":"EntityDB","type":"codeVoice"},{"text":" handles them by converging rather than by assuming uniqueness: writes update every matching row, deletions remove every matching row, and ","type":"text"},{"type":"codeVoice","code":"fetchAll"},{"text":" collapses to one value per ","type":"text"},{"type":"codeVoice","code":"id"},{"text":". Nothing deletes a duplicate as a side effect of a write.","type":"text"}],"type":"paragraph"}]},{"type":"heading","text":"Step 3: Put the `EntityStore` on your state","level":2,"anchor":"Step-3-Put-the-EntityStore-on-your-state"},{"code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var cards: EntityStore<Card> = .init()","    \/\/ ... your other slices","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Your reducers mutate "},{"type":"codeVoice","code":"state.cards"},{"type":"text","text":" like any "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" — "},{"type":"codeVoice","code":"state.cards[card.id] = card"},{"type":"text","text":", "},{"type":"codeVoice","code":"state.cards.modify(id) { … }"},{"type":"text","text":", "},{"type":"codeVoice","code":"state.cards[id] = nil"},{"type":"text","text":". Every change is recorded for the plugin to drain."}],"type":"paragraph"},{"anchor":"Step-4-Build-the-coordinator-and-register-the-plugin","text":"Step 4: Build the coordinator and register the plugin","type":"heading","level":2},{"inlineContent":[{"text":"In ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":", build a local container, create a ","type":"text"},{"type":"codeVoice","code":"PersistenceCoordinator"},{"text":", register its plugin, and run first-load hydration before constructing the store:","type":"text"}],"type":"paragraph"},{"code":["import SwiduxPersistence","","extension Store where State == AppState, Action == AppAction {","    static func configured() async -> AppStore {","        let container = try! ContainerFactory.makeLocalContainer(models: [CardModel.self])","","        let persistence = PersistenceCoordinator<AppState, AppAction>(","            entities: [.entity(\\.cards)],","            container: container,","            debounce: .milliseconds(250)","        )","","        let plugins = PluginHost<AppState, AppAction>()","        \/\/ Register UndoPlugin first if you use it — snapshots must precede writes.","        plugins.register(persistence.corePlugin)","","        var initial = AppState()","        await persistence.hydrate(into: &initial)   \/\/ first-load: fill EntityStores from disk","","        return Store(initialState: initial, reducer: { … }, plugins: plugins)","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"hydrate(into:)","type":"codeVoice"},{"text":" is ","type":"text"},{"inlineContent":[{"text":"first-load only","type":"text"}],"type":"strong"},{"text":" — it replaces each ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" with the on-disk rows before any live edits exist. It takes ","type":"text"},{"type":"codeVoice","code":"inout State"},{"text":" because it runs ","type":"text"},{"inlineContent":[{"text":"before the store is built","type":"text"}],"type":"emphasis"},{"text":", so there is nothing to race with.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The only refresh path after launch is ","type":"text"},{"type":"codeVoice","code":"rehydrate(into:)"},{"text":", which ","type":"text"},{"inlineContent":[{"text":"reconciles","type":"text"}],"type":"emphasis"},{"text":" rather than replaces: rows on disk are authoritative except for IDs that still carry unflushed local intent, which always win. So a “refresh from disk” can never clobber pending writes or in-progress UI edits, while remote edits and deletions still surface mid-session. Pass ","type":"text"},{"type":"codeVoice","code":"policy:"},{"text":" — or register an entity with ","type":"text"},{"type":"codeVoice","code":"policy:"},{"text":" — to narrow that; see ","type":"text"},{"type":"codeVoice","code":"MergePolicy"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It takes the ","type":"text"},{"inlineContent":[{"text":"store","type":"text"}],"type":"strong"},{"text":", not ","type":"text"},{"type":"codeVoice","code":"inout State"},{"text":": re-hydration is asynchronous, and a caller holding a state snapshot across those ","type":"text"},{"type":"codeVoice","code":"await"},{"text":"s would discard everything dispatched while they were in flight. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"},{"text":" if edits are vanishing after a load.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If you need to ","type":"text"},{"inlineContent":[{"text":"read","type":"text"}],"type":"emphasis"},{"text":" rows without touching state, don’t re-hydrate into a throwaway ","type":"text"},{"type":"codeVoice","code":"AppState()"},{"text":" — that idiom breaks silently the moment re-hydration starts reading the state it is handed. Use ","type":"text"},{"type":"codeVoice","code":"fetchAll(of:)"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"snapshot(of:)"},{"text":" on the coordinator instead.","type":"text"}]},{"type":"heading","text":"Reading rows without touching state","level":3,"anchor":"Reading-rows-without-touching-state"},{"type":"paragraph","inlineContent":[{"text":"For exports, migrations, diagnostics, or any other “what’s actually on disk?” question, read directly — naming your domain type, not its generated shadow:","type":"text"}]},{"type":"codeListing","code":["let notes = try await persistence.fetchAll(of: Note.self)","let store = try await persistence.snapshot(of: Note.self)   \/\/ as an EntityStore"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Both flush the debounce window first by default, so they can’t return a stale row for something the user just edited; pass ","type":"text"},{"type":"codeVoice","code":"flushPending: false"},{"text":" on a hot path where that doesn’t matter. Both report failures to ","type":"text"},{"type":"codeVoice","code":"onFailure"},{"text":" ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"text":" rethrow — there is no state to leave untouched here, so swallowing the error could only present an unreadable database as “no data”.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The entity does not have to be registered with the coordinator; reading a model that is in the container’s schema but not mirrored into state is fine.","type":"text"}]},{"type":"aside","name":"Important","style":"important","content":[{"inlineContent":[{"text":"Don’t answer these questions by re-hydrating into a throwaway ","type":"text"},{"code":"AppState()","type":"codeVoice"},{"text":". That reads like a pure fetch but is really a merge, and it breaks silently the moment re-hydration starts consulting the state it is handed.","type":"text"}],"type":"paragraph"}]},{"type":"heading","text":"Surfacing failures","level":3,"anchor":"Surfacing-failures"},{"type":"paragraph","inlineContent":[{"text":"Every save and fetch failure is logged, and the coordinator accepts an optional ","type":"text"},{"type":"codeVoice","code":"onFailure:"},{"text":" handler to additionally surface it to your app (a failed ","type":"text"},{"inlineContent":[{"text":"save","type":"text"}],"type":"strong"},{"text":" means the in-memory data is ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" on disk; a failed ","type":"text"},{"inlineContent":[{"text":"hydrate fetch","type":"text"}],"type":"strong"},{"text":" leaves that ","type":"text"},{"type":"codeVoice","code":"EntityStore"},{"text":" untouched rather than presenting an unreadable store as “no data”):","type":"text"}]},{"type":"codeListing","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    onFailure: { failure in","        guard failure.isFinal else { return }   \/\/ earlier attempts may still succeed","        \/\/ e.g. dispatch an action that shows a \"couldn't save\" banner","    }",")"],"syntax":"swift"},{"type":"heading","text":"Retrying a failed save","level":3,"anchor":"Retrying-a-failed-save"},{"type":"paragraph","inlineContent":[{"text":"A flush clears its buffers before the save runs, so a save that fails has nothing left to retry it — the write would reach disk only if the user happened to touch the same entity again. That is silent data loss, so the stack retries.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A failed batch goes ","type":"text"},{"inlineContent":[{"text":"back","type":"text"}],"type":"strong"},{"text":" into the writer’s pending buffers, never over anything newer: a later edit to the same entity supersedes the restored value, and a deletion drained while the save was in flight cancels it. ","type":"text"},{"type":"codeVoice","code":"PersistencePlugin"},{"text":" then re-attempts on a doubling backoff, independently of the debounce timer — a write has to land even if the user never touches the app again.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Retrying is bounded, because a write that can ","type":"text"},{"inlineContent":[{"text":"never","type":"text"}],"type":"emphasis"},{"text":" succeed (disk full, a model the container can’t encode) must not keep the stack busy forever. Tune it with ","type":"text"},{"type":"codeVoice","code":"retry:"},{"text":":","type":"text"}]},{"type":"codeListing","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    retry: RetryPolicy(maxAttempts: 5, baseDelay: .milliseconds(500), maxDelay: .seconds(30)),","    onFailure: { failure in ... }",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RetryPolicy.default"},{"text":" is that policy — five attempts over roughly seven seconds. ","type":"text"},{"type":"codeVoice","code":"RetryPolicy.never"},{"text":" opts out of retrying without opting back into losing the write.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When the budget runs out you get one final ","type":"text"},{"type":"codeVoice","code":"PersistenceFailure"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"isFinal == true"},{"text":". That is the one worth telling the user about: everything before it was “we’ll try again”. The batch is ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" discarded — it stays pending, so the next edit or an explicit ","type":"text"},{"type":"codeVoice","code":"flush()"},{"text":" tries once more, and until then those IDs stay locally owned so a re-hydration can’t overwrite them with the stale stored row.","type":"text"}]},{"type":"aside","name":"Note","style":"note","content":[{"inlineContent":[{"text":"Every attempt is reported, so a handler that shows UI should gate on ","type":"text"},{"code":"isFinal","type":"codeVoice"},{"text":". Most ","type":"text"},{"code":".save","type":"codeVoice"},{"text":" failures are transient and are followed by a success the app never hears about.","type":"text"}],"type":"paragraph"}]},{"type":"heading","text":"Diagnostics: what isn’t a failure","level":3,"anchor":"Diagnostics-what-isnt-a-failure"},{"type":"paragraph","inlineContent":[{"text":"Some conditions are worth acting on but aren’t errors, so routing them through ","type":"text"},{"type":"codeVoice","code":"onFailure"},{"text":" would be wrong. Duplicate rows are the clearest case: CloudKit forbids unique constraints, so several rows sharing an ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" are a legitimate on-disk state, not a fault. They go to ","type":"text"},{"type":"codeVoice","code":"onDiagnostic:"},{"text":" instead:","type":"text"}]},{"type":"codeListing","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards, collapse: EntityCollapse.byID { $0.updatedAt >= $1.updatedAt ? $0 : $1 })],","    container: container,","    onDiagnostic: { diagnostic in","        guard diagnostic.kind == .duplicateRowsCollapsed,","              let count = diagnostic.duplicateCount else { return }","        store.send(.offerDuplicateCleanup(count: count))","    }",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Four kinds ship today:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Kind","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Means","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Payload","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".duplicateRowsCollapsed","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A read found rows sharing an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":". Without a ","type":"text"},{"code":"collapse:","type":"codeVoice"},{"text":" resolver they are harmless but permanent — this is what lets you ","type":"text"},{"inlineContent":[{"text":"offer","type":"text"}],"type":"emphasis"},{"text":" the cleanup.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"entityType","type":"codeVoice"},{"text":", ","type":"text"},{"code":"duplicateCount","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".possibleDispatchLoop","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"afterReduce","type":"codeVoice"},{"text":" fired far more often in one debounce interval than a user could cause. Usually an effect or plugin dispatching on every state change. Reported once per burst, not once per dispatch.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"drainCount","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".writesUnpersisted","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The set of IDs whose last flush failed changed. Fires again with an ","type":"text"},{"inlineContent":[{"text":"empty","type":"text"}],"type":"strong"},{"text":" set once they land, so an indicator can be cleared rather than guessed at.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"entityType","type":"codeVoice"},{"text":", ","type":"text"},{"code":"unpersistedIDs","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".mergeWithheld","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A re-hydration left a stored value unapplied because an editing hold was in force. Expected while the user is editing; a hold that outlives the edit shows up here. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"entityType","type":"codeVoice"},{"text":", ","type":"text"},{"code":"withheldIDs","type":"codeVoice"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PersistenceDiagnostic"},{"text":" is a struct with static constructors rather than an enum, so a future kind can’t break an exhaustive ","type":"text"},{"type":"codeVoice","code":"switch"},{"text":" in your code — match on ","type":"text"},{"type":"codeVoice","code":"kind"},{"text":" and read the payload you expect. Duplicate reads and dispatch loops are logged whether or not you supply a handler; the unpersisted set has no log of its own, because the individual ","type":"text"},{"type":"codeVoice","code":"PersistenceFailure"},{"text":"s behind it are already logged.","type":"text"}]},{"type":"heading","text":"Step 5: Flush on background","level":2,"anchor":"Step-5-Flush-on-background"},{"type":"paragraph","inlineContent":[{"text":"Writes are debounced, so drain them when the app is backgrounded or terminates:","type":"text"}]},{"type":"codeListing","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await persistence.corePlugin.flush() }","    }","}"],"syntax":"swift"},{"type":"heading","text":"Multiple entities and ordering","level":2,"anchor":"Multiple-entities-and-ordering"},{"type":"paragraph","inlineContent":[{"text":"Register one ","type":"text"},{"type":"codeVoice","code":".entity(\\.keyPath)"},{"text":" per ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":":","type":"text"}]},{"type":"codeListing","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.decks), .entity(\\.cards), .entity(\\.tags)],","    container: try! ContainerFactory.makeLocalContainer(","        models: [DeckModel.self, CardModel.self, TagModel.self]","    )",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Pass every generated ","type":"text"},{"type":"codeVoice","code":"…Model"},{"text":" type to the container’s ","type":"text"},{"type":"codeVoice","code":"models:"},{"text":". Writers flush in registration order — if entity B holds a ","type":"text"},{"type":"codeVoice","code":"@Relation"},{"text":" to A, register A’s entity first.","type":"text"}]},{"type":"heading","text":"Testing","level":2,"anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"The whole stack runs against an in-memory SwiftData store, so persistence is unit-testable with no disk and no CloudKit:","type":"text"}]},{"type":"codeListing","code":["let container = try ContainerFactory.makeInMemoryContainer(models: [CardModel.self])","let db = EntityDB(modelContainer: container)","","try await db.upsert(Card(id: id, quote: \"hi\", createdAt: .now), as: CardModel.self)","let all = try await db.fetchAll(CardModel.self)","#expect(all.first?.quote == \"hi\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"To prove the rule-#8 merge guarantee, seed the store, make a live in-memory edit, call ","type":"text"},{"type":"codeVoice","code":"coordinator.rehydrate(into:)"},{"text":", and assert the live edit survives.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swidux\/howtoaddpersistence"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"title":"Add Feature Flags","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"role":"article","kind":"article","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"role":"article","kind":"article","title":"Add iCloud Sync","url":"\/documentation\/swidux\/howtoaddicloudsync"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"role":"article","kind":"article","title":"Cancel Effects","url":"\/documentation\/swidux\/howtocanceleffects"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"role":"article","kind":"article","title":"Troubleshooting","url":"\/documentation\/swidux\/troubleshooting"},"doc://Swidux