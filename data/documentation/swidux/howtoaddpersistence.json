{"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"]},{"title":"How-to Guides","generated":true,"anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"]}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"variants":[{"paths":["\/documentation\/swidux\/howtoaddpersistence"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"Add Persistence"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" turns persistence into a declare-and-register concern. You annotate a domain entity with ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":"; the macro generates its SwiftData ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" “shadow” class, the value↔model converters, and the ","type":"text"},{"code":"PersistableEntity","type":"codeVoice"},{"text":" conformance. A generic ","type":"text"},{"code":"EntityDB","type":"codeVoice"},{"text":" actor and a ","type":"text"},{"code":"PersistenceCoordinator","type":"codeVoice"},{"text":" build the container, synthesize one ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" per registered ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"text":", and reuse the core ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"text":" for debounced, batched writes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Your reducers mutate plain value-type entities inside an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":"; the plugin observes the changelog and writes through to SwiftData after a debounce. Reads happen once, at launch, into memory — the in-memory "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" is the source of truth."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For low-level manual wiring (writing your own "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":"), see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},{"type":"text","text":". For the macro details, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"},{"type":"text","text":". To add cross-device iCloud sync on top, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},{"type":"text","text":"."}]},{"level":2,"anchor":"Before-you-start","type":"heading","text":"Before you start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes a Swidux app already exists — "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and "},{"code":"AppStore","type":"codeVoice"},{"type":"text","text":" are wired and the store is in the SwiftUI environment. If not, follow "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference","isActive":true},{"type":"text","text":" first."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" is a local-only persistence layer. It needs "},{"type":"strong","inlineContent":[{"type":"text","text":"no iCloud, CloudKit, or Push entitlements"}]},{"type":"text","text":" — only the sandbox "},{"type":"codeVoice","code":"com.apple.security.network.client"},{"type":"text","text":" entitlement if your app also makes network calls (killswitch, analytics, feature flags). Adding sync entitlements to a local-only app is dead configuration and an App Review risk."}]},{"level":2,"anchor":"Step-1-Add-the-dependency","type":"heading","text":"Step 1: Add the dependency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":" product to your app target in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPersistence\",","    ]",")"]},{"anchor":"Step-2-Annotate-your-domain-entity-with-Persisted","level":2,"type":"heading","text":"Step 2: Annotate your domain entity with `@Persisted`"},{"type":"paragraph","inlineContent":[{"text":"A persisted entity is a value type that already satisfies ","type":"text"},{"code":"Identifiable & Equatable & Sendable","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"ID == UUID","type":"codeVoice"},{"text":" (the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" contract). Add ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxPersistence","","@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","    var createdAt: Date","}"]},{"type":"paragraph","inlineContent":[{"text":"This generates a ","type":"text"},{"code":"CardModel: @Model","type":"codeVoice"},{"text":" class with ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"toDomain()","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"update(from:)","type":"codeVoice"},{"text":", plus ","type":"text"},{"code":"extension Card: PersistableEntity { typealias Model = CardModel }","type":"codeVoice"},{"text":". By default every stored property is mirrored directly onto the model — SwiftData persists scalars ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" composites natively, so no manual blob columns are needed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The generated model is ","type":"text"},{"inlineContent":[{"text":"CloudKit-safe by construction","type":"text"}],"type":"strong"},{"text":", so the ","type":"text"},{"inlineContent":[{"text":"same","type":"text"}],"type":"emphasis"},{"text":" model backs both the local and the synced container (see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"reference","isActive":true},{"text":"). SwiftData’s CloudKit mirroring requires every non-optional attribute to be optional or carry a default value, and every relationship to be optional — validated when the ","type":"text"},{"type":"codeVoice","code":"ModelContainer"},{"text":" is created. ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" satisfies this automatically:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Non-optional mirrored attributes get a default.","type":"text"}],"type":"strong"},{"text":" If you wrote one on the domain property (","type":"text"},{"type":"codeVoice","code":"var count: Int = 0"},{"text":"), it is propagated verbatim; otherwise the macro fills a canonical default for the known SwiftData primitives (","type":"text"},{"type":"codeVoice","code":"String → \"\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"Bool → false"},{"text":", integers\/floats ","type":"text"},{"type":"codeVoice","code":"→ 0"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Date → .distantPast"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Data → Data()"},{"text":", ","type":"text"},{"type":"codeVoice","code":"UUID → UUID()"},{"text":"). Defaults are inert locally — ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" overwrites them on every load.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Non-primitive, non-optional properties"}]},{"text":" (a custom ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" type, ","type":"text"},{"type":"codeVoice","code":"URL"},{"text":", an enum) have no default the macro can invent. Give the property a default (","type":"text"},{"type":"codeVoice","code":"= …"},{"text":"), make it optional, or mark it ","type":"text"},{"type":"codeVoice","code":"@Inline"},{"text":" — otherwise ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" emits a compile-time error.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Relationships are generated optional","type":"text"}]},{"type":"text","text":" ("},{"code":"var tags: [TagModel]? = nil","type":"codeVoice"},{"type":"text","text":"); a non-optional to-one "},{"code":"@Relation","type":"codeVoice"},{"type":"text","text":" is a compile-time error (CloudKit forbids non-optional relationships)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" blob columns"}],"type":"strong"},{"type":"text","text":" default to "},{"code":"Data()","type":"codeVoice"},{"type":"text","text":", so any "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" type is CloudKit-safe through "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":". Because "},{"code":"Data()","type":"codeVoice"},{"text":" is never decodable, a ","type":"text"},{"inlineContent":[{"type":"text","text":"non-optional"}],"type":"strong"},{"text":" ","type":"text"},{"code":"@Inline","type":"codeVoice"},{"text":" property must also carry a domain default (","type":"text"},{"code":"= …","type":"codeVoice"},{"text":") — the generated getter falls back to it when the blob is missing or undecodable (e.g. a row CloudKit materialized before the blob synced). Omitting the default is a compile-time error (","type":"text"},{"code":"inlineRequiresDefault","type":"codeVoice"},{"text":").","type":"text"}]}]}]},{"inlineContent":[{"type":"codeVoice","code":"@Persisted"},{"text":" lives on the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"entity"}]},{"text":"; ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" lives on ","type":"text"},{"type":"strong","inlineContent":[{"text":"state containers","type":"text"}]},{"text":" (","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" slices). They are different layers and never apply to the same type.","type":"text"}],"type":"paragraph"},{"anchor":"Marker-macros-for-non-trivial-properties","type":"heading","level":3,"text":"Marker macros for non-trivial properties"},{"inlineContent":[{"type":"text","text":"A macro can’t infer relationships, foreign keys, or which fields are derived. Four property markers (named to avoid SwiftData’s own "},{"type":"codeVoice","code":"@Relationship"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"@Transient"},{"text":") tell ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" what to do:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","","    @Inline var styling: TextStyling = TextStyling()  \/\/ one opaque JSON Data column","    @ForeignKey var deckID: UUID                      \/\/ scalar parent reference","    @Relation(deleteRule: .cascade, inverse: \\TagModel.card)","    var tags: [Tag]                                   \/\/ SwiftData relationship","    @Ignored var renderedPreview: String?             \/\/ derived; omitted from the model","}"]},{"rows":[[[{"inlineContent":[{"text":"Marker","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Effect"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"(none)"}],"type":"emphasis"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Mirror the property directly (SwiftData persists scalars and "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" composites)."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@Inline"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Force a "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" value into a single JSON "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" column (keeps a CloudKit record compact; sidesteps SwiftData "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":"-attribute edge cases)."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@ForeignKey"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Intent marker on a "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":"; functionally a mirrored scalar column."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"@Relation(deleteRule:inverse:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A SwiftData relationship to another "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" entity. The property’s type references the "},{"inlineContent":[{"type":"text","text":"domain"}],"type":"emphasis"},{"type":"text","text":" type ("},{"type":"codeVoice","code":"[Tag]"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Tag?"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Tag"},{"type":"text","text":"); the model substitutes the "},{"type":"codeVoice","code":"…Model"},{"type":"text","text":" shadow. "},{"type":"codeVoice","code":"inverse"},{"type":"text","text":" is a key path on the generated model, e.g. "},{"type":"codeVoice","code":"\\TagModel.card"},{"type":"text","text":". "},{"type":"codeVoice","code":"deleteRule"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"SwiduxDeleteRule"},{"text":" (","type":"text"},{"type":"codeVoice","code":".cascade"},{"text":", ","type":"text"},{"type":"codeVoice","code":".nullify"},{"text":", ","type":"text"},{"type":"codeVoice","code":".noAction"},{"text":", ","type":"text"},{"type":"codeVoice","code":".deny"},{"text":").","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"@Ignored","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Exclude a derived\/denormalized property. Must be optional so it can be reconstructed as "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" on load."}]}]]],"header":"row","type":"table"},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" does not generate an "},{"type":"codeVoice","code":"@Attribute(.unique)"},{"text":" on ","type":"text"},{"code":"id","type":"codeVoice"},{"type":"text","text":" — CloudKit forbids unique constraints — so the same generated model works for both local and synced containers. The cost is that rows sharing an "},{"type":"codeVoice","code":"id"},{"type":"text","text":" are possible. "},{"type":"codeVoice","code":"EntityDB"},{"type":"text","text":" handles them by converging rather than by assuming uniqueness: writes update every matching row, deletions remove every matching row, and "},{"type":"codeVoice","code":"fetchAll"},{"type":"text","text":" collapses to one value per "},{"type":"codeVoice","code":"id"},{"type":"text","text":". Nothing deletes a duplicate as a side effect of a write."}],"type":"paragraph"}]},{"level":2,"anchor":"Step-3-Put-the-EntityStore-on-your-state","type":"heading","text":"Step 3: Put the `EntityStore` on your state"},{"type":"codeListing","code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var cards: EntityStore<Card> = .init()","    \/\/ ... your other slices","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Your reducers mutate ","type":"text"},{"code":"state.cards","type":"codeVoice"},{"type":"text","text":" like any "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":" — "},{"type":"codeVoice","code":"state.cards[card.id] = card"},{"type":"text","text":", "},{"code":"state.cards.modify(id) { … }","type":"codeVoice"},{"type":"text","text":", "},{"code":"state.cards[id] = nil","type":"codeVoice"},{"type":"text","text":". Every change is recorded for the plugin to drain."}]},{"anchor":"Step-4-Build-the-coordinator-and-register-the-plugin","type":"heading","level":2,"text":"Step 4: Build the coordinator and register the plugin"},{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":", build a local container, create a "},{"type":"codeVoice","code":"PersistenceCoordinator"},{"type":"text","text":", register its plugin, and run first-load hydration before constructing the store:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxPersistence","","extension Store where State == AppState, Action == AppAction {","    static func configured() async -> AppStore {","        let container = try! ContainerFactory.makeLocalContainer(models: [CardModel.self])","","        let persistence = PersistenceCoordinator<AppState, AppAction>(","            entities: [.entity(\\.cards)],","            container: container,","            debounce: .milliseconds(250)","        )","","        let plugins = PluginHost<AppState, AppAction>()","        \/\/ Register UndoPlugin first if you use it — snapshots must precede writes.","        plugins.register(persistence.corePlugin)","","        var initial = AppState()","        await persistence.hydrate(into: &initial)   \/\/ first-load: fill EntityStores from disk","","        return Store(initialState: initial, reducer: { … }, plugins: plugins)","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"hydrate(into:)","type":"codeVoice"},{"text":" is ","type":"text"},{"inlineContent":[{"type":"text","text":"first-load only"}],"type":"strong"},{"text":" — it replaces each ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"text":" with the on-disk rows before any live edits exist. It takes ","type":"text"},{"code":"inout State","type":"codeVoice"},{"text":" because it runs ","type":"text"},{"inlineContent":[{"text":"before the store is built","type":"text"}],"type":"emphasis"},{"text":", so there is nothing to race with.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The only refresh path after launch is "},{"type":"codeVoice","code":"rehydrate(into:)"},{"type":"text","text":", which "},{"type":"emphasis","inlineContent":[{"text":"reconciles","type":"text"}]},{"type":"text","text":" rather than replaces: rows on disk are authoritative except for IDs that still carry unflushed local intent, which always win. So a “refresh from disk” can never clobber pending writes or in-progress UI edits, while remote edits and deletions still surface mid-session. Pass "},{"type":"codeVoice","code":"policy:"},{"type":"text","text":" — or register an entity with "},{"type":"codeVoice","code":"policy:"},{"type":"text","text":" — to narrow that; see "},{"type":"codeVoice","code":"MergePolicy"},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It takes the "},{"type":"strong","inlineContent":[{"text":"store","type":"text"}]},{"type":"text","text":", not "},{"type":"codeVoice","code":"inout State"},{"type":"text","text":": re-hydration is asynchronous, and a caller holding a state snapshot across those "},{"type":"codeVoice","code":"await"},{"type":"text","text":"s would discard everything dispatched while they were in flight. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","isActive":true},{"type":"text","text":" if edits are vanishing after a load."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you need to "},{"inlineContent":[{"type":"text","text":"read"}],"type":"emphasis"},{"type":"text","text":" rows without touching state, don’t re-hydrate into a throwaway "},{"type":"codeVoice","code":"AppState()"},{"text":" — that idiom breaks silently the moment re-hydration starts reading the state it is handed. Use ","type":"text"},{"code":"fetchAll(of:)","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"snapshot(of:)"},{"text":" on the coordinator instead.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Reading-rows-without-touching-state","text":"Reading rows without touching state","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"For exports, migrations, diagnostics, or any other “what’s actually on disk?” question, read directly — naming your domain type, not its generated shadow:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let notes = try await persistence.fetchAll(of: Note.self)","let store = try await persistence.snapshot(of: Note.self)   \/\/ as an EntityStore"]},{"type":"paragraph","inlineContent":[{"text":"Both flush the debounce window first by default, so they can’t return a stale row for something the user just edited; pass ","type":"text"},{"code":"flushPending: false","type":"codeVoice"},{"text":" on a hot path where that doesn’t matter. Both report failures to ","type":"text"},{"code":"onFailure","type":"codeVoice"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" rethrow — there is no state to leave untouched here, so swallowing the error could only present an unreadable database as “no data”."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The entity does not have to be registered with the coordinator; reading a model that is in the container’s schema but not mirrored into state is fine."}]},{"name":"Important","type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Don’t answer these questions by re-hydrating into a throwaway "},{"code":"AppState()","type":"codeVoice"},{"type":"text","text":". That reads like a pure fetch but is really a merge, and it breaks silently the moment re-hydration starts consulting the state it is handed."}]}]},{"anchor":"Surfacing-failures","type":"heading","text":"Surfacing failures","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every save and fetch failure is logged, and the coordinator accepts an optional "},{"code":"onFailure:","type":"codeVoice"},{"text":" handler to additionally surface it to your app (a failed ","type":"text"},{"inlineContent":[{"type":"text","text":"save"}],"type":"strong"},{"text":" means the in-memory data is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" on disk; a failed ","type":"text"},{"inlineContent":[{"type":"text","text":"hydrate fetch"}],"type":"strong"},{"text":" leaves that ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":" untouched rather than presenting an unreadable store as “no data”):","type":"text"}]},{"type":"codeListing","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    onFailure: { failure in","        guard failure.isFinal else { return }   \/\/ earlier attempts may still succeed","        \/\/ e.g. dispatch an action that shows a \"couldn't save\" banner","    }",")"],"syntax":"swift"},{"text":"Retrying a failed save","level":3,"type":"heading","anchor":"Retrying-a-failed-save"},{"type":"paragraph","inlineContent":[{"text":"A flush clears its buffers before the save runs, so a save that fails has nothing left to retry it — the write would reach disk only if the user happened to touch the same entity again. That is silent data loss, so the stack retries.","type":"text"}]},{"inlineContent":[{"text":"A failed batch goes ","type":"text"},{"inlineContent":[{"text":"back","type":"text"}],"type":"strong"},{"text":" into the writer’s pending buffers, never over anything newer: a later edit to the same entity supersedes the restored value, and a deletion drained while the save was in flight cancels it. ","type":"text"},{"code":"PersistencePlugin","type":"codeVoice"},{"text":" then re-attempts on a doubling backoff, independently of the debounce timer — a write has to land even if the user never touches the app again.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Retrying is bounded, because a write that can "},{"type":"emphasis","inlineContent":[{"type":"text","text":"never"}]},{"type":"text","text":" succeed (disk full, a model the container can’t encode) must not keep the stack busy forever. Tune it with "},{"code":"retry:","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    retry: RetryPolicy(maxAttempts: 5, baseDelay: .milliseconds(500), maxDelay: .seconds(30)),","    onFailure: { failure in ... }",")"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RetryPolicy.default"},{"type":"text","text":" is that policy — five attempts over roughly seven seconds. "},{"type":"codeVoice","code":"RetryPolicy.never"},{"type":"text","text":" opts out of retrying without opting back into losing the write."}]},{"inlineContent":[{"type":"text","text":"When the budget runs out you get one final "},{"code":"PersistenceFailure","type":"codeVoice"},{"type":"text","text":" with "},{"code":"isFinal == true","type":"codeVoice"},{"type":"text","text":". That is the one worth telling the user about: everything before it was “we’ll try again”. The batch is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" discarded — it stays pending, so the next edit or an explicit "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" tries once more, and until then those IDs stay locally owned so a re-hydration can’t overwrite them with the stale stored row."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every attempt is reported, so a handler that shows UI should gate on "},{"type":"codeVoice","code":"isFinal"},{"type":"text","text":". Most "},{"code":".save","type":"codeVoice"},{"type":"text","text":" failures are transient and are followed by a success the app never hears about."}]}],"name":"Note","style":"note","type":"aside"},{"level":3,"text":"Diagnostics: what isn’t a failure","anchor":"Diagnostics-what-isnt-a-failure","type":"heading"},{"inlineContent":[{"text":"Some conditions are worth acting on but aren’t errors, so routing them through ","type":"text"},{"code":"onFailure","type":"codeVoice"},{"text":" would be wrong. Duplicate rows are the clearest case: CloudKit forbids unique constraints, so several rows sharing an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" are a legitimate on-disk state, not a fault. They go to ","type":"text"},{"code":"onDiagnostic:","type":"codeVoice"},{"text":" instead:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards, collapse: EntityCollapse.byID { $0.updatedAt >= $1.updatedAt ? $0 : $1 })],","    container: container,","    onDiagnostic: { diagnostic in","        guard diagnostic.kind == .duplicateRowsCollapsed,","              let count = diagnostic.duplicateCount else { return }","        store.send(.offerDuplicateCleanup(count: count))","    }",")"]},{"type":"paragraph","inlineContent":[{"text":"Three kinds ship today:","type":"text"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Kind"}]}],[{"type":"paragraph","inlineContent":[{"text":"Means","type":"text"}]}],[{"inlineContent":[{"text":"Payload","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".duplicateRowsCollapsed","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A read found rows sharing an "},{"type":"codeVoice","code":"id"},{"text":". Without a ","type":"text"},{"type":"codeVoice","code":"collapse:"},{"text":" resolver they are harmless but permanent — this is what lets you ","type":"text"},{"inlineContent":[{"text":"offer","type":"text"}],"type":"emphasis"},{"text":" the cleanup.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"entityType"},{"text":", ","type":"text"},{"type":"codeVoice","code":"duplicateCount"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".possibleDispatchLoop"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"afterReduce"},{"text":" fired far more often in one debounce interval than a user could cause. Usually an effect or plugin dispatching on every state change. Reported once per burst, not once per dispatch.","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"drainCount"}]}]],[[{"inlineContent":[{"code":".writesUnpersisted","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The set of IDs whose last flush failed changed. Fires again with an ","type":"text"},{"inlineContent":[{"type":"text","text":"empty"}],"type":"strong"},{"text":" set once they land, so an indicator can be cleared rather than guessed at.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"entityType"},{"type":"text","text":", "},{"code":"unpersistedIDs","type":"codeVoice"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PersistenceDiagnostic"},{"text":" is a struct with static constructors rather than an enum, so a future kind can’t break an exhaustive ","type":"text"},{"type":"codeVoice","code":"switch"},{"text":" in your code — match on ","type":"text"},{"type":"codeVoice","code":"kind"},{"type":"text","text":" and read the payload you expect. Duplicate reads and dispatch loops are logged whether or not you supply a handler; the unpersisted set has no log of its own, because the individual "},{"type":"codeVoice","code":"PersistenceFailure"},{"text":"s behind it are already logged.","type":"text"}]},{"type":"heading","level":2,"anchor":"Step-5-Flush-on-background","text":"Step 5: Flush on background"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Writes are debounced, so drain them when the app is backgrounded or terminates:"}]},{"syntax":"swift","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await persistence.corePlugin.flush() }","    }","}"],"type":"codeListing"},{"anchor":"Multiple-entities-and-ordering","type":"heading","text":"Multiple entities and ordering","level":2},{"inlineContent":[{"type":"text","text":"Register one "},{"type":"codeVoice","code":".entity(\\.keyPath)"},{"type":"text","text":" per "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.decks), .entity(\\.cards), .entity(\\.tags)],","    container: try! ContainerFactory.makeLocalContainer(","        models: [DeckModel.self, CardModel.self, TagModel.self]","    )",")"]},{"type":"paragraph","inlineContent":[{"text":"Pass every generated ","type":"text"},{"code":"…Model","type":"codeVoice"},{"text":" type to the container’s ","type":"text"},{"code":"models:","type":"codeVoice"},{"text":". Writers flush in registration order — if entity B holds a ","type":"text"},{"code":"@Relation","type":"codeVoice"},{"text":" to A, register A’s entity first.","type":"text"}]},{"anchor":"Testing","type":"heading","level":2,"text":"Testing"},{"type":"paragraph","inlineContent":[{"text":"The whole stack runs against an in-memory SwiftData store, so persistence is unit-testable with no disk and no CloudKit:","type":"text"}]},{"type":"codeListing","code":["let container = try ContainerFactory.makeInMemoryContainer(models: [CardModel.self])","let db = EntityDB(modelContainer: container)","","try await db.upsert(Card(id: id, quote: \"hi\", createdAt: .now), as: CardModel.self)","let all = try await db.fetchAll(CardModel.self)","#expect(all.first?.quote == \"hi\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To prove the rule-#8 merge guarantee, seed the store, make a live in-memory edit, call "},{"type":"codeVoice","code":"coordinator.rehydrate(into:)"},{"type":"text","text":", and assert the live edit survives."}]}]}],"sections":[],"references":{"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","url":"\/documentation\/swidux\/buildingadomainplugin","type":"topic","role":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"title":"Building a Domain Plugin","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"type":"topic","title":"Add iCloud Sync","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"kind":"article","url":"\/documentation\/swidux\/howtoaddicloudsync"},"doc://Swidux/documentation/Swidux/PersistencePlugin":{"navigatorTitle":[{"kind":"identifier","text":"PersistencePlugin"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","url":"\/documentation\/swidux\/persistenceplugin","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Coalescing persistence plugin."}],"title":"PersistencePlugin","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistencePlugin"}]},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"title":"EntityStore","url":"\/documentation\/swidux\/entitystoreguide","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"topic","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","title":"Add a Parental Gate","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"kind":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate"},"doc://Swidux/documentation/Swidux/MacrosReference":{"type":"topic","kind":"article","title":"Macros","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","role":"article","url":"\/documentation\/swidux\/macrosreference","abstract":[{"text":"Reference for ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" and its property markers (the SwiftData persistence bridge, shipped in ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":").","type":"text"}]},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","role":"article","kind":"article","type":"topic","url":"\/documentation\/swidux\/persistencemiddlewareguide","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"title":"Persistence Middleware"},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","type":"topic","role":"article","abstract":[{"text":"Install the bundled ","type":"text"},{"code":"swidux-ref","type":"codeVoice"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"title":"Using the Swidux Agent Skill","kind":"article"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"type":"topic","kind":"article","title":"Troubleshooting","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","role":"article","abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"url":"\/documentation\/swidux\/troubleshooting"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","type":"topic","role":"collection","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","kind":"symbol"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","title":"Add a Paywall","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"kind":"article","url":"\/documentation\/swidux\/howtoaddapaywall"},"doc://Swidux/documentation/Swidux/EntityStore":{"title":"EntityStore","url":"\/documentation\/swidux\/entitystore","kind":"symbol","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityStore"}],"navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"abstract":[{"type":"text","text":"An ordered, keyed collection of identifiable entities that silently records"},{"type":"text","text":" "},{"type":"text","text":"every mutation for downstream persistence."}],"role":"symbol"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","type":"topic","role":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"title":"Add a Version Killswitch","kind":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","title":"Getting Started with Swidux","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"kind":"article","url":"\/documentation\/swidux\/gettingstarted"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"type":"topic","kind":"article","title":"Add Feature Flags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","role":"article","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddfeatureflags"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","url":"\/documentation\/swidux\/howtoaddanalytics","type":"topic","role":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"title":"Add Analytics","kind":"article"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"type":"topic","title":"Cancel Effects","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"kind":"article","url":"\/documentation\/swidux\/howtocanceleffects"}}}