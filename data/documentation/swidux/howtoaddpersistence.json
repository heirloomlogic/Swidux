{"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"],"anchor":"Related-Documentation","title":"Related Documentation"},{"anchor":"How-to-Guides","generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence"},"sections":[],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}],"title":"Add Persistence"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" turns persistence into a declare-and-register concern. You annotate a domain entity with ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":"; the macro generates its SwiftData ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" “shadow” class, the value↔model converters, and the ","type":"text"},{"code":"PersistableEntity","type":"codeVoice"},{"text":" conformance. A generic ","type":"text"},{"code":"EntityDB","type":"codeVoice"},{"text":" actor and a ","type":"text"},{"code":"PersistenceCoordinator","type":"codeVoice"},{"text":" build the container, synthesize one ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"text":" per registered ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":", and reuse the core ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference"},{"text":" for debounced, batched writes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Your reducers mutate plain value-type entities inside an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":"; the plugin observes the changelog and writes through to SwiftData after a debounce. Reads happen once, at launch, into memory — the in-memory "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":" is the source of truth."}]},{"type":"paragraph","inlineContent":[{"text":"For low-level manual wiring (writing your own ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":"), see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true},{"text":". For the macro details, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","isActive":true,"type":"reference"},{"text":". To add cross-device iCloud sync on top, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"text":"Before you start","anchor":"Before-you-start","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes a Swidux app already exists — "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"text":" are wired and the store is in the SwiftUI environment. If not, follow ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true,"type":"reference"},{"type":"text","text":" first."}]},{"inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" is a local-only persistence layer. It needs "},{"type":"strong","inlineContent":[{"text":"no iCloud, CloudKit, or Push entitlements","type":"text"}]},{"type":"text","text":" — only the sandbox "},{"type":"codeVoice","code":"com.apple.security.network.client"},{"type":"text","text":" entitlement if your app also makes network calls (killswitch, analytics, feature flags). Adding sync entitlements to a local-only app is dead configuration and an App Review risk."}],"type":"paragraph"},{"text":"Step 1: Add the dependency","level":2,"type":"heading","anchor":"Step-1-Add-the-dependency"},{"inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" product to your app target in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPersistence\",","    ]",")"],"syntax":"swift","type":"codeListing"},{"text":"Step 2: Annotate your domain entity with `@Persisted`","level":2,"anchor":"Step-2-Annotate-your-domain-entity-with-Persisted","type":"heading"},{"inlineContent":[{"text":"A persisted entity is a value type that already satisfies ","type":"text"},{"code":"Identifiable & Equatable & Sendable","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"ID == UUID","type":"codeVoice"},{"text":" (the ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" contract). Add ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["import SwiduxPersistence","","@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","    var createdAt: Date","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This generates a ","type":"text"},{"type":"codeVoice","code":"CardModel: @Model"},{"text":" class with ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"toDomain()","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"update(from:)","type":"codeVoice"},{"text":", plus ","type":"text"},{"code":"extension Card: PersistableEntity { typealias Model = CardModel }","type":"codeVoice"},{"text":". By default every stored property is mirrored directly onto the model — SwiftData persists scalars ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" composites natively, so no manual blob columns are needed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The generated model is ","type":"text"},{"inlineContent":[{"type":"text","text":"CloudKit-safe by construction"}],"type":"strong"},{"type":"text","text":", so the "},{"inlineContent":[{"type":"text","text":"same"}],"type":"emphasis"},{"text":" model backs both the local and the synced container (see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true},{"text":"). SwiftData’s CloudKit mirroring requires every non-optional attribute to be optional or carry a default value, and every relationship to be optional — validated when the ","type":"text"},{"type":"codeVoice","code":"ModelContainer"},{"text":" is created. ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" satisfies this automatically:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Non-optional mirrored attributes get a default.","type":"text"}]},{"type":"text","text":" If you wrote one on the domain property ("},{"type":"codeVoice","code":"var count: Int = 0"},{"type":"text","text":"), it is propagated verbatim; otherwise the macro fills a canonical default for the known SwiftData primitives ("},{"type":"codeVoice","code":"String → \"\""},{"type":"text","text":", "},{"type":"codeVoice","code":"Bool → false"},{"type":"text","text":", integers\/floats "},{"type":"codeVoice","code":"→ 0"},{"type":"text","text":", "},{"type":"codeVoice","code":"Date → .distantPast"},{"type":"text","text":", "},{"type":"codeVoice","code":"Data → Data()"},{"type":"text","text":", "},{"type":"codeVoice","code":"UUID → UUID()"},{"type":"text","text":"). Defaults are inert locally — "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" overwrites them on every load."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Non-primitive, non-optional properties"}]},{"type":"text","text":" (a custom "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" type, "},{"type":"codeVoice","code":"URL"},{"type":"text","text":", an enum) have no default the macro can invent. Give the property a default ("},{"type":"codeVoice","code":"= …"},{"text":"), make it optional, or mark it ","type":"text"},{"type":"codeVoice","code":"@Inline"},{"text":" — otherwise ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" emits a compile-time error.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Relationships are generated optional","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"var tags: [TagModel]? = nil"},{"type":"text","text":"); a non-optional to-one "},{"type":"codeVoice","code":"@Relation"},{"type":"text","text":" is a compile-time error (CloudKit forbids non-optional relationships)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" blob columns"}]},{"text":" default to ","type":"text"},{"type":"codeVoice","code":"Data()"},{"text":", so any ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" type is CloudKit-safe through ","type":"text"},{"type":"codeVoice","code":"@Inline"},{"text":". Because ","type":"text"},{"code":"Data()","type":"codeVoice"},{"type":"text","text":" is never decodable, a "},{"type":"strong","inlineContent":[{"text":"non-optional","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"@Inline"},{"type":"text","text":" property must also carry a domain default ("},{"type":"codeVoice","code":"= …"},{"type":"text","text":") — the generated getter falls back to it when the blob is missing or undecodable (e.g. a row CloudKit materialized before the blob synced). Omitting the default is a compile-time error ("},{"type":"codeVoice","code":"inlineRequiresDefault"},{"type":"text","text":")."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"code":"@Persisted","type":"codeVoice"},{"text":" lives on the ","type":"text"},{"type":"strong","inlineContent":[{"text":"entity","type":"text"}]},{"text":"; ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" lives on ","type":"text"},{"inlineContent":[{"text":"state containers","type":"text"}],"type":"strong"},{"type":"text","text":" ("},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" slices). They are different layers and never apply to the same type.","type":"text"}]},{"level":3,"type":"heading","anchor":"Marker-macros-for-non-trivial-properties","text":"Marker macros for non-trivial properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A macro can’t infer relationships, foreign keys, or which fields are derived. Four property markers (named to avoid SwiftData’s own "},{"type":"codeVoice","code":"@Relationship"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"@Transient"},{"type":"text","text":") tell "},{"type":"codeVoice","code":"@Persisted"},{"text":" what to do:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","","    @Inline var styling: TextStyling = TextStyling()  \/\/ one opaque JSON Data column","    @ForeignKey var deckID: UUID                      \/\/ scalar parent reference","    @Relation(deleteRule: .cascade, inverse: \\TagModel.card)","    var tags: [Tag]                                   \/\/ SwiftData relationship","    @Ignored var renderedPreview: String?             \/\/ derived; omitted from the model","}"]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Marker","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Effect"}]}]],[[{"inlineContent":[{"type":"emphasis","inlineContent":[{"text":"(none)","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"Mirror the property directly (SwiftData persists scalars and ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" composites).","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"@Inline","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Force a "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" value into a single JSON "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" column (keeps a CloudKit record compact; sidesteps SwiftData "},{"code":"Codable","type":"codeVoice"},{"text":"-attribute edge cases).","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@ForeignKey"}]}],[{"type":"paragraph","inlineContent":[{"text":"Intent marker on a ","type":"text"},{"type":"codeVoice","code":"UUID"},{"type":"text","text":"; functionally a mirrored scalar column."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"@Relation(deleteRule:inverse:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"A SwiftData relationship to another ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" entity. The property’s type references the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"domain"}]},{"type":"text","text":" type ("},{"code":"[Tag]","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Tag?","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Tag","type":"codeVoice"},{"text":"); the model substitutes the ","type":"text"},{"code":"…Model","type":"codeVoice"},{"type":"text","text":" shadow. "},{"type":"codeVoice","code":"inverse"},{"text":" is a key path on the generated model, e.g. ","type":"text"},{"code":"\\TagModel.card","type":"codeVoice"},{"text":". ","type":"text"},{"code":"deleteRule","type":"codeVoice"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"SwiduxDeleteRule"},{"text":" (","type":"text"},{"type":"codeVoice","code":".cascade"},{"text":", ","type":"text"},{"code":".nullify","type":"codeVoice"},{"text":", ","type":"text"},{"code":".noAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":".deny","type":"codeVoice"},{"text":").","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":"@Ignored"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Exclude a derived\/denormalized property. Must be optional so it can be reconstructed as ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" on load.","type":"text"}],"type":"paragraph"}]]]},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"@Persisted","type":"codeVoice"},{"text":" does not generate an ","type":"text"},{"code":"@Attribute(.unique)","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" — CloudKit forbids unique constraints. Identity is enforced by upsert-by-","type":"text"},{"type":"codeVoice","code":"id"},{"type":"text","text":" inside "},{"type":"codeVoice","code":"EntityDB"},{"text":", so the same generated model works for both local and synced containers.","type":"text"}]}]},{"type":"heading","text":"Step 3: Put the `EntityStore` on your state","anchor":"Step-3-Put-the-EntityStore-on-your-state","level":2},{"code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var cards: EntityStore<Card> = .init()","    \/\/ ... your other slices","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Your reducers mutate ","type":"text"},{"type":"codeVoice","code":"state.cards"},{"type":"text","text":" like any "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"text":" — ","type":"text"},{"type":"codeVoice","code":"state.cards[card.id] = card"},{"type":"text","text":", "},{"type":"codeVoice","code":"state.cards.modify(id) { … }"},{"type":"text","text":", "},{"type":"codeVoice","code":"state.cards[id] = nil"},{"type":"text","text":". Every change is recorded for the plugin to drain."}]},{"type":"heading","text":"Step 4: Build the coordinator and register the plugin","anchor":"Step-4-Build-the-coordinator-and-register-the-plugin","level":2},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":", build a local container, create a ","type":"text"},{"code":"PersistenceCoordinator","type":"codeVoice"},{"text":", register its plugin, and run first-load hydration before constructing the store:","type":"text"}]},{"code":["import SwiduxPersistence","","extension Store where State == AppState, Action == AppAction {","    static func configured() async -> AppStore {","        let container = try! ContainerFactory.makeLocalContainer(models: [CardModel.self])","","        let persistence = PersistenceCoordinator<AppState, AppAction>(","            entities: [.entity(\\.cards)],","            container: container,","            debounce: .milliseconds(250)","        )","","        let plugins = PluginHost<AppState, AppAction>()","        \/\/ Register UndoPlugin first if you use it — snapshots must precede writes.","        plugins.register(persistence.corePlugin)","","        var initial = AppState()","        await persistence.hydrate(into: &initial)   \/\/ first-load: fill EntityStores from disk","","        return Store(initialState: initial, reducer: { … }, plugins: plugins)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"hydrate(into:)","type":"codeVoice"},{"type":"text","text":" is "},{"type":"strong","inlineContent":[{"type":"text","text":"first-load only"}]},{"type":"text","text":" — it replaces each "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":" with the on-disk rows before any live edits exist. The only refresh path after launch is "},{"type":"codeVoice","code":"rehydrate(into:)"},{"type":"text","text":", which always "},{"type":"emphasis","inlineContent":[{"type":"text","text":"merges"}]},{"type":"text","text":" (preferring in-memory values) so a “refresh from disk” can never clobber unflushed writes or in-progress UI edits."}],"type":"paragraph"},{"text":"Surfacing failures","level":3,"type":"heading","anchor":"Surfacing-failures"},{"inlineContent":[{"type":"text","text":"Every save and fetch failure is logged, and the coordinator accepts an optional "},{"type":"codeVoice","code":"onFailure:"},{"type":"text","text":" handler to additionally surface it to your app (a failed "},{"type":"strong","inlineContent":[{"type":"text","text":"save"}]},{"type":"text","text":" means the in-memory data is "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" on disk; a failed "},{"type":"strong","inlineContent":[{"type":"text","text":"hydrate fetch"}]},{"type":"text","text":" leaves that "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":" untouched rather than presenting an unreadable store as “no data”):"}],"type":"paragraph"},{"code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    onFailure: { failure in","        \/\/ e.g. dispatch an action that shows a \"couldn't save\" banner","    }",")"],"type":"codeListing","syntax":"swift"},{"text":"Step 5: Flush on background","level":2,"type":"heading","anchor":"Step-5-Flush-on-background"},{"inlineContent":[{"type":"text","text":"Writes are debounced, so drain them when the app is backgrounded or terminates:"}],"type":"paragraph"},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await persistence.corePlugin.flush() }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Multiple entities and ordering","level":2,"type":"heading","anchor":"Multiple-entities-and-ordering"},{"inlineContent":[{"type":"text","text":"Register one "},{"type":"codeVoice","code":".entity(\\.keyPath)"},{"type":"text","text":" per "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.decks), .entity(\\.cards), .entity(\\.tags)],","    container: try! ContainerFactory.makeLocalContainer(","        models: [DeckModel.self, CardModel.self, TagModel.self]","    )",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Pass every generated "},{"type":"codeVoice","code":"…Model"},{"type":"text","text":" type to the container’s "},{"type":"codeVoice","code":"models:"},{"type":"text","text":". Writers flush in registration order — if entity B holds a "},{"type":"codeVoice","code":"@Relation"},{"type":"text","text":" to A, register A’s entity first."}],"type":"paragraph"},{"text":"Testing","level":2,"type":"heading","anchor":"Testing"},{"inlineContent":[{"type":"text","text":"The whole stack runs against an in-memory SwiftData store, so persistence is unit-testable with no disk and no CloudKit:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let container = try ContainerFactory.makeInMemoryContainer(models: [CardModel.self])","let db = EntityDB(modelContainer: container)","","try await db.upsert(Card(id: id, quote: \"hi\", createdAt: .now), as: CardModel.self)","let all = try await db.fetchAll(CardModel.self)","#expect(all.first?.quote == \"hi\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To prove the rule-#8 merge guarantee, seed the store, make a live in-memory edit, call "},{"code":"coordinator.rehydrate(into:)","type":"codeVoice"},{"type":"text","text":", and assert the live edit survives."}]}]}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddpersistence"]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"references":{"doc://Swidux/documentation/Swidux/EntityStore":{"url":"\/documentation\/swidux\/entitystore","role":"symbol","title"