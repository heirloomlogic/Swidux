{"variants":[{"paths":["\/documentation\/swidux\/howtoaddpersistence"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"Add Persistence","role":"article"},"sections":[],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"],"anchor":"Related-Documentation"},{"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"anchor":"How-to-Guides"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" turns persistence into a declare-and-register concern. You annotate a domain entity with "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":"; the macro generates its SwiftData "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" “shadow” class, the value↔model converters, and the "},{"type":"codeVoice","code":"PersistableEntity"},{"type":"text","text":" conformance. A generic "},{"type":"codeVoice","code":"EntityDB"},{"type":"text","text":" actor and a "},{"type":"codeVoice","code":"PersistenceCoordinator"},{"type":"text","text":" build the container, synthesize one "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" per registered "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":", and reuse the core "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"type":"text","text":" for debounced, batched writes."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Your reducers mutate plain value-type entities inside an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":"; the plugin observes the changelog and writes through to SwiftData after a debounce. Reads happen once, at launch, into memory — the in-memory "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" is the source of truth."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For low-level manual wiring (writing your own "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":"), see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},{"type":"text","text":". For the macro details, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"},{"type":"text","text":". To add cross-device iCloud sync on top, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Before you start","anchor":"Before-you-start","type":"heading"},{"inlineContent":[{"type":"text","text":"This guide assumes a Swidux app already exists — "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" are wired and the store is in the SwiftUI environment. If not, follow "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"type":"text","text":" first."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" is a local-only persistence layer. It needs "},{"type":"strong","inlineContent":[{"text":"no iCloud, CloudKit, or Push entitlements","type":"text"}]},{"type":"text","text":" — only the sandbox "},{"type":"codeVoice","code":"com.apple.security.network.client"},{"type":"text","text":" entitlement if your app also makes network calls (killswitch, analytics, feature flags). Adding sync entitlements to a local-only app is dead configuration and an App Review risk."}],"type":"paragraph"},{"level":2,"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPersistence\",","    ]",")"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Step 2: Annotate your domain entity with `@Persisted`","anchor":"Step-2-Annotate-your-domain-entity-with-Persisted","type":"heading"},{"inlineContent":[{"type":"text","text":"A persisted entity is a value type that already satisfies "},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"type":"text","text":" with "},{"type":"codeVoice","code":"ID == UUID"},{"type":"text","text":" (the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" contract). Add "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import SwiduxPersistence","","@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","    var createdAt: Date","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This generates a "},{"type":"codeVoice","code":"CardModel: @Model"},{"type":"text","text":" class with "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"toDomain()"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"update(from:)"},{"type":"text","text":", plus "},{"type":"codeVoice","code":"extension Card: PersistableEntity { typealias Model = CardModel }"},{"type":"text","text":". By default every stored property is mirrored directly onto the model — SwiftData persists scalars "},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" composites natively, so no manual blob columns are needed."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The generated model is "},{"type":"strong","inlineContent":[{"text":"CloudKit-safe by construction","type":"text"}]},{"type":"text","text":", so the "},{"type":"emphasis","inlineContent":[{"text":"same","type":"text"}]},{"type":"text","text":" model backs both the local and the synced container (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},{"type":"text","text":"). SwiftData’s CloudKit mirroring requires every non-optional attribute to be optional or carry a default value, and every relationship to be optional — validated when the "},{"type":"codeVoice","code":"ModelContainer"},{"type":"text","text":" is created. "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" satisfies this automatically:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Non-optional mirrored attributes get a default.","type":"text"}],"type":"strong"},{"text":" If you wrote one on the domain property (","type":"text"},{"code":"var count: Int = 0","type":"codeVoice"},{"text":"), it is propagated verbatim; otherwise the macro fills a canonical default for the known SwiftData primitives (","type":"text"},{"code":"String → \"\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Bool → false","type":"codeVoice"},{"text":", integers\/floats ","type":"text"},{"code":"→ 0","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Date → .distantPast","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Data → Data()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"UUID → UUID()","type":"codeVoice"},{"text":"). Defaults are inert locally — ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" overwrites them on every load.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Non-primitive, non-optional properties","type":"text"}],"type":"strong"},{"text":" (a custom ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" type, ","type":"text"},{"code":"URL","type":"codeVoice"},{"text":", an enum) have no default the macro can invent. Give the property a default (","type":"text"},{"code":"= …","type":"codeVoice"},{"text":"), make it optional, or mark it ","type":"text"},{"code":"@Inline","type":"codeVoice"},{"text":" — otherwise ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" emits a compile-time error.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Relationships are generated optional","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"code":"var tags: [TagModel]? = nil","type":"codeVoice"},{"text":"); a non-optional to-one ","type":"text"},{"code":"@Relation","type":"codeVoice"},{"text":" is a compile-time error (CloudKit forbids non-optional relationships).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"@Inline","type":"codeVoice"},{"text":" blob columns","type":"text"}],"type":"strong"},{"text":" default to ","type":"text"},{"code":"Data()","type":"codeVoice"},{"text":", so any ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" type is CloudKit-safe through ","type":"text"},{"code":"@Inline","type":"codeVoice"},{"text":". Because ","type":"text"},{"code":"Data()","type":"codeVoice"},{"text":" is never decodable, a ","type":"text"},{"inlineContent":[{"text":"non-optional","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"@Inline","type":"codeVoice"},{"text":" property must also carry a domain default (","type":"text"},{"code":"= …","type":"codeVoice"},{"text":") — the generated getter falls back to it when the blob is missing or undecodable (e.g. a row CloudKit materialized before the blob synced). Omitting the default is a compile-time error (","type":"text"},{"code":"inlineRequiresDefault","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" lives on the "},{"type":"strong","inlineContent":[{"text":"entity","type":"text"}]},{"type":"text","text":"; "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" lives on "},{"type":"strong","inlineContent":[{"text":"state containers","type":"text"}]},{"text":" (","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" slices). They are different layers and never apply to the same type.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Marker macros for non-trivial properties","anchor":"Marker-macros-for-non-trivial-properties","type":"heading"},{"inlineContent":[{"type":"text","text":"A macro can’t infer relationships, foreign keys, or which fields are derived. Four property markers (named to avoid SwiftData’s own "},{"type":"codeVoice","code":"@Relationship"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"@Transient"},{"type":"text","text":") tell "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" what to do:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@Persisted","nonisolated struct Card: Identifiable, Equatable, Sendable {","    var id: UUID","    var quote: String","","    @Inline var styling: TextStyling = TextStyling()  \/\/ one opaque JSON Data column","    @ForeignKey var deckID: UUID                      \/\/ scalar parent reference","    @Relation(deleteRule: .cascade, inverse: \\TagModel.card)","    var tags: [Tag]                                   \/\/ SwiftData relationship","    @Ignored var renderedPreview: String?             \/\/ derived; omitted from the model","}"]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Marker","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Effect","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"(none)","type":"text"}],"type":"emphasis"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Mirror the property directly (SwiftData persists scalars and ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" composites).","type":"text"}]}]],[[{"inlineContent":[{"code":"@Inline","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Force a "},{"type":"codeVoice","code":"Codable"},{"text":" value into a single JSON ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":" column (keeps a CloudKit record compact; sidesteps SwiftData ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":"-attribute edge cases).","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@ForeignKey"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Intent marker on a ","type":"text"},{"type":"codeVoice","code":"UUID"},{"text":"; functionally a mirrored scalar column.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@Relation(deleteRule:inverse:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A SwiftData relationship to another ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" entity. The property’s type references the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"domain","type":"text"}]},{"text":" type (","type":"text"},{"type":"codeVoice","code":"[Tag]"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Tag?"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Tag"},{"text":"); the model substitutes the ","type":"text"},{"type":"codeVoice","code":"…Model"},{"text":" shadow. ","type":"text"},{"type":"codeVoice","code":"inverse"},{"text":" is a key path on the generated model, e.g. ","type":"text"},{"type":"codeVoice","code":"\\TagModel.card"},{"text":". ","type":"text"},{"type":"codeVoice","code":"deleteRule"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"SwiduxDeleteRule"},{"text":" (","type":"text"},{"type":"codeVoice","code":".cascade"},{"text":", ","type":"text"},{"type":"codeVoice","code":".nullify"},{"text":", ","type":"text"},{"type":"codeVoice","code":".noAction"},{"text":", ","type":"text"},{"type":"codeVoice","code":".deny"},{"text":").","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"@Ignored"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Exclude a derived\/denormalized property. Must be optional so it can be reconstructed as ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" on load.","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" does not generate an ","type":"text"},{"type":"codeVoice","code":"@Attribute(.unique)"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" — CloudKit forbids unique constraints — so the same generated model works for both local and synced containers. The cost is that rows sharing an ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" are possible. ","type":"text"},{"type":"codeVoice","code":"EntityDB"},{"text":" handles them by converging rather than by assuming uniqueness: writes update every matching row, deletions remove every matching row, and ","type":"text"},{"type":"codeVoice","code":"fetchAll"},{"text":" collapses to one value per ","type":"text"},{"type":"codeVoice","code":"id"},{"text":". Nothing deletes a duplicate as a side effect of a write.","type":"text"}],"type":"paragraph"}]},{"type":"heading","text":"Step 3: Put the `EntityStore` on your state","level":2,"anchor":"Step-3-Put-the-EntityStore-on-your-state"},{"syntax":"swift","type":"codeListing","code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var cards: EntityStore<Card> = .init()","    \/\/ ... your other slices","}"]},{"type":"paragraph","inlineContent":[{"text":"Your reducers mutate ","type":"text"},{"code":"state.cards","type":"codeVoice"},{"text":" like any ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" — ","type":"text"},{"code":"state.cards[card.id] = card","type":"codeVoice"},{"text":", ","type":"text"},{"code":"state.cards.modify(id) { … }","type":"codeVoice"},{"text":", ","type":"text"},{"code":"state.cards[id] = nil","type":"codeVoice"},{"text":". Every change is recorded for the plugin to drain.","type":"text"}]},{"type":"heading","text":"Step 4: Build the coordinator and register the plugin","level":2,"anchor":"Step-4-Build-the-coordinator-and-register-the-plugin"},{"type":"paragraph","inlineContent":[{"text":"In ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":", build a local container, create a ","type":"text"},{"code":"PersistenceCoordinator","type":"codeVoice"},{"text":", register its plugin, and run first-load hydration before constructing the store:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxPersistence","","extension Store where State == AppState, Action == AppAction {","    static func configured() async -> AppStore {","        let container = try! ContainerFactory.makeLocalContainer(models: [CardModel.self])","","        let persistence = PersistenceCoordinator<AppState, AppAction>(","            entities: [.entity(\\.cards)],","            container: container,","            debounce: .milliseconds(250)","        )","","        let plugins = PluginHost<AppState, AppAction>()","        \/\/ Register UndoPlugin first if you use it — snapshots must precede writes.","        plugins.register(persistence.corePlugin)","","        var initial = AppState()","        await persistence.hydrate(into: &initial)   \/\/ first-load: fill EntityStores from disk","","        return Store(initialState: initial, reducer: { … }, plugins: plugins)","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"hydrate(into:)","type":"codeVoice"},{"text":" is ","type":"text"},{"inlineContent":[{"text":"first-load only","type":"text"}],"type":"strong"},{"text":" — it replaces each ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" with the on-disk rows before any live edits exist. It takes ","type":"text"},{"code":"inout State","type":"codeVoice"},{"text":" because it runs ","type":"text"},{"inlineContent":[{"text":"before the store is built","type":"text"}],"type":"emphasis"},{"text":", so there is nothing to race with.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The only refresh path after launch is ","type":"text"},{"code":"rehydrate(into:)","type":"codeVoice"},{"text":", which ","type":"text"},{"inlineContent":[{"text":"reconciles","type":"text"}],"type":"emphasis"},{"text":" rather than replaces: rows on disk are authoritative except for IDs that still carry unflushed local intent, which always win. So a “refresh from disk” can never clobber pending writes or in-progress UI edits, while remote edits and deletions still surface mid-session. Pass ","type":"text"},{"code":"policy:","type":"codeVoice"},{"text":" — or register an entity with ","type":"text"},{"code":"policy:","type":"codeVoice"},{"text":" — to narrow that; see ","type":"text"},{"code":"MergePolicy","type":"codeVoice"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It takes the ","type":"text"},{"inlineContent":[{"text":"store","type":"text"}],"type":"strong"},{"text":", not ","type":"text"},{"code":"inout State","type":"codeVoice"},{"text":": re-hydration is asynchronous, and a caller holding a state snapshot across those ","type":"text"},{"code":"await","type":"codeVoice"},{"text":"s would discard everything dispatched while they were in flight. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","isActive":true,"type":"reference"},{"text":" if edits are vanishing after a load.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If you need to ","type":"text"},{"inlineContent":[{"text":"read","type":"text"}],"type":"emphasis"},{"text":" rows without touching state, don’t re-hydrate into a throwaway ","type":"text"},{"code":"AppState()","type":"codeVoice"},{"text":" — that idiom breaks silently the moment re-hydration starts reading the state it is handed. Use ","type":"text"},{"code":"fetchAll(of:)","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"snapshot(of:)","type":"codeVoice"},{"text":" on the coordinator instead.","type":"text"}]},{"type":"heading","text":"Reading rows without touching state","level":3,"anchor":"Reading-rows-without-touching-state"},{"type":"paragraph","inlineContent":[{"text":"For exports, migrations, diagnostics, or any other “what’s actually on disk?” question, read directly — naming your domain type, not its generated shadow:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let notes = try await persistence.fetchAll(of: Note.self)","let store = try await persistence.snapshot(of: Note.self)   \/\/ as an EntityStore"]},{"type":"paragraph","inlineContent":[{"text":"Both flush the debounce window first by default, so they can’t return a stale row for something the user just edited; pass ","type":"text"},{"code":"flushPending: false","type":"codeVoice"},{"text":" on a hot path where that doesn’t matter. Both report failures to ","type":"text"},{"code":"onFailure","type":"codeVoice"},{"text":" ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"text":" rethrow — there is no state to leave untouched here, so swallowing the error could only present an unreadable database as “no data”.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The entity does not have to be registered with the coordinator; reading a model that is in the container’s schema but not mirrored into state is fine.","type":"text"}]},{"name":"Important","type":"aside","style":"important","content":[{"inlineContent":[{"text":"Don’t answer these questions by re-hydrating into a throwaway ","type":"text"},{"type":"codeVoice","code":"AppState()"},{"text":". That reads like a pure fetch but is really a merge, and it breaks silently the moment re-hydration starts consulting the state it is handed.","type":"text"}],"type":"paragraph"}]},{"type":"heading","text":"Surfacing failures","level":3,"anchor":"Surfacing-failures"},{"type":"paragraph","inlineContent":[{"text":"Every save and fetch failure is logged, and the coordinator accepts an optional ","type":"text"},{"code":"onFailure:","type":"codeVoice"},{"text":" handler to additionally surface it to your app (a failed ","type":"text"},{"inlineContent":[{"text":"save","type":"text"}],"type":"strong"},{"text":" means the in-memory data is ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" on disk; a failed ","type":"text"},{"inlineContent":[{"text":"hydrate fetch","type":"text"}],"type":"strong"},{"text":" leaves that ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":" untouched rather than presenting an unreadable store as “no data”):","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.cards)],","    container: container,","    onFailure: { failure in","        \/\/ e.g. dispatch an action that shows a \"couldn't save\" banner","    }",")"]},{"type":"heading","text":"Step 5: Flush on background","level":2,"anchor":"Step-5-Flush-on-background"},{"type":"paragraph","inlineContent":[{"text":"Writes are debounced, so drain them when the app is backgrounded or terminates:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await persistence.corePlugin.flush() }","    }","}"]},{"type":"heading","text":"Multiple entities and ordering","level":2,"anchor":"Multiple-entities-and-ordering"},{"type":"paragraph","inlineContent":[{"text":"Register one ","type":"text"},{"code":".entity(\\.keyPath)","type":"codeVoice"},{"text":" per ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let persistence = PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.decks), .entity(\\.cards), .entity(\\.tags)],","    container: try! ContainerFactory.makeLocalContainer(","        models: [DeckModel.self, CardModel.self, TagModel.self]","    )",")"]},{"type":"paragraph","inlineContent":[{"text":"Pass every generated ","type":"text"},{"code":"…Model","type":"codeVoice"},{"text":" type to the container’s ","type":"text"},{"code":"models:","type":"codeVoice"},{"text":". Writers flush in registration order — if entity B holds a ","type":"text"},{"code":"@Relation","type":"codeVoice"},{"text":" to A, register A’s entity first.","type":"text"}]},{"type":"heading","text":"Testing","level":2,"anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"The whole stack runs against an in-memory SwiftData store, so persistence is unit-testable with no disk and no CloudKit:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let container = try ContainerFactory.makeInMemoryContainer(models: [CardModel.self])","let db = EntityDB(modelContainer: container)","","try await db.upsert(Card(id: id, quote: \"hi\", createdAt: .now), as: CardModel.self)","let all = try await db.fetchAll(CardModel.self)","#expect(all.first?.quote == \"hi\")"]},{"type":"paragraph","inlineContent":[{"text":"To prove the rule-#8 merge guarantee, seed the store, make a live in-memory edit, call ","type":"text"},{"code":"coordinator.rehydrate(into:)","type":"codeVoice"},{"text":", and assert the live edit survives.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","interfaceLanguage":"swift"},"hierar