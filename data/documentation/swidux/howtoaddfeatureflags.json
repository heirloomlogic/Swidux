{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddfeatureflags"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" is a domain plugin that owns a "},{"code":"FeatureFlagsState","type":"codeVoice"},{"type":"text","text":" slice, fetches a Swidux-defined JSON wire format via a provider-agnostic "},{"code":"FeatureFlagsService","type":"codeVoice"},{"type":"text","text":", and answers reads against state. Bucketing is pure FNV-1a — same input always produces the same bucket, no network round-trip per read. Local overrides give QA a one-action toggle that wins over remote evaluation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an API-level reference, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","type":"reference","isActive":true},{"type":"text","text":". For where domain plugins fit in the dispatch cycle, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"heading","text":"Before you start","level":2,"anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes you have a Swidux app already wired up — "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and "},{"code":"AppStore","type":"codeVoice"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference","isActive":true},{"type":"text","text":" first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You also need somewhere to host a JSON file. Any URL works — Cloudflare Pages, R2, S3, a Worker, your own backend. The plugin doesn’t care. "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"type":"text","text":" is a runnable Cloudflare Worker that serves feature-flag "},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" killswitch config for every app in a portfolio from one URL and one KV namespace, keyed "},{"type":"codeVoice","code":"GET \/<appID>\/<resource>"},{"type":"text","text":" — point this plugin at "},{"type":"codeVoice","code":"https:\/\/<host>\/<appID>\/flags"},{"type":"text","text":"."}]},{"type":"heading","text":"Step 1: Add the dependency","level":2,"anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxFeatureFlags\",","    ]",")"]},{"type":"heading","text":"Step 2: Add a state slice and action case","level":2,"anchor":"Step-2-Add-a-state-slice-and-action-case"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxFeatureFlags","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var featureFlags: FeatureFlagsState = .init()","    \/\/ ... your other slices","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"AppAction.swift"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["enum AppAction: Sendable {","    case featureFlags(FeatureFlagsAction)","    \/\/ ... your other cases","}"]},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"import SwiduxFeatureFlags","type":"codeVoice"},{"text":" is needed in ","type":"text"},{"inlineContent":[{"text":"every","type":"text"}],"type":"emphasis"},{"text":" file that touches ","type":"text"},{"code":"store.featureFlags.*","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"FeatureFlagsAction","type":"codeVoice"},{"text":" — including views that read flags for display. ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"type":"aside","style":"tip","name":"Tip"},{"type":"heading","text":"Step 3: Hydrate state and register the plugin","level":2,"anchor":"Step-3-Hydrate-state-and-register-the-plugin"},{"type":"paragraph","inlineContent":[{"text":"At app launch, hydrate state from your ","type":"text"},{"type":"codeVoice","code":"KeyValueStore"},{"text":" (so the install ID and last-known-good config survive cold launches), then register the plugin:","type":"text"}]},{"syntax":"swift","code":["let kv = UserDefaultsKeyValueStore()","let initial = AppState(","    featureFlags: .hydrated(from: kv)",")","","let store = Store(initialState: initial, reducer: AppReducer())","","\/\/ With the Examples\/ConfigWorker setup this is the shared portfolio URL:","\/\/ \"https:\/\/<host>\/<appID>\/flags\". Any URL returning FeatureFlagsConfig works.","let configURL = URL(static: \"https:\/\/<host>\/<appID>\/flags\")","","let flags = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags,","    action: AppAction.featureFlags,","    extractAction: { if case .featureFlags(let a) = $0 { return a } else { return nil } },","    service: HTTPFeatureFlagsService(url: configURL),","    keyValueStore: kv",")","store.register(plugin: flags)"],"type":"codeListing"},{"anchor":"Step-4-Declare-typed-flag-keys","type":"heading","level":2,"text":"Step 4: Declare typed flag keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare each flag once on a namespace so reads are type-safe:"}]},{"syntax":"swift","code":["extension BoolFlag {","    static let newOnboarding = BoolFlag(\"new_onboarding\")","}","","enum CheckoutVariant: String { case control, treatment }","","extension VariantFlag where Variant == CheckoutVariant {","    static let checkoutLayout = VariantFlag(\"checkout_layout\", default: .control)","}","","extension ValueFlag where Value == Int {","    static let maxFreeUploads = ValueFlag(\"max_free_uploads\", default: 5)","}"],"type":"codeListing"},{"anchor":"Step-5-Read-flags-from-views","type":"heading","level":2,"text":"Step 5: Read flags from views"},{"syntax":"swift","code":["if store.featureFlags.isEnabled(.newOnboarding) {","    NewOnboardingView()","}","","let layout = store.featureFlags.variant(of: .checkoutLayout)","let cap = store.featureFlags.value(of: .maxFreeUploads)"],"type":"codeListing"},{"level":2,"anchor":"Step-6-Refresh-on-foreground","text":"Step 6: Refresh on foreground","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The plugin debounces ","type":"text"},{"type":"codeVoice","code":".refresh"},{"type":"text","text":" against the configured "},{"type":"codeVoice","code":"RefreshPolicy"},{"type":"text","text":", so it’s safe to dispatch on every "},{"type":"codeVoice","code":"scenePhase"},{"type":"text","text":" transition:"}]},{"code":[".onChange(of: scenePhase) { _, phase in","    i