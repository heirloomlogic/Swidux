{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"paths":["\/documentation\/swidux\/howtoaddfeatureflags"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","role":"article","title":"Add Feature Flags","modules":[{"name":"Swidux"}]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" is a domain plugin that owns a ","type":"text"},{"code":"FeatureFlagsState","type":"codeVoice"},{"text":" slice, fetches a Swidux-defined JSON wire format via a provider-agnostic ","type":"text"},{"code":"FeatureFlagsService","type":"codeVoice"},{"text":", and answers reads against state. Bucketing is pure FNV-1a — same input always produces the same bucket, no network round-trip per read. Local overrides give QA a one-action toggle that wins over remote evaluation.","type":"text"}]},{"inlineContent":[{"text":"For an API-level reference, see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},{"type":"text","text":". For where domain plugins fit in the dispatch cycle, see "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Before-you-start","text":"Before you start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes you have a Swidux app already wired up — "},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true,"type":"reference"},{"text":" first.","type":"text"}]},{"inlineContent":[{"type":"text","text":"You also need somewhere to host a JSON file. Any URL works — Cloudflare Pages, R2, S3, a Worker, your own backend. The plugin doesn’t care. "},{"code":"Examples\/ConfigWorker\/","type":"codeVoice"},{"type":"text","text":" is a runnable Cloudflare Worker that serves feature-flag "},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"type":"text","text":" killswitch config for every app in a portfolio from one URL and one KV namespace, keyed "},{"type":"codeVoice","code":"GET \/<appID>\/<resource>"},{"type":"text","text":" — point this plugin at "},{"type":"codeVoice","code":"https:\/\/<host>\/<appID>\/flags"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Step 1: Add the dependency","type":"heading","anchor":"Step-1-Add-the-dependency","level":2},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" product to your app target in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxFeatureFlags\",","    ]",")"]},{"anchor":"Step-2-Add-a-state-slice-and-action-case","type":"heading","level":2,"text":"Step 2: Add a state slice and action case"},{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import SwiduxFeatureFlags","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var featureFlags: FeatureFlagsState = .init()","    \/\/ ... your other slices","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"In ","type":"text"},{"code":"AppAction.swift","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["enum AppAction: Sendable {","    case featureFlags(FeatureFlagsAction)","    \/\/ ... your other cases","}"]},{"level":2,"type":"heading","text":"Step 3: Hydrate state and register the plugin","anchor":"Step-3-Hydrate-state-and-register-the-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"At app launch, hydrate state from your "},{"code":"KeyValueStore","type":"codeVoice"},{"text":" (so the install ID and last-known-good config survive cold launches), then register the plugin:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let kv = UserDefaultsKeyValueStore()","let initial = AppState(","    featureFlags: .hydrated(from: kv)",")","","let store = Store(initialState: initial, reducer: AppReducer())","","\/\/ With the Examples\/ConfigWorker setup this is the shared portfolio URL:","\/\/ \"https:\/\/<host>\/<appID>\/flags\". Any URL returning FeatureFlagsConfig works.","let configURL = URL(static: \"https:\/\/<host>\/<appID>\/flags\")","","let flags = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags,","    action: AppAction.featureFlags,","    extractAction: { if case .featureFlags(let a) = $0 { return a } else { return nil } },","    service: HTTPFeatureFlagsService(url: configURL),","    keyValueStore: kv",")","store.register(plugin: flags)"]},{"anchor":"Step-4-Declare-typed-flag-keys","level":2,"text":"Step 4: Declare typed flag keys","type":"heading"},{"inlineContent":[{"text":"Declare each flag once on a namespace so reads are type-safe:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["extension BoolFlag {","    static let newOnboarding = BoolFlag(\"new_onboarding\")","}","","enum CheckoutVariant: String { case control, treatment }","","extension VariantFlag where Variant == CheckoutVariant {","    static let checkoutLayout = VariantFlag(\"checkout_layout\", default: .control)","}","","extension ValueFlag where Value == Int {","    static let maxFreeUploads = ValueFlag(\"max_free_uploads\", default: 5)","}"],"type":"codeListing"},{"anchor":"Step-5-Read-flags-from-views","level":2,"text":"Step 5: Read flags from views","type":"heading"},{"syntax":"swift","code":["if store.featureFlags.isEnabled(.newOnboarding) {","    NewOnboardingView()","}","","let layout = store.featureFlags.variant(of: .checkoutLayout)","let cap = store.featureFlags.value(of: .maxFreeUploads)"],"type":"codeListing"},{"level":2,"type":"heading","text":"Step 6: Refresh on foreground","anchor":"Step-6-Refresh-on-foreground"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin debounces "},{"type":"codeVoice","code":".refresh"},{"type":"text","text":" against the configured "},{"type":"codeVoice","code":"RefreshPolicy"},{"type":"text","text":", so it’s safe to dispatch on every "},{"type":"codeVoice","code":"scenePhase"},{"text":" transition:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .active { store.send(.featureFlags(.refresh)) }","}"]},{"inlineContent":[{"text":"For wire format, bucketing, and exposure tracking details, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"kind":"article","seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersion