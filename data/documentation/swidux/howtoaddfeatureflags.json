{"variants":[{"paths":["\/documentation\/swidux\/howtoaddfeatureflags"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"modules":[{"name":"Swidux"}],"title":"Add Feature Flags","role":"article","roleHeading":"Article"},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"title":"How-to Guides","anchor":"How-to-Guides"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" is a domain plugin that owns a "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":" slice, fetches a Swidux-defined JSON wire format via a provider-agnostic "},{"type":"codeVoice","code":"FeatureFlagsService"},{"type":"text","text":", and answers reads against state. Bucketing is pure FNV-1a — same input always produces the same bucket, no network round-trip per read. Local overrides give QA a one-action toggle that wins over remote evaluation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an API-level reference, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","isActive":true},{"type":"text","text":". For where domain plugins fit in the dispatch cycle, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Before you start","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes you have a Swidux app already wired up — "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"type":"text","text":" first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You also need somewhere to host a JSON file. Any URL works — Cloudflare Pages, R2, S3, a Worker, your own backend. The plugin doesn’t care. "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"type":"text","text":" is a runnable Cloudflare Worker that serves feature-flag "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" killswitch config for every app in a portfolio from one URL and one KV namespace, keyed "},{"type":"codeVoice","code":"GET \/<appID>\/<resource>"},{"type":"text","text":" — point this plugin at "},{"type":"codeVoice","code":"https:\/\/<host>\/<appID>\/flags"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxFeatureFlags\",","    ]",")"]},{"type":"heading","level":2,"text":"Step 2: Add a state slice and action case","anchor":"Step-2-Add-a-state-slice-and-action-case"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxFeatureFlags","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var featureFlags: FeatureFlagsState = .init()","    \/\/ ... your other slices","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"AppAction.swift"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["enum AppAction: Sendable {","    case featureFlags(FeatureFlagsAction)","    \/\/ ... your other cases","}"]},{"name":"Tip","style":"tip","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"code":"import SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" file that touches "},{"code":"store.featureFlags.*","type":"codeVoice"},{"type":"text","text":" or "},{"code":"FeatureFlagsAction","type":"codeVoice"},{"type":"text","text":" — including views that read flags for display. "},{"code":"@_exported import Swidux","type":"codeVoice"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"type":"heading","level":2,"text":"Step 3: Hydrate state and register the plugin","anchor":"Step-3-Hydrate-state-and-register-the-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"At app launch, mint a stable per-install "},{"inlineContent":[{"type":"text","text":"device ID"}],"type":"strong"},{"type":"text","text":" (Keychain-backed so it survives reinstall — this is the bucketing identity), hydrate state from your "},{"type":"codeVoice","code":"KeyValueStore"},{"type":"text","text":" (so the last-known-good config survives cold launches), then register the plugin. Add "},{"type":"codeVoice","code":"var deviceID: String = \"\""},{"type":"text","text":" to "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" and point "},{"type":"codeVoice","code":"deviceIDKeyPath"},{"type":"text","text":" at it:"}]},{"syntax":"swift","type":"codeListing","code":["let kv = UserDefaultsKeyValueStore()                       \/\/ flags config cache","","\/\/ Stable bucketing identity — Keychain so it survives reinstall, and shared","\/\/ with analytics: AnalyticsIdentity(userID: \\.deviceID, …).","let deviceID = KeychainKeyValueStore(service: \"com.example.app\").deviceIdentity()","","let initial = AppState(","    featureFlags: .hydrated(from: kv, deviceID: deviceID),","    deviceID: deviceID",")","","let store = Store(initialState: initial, reducer: AppReducer())","","\/\/ With the Examples\/ConfigWorker setup this is the shared portfolio URL:","\/\/ \"https:\/\/<host>\/<appID>\/flags\". Any URL returning FeatureFlagsConfig works.","let configURL = URL(static: \"https:\/\/<host>\/<appID>\/flags\")","","let flags = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags,","    action: AppAction.featureFlags,","    extractAction: { if case .featureFlags(let a) = $0 { return a } else { return nil } },","    service: HTTPFeatureFlagsService(url: configURL),","    deviceIDKeyPath: \\.deviceID,","    keyValueStore: kv",")","store.register(plugin: flags)"]},{"type":"heading","level":2,"text":"Step 4: Declare typed flag keys","anchor":"Step-4-Declare-typed-flag-keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare each flag once on a namespace so reads are type-safe:"}]},{"syntax":"swift","type":"codeListing","code":["extension BoolFlag {","    static let newOnboarding = BoolFlag(\"new_onboarding\")","}","","enum CheckoutVariant: String { case control, treatment }","","extension VariantFlag where Variant == CheckoutVariant {","    static let checkoutLayout = VariantFlag(\"checkout_layout\", default: .control)","}","","extension ValueFlag where Value == Int {","    static let maxFreeUploads = ValueFlag(\"max_free_uploads\", default: 5)","}"]},{"type":"heading","level":2,"text":"Step 5: Read flags from views","anchor":"Step-5-Read-flags-from-views"},{"syntax":"swift","type":"codeListing","code":["if store.featureFlags.isEnabled(.newOnboarding) {","    NewOnboardingView()","}","","let layout = store.featureFlags.variant(of: .checkoutLayout)","let cap = store.featureFlags.value(of: .maxFreeUploads)"]},{"type":"heading","level":2,"text":"Step 6: Refresh on foreground","anchor":"Step-6-Refresh-on-foreground"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin debounces "},{"type":"codeVoice","code":".refresh"},{"type":"text","text":" against the configured "},{"type":"codeVoice","code":"RefreshPolicy"},{"type":"text","text":", so it’s safe to dispatch on every "},{"type":"codeVoice","code":"scenePhase"},{"type":"text","text":" transition:"}]},{"syntax":"swift","type":"codeListing","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .active { store.send(.featureFlags(.refresh)) }","}"]},{"type":"heading","level":2,"text":"Step 7: Guard against forever flags","anchor":"Step-7-Guard-against-forever-flags"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Give every flag a required owner and expiry, and add one CI test that fails when a flag outlives its expiry. Declare a manifest alongside the typed keys — the factory "},{"type":"codeVoice","code":"owner"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"expires"},{"type":"text","text":" parameters are non-optional, and the keys are single-sourced from the flag declarations:"}]},{"syntax":"swift","type":"codeListing","code":["enum FlagManifest {","    static let all: [FlagDescriptor] = [","        .bool(.newOnboarding, owner: \"growth\",","              expires: Date(timeIntervalSince1970: 1_788_000_000), purpose: \"New onboarding flow\"),","        .variant(.checkoutLayout, owner: \"checkout\",","                 expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Checkout A\/B\"),","        .value(.maxFreeUploads, owner: \"platform\",","               expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Free upload cap\"),","    ]","}","","@Test func noForeverFlags() {","    let report = FlagGovernance.expirationReport(FlagManifest.all)","    #expect(report == nil, \"\\(report ?? \"\")\")   \/\/ failure names each expired flag + owner","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is a pure compile-time \/ test concern — no wire-format change and no effect on runtime evaluation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For wire format, bucketing, exposure tracking, and governance details, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"references":{"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"kind":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddanalytics","title":"Add Analytics","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","kind":"symbol","role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux","type":"topic","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"url":"\/documentation\/swidux\/gettingstarted","kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","title":"Getting Started with Swidux","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"url":"\/documentation\/swidux\/pluginfeatureflagsreference","kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","title":"SwiduxFeatureFlags Reference","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"role":"article","title":"Building a Domain Plugin","kind":"article","type":"topic","url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":" plugin and the "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" macro — no hand-written "},{"code":"@Model","type":"codeVoice"},{"type":"text","text":" classes, database actors, or "},{"code":"StateWriter","type":"codeVoice"},{"type":"text","text":" closures."}],"kind":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddpersistence","title":"Add Persistence","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":" with the "},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"kind":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddicloudsync","title":"Add iCloud Sync","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"url":"\/documentation\/swidux\/pluginarchitecture","kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","title":"Plugin Architecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"kind":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddaparentalgate","title":"Add a Parental Gate","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"kind":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","title":"Add a Version Killswitch","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch"},"doc://Swidux/documentation/Swidux/AgentSkill":{"abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"kind":"article","type":"topic","url":"\/documentation\/swidux\/agentskill","title":"Using the Swidux Agent Skill","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"kind":"article","type":"topic","url":"\/documentation\/swidux\/howtocanceleffects","title":"Cancel Effects","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"url":"\/documentation\/swidux\/howtoaddapaywall","kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"type":"topic"}}}