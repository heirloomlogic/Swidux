{"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"anchor":"How-to-Guides","title":"How-to Guides"}],"kind":"article","metadata":{"role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"Add Feature Flags"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" is a domain plugin that owns a "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":" slice, fetches a Swidux-defined JSON wire format via a provider-agnostic "},{"type":"codeVoice","code":"FeatureFlagsService"},{"type":"text","text":", and answers reads against state. Bucketing is pure FNV-1a — same input always produces the same bucket, no network round-trip per read. Local overrides give QA a one-action toggle that wins over remote evaluation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an API-level reference, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},{"type":"text","text":". For where domain plugins fit in the dispatch cycle, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]},{"anchor":"Before-you-start","level":2,"type":"heading","text":"Before you start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes you have a Swidux app already wired up — "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference"},{"text":" first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You also need somewhere to host a JSON file. Any URL works — Cloudflare Pages, R2, S3, a Worker, your own backend. The plugin doesn’t care. ","type":"text"},{"code":"Examples\/ConfigWorker\/","type":"codeVoice"},{"text":" is a runnable Cloudflare Worker that serves feature-flag ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" killswitch config for every app in a portfolio from one URL and one KV namespace, keyed ","type":"text"},{"code":"GET \/<appID>\/<resource>","type":"codeVoice"},{"text":" — point this plugin at ","type":"text"},{"code":"https:\/\/<host>\/<appID>\/flags","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxFeatureFlags\",","    ]",")"]},{"level":2,"anchor":"Step-2-Add-a-state-slice-and-action-case","type":"heading","text":"Step 2: Add a state slice and action case"},{"inlineContent":[{"type":"text","text":"In "},{"code":"AppState.swift","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiduxFeatureFlags","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var featureFlags: FeatureFlagsState = .init()","    \/\/ ... your other slices","}"]},{"inlineContent":[{"type":"text","text":"In "},{"code":"AppAction.swift","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["enum AppAction: Sendable {","    case featureFlags(FeatureFlagsAction)","    \/\/ ... your other cases","}"]},{"name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"import SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" is needed in "},{"inlineContent":[{"text":"every","type":"text"}],"type":"emphasis"},{"type":"text","text":" file that touches "},{"code":"store.featureFlags.*","type":"codeVoice"},{"type":"text","text":" or "},{"code":"FeatureFlagsAction","type":"codeVoice"},{"type":"text","text":" — including views that read flags for display. "},{"code":"@_exported import Swidux","type":"codeVoice"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]}],"type":"aside","style":"tip"},{"level":2,"anchor":"Step-3-Hydrate-state-and-register-the-plugin","type":"heading","text":"Step 3: Hydrate state and register the plugin"},{"inlineContent":[{"text":"At app launch, mint a stable per-install ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"device ID"}]},{"text":" (Keychain-backed so it survives reinstall — this is the bucketing identity), hydrate state from your ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":" (so the last-known-good config survives cold launches), then register the plugin. Add ","type":"text"},{"type":"codeVoice","code":"var deviceID: String = \"\""},{"type":"text","text":" to "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" and point "},{"type":"codeVoice","code":"deviceIDKeyPath"},{"type":"text","text":" at it:"}],"type":"paragraph"},{"code":["let kv = UserDefaultsKeyValueStore()                       \/\/ flags config cache","","\/\/ Stable bucketing identity — Keychain so it survives reinstall, and shared","\/\/ with analytics: AnalyticsIdentity(userID: \\.deviceID, …).","let deviceID = KeychainKeyValueStore(service: \"com.example.app\").deviceIdentity()","","let initial = AppState(","    featureFlags: .hydrated(from: kv, deviceID: deviceID),","    deviceID: deviceID",")","","let store = Store(initialState: initial, reducer: AppReducer())","","\/\/ With the Examples\/ConfigWorker setup this is the shared portfolio URL:","\/\/ \"https:\/\/<host>\/<appID>\/flags\". Any URL returning FeatureFlagsConfig works.","let configURL = URL(static: \"https:\/\/<host>\/<appID>\/flags\")","","let flags = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags,","    action: AppAction.featureFlags,","    extractAction: { if case .featureFlags(let a) = $0 { return a } else { return nil } },","    service: HTTPFeatureFlagsService(url: configURL),","    deviceIDKeyPath: \\.deviceID,","    keyValueStore: kv",")","store.register(plugin: flags)"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-4-Declare-typed-flag-keys","level":2,"type":"heading","text":"Step 4: Declare typed flag keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare each flag once on a namespace so reads are type-safe:"}]},{"code":["extension BoolFlag {","    static let newOnboarding = BoolFlag(\"new_onboarding\")","}","","enum CheckoutVariant: String { case control, treatment }","","extension VariantFlag where Variant == CheckoutVariant {","    static let checkoutLayout = VariantFlag(\"checkout_layout\", default: .control)","}","","extension ValueFlag where Value == Int {","    static let maxFreeUploads = ValueFlag(\"max_free_uploads\", default: 5)","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-5-Read-flags-from-views","level":2,"type":"heading","text":"Step 5: Read flags from views"},{"code":["if store.featureFlags.isEnabled(.newOnboarding) {","    NewOnboardingView()","}","","let layout = store.featureFlags.variant(of: .checkoutLayout)","let cap = store.featureFlags.value(of: .maxFreeUploads)"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-6-Refresh-on-foreground","level":2,"type":"heading","text":"Step 6: Refresh on foreground"},{"type":"paragraph","inlineContent":[{"text":"The plugin debounces ","type":"text"},{"code":".refresh","type":"codeVoice"},{"text":" against the configured ","type":"text"},{"code":"RefreshPolicy","type":"codeVoice"},{"text":", so it’s safe to dispatch on every ","type":"text"},{"code":"scenePhase","type":"codeVoice"},{"text":" transition:","type":"text"}]},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .active { store.send(.featureFlags(.refresh)) }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-7-Guard-against-forever-flags","level":2,"type":"heading","text":"Step 7: Guard against forever flags"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Give every flag a required owner and expiry, and add one CI test that fails when a flag outlives its expiry. Declare a manifest alongside the typed keys — the factory "},{"code":"owner","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"expires","type":"codeVoice"},{"type":"text","text":" parameters are non-optional, and the keys are single-sourced from the flag declarations:"}]},{"code":["enum FlagManifest {","    static let all: [FlagDescriptor] = [","        .bool(.newOnboarding, owner: \"growth\",","              expires: Date(timeIntervalSince1970: 1_788_000_000), purpose: \"New onboarding flow\"),","        .variant(.checkoutLayout, owner: \"checkout\",","                 expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Checkout A\/B\"),","        .value(.maxFreeUploads, owner: \"platform\",","               expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Free upload cap\"),","    ]","}","","@Test func noForeverFlags() {","    let report = FlagGovernance.expirationReport(FlagManifest.all)","    #expect(report == nil, \"\\(report ?? \"\")\")   \/\/ failure names each expired flag + owner","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This is a pure compile-time \/ test concern — no wire-format change and no effect on runtime evaluation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For wire format, bucketing, exposure tracking, and governance details, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},{"text":".","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddfeatureflags"]}],"references":{"doc://Swidux/documentation/Swidux/PluginArchitecture":{"url":"\/documentation\/swidux\/pluginarchitecture","role":"article","title":"Plugin Architecture","type":"topic","kind":"article","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","url":"\/documentation\/swidux\/gettingstarted","kind":"article","role":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"title":"Getting Started with Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},"doc://Swidux/documentation/Swidux":{"abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"url":"\/documentation\/swidux","kind":"symbol","role":"collection","type":"topic","title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","type":"topic","kind":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","title":"Add a Version Killswitch"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"url":"\/documentation\/swidux\/buildingadomainplugin","role":"article","title":"Building a Domain Plugin","type":"topic","kind":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"role":"article","type":"topic","kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","url":"\/documentation\/swidux\/pluginfeatureflagsreference","title":"SwiduxFeatureFlags Reference"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"url":"\/documentation\/swidux\/howtoaddicloudsync","role":"article","title":"Add iCloud Sync","kind":"article","type":"topic","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"type":"topic","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"role":"article","kind":"article","title":"Cancel Effects","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","url":"\/documentation\/swidux\/howtocanceleffects"},"doc://Swidux/documentation/Swidux/AgentSkill":{"role":"article","type":"topic","kind":"article","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","title":"Using the Swidux Agent Skill"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"url":"\/documentation\/swidux\/howtoaddanalytics","role":"article","title":"Add Analytics","kind":"article","type":"topic","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"role":"article","type":"topic","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","url":"\/documentation\/swidux\/howtoaddapaywall","title":"Add a Paywall"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"url":"\/documentation\/swidux\/howtoaddaparentalgate","role":"article","title":"Add a Parental Gate","kind":"article","type":"topic","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"role":"article","type":"topic","kind":"article","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" plugin and the ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" macro — no hand-written ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":" classes, database actors, or ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"text":" closures.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","url":"\/documentation\/swidux\/howtoaddpersistence","title":"Add Persistence"}}}