", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You also need somewhere to host a JSON file. Any URL works — Cloudflare Pages, R2, S3, a Worker, your own backend. The plugin doesn’t care. "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"type":"text","text":" is a runnable Cloudflare Worker that serves feature-flag "},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"text":" killswitch config for every app in a portfolio from one URL and one KV namespace, keyed ","type":"text"},{"code":"GET \/<appID>\/<resource>","type":"codeVoice"},{"text":" — point this plugin at ","type":"text"},{"code":"https:\/\/<host>\/<appID>\/flags","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" product to your app target in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}]},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxFeatureFlags\",","    ]",")"],"type":"codeListing","syntax":"swift"},{"text":"Step 2: Add a state slice and action case","anchor":"Step-2-Add-a-state-slice-and-action-case","type":"heading","level":2},{"inlineContent":[{"text":"In ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import SwiduxFeatureFlags","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var featureFlags: FeatureFlagsState = .init()","    \/\/ ... your other slices","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"In ","type":"text"},{"code":"AppAction.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["enum AppAction: Sendable {","    case featureFlags(FeatureFlagsAction)","    \/\/ ... your other cases","}"]},{"name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxFeatureFlags"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"text":"every","type":"text"}]},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.featureFlags.*"},{"type":"text","text":" or "},{"type":"codeVoice","code":"FeatureFlagsAction"},{"type":"text","text":" — including views that read flags for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}]}],"type":"aside","style":"tip"},{"type":"heading","text":"Step 3: Hydrate state and register the plugin","anchor":"Step-3-Hydrate-state-and-register-the-plugin","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"At app launch, hydrate state from your "},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":" (so the install ID and last-known-good config survive cold launches), then register the plugin:"}]},{"code":["let kv = UserDefaultsKeyValueStore()","let initial = AppState(","    featureFlags: .hydrated(from: kv)",")","","let store = Store(initialState: initial, reducer: AppReducer())","","\/\/ With the Examples\/ConfigWorker setup this is the shared portfolio URL:","\/\/ \"https:\/\/<h