{"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"generated":true,"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"sections":[],"variants":[{"paths":["\/documentation\/swidux\/howtoaddfeatureflags"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Swidux"}],"title":"Add Feature Flags"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" is a domain plugin that owns a ","type":"text"},{"type":"codeVoice","code":"FeatureFlagsState"},{"text":" slice, fetches a Swidux-defined JSON wire format via a provider-agnostic ","type":"text"},{"type":"codeVoice","code":"FeatureFlagsService"},{"text":", and answers reads against state. Bucketing is pure FNV-1a — same input always produces the same bucket, no network round-trip per read. Local overrides give QA a one-action toggle that wins over remote evaluation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For an API-level reference, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","type":"reference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Before you start","anchor":"Before-you-start","type":"heading"},{"inlineContent":[{"text":"This guide assumes you have a Swidux app already wired up — ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"AppStore"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference"},{"text":" first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You also need somewhere to host a JSON file. Any URL works — Cloudflare Pages, R2, S3, a Worker, your own backend. The plugin doesn’t care. ","type":"text"},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"text":" is a runnable Cloudflare Worker that serves feature-flag ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" killswitch config for every app in a portfolio from one URL and one KV namespace, keyed ","type":"text"},{"type":"codeVoice","code":"GET \/<appID>\/<resource>"},{"text":" — point this plugin at ","type":"text"},{"type":"codeVoice","code":"https:\/\/<host>\/<appID>\/flags"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency","type":"heading"},{"inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" product to your app target in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxFeatureFlags\",","    ]",")"],"type":"codeListing"},{"level":2,"text":"Step 2: Add a state slice and action case","anchor":"Step-2-Add-a-state-slice-and-action-case","type":"heading"},{"inlineContent":[{"text":"In ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxFeatureFlags","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var featureFlags: FeatureFlagsState = .init()","    \/\/ ... your other slices","}"],"type":"codeListing"},{"inlineContent":[{"text":"In ","type":"text"},{"type":"codeVoice","code":"AppAction.swift"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["enum AppAction: Sendable {","    case featureFlags(FeatureFlagsAction)","    \/\/ ... your other cases","}"],"type":"codeListing"},{"name":"Tip","style":"tip","content":[{"inlineContent":[{"type":"text","text":""},{"code":"import SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" file that touches "},{"code":"store.featureFlags.*","type":"codeVoice"},{"type":"text","text":" or "},{"code":"FeatureFlagsAction","type":"codeVoice"},{"type":"text","text":" — including views that read flags for display. "},{"code":"@_exported import Swidux","type":"codeVoice"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside"},{"level":2,"text":"Step 3: Hydrate state and register the plugin","anchor":"Step-3-Hydrate-state-and-register-the-plugin","type":"heading"},{"inlineContent":[{"text":"At app launch, mint a stable per-install ","type":"text"},{"inlineContent":[{"type":"text","text":"device ID"}],"type":"strong"},{"text":" (Keychain-backed so it survives reinstall — this is the bucketing identity), hydrate state from your ","type":"text"},{"type":"codeVoice","code":"KeyValueStore"},{"text":" (so the last-known-good config survives cold launches), then register the plugin. Add ","type":"text"},{"type":"codeVoice","code":"var deviceID: String = \"\""},{"text":" to ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" and point ","type":"text"},{"type":"codeVoice","code":"deviceIDKeyPath"},{"text":" at it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let kv = UserDefaultsKeyValueStore()                       \/\/ flags config cache","","\/\/ Stable bucketing identity — Keychain so it survives reinstall, and shared","\/\/ with analytics: AnalyticsIdentity(userID: \\.deviceID, …).","let deviceID = KeychainKeyValueStore(service: \"com.example.app\").deviceIdentity()","","let initial = AppState(","    featureFlags: .hydrated(from: kv, deviceID: deviceID),","    deviceID: deviceID",")","","let store = Store(initialState: initial, reducer: AppReducer())","","\/\/ With the Examples\/ConfigWorker setup this is the shared portfolio URL:","\/\/ \"https:\/\/<host>\/<appID>\/flags\". Any URL returning FeatureFlagsConfig works.","let configURL = URL(static: \"https:\/\/<host>\/<appID>\/flags\")","","let flags = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags,","    action: AppAction.featureFlags,","    extractAction: { if case .featureFlags(let a) = $0 { return a } else { return nil } },","    service: HTTPFeatureFlagsService(url: configURL),","    deviceIDKeyPath: \\.deviceID,","    keyValueStore: kv",")","store.register(plugin: flags)"],"type":"codeListing"},{"level":2,"text":"Step 4: Declare typed flag keys","anchor":"Step-4-Declare-typed-flag-keys","type":"heading"},{"inlineContent":[{"text":"Declare each flag once on a namespace so reads are type-safe:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["extension BoolFlag {","    static let newOnboarding = BoolFlag(\"new_onboarding\")","}","","enum CheckoutVariant: String { case control, treatment }","","extension VariantFlag where Variant == CheckoutVariant {","    static let checkoutLayout = VariantFlag(\"checkout_layout\", default: .control)","}","","extension ValueFlag where Value == Int {","    static let maxFreeUploads = ValueFlag(\"max_free_uploads\", default: 5)","}"],"type":"codeListing"},{"level":2,"text":"Step 5: Read flags from views","anchor":"Step-5-Read-flags-from-views","type":"heading"},{"syntax":"swift","code":["if store.featureFlags.isEnabled(.newOnboarding) {","    NewOnboardingView()","}","","let layout = store.featureFlags.variant(of: .checkoutLayout)","let cap = store.featureFlags.value(of: .maxFreeUploads)"],"type":"codeListing"},{"level":2,"text":"Step 6: Refresh on foreground","anchor":"Step-6-Refresh-on-foreground","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin debounces "},{"code":".refresh","type":"codeVoice"},{"type":"text","text":" against the configured "},{"code":"RefreshPolicy","type":"codeVoice"},{"text":", so it’s safe to dispatch on every ","type":"text"},{"code":"scenePhase","type":"codeVoice"},{"type":"text","text":" transition:"}]},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .active { store.send(.featureFlags(.refresh)) }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Step 7: Guard against forever flags","anchor":"Step-7-Guard-against-forever-flags"},{"type":"paragraph","inlineContent":[{"text":"Give every flag a required owner and expiry, and add one CI test that fails when a flag outlives its expiry. Declare a manifest alongside the typed keys — the factory ","type":"text"},{"code":"owner","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"expires","type":"codeVoice"},{"text":" parameters are non-optional, and the keys are single-sourced from the flag declarations:","type":"text"}]},{"syntax":"swift","code":["enum FlagManifest {","    static let all: [FlagDescriptor] = [","        .bool(.newOnboarding, owner: \"growth\",","              expires: Date(timeIntervalSince1970: 1_788_000_000), purpose: \"New onboarding flow\"),","        .variant(.checkoutLayout, owner: \"checkout\",","                 expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Checkout A\/B\"),","        .value(.maxFreeUploads, owner: \"platform\",","               expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Free upload cap\"),","    ]","}","","@Test func noForeverFlags() {","    let report = FlagGovernance.expirationReport(FlagManifest.all)","    #expect(report == nil, \"\\(report ?? \"\")\")   \/\/ failure names each expired flag + owner","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"This is a pure compile-time \/ test concern — no wire-format change and no effect on runtime evaluation.","type":"text"}]},{"inlineContent":[{"text":"For wire format, bucketing, exposure tracking, and governance details, see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},{"type":"text","text":"."}],"type":"paragraph"}]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"references":{"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"role":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","title":"Add iCloud Sync","url":"\/documentation\/swidux\/howtoaddicloudsync","type":"topic","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","title":"Add a Parental Gate","url":"\/documentation\/swidux\/howtoaddaparentalgate","type":"topic","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"role":"article"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"role":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"type":"topic","url":"\/documentation\/swidux\/buildingadomainplugin","title":"Building a Domain Plugin","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},"doc://Swidux/documentation/Swidux/AgentSkill":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","title":"Using the Swidux Agent Skill","url":"\/documentation\/swidux\/agentskill","type":"topic","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"rol