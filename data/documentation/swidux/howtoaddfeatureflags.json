{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"variants":[{"paths":["\/documentation\/swidux\/howtoaddfeatureflags"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article","title":"Add Feature Flags"},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"title":"How-to Guides","generated":true,"anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"]}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" is a domain plugin that owns a "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":" slice, fetches a Swidux-defined JSON wire format via a provider-agnostic "},{"type":"codeVoice","code":"FeatureFlagsService"},{"type":"text","text":", and answers reads against state. Bucketing is pure FNV-1a — same input always produces the same bucket, no network round-trip per read. Local overrides give QA a one-action toggle that wins over remote evaluation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an API-level reference, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","isActive":true},{"type":"text","text":". For where domain plugins fit in the dispatch cycle, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}]},{"anchor":"Before-you-start","type":"heading","level":2,"text":"Before you start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes you have a Swidux app already wired up — "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You also need somewhere to host a JSON file. Any URL works — Cloudflare Pages, R2, S3, a Worker, your own backend. The plugin doesn’t care. "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"type":"text","text":" is a runnable Cloudflare Worker that serves feature-flag "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" killswitch config for every app in a portfolio from one URL and one KV namespace, keyed "},{"type":"codeVoice","code":"GET \/<appID>\/<resource>"},{"type":"text","text":" — point this plugin at "},{"type":"codeVoice","code":"https:\/\/<host>\/<appID>\/flags"},{"type":"text","text":"."}]},{"anchor":"Step-1-Add-the-dependency","type":"heading","level":2,"text":"Step 1: Add the dependency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxFeatureFlags\",","    ]",")"],"syntax":"swift"},{"anchor":"Step-2-Add-a-state-slice-and-action-case","type":"heading","level":2,"text":"Step 2: Add a state slice and action case"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":":"}]},{"type":"codeListing","code":["import SwiduxFeatureFlags","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var featureFlags: FeatureFlagsState = .init()","    \/\/ ... your other slices","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"AppAction.swift"},{"type":"text","text":":"}]},{"type":"codeListing","code":["enum AppAction: Sendable {","    case featureFlags(FeatureFlagsAction)","    \/\/ ... your other cases","}"],"syntax":"swift"},{"style":"tip","type":"aside","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"import SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" file that touches "},{"code":"store.featureFlags.*","type":"codeVoice"},{"type":"text","text":" or "},{"code":"FeatureFlagsAction","type":"codeVoice"},{"type":"text","text":" — including views that read flags for display. "},{"code":"@_exported import Swidux","type":"codeVoice"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]}]},{"anchor":"Step-3-Hydrate-state-and-register-the-plugin","type":"heading","level":2,"text":"Step 3: Hydrate state and register the plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"At app launch, mint a stable per-install "},{"type":"strong","inlineContent":[{"type":"text","text":"device ID"}]},{"type":"text","text":" (Keychain-backed so it survives reinstall — this is the bucketing identity), hydrate state from your "},{"type":"codeVoice","code":"KeyValueStore"},{"type":"text","text":" (so the last-known-good config survives cold launches), then register the plugin. Add "},{"type":"codeVoice","code":"var deviceID: String = \"\""},{"type":"text","text":" to "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" and point "},{"type":"codeVoice","code":"deviceIDKeyPath"},{"type":"text","text":" at it:"}]},{"type":"codeListing","code":["let kv = UserDefaultsKeyValueStore()                       \/\/ flags config cache","","\/\/ Stable bucketing identity — Keychain so it survives reinstall, and shared","\/\/ with analytics: AnalyticsIdentity(userID: \\.deviceID, …).","let deviceID = KeychainKeyValueStore(service: \"com.example.app\").deviceIdentity()","","let initial = AppState(","    featureFlags: .hydrated(from: kv, deviceID: deviceID),","    deviceID: deviceID",")","","let store = Store(initialState: initial, reducer: AppReducer())","","\/\/ With the Examples\/ConfigWorker setup this is the shared portfolio URL:","\/\/ \"https:\/\/<host>\/<appID>\/flags\". Any URL returning FeatureFlagsConfig works.","let configURL = URL(static: \"https:\/\/<host>\/<appID>\/flags\")","","let flags = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags,","    action: AppAction.featureFlags,","    extractAction: { if case .featureFlags(let a) = $0 { return a } else { return nil } },","    service: HTTPFeatureFlagsService(url: configURL),","    deviceIDKeyPath: \\.deviceID,","    keyValueStore: kv",")","store.register(plugin: flags)"],"syntax":"swift"},{"anchor":"Step-4-Declare-typed-flag-keys","type":"heading","level":2,"text":"Step 4: Declare typed flag keys"},{"type":"paragraph","inlineContent":[{"text":"Declare each flag once on a namespace so reads are type-safe:","type":"text"}]},{"code":["extension BoolFlag {","    static let newOnboarding = BoolFlag(\"new_onboarding\")","}","","enum CheckoutVariant: String { case control, treatment }","","extension VariantFlag where Variant == CheckoutVariant {","    static let checkoutLayout = VariantFlag(\"checkout_layout\", default: .control)","}","","extension ValueFlag where Value == Int {","    static let maxFreeUploads = ValueFlag(\"max_free_uploads\", default: 5)","}"],"type":"codeListing","syntax":"swift"},{"text":"Step 5: Read flags from views","anchor":"Step-5-Read-flags-from-views","type":"heading","level":2},{"code":["if store.featureFlags.isEnabled(.newOnboarding) {","    NewOnboardingView()","}","","let layout = store.featureFlags.variant(of: .checkoutLayout)","let cap = store.featureFlags.value(of: .maxFreeUploads)"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-6-Refresh-on-foreground","type":"heading","level":2,"text":"Step 6: Refresh on foreground"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin debounces "},{"code":".refresh","type":"codeVoice"},{"type":"text","text":" against the configured "},{"code":"RefreshPolicy","type":"codeVoice"},{"type":"text","text":", so it’s safe to dispatch on every "},{"code":"scenePhase","type":"codeVoice"},{"type":"text","text":" transition:"}]},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .active { store.send(.featureFlags(.refresh)) }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Step 7: Guard against forever flags","anchor":"Step-7-Guard-against-forever-flags"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Give every flag a required owner and expiry, and add one CI test that fails when a flag outlives its expiry. Declare a manifest alongside the typed keys — the factory "},{"code":"owner","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"expires","type":"codeVoice"},{"type":"text","text":" parameters are non-optional, and the keys are single-sourced from the flag declarations:"}]},{"code":["enum FlagManifest {","    static let all: [FlagDescriptor] = [","        .bool(.newOnboarding, owner: \"growth\",","              expires: Date(timeIntervalSince1970: 1_788_000_000), purpose: \"New onboarding flow\"),","        .variant(.checkoutLayout, owner: \"checkout\",","                 expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Checkout A\/B\"),","        .value(.maxFreeUploads, owner: \"platform\",","               expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Free upload cap\"),","    ]","}","","@Test func noForeverFlags() {","    let report = FlagGovernance.expirationReport(FlagManifest.all)","    #expect(report == nil, \"\\(report ?? \"\")\")   \/\/ failure names each expired flag + owner","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This is a pure compile-time \/ test concern — no wire-format change and no effect on runtime evaluation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For wire format, bucketing, exposure tracking, and governance details, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},{"type":"text","text":"."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"references":{"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"type":"topic","title":"Swidux","role":"collection","kind":"symbol","url":"\/documentation\/swidux"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"title":"Plugin Architecture","type":"topic","url":"\/documentation\/swidux\/pluginarchitecture","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"url":"\/documentation\/swidux\/howtoaddapaywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"topic","title":"Add a Paywall","role":"article","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"title":"Getting Started with Swidux","type":"topic","url":"\/documentation\/swidux\/gettingstarted","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"role":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"title":"Add a Parental Gate","type":"topic","url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"role":"article","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"title":"Add iCloud Sync","type":"topic","url":"\/documentation\/swidux\/howtoaddicloudsync","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"role":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"title":"Add Analytics","type":"topic","url":"\/documentation\/swidux\/howtoaddanalytics","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"title":"SwiduxFeatureFlags Reference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","role":"article","kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"url":"\/documentation\/swidux\/pluginfeatureflagsreference"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"title":"Building a Domain Plugin","type":"topic","url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"role":"article","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"title":"Add Persistence","type":"topic","url":"\/documentation\/swidux\/howtoaddpersistence","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"title":"Add a Version Killswitch","type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch"},"doc://Swidux/documentation/Swidux/AgentSkill":{"role":"article","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"title":"Using the Swidux Agent Skill","type":"topic","url":"\/documentation\/swidux\/agentskill","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"role":"article","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"title":"Cancel Effects","type":"topic","url":"\/documentation\/swidux\/howtocanceleffects","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects"}}}