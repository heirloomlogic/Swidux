, ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true,"type":"reference"},{"text":" first.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You also need somewhere to host a JSON file. Any URL works — Cloudflare Pages, R2, S3, a Worker, your own backend. The plugin doesn’t care.","type":"text"}]},{"level":2,"anchor":"Step-1-Add-the-dependency","type":"heading","text":"Step 1: Add the dependency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxFeatureFlags\",","    ]",")"]},{"level":2,"anchor":"Step-2-Add-a-state-slice-and-action-case","type":"heading","text":"Step 2: Add a state slice and action case"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxFeatureFlags","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var featureFlags: FeatureFlagsState = .init()","    \/\/ ... your other slices","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"AppAction.swift"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["enum AppAction: Sendable {","    case featureFlags(FeatureFlagsAction)","    \/\/ ... your other cases","}"]},{"level":2,"anchor":"Step-3-Hydrate-state-and-register-the-plugin","type":"head