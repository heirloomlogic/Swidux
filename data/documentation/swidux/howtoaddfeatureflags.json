{"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddfeatureflags"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"title":"How-to Guides","anchor":"How-to-Guides"}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article","title":"Add Feature Flags"},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" is a domain plugin that owns a "},{"code":"FeatureFlagsState","type":"codeVoice"},{"type":"text","text":" slice, fetches a Swidux-defined JSON wire format via a provider-agnostic "},{"code":"FeatureFlagsService","type":"codeVoice"},{"type":"text","text":", and answers reads against state. Bucketing is pure FNV-1a — same input always produces the same bucket, no network round-trip per read. Local overrides give QA a one-action toggle that wins over remote evaluation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For an API-level reference, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},{"type":"text","text":". For where domain plugins fit in the dispatch cycle, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Before-you-start","type":"heading","level":2,"text":"Before you start"},{"inlineContent":[{"text":"This guide assumes you have a Swidux app already wired up — ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"AppStore"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true,"type":"reference"},{"text":" first.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You also need somewhere to host a JSON file. Any URL works — Cloudflare Pages, R2, S3, a Worker, your own backend. The plugin doesn’t care. "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"type":"text","text":" is a runnable Cloudflare Worker that serves feature-flag "},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" killswitch config for every app in a portfolio from one URL and one KV namespace, keyed ","type":"text"},{"code":"GET \/<appID>\/<resource>","type":"codeVoice"},{"type":"text","text":" — point this plugin at "},{"type":"codeVoice","code":"https:\/\/<host>\/<appID>\/flags"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Step-1-Add-the-dependency","level":2,"text":"Step 1: Add the dependency"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxFeatureFlags\",","    ]",")"],"type":"codeListing"},{"level":2,"text":"Step 2: Add a state slice and action case","anchor":"Step-2-Add-a-state-slice-and-action-case","type":"heading"},{"inlineContent":[{"text":"In ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["import SwiduxFeatureFlags","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var featureFlags: FeatureFlagsState = .init()","    \/\/ ... your other slices","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"In ","type":"text"},{"code":"AppAction.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["enum AppAction: Sendable {","    case featureFlags(FeatureFlagsAction)","    \/\/ ... your other cases","}"]},{"style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"import SwiduxFeatureFlags","type":"codeVoice"},{"text":" is needed in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"text":" file that touches ","type":"text"},{"code":"store.featureFlags.*","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"FeatureFlagsAction","type":"codeVoice"},{"text":" — including views that read flags for display. ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}]}],"type":"aside"},{"text":"Step 3: Hydrate state and register the plugin","anchor":"Step-3-Hydrate-state-and-register-the-plugin","level":2,"type":"heading"},{"inlineContent":[{"text":"At app launch, mint a stable per-install ","type":"text"},{"inlineContent":[{"type":"text","text":"device ID"}],"type":"strong"},{"type":"text","text":" (Keychain-backed so it survives reinstall — this is the bucketing identity), hydrate state from your "},{"type":"codeVoice","code":"KeyValueStore"},{"text":" (so the last-known-good config survives cold launches), then register the plugin. Add ","type":"text"},{"code":"var deviceID: String = \"\"","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" and point ","type":"text"},{"code":"deviceIDKeyPath","type":"codeVoice"},{"text":" at it:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let kv = UserDefaultsKeyValueStore()                       \/\/ flags config cache","","\/\/ Stable bucketing identity — Keychain so it survives reinstall, and shared","\/\/ with analytics: AnalyticsIdentity(userID: \\.deviceID, …).","let deviceID = KeychainKeyValueStore(service: \"com.example.app\").deviceIdentity()","","let initial = AppState(","    featureFlags: .hydrated(from: kv, deviceID: deviceID),","    deviceID: deviceID",")","","let store = Store(initialState: initial, reducer: AppReducer())","","\/\/ With the Examples\/ConfigWorker setup this is the shared portfolio URL:","\/\/ \"https:\/\/<host>\/<appID>\/flags\". Any URL returning FeatureFlagsConfig works.","let configURL = URL(static: \"https:\/\/<host>\/<appID>\/flags\")","","let flags = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags,","    action: AppAction.featureFlags,","    extractAction: { if case .featureFlags(let a) = $0 { return a } else { return nil } },","    service: HTTPFeatureFlagsService(url: configURL),","    deviceIDKeyPath: \\.deviceID,","    keyValueStore: kv",")","store.register(plugin: flags)"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Step-4-Declare-typed-flag-keys","text":"Step 4: Declare typed flag keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare each flag once on a namespace so reads are type-safe:"}]},{"type":"codeListing","code":["extension BoolFlag {","    static let newOnboarding = BoolFlag(\"new_onboarding\")","}","","enum CheckoutVariant: String { case control, treatment }","","extension VariantFlag where Variant == CheckoutVariant {","    static let checkoutLayout = VariantFlag(\"checkout_layout\", default: .control)","}","","extension ValueFlag where Value == Int {","    static let maxFreeUploads = ValueFlag(\"max_free_uploads\", default: 5)","}"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Step-5-Read-flags-from-views","text":"Step 5: Read flags from views"},{"type":"codeListing","code":["if store.featureFlags.isEnabled(.newOnboarding) {","    NewOnboardingView()","}","","let layout = store.featureFlags.variant(of: .checkoutLayout)","let cap = store.featureFlags.value(of: .maxFreeUploads)"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Step-6-Refresh-on-foreground","text":"Step 6: Refresh on foreground"},{"type":"paragraph","inlineContent":[{"text":"The plugin debounces ","type":"text"},{"type":"codeVoice","code":".refresh"},{"text":" against the configured ","type":"text"},{"type":"codeVoice","code":"RefreshPolicy"},{"type":"text","text":", so it’s safe to dispatch on every "},{"type":"codeVoice","code":"scenePhase"},{"type":"text","text":" transition:"}]},{"type":"codeListing","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .active { store.send(.featureFlags(.refresh)) }","}"],"syntax":"swift"},{"anchor":"Step-7-Guard-against-forever-flags","level":2,"type":"heading","text":"Step 7: Guard against forever flags"},{"inlineContent":[{"text":"Give every flag a required owner and expiry, and add one CI test that fails when a flag outlives its expiry. Declare a manifest alongside the typed keys — the factory ","type":"text"},{"code":"owner","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"expires","type":"codeVoice"},{"text":" parameters are non-optional, and the keys are single-sourced from the flag declarations:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["enum FlagManifest {","    static let all: [FlagDescriptor] = [","        .bool(.newOnboarding, owner: \"growth\",","              expires: Date(timeIntervalSince1970: 1_788_000_000), purpose: \"New onboarding flow\"),","        .variant(.checkoutLayout, owner: \"checkout\",","                 expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Checkout A\/B\"),","        .value(.maxFreeUploads, owner: \"platform\",","               expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Free upload cap\"),","    ]","}","","@Test func noForeverFlags() {","    let report = FlagGovernance.expirationReport(FlagManifest.all)","    #expect(report == nil, \"\\(report ?? \"\")\")   \/\/ failure names each expired flag + owner","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is a pure compile-time \/ test concern — no wire-format change and no effect on runtime evaluation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For wire format, bucketing, exposure tracking, and governance details, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"sections":[],"references":{"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","url":"\/documentation\/swidux\/buildingadomainplugin","type":"topic","role":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"title":"Building a Domain Plugin","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"type":"topic","title":"Add iCloud Sync","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"kind":"article","url":"\/documentation\/swidux\/howtoaddicloudsync"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","url":"\/documentation\/swidux\/pluginfeatureflagsreference","type":"topic","role":"article","title":"SwiduxFeatureFlags Reference","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","title":"Add a Parental Gate","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"kind":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","type":"topic","role":"collection","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","kind":"symbol"},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","type":"topic","role":"article","abstract":[{"text":"Install the bundled ","type":"text"},{"code":"swidux-ref","type":"codeVoice"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"title":"Using the Swidux Agent Skill","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"type":"topic","title":"Add Persistence","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","kind":"article","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"url":"\/documentation\/swidux\/howtoaddpersistence"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","url":"\/documentation\/swidux\/pluginarchitecture","type":"topic","role":"article","title":"Plugin Architecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","title":"Add a Paywall","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"kind":"article","url":"\/documentation\/swidux\/howtoaddapaywall"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","type":"topic","role":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"title":"Add a Version Killswitch","kind":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","title":"Getting Started with Swidux","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"kind":"article","url":"\/documentation\/swidux\/gettingstarted"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","url":"\/documentation\/swidux\/howtoaddanalytics","type":"topic","role":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"title":"Add Analytics","kind":"article"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"type":"topic","title":"Cancel Effects","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"kind":"article","url":"\/documentation\/swidux\/howtocanceleffects"}}}