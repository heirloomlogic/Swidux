{"metadata":{"title":"Add Analytics","roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}]},"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide takes you from a wired Swidux app to fully-tracked user behavior with screen views, action-driven events, identity management, opt-out support, and shutdown flushing. It covers state and action wiring, implementing an "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":", declaring an event mapper, configuring auto-identify, and flushing on app background."}]},{"type":"paragraph","inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","type":"reference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":".","type":"text"}]},{"type":"heading","text":"Before you start","level":2,"anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"You have an analytics backend in mind. Mixpanel is the path of least resistance via the "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" companion package, but Amplitude, PostHog, Segment, or a custom backend work just as well — the plugin doesn’t care."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Step-1-Add-the-dependency","level":2,"text":"Step 1: Add the dependency"},{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" product to your app target in "},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxAnalytics\",","    ]",")"],"syntax":"swift"},{"type":"heading","anchor":"Step-2-Add-state-and-actions","level":2,"text":"Step 2: Add state and actions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add an analytics slice to "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" with "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":", and an analytics case to "},{"code":"AppAction","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["\/\/ AppState.swift","import SwiduxAnalytics","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var analytics: AnalyticsState = .init()","    \/\/ … other slices","}"],"syntax":"swift"},{"type":"codeListing","code":["\/\/ AppAction.swift","import SwiduxAnalytics","","enum AppAction: Sendable {","    case analytics(AnalyticsAction)","    \/\/ … other cases","}"],"syntax":"swift"},{"name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"import SwiduxAnalytics","type":"codeVoice"},{"text":" is needed in ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"every","type":"text"}]},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.analytics.*"},{"type":"text","text":" or "},{"code":"AnalyticsAction","type":"codeVoice"},{"text":" — including views that read the slice for display. ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]}],"type":"aside","style":"tip"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"type":"codeVoice","code":".analytics"},{"text":" actions, so the root reducer should fall through:","type":"text"}]},{"code":["\/\/ AppReducer.swift","case .analytics:","    return nil"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Step 3: Provide an `AnalyticsService`","anchor":"Step-3-Provide-an-AnalyticsService","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin needs an "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that talks to your analytics backend. Pick the path that matches your backend."}]},{"type":"heading","text":"Path A: Mixpanel (recommended)","anchor":"Path-A-Mixpanel-recommended","level":3},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","isActive":true,"type":"reference"},{"text":" companion package and use the supplied ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":". No bridging code on your side.","type":"text"}]},{"code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"],"type":"codeListing","syntax":"swift"},{"code":["import SwiduxMixpanelAnalytics","","let service = MixpanelAnalyticsService(token: \"your-mixpanel-token\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See the package’s "},{"type":"reference","isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/"},{"type":"text","text":" for configuration details."}]},{"type":"heading","text":"Path B: Amplitude \/ PostHog \/ Segment \/ custom backend","anchor":"Path-B-Amplitude--PostHog--Segment--custom-backend","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For any non-Mixpanel backend, implement "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" directly. The protocol is small:"}]},{"code":["import SwiduxAnalytics","","struct MyAnalyticsService: AnalyticsService {","    func track(_ event: AnalyticsEvent) async {","        \/\/ Forward event.name + event.properties to your SDK.","    }","","    func identify(userID: String, properties: [String: AnalyticsValue]) async {","        \/\/ Set the active user and people properties.","    }","","    func alias(newID: String, previousID: String?) async {","        \/\/ Link an anonymous distinct ID to a known user ID.","    }","","    func reset() async {","        \/\/ Clear local identity (logout). Subsequent events should be anonymous.","    }","","    func flush() async {","        \/\/ Drain in-flight buffers (called by the plugin on app shutdown).","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Translate "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" cases ("},{"type":"codeVoice","code":".string"},{"type":"text","text":", "},{"type":"codeVoice","code":".int"},{"type":"text","text":", "},{"type":"codeVoice","code":".double"},{"type":"text","text":", "},{"type":"codeVoice","code":".bool"},{"text":", ","type":"text"},{"code":".date","type":"codeVoice"},{"text":", ","type":"text"},{"code":".array","type":"codeVoice"},{"text":", ","type":"text"},{"code":".dict","type":"codeVoice"},{"text":", ","type":"text"},{"code":".null","type":"codeVoice"},{"text":") into whatever your SDK takes. The mapping is mechanical: each case has an obvious target type.","type":"text"}]},{"type":"heading","text":"Previews and tests","level":3,"anchor":"Previews-and-tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the built-in "},{"code":"MockAnalyticsService","type":"codeVoice"},{"type":"text","text":" for backend-agnostic previews:"}]},{"type":"codeListing","code":["let service = MockAnalyticsService()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If you’re on Path A, ","type":"text"},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":" ships ","type":"text"},{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"text":" for Mixpanel-flavored previews.","type":"text"}]},{"type":"heading","text":"Step 4: Declare an event mapper","level":2,"anchor":"Step-4-Declare-an-event-mapper"},{"type":"paragraph","inlineContent":[{"text":"The mapper is where you decide which actions become tracked events and what properties they carry. It runs in ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":" for every non-analytics action while the user is opted in.","type":"text"}]},{"syntax":"swift","code":["import SwiduxAnalytics","","let mapper = AnalyticsMapper<AppState, AppAction> { state, action in","    switch action {","    case .counter(.increment(let n)):","        return [AnalyticsEvent(\"counter_added\", [\"amount\": .int(n)])]","","    case .paywall(.request(let reason)):","        return [AnalyticsEvent(\"paywall_requested\", [\"reason\": .string(reason)])]","","    case .paywall(.customerInfoUpdated(let snapshot)) where snapshot.isPro:","        return [AnalyticsEvent(\"subscription_started\")]","","    default:","        return []","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A single action can produce zero, one, or several events. The mapper closure is allowed to read freely from "},{"type":"codeVoice","code":"state"},{"type":"text","text":" — that’s deliberately what gets passed in, post-reducer."}]},{"level":2,"text":"Step 5: Configure auto-identify","type":"heading","anchor":"Step-5-Configure-auto-identify"},{"type":"paragraph","inlineContent":[{"text":"If your app has a stable userID source (e.g. an ","type":"text"},{"type":"codeVoice","code":"auth.currentUserID"},{"text":" slice), let the plugin watch it. The plugin auto-fires ","type":"text"},{"type":"codeVoice","code":"identify"},{"text":" on transitions and ","type":"text"},{"type":"codeVoice","code":"reset"},{"text":" on sign-out, with no app-level plumbing.","type":"text"}]},{"code":["let identity = AnalyticsIdentity<AppState>(","    userID: \\.auth.currentUserID,","    userProperties: { state in","        [","            \"subscription_tier\": state.paywall.isPro ? \"pro\" : \"free\",","            \"signup_date\": state.auth.signupDate.map(AnalyticsValue.date) ?? .null,","        ]","    }",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"userProperties"},{"text":" is re-evaluated each non-analytics dispatch. The plugin re-fires ","type":"text"},{"type":"codeVoice","code":"service.identify"},{"text":" whenever the returned dictionary changes — so derived people-properties (subscription tier, paywall entitlements, feature flags, A\/B variants) stay in sync with state without any explicit ","type":"text"},{"type":"codeVoice","code":".identify"},{"text":" plumbing.","type":"text"}]},{"text":"Step 6: Wire the plugin","type":"heading","anchor":"Step-6-Wire-the-plugin","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct and register "},{"code":"AnalyticsPlugin","type":"codeVoice"},{"type":"text","text":" inside your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory:"}]},{"code":["import SwiduxAnalytics","","let analyticsPlugin = AnalyticsPlugin<AppState, AppAction>(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","    service: MixpanelAnalyticsService(token: \"...\"),","    mapper: mapper,","    identity: identity",")","plugins.register(analyticsPlugin)"],"type":"codeListing","syntax":"swift"},{"text":"Step 7: Track screen views","type":"heading","anchor":"Step-7-Track-screen-views","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".analytics(.screenView(_:))"},{"type":"text","text":" from your view’s "},{"type":"codeVoice","code":".onAppear"},{"type":"text","text":" (or equivalent navigation hook). The plugin updates "},{"type":"codeVoice","code":"state.analytics.currentScreen"},{"type":"text","text":" and emits a "},{"type":"codeVoice","code":"screen_view"},{"type":"text","text":" event with "},{"type":"codeVoice","code":"screen_name"},{"type":"text","text":" plus any extra properties."}]},{"code":["struct ProfileView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        Form { \/* … *\/ }","            .onAppear { store.send(.analytics(.screenView(\"Profile\"))) }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Subsequent mapper-emitted events are auto-enriched with ","type":"text"},{"code":"screen: \"Profile\"","type":"codeVoice"},{"text":" until the next ","type":"text"},{"type":"codeVoice","code":"screenView"},{"text":" dispatch — useful for understanding ","type":"text"},{"inlineContent":[{"type":"text","text":"where"}],"type":"emphasis"},{"text":" an action originated without manually passing context through every event.","type":"text"}]},{"type":"heading","anchor":"Step-8-Track-ad-hoc-events","text":"Step 8: Track ad-hoc events","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For events that don’t map cleanly from a domain action, dispatch "},{"type":"codeVoice","code":".analytics(.track(_:))"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["Button(\"Share\") {","    store.send(.analytics(.track(","        AnalyticsEvent(\"share_tapped\", [\"destination\": .string(\"twitter\")])","    )))","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This bypasses the mapper but still gets "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached."}]},{"type":"heading","anchor":"Step-9-Handle-opt-out","text":"Step 9: Handle opt-out","level":2},{"type":"paragraph","inlineContent":[{"text":"Surface a privacy toggle that dispatches ","type":"text"},{"type":"codeVoice","code":".analytics(.setOptedOut(_:))"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["Toggle(\"Share usage analytics\", isOn: Binding(","    get: { !store.analytics.isOptedOut },","    set: { store.send(.analytics(.setOptedOut(!$0))) }","))"]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"setOptedOut(true)","type":"codeVoice"},{"text":" fires, the plugin clears ","type":"text"},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":" and calls ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":" to clear server-side identity. While opted out, all tracking is dropped and auto-identify is paused. Opting back in re-identifies the user automatically on the next dispatch.","type":"text"}]},{"type":"heading","anchor":"Step-10-Flush-on-app-shutdown","text":"Step 10: Flush on app shutdown","level":2},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":" when the app moves to the background or terminates so in-flight events aren’t lost:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","    @Environment(\\.scenePhase) private var scenePhase","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        .onChange(of: scenePhase) { _, phase in","            if phase == .background {","                Task { await store.analyticsPlugin.flush() }","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"flush()"},{"type":"text","text":" awaits any pending fire-and-forget service calls the plugin spawned, then calls "},{"type":"codeVoice","code":"service.flush()"},{"type":"text","text":" to drain the SDK’s own buffers."}]},{"anchor":"Testing","level":2,"text":"Testing","type":"heading"},{"inlineContent":[{"text":"Use a recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" to verify your mapper and explicit dispatches in tests:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Testing","@testable import SwiduxAnalytics","","actor RecordingAnalyticsService: AnalyticsService {","    private(set) var events: [AnalyticsEvent] = []","    func track(_ event: AnalyticsEvent) async { events.append(event) }","    func identify(userID: String, properties: [String: AnalyticsValue]) async {}","    func alias(newID: String, previousID: String?) async {}","    func reset() async {}","    func flush() async {}","}","","@Test func incrementTracks() async {","    let service = RecordingAnalyticsService()","    let store = AppStore.configured(analyticsService: service)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await service.events","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"],"type":"codeListing"},{"inlineContent":[{"code":"flush()","type":"codeVoice"},{"text":" is the deterministic sync point — it awaits all pending tracking tasks before returning, so post-flush assertions are stable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Plumb the service through a parameter on your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory so previews and tests can override it without touching the live SDK.","type":"text"}],"type":"paragraph"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},"kind":"article","seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"generated":true,"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddanalytics"]}],"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"references":{"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"topic","role":"article","url":"\/documentation\/swidux\/howtoaddicloudsync","title":"Add iCloud Sync","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}]},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"topic","role":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","title":"Add Feature Flags","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}]},"https://github.com/heirloomlogic/SwiduxMixpanelAnalytics":{"titleInlineContent":[{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"}],"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","type":"link","url":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},"doc://Swidux/documentation/Swidux":{"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux","url":"\/documentation\/swidux","role":"collection","type":"topic","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","kind":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","title":"Add a Parental Gate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}]},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","kind":"article","url":"\/documentation\/swidux\/buildingadomainplugin","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"title":"Building a Domain Plugin"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","title":"Add a Version Killswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","role":"article","type":"topic","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"url":"\/documentation\/swidux\/gettingstarted","kind":"article","role":"article","title":"Getting Started with Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"url":"\/documentation\/swidux\/pluginarchitecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","title":"Plugin Architecture","type":"topic","kind":"article","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"role":"article"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"url":"\/documentation\/swidux\/pluginanalyticsreference","kind":"article","title":"SwiduxAnalytics Reference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"role":"article"},"https://heirloomlogic.github.io/SwiduxMixpanelAnalytics/documentation/swiduxmixpanelanalytics/":{"titleInlineContent":[{"text":"DocC reference","type":"text"}],"url":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","title":"DocC reference","type":"link","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/"},"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","kind":"article","url":"\/documentation\/swidux\/agentskill","role":"article","title":"Using the Swidux Agent Skill","abstract":[{"text":"Install the bundled ","type":"text"},{"code":"swidux-ref","type":"codeVoice"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"url":"\/documentation\/swidux\/howtoaddpersistence","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","type":"topic","title":"Add Persistence","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"url":"\/documentation\/swidux\/howtoaddapaywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","kind":"article","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"role":"article"}}}