{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","interfaceLanguage":"swift"},"metadata":{"role":"article","title":"Add Analytics","roleHeading":"Article","modules":[{"name":"Swidux"}]},"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"text":"This guide takes you from a wired Swidux app to fully-tracked user behavior with screen views, action-driven events, identity management, opt-out support, and shutdown flushing. It covers state and action wiring, implementing an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":", declaring an event mapper, configuring auto-identify, and flushing on app background.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","isActive":true,"type":"reference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Before-you-start","level":2,"type":"heading","text":"Before you start"},{"inlineContent":[{"text":"This guide assumes:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"type":"text","text":" first."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"You have an analytics backend in mind. Mixpanel is the path of least resistance via the "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" companion package, but Amplitude, PostHog, Segment, or a custom backend work just as well — the plugin doesn’t care."}],"type":"paragraph"}]}]},{"anchor":"Step-1-Add-the-dependency","level":2,"type":"heading","text":"Step 1: Add the dependency"},{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" product to your app target in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxAnalytics\",","    ]",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-2-Add-state-and-actions","level":2,"type":"heading","text":"Step 2: Add state and actions"},{"inlineContent":[{"text":"Add an analytics slice to ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":", and an analytics case to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["\/\/ AppState.swift","import SwiduxAnalytics","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var analytics: AnalyticsState = .init()","    \/\/ … other slices","}"],"type":"codeListing","syntax":"swift"},{"code":["\/\/ AppAction.swift","import SwiduxAnalytics","","enum AppAction: Sendable {","    case analytics(AnalyticsAction)","    \/\/ … other cases","}"],"type":"codeListing","syntax":"swift"},{"type":"aside","style":"tip","name":"Tip","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxAnalytics"},{"type":"text","text":" is needed in "},{"inlineContent":[{"type":"text","text":"every"}],"type":"emphasis"},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.analytics.*"},{"type":"text","text":" or "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" — including views that read the slice for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"inlineContent":[{"text":"The plugin owns reducing for ","type":"text"},{"code":".analytics","type":"codeVoice"},{"text":" actions, so the root reducer should fall through:","type":"text"}],"type":"paragraph"},{"code":["\/\/ AppReducer.swift","case .analytics:","    return nil"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-3-Provide-an-AnalyticsService","level":2,"type":"heading","text":"Step 3: Provide an `AnalyticsService`"},{"inlineContent":[{"text":"The plugin needs an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that talks to your analytics backend. Pick the path that matches your backend.","type":"text"}],"type":"paragraph"},{"anchor":"Path-A-Mixpanel-recommended","level":3,"type":"heading","text":"Path A: Mixpanel (recommended)"},{"inlineContent":[{"text":"Add the ","type":"text"},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","isActive":true,"type":"reference"},{"text":" companion package and use the supplied ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":". No bridging code on your side.","type":"text"}],"type":"paragraph"},{"code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"],"type":"codeListing","syntax":"swift"},{"code":["import SwiduxMixpanelAnalytics","","let service = MixpanelAnalyticsService(token: \"your-mixpanel-token\")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"See the package’s ","type":"text"},{"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","isActive":true,"type":"reference"},{"text":" for configuration details.","type":"text"}],"type":"paragraph"},{"anchor":"Path-B-Amplitude--PostHog--Segment--custom-backend","level":3,"type":"heading","text":"Path B: Amplitude \/ PostHog \/ Segment \/ custom backend"},{"inlineContent":[{"text":"For any non-Mixpanel backend, implement ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" directly. The protocol is small:","type":"text"}],"type":"paragraph"},{"code":["import SwiduxAnalytics","","struct MyAnalyticsService: AnalyticsService {","    func track(_ event: AnalyticsEvent) async {","        \/\/ Forward event.name + event.properties to your SDK.","    }","","    func identify(userID: String, properties: [String: AnalyticsValue]) async {","        \/\/ Set the active user and people properties.","    }","","    func alias(newID: String, previousID: String?) async {","        \/\/ Link an anonymous distinct ID to a known user ID.","    }","","    func reset() async {","        \/\/ Clear local identity (logout). Subsequent events should be anonymous.","    }","","    func flush() async {","        \/\/ Drain in-flight buffers (called by the plugin on app shutdown).","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Translate "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" cases ("},{"type":"codeVoice","code":".string"},{"type":"text","text":", "},{"type":"codeVoice","code":".int"},{"type":"text","text":", "},{"type":"codeVoice","code":".double"},{"type":"text","text":", "},{"type":"codeVoice","code":".bool"},{"type":"text","text":", "},{"type":"codeVoice","code":".date"},{"type":"text","text":", "},{"type":"codeVoice","code":".array"},{"type":"text","text":", "},{"type":"codeVoice","code":".dict"},{"type":"text","text":", "},{"type":"codeVoice","code":".null"},{"type":"text","text":") into whatever your SDK takes. The mapping is mechanical: each case has an obvious target type."}],"type":"paragraph"},{"anchor":"Previews-and-tests","level":3,"type":"heading","text":"Previews and tests"},{"inlineContent":[{"type":"text","text":"Use the built-in "},{"type":"codeVoice","code":"MockAnalyticsService"},{"type":"text","text":" for backend-agnostic previews:"}],"type":"paragraph"},{"code":["let service = MockAnalyticsService()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" ships "},{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" for Mixpanel-flavored previews."}],"type":"paragraph"},{"anchor":"Step-4-Declare-an-event-mapper","level":2,"type":"heading","text":"Step 4: Declare an event mapper"},{"inlineContent":[{"type":"text","text":"The mapper is where you decide which actions become tracked events and what properties they carry. It runs in "},{"type":"codeVoice","code":"afterReduce"},{"text":" for every non-analytics action while the user is opted in.","type":"text"}],"type":"paragraph"},{"code":["import SwiduxAnalytics","","let mapper = AnalyticsMapper<AppState, AppAction> { state, action in","    switch action {","    case .counter(.increment(let n)):","        return [AnalyticsEvent(\"counter_added\", [\"amount\": .int(n)])]","","    case .paywall(.request(let reason)):","        return [AnalyticsEvent(\"paywall_requested\", [\"reason\": .string(reason)])]","","    case .paywall(.customerInfoUpdated(let snapshot)) where snapshot.isPro:","        return [AnalyticsEvent(\"subscription_started\")]","","    default:","        return []","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A single action can produce zero, one, or several events. The mapper closure is allowed to read freely from "},{"type":"codeVoice","code":"state"},{"type":"text","text":" — that’s deliberately what gets passed in, post-reducer."}],"type":"paragraph"},{"anchor":"Step-5-Configure-auto-identify","level":2,"type":"heading","text":"Step 5: Configure auto-identify"},{"inlineContent":[{"type":"text","text":"If your app has a stable userID source (e.g. an "},{"type":"codeVoice","code":"auth.currentUserID"},{"type":"text","text":" slice), let the plugin watch it. The plugin auto-fires "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" on transitions and "},{"type":"codeVoice","code":"reset"},{"type":"text","text":" on sign-out, with no app-level plumbing."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let identity = AnalyticsIdentity<AppState>(","    userID: \\.auth.currentUserID,","    userProperties: { state in","        [","            \"subscription_tier\": state.paywall.isPro ? \"pro\" : \"free\",","            \"signup_date\": state.auth.signupDate.map(AnalyticsValue.date) ?? .null,","        ]","    }",")"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" is re-evaluated each non-analytics dispatch. The plugin re-fires "},{"type":"codeVoice","code":"service.identify"},{"type":"text","text":" whenever the returned dictionary changes — so derived people-properties (subscription tier, paywall entitlements, feature flags, A\/B variants) stay in sync with state without any explicit "},{"type":"codeVoice","code":".identify"},{"type":"text","text":" plumbing."}]},{"anchor":"Step-6-Wire-the-plugin","level":2,"type":"heading","text":"Step 6: Wire the plugin"},{"inlineContent":[{"type":"text","text":"Construct and register "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"text":" inside your ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiduxAnalytics","","let analyticsPlugin = AnalyticsPlugin<AppState, AppAction>(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","    service: MixpanelAnalyticsService(token: \"...\"),","    mapper: mapper,","    identity: identity",")","plugins.register(analyticsPlugin)"]},{"type":"heading","anchor":"Step-7-Track-screen-views","level":2,"text":"Step 7: Track screen views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".analytics(.screenView(_:))"},{"type":"text","text":" from your view’s "},{"type":"codeVoice","code":".onAppear"},{"text":" (or equivalent navigation hook). The plugin updates ","type":"text"},{"type":"codeVoice","code":"state.analytics.currentScreen"},{"type":"text","text":" and emits a "},{"type":"codeVoice","code":"screen_view"},{"type":"text","text":" event with "},{"type":"codeVoice","code":"screen_name"},{"text":" plus any extra properties.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ProfileView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        Form { \/* … *\/ }","            .onAppear { store.send(.analytics(.screenView(\"Profile\"))) }","    }","}"]},{"inlineContent":[{"type":"text","text":"Subsequent mapper-emitted events are auto-enriched with "},{"type":"codeVoice","code":"screen: \"Profile\""},{"text":" until the next ","type":"text"},{"type":"codeVoice","code":"screenView"},{"type":"text","text":" dispatch — useful for understanding "},{"type":"emphasis","inlineContent":[{"type":"text","text":"where"}]},{"type":"text","text":" an action originated without manually passing context through every event."}],"type":"paragraph"},{"type":"heading","text":"Step 8: Track ad-hoc events","anchor":"Step-8-Track-ad-hoc-events","level":2},{"inlineContent":[{"type":"text","text":"For events that don’t map cleanly from a domain action, dispatch "},{"type":"codeVoice","code":".analytics(.track(_:))"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Button(\"Share\") {","    store.send(.analytics(.track(","        AnalyticsEvent(\"share_tapped\", [\"destination\": .string(\"twitter\")])","    )))","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This bypasses the mapper but still gets "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached."}]},{"type":"heading","anchor":"Step-9-Handle-opt-out","level":2,"text":"Step 9: Handle opt-out"},{"inlineContent":[{"text":"Surface a privacy toggle that dispatches ","type":"text"},{"type":"codeVoice","code":".analytics(.setOptedOut(_:))"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["Toggle(\"Share usage analytics\", isOn: Binding(","    get: { !store.analytics.isOptedOut },","    set: { store.send(.analytics(.setOptedOut(!$0))) }","))"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"setOptedOut(true)"},{"type":"text","text":" fires, the plugin clears "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":" to clear server-side identity. While opted out, all tracking is dropped and auto-identify is paused. Opting back in re-identifies the user automatically on the next dispatch."}],"type":"paragraph"},{"type":"heading","anchor":"Engage-the-SDKs-own-consent-switch","level":3,"text":"Engage the SDK’s own consent switch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The gate above stops events Swidux dispatches. It does not tell your vendor’s SDK anything — so if that SDK collects automatic events, or is still holding its own queue, data can leave the device after the user opts out."}]},{"inlineContent":[{"type":"text","text":"If your provider has a consent API, wire it through "},{"type":"codeVoice","code":"onConsentChange"},{"type":"text","text":" when you build the plugin:"}],"type":"paragraph"},{"code":["AnalyticsPlugin(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { a } else { nil } },","    service: mixpanel,","    onConsentChange: { optedOut in","        optedOut ? mixpanel.optOutTracking() : mixpanel.optInTracking()","    }",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The hook fires for either value, and on opt-out it runs before "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":" — so the SDK’s own opt-out closes the tap before the reset hands it an identity change that is still eligible to be sent. Events already in flight when the toggle fires are not retracted; the hook shuts off what happens next. This is the one place your app names the vendor, which the line constructing the service already does."}],"type":"paragraph"},{"anchor":"Step-10-Flush-on-app-shutdown","level":2,"type":"heading","text":"Step 10: Flush on app shutdown"},{"inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" when the app moves to the background or terminates so in-flight events aren’t lost:"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","    @Environment(\\.scenePhase) private var scenePhase","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        .onChange(of: scenePhase) { _, phase in","            if phase == .background {","                Task { await store.analyticsPlugin.flush() }","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"flush()"},{"type":"text","text":" awaits any pending fire-and-forget service calls the plugin spawned, then calls "},{"type":"codeVoice","code":"service.flush()"},{"type":"text","text":" to drain the SDK’s own buffers."}],"type":"paragraph"},{"anchor":"Testing","level":2,"type":"heading","text":"Testing"},{"inlineContent":[{"type":"text","text":"Use a recording "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" to verify your mapper and explicit dispatches in tests:"}],"type":"paragraph"},{"code":["import Testing","@testable import SwiduxAnalytics","","actor RecordingAnalyticsService: AnalyticsService {","    private(set) var events: [AnalyticsEvent] = []","    func track(_ event: AnalyticsEvent) async { events.append(event) }","    func identify(userID: String, properties: [String: AnalyticsValue]) async {}","    func alias(newID: String, previousID: String?) async {}","    func reset() async {}","    func flush() async {}","}","","@Test func incrementTracks() async {","    let service = RecordingAnalyticsService()","    let store = AppStore.configured(analyticsService: service)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await service.events","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"flush()"},{"type":"text","text":" is the deterministic sync point — it awaits all pending tracking tasks before returning, so post-flush assertions are stable."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Plumb the service through a parameter on your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory so previews and tests can override it without touching the live SDK."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/swidux\/howtoaddanalytics"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides","generated":true,"anchor":"How-to-Guides"}],"references":{"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","role":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article","type":"topic","title":"Add Feature Flags"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","role":"article","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"type":"topic","url":"\/documentation\/swidux\/pluginarchitecture","kind":"article","title":"Plugin Architecture"},"https://heirloomlogic.github.io/SwiduxMixpanelAnalytics/documentation/swiduxmixpanelanalytics/":{"url":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","type":"link","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","title":"DocC reference","titleInlineContent":[{"text":"DocC reference","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","role":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","type":"topic","title":"Add a Parental Gate"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","role":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"url":"\/documentation\/swidux\/howtoaddapaywall","kind":"article","type":"topic","title":"Add a Paywall"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","role":"article","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"url":"\/documentation\/swidux\/howtoaddicloudsync","kind":"article","type":"topic","title":"Add iCloud Sync"},"https://github.com/heirloomlogic/SwiduxMixpanelAnalytics":{"url":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","type":"link","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","titleInlineContent":[{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"}]},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","role":"article","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"url":"\/documentation\/swidux\/agentskill","kind":"article","type":"topic","title":"Using the Swidux Agent Skill"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","role":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"url":"\/documentation\/swidux\/buildingadomainplugin","kind":"article","type":"topic","title":"Building a Domain Plugin"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","role":"article","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" macro — no hand-written "},{"code":"@Model","type":"codeVoice"},{"type":"text","text":" classes, database actors, or "},{"code":"StateWriter","type":"codeVoice"},{"type":"text","text":" closures."}],"type":"topic","url":"\/documentation\/swidux\/howtoaddpersistence","kind":"article","title":"Add Persistence"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","role":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"url":"\/documentation\/swidux\/howtoaddaversionkillswitch","kind":"article","type":"topic","title":"Add a Version Killswitch"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/swidux","title":"Swidux"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","role":"article","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"url":"\/documentation\/swidux\/howtocanceleffects","kind":"article","type":"topic","title":"Cancel Effects"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","role":"article","type":"topic","url":"\/documentation\/swidux\/pluginanalyticsreference","title":"SwiduxAnalytics Reference"},"doc://Swidux/documentation/Swidux/GettingStarted":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","role":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"url":"\/documentation\/swidux\/gettingstarted","kind":"article","type":"topic","title":"Getting Started with Swidux"}}}