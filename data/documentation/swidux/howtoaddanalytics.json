{"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation","title":"Related Documentation"},{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HostingRemoteConfig","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides","title":"How-to Guides"}],"abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify.","type":"text"}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"This guide takes you from a wired Swidux app to fully-tracked user behavior with screen views, action-driven events, identity management, opt-out support, and shutdown flushing. It covers state and action wiring, implementing an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":", declaring an event mapper, configuring auto-identify, and flushing on app background.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","isActive":true,"type":"reference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Before-you-start","text":"Before you start","type":"heading","level":2},{"inlineContent":[{"text":"This guide assumes:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"You have a Swidux app already wired up — ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference"},{"text":" first.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"You have an analytics backend in mind. Mixpanel is the path of least resistance via the ","type":"text"},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":" companion package, but Amplitude, PostHog, Segment, or a custom backend work just as well — the plugin doesn’t care.","type":"text"}]}]}]},{"anchor":"Step-1-Add-the-dependency","text":"Step 1: Add the dependency","type":"heading","level":2},{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" product to your app target in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxAnalytics\",","    ]",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Step-2-Add-state-and-actions","text":"Step 2: Add state and actions","type":"heading","level":2},{"inlineContent":[{"text":"Add an analytics slice to ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":", and an analytics case to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["\/\/ AppState.swift","import SwiduxAnalytics","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var analytics: AnalyticsState = .init()","    \/\/ … other slices","}"],"syntax":"swift","type":"codeListing"},{"code":["\/\/ AppAction.swift","import SwiduxAnalytics","","enum AppAction: Sendable {","    case analytics(AnalyticsAction)","    \/\/ … other cases","}"],"syntax":"swift","type":"codeListing"},{"name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"import SwiduxAnalytics"},{"text":" is needed in ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"every","type":"text"}]},{"text":" file that touches ","type":"text"},{"type":"codeVoice","code":"store.analytics.*"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"AnalyticsAction"},{"text":" — including views that read the slice for display. ","type":"text"},{"type":"codeVoice","code":"@_exported import Swidux"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":".","type":"text"}]}],"type":"aside","style":"tip"},{"type":"paragraph","inlineContent":[{"text":"The plugin owns reducing for ","type":"text"},{"code":".analytics","type":"codeVoice"},{"text":" actions, so the root reducer should fall through:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ AppReducer.swift","case .analytics:","    return nil"]},{"text":"Step 3: Provide an `AnalyticsService`","type":"heading","level":2,"anchor":"Step-3-Provide-an-AnalyticsService"},{"inlineContent":[{"text":"The plugin needs an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that talks to your analytics backend. Pick the path that matches your backend.","type":"text"}],"type":"paragraph"},{"text":"Path A: Mixpanel (recommended)","type":"heading","level":3,"anchor":"Path-A-Mixpanel-recommended"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","isActive":true,"type":"reference"},{"text":" companion package and use the supplied ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":". No bridging code on your side.","type":"text"}]},{"syntax":"swift","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"],"type":"codeListing"},{"code":["import SwiduxMixpanelAnalytics","","let service = MixpanelAnalyticsService(token: \"your-mixpanel-token\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"See the package’s ","type":"text"},{"isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","type":"reference"},{"text":" for configuration details.","type":"text"}]},{"text":"Path B: Amplitude \/ PostHog \/ Segment \/ custom backend","anchor":"Path-B-Amplitude--PostHog--Segment--custom-backend","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"For any non-Mixpanel backend, implement ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" directly. The protocol is small:","type":"text"}]},{"code":["import SwiduxAnalytics","","struct MyAnalyticsService: AnalyticsService {","    func track(_ event: AnalyticsEvent) async {","        \/\/ Forward event.name + event.properties to your SDK.","    }","","    func identify(userID: String, properties: [String: AnalyticsValue]) async {","        \/\/ Set the active user and people properties.","    }","","    func alias(newID: String, previousID: String?) async {","        \/\/ Link an anonymous distinct ID to a known user ID.","    }","","    func reset() async {","        \/\/ Clear local identity (logout). Subsequent events should be anonymous.","    }","","    func flush() async {","        \/\/ Drain in-flight buffers (called by the plugin on app shutdown).","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Translate ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" cases (","type":"text"},{"code":".string","type":"codeVoice"},{"text":", ","type":"text"},{"code":".int","type":"codeVoice"},{"text":", ","type":"text"},{"code":".double","type":"codeVoice"},{"text":", ","type":"text"},{"code":".bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":".date","type":"codeVoice"},{"text":", ","type":"text"},{"code":".array","type":"codeVoice"},{"text":", ","type":"text"},{"code":".dict","type":"codeVoice"},{"text":", ","type":"text"},{"code":".null","type":"codeVoice"},{"text":") into whatever your SDK takes. The mapping is mechanical: each case has an obvious target type.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Return promptly from each method. The plugin calls the service one call at a time, in dispatch order, so a ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" that awaits an HTTP request holds back every call behind it for the length of the request. At most 1,000 ","type":"text"},{"code":"track","type":"codeVoice"},{"text":" calls wait; past that the plugin drops the oldest queued ","type":"text"},{"code":"track","type":"codeVoice"},{"text":", while ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":", ","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" are never dropped. If you’re writing a custom backend, append to a queue and upload from a background task instead of awaiting the network in ","type":"text"},{"code":"track","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Previews-and-tests","text":"Previews and tests","type":"heading","level":3},{"inlineContent":[{"text":"Use the built-in ","type":"text"},{"code":"MockAnalyticsService","type":"codeVoice"},{"text":" for previews that don’t need to check anything, and ","type":"text"},{"code":"RecordingAnalyticsService","type":"codeVoice"},{"text":" for tests (see ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Testing","type":"text"}]},{"text":" below). Both are backend-agnostic, so neither changes when you switch provider:","type":"text"}],"type":"paragraph"},{"code":["let service = MockAnalyticsService()"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"If you’re on Path A, ","type":"text"},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":" ships its own recording stand-in for previews and tests, which also records Mixpanel’s consent controls. See its ","type":"text"},{"overridingTitle":"DocC reference","overridingTitleInlineContent":[{"text":"DocC reference","type":"text"}],"isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","type":"reference"},{"text":".","type":"text"}]},{"anchor":"Step-4-Declare-an-event-mapper","text":"Step 4: Declare an event mapper","type":"heading","level":2},{"inlineContent":[{"text":"The mapper is where you decide which actions become tracked events and what properties they carry. It runs in ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":" for every non-analytics action while the user is opted in.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiduxAnalytics","","let mapper = AnalyticsMapper<AppState, AppAction> { state, action in","    switch action {","    case .counter(.increment(let n)):","        return [AnalyticsEvent(\"counter_added\", [\"amount\": .int(n)])]","","    case .paywall(.request(let reason)):","        return [AnalyticsEvent(\"paywall_requested\", [\"reason\": .string(reason)])]","","    case .paywall(.customerInfoUpdated(let snapshot)) where snapshot.isPro:","        return [AnalyticsEvent(\"subscription_started\")]","","    default:","        return []","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"A single action can produce zero, one, or several events. The mapper closure is allowed to read freely from ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" — that’s deliberately what gets passed in, post-reducer.","type":"text"}]},{"anchor":"Step-5-Configure-auto-identify","text":"Step 5: Configure auto-identify","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"If your app has a stable userID source (e.g. an ","type":"text"},{"type":"codeVoice","code":"auth.currentUserID"},{"text":" slice), let the plugin watch it. The plugin auto-fires ","type":"text"},{"type":"codeVoice","code":"identify"},{"text":" on transitions and ","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" on sign-out, with no app-level plumbing.","type":"text"}]},{"syntax":"swift","code":["let identity = AnalyticsIdentity<AppState>(","    userID: \\.auth.currentUserID,","    userProperties: { state in","        [","            \"subscription_tier\": state.paywall.isPro ? \"pro\" : \"free\",","            \"signup_date\": state.auth.signupDate.map(AnalyticsValue.date) ?? .null,","        ]","    }",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"userProperties","type":"codeVoice"},{"text":" is re-evaluated each non-analytics dispatch. The plugin re-fires ","type":"text"},{"code":"service.identify","type":"codeVoice"},{"text":" whenever the returned dictionary changes — so derived people-properties (subscription tier, paywall entitlements, feature flags, A\/B variants) are sent without any explicit ","type":"text"},{"code":".identify","type":"codeVoice"},{"text":" plumbing. Each call carries the current dictionary; a key you stop returning is omitted, not deleted, so it keeps its last value on the profile unless you return ","type":"text"},{"code":".null","type":"codeVoice"},{"text":" for it.","type":"text"}]},{"anchor":"Step-6-Wire-the-plugin","text":"Step 6: Wire the plugin","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Construct ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":" where the app can keep a reference to it, and register it on the ","type":"text"},{"code":"PluginHost","type":"codeVoice"},{"text":" inside your ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory. ","type":"text"},{"type":"codeVoice","code":"Store"},{"text":" has no typed accessor for a registered plugin, and Step 10 needs the plugin itself to flush with a deadline:","type":"text"}]},{"code":["import SwiduxAnalytics","","typealias AppAnalytics = AnalyticsPlugin<AppState, AppAction>","","extension AnalyticsPlugin where RootState == AppState, RootAction == AppAction {","    static func configured(","        service: any AnalyticsService = MixpanelAnalyticsService(token: \"...\")","    ) -> AppAnalytics {","        AnalyticsPlugin(","            state: \\.analytics,","            action: AppAction.analytics,","            extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","            service: service,","            mapper: mapper,        \/\/ Step 4","            identity: identity     \/\/ Step 5","        )","    }","}","","extension Store where State == AppState, Action == AppAction {","    static func configured(analytics: AppAnalytics = .configured()) -> AppStore {","        let plugins = PluginHost<AppState, AppAction>()","        \/\/ … register persistence and other plugins first","        plugins.register(analytics)","        return Store(initialState: AppState(), reducer: { … }, plugins: plugins)","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-7-Track-screen-views","text":"Step 7: Track screen views","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Dispatch ","type":"text"},{"code":".analytics(.screenView(_:))","type":"codeVoice"},{"text":" from your view’s ","type":"text"},{"type":"codeVoice","code":".onAppear"},{"text":" (or equivalent navigation hook). The plugin updates ","type":"text"},{"type":"codeVoice","code":"state.analytics.currentScreen"},{"text":" and emits a ","type":"text"},{"type":"codeVoice","code":"screen_view"},{"type":"text","text":" event with "},{"type":"codeVoice","code":"screen_name"},{"text":" plus any extra properties.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ProfileView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        Form { \/* … *\/ }","            .onAppear { store.send(.analytics(.screenView(\"Profile\"))) }","    }","}"]},{"inlineContent":[{"type":"text","text":"Subsequent mapper-emitted events are auto-enriched with "},{"code":"screen: \"Profile\"","type":"codeVoice"},{"type":"text","text":" until the next "},{"type":"codeVoice","code":"screenView"},{"type":"text","text":" dispatch — useful for understanding "},{"inlineContent":[{"text":"where","type":"text"}],"type":"emphasis"},{"type":"text","text":" an action originated without manually passing context through every event."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Step 8: Track ad-hoc events","anchor":"Step-8-Track-ad-hoc-events"},{"type":"paragraph","inlineContent":[{"text":"For events that don’t map cleanly from a domain action, dispatch ","type":"text"},{"code":".analytics(.track(_:))","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","code":["Button(\"Share\") {","    store.send(.analytics(.track(","        AnalyticsEvent(\"share_tapped\", [\"destination\": .string(\"twitter\")])","    )))","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"This bypasses the mapper but still gets ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"text":" auto-attached.","type":"text"}]},{"text":"Step 9: Handle opt-out","type":"heading","level":2,"anchor":"Step-9-Handle-opt-out"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Surface a privacy toggle that dispatches "},{"code":".analytics(.setOptedOut(_:))","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["Toggle(\"Share usage analytics\", isOn: Binding(","    get: { !store.analytics.isOptedOut },","    set: { store.send(.analytics(.setOptedOut(!$0))) }","))"]},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"setOptedOut(true)","type":"codeVoice"},{"text":" fires, the plugin discards any queued ","type":"text"},{"code":"track","type":"codeVoice"},{"text":", ","type":"text"},{"code":"screenView","type":"codeVoice"},{"text":", ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" calls, clears ","type":"text"},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":", and calls ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":" to clear server-side identity. While opted out, all tracking is dropped and auto-identify is paused. Opting back in re-identifies the user automatically on the next dispatch.","type":"text"}]},{"type":"heading","level":3,"text":"Synchronize the SDK’s consent switch","anchor":"Synchronize-the-SDKs-consent-switch"},{"inlineContent":[{"text":"The gate above stops events Swidux dispatches. It does not tell your vendor’s SDK anything, so an SDK that collects automatic events or holds its own queue can still send data after the user opts out.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If your provider has a consent API, wire it through ","type":"text"},{"code":"onConsentChange","type":"codeVoice"},{"text":" when you build the plugin:","type":"text"}]},{"syntax":"swift","code":["AnalyticsPlugin(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { a } else { nil } },","    service: mixpanel,","    onConsentChange: { optedOut in","        if optedOut {","            await mixpanel.optOutTracking()","        } else {","            await mixpanel.optInTracking()","        }","    }",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Keep the consent choice in app storage and use it for both the plugin and the vendor SDK. ","type":"text"},{"code":"AnalyticsState.isOptedOut","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"text":" by default, while some vendors can start opted out. If their initial values differ, the plugin can record an identify that the vendor drops and never retry it after consent changes.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Seed the initial state from the stored choice when you configure the store:"}]},{"syntax":"swift","code":["var initialState = AppState()","initialState.analytics = AnalyticsState(isOptedOut: ConsentStore.isOptedOut)","","return Store(","    initialState: initialState,","    reducer: AppReducer().reduce,","    plugins: plugins",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Then dispatch the same value once from the root view at launch. The dispatch invokes the consent hook even when the value already matches the state, so the vendor SDK receives the stored choice:","type":"text"}]},{"code":[".task { store.send(.analytics(.setOptedOut(ConsentStore.isOptedOut))) }"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The hook fires for either value, and on opt-out it runs before ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":", so the SDK receives the withdrawal before the service reset. On opt-in it waits for that reset, so opting back in quickly never lets a stale reset land after the SDK has resumed. By then the plugin has discarded its queued ","type":"text"},{"code":"track","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"screen_view"},{"text":", ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" calls, but the opt-out’s own ","type":"text"},{"type":"codeVoice","code":"reset"},{"text":" is still queued behind the hook, and a call already taken off the queue may still be delivered. What happens to uploads the SDK has queued or started is adapter-specific, and they may be sent, retained, or discarded as consent and reset take effect. Treat this hook as neither a delivery guarantee nor a data-deletion API. This is the one place your app names the vendor, which the line constructing the service already does.","type":"text"}]},{"anchor":"Step-10-Flush-on-app-shutdown","text":"Step 10: Flush on app shutdown","type":"heading","level":2},{"inlineContent":[{"text":"Flush the plugin when the app moves to the background or terminates so queued events aren’t lost. Use the reference you kept in Step 6 and give the flush a deadline:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@main","struct MyApp: App {","    private let analytics: AppAnalytics","    @State private var store: AppStore","    @Environment(\\.scenePhase) private var scenePhase","","    init() {","        let analytics = AppAnalytics.configured()","        self.analytics = analytics","        _store = State(initialValue: AppStore.configured(analytics: analytics))","    }","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        .onChange(of: scenePhase) { _, phase in","            if phase == .background {","                Task { await analytics.flush(timeout: .seconds(2)) }","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"flush(timeout:)"},{"type":"text","text":" waits for the service calls the plugin has queued, then calls "},{"type":"codeVoice","code":"service.flush()"},{"text":" to drain the SDK’s own buffers, and gives up once the deadline passes — nothing is cancelled, the caller just stops waiting. The no-argument ","type":"text"},{"type":"codeVoice","code":"flush()"},{"type":"text","text":", and "},{"code":"store.flush()","type":"codeVoice"},{"text":", which flushes every registered plugin, wait without bound: one hung service call holds them until the OS watchdog steps in.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Testing","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"code":"RecordingAnalyticsService","type":"codeVoice"},{"text":" records every call it receives. Use it to verify your mapper and explicit dispatches in tests:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxAnalytics","import Testing","","@Test func incrementTracks() async {","    let service = RecordingAnalyticsService()","    let store = AppStore.configured(analytics: .configured(service: service))","","    store.send(.counter(.increment(5)))","    await store.flush()","","    let events = await service.trackedEvents","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"]},{"inlineContent":[{"code":"calls","type":"codeVoice"},{"text":" holds every call in arrival order, for assertions about sequence. To put consent changes in the same log, point the plugin’s consent hook at the recorder:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let service = RecordingAnalyticsService()","let plugin = AnalyticsPlugin(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { a } else { nil } },","    service: service,","    onConsentChange: { await service.setOptedOut($0) }",")","\/\/ After opting out and flushing:","#expect(await service.calls == [.setOptedOut(true), .reset, .flush])"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The recorder keeps calls a real service would drop, such as tracking while opted out, so assert consent through the "},{"code":".setOptedOut","type":"codeVoice"},{"text":" entries rather than a missing event. The log grows without limit, and the recorder logs a fault at init in Release builds.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"store.flush()"},{"type":"text","text":" is the deterministic sync point — it flushes every registered plugin, and the analytics plugin waits for every queued service call before returning, so post-flush assertions are stable. Its unbounded wait is what a test wants."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plumb the service through the plugin factory from Step 6 so previews and tests can override it without touching the live SDK."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddanalytics"]}],"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"Add Analytics"},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","interfaceLanguage":"swift"},"references":{"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","title":"Cancel Effects","role":"article","kind":"article","url":"\/documentation\/swidux\/howtocanceleffects","abstract":[{"text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic","title":"Add Feature Flags","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddicloudsync","type":"topic","title":"Add iCloud Sync","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","role":"article"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"role":"collection","type":"topic","kind":"symbol","title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"url":"\/documenta