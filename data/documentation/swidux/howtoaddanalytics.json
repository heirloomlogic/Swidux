{"kind":"article","seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides","generated":true}],"variants":[{"paths":["\/documentation\/swidux\/howtoaddanalytics"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","interfaceLanguage":"swift"},"metadata":{"title":"Add Analytics","modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article"},"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide takes you from a wired Swidux app to fully-tracked user behavior with screen views, action-driven events, identity management, opt-out support, and shutdown flushing. It covers state and action wiring, implementing an "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":", declaring an event mapper, configuring auto-identify, and flushing on app background."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an API-level reference of every type and action, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference"},{"type":"text","text":". For where domain plugins fit in the dispatch cycle, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Before you start","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"You have a Swidux app already wired up — ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true,"type":"reference"},{"text":" first.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"You have an analytics backend in mind. Mixpanel is the path of least resistance via the ","type":"text"},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":" companion package, but Amplitude, PostHog, Segment, or a custom backend work just as well — the plugin doesn’t care.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" product to your app target in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxAnalytics\",","    ]",")"],"syntax":"swift"},{"type":"heading","level":2,"text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add an analytics slice to "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":" with "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":", and an analytics case to "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["\/\/ AppState.swift","import SwiduxAnalytics","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var analytics: AnalyticsState = .init()","    \/\/ … other slices","}"],"syntax":"swift"},{"type":"codeListing","code":["\/\/ AppAction.swift","import SwiduxAnalytics","","enum AppAction: Sendable {","    case analytics(AnalyticsAction)","    \/\/ … other cases","}"],"syntax":"swift"},{"type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"import SwiduxAnalytics","type":"codeVoice"},{"text":" is needed in ","type":"text"},{"inlineContent":[{"text":"every","type":"text"}],"type":"emphasis"},{"text":" file that touches ","type":"text"},{"code":"store.analytics.*","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"text":" — including views that read the slice for display. ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"tip","name":"Tip"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"code":".analytics","type":"codeVoice"},{"type":"text","text":" actions, so the root reducer should fall through:"}]},{"type":"codeListing","code":["\/\/ AppReducer.swift","case .analytics:","    return nil"],"syntax":"swift"},{"type":"heading","level":2,"text":"Step 3: Provide an `AnalyticsService`","anchor":"Step-3-Provide-an-AnalyticsService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin needs an "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" conformer that talks to your analytics backend. Pick the path that matches your backend."}]},{"type":"heading","level":3,"text":"Path A: Mixpanel (recommended)","anchor":"Path-A-Mixpanel-recommended"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},{"type":"text","text":" companion package and use the supplied "},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":". No bridging code on your side."}]},{"type":"codeListing","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"],"syntax":"swift"},{"type":"codeListing","code":["import SwiduxMixpanelAnalytics","","let service = MixpanelAnalyticsService(token: \"your-mixpanel-token\")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See the package’s "},{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/"},{"type":"text","text":" for configuration details."}]},{"type":"heading","level":3,"text":"Path B: Amplitude \/ PostHog \/ Segment \/ custom backend","anchor":"Path-B-Amplitude--PostHog--Segment--custom-backend"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For any non-Mixpanel backend, implement "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" directly. The protocol is small:"}]},{"type":"codeListing","code":["import SwiduxAnalytics","","struct MyAnalyticsService: AnalyticsService {","    func track(_ event: AnalyticsEvent) async {","        \/\/ Forward event.name + event.properties to your SDK.","    }","","    func identify(userID: String, properties: [String: AnalyticsValue]) async {","        \/\/ Set the active user and people properties.","    }","","    func alias(newID: String, previousID: String?) async {","        \/\/ Link an anonymous distinct ID to a known user ID.","    }","","    func reset() async {","        \/\/ Clear local identity (logout). Subsequent events should be anonymous.","    }","","    func flush() async {","        \/\/ Drain in-flight buffers (called by the plugin on app shutdown).","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Translate "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" cases ("},{"code":".string","type":"codeVoice"},{"type":"text","text":", "},{"code":".int","type":"codeVoice"},{"type":"text","text":", "},{"code":".double","type":"codeVoice"},{"type":"text","text":", "},{"code":".bool","type":"codeVoice"},{"type":"text","text":", "},{"code":".date","type":"codeVoice"},{"type":"text","text":", "},{"code":".array","type":"codeVoice"},{"type":"text","text":", "},{"code":".dict","type":"codeVoice"},{"type":"text","text":", "},{"code":".null","type":"codeVoice"},{"type":"text","text":") into whatever your SDK takes. The mapping is mechanical: each case has an obvious target type."}]},{"type":"heading","level":3,"text":"Previews and tests","anchor":"Previews-and-tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the built-in "},{"code":"MockAnalyticsService","type":"codeVoice"},{"type":"text","text":" for backend-agnostic previews:"}]},{"type":"codeListing","code":["let service = MockAnalyticsService()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"type":"text","text":" ships "},{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" for Mixpanel-flavored previews."}]},{"type":"heading","level":2,"text":"Step 4: Declare an event mapper","anchor":"Step-4-Declare-an-event-mapper"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mapper is where you decide which actions become tracked events and what properties they carry. It runs in "},{"code":"afterReduce","type":"codeVoice"},{"type":"text","text":" for every non-analytics action while the user is opted in."}]},{"type":"codeListing","code":["import SwiduxAnalytics","","let mapper = AnalyticsMapper<AppState, AppAction> { state, action in","    switch action {","    case .counter(.increment(let n)):","        return [AnalyticsEvent(\"counter_added\", [\"amount\": .int(n)])]","","    case .paywall(.request(let reason)):","        return [AnalyticsEvent(\"paywall_requested\", [\"reason\": .string(reason)])]","","    case .paywall(.customerInfoUpdated(let snapshot)) where snapshot.isPro:","        return [AnalyticsEvent(\"subscription_started\")]","","    default:","        return []","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A single action can produce zero, one, or several events. The mapper closure is allowed to read freely from "},{"code":"state","type":"codeVoice"},{"type":"text","text":" — that’s deliberately what gets passed in, post-reducer."}]},{"type":"heading","level":2,"text":"Step 5: Configure auto-identify","anchor":"Step-5-Configure-auto-identify"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app has a stable userID source (e.g. an "},{"code":"auth.currentUserID","type":"codeVoice"},{"type":"text","text":" slice), let the plugin watch it. The plugin auto-fires "},{"code":"identify","type":"codeVoice"},{"type":"text","text":" on transitions and "},{"code":"reset","type":"codeVoice"},{"type":"text","text":" on sign-out, with no app-level plumbing."}]},{"type":"codeListing","code":["let identity = AnalyticsIdentity<AppState>(","    userID: \\.auth.currentUserID,","    userProperties: { state in","        [","            \"subscription_tier\": state.paywall.isPro ? \"pro\" : \"free\",","            \"signup_date\": state.auth.signupDate.map(AnalyticsValue.date) ?? .null,","        ]","    }",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"userProperties","type":"codeVoice"},{"type":"text","text":" is re-evaluated each non-analytics dispatch. The plugin re-fires "},{"code":"service.identify","type":"codeVoice"},{"type":"text","text":" whenever the returned dictionary changes — so derived people-properties (subscription tier, paywall entitlements, feature flags, A\/B variants) stay in sync with state without any explicit "},{"code":".identify","type":"codeVoice"},{"type":"text","text":" plumbing."}]},{"type":"heading","level":2,"text":"Step 6: Wire the plugin","anchor":"Step-6-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct and register "},{"code":"AnalyticsPlugin","type":"codeVoice"},{"type":"text","text":" inside your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory:"}]},{"type":"codeListing","code":["import SwiduxAnalytics","","let analyticsPlugin = AnalyticsPlugin<AppState, AppAction>(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","    service: MixpanelAnalyticsService(token: \"...\"),","    mapper: mapper,","    identity: identity",")","plugins.register(analyticsPlugin)"],"syntax":"swift"},{"type":"heading","level":2,"text":"Step 7: Track screen views","anchor":"Step-7-Track-screen-views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"code":".analytics(.screenView(_:))","type":"codeVoice"},{"type":"text","text":" from your view’s "},{"code":".onAppear","type":"codeVoice"},{"type":"text","text":" (or equivalent navigation hook). The plugin updates "},{"code":"state.analytics.currentScreen","type":"codeVoice"},{"type":"text","text":" and emits a "},{"code":"screen_view","type":"codeVoice"},{"type":"text","text":" event with "},{"code":"screen_name","type":"codeVoice"},{"type":"text","text":" plus any extra properties."}]},{"type":"codeListing","code":["struct ProfileView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        Form { \/* … *\/ }","            .onAppear { store.send(.analytics(.screenView(\"Profile\"))) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Subsequent mapper-emitted events are auto-enriched with ","type":"text"},{"code":"screen: \"Profile\"","type":"codeVoice"},{"text":" until the next ","type":"text"},{"code":"screenView","type":"codeVoice"},{"text":" dispatch — useful for understanding ","type":"text"},{"inlineContent":[{"type":"text","text":"where"}],"type":"emphasis"},{"text":" an action originated without manually passing context through every event.","type":"text"}]},{"type":"heading","level":2,"text":"Step 8: Track ad-hoc events","anchor":"Step-8-Track-ad-hoc-events"},{"inlineContent":[{"type":"text","text":"For events that don’t map cleanly from a domain action, dispatch "},{"type":"codeVoice","code":".analytics(.track(_:))"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["Button(\"Share\") {","    store.send(.analytics(.track(","        AnalyticsEvent(\"share_tapped\", [\"destination\": .string(\"twitter\")])","    )))","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This bypasses the mapper but still gets ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"type":"text","text":" auto-attached."}],"type":"paragraph"},{"text":"Step 9: Handle opt-out","level":2,"anchor":"Step-9-Handle-opt-out","type":"heading"},{"inlineContent":[{"text":"Surface a privacy toggle that dispatches ","type":"text"},{"code":".analytics(.setOptedOut(_:))","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["Toggle(\"Share usage analytics\", isOn: Binding(","    get: { !store.analytics.isOptedOut },","    set: { store.send(.analytics(.setOptedOut(!$0))) }","))"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"When "},{"code":"setOptedOut(true)","type":"codeVoice"},{"type":"text","text":" fires, the plugin clears "},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":" to clear server-side identity. While opted out, all tracking is dropped and auto-identify is paused. Opting back in re-identifies the user automatically on the next dispatch."}],"type":"paragraph"},{"text":"Step 10: Flush on app shutdown","level":2,"anchor":"Step-10-Flush-on-app-shutdown","type":"heading"},{"inlineContent":[{"text":"Call ","type":"text"},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" when the app moves to the background or terminates so in-flight events aren’t lost:"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","    @Environment(\\.scenePhase) private var scenePhase","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        .onChange(of: scenePhase) { _, phase in","            if phase == .background {","                Task { await store.analyticsPlugin.flush() }","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"flush()"},{"type":"text","text":" awaits any pending fire-and-forget service calls the plugin spawned, then calls "},{"type":"codeVoice","code":"service.flush()"},{"type":"text","text":" to drain the SDK’s own buffers."}],"type":"paragraph"},{"text":"Testing","level":2,"anchor":"Testing","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use a recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" to verify your mapper and explicit dispatches in tests:","type":"text"}]},{"code":["import Testing","@testable import SwiduxAnalytics","","actor RecordingAnalyticsService: AnalyticsService {","    private(set) var events: [AnalyticsEvent] = []","    func track(_ event: AnalyticsEvent) async { events.append(event) }","    func identify(userID: String, properties: [String: AnalyticsValue]) async {}","    func alias(newID: String, previousID: String?) async {}","    func reset() async {}","    func flush() async {}","}","","@Test func incrementTracks() async {","    let service = RecordingAnalyticsService()","    let store = AppStore.configured(analyticsService: service)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await service.events","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"flush()","type":"codeVoice"},{"type":"text","text":" is the deterministic sync point — it awaits all pending tracking tasks before returning, so post-flush assertions are stable."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Plumb the service through a parameter on your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory so previews and tests can override it without touching the live SDK."}],"type":"paragraph"}]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"topic","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"role":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","title":"Add Feature Flags"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","kind":"symbol","title":"Swidux"},"doc://Swidux/documentation/Swidux/AgentSkill":{"kind":"article","title":"Using the Swidux Agent Skill","url":"\/documentation\/swidux\/agentskill","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","type":"topic","kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"role":"article","url":"\/documentation\/swidux\/pluginanalyticsreference","title":"SwiduxAnalytics Reference"},"doc://Swidux/documentation/Swidux/GettingStarted":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","kind":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"role":"article","url":"\/documentation\/swidux\/gettingstarted","title":"Getting Started with Swidux"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","type":"topic","kind":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"role":"article","url":"\/documentation\/swidux\/buildingadomainplugin","title":"Building a Domain Plugin"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"kind":"article","title":"Add a Paywall","url":"\/documentation\/swidux\/howtoaddapaywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"kind":"article","title":"Add Persistence","url":"\/documentation\/swidux\/howtoaddpersistence","type":"topic","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":" plugin and the "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" macro — no hand-written "},{"code":"@Model","type":"codeVoice"},{"type":"text","text":" classes, database actors, or "},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","role":"article"},"https://github.com/heirloomlogic/SwiduxMixpanelAnalytics":{"type":"link","url":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","titleInlineContent":[{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic","kind":"article","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"role":"article","url":"\/documentation\/swidux\/pluginarchitecture","title":"Plugin Architecture"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"title":"Add a Parental Gate","kind":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"kind":"article","title":"Add iCloud Sync","url":"\/documentation\/swidux\/howtoaddicloudsync","type":"topic","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","type":"topic","kind":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"role":"article","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","title":"Add a Version Killswitch"},"https://heirloomlogic.github.io/SwiduxMixpanelAnalytics/documentation/swiduxmixpanelanalytics/":{"url":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","type":"link","title":"DocC reference","titleInlineContent":[{"type":"text","text":"DocC reference"}]}}}