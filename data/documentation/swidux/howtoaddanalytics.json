{"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This guide takes you from a wired Swidux app to fully-tracked user behavior with screen views, action-driven events, identity management, opt-out support, and shutdown flushing. It covers state and action wiring, implementing an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":", declaring an event mapper, configuring auto-identify, and flushing on app background.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","isActive":true,"type":"reference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Before you start","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"You have a Swidux app already wired up — ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"AppStore"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference"},{"text":" first.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"You have an analytics backend in mind. Mixpanel is the path of least resistance via the ","type":"text"},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"text":" companion package, but Amplitude, PostHog, Segment, or a custom backend work just as well — the plugin doesn’t care.","type":"text"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" product to your app target in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxAnalytics\",","    ]",")"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions"},{"type":"paragraph","inlineContent":[{"text":"Add an analytics slice to ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":", and an analytics case to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["\/\/ AppState.swift","import SwiduxAnalytics","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var analytics: AnalyticsState = .init()","    \/\/ … other slices","}"],"type":"codeListing","syntax":"swift"},{"code":["\/\/ AppAction.swift","import SwiduxAnalytics","","enum AppAction: Sendable {","    case analytics(AnalyticsAction)","    \/\/ … other cases","}"],"type":"codeListing","syntax":"swift"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxAnalytics"},{"type":"text","text":" is needed in "},{"inlineContent":[{"text":"every","type":"text"}],"type":"emphasis"},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.analytics.*"},{"type":"text","text":" or "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" — including views that read the slice for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Tip","type":"aside","style":"tip"},{"type":"paragraph","inlineContent":[{"text":"The plugin owns reducing for ","type":"text"},{"code":".analytics","type":"codeVoice"},{"text":" actions, so the root reducer should fall through:","type":"text"}]},{"code":["\/\/ AppReducer.swift","case .analytics:","    return nil"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Step 3: Provide an `AnalyticsService`","anchor":"Step-3-Provide-an-AnalyticsService"},{"type":"paragraph","inlineContent":[{"text":"The plugin needs an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that talks to your analytics backend. Pick the path that matches your backend.","type":"text"}]},{"level":3,"type":"heading","text":"Path A: Mixpanel (recommended)","anchor":"Path-A-Mixpanel-recommended"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","isActive":true,"type":"reference"},{"text":" companion package and use the supplied ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":". No bridging code on your side.","type":"text"}]},{"code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"],"type":"codeListing","syntax":"swift"},{"code":["import SwiduxMixpanelAnalytics","","let service = MixpanelAnalyticsService(token: \"your-mixpanel-token\")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"See the package’s ","type":"text"},{"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","isActive":true,"type":"reference"},{"text":" for configuration details.","type":"text"}]},{"level":3,"type":"heading","text":"Path B: Amplitude \/ PostHog \/ Segment \/ custom backend","anchor":"Path-B-Amplitude--PostHog--Segment--custom-backend"},{"type":"paragraph","inlineContent":[{"text":"For any non-Mixpanel backend, implement ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" directly. The protocol is small:","type":"text"}]},{"code":["import SwiduxAnalytics","","struct MyAnalyticsService: AnalyticsService {","    func track(_ event: AnalyticsEvent) async {","        \/\/ Forward event.name + event.properties to your SDK.","    }","","    func identify(userID: String, properties: [String: AnalyticsValue]) async {","        \/\/ Set the active user and people properties.","    }","","    func alias(newID: String, previousID: String?) async {","        \/\/ Link an anonymous distinct ID to a known user ID.","    }","","    func reset() async {","        \/\/ Clear local identity (logout). Subsequent events should be anonymous.","    }","","    func flush() async {","        \/\/ Drain in-flight buffers (called by the plugin on app shutdown).","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Translate ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" cases (","type":"text"},{"code":".string","type":"codeVoice"},{"text":", ","type":"text"},{"code":".int","type":"codeVoice"},{"text":", ","type":"text"},{"code":".double","type":"codeVoice"},{"text":", ","type":"text"},{"code":".bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":".date","type":"codeVoice"},{"text":", ","type":"text"},{"code":".array","type":"codeVoice"},{"text":", ","type":"text"},{"code":".dict","type":"codeVoice"},{"text":", ","type":"text"},{"code":".null","type":"codeVoice"},{"text":") into whatever your SDK takes. The mapping is mechanical: each case has an obvious target type.","type":"text"}]},{"level":3,"type":"heading","text":"Previews and tests","anchor":"Previews-and-tests"},{"type":"paragraph","inlineContent":[{"text":"Use the built-in ","type":"text"},{"code":"MockAnalyticsService","type":"codeVoice"},{"text":" for backend-agnostic previews:","type":"text"}]},{"code":["let service = MockAnalyticsService()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If you’re on Path A, ","type":"text"},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":" ships ","type":"text"},{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"text":" for Mixpanel-flavored previews.","type":"text"}]},{"level":2,"type":"heading","text":"Step 4: Declare an event mapper","anchor":"Step-4-Declare-an-event-mapper"},{"type":"paragraph","inlineContent":[{"text":"The mapper is where you decide which actions become tracked events and what properties they carry. It runs in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action while the user is opted in.","type":"text"}]},{"code":["import SwiduxAnalytics","","let mapper = AnalyticsMapper<AppState, AppAction> { state, action in","    switch action {","    case .counter(.increment(let n)):","        return [AnalyticsEvent(\"counter_added\", [\"amount\": .int(n)])]","","    case .paywall(.request(let reason)):","        return [AnalyticsEvent(\"paywall_requested\", [\"reason\": .string(reason)])]","","    case .paywall(.customerInfoUpdated(let snapshot)) where snapshot.isPro:","        return [AnalyticsEvent(\"subscription_started\")]","","    default:","        return []","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A single action can produce zero, one, or several events. The mapper closure is allowed to read freely from ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" — that’s deliberately what gets passed in, post-reducer.","type":"text"}]},{"level":2,"type":"heading","text":"Step 5: Configure auto-identify","anchor":"Step-5-Configure-auto-identify"},{"type":"paragraph","inlineContent":[{"text":"If your app has a stable userID source (e.g. an ","type":"text"},{"code":"auth.currentUserID","type":"codeVoice"},{"text":" slice), let the plugin watch it. The plugin auto-fires ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":" on transitions and ","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" on sign-out, with no app-level plumbing.","type":"text"}]},{"code":["let identity = AnalyticsIdentity<AppState>(","    userID: \\.auth.currentUserID,","    userProperties: { state in","        [","            \"subscription_tier\": state.paywall.isPro ? \"pro\" : \"free\",","            \"signup_date\": state.auth.signupDate.map(AnalyticsValue.date) ?? .null,","        ]","    }",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"userProperties","type":"codeVoice"},{"text":" is re-evaluated each non-analytics dispatch. The plugin re-fires ","type":"text"},{"code":"service.identify","type":"codeVoice"},{"text":" whenever the returned dictionary changes — so derived people-properties (subscription tier, paywall entitlements, feature flags, A\/B variants) stay in sync with state without any explicit ","type":"text"},{"code":".identify","type":"codeVoice"},{"text":" plumbing.","type":"text"}]},{"level":2,"type":"heading","text":"Step 6: Wire the plugin","anchor":"Step-6-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"text":"Construct and register ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":" inside your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory:","type":"text"}]},{"code":["import SwiduxAnalytics","","let analyticsPlugin = AnalyticsPlugin<AppState, AppAction>(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","    service: MixpanelAnalyticsService(token: \"...\"),","    mapper: mapper,","    identity: identity",")","plugins.register(analyticsPlugin)"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Step 7: Track screen views","anchor":"Step-7-Track-screen-views"},{"type":"paragraph","inlineContent":[{"text":"Dispatch ","type":"text"},{"code":".analytics(.screenView(_:))","type":"codeVoice"},{"text":" from your view’s ","type":"text"},{"code":".onAppear","type":"codeVoice"},{"text":" (or equivalent navigation hook). The plugin updates ","type":"text"},{"code":"state.analytics.currentScreen","type":"codeVoice"},{"text":" and emits a ","type":"text"},{"code":"screen_view","type":"codeVoice"},{"text":" event with ","type":"text"},{"code":"screen_name","type":"codeVoice"},{"text":" plus any extra properties.","type":"text"}]},{"code":["struct ProfileView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        Form { \/* … *\/ }","            .onAppear { store.send(.analytics(.screenView(\"Profile\"))) }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Subsequent mapper-emitted events are auto-enriched with ","type":"text"},{"code":"screen: \"Profile\"","type":"codeVoice"},{"text":" until the next ","type":"text"},{"code":"screenView","type":"codeVoice"},{"text":" dispatch — useful for understanding ","type":"text"},{"inlineContent":[{"type":"text","text":"where"}],"type":"emphasis"},{"text":" an action originated without manually passing context through every event.","type":"text"}]},{"level":2,"type":"heading","text":"Step 8: Track ad-hoc events","anchor":"Step-8-Track-ad-hoc-events"},{"type":"paragraph","inlineContent":[{"text":"For events that don’t map cleanly from a domain action, dispatch ","type":"text"},{"code":".analytics(.track(_:))","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["Button(\"Share\") {","    store.send(.analytics(.track(","        AnalyticsEvent(\"share_tapped\", [\"destination\": .string(\"twitter\")])","    )))","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This bypasses the mapper but still gets ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"text":" auto-attached.","type":"text"}]},{"level":2,"type":"heading","text":"Step 9: Handle opt-out","anchor":"Step-9-Handle-opt-out"},{"type":"paragraph","inlineContent":[{"text":"Surface a privacy toggle that dispatches ","type":"text"},{"code":".analytics(.setOptedOut(_:))","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["Toggle(\"Share usage analytics\", isOn: Binding(","    get: { !store.analytics.isOptedOut },","    set: { store.send(.analytics(.setOptedOut(!$0))) }","))"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"setOptedOut(true)","type":"codeVoice"},{"text":" fires, the plugin clears ","type":"text"},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":" and calls ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":" to clear server-side identity. While opted out, all tracking is dropped and auto-identify is paused. Opting back in re-identifies the user automatically on the next dispatch.","type":"text"}]},{"level":3,"type":"heading","text":"Engage the SDK’s own consent switch","anchor":"Engage-the-SDKs-own-consent-switch"},{"type":"paragraph","inlineContent":[{"text":"The gate above stops events Swidux dispatches. It does not tell your vendor’s SDK anything — so if that SDK collects automatic events, or is still holding its own queue, data can leave the device after the user opts out.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If your provider has a consent API, wire it through ","type":"text"},{"code":"onConsentChange","type":"codeVoice"},{"text":" when you build the plugin:","type":"text"}]},{"code":["AnalyticsPlugin(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { a } else { nil } },","    service: mixpanel,","    onConsentChange: { optedOut in","        optedOut ? mixpanel.optOutTracking() : mixpanel.optInTracking()","    }",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The hook fires for either value, and on opt-out it runs before ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":" — so the SDK’s own opt-out closes the tap before the reset hands it an identity change that is still eligible to be sent. Events already in flight when the toggle fires are not retracted; the hook shuts off what happens next. This is the one place your app names the vendor, which the line constructing the service already does.","type":"text"}]},{"level":2,"type":"heading","text":"Step 10: Flush on app shutdown","anchor":"Step-10-Flush-on-app-shutdown"},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":" when the app moves to the background or terminates so in-flight events aren’t lost:","type":"text"}]},{"code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","    @Environment(\\.scenePhase) private var scenePhase","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        .onChange(of: scenePhase) { _, phase in","            if phase == .background {","                Task { await store.analyticsPlugin.flush() }","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"flush()","type":"codeVoice"},{"text":" awaits any pending fire-and-forget service calls the plugin spawned, then calls ","type":"text"},{"code":"service.flush()","type":"codeVoice"},{"text":" to drain the SDK’s own buffers.","type":"text"}]},{"level":2,"type":"heading","text":"Testing","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"Use a recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" to verify your mapper and explicit dispatches in tests:","type":"text"}]},{"code":["import Testing","@testable import SwiduxAnalytics","","actor RecordingAnalyticsService: AnalyticsService {","    private(set) var events: [AnalyticsEvent] = []","    func track(_ event: AnalyticsEvent) async { events.append(event) }","    func identify(userID: String, properties: [String: AnalyticsValue]) async {}","    func alias(newID: String, previousID: String?) async {}","    func reset() async {}","    func flush() async {}","}","","@Test func incrementTracks() async {","    let service = RecordingAnalyticsService()","    let store = AppStore.configured(analyticsService: service)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await service.events","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"flush()","type":"codeVoice"},{"text":" is the deterministic sync point — it awaits all pending tracking tasks before returning, so post-flush assertions are stable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Plumb the service through a parameter on your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory so previews and tests can override it without touching the live SDK.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddanalytics"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides","anchor":"How-to-Guides","generated":true}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"title":"Add Analytics","role":"article"},"references":{"https://github.com/heirloomlogic/SwiduxMixpanelAnalytics":{"titleInlineContent":[{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"}],"url":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","type":"link","title":"SwiduxMixpanelAnalytics"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic","kind":"article","title":"Plugin Architecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"url":"\/documentation\/swidux\/pluginarchitecture","role":"article"},"doc://Swidux/documentation/Swidux":{"abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","kind":"symbol","role":"collection","title":"Swidux"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"topic","kind":"article","title":"Add a Paywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddapaywall","role":"article"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"url":"\/documentation\/swidux\/howtocanceleffects","type":"topic","title":"Cancel Effects"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"kind":"article","title":"Add a Version Killswitch","type":"topic"},"doc://Swidux/documentation/Swidux/GettingStarted":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","kind":"article","title":"Getting Started with Swidux","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"url":"\/documentation\/swidux\/gettingstarted","role":"article"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","title":"SwiduxAnalytics Reference","url":"\/documentation\/swidux\/pluginanalyticsreference","type":"topic","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","type":"topic","kind":"article","title":"Using the Swidux Agent Skill","abstract":[{"text":"Install the bundled ","type":"text"},{"type":"codeVoice","code":"swidux-ref"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"url":"\/documentation\/swidux\/agentskill","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"url":"\/documentation\/swidux\/howtoaddpersistence","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","title":"Add Persistence","role":"article","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" plugin and the ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" macro — no hand-written ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":" classes, database actors, or ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"text":" closures.","type":"text"}],"type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"url":"\/documentation\/swidux\/howtoaddaparentalgate","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","title":"Add a Parental Gate","role":"article","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"topic","kind":"article","title":"Add iCloud Sync","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddicloudsync","role":"article"},"https://heirloomlogic.github.io/SwiduxMixpanelAnalytics/documentation/swiduxmixpanelanalytics/":{"titleInlineContent":[{"text":"DocC reference","type":"text"}],"url":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","type":"link","title":"DocC reference"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","type":"topic","kind":"article","title":"Building a Domain Plugin","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"url":"\/documentation\/swidux\/buildingadomainplugin","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"topic","kind":"article","title":"Add Feature Flags","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddfeatureflags","role":"article"}}}