{"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true}],"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"Add Analytics"},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/swidux\/howtoaddanalytics"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","sections":[],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"This guide takes you from a wired Swidux app to fully-tracked user behavior with screen views, action-driven events, identity management, opt-out support, and shutdown flushing. It covers state and action wiring, implementing an "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":", declaring an event mapper, configuring auto-identify, and flushing on app background."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an API-level reference of every type and action, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference"},{"type":"text","text":". For where domain plugins fit in the dispatch cycle, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]},{"level":2,"text":"Before you start","type":"heading","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes:"}]},{"items":[{"content":[{"inlineContent":[{"text":"You have a Swidux app already wired up — ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and "},{"code":"AppStore","type":"codeVoice"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"type":"text","text":" first."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"You have an analytics backend in mind. Mixpanel is the path of least resistance via the "},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"type":"text","text":" companion package, but Amplitude, PostHog, Segment, or a custom backend work just as well — the plugin doesn’t care."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Step 1: Add the dependency","type":"heading","anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxAnalytics\",","    ]",")"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Step 2: Add state and actions","type":"heading","anchor":"Step-2-Add-state-and-actions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add an analytics slice to "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" with "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":", and an analytics case to "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":":"}]},{"code":["\/\/ AppState.swift","import SwiduxAnalytics","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var analytics: AnalyticsState = .init()","    \/\/ … other slices","}"],"type":"codeListing","syntax":"swift"},{"code":["\/\/ AppAction.swift","import SwiduxAnalytics","","enum AppAction: Sendable {","    case analytics(AnalyticsAction)","    \/\/ … other cases","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"type":"codeVoice","code":".analytics"},{"type":"text","text":" actions, so the root reducer should fall through:"}]},{"code":["\/\/ AppReducer.swift","case .analytics:","    return nil"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Step 3: Provide an `AnalyticsService`","type":"heading","anchor":"Step-3-Provide-an-AnalyticsService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin needs an "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that talks to your analytics backend. Pick the path that matches your backend."}]},{"level":3,"text":"Path A: Mixpanel (recommended)","type":"heading","anchor":"Path-A-Mixpanel-recommended"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},{"type":"text","text":" companion package and use the supplied "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":". No bridging code on your side."}]},{"code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"],"type":"codeListing","syntax":"swift"},{"code":["import SwiduxMixpanelAnalytics","","let service = MixpanelAnalyticsService(token: \"your-mixpanel-token\")"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"Path B: Amplitude \/ PostHog \/ Segment \/ custom backend","type":"heading","anchor":"Path-B-Amplitude--PostHog--Segment--custom-backend"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For any non-Mixpanel backend, implement "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" directly. The protocol is small:"}]},{"code":["import SwiduxAnalytics","","struct MyAnalyticsService: AnalyticsService {","    func track(_ event: AnalyticsEvent) async {","        \/\/ Forward event.name + event.properties to your SDK.","    }","","    func identify(userID: String, properties: [String: AnalyticsValue]) async {","        \/\/ Set the active user and people properties.","    }","","    func alias(newID: String, previousID: String?) async {","        \/\/ Link an anonymous distinct ID to a known user ID.","    }","","    func reset() async {","        \/\/ Clear local identity (logout). Subsequent events should be anonymous.","    }","","    func flush() async {","        \/\/ Drain in-flight buffers (called by the plugin on app shutdown).","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Translate "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" cases ("},{"type":"codeVoice","code":".string"},{"type":"text","text":", "},{"type":"codeVoice","code":".int"},{"type":"text","text":", "},{"type":"codeVoice","code":".double"},{"type":"text","text":", "},{"type":"codeVoice","code":".bool"},{"type":"text","text":", "},{"type":"codeVoice","code":".date"},{"type":"text","text":", "},{"type":"codeVoice","code":".array"},{"type":"text","text":", "},{"type":"codeVoice","code":".dict"},{"type":"text","text":", "},{"type":"codeVoice","code":".null"},{"type":"text","text":") into whatever your SDK takes. The mapping is mechanical: each case has an obvious target type."}]},{"type":"heading","text":"Previews and tests","level":3,"anchor":"Previews-and-tests"},{"inlineContent":[{"type":"text","text":"Use the built-in "},{"code":"MockAnalyticsService","type":"codeVoice"},{"type":"text","text":" for backend-agnostic previews:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let service = MockAnalyticsService()"]},{"inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":" ships ","type":"text"},{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"text":" for Mixpanel-flavored previews.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 4: Declare an event mapper","anchor":"Step-4-Declare-an-event-mapper"},{"inlineContent":[{"text":"The mapper is where you decide which actions become tracked events and what properties they carry. It runs in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action while the user is opted in.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiduxAnalytics","","let mapper = AnalyticsMapper<AppState, AppAction> { state, action in","    switch action {","    case .counter(.increment(let n)):","        return [AnalyticsEvent(\"counter_added\", [\"amount\": .int(n)])]","","    case .paywall(.request(let reason)):","        return [AnalyticsEvent(\"paywall_requested\", [\"reason\": .string(reason)])]","","    case .paywall(.customerInfoUpdated(let snapshot)) where snapshot.isPro:","        return [AnalyticsEvent(\"subscription_started\")]","","    default:","        return []","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A single action can produce zero, one, or several events. The mapper closure is allowed to read freely from "},{"code":"state","type":"codeVoice"},{"type":"text","text":" — that’s deliberately what gets passed in, post-reducer."}]},{"level":2,"text":"Step 5: Configure auto-identify","type":"heading","anchor":"Step-5-Configure-auto-identify"},{"inlineContent":[{"type":"text","text":"If your app has a stable userID source (e.g. an "},{"code":"auth.currentUserID","type":"codeVoice"},{"text":" slice), let the plugin watch it. The plugin auto-fires ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":" on transitions and ","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" on sign-out, with no app-level plumbing.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let identity = AnalyticsIdentity<AppState>(","    userID: \\.auth.currentUserID,","    userProperties: { state in","        [","            \"subscription_tier\": state.paywall.isPro ? \"pro\" : \"free\",","            \"signup_date\": state.auth.signupDate.map(AnalyticsValue.date) ?? .null,","        ]","    }",")"]},{"type":"paragraph","inlineContent":[{"code":"userProperties","type":"codeVoice"},{"type":"text","text":" is re-evaluated each non-analytics dispatch. The plugin re-fires "},{"type":"codeVoice","code":"service.identify"},{"type":"text","text":" whenever the returned dictionary changes — so derived people-properties (subscription tier, paywall entitlements, feature flags, A\/B variants) stay in sync with state without any explicit "},{"code":".identify","type":"codeVoice"},{"text":" plumbing.","type":"text"}]},{"level":2,"type":"heading","text":"Step 6: Wire the plugin","anchor":"Step-6-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct and register "},{"code":"AnalyticsPlugin","type":"codeVoice"},{"type":"text","text":" inside your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory:"}]},{"code":["import SwiduxAnalytics","","let analyticsPlugin = AnalyticsPlugin<AppState, AppAction>(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","    service: MixpanelAnalyticsService(token: \"...\"),","    mapper: mapper,","    identity: identity",")","plugins.register(analyticsPlugin)"],"syntax":"swift","type":"codeListing"},{"type":"heading","text":"Step 7: Track screen views","level":2,"anchor":"Step-7-Track-screen-views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"code":".analytics(.screenView(_:))","type":"codeVoice"},{"text":" from your view’s ","type":"text"},{"code":".onAppear","type":"codeVoice"},{"type":"text","text":" (or equivalent navigation hook). The plugin updates "},{"type":"codeVoice","code":"state.analytics.currentScreen"},{"type":"text","text":" and emits a "},{"code":"screen_view","type":"codeVoice"},{"text":" event with ","type":"text"},{"code":"screen_name","type":"codeVoice"},{"type":"text","text":" plus any extra properties."}]},{"code":["struct ProfileView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        Form { \/* … *\/ }","            .onAppear { store.send(.analytics(.screenView(\"Profile\"))) }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Subsequent mapper-emitted events are auto-enriched with "},{"type":"codeVoice","code":"screen: \"Profile\""},{"type":"text","text":" until the next "},{"type":"codeVoice","code":"screenView"},{"text":" dispatch — useful for understanding ","type":"text"},{"inlineContent":[{"text":"where","type":"text"}],"type":"emphasis"},{"type":"text","text":" an action originated without manually passing context through every event."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 8: Track ad-hoc events","anchor":"Step-8-Track-ad-hoc-events"},{"inlineContent":[{"type":"text","text":"For events that don’t map cleanly from a domain action, dispatch "},{"code":".analytics(.track(_:))","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Button(\"Share\") {","    store.send(.analytics(.track(","        AnalyticsEvent(\"share_tapped\", [\"destination\": .string(\"twitter\")])","    )))","}"]},{"inlineContent":[{"type":"text","text":"This bypasses the mapper but still gets "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 9: Handle opt-out","anchor":"Step-9-Handle-opt-out"},{"inlineContent":[{"text":"Surface a privacy toggle that dispatches ","type":"text"},{"type":"codeVoice","code":".analytics(.setOptedOut(_:))"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Toggle(\"Share usage analytics\", isOn: Binding(","    get: { !store.analytics.isOptedOut },","    set: { store.send(.analytics(.setOptedOut(!$0))) }","))"]},{"inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"setOptedOut(true)"},{"type":"text","text":" fires, the plugin clears "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":" to clear server-side identity. While opted out, all tracking is dropped and auto-identify is paused. Opting back in re-identifies the user automatically on the next dispatch."}],"type":"paragraph"},{"anchor":"Step-10-Flush-on-app-shutdown","text":"Step 10: Flush on app shutdown","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Call "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" when the app moves to the background or terminates so in-flight events aren’t lost:"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","    @Environment(\\.scenePhase) private var scenePhase","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        .onChange(of: scenePhase) { _, phase in","            if phase == .background {","                Task { await store.analyticsPlugin.flush() }","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"flush()","type":"codeVoice"},{"text":" awaits any pending fire-and-forget service calls the plugin spawned, then calls ","type":"text"},{"code":"service.flush()","type":"codeVoice"},{"text":" to drain the SDK’s own buffers.","type":"text"}]},{"level":2,"text":"Testing","type":"heading","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"Use a recording ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" to verify your mapper and explicit dispatches in tests:","type":"text"}]},{"code":["import Testing","@testable import SwiduxAnalytics","","actor RecordingAnalyticsService: AnalyticsService {","    private(set) var events: [AnalyticsEvent] = []","    func track(_ event: AnalyticsEvent) async { events.append(event) }","    func identify(userID: String, properties: [String: AnalyticsValue]) async {}","    func alias(newID: String, previousID: String?) async {}","    func reset() async {}","    func flush() async {}","}","","@Test func incrementTracks() async {","    let service = RecordingAnalyticsService()","    let store = AppStore.configured(analyticsService: service)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await service.events","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"flush()","type":"codeVoice"},{"text":" is the deterministic sync point — it awaits all pending tracking tasks before returning, so post-flush assertions are stable.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Plumb the service through a parameter on your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory so previews and tests can override it without touching the live SDK."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","url":"\/documentation\/swidux\/pluginanalyticsreference","kind":"article","type":"topic","title":"SwiduxAnalytics Reference","role":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}]},"https://github.com/heirloomlogic/SwiduxMixpanelAnalytics":{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","titleInlineContent":[{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"}],"url":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","type":"link","title":"SwiduxMixpanelAnalytics"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","kind":"symbol","type":"topic","title":"Swidux","role":"collection","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article","type":"topic","title":"Add Feature Flags","role":"article","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}]},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","title":"Using the Swidux Agent Skill","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}]},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","type":"topic","title":"Add a Parental Gate","role":"article","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","role":"article","title":"Getting Started with Swidux","type":"topic","url":"\/documentation\/swidux\/gettingstarted","kind":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","role":"article","title":"Add a Paywall","type":"topic","url":"\/documentation\/swidux\/howtoaddapaywall","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"url":"\/documentation\/swidux\/pluginarchitecture","title":"Plugin Architecture","kind":"article"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","url":"\/documentation\/swidux\/buildingadomainplugin","title":"Building a Domain Plugin","type":"topic","kind":"article","role":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}]},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"url":"\/documentation\/swidux\/howtoaddaversionkillswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","title":"Add a Version Killswitch","type":"topic","kind":"article","role":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}]}}}