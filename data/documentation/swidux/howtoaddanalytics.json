{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"roleHeading":"Article","title":"Add Analytics","role":"article","modules":[{"name":"Swidux"}]},"abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify.","type":"text"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"text":"This guide takes you from a wired Swidux app to fully-tracked user behavior with screen views, action-driven events, identity management, opt-out support, and shutdown flushing. It covers state and action wiring, implementing an ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":", declaring an event mapper, configuring auto-identify, and flushing on app background.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","isActive":true,"type":"reference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Before you start","type":"heading","anchor":"Before-you-start","level":2},{"inlineContent":[{"text":"This guide assumes:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"type":"text","text":" first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have an analytics backend in mind. Mixpanel is the path of least resistance via the "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" companion package, but Amplitude, PostHog, Segment, or a custom backend work just as well — the plugin doesn’t care."}]}]}]},{"text":"Step 1: Add the dependency","type":"heading","anchor":"Step-1-Add-the-dependency","level":2},{"inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" product to your app target in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxAnalytics\",","    ]",")"]},{"text":"Step 2: Add state and actions","type":"heading","anchor":"Step-2-Add-state-and-actions","level":2},{"inlineContent":[{"text":"Add an analytics slice to ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":", and an analytics case to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ AppState.swift","import SwiduxAnalytics","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var analytics: AnalyticsState = .init()","    \/\/ … other slices","}"],"syntax":"swift"},{"type":"codeListing","code":["\/\/ AppAction.swift","import SwiduxAnalytics","","enum AppAction: Sendable {","    case analytics(AnalyticsAction)","    \/\/ … other cases","}"],"syntax":"swift"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"import SwiduxAnalytics","type":"codeVoice"},{"text":" is needed in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"text":" file that touches ","type":"text"},{"code":"store.analytics.*","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"text":" — including views that read the slice for display. ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}]}],"name":"Tip","style":"tip"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"code":".analytics","type":"codeVoice"},{"type":"text","text":" actions, so the root reducer should fall through:"}]},{"type":"codeListing","code":["\/\/ AppReducer.swift","case .analytics:","    return nil"],"syntax":"swift"},{"type":"heading","level":2,"text":"Step 3: Provide an `AnalyticsService`","anchor":"Step-3-Provide-an-AnalyticsService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin needs an "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" conformer that talks to your analytics backend. Pick the path that matches your backend."}]},{"type":"heading","level":3,"text":"Path A: Mixpanel (recommended)","anchor":"Path-A-Mixpanel-recommended"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","type":"reference"},{"type":"text","text":" companion package and use the supplied "},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":". No bridging code on your side."}]},{"type":"codeListing","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"],"syntax":"swift"},{"type":"codeListing","code":["import SwiduxMixpanelAnalytics","","let service = MixpanelAnalyticsService(token: \"your-mixpanel-token\")"],"syntax":"swift"},{"type":"heading","level":3,"text":"Path B: Amplitude \/ PostHog \/ Segment \/ custom backend","anchor":"Path-B-Amplitude--PostHog--Segment--custom-backend"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For any non-Mixpanel backend, implement "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" directly. The protocol is small:"}]},{"type":"codeListing","code":["import SwiduxAnalytics","","struct MyAnalyticsService: AnalyticsService {","    func track(_ event: AnalyticsEvent) async {","        \/\/ Forward event.name + event.properties to your SDK.","    }","","    func identify(userID: String, properties: [String: AnalyticsValue]) async {","        \/\/ Set the active user and people properties.","    }","","    func alias(newID: String, previousID: String?) async {","        \/\/ Link an anonymous distinct ID to a known user ID.","    }","","    func reset() async {","        \/\/ Clear local identity (logout). Subsequent events should be anonymous.","    }","","    func flush() async {","        \/\/ Drain in-flight buffers (called by the plugin on app shutdown).","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Translate "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" cases ("},{"code":".string","type":"codeVoice"},{"type":"text","text":", "},{"code":".int","type":"codeVoice"},{"type":"text","text":", "},{"code":".double","type":"codeVoice"},{"type":"text","text":", "},{"code":".bool","type":"codeVoice"},{"type":"text","text":", "},{"code":".date","type":"codeVoice"},{"type":"text","text":", "},{"code":".array","type":"codeVoice"},{"type":"text","text":", "},{"code":".dict","type":"codeVoice"},{"type":"text","text":", "},{"code":".null","type":"codeVoice"},{"type":"text","text":") into whatever your SDK takes. The mapping is mechanical: each case has an obvious target type."}]},{"type":"heading","level":3,"text":"Previews and tests","anchor":"Previews-and-tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the built-in "},{"code":"MockAnalyticsService","type":"codeVoice"},{"type":"text","text":" for backend-agnostic previews:"}]},{"type":"codeListing","code":["let service = MockAnalyticsService()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"type":"text","text":" ships "},{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" for Mixpanel-flavored previews."}]},{"type":"heading","level":2,"text":"Step 4: Declare an event mapper","anchor":"Step-4-Declare-an-event-mapper"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mapper is where you decide which actions become tracked events and what properties they carry. It runs in "},{"code":"afterReduce","type":"codeVoice"},{"type":"text","text":" for every non-analytics action while the user is opted in."}]},{"type":"codeListing","code":["import SwiduxAnalytics","","let mapper = AnalyticsMapper<AppState, AppAction> { state, action in","    switch action {","    case .counter(.increment(let n)):","        return [AnalyticsEvent(\"counter_added\", [\"amount\": .int(n)])]","","    case .paywall(.request(let reason)):","        return [AnalyticsEvent(\"paywall_requested\", [\"reason\": .string(reason)])]","","    case .paywall(.customerInfoUpdated(let snapshot)) where snapshot.isPro:","        return [AnalyticsEvent(\"subscription_started\")]","","    default:","        return []","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A single action can produce zero, one, or several events. The mapper closure is allowed to read freely from "},{"code":"state","type":"codeVoice"},{"type":"text","text":" — that’s deliberately what gets passed in, post-reducer."}]},{"type":"heading","level":2,"text":"Step 5: Configure auto-identify","anchor":"Step-5-Configure-auto-identify"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app has a stable userID source (e.g. an "},{"type":"codeVoice","code":"auth.currentUserID"},{"text":" slice), let the plugin watch it. The plugin auto-fires ","type":"text"},{"type":"codeVoice","code":"identify"},{"text":" on transitions and ","type":"text"},{"type":"codeVoice","code":"reset"},{"text":" on sign-out, with no app-level plumbing.","type":"text"}]},{"type":"codeListing","code":["let identity = AnalyticsIdentity<AppState>(","    userID: \\.auth.currentUserID,","    userProperties: { state in","        [","            \"subscription_tier\": state.paywall.isPro ? \"pro\" : \"free\",","            \"signup_date\": state.auth.signupDate.map(AnalyticsValue.date) ?? .null,","        ]","    }",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"userProperties"},{"text":" is re-evaluated each non-analytics dispatch. The plugin re-fires ","type":"text"},{"type":"codeVoice","code":"service.identify"},{"text":" whenever the returned dictionary changes — so derived people-properties (subscription tier, paywall entitlements, feature flags, A\/B variants) stay in sync with state without any explicit ","type":"text"},{"code":".identify","type":"codeVoice"},{"type":"text","text":" plumbing."}]},{"text":"Step 6: Wire the plugin","type":"heading","anchor":"Step-6-Wire-the-plugin","level":2},{"inlineContent":[{"type":"text","text":"Construct and register "},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":" inside your ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiduxAnalytics","","let analyticsPlugin = AnalyticsPlugin<AppState, AppAction>(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","    service: MixpanelAnalyticsService(token: \"...\"),","    mapper: mapper,","    identity: identity",")","plugins.register(analyticsPlugin)"]},{"text":"Step 7: Track screen views","type":"heading","anchor":"Step-7-Track-screen-views","level":2},{"inlineContent":[{"text":"Dispatch ","type":"text"},{"type":"codeVoice","code":".analytics(.screenView(_:))"},{"text":" from your view’s ","type":"text"},{"type":"codeVoice","code":".onAppear"},{"text":" (or equivalent navigation hook). The plugin updates ","type":"text"},{"code":"state.analytics.currentScreen","type":"codeVoice"},{"type":"text","text":" and emits a "},{"code":"screen_view","type":"codeVoice"},{"text":" event with ","type":"text"},{"code":"screen_name","type":"codeVoice"},{"text":" plus any extra properties.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct ProfileView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        Form { \/* … *\/ }","            .onAppear { store.send(.analytics(.screenView(\"Profile\"))) }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Subsequent mapper-emitted events are auto-enriched with ","type":"text"},{"type":"codeVoice","code":"screen: \"Profile\""},{"text":" until the next ","type":"text"},{"type":"codeVoice","code":"screenView"},{"type":"text","text":" dispatch — useful for understanding "},{"type":"emphasis","inlineContent":[{"type":"text","text":"where"}]},{"type":"text","text":" an action originated without manually passing context through every event."}]},{"level":2,"type":"heading","text":"Step 8: Track ad-hoc events","anchor":"Step-8-Track-ad-hoc-events"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For events that don’t map cleanly from a domain action, dispatch "},{"type":"codeVoice","code":".analytics(.track(_:))"},{"type":"text","text":":"}]},{"code":["Button(\"Share\") {","    store.send(.analytics(.track(","        AnalyticsEvent(\"share_tapped\", [\"destination\": .string(\"twitter\")])","    )))","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This bypasses the mapper but still gets ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"type":"text","text":" auto-attached."}]},{"level":2,"type":"heading","text":"Step 9: Handle opt-out","anchor":"Step-9-Handle-opt-out"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Surface a privacy toggle that dispatches "},{"code":".analytics(.setOptedOut(_:))","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["Toggle(\"Share usage analytics\", isOn: Binding(","    get: { !store.analytics.isOptedOut },","    set: { store.send(.analytics(.setOptedOut(!$0))) }","))"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"code":"setOptedOut(true)","type":"codeVoice"},{"type":"text","text":" fires, the plugin clears "},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"type":"text","text":" and calls "},{"code":"service.reset()","type":"codeVoice"},{"type":"text","text":" to clear server-side identity. While opted out, all tracking is dropped and auto-identify is paused. Opting back in re-identifies the user automatically on the next dispatch."}]},{"text":"Step 10: Flush on app shutdown","anchor":"Step-10-Flush-on-app-shutdown","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" when the app moves to the background or terminates so in-flight events aren’t lost:"}]},{"type":"codeListing","syntax":"swift","code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","    @Environment(\\.scenePhase) private var scenePhase","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        .onChange(of: scenePhase) { _, phase in","            if phase == .background {","                Task { await store.analyticsPlugin.flush() }","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"flush()","type":"codeVoice"},{"type":"text","text":" awaits any pending fire-and-forget service calls the plugin spawned, then calls "},{"code":"service.flush()","type":"codeVoice"},{"type":"text","text":" to drain the SDK’s own buffers."}]},{"text":"Testing","anchor":"Testing","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a recording "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" to verify your mapper and explicit dispatches in tests:"}]},{"type":"codeListing","syntax":"swift","code":["import Testing","@testable import SwiduxAnalytics","","actor RecordingAnalyticsService: AnalyticsService {","    private(set) var events: [AnalyticsEvent] = []","    func track(_ event: AnalyticsEvent) async { events.append(event) }","    func identify(userID: String, properties: [String: AnalyticsValue]) async {}","    func alias(newID: String, previousID: String?) async {}","    func reset() async {}","    func flush() async {}","}","","@Test func incrementTracks() async {","    let service = RecordingAnalyticsService()","    let store = AppStore.configured(analyticsService: service)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await service.events","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"]},{"type":"paragraph","inlineContent":[{"code":"flush()","type":"codeVoice"},{"type":"text","text":" is the deterministic sync point — it awaits all pending tracking tasks before returning, so post-flush assertions are stable."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plumb the service through a parameter on your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory so previews and tests can override it without touching the live SDK."}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","variants":[{"paths":["\/documentation\/swidux\/howtoaddanalytics"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides","generated":true,"anchor":"How-to-Guides"}],"references":{"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"title":"Add a Version Killswitch","role":"article","url":"\/documentation\/swidux\/howtoaddaversionkillswitch"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"kind":"article","url":"\/documentation\/swidux\/howtoaddicloudsync","type":"topic","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","title":"Add iCloud Sync"},"doc://Swidux/documentation/Swidux/GettingStarted":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"title":"Getting Started with Swidux","role":"article","url":"\/documentation\/swidux\/gettingstarted"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"title":"Building a Domain Plugin","role":"article","url":"\/documentation\/swidux\/buildingadomainplugin"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"kind":"article","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"title":"Add a Parental Gate","type":"topic","role":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"url":"\/documentation\/swidux\/howtoaddaparentalgate","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"kind":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","title":"Add Feature Flags"},"doc://Swidux/documentation/Swidux":{"kind":"symbol","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"title":"Swidux","role":"collection","url":"\/documentation\/swidux"},"https://github.com/heirloomlogic/SwiduxMixpanelAnalytics":{"titleInlineContent":[{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"}],"title":"SwiduxMixpanelAnalytics","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","url":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","type":"link"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"title":"SwiduxAnalytics Reference","role":"article","url":"\/documentation\/swidux\/pluginanalyticsreference"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"title":"Add Persistence","role":"article","url":"\/documentation\/swidux\/howtoaddpersistence"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"title":"Plugin Architecture","role":"article","url":"\/documentation\/swidux\/pluginarchitecture"},"doc://Swidux/documentation/Swidux/AgentSkill":{"title":"Using the Swidux Agent Skill","type":"topic","role":"article","abstract":[{"text":"Install the bundled ","type":"text"},{"type":"codeVoice","code":"swidux-ref"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"url":"\/documentation\/swidux\/agentskill","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","kind":"article"}}}