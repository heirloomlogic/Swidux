{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"anchor":"How-to-Guides"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This guide takes you from a wired Swidux app to fully-tracked user behavior with screen views, action-driven events, identity management, opt-out support, and shutdown flushing. It covers state and action wiring, implementing an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":", declaring an event mapper, configuring auto-identify, and flushing on app background.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Before-you-start","level":2,"text":"Before you start"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"You have a Swidux app already wired up — ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"text":" first.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"You have an analytics backend in mind. Mixpanel is the path of least resistance via the ","type":"text"},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":" companion package, but Amplitude, PostHog, Segment, or a custom backend work just as well — the plugin doesn’t care.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Step-1-Add-the-dependency","level":2,"text":"Step 1: Add the dependency"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" product to your app target in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxAnalytics\",","    ]",")"],"syntax":"swift"},{"type":"heading","anchor":"Step-2-Add-state-and-actions","level":2,"text":"Step 2: Add state and actions"},{"type":"paragraph","inlineContent":[{"text":"Add an analytics slice to ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":", and an analytics case to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["\/\/ AppState.swift","import SwiduxAnalytics","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var analytics: AnalyticsState = .init()","    \/\/ … other slices","}"],"syntax":"swift"},{"type":"codeListing","code":["\/\/ AppAction.swift","import SwiduxAnalytics","","enum AppAction: Sendable {","    case analytics(AnalyticsAction)","    \/\/ … other cases","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The plugin owns reducing for ","type":"text"},{"code":".analytics","type":"codeVoice"},{"text":" actions, so the root reducer should fall through:","type":"text"}]},{"type":"codeListing","code":["\/\/ AppReducer.swift","case .analytics:","    return nil"],"syntax":"swift"},{"type":"heading","anchor":"Step-3-Provide-an-AnalyticsService","level":2,"text":"Step 3: Provide an `AnalyticsService`"},{"type":"paragraph","inlineContent":[{"text":"The plugin needs an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that talks to your analytics backend. Pick the path that matches your backend.","type":"text"}]},{"type":"heading","anchor":"Path-A-Mixpanel-recommended","level":3,"text":"Path A: Mixpanel (recommended)"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},{"text":" companion package and use the supplied ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":". No bridging code on your side.","type":"text"}]},{"type":"codeListing","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"],"syntax":"swift"},{"type":"codeListing","code":["import SwiduxMixpanelAnalytics","","let service = MixpanelAnalyticsService(token: \"your-mixpanel-token\")"],"syntax":"swift"},{"type":"heading","anchor":"Path-B-Amplitude--PostHog--Segment--custom-backend","level":3,"text":"Path B: Amplitude \/ PostHog \/ Segment \/ custom backend"},{"type":"paragraph","inlineContent":[{"text":"For any non-Mixpanel backend, implement ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" directly. The protocol is small:","type":"text"}]},{"type":"codeListing","code":["import SwiduxAnalytics","","struct MyAnalyticsService: AnalyticsService {","    func track(_ event: AnalyticsEvent) async {","        \/\/ Forward event.name + event.properties to your SDK.","    }","","    func identify(userID: String, properties: [String: AnalyticsValue]) async {","        \/\/ Set the active user and people properties.","    }","","    func alias(newID: String, previousID: String?) async {","        \/\/ Link an anonymous distinct ID to a known user ID.","    }","","    func reset() async {","        \/\/ Clear local identity (logout). Subsequent events should be anonymous.","    }","","    func flush() async {","        \/\/ Drain in-flight buffers (called by the plugin on app shutdown).","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Translate ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" cases (","type":"text"},{"code":".string","type":"codeVoice"},{"text":", ","type":"text"},{"code":".int","type":"codeVoice"},{"text":", ","type":"text"},{"code":".double","type":"codeVoice"},{"text":", ","type":"text"},{"code":".bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":".date","type":"codeVoice"},{"text":", ","type":"text"},{"code":".array","type":"codeVoice"},{"text":", ","type":"text"},{"code":".dict","type":"codeVoice"},{"text":", ","type":"text"},{"code":".null","type":"codeVoice"},{"text":") into whatever your SDK takes. The mapping is mechanical: each case has an obvious target type.","type":"text"}]},{"type":"heading","anchor":"Previews-and-tests","level":3,"text":"Previews and tests"},{"type":"paragraph","inlineContent":[{"text":"Use the built-in ","type":"text"},{"code":"MockAnalyticsService","type":"codeVoice"},{"text":" for backend-agnostic previews:","type":"text"}]},{"type":"codeListing","code":["let service = MockAnalyticsService()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If you’re on Path A, ","type":"text"},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":" ships ","type":"text"},{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"text":" for Mixpanel-flavored previews.","type":"text"}]},{"type":"heading","anchor":"Step-4-Declare-an-event-mapper","level":2,"text":"Step 4: Declare an event mapper"},{"type":"paragraph","inlineContent":[{"text":"The mapper is where you decide which actions become tracked events and what properties they carry. It runs in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action while the user is opted in.","type":"text"}]},{"type":"codeListing","code":["import SwiduxAnalytics","","let mapper = AnalyticsMapper<AppState, AppAction> { state, action in","    switch action {","    case .counter(.increment(let n)):","        return [AnalyticsEvent(\"counter_added\", [\"amount\": .int(n)])]","","    case .paywall(.request(let reason)):","        return [AnalyticsEvent(\"paywall_requested\", [\"reason\": .string(reason)])]","","    case .paywall(.customerInfoUpdated(let snapshot)) where snapshot.isPro:","        return [AnalyticsEvent(\"subscription_started\")]","","    default:","        return []","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A single action can produce zero, one, or several events. The mapper closure is allowed to read freely from ","type":"text"},{"code":"state","type":"codeVoice"},{"text":" — that’s deliberately what gets passed in, post-reducer.","type":"text"}]},{"type":"heading","anchor":"Step-5-Configure-auto-identify","level":2,"text":"Step 5: Configure auto-identify"},{"type":"paragraph","inlineContent":[{"text":"If your app has a stable userID source (e.g. an ","type":"text"},{"code":"auth.currentUserID","type":"codeVoice"},{"text":" slice), let the plugin watch it. The plugin auto-fires ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":" on transitions and ","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" on sign-out, with no app-level plumbing.","type":"text"}]},{"type":"codeListing","code":["let identity = AnalyticsIdentity<AppState>(","    userID: \\.auth.currentUserID,","    userProperties: { state in","        [","            \"subscription_tier\": state.paywall.isPro ? \"pro\" : \"free\",","            \"signup_date\": state.auth.signupDate.map(AnalyticsValue.date) ?? .null,","        ]","    }",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"userProperties","type":"codeVoice"},{"text":" is re-evaluated each non-analytics dispatch. The plugin re-fires ","type":"text"},{"code":"service.identify","type":"codeVoice"},{"text":" whenever the returned dictionary changes — so derived people-properties (subscription tier, paywall entitlements, feature flags, A\/B variants) stay in sync with state without any explicit ","type":"text"},{"code":".identify","type":"codeVoice"},{"text":" plumbing.","type":"text"}]},{"type":"heading","anchor":"Step-6-Wire-the-plugin","level":2,"text":"Step 6: Wire the plugin"},{"type":"paragraph","inlineContent":[{"text":"Construct and register ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":" inside your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory:","type":"text"}]},{"type":"codeListing","code":["import SwiduxAnalytics","","let analyticsPlugin = AnalyticsPlugin<AppState, AppAction>(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","    service: MixpanelAnalyticsService(token: \"...\"),","    mapper: mapper,","    identity: identity",")","plugins.register(analyticsPlugin)"],"syntax":"swift"},{"type":"heading","anchor":"Step-7-Track-screen-views","level":2,"text":"Step 7: Track screen views"},{"type":"paragraph","inlineContent":[{"text":"Dispatch ","type":"text"},{"code":".analytics(.screenView(_:))","type":"codeVoice"},{"text":" from your view’s ","type":"text"},{"code":".onAppear","type":"codeVoice"},{"text":" (or equivalent navigation hook). The plugin updates ","type":"text"},{"code":"state.analytics.currentScreen","type":"codeVoice"},{"text":" and emits a ","type":"text"},{"code":"screen_view","type":"codeVoice"},{"text":" event with ","type":"text"},{"code":"screen_name","type":"codeVoice"},{"text":" plus any extra properties.","type":"text"}]},{"type":"codeListing","code":["struct ProfileView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        Form { \/* … *\/ }","            .onAppear { store.send(.analytics(.screenView(\"Profile\"))) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Subsequent mapper-emitted events are auto-enriched with ","type":"text"},{"code":"screen: \"Profile\"","type":"codeVoice"},{"text":" until the next ","type":"text"},{"code":"screenView","type":"codeVoice"},{"text":" dispatch — useful for understanding ","type":"text"},{"inlineContent":[{"text":"where","type":"text"}],"type":"emphasis"},{"text":" an action originated without manually passing context through every event.","type":"text"}]},{"type":"heading","anchor":"Step-8-Track-ad-hoc-events","level":2,"text":"Step 8: Track ad-hoc events"},{"type":"paragraph","inlineContent":[{"text":"For events that don’t map cleanly from a domain action, dispatch ","type":"text"},{"code":".analytics(.track(_:))","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["Button(\"Share\") {","    store.send(.analytics(.track(","        AnalyticsEvent(\"share_tapped\", [\"destination\": .string(\"twitter\")])","    )))","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This bypasses the mapper but still gets ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"text":" auto-attached.","type":"text"}]},{"type":"heading","anchor":"Step-9-Handle-opt-out","level":2,"text":"Step 9: Handle opt-out"},{"type":"paragraph","inlineContent":[{"text":"Surface a privacy toggle that dispatches ","type":"text"},{"code":".analytics(.setOptedOut(_:))","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["Toggle(\"Share usage analytics\", isOn: Binding(","    get: { !store.analytics.isOptedOut },","    set: { store.send(.analytics(.setOptedOut(!$0))) }","))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"setOptedOut(true)","type":"codeVoice"},{"text":" fires, the plugin clears ","type":"text"},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":" and calls ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":" to clear server-side identity. While opted out, all tracking is dropped and auto-identify is paused. Opting back in re-identifies the user automatically on the next dispatch.","type":"text"}]},{"type":"heading","anchor":"Step-10-Flush-on-app-shutdown","level":2,"text":"Step 10: Flush on app shutdown"},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":" when the app moves to the background or terminates so in-flight events aren’t lost:","type":"text"}]},{"type":"codeListing","code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","    @Environment(\\.scenePhase) private var scenePhase","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        .onChange(of: scenePhase) { _, phase in","            if phase == .background {","                Task { await store.analyticsPlugin.flush() }","            }","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"flush()","type":"codeVoice"},{"text":" awaits any pending fire-and-forget service calls the plugin spawned, then calls ","type":"text"},{"code":"service.flush()","type":"codeVoice"},{"text":" to drain the SDK’s own buffers.","type":"text"}]},{"type":"heading","anchor":"Testing","level":2,"text":"Testing"},{"type":"paragraph","inlineContent":[{"text":"Use a recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" to verify your mapper and explicit dispatches in tests:","type":"text"}]},{"type":"codeListing","code":["import Testing","@testable import SwiduxAnalytics","","actor RecordingAnalyticsService: AnalyticsService {","    private(set) var events: [AnalyticsEvent] = []","    func track(_ event: AnalyticsEvent) async { events.append(event) }","    func identify(userID: String, properties: [String: AnalyticsValue]) async {}","    func alias(newID: String, previousID: String?) async {}","    func reset() async {}","    func flush() async {}","}","","@Test func incrementTracks() async {","    let service = RecordingAnalyticsService()","    let store = AppStore.configured(analyticsService: service)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await service.events","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"flush()","type":"codeVoice"},{"text":" is the deterministic sync point — it awaits all pending tracking tasks before returning, so post-flush assertions are stable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Plumb the service through a parameter on your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory so previews and tests can override it without touching the live SDK.","type":"text"}]}]}],"kind":"article","identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"paths":["\/documentation\/swidux\/howtoaddanalytics"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article","title":"Add Analytics"},"references":{"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"type":"topic","url":"\/documentation\/swidux\/howtoaddfeatureflags","title":"Add Feature Flags","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux":{"kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","title":"SwiduxAnalytics Reference","url":"\/documentation\/swidux\/pluginanalyticsreference","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}]},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","title":"Using the Swidux Agent Skill","kind":"article","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"role":"article","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","url":"\/documentation\/swidux\/howtoaddaparentalgate","title":"Add a Parental Gate","kind":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"https://github.com/heirloomlogic/SwiduxMixpanelAnalytics":{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","titleInlineContent":[{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"}],"url":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","type":"link"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}]},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","url":"\/documentation\/swidux\/buildingadomainplugin","title":"Building a Domain Plugin","kind":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","title":"Plugin Architecture","url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}]},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","title":"Add a Version Killswitch","kind":"article","abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"role":"article","type":"topic"}}}