{"kind":"article","variants":[{"paths":["\/documentation\/swidux\/howtoaddanalytics"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Add Analytics","modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},"abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"This guide takes you from a wired Swidux app to fully-tracked user behavior with screen views, action-driven events, identity management, opt-out support, and shutdown flushing. It covers state and action wiring, implementing an ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":", declaring an event mapper, configuring auto-identify, and flushing on app background.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Before-you-start","type":"heading","text":"Before you start"},{"inlineContent":[{"text":"This guide assumes:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and "},{"code":"AppStore","type":"codeVoice"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have an analytics backend in mind. Mixpanel is the path of least resistance via the "},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"type":"text","text":" companion package, but Amplitude, PostHog, Segment, or a custom backend work just as well — the plugin doesn’t care."}]}]}]},{"level":2,"anchor":"Step-1-Add-the-dependency","type":"heading","text":"Step 1: Add the dependency"},{"inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" product to your app target in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}],"type":"paragraph"},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxAnalytics\",","    ]",")"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Step-2-Add-state-and-actions","type":"heading","text":"Step 2: Add state and actions"},{"inlineContent":[{"text":"Add an analytics slice to ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":", and an analytics case to ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["\/\/ AppState.swift","import SwiduxAnalytics","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var analytics: AnalyticsState = .init()","    \/\/ … other slices","}"],"type":"codeListing","syntax":"swift"},{"code":["\/\/ AppAction.swift","import SwiduxAnalytics","","enum AppAction: Sendable {","    case analytics(AnalyticsAction)","    \/\/ … other cases","}"],"type":"codeListing","syntax":"swift"},{"style":"tip","name":"Tip","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxAnalytics"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.analytics.*"},{"type":"text","text":" or "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" — including views that read the slice for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside"},{"inlineContent":[{"text":"The plugin owns reducing for ","type":"text"},{"type":"codeVoice","code":".analytics"},{"text":" actions, so the root reducer should fall through:","type":"text"}],"type":"paragraph"},{"code":["\/\/ AppReducer.swift","case .analytics:","    return nil"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Step-3-Provide-an-AnalyticsService","type":"heading","text":"Step 3: Provide an `AnalyticsService`"},{"inlineContent":[{"text":"The plugin needs an ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" conformer that talks to your analytics backend. Pick the path that matches your backend.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Path-A-Mixpanel-recommended","type":"heading","text":"Path A: Mixpanel (recommended)"},{"inlineContent":[{"text":"Add the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},{"text":" companion package and use the supplied ","type":"text"},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"text":". No bridging code on your side.","type":"text"}],"type":"paragraph"},{"code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"],"type":"codeListing","syntax":"swift"},{"code":["import SwiduxMixpanelAnalytics","","let service = MixpanelAnalyticsService(token: \"your-mixpanel-token\")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"See the package’s ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/"},{"text":" for configuration details.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Path-B-Amplitude--PostHog--Segment--custom-backend","type":"heading","text":"Path B: Amplitude \/ PostHog \/ Segment \/ custom backend"},{"inlineContent":[{"text":"For any non-Mixpanel backend, implement ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" directly. The protocol is small:","type":"text"}],"type":"paragraph"},{"code":["import SwiduxAnalytics","","struct MyAnalyticsService: AnalyticsService {","    func track(_ event: AnalyticsEvent) async {","        \/\/ Forward event.name + event.properties to your SDK.","    }","","    func identify(userID: String, properties: [String: AnalyticsValue]) async {","        \/\/ Set the active user and people properties.","    }","","    func alias(newID: String, previousID: String?) async {","        \/\/ Link an anonymous distinct ID to a known user ID.","    }","","    func reset() async {","        \/\/ Clear local identity (logout). Subsequent events should be anonymous.","    }","","    func flush() async {","        \/\/ Drain in-flight buffers (called by the plugin on app shutdown).","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Translate ","type":"text"},{"type":"codeVoice","code":"AnalyticsValue"},{"text":" cases (","type":"text"},{"type":"codeVoice","code":".string"},{"text":", ","type":"text"},{"type":"codeVoice","code":".int"},{"text":", ","type":"text"},{"type":"codeVoice","code":".double"},{"text":", ","type":"text"},{"type":"codeVoice","code":".bool"},{"text":", ","type":"text"},{"type":"codeVoice","code":".date"},{"text":", ","type":"text"},{"type":"codeVoice","code":".array"},{"text":", ","type":"text"},{"type":"codeVoice","code":".dict"},{"text":", ","type":"text"},{"type":"codeVoice","code":".null"},{"text":") into whatever your SDK takes. The mapping is mechanical: each case has an obvious target type.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Previews-and-tests","type":"heading","text":"Previews and tests"},{"inlineContent":[{"text":"Use the built-in ","type":"text"},{"type":"codeVoice","code":"MockAnalyticsService"},{"text":" for backend-agnostic previews:","type":"text"}],"type":"paragraph"},{"code":["let service = MockAnalyticsService()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"If you’re on Path A, ","type":"text"},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"text":" ships ","type":"text"},{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"text":" for Mixpanel-flavored previews.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Step-4-Declare-an-event-mapper","type":"heading","text":"Step 4: Declare an event mapper"},{"inlineContent":[{"text":"The mapper is where you decide which actions become tracked events and what properties they carry. It runs in ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":" for every non-analytics action while the user is opted in.","type":"text"}],"type":"paragraph"},{"code":["import SwiduxAnalytics","","let mapper = AnalyticsMapper<AppState, AppAction> { state, action in","    switch action {","    case .counter(.increment(let n)):","        return [AnalyticsEvent(\"counter_added\", [\"amount\": .int(n)])]","","    case .paywall(.request(let reason)):","        return [AnalyticsEvent(\"paywall_requested\", [\"reason\": .string(reason)])]","","    case .paywall(.customerInfoUpdated(let snapshot)) where snapshot.isPro:","        return [AnalyticsEvent(\"subscription_started\")]","","    default:","        return []","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"A single action can produce zero, one, or several events. The mapper closure is allowed to read freely from ","type":"text"},{"type":"codeVoice","code":"state"},{"text":" — that’s deliberately what gets passed in, post-reducer.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Step-5-Configure-auto-identify","type":"heading","text":"Step 5: Configure auto-identify"},{"inlineContent":[{"text":"If your app has a stable userID source (e.g. an ","type":"text"},{"type":"codeVoice","code":"auth.currentUserID"},{"text":" slice), let the plugin watch it. The plugin auto-fires ","type":"text"},{"type":"codeVoice","code":"identify"},{"text":" on transitions and ","type":"text"},{"type":"codeVoice","code":"reset"},{"text":" on sign-out, with no app-level plumbing.","type":"text"}],"type":"paragraph"},{"code":["let identity = AnalyticsIdentity<AppState>(","    userID: \\.auth.currentUserID,","    userProperties: { state in","        [","            \"subscription_tier\": state.paywall.isPro ? \"pro\" : \"free\",","            \"signup_date\": state.auth.signupDate.map(AnalyticsValue.date) ?? .null,","        ]","    }",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"userProperties"},{"text":" is re-evaluated each non-analytics dispatch. The plugin re-fires ","type":"text"},{"type":"codeVoice","code":"service.identify"},{"text":" whenever the returned dictionary changes — so derived people-properties (subscription tier, paywall entitlements, feature flags, A\/B variants) stay in sync with state without any explicit ","type":"text"},{"type":"codeVoice","code":".identify"},{"text":" plumbing.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Step-6-Wire-the-plugin","type":"heading","text":"Step 6: Wire the plugin"},{"inlineContent":[{"text":"Construct and register ","type":"text"},{"type":"codeVoice","code":"AnalyticsPlugin"},{"text":" inside your ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory:","type":"text"}],"type":"paragraph"},{"code":["import SwiduxAnalytics","","let analyticsPlugin = AnalyticsPlugin<AppState, AppAction>(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","    service: MixpanelAnalyticsService(token: \"...\"),","    mapper: mapper,","    identity: identity",")","plugins.register(analyticsPlugin)"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Step-7-Track-screen-views","type":"heading","text":"Step 7: Track screen views"},{"inlineContent":[{"text":"Dispatch ","type":"text"},{"type":"codeVoice","code":".analytics(.screenView(_:))"},{"text":" from your view’s ","type":"text"},{"type":"codeVoice","code":".onAppear"},{"text":" (or equivalent navigation hook). The plugin updates ","type":"text"},{"type":"codeVoice","code":"state.analytics.currentScreen"},{"text":" and emits a ","type":"text"},{"type":"codeVoice","code":"screen_view"},{"text":" event with ","type":"text"},{"type":"codeVoice","code":"screen_name"},{"text":" plus any extra properties.","type":"text"}],"type":"paragraph"},{"code":["struct ProfileView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        Form { \/* … *\/ }","            .onAppear { store.send(.analytics(.screenView(\"Profile\"))) }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Subsequent mapper-emitted events are auto-enriched with ","type":"text"},{"type":"codeVoice","code":"screen: \"Profile\""},{"text":" until the next ","type":"text"},{"type":"codeVoice","code":"screenView"},{"text":" dispatch — useful for understanding ","type":"text"},{"inlineContent":[{"type":"text","text":"where"}],"type":"emphasis"},{"text":" an action originated without manually passing context through every event.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Step-8-Track-ad-hoc-events","type":"heading","text":"Step 8: Track ad-hoc events"},{"inlineContent":[{"text":"For events that don’t map cleanly from a domain action, dispatch ","type":"text"},{"type":"codeVoice","code":".analytics(.track(_:))"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["Button(\"Share\") {","    store.send(.analytics(.track(","        AnalyticsEvent(\"share_tapped\", [\"destination\": .string(\"twitter\")])","    )))","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"This bypasses the mapper but still gets ","type":"text"},{"type":"codeVoice","code":"currentScreen"},{"text":" auto-attached.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Step-9-Handle-opt-out","type":"heading","text":"Step 9: Handle opt-out"},{"inlineContent":[{"text":"Surface a privacy toggle that dispatches ","type":"text"},{"type":"codeVoice","code":".analytics(.setOptedOut(_:))"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["Toggle(\"Share usage analytics\", isOn: Binding(","    get: { !store.analytics.isOptedOut },","    set: { store.send(.analytics(.setOptedOut(!$0))) }","))"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"When ","type":"text"},{"type":"codeVoice","code":"setOptedOut(true)"},{"text":" fires, the plugin clears ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"text":" and calls ","type":"text"},{"type":"codeVoice","code":"service.reset()"},{"text":" to clear server-side identity. While opted out, all tracking is dropped and auto-identify is paused. Opting back in re-identifies the user automatically on the next dispatch.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Engage-the-SDKs-own-consent-switch","type":"heading","text":"Engage the SDK’s own consent switch"},{"inlineContent":[{"text":"The gate above stops events Swidux dispatches. It does not tell your vendor’s SDK anything — so if that SDK collects automatic events, or is still holding its own queue, data can leave the device after the user opts out.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If your provider has a consent API, wire it through ","type":"text"},{"type":"codeVoice","code":"onConsentChange"},{"text":" when you build the plugin:","type":"text"}],"type":"paragraph"},{"code":["AnalyticsPlugin(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { a } else { nil } },","    service: mixpanel,","    onConsentChange: { optedOut in","        optedOut ? mixpanel.optOutTracking() : mixpanel.optInTracking()","    }",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The hook fires for either value, and on opt-out it runs before ","type":"text"},{"type":"codeVoice","code":"service.reset()"},{"text":" — so the SDK’s own opt-out closes the tap before the reset hands it an identity change that is still eligible to be sent. Events already in flight when the toggle fires are not retracted; the hook shuts off what happens next. This is the one place your app names the vendor, which the line constructing the service already does.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Step-10-Flush-on-app-shutdown","type":"heading","text":"Step 10: Flush on app shutdown"},{"inlineContent":[{"text":"Call ","type":"text"},{"type":"codeVoice","code":"flush()"},{"text":" when the app moves to the background or terminates so in-flight events aren’t lost:","type":"text"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","    @Environment(\\.scenePhase) private var scenePhase","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        .onChange(of: scenePhase) { _, phase in","            if phase == .background {","                Task { await store.analyticsPlugin.flush() }","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"flush()"},{"text":" awaits any pending fire-and-forget service calls the plugin spawned, then calls ","type":"text"},{"type":"codeVoice","code":"service.flush()"},{"text":" to drain the SDK’s own buffers.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Testing","type":"heading","text":"Testing"},{"inlineContent":[{"text":"Use a recording ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" to verify your mapper and explicit dispatches in tests:","type":"text"}],"type":"paragraph"},{"code":["import Testing","@testable import SwiduxAnalytics","","actor RecordingAnalyticsService: AnalyticsService {","    private(set) var events: [AnalyticsEvent] = []","    func track(_ event: AnalyticsEvent) async { events.append(event) }","    func identify(userID: String, properties: [String: AnalyticsValue]) async {}","    func alias(newID: String, previousID: String?) async {}","    func reset() async {}","    func flush() async {}","}","","@Test func incrementTracks() async {","    let service = RecordingAnalyticsService()","    let store = AppStore.configured(analyticsService: service)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await service.events","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"flush()"},{"text":" is the deterministic sync point — it awaits all pending tracking tasks before returning, so post-flush assertions are stable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Plumb the service through a parameter on your ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory so previews and tests can override it without touching the live SDK.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"url":"\/documentation\/swidux\/howtocanceleffects","kind":"article","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"title":"Cancel Effects","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"kind":"article","url":"\/documentation\/swidux\/pluginarchitecture","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","title":"Plugin Architecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"url":"\/documentation\/swidux\/howtoaddicloudsync","kind":"article","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"topic","title":"Add iCloud Sync","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"kind":"article","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"role":"article"},"https://github.com/heirloomlogic/SwiduxMixpanelAnalytics":{"type":"link","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","titleInlineContent":[{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"}],"url":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},"https://heirloomlogic.github.io/SwiduxMixpanelAnalytics/documentation/swiduxmixpanelanalytics/":{"type":"link","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","title":"DocC reference","titleInlineContent":[{"type":"text","text":"DocC reference"}],"url":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"url":"\/documentation\/swidux\/pluginanalyticsreference","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","type":"topic","title":"SwiduxAnalytics Reference","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"title":"Add Feature Flags","url":"\/documentation\/swidux\/howtoaddfeatureflags","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"kind":"article","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"title":"Add Persistence","url":"\/documentation\/swidux\/howtoaddpersistence","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"kind":"article","type":"topic"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"title":"Building a Domain Plugin","url":"\/documentation\/swidux\/buildingadomainplugin","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"kind":"article","type":"topic"},"doc://Swidux/documentation/Swidux/AgentSkill":{"url":"\/documentation\/swidux\/agentskill","kind":"article","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"title":"Using the Swidux Agent Skill","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"url":"\/documentation\/swidux\/gettingstarted","kind":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","title":"Getting Started with Swidux","role":"article"},"doc://Swidux/documentation/Swidux":{"role":"collection","url":"\/documentation\/swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","type":"topic","title":"Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}]},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"url":"\/documentation\/swidux\/howtoaddaversionkillswitch","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","title":"Add a Version Killswitch","abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"kind":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","title":"Add a Parental Gate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"role":"article"}}}