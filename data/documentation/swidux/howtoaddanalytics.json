{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"This guide takes you from a wired Swidux app to fully-tracked user behavior with screen views, action-driven events, identity management, opt-out support, and shutdown flushing. It covers state and action wiring, implementing an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":", declaring an event mapper, configuring auto-identify, and flushing on app background.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","type":"reference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":".","type":"text"}]},{"type":"heading","text":"Before you start","anchor":"Before-you-start","level":2},{"type":"paragraph","inlineContent":[{"text":"This guide assumes:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"You have a Swidux app already wired up — ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"text":" first.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"You have an analytics backend in mind. Mixpanel is the path of least resistance via the ","type":"text"},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":" companion package, but Amplitude, PostHog, Segment, or a custom backend work just as well — the plugin doesn’t care.","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency","level":2},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" product to your app target in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxAnalytics\",","    ]",")"]},{"type":"heading","text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions","level":2},{"type":"paragraph","inlineContent":[{"text":"Add an analytics slice to ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":", and an analytics case to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppState.swift","import SwiduxAnalytics","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var analytics: AnalyticsState = .init()","    \/\/ … other slices","}"]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppAction.swift","import SwiduxAnalytics","","enum AppAction: Sendable {","    case analytics(AnalyticsAction)","    \/\/ … other cases","}"]},{"type":"aside","style":"tip","name":"Tip","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxAnalytics"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"text":"every","type":"text"}]},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.analytics.*"},{"type":"text","text":" or "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" — including views that read the slice for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"The plugin owns reducing for ","type":"text"},{"code":".analytics","type":"codeVoice"},{"text":" actions, so the root reducer should fall through:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppReducer.swift","case .analytics:","    return nil"]},{"type":"heading","text":"Step 3: Provide an `AnalyticsService`","anchor":"Step-3-Provide-an-AnalyticsService","level":2},{"type":"paragraph","inlineContent":[{"text":"The plugin needs an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that talks to your analytics backend. Pick the path that matches your backend.","type":"text"}]},{"type":"heading","text":"Path A: Mixpanel (recommended)","anchor":"Path-A-Mixpanel-recommended","level":3},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","type":"reference"},{"text":" companion package and use the supplied ","type":"text"},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":". No bridging code on your side.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"]},{"syntax":"swift","type":"codeListing","code":["import SwiduxMixpanelAnalytics","","let service = MixpanelAnalyticsService(token: \"your-mixpanel-token\")"]},{"type":"paragraph","inlineContent":[{"text":"See the package’s ","type":"text"},{"isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","type":"reference"},{"text":" for configuration details.","type":"text"}]},{"type":"heading","text":"Path B: Amplitude \/ PostHog \/ Segment \/ custom backend","anchor":"Path-B-Amplitude--PostHog--Segment--custom-backend","level":3},{"type":"paragraph","inlineContent":[{"text":"For any non-Mixpanel backend, implement ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" directly. The protocol is small:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxAnalytics","","struct MyAnalyticsService: AnalyticsService {","    func track(_ event: AnalyticsEvent) async {","        \/\/ Forward event.name + event.properties to your SDK.","    }","","    func identify(userID: String, properties: [String: AnalyticsValue]) async {","        \/\/ Set the active user and people properties.","    }","","    func alias(newID: String, previousID: String?) async {","        \/\/ Link an anonymous distinct ID to a known user ID.","    }","","    func reset() async {","        \/\/ Clear local identity (logout). Subsequent events should be anonymous.","    }","","    func flush() async {","        \/\/ Drain in-flight buffers (called by the plugin on app shutdown).","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Translate ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" cases (","type":"text"},{"code":".string","type":"codeVoice"},{"text":", ","type":"text"},{"code":".int","type":"codeVoice"},{"text":", ","type":"text"},{"code":".double","type":"codeVoice"},{"text":", ","type":"text"},{"code":".bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":".date","type":"codeVoice"},{"text":", ","type":"text"},{"code":".array","type":"codeVoice"},{"text":", ","type":"text"},{"code":".dict","type":"codeVoice"},{"text":", ","type":"text"},{"code":".null","type":"codeVoice"},{"text":") into whatever your SDK takes. The mapping is mechanical: each case has an obvious target type.","type":"text"}]},{"type":"heading","text":"Previews and tests","anchor":"Previews-and-tests","level":3},{"type":"paragraph","inlineContent":[{"text":"Use the built-in ","type":"text"},{"code":"MockAnalyticsService","type":"codeVoice"},{"text":" for backend-agnostic previews:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let service = MockAnalyticsService()"]},{"type":"paragraph","inlineContent":[{"text":"If you’re on Path A, ","type":"text"},{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"},{"text":" ships ","type":"text"},{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"text":" for Mixpanel-flavored previews.","type":"text"}]},{"type":"heading","text":"Step 4: Declare an event mapper","anchor":"Step-4-Declare-an-event-mapper","level":2},{"type":"paragraph","inlineContent":[{"text":"The mapper is where you decide which actions become tracked events and what properties they carry. It runs in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action while the user is opted in.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxAnalytics","","let mapper = AnalyticsMapper<AppState, AppAction> { state, action in","    switch action {","    case .counter(.increment(let n)):","        return [AnalyticsEvent(\"counter_added\", [\"amount\": .int(n)])]","","    case .paywall(.request(let reason)):","        return [AnalyticsEvent(\"paywall_requested\", [\"reason\": .string(reason)])]","","    case .paywall(.customerInfoUpdated(let snapshot)) where snapshot.isPro:","        return [AnalyticsEvent(\"subscription_started\")]","","    default:","        return []","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A single action can produce zero, one, or several events. The mapper closure is allowed to read freely from "},{"type":"codeVoice","code":"state"},{"type":"text","text":" — that’s deliberately what gets passed in, post-reducer."}]},{"type":"heading","text":"Step 5: Configure auto-identify","anchor":"Step-5-Configure-auto-identify","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app has a stable userID source (e.g. an "},{"type":"codeVoice","code":"auth.currentUserID"},{"type":"text","text":" slice), let the plugin watch it. The plugin auto-fires "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" on transitions and "},{"type":"codeVoice","code":"reset"},{"type":"text","text":" on sign-out, with no app-level plumbing."}]},{"syntax":"swift","type":"codeListing","code":["let identity = AnalyticsIdentity<AppState>(","    userID: \\.auth.currentUserID,","    userProperties: { state in","        [","            \"subscription_tier\": state.paywall.isPro ? \"pro\" : \"free\",","            \"signup_date\": state.auth.signupDate.map(AnalyticsValue.date) ?? .null,","        ]","    }",")"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" is re-evaluated each non-analytics dispatch. The plugin re-fires "},{"type":"codeVoice","code":"service.identify"},{"type":"text","text":" whenever the returned dictionary changes — so derived people-properties (subscription tier, paywall entitlements, feature flags, A\/B variants) stay in sync with state without any explicit "},{"type":"codeVoice","code":".identify"},{"type":"text","text":" plumbing."}]},{"type":"heading","text":"Step 6: Wire the plugin","anchor":"Step-6-Wire-the-plugin","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct and register "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":" inside your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory:"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxAnalytics","","let analyticsPlugin = AnalyticsPlugin<AppState, AppAction>(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","    service: MixpanelAnalyticsService(token: \"...\"),","    mapper: mapper,","    identity: identity",")","plugins.register(analyticsPlugin)"]},{"type":"heading","text":"Step 7: Track screen views","anchor":"Step-7-Track-screen-views","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".analytics(.screenView(_:))"},{"type":"text","text":" from your view’s "},{"type":"codeVoice","code":".onAppear"},{"type":"text","text":" (or equivalent navigation hook). The plugin updates "},{"type":"codeVoice","code":"state.analytics.currentScreen"},{"type":"text","text":" and emits a "},{"type":"codeVoice","code":"screen_view"},{"type":"text","text":" event with "},{"type":"codeVoice","code":"screen_name"},{"type":"text","text":" plus any extra properties."}]},{"syntax":"swift","type":"codeListing","code":["struct ProfileView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        Form { \/* … *\/ }","            .onAppear { store.send(.analytics(.screenView(\"Profile\"))) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Subsequent mapper-emitted events are auto-enriched with "},{"type":"codeVoice","code":"screen: \"Profile\""},{"type":"text","text":" until the next "},{"type":"codeVoice","code":"screenView"},{"type":"text","text":" dispatch — useful for understanding "},{"type":"emphasis","inlineContent":[{"text":"where","type":"text"}]},{"type":"text","text":" an action originated without manually passing context through every event."}]},{"type":"heading","text":"Step 8: Track ad-hoc events","anchor":"Step-8-Track-ad-hoc-events","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For events that don’t map cleanly from a domain action, dispatch "},{"type":"codeVoice","code":".analytics(.track(_:))"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["Button(\"Share\") {","    store.send(.analytics(.track(","        AnalyticsEvent(\"share_tapped\", [\"destination\": .string(\"twitter\")])","    )))","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This bypasses the mapper but still gets "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached."}]},{"type":"heading","text":"Step 9: Handle opt-out","anchor":"Step-9-Handle-opt-out","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Surface a privacy toggle that dispatches "},{"type":"codeVoice","code":".analytics(.setOptedOut(_:))"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["Toggle(\"Share usage analytics\", isOn: Binding(","    get: { !store.analytics.isOptedOut },","    set: { store.send(.analytics(.setOptedOut(!$0))) }","))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"setOptedOut(true)"},{"type":"text","text":" fires, the plugin clears "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":" to clear server-side identity. While opted out, all tracking is dropped and auto-identify is paused. Opting back in re-identifies the user automatically on the next dispatch."}]},{"type":"heading","text":"Engage the SDK’s own consent switch","anchor":"Engage-the-SDKs-own-consent-switch","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The gate above stops events Swidux dispatches. It does not tell your vendor’s SDK anything — so if that SDK collects automatic events, or is still holding its own queue, data can leave the device after the user opts out."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your provider has a consent API, wire it through "},{"type":"codeVoice","code":"onConsentChange"},{"type":"text","text":" when you build the plugin:"}]},{"syntax":"swift","type":"codeListing","code":["AnalyticsPlugin(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { a } else { nil } },","    service: mixpanel,","    onConsentChange: { optedOut in","        optedOut ? mixpanel.optOutTracking() : mixpanel.optInTracking()","    }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The hook fires for either value, and on opt-out it runs before "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":" — so the SDK’s own opt-out closes the tap before the reset hands it an identity change that is still eligible to be sent. Events already in flight when the toggle fires are not retracted; the hook shuts off what happens next. This is the one place your app names the vendor, which the line constructing the service already does."}]},{"type":"heading","text":"Step 10: Flush on app shutdown","anchor":"Step-10-Flush-on-app-shutdown","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" when the app moves to the background or terminates so in-flight events aren’t lost:"}]},{"syntax":"swift","type":"codeListing","code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","    @Environment(\\.scenePhase) private var scenePhase","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        .onChange(of: scenePhase) { _, phase in","            if phase == .background {","                Task { await store.analyticsPlugin.flush() }","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"flush()","type":"codeVoice"},{"text":" awaits any pending fire-and-forget service calls the plugin spawned, then calls ","type":"text"},{"code":"service.flush()","type":"codeVoice"},{"text":" to drain the SDK’s own buffers.","type":"text"}]},{"type":"heading","text":"Testing","anchor":"Testing","level":2},{"type":"paragraph","inlineContent":[{"text":"Use a recording ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" to verify your mapper and explicit dispatches in tests:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Testing","@testable import SwiduxAnalytics","","actor RecordingAnalyticsService: AnalyticsService {","    private(set) var events: [AnalyticsEvent] = []","    func track(_ event: AnalyticsEvent) async { events.append(event) }","    func identify(userID: String, properties: [String: AnalyticsValue]) async {}","    func alias(newID: String, previousID: String?) async {}","    func reset() async {}","    func flush() async {}","}","","@Test func incrementTracks() async {","    let service = RecordingAnalyticsService()","    let store = AppStore.configured(analyticsService: service)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await service.events","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"]},{"type":"paragraph","inlineContent":[{"code":"flush()","type":"codeVoice"},{"text":" is the deterministic sync point — it awaits all pending tracking tasks before returning, so post-flush assertions are stable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Plumb the service through a parameter on your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory so previews and tests can override it without touching the live SDK.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddanalytics"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides","anchor":"How-to-Guides","generated":true}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"Add Analytics"},"references":{"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","title":"Using the Swidux Agent Skill","role":"article","url":"\/documentation\/swidux\/agentskill","abstract":[{"text":"Install the bundled ","type":"text"},{"type":"codeVoice","code":"swidux-ref"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","role":"article","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"type":"topic","url":"\/documentation\/swidux\/howtoaddpersistence","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","kind":"article","role":"article","title":"Add Persistence"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","title":"Add a Parental Gate","role":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}]},"doc://Swidux/documentation/Swidux":{"type":"topic","url":"\/documentation\/swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","role":"collection","title":"Swidux"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"type":"topic","url":"\/documentation\/swidux\/howtoaddicloudsync","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","kind":"article","role":"article","title":"Add iCloud Sync"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"type":"topic","url":"\/documentation\/swidux\/pluginanalyticsreference","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","kind":"article","role":"article","title":"SwiduxAnalytics Reference"},"https://github.com/heirloomlogic/SwiduxMixpanelAnalytics":{"type":"link","title":"SwiduxMixpanelAnalytics","titleInlineContent":[{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"}],"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","url":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"kind":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","title":"Add a Version Killswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"kind":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"title":"Add Feature Flags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","role":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","title":"Plugin Architecture","role":"article","url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}]},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","title":"Building a Domain Plugin","role":"article","url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}]},"https://heirloomlogic.github.io/SwiduxMixpanelAnalytics/documentation/swiduxmixpanelanalytics/":{"title":"DocC reference","titleInlineContent":[{"text":"DocC reference","type":"text"}],"type":"link","url":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"abstract":[{"text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code.","type":"text"}],"kind":"article","type":"topic","title":"Cancel Effects","url":"\/documentation\/swidux\/howtocanceleffects","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","role":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","url":"\/documentation\/swidux\/gettingstarted","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","kind":"article","role":"article","title":"Getting Started with Swidux"}}}