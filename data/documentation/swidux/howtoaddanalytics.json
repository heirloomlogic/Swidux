{"variants":[{"paths":["\/documentation\/swidux\/howtoaddanalytics"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"text","text":"This guide takes you from a wired Swidux app to fully-tracked user behavior with screen views, action-driven events, identity management, opt-out support, and shutdown flushing. It covers state and action wiring, implementing an "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":", declaring an event mapper, configuring auto-identify, and flushing on app background."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For an API-level reference of every type and action, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","isActive":true,"type":"reference"},{"type":"text","text":". For where domain plugins fit in the dispatch cycle, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Before-you-start","type":"heading","text":"Before you start","level":2},{"inlineContent":[{"type":"text","text":"This guide assumes:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and "},{"code":"AppStore","type":"codeVoice"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference","isActive":true},{"type":"text","text":" first."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"You have an analytics backend in mind. Mixpanel is the path of least resistance via the "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" companion package, but Amplitude, PostHog, Segment, or a custom backend work just as well — the plugin doesn’t care."}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxAnalytics\",","    ]",")"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add an analytics slice to "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" with "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":", and an analytics case to "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":":"}]},{"code":["\/\/ AppState.swift","import SwiduxAnalytics","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var analytics: AnalyticsState = .init()","    \/\/ … other slices","}"],"type":"codeListing","syntax":"swift"},{"code":["\/\/ AppAction.swift","import SwiduxAnalytics","","enum AppAction: Sendable {","    case analytics(AnalyticsAction)","    \/\/ … other cases","}"],"type":"codeListing","syntax":"swift"},{"type":"aside","name":"Tip","style":"tip","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxAnalytics"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.analytics.*"},{"type":"text","text":" or "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" — including views that read the slice for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"type":"codeVoice","code":".analytics"},{"type":"text","text":" actions, so the root reducer should fall through:"}]},{"code":["\/\/ AppReducer.swift","case .analytics:","    return nil"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Step 3: Provide an `AnalyticsService`","anchor":"Step-3-Provide-an-AnalyticsService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin needs an "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that talks to your analytics backend. Pick the path that matches your backend."}]},{"level":3,"type":"heading","text":"Path A: Mixpanel (recommended)","anchor":"Path-A-Mixpanel-recommended"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","isActive":true},{"type":"text","text":" companion package and use the supplied "},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":". No bridging code on your side."}]},{"code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics\", from: \"1.0.0\"),"],"type":"codeListing","syntax":"swift"},{"code":["import SwiduxMixpanelAnalytics","","let service = MixpanelAnalyticsService(token: \"your-mixpanel-token\")"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"Path B: Amplitude \/ PostHog \/ Segment \/ custom backend","anchor":"Path-B-Amplitude--PostHog--Segment--custom-backend"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For any non-Mixpanel backend, implement "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" directly. The protocol is small:"}]},{"code":["import SwiduxAnalytics","","struct MyAnalyticsService: AnalyticsService {","    func track(_ event: AnalyticsEvent) async {","        \/\/ Forward event.name + event.properties to your SDK.","    }","","    func identify(userID: String, properties: [String: AnalyticsValue]) async {","        \/\/ Set the active user and people properties.","    }","","    func alias(newID: String, previousID: String?) async {","        \/\/ Link an anonymous distinct ID to a known user ID.","    }","","    func reset() async {","        \/\/ Clear local identity (logout). Subsequent events should be anonymous.","    }","","    func flush() async {","        \/\/ Drain in-flight buffers (called by the plugin on app shutdown).","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Translate "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" cases ("},{"type":"codeVoice","code":".string"},{"type":"text","text":", "},{"type":"codeVoice","code":".int"},{"type":"text","text":", "},{"type":"codeVoice","code":".double"},{"type":"text","text":", "},{"type":"codeVoice","code":".bool"},{"type":"text","text":", "},{"type":"codeVoice","code":".date"},{"type":"text","text":", "},{"type":"codeVoice","code":".array"},{"type":"text","text":", "},{"type":"codeVoice","code":".dict"},{"type":"text","text":", "},{"type":"codeVoice","code":".null"},{"type":"text","text":") into whatever your SDK takes. The mapping is mechanical: each case has an obvious target type."}]},{"level":3,"type":"heading","text":"Previews and tests","anchor":"Previews-and-tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the built-in "},{"type":"codeVoice","code":"MockAnalyticsService"},{"type":"text","text":" for backend-agnostic previews:"}]},{"code":["let service = MockAnalyticsService()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"},{"type":"text","text":" ships "},{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" for Mixpanel-flavored previews."}]},{"level":2,"type":"heading","text":"Step 4: Declare an event mapper","anchor":"Step-4-Declare-an-event-mapper"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mapper is where you decide which actions become tracked events and what properties they carry. It runs in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action while the user is opted in."}]},{"code":["import SwiduxAnalytics","","let mapper = AnalyticsMapper<AppState, AppAction> { state, action in","    switch action {","    case .counter(.increment(let n)):","        return [AnalyticsEvent(\"counter_added\", [\"amount\": .int(n)])]","","    case .paywall(.request(let reason)):","        return [AnalyticsEvent(\"paywall_requested\", [\"reason\": .string(reason)])]","","    case .paywall(.customerInfoUpdated(let snapshot)) where snapshot.isPro:","        return [AnalyticsEvent(\"subscription_started\")]","","    default:","        return []","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A single action can produce zero, one, or several events. The mapper closure is allowed to read freely from "},{"type":"codeVoice","code":"state"},{"type":"text","text":" — that’s deliberately what gets passed in, post-reducer."}]},{"level":2,"type":"heading","text":"Step 5: Configure auto-identify","anchor":"Step-5-Configure-auto-identify"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app has a stable userID source (e.g. an "},{"type":"codeVoice","code":"auth.currentUserID"},{"type":"text","text":" slice), let the plugin watch it. The plugin auto-fires "},{"type":"codeVoice","code":"identify"},{"type":"text","text":" on transitions and "},{"type":"codeVoice","code":"reset"},{"type":"text","text":" on sign-out, with no app-level plumbing."}]},{"code":["let identity = AnalyticsIdentity<AppState>(","    userID: \\.auth.currentUserID,","    userProperties: { state in","        [","            \"subscription_tier\": state.paywall.isPro ? \"pro\" : \"free\",","            \"signup_date\": state.auth.signupDate.map(AnalyticsValue.date) ?? .null,","        ]","    }",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" is re-evaluated each non-analytics dispatch. The plugin re-fires "},{"type":"codeVoice","code":"service.identify"},{"type":"text","text":" whenever the returned dictionary changes — so derived people-properties (subscription tier, paywall entitlements, feature flags, A\/B variants) stay in sync with state without any explicit "},{"type":"codeVoice","code":".identify"},{"type":"text","text":" plumbing."}]},{"level":2,"type":"heading","text":"Step 6: Wire the plugin","anchor":"Step-6-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct and register "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":" inside your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory:"}]},{"code":["import SwiduxAnalytics","","let analyticsPlugin = AnalyticsPlugin<AppState, AppAction>(","    state: \\.analytics,","    action: AppAction.analytics,","    extractAction: { if case .analytics(let a) = $0 { return a }; return nil },","    service: MixpanelAnalyticsService(token: \"...\"),","    mapper: mapper,","    identity: identity",")","plugins.register(analyticsPlugin)"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Step 7: Track screen views","anchor":"Step-7-Track-screen-views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".analytics(.screenView(_:))"},{"type":"text","text":" from your view’s "},{"type":"codeVoice","code":".onAppear"},{"type":"text","text":" (or equivalent navigation hook). The plugin updates "},{"type":"codeVoice","code":"state.analytics.currentScreen"},{"type":"text","text":" and emits a "},{"type":"codeVoice","code":"screen_view"},{"type":"text","text":" event with "},{"type":"codeVoice","code":"screen_name"},{"type":"text","text":" plus any extra properties."}]},{"code":["struct ProfileView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        Form { \/* … *\/ }","            .onAppear { store.send(.analytics(.screenView(\"Profile\"))) }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Subsequent mapper-emitted events are auto-enriched with "},{"type":"codeVoice","code":"screen: \"Profile\""},{"type":"text","text":" until the next "},{"type":"codeVoice","code":"screenView"},{"type":"text","text":" dispatch — useful for understanding "},{"type":"emphasis","inlineContent":[{"type":"text","text":"where"}]},{"type":"text","text":" an action originated without manually passing context through every event."}]},{"level":2,"type":"heading","text":"Step 8: Track ad-hoc events","anchor":"Step-8-Track-ad-hoc-events"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For events that don’t map cleanly from a domain action, dispatch "},{"type":"codeVoice","code":".analytics(.track(_:))"},{"type":"text","text":":"}]},{"code":["Button(\"Share\") {","    store.send(.analytics(.track(","        AnalyticsEvent(\"share_tapped\", [\"destination\": .string(\"twitter\")])","    )))","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This bypasses the mapper but still gets "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached."}]},{"level":2,"type":"heading","text":"Step 9: Handle opt-out","anchor":"Step-9-Handle-opt-out"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Surface a privacy toggle that dispatches "},{"type":"codeVoice","code":".analytics(.setOptedOut(_:))"},{"type":"text","text":":"}]},{"code":["Toggle(\"Share usage analytics\", isOn: Binding(","    get: { !store.analytics.isOptedOut },","    set: { store.send(.analytics(.setOptedOut(!$0))) }","))"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"setOptedOut(true)"},{"type":"text","text":" fires, the plugin clears "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":" to clear server-side identity. While opted out, all tracking is dropped and auto-identify is paused. Opting back in re-identifies the user automatically on the next dispatch."}]},{"level":2,"type":"heading","text":"Step 10: Flush on app shutdown","anchor":"Step-10-Flush-on-app-shutdown"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" when the app moves to the background or terminates so in-flight events aren’t lost:"}]},{"code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","    @Environment(\\.scenePhase) private var scenePhase","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        .onChange(of: scenePhase) { _, phase in","            if phase == .background {","                Task { await store.analyticsPlugin.flush() }","            }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"flush()"},{"type":"text","text":" awaits any pending fire-and-forget service calls the plugin spawned, then calls "},{"type":"codeVoice","code":"service.flush()"},{"type":"text","text":" to drain the SDK’s own buffers."}]},{"level":2,"type":"heading","text":"Testing","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use a recording "},{"type":"codeVoice","code":"AnalyticsService"},{"text":" to verify your mapper and explicit dispatches in tests:","type":"text"}]},{"code":["import Testing","@testable import SwiduxAnalytics","","actor RecordingAnalyticsService: AnalyticsService {","    private(set) var events: [AnalyticsEvent] = []","    func track(_ event: AnalyticsEvent) async { events.append(event) }","    func identify(userID: String, properties: [String: AnalyticsValue]) async {}","    func alias(newID: String, previousID: String?) async {}","    func reset() async {}","    func flush() async {}","}","","@Test func incrementTracks() async {","    let service = RecordingAnalyticsService()","    let store = AppStore.configured(analyticsService: service)","","    store.send(.counter(.increment(5)))","    await store.analyticsPlugin.flush()","","    let events = await service.events","    #expect(events.first?.name == \"counter_added\")","    #expect(events.first?.properties[\"amount\"] == .int(5))","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"flush()","type":"codeVoice"},{"text":" is the deterministic sync point — it awaits all pending tracking tasks before returning, so post-flush assertions are stable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Plumb the service through a parameter on your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory so previews and tests can override it without touching the live SDK.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"Add Analytics"},"kind":"article","seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"title":"How-to Guides"}],"references":{"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"url":"\/documentation\/swidux\/buildingadomainplugin","kind":"article","type":"topic","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","title":"Building a Domain Plugin"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"title":"Plugin Architecture","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","url":"\/documentation\/swidux\/pluginarchitecture"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic","title":"Add a Paywall","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","type":"topic","title":"Add a Version Killswitch","role":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"role":"article","type":"topic","kind":"article","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","url":"\/documentation\/swidux\/howtoaddicloudsync","type":"topic","title":"Add iCloud Sync","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"role":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article","title":"Add Feature Flags"},"doc://Swidux/documentation/Swidux":{"title":"Swidux","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"role":"collection","url":"\/documentation\/swidux","kind":"symbol"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"title":"Add Persistence","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","url":"\/documentation\/swidux\/howtoaddpersistence"},"https://github.com/heirloomlogic/SwiduxMixpanelAnalytics":{"titleInlineContent":[{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"}],"url":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","type":"link","title":"SwiduxMixpanelAnalytics"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"title":"Add a Parental Gate","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","url":"\/documentation\/swidux\/howtoaddaparentalgate"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"title":"SwiduxAnalytics Reference","url":"\/documentation\/swidux\/pluginanalyticsreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","type":"topic","role":"article","kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}]},"doc://Swidux/documentation/Swidux/AgentSkill":{"url":"\/documentation\/swidux\/agentskill","kind":"article","type":"topic","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","title":"Using the Swidux Agent Skill"}}}