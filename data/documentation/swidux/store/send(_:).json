{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"send","kind":"identifier"},{"text":"(","kind":"text"},{"text":"_","kind":"externalParam"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"action"},{"kind":"text","text":": "},{"text":"Action","kind":"typeIdentifier"},{"text":")","kind":"text"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Re-entrant calls — a synchronous "},{"type":"codeVoice","code":"send"},{"type":"text","text":" from inside a reducer or plugin"},{"text":" ","type":"text"},{"type":"text","text":"hook — are deferred and run as full cycles immediately after the current"},{"type":"text","text":" "},{"text":"one, in FIFO order. Running them inline would pack stale state and let","type":"text"},{"type":"text","text":" "},{"text":"the outer dispatch clobber the inner one’s changes. Prefer dispatching","type":"text"},{"text":" ","type":"text"},{"text":"follow-up actions from an ","type":"text"},{"type":"codeVoice","code":"Effect"},{"text":"; deferral is a safety net, and each","type":"text"},{"text":" ","type":"text"},{"text":"occurrence logs a fault.","type":"text"}]}],"kind":"content"}],"kind":"symbol","abstract":[{"text":"Dispatches an action through the full plugin → reducer → effect cycle.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/store\/send(_:)"]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/send(_:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/Store"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"me