{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/store\/send(_:)"]}],"abstract":[{"text":"Dispatches an action through the full plugin → reducer → effect cycle.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"send"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":" "},{"kind":"internalParam","text":"action"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":")"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Re-entrant calls — a synchronous "},{"type":"codeVoice","code":"send"},{"type":"text","text":" from inside a reducer or plugin"},{"type":"text","text":" "},{"type":"text","text":"hook — are deferred and run as full cycles immediately after the current"},{"type":"text","text":" "},{"type":"text","text":"one, in FIFO order. Running them inline would pack stale state and let"},{"type":"text","text":" "},{"type":"text","text":"the outer dispatch clobber the inner one’s changes. Prefer dispatching"},{"type":"text","text":" "},{"type":"text","text":"follow-up actions from an "},{"type":"codeVoice","code":"Effect"},{"type":"text","text":"; deferral is a safety net, and each"},{"type":"text","text":" "},{"type":"text","text":"occurrence logs a fault."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/Store"]]},"kind":"symbol","identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/send(_:)","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"major":0,"patch":0,