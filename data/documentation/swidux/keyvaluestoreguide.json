{"seeAlsoSections":[{"generated":true,"title":"Reference","anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"roleHeading":"API Collection","title":"KeyValueStore","modules":[{"name":"Swidux"}],"role":"collectionGroup"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"},{"text":" is a small protocol for one-shot scalar values that don’t fit","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" model. Three implementations ship:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference"},{"text":" — production, backed by any ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" suite","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true,"type":"reference"},{"type":"text","text":" — production, backed by the system Keychain (survives reinstall)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","isActive":true},{"type":"text","text":" — tests, dictionary-backed, reference semantics"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Inject through your ","type":"text"},{"type":"codeVoice","code":"Environment"},{"type":"text","text":", hydrate state at startup, and write from"},{"type":"text","text":" "},{"type":"text","text":"effects. Reducers stay pure."}]},{"code":["public protocol KeyValueStore: Sendable {","    func value<Value>(_ key: KVKey<Value>) -> Value?","    @discardableResult","    func setValue<Value>(_ value: Value?, for key: KVKey<Value>) -> Bool","    @discardableResult","    func removeValue<Value>(for key: KVKey<Value>) -> Bool","    func contains<Value>(_ key: KVKey<Value>) -> Bool","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"All values are JSON-encoded as "},{"type":"codeVoice","code":"Data"},{"type":"text","text":". Reads and writes go through "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which pairs a backing-store name with its "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" value type at compile time."}],"type":"paragraph"},{"anchor":"When-to-Use-What","type":"heading","level":2,"text":"When to Use What"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Need","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Collection of identifiable entities (decks, cards, sessions)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" + "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Scalar preference (theme, sort order, last-seen version)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"type":"text","text":" (UserDefaults)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Anonymous device identity that must survive reinstall"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"type":"text","text":" (Keychain)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Last-known-good entitlement cache (offline pro gate)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference","isActive":true},{"text":" (Keychain) — backs ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":" is for many-of-a-kind data with change tracking and batched"},{"type":"text","text":" "},{"type":"text","text":"writes. "},{"type":"codeVoice","code":"KeyValueStore"},{"type":"text","text":" is for one-of-a-kind values that you read once at"},{"type":"text","text":" "},{"type":"text","text":"startup and overwrite on change."}]},{"type":"heading","text":"UserDefaults vs Keychain","anchor":"UserDefaults-vs-Keychain","level":3},{"type":"table","header":"row","rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Survives reinstall?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes (this-device-only by default)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Backup \/ device migration"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Included","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Excluded with default accessibility"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Throughput"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fast (in-memory cache)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Slower (system call)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Visible to other apps?"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No (per app\/group)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optionally (App Groups via "},{"type":"codeVoice","code":"accessGroup:"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Best for"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Theme, sort order, feature toggles, last-seen version"}]}],[{"type":"paragraph","inlineContent":[{"text":"Anonymous device ID, opaque tokens, last-known-good entitlement","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The Keychain costs more per access — hydrate once at launch and observe state","type":"text"},{"text":" ","type":"text"},{"text":"afterward, never read inside a reducer.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Prefer the Keychain for anything a user could gain by forging it. A","type":"text"},{"text":" ","type":"text"},{"text":"last-known-good entitlement cache is the clearest case: it grants pro offline,","type":"text"},{"text":" ","type":"text"},{"text":"so a ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" plist (editable directly or via a doctored-backup restore)","type":"text"},{"text":" ","type":"text"},{"text":"lets a spoofed value unlock the app. ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" ","type":"text"},{"text":"persists that cache through an injected ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":", so back it with the","type":"text"},{"text":" ","type":"text"},{"text":"Keychain.","type":"text"}]},{"text":"macOS sandbox & entitlements","type":"heading","level":3,"anchor":"macOS-sandbox--entitlements"},{"inlineContent":[{"type":"codeVoice","code":"KeychainKeyValueStore"},{"text":" uses the data-protection keychain, so it never raises","type":"text"},{"text":" ","type":"text"},{"text":"a user prompt — no “Always Allow \/ Deny” dialog, no locked-keychain prompt, no","type":"text"},{"text":" ","type":"text"},{"text":"Touch ID \/ Face ID challenge.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"text":"sandboxed","type":"text"}]},{"type":"text","text":" macOS app still needs a keychain entitlement, even when"},{"type":"text","text":" "},{"type":"text","text":"not sharing items across an access group. Xcode supplies an"},{"type":"text","text":" "},{"code":"application-identifier","type":"codeVoice"},{"type":"text","text":" automatically for provisioning-profile–signed"},{"type":"text","text":" "},{"type":"text","text":"builds; otherwise add an explicit "},{"code":"keychain-access-groups","type":"codeVoice"},{"type":"text","text":" entry:"}]},{"code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"],"type":"codeListing","syntax":"xml"},{"type":"paragraph","inlineContent":[{"text":"Without it, the first ","type":"text"},{"code":"setValue","type":"codeVoice"},{"text":" fails with ","type":"text"},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"OSStatus"},{"type":"text","text":" −34018). This is a build\/signing condition, not a runtime"},{"type":"text","text":" "},{"type":"text","text":"prompt. iOS \/ iPadOS \/ tvOS \/ watchOS need no extra entitlement."}]}],"type":"aside","name":"Tip","style":"tip"},{"level":3,"anchor":"Unsigned-builds-and-test-hosts","text":"Unsigned builds and test hosts","type":"heading"},{"inlineContent":[{"type":"text","text":"A build made with "},{"type":"codeVoice","code":"CODE_SIGNING_ALLOWED=NO"},{"type":"text","text":" embeds no entitlements at all, so"},{"type":"text","text":" "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" never reaches the binary and every write returns"},{"type":"text","text":" "},{"type":"text","text":"−34018. Test hosts and most CI invocations are built that way, which puts the"},{"type":"text","text":" "},{"type":"text","text":"entitlement advice above out of reach: there is nothing to attach it to."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"KeychainKeyValueStore"},{"text":" treats that as an environment condition rather than a","type":"text"},{"text":" ","type":"text"},{"text":"bug: it logs, returns ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", and carries on. Reach for the returned value","type":"text"},{"text":" ","type":"text"},{"text":"where the app has something to fall back to.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let identity = keychain.deviceIdentity()   \/\/ usable even if nothing persisted"],"type":"codeListing"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)"},{"type":"text","text":" already works this way — a failed write"},{"type":"text","text":" "},{"type":"text","text":"yields a session-local identity instead of a crash. Adopters do not need to"},{"type":"text","text":" "},{"type":"text","text":"detect XCTest and swap in a different store."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Adding a "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entry has a cost worth weighing: it makes the"},{"type":"text","text":" "},{"type":"text","text":"app require a provisioning profile for any signed build, which breaks ad-hoc and"},{"type":"text","text":" "},{"type":"text","text":"local unsigned builds that otherwise run fine. Add it because you want the access"},{"type":"text","text":" "},{"type":"text","text":"group, not to silence −34018."}],"type":"paragraph"},{"inlineContent":[{"text":"Encryption, accessibility, iCloud-sync exclusion, and backup exclusion are","type":"text"},{"text":" ","type":"text"},{"text":"identical whichever entitlement you use — the access group only controls","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"which of your own apps","type":"text"}],"type":"emphasis"},{"text":" can read an item, never third parties or the cloud.","type":"text"},{"text":" ","type":"text"},{"text":"For a private device ID, in order of strictness:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Most private:","type":"text"}]},{"type":"text","text":" profile-signed build + "},{"type":"codeVoice","code":"accessGroup: nil"},{"type":"text","text":", relying on the"},{"type":"text","text":" "},{"type":"text","text":"implicit "},{"type":"codeVoice","code":"application-identifier"},{"type":"text","text":" group. No other app — even same-team —"},{"type":"text","text":" "},{"type":"text","text":"can be entitled to it. Mirrors the iOS default; zero sharing surface."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Practically equivalent:","type":"text"}]},{"type":"text","text":" a "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" array whose only"},{"type":"text","text":" "},{"type":"text","text":"entry is the team-prefixed bundle id (the snippet above). Use when a"},{"type":"text","text":" "},{"type":"text","text":"profile-signed build isn’t available (unsigned local \/ CI dev). Only delta:"},{"type":"text","text":" "},{"type":"text","text":"a same-team app you sign could also declare that string."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Intentional sharing only:","type":"text"}],"type":"strong"},{"text":" a shared group string. The ","type":"text"},{"inlineContent":[{"text":"first","type":"text"}],"type":"emphasis"},{"text":" element","type":"text"},{"text":" ","type":"text"},{"text":"becomes the default group for new items — never put a shared group first","type":"text"},{"text":" ","type":"text"},{"text":"for private data.","type":"text"}]}]}],"type":"orderedList"},{"type":"heading","text":"Device-Identity Pattern","level":2,"anchor":"Device-Identity-Pattern"},{"type":"paragraph","inlineContent":[{"text":"The original motivation for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference"},{"text":" was apps without user","type":"text"},{"text":" ","type":"text"},{"text":"auth that still want stable identity for analytics. Mint a UUID once with the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)","type":"reference"},{"text":" helper, hydrate into ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" at launch,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and feed it to "},{"type":"codeVoice","code":"AnalyticsIdentity"},{"type":"text","text":". The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"deviceID"},{"type":"text","text":" is also the stable"},{"type":"text","text":" "},{"type":"text","text":"feature-flag bucketing identity (the plugin’s "},{"type":"codeVoice","code":"deviceIDKeyPath"},{"type":"text","text":"), so analytics"},{"type":"text","text":" "},{"type":"text","text":"and A\/B exposure share one identity:"}]},{"type":"codeListing","code":["\/\/ `KVKey.deviceID` and `deviceIdentity()` ship with Swidux.","","\/\/ In Store.configured(), before constructing the store:","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.deviceIdentity()   \/\/ reads, or mints-and-persists, a stable UUID","","let initialState = AppState(deviceID: deviceID, \/* … *\/)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then in the analytics plugin wiring:"}]},{"type":"codeListing","code":["AnalyticsPlugin(","    service: analytics,","    identity: AnalyticsIdentity(userID: \\.deviceID, properties: { _ in [:] }),","    \/\/ …",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The closure-based ","type":"text"},{"code":"userID","type":"codeVoice"},{"text":" keypath runs on every dispatch, so the value","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"text":"must","type":"text"}]},{"text":" live in state — never call into the Keychain from the closure. Hydrate","type":"text"},{"text":" ","type":"text"},{"text":"once; observe state.","type":"text"}]},{"type":"heading","level":2,"text":"Type-safe Keys","anchor":"Type-safe-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare each key once on "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference","isActive":true},{"type":"text","text":" so the value type travels with the name —"},{"type":"text","text":" "},{"type":"text","text":"no magic strings at call sites:"}]},{"type":"codeListing","code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Then read and write through static-member literals. The compiler enforces"},{"type":"text","text":" "},{"type":"text","text":"that the value type matches what you declared:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"]},{"inlineContent":[{"text":"A typo or wrong type produces a compile error, not a silent miss at runtime.","type":"text"},{"text":" ","type":"text"},{"text":"Centralizing keys on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference"},{"text":" also gives you autocomplete and a single place","type":"text"},{"text":" ","type":"text"},{"text":"to audit your preference surface.","type":"text"}],"type":"paragraph"},{"text":"Wiring","anchor":"Wiring","type":"heading","level":2},{"text":"1. Add to your environment","anchor":"1-Add-to-your-environment","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"]},{"text":"2. Hydrate at startup","anchor":"2-Hydrate-at-startup","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Read once into the initial state — never read mid-cycle from a reducer."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"]},{"text":"3. Write from an effect","anchor":"3-Write-from-an-effect","type":"heading","level":3},{"inlineContent":[{"text":"Mutate state in the reducer, return an effect that writes the value:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"]},{"inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"try?"},{"type":"text","text":", no "},{"type":"codeVoice","code":"do\/catch"},{"type":"text","text":". "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","isActive":true},{"type":"text","text":" does not throw —"},{"type":"text","text":" "},{"type":"text","text":"encoder errors are programmer mistakes (e.g. "},{"type":"codeVoice","code":"Float.nan"},{"type":"text","text":"), so the store logs"},{"type":"text","text":" "},{"type":"text","text":"them and triggers "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":" in DEBUG instead of forcing every effect"},{"type":"text","text":" "},{"type":"text","text":"to handle an "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" it can’t act on."}],"type":"paragraph"},{"anchor":"Testing","level":2,"type":"heading","text":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","type":"reference","isActive":true},{"type":"text","text":" and assert against the same instance:"}]},{"syntax":"swift","type":"codeListing","code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"]},{"type":"paragraph","inlineContent":[{"text":"Tests touching real ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" should use a fresh per-test suite and tear","type":"text"},{"text":" ","type":"text"},{"text":"it down explicitly:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"]},{"anchor":"Reads-Are-For-Hydration","level":2,"type":"heading","text":"Reads Are For Hydration"},{"style":"important","content":[{"inlineContent":[{"type":"text","text":"Reading from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"type":"text","text":" mid-cycle (inside a reducer) is an"},{"type":"text","text":" "},{"type":"text","text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" construction. After hydration, the value lives in state and"},{"type":"text","text":" "},{"type":"text","text":"downstream code observes state, not the store."}],"type":"paragraph"}],"type":"aside","name":"Important"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" itself is thread-safe, but a reducer reading while an effect"},{"type":"text","text":" "},{"type":"text","text":"writes creates ordering ambiguity. Hydrate, observe state, write through"},{"type":"text","text":" "},{"type":"text","text":"effects — that’s the discipline."}]},{"level":2,"type":"heading","text":"Failure Modes","anchor":"Failure-Modes"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Missing key"}]},{"text":" — ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)","isActive":true,"type":"reference"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". Provide a","type":"text"},{"text":" ","type":"text"},{"text":"default at the call site.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Decode failure","type":"text"}]},{"type":"text","text":" — returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and logs through "},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":" "},{"type":"text","text":"(subsystem "},{"type":"codeVoice","code":"\"swidux\""},{"type":"text","text":", category "},{"type":"codeVoice","code":"\"kvstore\""},{"type":"text","text":"). On startup, behaves identically"},{"type":"text","text":" "},{"type":"text","text":"to first launch."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Encode failure","type":"text"}]},{"text":" — logged at the same subsystem\/category, then","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"assertionFailure"},{"text":" fires in DEBUG so the bug surfaces during development.","type":"text"},{"text":" ","type":"text"},{"text":"Production builds log and continue; the in-memory state is unchanged. The","type":"text"},{"text":" ","type":"text"},{"text":"API does not throw — there is no useful runtime recovery from inside an","type":"text"},{"text":" ","type":"text"},{"text":"effect, and ","type":"text"},{"type":"codeVoice","code":"try?"},{"text":" would just hide the problem.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Keychain unreachable"}],"type":"strong"},{"type":"text","text":" — an unsigned build, a locked device, or a missing"},{"type":"text","text":" "},{"type":"text","text":"entitlement makes "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference"},{"type":"text","text":" writes fail for reasons no caller"},{"type":"text","text":" "},{"type":"text","text":"can fix. These log and return "},{"type":"codeVoice","code":"false"},{"type":"text","text":"; they do "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" trap, because a test"},{"type":"text","text":" "},{"type":"text","text":"host built without code signing would otherwise crash on its first write."},{"type":"text","text":" "},{"type":"text","text":"Malformed queries still assert in DEBUG."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"setValue"},{"type":"text","text":" and "},{"type":"codeVoice","code":"removeValue"},{"type":"text","text":" return "},{"type":"codeVoice","code":"@discardableResult Bool"},{"type":"text","text":" — "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when the"},{"type":"text","text":" "},{"type":"text","text":"store holds the intended state. Ignore it for "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":", 