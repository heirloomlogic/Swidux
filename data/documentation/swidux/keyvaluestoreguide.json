{"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"topicSections":[{"title":"Keys","anchor":"Keys","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KVKey"]},{"title":"Protocol","anchor":"Protocol","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"]},{"title":"Implementations","anchor":"Implementations","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore"]}],"seeAlsoSections":[{"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference","generated":true}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference","isActive":true},{"type":"text","text":" is a small protocol for one-shot scalar values that don’t fit"},{"type":"text","text":" "},{"type":"text","text":"the "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":" model. Three implementations ship:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore"},{"text":" — production, backed by any ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" suite","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true,"type":"reference"},{"type":"text","text":" — production, backed by the system Keychain (survives reinstall)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","isActive":true,"type":"reference"},{"text":" — tests, dictionary-backed, reference semantics","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject through your "},{"type":"codeVoice","code":"Environment"},{"type":"text","text":", hydrate state at startup, and write from"},{"type":"text","text":" "},{"type":"text","text":"effects. Reducers stay pure."}]},{"type":"codeListing","code":["public protocol KeyValueStore: Sendable {","    func value<Value>(_ key: KVKey<Value>) -> Value?","    @discardableResult","    func setValue<Value>(_ value: Value?, for key: KVKey<Value>) -> Bool","    @discardableResult","    func removeValue<Value>(for key: KVKey<Value>) -> Bool","    func contains<Value>(_ key: KVKey<Value>) -> Bool","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All values are JSON-encoded as "},{"type":"codeVoice","code":"Data"},{"type":"text","text":". Reads and writes go through "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which pairs a backing-store name with its "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" value type at compile time."}]},{"level":2,"type":"heading","anchor":"When-to-Use-What","text":"When to Use What"},{"type":"table","rows":[[[{"inlineContent":[{"text":"Need","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Collection of identifiable entities (decks, cards, sessions)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" + ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Scalar preference (theme, sort order, last-seen version)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"text":" (UserDefaults)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Anonymous device identity that must survive reinstall","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"text":" (Keychain)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Last-known-good entitlement cache (offline pro gate)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"text":" (Keychain) — backs ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":" is for many-of-a-kind data with change tracking and batched"},{"type":"text","text":" "},{"type":"text","text":"writes. "},{"type":"codeVoice","code":"KeyValueStore"},{"type":"text","text":" is for one-of-a-kind values that you read once at"},{"type":"text","text":" "},{"type":"text","text":"startup and overwrite on change."}]},{"level":3,"type":"heading","anchor":"UserDefaults-vs-Keychain","text":"UserDefaults vs Keychain"},{"type":"table","rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Survives reinstall?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes (this-device-only by default)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Backup \/ device migration","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Included","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Excluded with default accessibility","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Throughput","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Fast (in-memory cache)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Slower (system call)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Visible to other apps?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No (per app\/group)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Optionally (App Groups via ","type":"text"},{"code":"accessGroup:","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Best for","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Theme, sort order, feature toggles, last-seen version","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Anonymous device ID, opaque tokens, last-known-good entitlement","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Keychain costs more per access — hydrate once at launch and observe state"},{"type":"text","text":" "},{"type":"text","text":"afterward, never read inside a reducer."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefer the Keychain for anything a user could gain by forging it. A"},{"type":"text","text":" "},{"type":"text","text":"last-known-good entitlement cache is the clearest case: it grants pro offline,"},{"type":"text","text":" "},{"type":"text","text":"so a "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" plist (editable directly or via a doctored-backup restore)"},{"type":"text","text":" "},{"type":"text","text":"lets a spoofed value unlock the app. "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" "},{"type":"text","text":"persists that cache through an injected "},{"type":"codeVoice","code":"KeyValueStore"},{"type":"text","text":", so back it with the"},{"type":"text","text":" "},{"type":"text","text":"Keychain."}]},{"level":3,"type":"heading","anchor":"macOS-sandbox--entitlements","text":"macOS sandbox & entitlements"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" uses the data-protection keychain, so it never raises"},{"type":"text","text":" "},{"type":"text","text":"a user prompt — no “Always Allow \/ Deny” dialog, no locked-keychain prompt, no"},{"type":"text","text":" "},{"type":"text","text":"Touch ID \/ Face ID challenge."}]},{"name":"Tip","type":"aside","content":[{"inlineContent":[{"text":"A ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"sandboxed","type":"text"}]},{"text":" macOS app still needs a keychain entitlement, even when","type":"text"},{"text":" ","type":"text"},{"text":"not sharing items across an access group. Xcode supplies an","type":"text"},{"text":" ","type":"text"},{"code":"application-identifier","type":"codeVoice"},{"text":" automatically for provisioning-profile–signed","type":"text"},{"text":" ","type":"text"},{"text":"builds; otherwise add an explicit ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" entry:","type":"text"}],"type":"paragraph"},{"syntax":"xml","type":"codeListing","code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"]},{"inlineContent":[{"text":"Without it, the first ","type":"text"},{"code":"setValue","type":"codeVoice"},{"text":" fails with ","type":"text"},{"code":"errSecMissingEntitlement","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"OSStatus","type":"codeVoice"},{"text":" −34018). This is a build\/signing condition, not a runtime","type":"text"},{"text":" ","type":"text"},{"text":"prompt. iOS \/ iPadOS \/ tvOS \/ watchOS need no extra entitlement.","type":"text"}],"type":"paragraph"}],"style":"tip"},{"level":3,"type":"heading","anchor":"Unsigned-builds-and-test-hosts","text":"Unsigned builds and test hosts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A build made with "},{"type":"codeVoice","code":"CODE_SIGNING_ALLOWED=NO"},{"type":"text","text":" embeds no entitlements at all, so"},{"type":"text","text":" "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" never reaches the binary and every write returns"},{"type":"text","text":" "},{"type":"text","text":"−34018. Test hosts and most CI invocations are built that way, which puts the"},{"type":"text","text":" "},{"type":"text","text":"entitlement advice above out of reach: there is nothing to attach it to."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" treats that as an environment condition rather than a"},{"type":"text","text":" "},{"type":"text","text":"bug: it logs, returns "},{"type":"codeVoice","code":"false"},{"type":"text","text":", and carries on. Reach for the returned value"},{"type":"text","text":" "},{"type":"text","text":"where the app has something to fall back to."}]},{"type":"codeListing","code":["let identity = keychain.deviceIdentity()   \/\/ usable even if nothing persisted"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)","type":"reference","isActive":true},{"type":"text","text":" already works this way — a failed write"},{"type":"text","text":" "},{"type":"text","text":"yields a session-local identity instead of a crash. Adopters do not need to"},{"type":"text","text":" "},{"type":"text","text":"detect XCTest and swap in a different store."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Adding a "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entry has a cost worth weighing: it makes the"},{"type":"text","text":" "},{"type":"text","text":"app require a provisioning profile for any signed build, which breaks ad-hoc and"},{"type":"text","text":" "},{"type":"text","text":"local unsigned builds that otherwise run fine. Add it because you want the access"},{"type":"text","text":" "},{"type":"text","text":"group, not to silence −34018."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Encryption, accessibility, iCloud-sync exclusion, and backup exclusion are"},{"type":"text","text":" "},{"type":"text","text":"identical whichever entitlement you use — the access group only controls"},{"type":"text","text":" "},{"inlineContent":[{"text":"which of your own apps","type":"text"}],"type":"emphasis"},{"type":"text","text":" can read an item, never third parties or the cloud."},{"type":"text","text":" "},{"type":"text","text":"For a private device ID, in order of strictness:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Most private:"}],"type":"strong"},{"text":" profile-signed build + ","type":"text"},{"code":"accessGroup: nil","type":"codeVoice"},{"text":", relying on the","type":"text"},{"text":" ","type":"text"},{"text":"implicit ","type":"text"},{"code":"application-identifier","type":"codeVoice"},{"text":" group. No other app — even same-team —","type":"text"},{"text":" ","type":"text"},{"text":"can be entitled to it. Mirrors the iOS default; zero sharing surface.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Practically equivalent:"}],"type":"strong"},{"text":" a ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" array whose only","type":"text"},{"text":" ","type":"text"},{"text":"entry is the team-prefixed bundle id (the snippet above). Use when a","type":"text"},{"text":" ","type":"text"},{"text":"profile-signed build isn’t available (unsigned local \/ CI dev). Only delta:","type":"text"},{"text":" ","type":"text"},{"text":"a same-team app you sign could also declare that string.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Intentional sharing only:"}],"type":"strong"},{"text":" a shared group string. The ","type":"text"},{"inlineContent":[{"type":"text","text":"first"}],"type":"emphasis"},{"text":" element","type":"text"},{"text":" ","type":"text"},{"text":"becomes the default group for new items — never put a shared group first","type":"text"},{"text":" ","type":"text"},{"text":"for private data.","type":"text"}]}]}]},{"level":2,"type":"heading","anchor":"Device-Identity-Pattern","text":"Device-Identity Pattern"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The original motivation for "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference","isActive":true},{"type":"text","text":" was apps without user"},{"type":"text","text":" "},{"type":"text","text":"auth that still want stable identity for analytics. Mint a UUID once with the"},{"type":"text","text":" "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)","type":"reference","isActive":true},{"type":"text","text":" helper, hydrate into "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" at launch,"},{"type":"text","text":" "},{"type":"text","text":"and feed it to "},{"type":"codeVoice","code":"AnalyticsIdentity"},{"type":"text","text":". The "},{"inlineContent":[{"text":"same","type":"text"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"codeVoice","code":"deviceID"},{"type":"text","text":" is also the stable"},{"type":"text","text":" "},{"type":"text","text":"feature-flag bucketing identity (the plugin’s "},{"type":"codeVoice","code":"deviceIDKeyPath"},{"type":"text","text":"), so analytics"},{"type":"text","text":" "},{"type":"text","text":"and A\/B exposure share one identity:"}]},{"type":"codeListing","code":["\/\/ `KVKey.deviceID` and `deviceIdentity()` ship with Swidux.","","\/\/ In Store.configured(), before constructing the store:","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.deviceIdentity()   \/\/ reads, or mints-and-persists, a stable UUID","","let initialState = AppState(deviceID: deviceID, \/* … *\/)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then in the analytics plugin wiring:"}]},{"type":"codeListing","code":["AnalyticsPlugin(","    service: analytics,","    identity: AnalyticsIdentity(userID: \\.deviceID, properties: { _ in [:] }),","    \/\/ …",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The closure-based "},{"type":"codeVoice","code":"userID"},{"type":"text","text":" keypath runs on every dispatch, so the value"},{"type":"text","text":" "},{"inlineContent":[{"text":"must","type":"text"}],"type":"strong"},{"type":"text","text":" live in state — never call into the Keychain from the closure. Hydrate"},{"type":"text","text":" "},{"type":"text","text":"once; observe state."}]},{"level":2,"type":"heading","anchor":"Type-safe-Keys","text":"Type-safe Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare each key once on "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference","isActive":true},{"type":"text","text":" so the value type travels with the name —"},{"type":"text","text":" "},{"type":"text","text":"no magic strings at call sites:"}]},{"type":"codeListing","code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then read and write through static-member literals. The compiler enforces"},{"type":"text","text":" "},{"type":"text","text":"that the value type matches what you declared:"}]},{"type":"codeListing","code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typo or wrong type produces a compile error, not a silent miss at runtime."},{"type":"text","text":" "},{"type":"text","text":"Centralizing keys on "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference","isActive":true},{"type":"text","text":" also gives you autocomplete and a single place"},{"type":"text","text":" "},{"type":"text","text":"to audit your preference surface."}]},{"level":2,"type":"heading","anchor":"Wiring","text":"Wiring"},{"level":3,"type":"heading","anchor":"1-Add-to-your-environment","text":"1. Add to your environment"},{"type":"codeListing","code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"2-Hydrate-at-startup","text":"2. Hydrate at startup"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read once into the initial state — never read mid-cycle from a reducer."}]},{"type":"codeListing","code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"3-Write-from-an-effect","text":"3. Write from an effect"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mutate state in the reducer, return an effect that writes the value:"}]},{"type":"codeListing","code":["case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"try?"},{"type":"text","text":", no "},{"type":"codeVoice","code":"do\/catch"},{"type":"text","text":". "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","type":"reference","isActive":true},{"type":"text","text":" does not throw —"},{"type":"text","text":" "},{"type":"text","text":"encoder errors are programmer mistakes (e.g. "},{"type":"codeVoice","code":"Float.nan"},{"type":"text","text":"), so the store logs"},{"type":"text","text":" "},{"type":"text","text":"them and triggers "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":" in DEBUG instead of forcing every effect"},{"type":"text","text":" "},{"type":"text","text":"to handle an "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" it can’t act on."}]},{"level":2,"type":"heading","anchor":"Testing","text":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","type":"reference","isActive":true},{"type":"text","text":" and assert against the same instance:"}]},{"type":"codeListing","code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tests touching real "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" should use a fresh per-test suite and tear"},{"type":"text","text":" "},{"type":"text","text":"it down explicitly:"}]},{"type":"codeListing","code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Reads-Are-For-Hydration","text":"Reads Are For Hydration"},{"name":"Important","type":"aside","content":[{"inlineContent":[{"text":"Reading from ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"},{"text":" mid-cycle (inside a reducer) is an","type":"text"},{"type":"text","text":" "},{"text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppState"},{"text":" construction. After hydration, the value lives in state and","type":"text"},{"type":"text","text":" "},{"text":"downstream code observes state, not the store.","type":"text"}],"type":"paragraph"}],"style":"important"},{"inlineContent":[{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" itself is thread-safe, but a reducer reading while an effect"},{"type":"text","text":" "},{"type":"text","text":"writes creates ordering ambiguity. Hydrate, observe state, write through"},{"type":"text","text":" "},{"type":"text","text":"effects — that’s the discipline."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Failure Modes","anchor":"Failure-Modes"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Missing key","type":"text"}],"type":"strong"},{"type":"text","text":" — "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)","type":"reference","isActive":true},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". Provide a"},{"type":"text","text":" "},{"type":"text","text":"default at the call site."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Decode failure"}],"type":"strong"},{"type":"text","text":" — returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and logs through "},{"code":"os.Logger","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(subsystem ","type":"text"},{"type":"codeVoice","code":"\"swidux\""},{"type":"text","text":", category "},{"code":"\"kvstore\"","type":"codeVoice"},{"type":"text","text":"). On startup, behaves identically"},{"text":" ","type":"text"},{"text":"to first launch.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Encode failure"}]},{"text":" — logged at the same subsystem\/category, then","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":" fires in DEBUG so the bug surfaces during development."},{"type":"text","text":" "},{"text":"Production builds log and continue; the in-memory state is unchanged. The","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"API does not throw — there is no useful runtime recovery from inside an"},{"type":"text","text":" "},{"text":"effect, and ","type":"text"},{"code":"try?","type":"codeVoice"},{"type":"text","text":" would just hide the problem."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Keychain unreachable","type":"text"}]},{"text":" — an unsigned build, a locked device, or a missing","type":"text"},{"text":" ","type":"text"},{"text":"entitlement makes ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"},{"text":" writes fail for reasons no caller","type":"text"},{"text":" ","type":"text"},{"text":"can fix. These log and return ","type":"text"},{"code":"false","type":"codeVoice"},{"text":"; they do ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" trap, because a test"},{"type":"text","text":" "},{"type":"text","text":"host built without code signing would otherwise crash on 