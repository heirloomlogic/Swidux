{"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"API Collection","role":"collectionGroup","title":"KeyValueStore"},"schemaVersion":{"patch":0,"major":0,"minor":3},"topicSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KVKey"],"title":"Keys","anchor":"Keys"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"],"title":"Protocol","anchor":"Protocol"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore"],"title":"Implementations","anchor":"Implementations"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true,"title":"Reference","anchor":"Reference"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"type":"text","text":" is a small protocol for one-shot scalar values that don’t fit"},{"type":"text","text":" "},{"type":"text","text":"the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" model. Three implementations ship:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore"},{"type":"text","text":" — production, backed by any "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" suite"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"},{"type":"text","text":" — production, backed by the system Keychain (survives reinstall)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore"},{"type":"text","text":" — tests, dictionary-backed, reference semantics"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject through your "},{"code":"Environment","type":"codeVoice"},{"type":"text","text":", hydrate state at startup, and write from"},{"type":"text","text":" "},{"type":"text","text":"effects. Reducers stay pure."}]},{"type":"codeListing","syntax":"swift","code":["public protocol KeyValueStore: Sendable {","    func value<Value>(_ key: KVKey<Value>) -> Value?","    func setValue<Value>(_ value: Value?, for key: KVKey<Value>)","    func removeValue<Value>(for key: KVKey<Value>)","    func contains<Value>(_ key: KVKey<Value>) -> Bool","}"]},{"type":"paragraph","inlineContent":[{"text":"All values are JSON-encoded as ","type":"text"},{"type":"codeVoice","code":"Data"},{"type":"text","text":". Reads and writes go through "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which pairs a backing-store name with its "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" value type at compile time."}]},{"type":"heading","text":"When to Use What","anchor":"When-to-Use-What","level":2},{"rows":[[[{"inlineContent":[{"type":"text","text":"Need"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Collection of identifiable entities (decks, cards, sessions)","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":" + ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Scalar preference (theme, sort order, last-seen version)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference"},{"type":"text","text":" (UserDefaults)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Anonymous device identity that must survive reinstall"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference"},{"text":" (Keychain)","type":"text"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"code":"EntityStore","type":"codeVoice"},{"type":"text","text":" is for many-of-a-kind data with change tracking and batched"},{"type":"text","text":" "},{"type":"text","text":"writes. "},{"type":"codeVoice","code":"KeyValueStore"},{"type":"text","text":" is for one-of-a-kind values that you read once at"},{"type":"text","text":" "},{"type":"text","text":"startup and overwrite on change."}],"type":"paragraph"},{"anchor":"UserDefaults-vs-Keychain","level":3,"type":"heading","text":"UserDefaults vs Keychain"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Survives reinstall?"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes (this-device-only by default)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backup \/ device migration"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Included"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Excluded with default accessibility"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Throughput"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fast (in-memory cache)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Slower (system call)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Visible to other apps?"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No (per app\/group)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optionally (App Groups via "},{"type":"codeVoice","code":"accessGroup:"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Best for"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Theme, sort order, feature toggles, last-seen version"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Anonymous device ID, opaque tokens"}]}]]]},{"inlineContent":[{"type":"text","text":"The Keychain costs more per access — hydrate once at launch and observe state"},{"type":"text","text":" "},{"type":"text","text":"afterward, never read inside a reducer."}],"type":"paragraph"},{"text":"macOS sandbox & entitlements","type":"heading","level":3,"anchor":"macOS-sandbox--entitlements"},{"inlineContent":[{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" uses the data-protection keychain, so it never raises"},{"type":"text","text":" "},{"type":"text","text":"a user prompt — no “Always Allow \/ Deny” dialog, no locked-keychain prompt, no"},{"type":"text","text":" "},{"type":"text","text":"Touch ID \/ Face ID challenge."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"sandboxed"}]},{"type":"text","text":" macOS app still needs a keychain entitlement, even when"},{"type":"text","text":" "},{"type":"text","text":"not sharing items across an access group. Xcode supplies an"},{"type":"text","text":" "},{"type":"codeVoice","code":"application-identifier"},{"type":"text","text":" automatically for provisioning-profile–signed"},{"type":"text","text":" "},{"type":"text","text":"builds; otherwise add an explicit "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entry:"}]},{"type":"codeListing","syntax":"xml","code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without it, the first "},{"type":"codeVoice","code":"setValue"},{"type":"text","text":" fails with "},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"OSStatus"},{"type":"text","text":" −34018). This is a build\/signing condition, not a runtime"},{"type":"text","text":" "},{"type":"text","text":"prompt. iOS \/ iPadOS \/ tvOS \/ watchOS need no extra entitlement."}]}],"style":"tip","type":"aside","name":"Tip"},{"inlineContent":[{"type":"text","text":"Encryption, accessibility, iCloud-sync exclusion, and backup exclusion are"},{"type":"text","text":" "},{"type":"text","text":"identical whichever entitlement you use — the access group only controls"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"which of your own apps"}]},{"type":"text","text":" can read an item, never third parties or the cloud."},{"type":"text","text":" "},{"type":"text","text":"For a private device ID, in order of strictness:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Most private:"}]},{"type":"text","text":" profile-signed build + "},{"type":"codeVoice","code":"accessGroup: nil"},{"type":"text","text":", relying on the"},{"type":"text","text":" "},{"type":"text","text":"implicit "},{"type":"codeVoice","code":"application-identifier"},{"type":"text","text":" group. No other app — even same-team —"},{"type":"text","text":" "},{"type":"text","text":"can be entitled to it. Mirrors the iOS default; zero sharing surface."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Practically equivalent:"}]},{"type":"text","text":" a "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" array whose only"},{"type":"text","text":" "},{"type":"text","text":"entry is the team-prefixed bundle id (the snippet above). Use when a"},{"type":"text","text":" "},{"type":"text","text":"profile-signed build isn’t available (unsigned local \/ CI dev). Only delta:"},{"type":"text","text":" "},{"type":"text","text":"a same-team app you sign could also declare that string."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Intentional sharing only:"}]},{"type":"text","text":" a shared group string. The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"first"}]},{"type":"text","text":" element"},{"type":"text","text":" "},{"type":"text","text":"becomes the default group for new items — never put a shared group first"},{"type":"text","text":" "},{"type":"text","text":"for private data."}]}]}],"type":"orderedList"},{"text":"Device-Identity Pattern","type":"heading","level":2,"anchor":"Device-Identity-Pattern"},{"inlineContent":[{"type":"text","text":"The original motivation for "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference"},{"type":"text","text":" was apps without user"},{"type":"text","text":" "},{"type":"text","text":"auth that still want stable identity for analytics. Mint a UUID once with the"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)","type":"reference"},{"type":"text","text":" helper, hydrate into "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" at launch,"},{"type":"text","text":" "},{"type":"text","text":"and feed it to "},{"type":"codeVoice","code":"AnalyticsIdentity"},{"type":"text","text":". The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"deviceID"},{"type":"text","text":" is also the stable"},{"type":"text","text":" "},{"type":"text","text":"feature-flag bucketing identity (the plugin’s "},{"type":"codeVoice","code":"deviceIDKeyPath"},{"type":"text","text":"), so analytics"},{"type":"text","text":" "},{"type":"text","text":"and A\/B exposure share one identity:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ `KVKey.deviceID` and `deviceIdentity()` ship with Swidux.","","\/\/ In Store.configured(), before constructing the store:","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.deviceIdentity()   \/\/ reads, or mints-and-persists, a stable UUID","","let initialState = AppState(deviceID: deviceID, \/* … *\/)"]},{"inlineContent":[{"type":"text","text":"Then in the analytics plugin wiring:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["AnalyticsPlugin(","    service: analytics,","    identity: AnalyticsIdentity(userID: \\.deviceID, properties: { _ in [:] }),","    \/\/ …",")"]},{"inlineContent":[{"type":"text","text":"The closure-based "},{"type":"codeVoice","code":"userID"},{"type":"text","text":" keypath runs on every dispatch, so the value"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"must"}]},{"type":"text","text":" live in state — never call into the Keychain from the closure. Hydrate"},{"type":"text","text":" "},{"type":"text","text":"once; observe state."}],"type":"paragraph"},{"text":"Type-safe Keys","type":"heading","level":2,"anchor":"Type-safe-Keys"},{"inlineContent":[{"type":"text","text":"Declare each key once on "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference"},{"type":"text","text":" so the value type travels with the name —"},{"type":"text","text":" "},{"type":"text","text":"no magic strings at call sites:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"]},{"inlineContent":[{"type":"text","text":"Then read and write through static-member literals. The compiler enforces"},{"type":"text","text":" "},{"type":"text","text":"that the value type matches what you declared:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"]},{"inlineContent":[{"type":"text","text":"A typo or wrong type produces a compile error, not a silent miss at runtime."},{"type":"text","text":" "},{"type":"text","text":"Centralizing keys on "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference"},{"type":"text","text":" also gives you autocomplete and a single place"},{"type":"text","text":" "},{"type":"text","text":"to audit your preference surface."}],"type":"paragraph"},{"text":"Wiring","type":"heading","level":2,"anchor":"Wiring"},{"text":"1. Add to your environment","type":"heading","level":3,"anchor":"1-Add-to-your-environment"},{"syntax":"swift","type":"codeListing","code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"]},{"text":"2. Hydrate at startup","type":"heading","level":3,"anchor":"2-Hydrate-at-startup"},{"inlineContent":[{"type":"text","text":"Read once into the initial state — never read mid-cycle from a reducer."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"]},{"text":"3. Write from an effect","type":"heading","level":3,"anchor":"3-Write-from-an-effect"},{"inlineContent":[{"type":"text","text":"Mutate state in the reducer, return an effect that writes the value:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"]},{"inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"try?"},{"type":"text","text":", no "},{"type":"codeVoice","code":"do\/catch"},{"type":"text","text":". "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","type":"reference"},{"type":"text","text":" does not throw —"},{"type":"text","text":" "},{"type":"text","text":"encoder errors are programmer mistakes (e.g. "},{"type":"codeVoice","code":"Float.nan"},{"type":"text","text":"), so the store logs"},{"type":"text","text":" "},{"type":"text","text":"them and triggers "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":" in DEBUG instead of forcing every effect"},{"type":"text","text":" "},{"type":"text","text":"to handle an "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" it can’t act on."}],"type":"paragraph"},{"text":"Testing","type":"heading","level":2,"anchor":"Testing"},{"inlineContent":[{"type":"text","text":"Inject "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","type":"reference"},{"type":"text","text":" and assert against the same instance:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"]},{"inlineContent":[{"type":"text","text":"Tests touching real "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" should use a fresh per-test suite and tear"},{"type":"text","text":" "},{"type":"text","text":"it down explicitly:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"]},{"text":"Reads Are For Hydration","type":"heading","level":2,"anchor":"Reads-Are-For-Hydration"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reading from "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true},{"type":"text","text":" mid-cycle (inside a reducer) is an"},{"type":"text","text":" "},{"type":"text","text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" construction. After hydration, the value lives in state and"},{"type":"text","text":" "},{"type":"text","text":"downstream code observes state, not the store."}]}],"style":"important","type":"aside","name":"Important"},{"inlineContent":[{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" itself is thread-safe, but a reducer reading while an effect"},{"type":"text","text":" "},{"type":"text","text":"writes creates ordering ambiguity. Hydrate, observe state, write through"},{"type":"text","text":" "},{"type":"text","text":"effects — that’s the discipline."}],"type":"paragraph"},{"text":"Failure Modes","type":"heading","level":2,"anchor":"Failure-Modes"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Missing key"}]},{"type":"text","text":" — "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". Provide a"},{"type":"text","text":" "},{"type":"text","text":"default at the call site."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Decode failure"}]},{"type":"text","text":" — returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and logs through "},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":" "},{"type":"text","text":"(subsystem "},{"type":"codeVoice","code":"\"swidux\""},{"type":"text","text":", category "},{"type":"codeVoice","code":"\"kvstore\""},{"type":"text","text":"). On startup, behaves identically"},{"type":"text","text":" "},{"type":"text","text":"to first launch."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Encode failure"}]},{"type":"text","text":" — logged at the same subsystem\/category, then"},{"type":"text","text":" "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":" fires in DEBUG so the bug surfaces during development."},{"type":"text","text":" "},{"type":"text","text":"Production builds log and continue; the in-memory state is unchanged. The"},{"type":"text","text":" "},{"type":"text","text":"API does not throw — there is no useful runtime recovery from inside an"},{"type":"text","text":" "},{"type":"text","text":"effect, and "},{"type":"codeVoice","code":"try?"},{"type":"text","text":" would just hide the problem."}]}]}],"type":"unorderedList"},{"text":"@AppStorage Interop","type":"heading","level":2,"anchor":"AppStorage-Interop"},{"inlineContent":[{"type":"text","text":"There is none, by design. "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference"},{"type":"text","text":" writes JSON-encoded"},{"type":"text","text":" "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" blobs. SwiftUI’s "},{"type":"codeVoice","code":"@AppStorage"},{"type":"text","text":" only observes native primitive types"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Bool"},{"type":"text","text":", "},{"type":"codeVoice","code":"Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"String"},{"type":"text","text":", "},{"type":"codeVoice","code":"Double"},{"type":"text","text":", "},{"type":"codeVoice","code":"URL"},{"type":"text","text":", raw "},{"type":"codeVoice","code":"Data"},{"type":"text","text":"). Two parallel"},{"type":"text","text":" "},{"type":"text","text":"observation channels — Swidux state and "},{"type":"codeVoice","code":"@AppStorage"},{"type":"text","text":" — would drift."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Swidux state is the source of truth. Read once at hydration, then observe"},{"type":"text","text":" "},{"type":"text","text":"state through the store."}],"type":"paragraph"},{"text":"Schema Migration","type":"heading","level":2,"anchor":"Schema-Migration"},{"inlineContent":[{"type":"text","text":"Out of scope for "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference"},{"type":"text","text":". If a "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" shape changes"},{"type":"text","text":" "},{"type":"text","text":"incompatibly, declare a new versioned key:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ before:","extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","\/\/ after a breaking shape change:","extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme.v2\")","}"]},{"inlineContent":[{"type":"text","text":"Old keys can be cleaned up at startup with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/removeValue(for:)"},{"type":"text","text":" "},{"type":"text","text":"(declare a tombstone "},{