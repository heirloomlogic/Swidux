{"seeAlsoSections":[{"anchor":"Reference","generated":true,"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"]}],"sections":[],"metadata":{"modules":[{"name":"Swidux"}],"role":"collectionGroup","title":"KeyValueStore","roleHeading":"API Collection"},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"},{"type":"text","text":" is a small protocol for one-shot scalar values that don’t fit"},{"type":"text","text":" "},{"type":"text","text":"the "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"type":"text","text":" model. Three implementations ship:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore"},{"text":" — production, backed by any ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"text":" suite","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"},{"text":" — production, backed by the system Keychain (survives reinstall)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore"},{"text":" — tests, dictionary-backed, reference semantics","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Inject through your "},{"code":"Environment","type":"codeVoice"},{"type":"text","text":", hydrate state at startup, and write from"},{"type":"text","text":" "},{"type":"text","text":"effects. Reducers stay pure."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public protocol KeyValueStore: Sendable {","    func value<Value>(_ key: KVKey<Value>) -> Value?","    @discardableResult","    func setValue<Value>(_ value: Value?, for key: KVKey<Value>) -> Bool","    @discardableResult","    func removeValue<Value>(for key: KVKey<Value>) -> Bool","    func contains<Value>(_ key: KVKey<Value>) -> Bool","}"]},{"inlineContent":[{"type":"text","text":"All values are JSON-encoded as "},{"code":"Data","type":"codeVoice"},{"type":"text","text":". Reads and writes go through "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which pairs a backing-store name with its "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" value type at compile time."}],"type":"paragraph"},{"type":"heading","anchor":"When-to-Use-What","text":"When to Use What","level":2},{"type":"table","rows":[[[{"inlineContent":[{"text":"Need","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Collection of identifiable entities (decks, cards, sessions)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"text":" + ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Scalar preference (theme, sort order, last-seen version)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference","isActive":true},{"text":" (UserDefaults)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Anonymous device identity that must survive reinstall","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference","isActive":true},{"text":" (Keychain)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Last-known-good entitlement cache (offline pro gate)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference","isActive":true},{"text":" (Keychain) — backs ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"}],"type":"paragraph"}]]],"header":"row"},{"inlineContent":[{"code":"EntityStore","type":"codeVoice"},{"type":"text","text":" is for many-of-a-kind data with change tracking and batched"},{"type":"text","text":" "},{"type":"text","text":"writes. "},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":" is for one-of-a-kind values that you read once at"},{"type":"text","text":" "},{"type":"text","text":"startup and overwrite on change."}],"type":"paragraph"},{"type":"heading","anchor":"UserDefaults-vs-Keychain","text":"UserDefaults vs Keychain","level":3},{"type":"table","rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference","isActive":true}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Survives reinstall?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes (this-device-only by default)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Backup \/ device migration","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Included","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Excluded with default accessibility","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Throughput","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Fast (in-memory cache)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Slower (system call)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Visible to other apps?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No (per app\/group)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Optionally (App Groups via ","type":"text"},{"code":"accessGroup:","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Best for","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Theme, sort order, feature toggles, last-seen version","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Anonymous device ID, opaque tokens, last-known-good entitlement","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"inlineContent":[{"type":"text","text":"The Keychain costs more per access — hydrate once at launch and observe state"},{"type":"text","text":" "},{"type":"text","text":"afterward, never read inside a reducer."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Prefer the Keychain for anything a user could gain by forging it. A"},{"type":"text","text":" "},{"type":"text","text":"last-known-good entitlement cache is the clearest case: it grants pro offline,"},{"type":"text","text":" "},{"type":"text","text":"so a "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":" plist (editable directly or via a doctored-backup restore)"},{"type":"text","text":" "},{"type":"text","text":"lets a spoofed value unlock the app. "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"persists that cache through an injected "},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":", so back it with the"},{"type":"text","text":" "},{"type":"text","text":"Keychain."}],"type":"paragraph"},{"type":"heading","anchor":"macOS-sandbox--entitlements","text":"macOS sandbox & entitlements","level":3},{"inlineContent":[{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" uses the data-protection keychain, so it never raises"},{"type":"text","text":" "},{"type":"text","text":"a user prompt — no “Always Allow \/ Deny” dialog, no locked-keychain prompt, no"},{"type":"text","text":" "},{"type":"text","text":"Touch ID \/ Face ID challenge."}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"text":"sandboxed","type":"text"}],"type":"emphasis"},{"text":" macOS app still needs a keychain entitlement, even when","type":"text"},{"text":" ","type":"text"},{"text":"not sharing items across an access group. Xcode supplies an","type":"text"},{"text":" ","type":"text"},{"code":"application-identifier","type":"codeVoice"},{"text":" automatically for provisioning-profile–signed","type":"text"},{"text":" ","type":"text"},{"text":"builds; otherwise add an explicit ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" entry:","type":"text"}],"type":"paragraph"},{"code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"],"syntax":"xml","type":"codeListing"},{"inlineContent":[{"text":"Without it, the first ","type":"text"},{"code":"setValue","type":"codeVoice"},{"text":" fails with ","type":"text"},{"code":"errSecMissingEntitlement","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"OSStatus","type":"codeVoice"},{"text":" −34018). This is a build\/signing condition, not a runtime","type":"text"},{"text":" ","type":"text"},{"text":"prompt. iOS \/ iPadOS \/ tvOS \/ watchOS need no extra entitlement.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"tip","name":"Tip"},{"type":"heading","anchor":"Unsigned-builds-and-test-hosts","text":"Unsigned builds and test hosts","level":3},{"inlineContent":[{"type":"text","text":"A build made with "},{"code":"CODE_SIGNING_ALLOWED=NO","type":"codeVoice"},{"type":"text","text":" embeds no entitlements at all, so"},{"type":"text","text":" "},{"code":"keychain-access-groups","type":"codeVoice"},{"type":"text","text":" never reaches the binary and every write returns"},{"type":"text","text":" "},{"type":"text","text":"−34018. Test hosts and most CI invocations are built that way, which puts the"},{"type":"text","text":" "},{"type":"text","text":"entitlement advice above out of reach: there is nothing to attach it to."}],"type":"paragraph"},{"inlineContent":[{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" treats that as an environment condition rather than a"},{"type":"text","text":" "},{"type":"text","text":"bug: it logs, returns "},{"code":"false","type":"codeVoice"},{"type":"text","text":", and carries on. Reach for the returned value"},{"type":"text","text":" "},{"type":"text","text":"where the app has something to fall back to."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let identity = keychain.deviceIdentity()   \/\/ usable even if nothing persisted"]},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)","isActive":true,"type":"reference"},{"type":"text","text":" already works this way — a failed write"},{"type":"text","text":" "},{"type":"text","text":"yields a session-local identity instead of a crash. Adopters do not need to"},{"type":"text","text":" "},{"type":"text","text":"detect XCTest and swap in a different store."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Adding a "},{"code":"keychain-access-groups","type":"codeVoice"},{"type":"text","text":" entry has a cost worth weighing: it makes the"},{"type":"text","text":" "},{"type":"text","text":"app require a provisioning profile for any signed build, which breaks ad-hoc and"},{"type":"text","text":" "},{"type":"text","text":"local unsigned builds that otherwise run fine. Add it because you want the access"},{"type":"text","text":" "},{"type":"text","text":"group, not to silence −34018."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Encryption, accessibility, iCloud-sync exclusion, and backup exclusion are"},{"type":"text","text":" "},{"type":"text","text":"identical whichever entitlement you use — the access group only controls"},{"type":"text","text":" "},{"inlineContent":[{"text":"which of your own apps","type":"text"}],"type":"emphasis"},{"type":"text","text":" can read an item, never third parties or the cloud."},{"type":"text","text":" "},{"type":"text","text":"For a private device ID, in order of strictness:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Most private:","type":"text"}],"type":"strong"},{"text":" profile-signed build + ","type":"text"},{"type":"codeVoice","code":"accessGroup: nil"},{"text":", relying on the","type":"text"},{"text":" ","type":"text"},{"text":"implicit ","type":"text"},{"type":"codeVoice","code":"application-identifier"},{"text":" group. No other app — even same-team —","type":"text"},{"text":" ","type":"text"},{"text":"can be entitled to it. Mirrors the iOS default; zero sharing surface.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Practically equivalent:","type":"text"}],"type":"strong"},{"text":" a ","type":"text"},{"type":"codeVoice","code":"keychain-access-groups"},{"text":" array whose only","type":"text"},{"text":" ","type":"text"},{"text":"entry is the team-prefixed bundle id (the snippet above). Use when a","type":"text"},{"text":" ","type":"text"},{"text":"profile-signed build isn’t available (unsigned local \/ CI dev). Only delta:","type":"text"},{"text":" ","type":"text"},{"text":"a same-team app you sign could also declare that string.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Intentional sharing only:","type":"text"}],"type":"strong"},{"text":" a shared group string. The ","type":"text"},{"inlineContent":[{"text":"first","type":"text"}],"type":"emphasis"},{"text":" element","type":"text"},{"text":" ","type":"text"},{"text":"becomes the default group for new items — never put a shared group first","type":"text"},{"text":" ","type":"text"},{"text":"for private data.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Device-Identity-Pattern","text":"Device-Identity Pattern","level":2},{"inlineContent":[{"type":"text","text":"The original motivation for "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true,"type":"reference"},{"type":"text","text":" was apps without user"},{"type":"text","text":" "},{"type":"text","text":"auth that still want stable identity for analytics. Mint a UUID once with the"},{"type":"text","text":" "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)","isActive":true,"type":"reference"},{"type":"text","text":" helper, hydrate into "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":" at launch,"},{"type":"text","text":" "},{"type":"text","text":"and feed it to "},{"code":"AnalyticsIdentity","type":"codeVoice"},{"type":"text","text":". The "},{"inlineContent":[{"text":"same","type":"text"}],"type":"emphasis"},{"type":"text","text":" "},{"code":"deviceID","type":"codeVoice"},{"type":"text","text":" is also the stable"},{"type":"text","text":" "},{"type":"text","text":"feature-flag bucketing identity (the plugin’s "},{"code":"deviceIDKeyPath","type":"codeVoice"},{"type":"text","text":"), so analytics"},{"type":"text","text":" "},{"type":"text","text":"and A\/B exposure share one identity:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ `KVKey.deviceID` and `deviceIdentity()` ship with Swidux.","","\/\/ In Store.configured(), before constructing the store:","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.deviceIdentity()   \/\/ reads, or mints-and-persists, a stable UUID","","let initialState = AppState(deviceID: deviceID, \/* … *\/)"]},{"inlineContent":[{"type":"text","text":"Then in the analytics plugin wiring:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["AnalyticsPlugin(","    service: analytics,","    identity: AnalyticsIdentity(userID: \\.deviceID, properties: { _ in [:] }),","    \/\/ …",")"]},{"inlineContent":[{"type":"text","text":"The closure-based "},{"code":"userID","type":"codeVoice"},{"type":"text","text":" keypath runs on every dispatch, so the value"},{"type":"text","text":" "},{"inlineContent":[{"text":"must","type":"text"}],"type":"strong"},{"type":"text","text":" live in state — never call into the Keychain from the closure. Hydrate"},{"type":"text","text":" "},{"type":"text","text":"once; observe state."}],"type":"paragraph"},{"type":"heading","anchor":"Type-safe-Keys","text":"Type-safe Keys","level":2},{"inlineContent":[{"type":"text","text":"Declare each key once on "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true,"type":"reference"},{"type":"text","text":" so the value type travels with the name —"},{"type":"text","text":" "},{"type":"text","text":"no magic strings at call sites:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"]},{"inlineContent":[{"type":"text","text":"Then read and write through static-member literals. The compiler enforces"},{"type":"text","text":" "},{"type":"text","text":"that the value type matches what you declared:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"]},{"inlineContent":[{"type":"text","text":"A typo or wrong type produces a compile error, not a silent miss at runtime."},{"type":"text","text":" "},{"type":"text","text":"Centralizing keys on "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true,"type":"reference"},{"type":"text","text":" also gives you autocomplete and a single place"},{"type":"text","text":" "},{"type":"text","text":"to audit your preference surface."}],"type":"paragraph"},{"type":"heading","anchor":"Wiring","text":"Wiring","level":2},{"type":"heading","anchor":"1-Add-to-your-environment","text":"1. Add to your environment","level":3},{"type":"codeListing","syntax":"swift","code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"]},{"type":"heading","anchor":"2-Hydrate-at-startup","text":"2. Hydrate at startup","level":3},{"inlineContent":[{"type":"text","text":"Read once into the initial state — never read mid-cycle from a reducer."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"]},{"type":"heading","anchor":"3-Write-from-an-effect","text":"3. Write from an effect","level":3},{"inlineContent":[{"type":"text","text":"Mutate state in the reducer, return an effect that writes the value:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["case .themeChanged(let theme):","    state.theme = theme","    return Effect { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"]},{"inlineContent":[{"type":"text","text":"No "},{"code":"try?","type":"codeVoice"},{"type":"text","text":", no "},{"code":"do\/catch","type":"codeVoice"},{"type":"text","text":". "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","isActive":true,"type":"reference"},{"type":"text","text":" does not throw —"},{"type":"text","text":" "},{"type":"text","text":"encoder errors are programmer mistakes (e.g. "},{"code":"Float.nan","type":"codeVoice"},{"type":"text","text":"), so the store logs"},{"type":"text","text":" "},{"type":"text","text":"them and triggers "},{"code":"assertionFailure","type":"codeVoice"},{"type":"text","text":" in DEBUG instead of forcing every effect"},{"type":"text","text":" "},{"type":"text","text":"to handle an "},{"code":"Error","type":"codeVoice"},{"type":"text","text":" it can’t act on."}],"type":"paragraph"},{"type":"heading","anchor":"Testing","text":"Testing","level":2},{"inlineContent":[{"type":"text","text":"Inject "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","isActive":true,"type":"reference"},{"type":"text","text":" and assert against the same instance:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"]},{"inlineContent":[{"type":"text","text":"Tests touching real "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":" should use a fresh per-test suite and tear"},{"type":"text","text":" "},{"type":"text","text":"it down explicitly:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"]},{"type":"heading","anchor":"Reads-Are-For-Hydration","text":"Reads Are For Hydration","level":2},{"content":[{"inlineContent":[{"text":"Reading from ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference","isActive":true},{"text":" mid-cycle (inside a reducer) is an","type":"text"},{"text":" ","type":"text"},{"text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at","type":"text"},{"text":" ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" construction. After hydration, the value lives in state and","type":"text"},{"text":" ","type":"text"},{"text":"downstream code observes state, not the store.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"important","name":"Important"},{"inlineContent":[{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":" itself is thread-safe, but a reducer reading while an effect"},{"type":"text","text":" "},{"type":"text","text":"writes creates ordering ambiguity. Hydrate, observe state, write through"},{"type":"text","text":" "},{"type":"text","text":"effects — that’s the discipline."}],"type":"paragraph"},{"type":"heading","anchor":"Failure-Modes","text":"Failure Modes","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Missing key","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":". Provide a","type":"text"},{"text":" ","type":"text"},{"text":"default at the call site.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Decode failure","type":"text"}],"type":"strong"},{"text":" — returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" and logs through ","type":"text"},{"type":"codeVoice","code":"os.Logger"},{"text":" ","type":"text"},{"text":"(subsystem ","type":"text"},{"type":"codeVoice","code":"\"swidux\""},{"text":", category ","type":"text"},{"type":"codeVoice","code":"\"kvstore\""},{"text":"). On startup, behaves identically","type":"text"},{"text":" ","type":"text"},{"text":"to first launch.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Encode failure","type":"text"}],"type":"strong"},{"text":" — logged at the same subsystem\/category, then","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"assertionFailure"},{"text":" fires in DEBUG so the bug surfaces during development.","type":"text"},{"text":" ","type":"text"},{"text":"Production builds log and continue; the in-memory state is unchanged. The","type":"text"},{"text":" ","type":"text"},{"text":"API does not throw — there is no useful runtime recovery from inside an","type":"text"},{"text":" ","type":"text"},{"text":"effect, and ","type":"text"},{"type":"codeVoice","code":"try?"},{"text":" would just hide the problem.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Keychain unreachable","type":"text"}],"type":"strong"},{"text":" — an unsigned build, a locked device, or a missing","type":"text"},{"text":" ","type":"text"},{"text":"entitlement makes ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"},{"text":" writes fail for reasons no caller","type":"text"},{"text":" ","type":"text"},{"text":"can fix. These log and return ","type":"text"},{"type":"codeVoice","code":"false"},{"text":"; they do ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" trap, because a test","type":"text"},{"text":" ","type":"text"},{"text":"host built without code signing would otherwise crash on its first write.","type":"text"},{"text":" ","type":"text"},{"text":"Malformed queries still assert in DEBUG.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"code":"setValue","type":"codeVoice"},{"type":"text","text":" and "},{"code":"removeValue","type":"codeVoice"},{"type":"text","text":" r