\/KVKey"},{"type":"text","text":","},{"type":"text","text":" "},{"text":"which pairs a backing-store name with its ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" value type at compile time.","type":"text"}]},{"type":"heading","text":"When to Use What","level":2,"anchor":"When-to-Use-What"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Need","type":"text"}]}],[{"inlineContent":[{"text":"Use","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Collection of identifiable entities (decks, cards, sessions)"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":" + "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"Scalar preference (theme, sort order, last-seen version)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"},{"type":"text","text":" (UserDefaults)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Anonymous device identity that must survive reinstall"}]}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"},{"type":"text","text":" (Keychain)"}],"type":"paragraph"}]]],"header":"row"},{"inlineContent":[{"code":"EntityStore","type":"codeVoice"},{"text":" is for many-of-a-kind data with change tracking and batched","type":"text"},{"text":" ","type":"text"},{"text":"writes. ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":" is for one-of-a-kind values that you read once at","type":"text"},{"text":" ","type":"text"},{"text":"startup and overwrite on change.","type":"text"}],"type":"paragraph"},{"text":"UserDefaults vs Keychain","anchor":"UserDefaults-vs-Keychain","level":3,"type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Survives reinstall?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"No","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes (this-device-only by default)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Backup \/ device migration","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Included","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Excluded with default accessibility","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Throughput"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fast (in-memory cache)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Slower (system call)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Visible to other apps?"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No (per app\/group)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Optionally (App Groups via ","type":"text"},{"code":"accessGroup:","type":"codeVoice"},{"text":")","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Best for","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Theme, sort order, feature toggles, last-seen version"}]}],[{"type":"paragraph","inlineContent":[{"text":"Anonymous device ID, opaque tokens","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"text":"The Keychain costs more per access — hydrate once at launch and observe state","type":"text"},{"text":" ","type":"text"},{"text":"afterward, never read inside a reducer.","type":"text"}],"type":"paragraph"},{"level":3,"text":"macOS sandbox & entitlements","anchor":"macOS-sandbox--entitlements","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" uses the data-protection keychain, so it never raises"},{"type":"text","text":" "},{"type":"text","text":"a user prompt — no “Always Allow \/ Deny” dialog, no locked-keychain prompt, no"},{"type":"text","text":" "},{"type":"text","text":"Touch ID \/ Face ID challenge."}],"type":"paragraph"},{"style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"sandboxed"}]},{"type":"text","text":" macOS app still needs a keychain entitlement, even when"},{"type":"text","text":" "},{"type":"text","text":"not sharing items across an access group. Xcode supplies an"},{"type":"text","text":" "},{"type":"codeVoice","code":"application-identifier"},{"type":"text","text":" automatically for provisioning-profile–signed"},{"type":"text","text":" "},{"type":"text","text":"builds; otherwise add an explicit "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entry:"}]},{"type":"codeListing","code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"],"syntax":"xml"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Without it, the first "},{"code":"setValue","type":"codeVoice"},{"type":"text","text":" fails with "},{"code":"errSecMissingEntitlement","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"OSStatus","type":"codeVoice"},{"type":"text","text":" −34018). This is a build\/signing condition, not a runtime"},{"type":"text","text":" "},{"type":"text","text":"prompt. iOS \/ iPadOS \/ tvOS \/ watchOS need no extra entitlement."}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"Encryption, accessibility, iCloud-sync exclusion, and backup exclusion are"},{"type":"text","text":" "},{"type":"text","text":"identical whichever entitlement you use — the access group only controls"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"which of your own apps","type":"text"}]},{"type":"text","text":" can read an item, never third parties or the cloud."},{"type":"text","text":" "},{"type":"text","text":"For a private device ID, in order of strictness:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Most private:","type":"text"}]},{"type":"text","text":" profile-signed build + "},{"code":"accessGroup: nil","type":"codeVoice"},{"type":"text","text":", relying on the"},{"type":"text","text":" "},{"type":"text","text":"implicit "},{"type":"codeVoice","code":"application-identifier"},{"type":"text","text":" group. No other app — even same-team —"},{"type":"text","text":" "},{"type":"text","text":"can be entitled to it. Mirrors the iOS default; zero sharing surface."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Practically equivalent:","type":"text"}]},{"text":" a ","type":"text"},{"type":"codeVoice","code":"keychain-access-groups"},{"text":" array whose only","type":"text"},{"text":" ","type":"text"},{"text":"entry is the team-prefixed bundle id (the snippet above). Use when a","type":"text"},{"text":" ","type":"text"},{"text":"profile-signed build isn’t available (unsigned local \/ CI dev). Only delta:","type":"text"},{"text":" ","type":"text"},{"text":"a same-team app you sign could also declare that string.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Intentional sharing only:"}],"type":"strong"},{"text":" a shared group string. The ","type":"text"},{"inlineContent":[{"type":"text","text":"first"}],"type":"emphasis"},{"text":" element","type":"text"},{"text":" ","type":"text"},{"text":"becomes the default group for new items — never put a shared group first","type":"text"},{"text":" ","type":"text"},{"text":"for private data.","type":"text"}],"type":"paragraph"}]}]},{"level":2,"anchor":"Device-Identity-Pattern","text":"Device-Identity Pattern","type":"heading"},{"inlineContent":[{"type":"text","text":"The original motivation for "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true},{"text":" was apps without user","type":"text"},{"text":" ","type":"text"},{"text":"auth that still want stable identity for analytics. Stash a UUID once, hydrate","type":"text"},{"text":" ","type":"text"},{"text":"into ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" at launch, feed it to ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension KVKey where Value == String {","    static let deviceID = KVKey<String>(\"device-id\")","}","","\/\/ In Store.configured(), before constructing the store:","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.value(.deviceID) ?? {","    let new = UUID().uuidString","    kv.setValue(new, for: .deviceID)","    return new","}()","","let initialState = AppState(deviceID: deviceID, \/* … *\/)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then in the analytics plugin wiring:"}]},{"type":"codeListing","syntax":"swift","code":["AnalyticsPlugin(","    service: analytics,","    identity: AnalyticsIdentity(userID: \\.deviceID, properties: { _ in [:] }),","    \/\/ …",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The closure-based "},{"type":"codeVoice","code":"userID"},{"type":"text","text":" keypath runs on every dispatch, so the value"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"must"}]},{"type":"text","text":" live in state — never call into the Keychain from the closure. Hydrate"},{"type":"text","text":" "},{"type":"text","text":"once; observe state."}]},{"level":2,"type":"heading","text":"Type-safe Keys","anchor":"Type-safe-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare each key once on "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true,"type":"reference"},{"type":"text","text":" so the value type travels with the name —"},{"type":"text","text":" "},{"type":"text","text":"no magic strings at call sites:"}]},{"type":"codeListing","syntax":"swift","code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"]},{"type":"paragraph","inlineContent":[{"text":"Then read and write through static-member literals. The compiler enforces","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that the value type matches what you declared:"}]},{"type":"codeListing","syntax":"swift","code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"]},{"inlineContent":[{"text":"A typo or wrong type produces a compile error, not a silent miss at runtime.","type":"text"},{"text":" ","type":"text"},{"text":"Centralizing keys on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference"},{"text":" also gives you autocomplete and a single place","type":"text"},{"text":" ","type":"text"},{"text":"to audit your preference surface.","type":"text"}],"type":"paragraph"},{"anchor":"Wiring","text":"Wiring","level":2,"type":"heading"},{"anchor":"1-Add-to-your-environment","text":"1. Add to your environment","level":3,"type":"heading"},{"syntax":"swift","code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"],"type":"codeListing"},{"anchor":"2-Hydrate-at-startup","text":"2. Hydrate at startup","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Read once into the initial state — never read mid-cycle from a reducer."}],"type":"paragraph"},{"syntax":"swift","code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"],"type":"codeListing"},{"anchor":"3-Write-from-an-effect","text":"3. Write from an effect","level":3,"type":"heading"},{"inlineContent":[{"text":"Mutate state in the reducer, return an effect that writes the value:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"],"type":"codeListing"},{"inlineContent":[{"text":"No ","type":"text"},{"code":"try?","type":"codeVoice"},{"text":", no ","type":"text"},{"code":"do\/catch","type":"codeVoice"},{"text":". ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","type":"reference"},{"text":" does not throw —","type":"text"},{"text":" ","type":"text"},{"text":"encoder errors are programmer mistakes (e.g. ","type":"text"},{"code":"Float.nan","type":"codeVoice"},{"text":"), so the store logs","type":"text"},{"text":" ","type":"text"},{"text":"them and triggers ","type":"text"},{"code":"assertionFailure","type":"codeVoice"},{"text":" in DEBUG instead of forcing every effect","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to handle an "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" it can’t act on."}],"type":"paragraph"},{"anchor":"Testing","type":"heading","level":2,"text":"Testing"},{"inlineContent":[{"text":"Inject ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","type":"reference","isActive":true},{"text":" and assert against the same instance:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Tests touching real "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" should use a fresh per-test suite and tear"},{"type":"text","text":" "},{"type":"text","text":"it down explicitly:"}],"type":"paragraph"},{"syntax":"swift","code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"],"type":"codeListing"},{"anchor":"Reads-Are-For-Hydration","type":"heading","level":2,"text":"Reads Are For Hydration"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reading from "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"type":"text","text":" mid-cycle (inside a reducer) is an"},{"type":"text","text":" "},{"type":"text","text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" construction. After hydration, the value lives in state and"},{"type":"text","text":" "},{"type":"text","text":"downstream code observes state, not the store."}]}],"type":"aside","style":"important"},{"inlineContent":[{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" itself is thread-safe, but a reducer reading while an effect"},{"type":"text","text":" "},{"type":"text","text":"writes creates ordering ambiguity. Hydrate, observe state, write through"},{"text":" ","type":"text"},{"text":"effects — that’s the discipline.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Failure-Modes","text":"Failure Modes"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Missing key"}]},{"text":" — ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)","isActive":true,"type":"reference"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":". Provide a","type":"text"},{"text":" ","type":"text"},{"text":"default at the call site.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Decode failure"}],"type":"strong"},{"text":" — returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" and logs through ","type":"text"},{"code":"os.Logger","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(subsystem ","type":"text"},{"code":"\"swidux\"","type":"codeVoice"},{"text":", category ","type":"text"},{"code":"\"kvstore\"","type":"codeVoice"},{"text":"). On startup, behaves identically","type":"text"},{"text":" ","type":"text"},{"text":"to first launch.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Encode failure","type":"text"}],"type":"strong"},{"text":" — logged at the same subsystem\/category, then","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"assertionFailure"},{"text":" fires in DEBUG so the bug surfaces during development.","type":"text"},{"text":" ","type":"text"},{"text":"Production builds log and continue; the in-memory state is unchanged. The","type":"text"},{"text":" ","type":"text"},{"text":"API does not throw — there is no useful runtime recovery from inside an","type":"text"},{"text":" ","type":"text"},{"text":"effect, and ","type":"text"},{"code":"try?","type":"codeVoice"},{"text":" would just hide the problem.","type":"text"}],"type":"paragraph"}]}]},{"text":"@AppStorage Interop","anchor":"AppStorage-Interop","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"There is none, by design. "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","isActive":true},{"type":"text","text":" writes JSON-encoded"},{"type":"text","text":" "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" blobs. SwiftUI’s "},{"type":"codeVoice","code":"@AppStorage"},{"type":"text","text":" only observes native primitive types"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Bool"},{"type":"text","text":", "},{"type":"codeVoice","code":"Int"},{"type":"text","text":", "},{"type":"codeVoice","code":"String"},{"type":"text","text":", "},{"type":"codeVoice","code":"Double"},{"type":"text","text":", "},{"type":"codeVoice","code":"URL"},{"type":"text","t