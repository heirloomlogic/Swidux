{"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true},{"text":" is a small protocol for one-shot scalar values that don’t fit","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"text":" model. Three implementations ship:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference"},{"text":" — production, backed by any ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" suite","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference"},{"text":" — production, backed by the system Keychain (survives reinstall)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","type":"reference"},{"text":" — tests, dictionary-backed, reference semantics","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Inject through your ","type":"text"},{"type":"codeVoice","code":"Environment"},{"text":", hydrate state at startup, and write from","type":"text"},{"text":" ","type":"text"},{"text":"effects. Reducers stay pure.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["public protocol KeyValueStore: Sendable {","    func value<Value>(_ key: KVKey<Value>) -> Value?","    @discardableResult","    func setValue<Value>(_ value: Value?, for key: KVKey<Value>) -> Bool","    @discardableResult","    func removeValue<Value>(for key: KVKey<Value>) -> Bool","    func contains<Value>(_ key: KVKey<Value>) -> Bool","}"],"syntax":"swift"},{"inlineContent":[{"text":"All values are JSON-encoded as ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":". Reads and writes go through ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which pairs a backing-store name with its ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" value type at compile time.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"When-to-Use-What","text":"When to Use What"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Need","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Use","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Collection of identifiable entities (decks, cards, sessions)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":" + ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Scalar preference (theme, sort order, last-seen version)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference"},{"text":" (UserDefaults)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Anonymous device identity that must survive reinstall","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference"},{"text":" (Keychain)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Last-known-good entitlement cache (offline pro gate)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference"},{"text":" (Keychain) — backs ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"codeVoice","code":"EntityStore"},{"text":" is for many-of-a-kind data with change tracking and batched","type":"text"},{"text":" ","type":"text"},{"text":"writes. ","type":"text"},{"type":"codeVoice","code":"KeyValueStore"},{"text":" is for one-of-a-kind values that you read once at","type":"text"},{"text":" ","type":"text"},{"text":"startup and overwrite on change.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"UserDefaults-vs-Keychain","text":"UserDefaults vs Keychain"},{"rows":[[[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Survives reinstall?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"No","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes (this-device-only by default)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Backup \/ device migration","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Included","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Excluded with default accessibility","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Throughput","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Fast (in-memory cache)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Slower (system call)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Visible to other apps?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"No (per app\/group)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Optionally (App Groups via ","type":"text"},{"code":"accessGroup:","type":"codeVoice"},{"text":")","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Best for","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Theme, sort order, feature toggles, last-seen version","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Anonymous device ID, opaque tokens, last-known-good entitlement","type":"text"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"text":"The Keychain costs more per access — hydrate once at launch and observe state","type":"text"},{"text":" ","type":"text"},{"text":"afterward, never read inside a reducer.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Prefer the Keychain for anything a user could gain by forging it. A","type":"text"},{"text":" ","type":"text"},{"text":"last-known-good entitlement cache is the clearest case: it grants pro offline,","type":"text"},{"text":" ","type":"text"},{"text":"so a ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"text":" plist (editable directly or via a doctored-backup restore)","type":"text"},{"text":" ","type":"text"},{"text":"lets a spoofed value unlock the app. ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"ResilientPaywallService"},{"text":" ","type":"text"},{"text":"persists that cache through an injected ","type":"text"},{"type":"codeVoice","code":"KeyValueStore"},{"text":", so back it with the","type":"text"},{"text":" ","type":"text"},{"text":"Keychain.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"macOS-sandbox--entitlements","text":"macOS sandbox & entitlements"},{"inlineContent":[{"type":"codeVoice","code":"KeychainKeyValueStore"},{"text":" uses the data-protection keychain, so it never raises","type":"text"},{"text":" ","type":"text"},{"text":"a user prompt — no “Always Allow \/ Deny” dialog, no locked-keychain prompt, no","type":"text"},{"text":" ","type":"text"},{"text":"Touch ID \/ Face ID challenge.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"text":"sandboxed","type":"text"}],"type":"emphasis"},{"text":" macOS app still needs a keychain entitlement, even when","type":"text"},{"text":" ","type":"text"},{"text":"not sharing items across an access group. Xcode supplies an","type":"text"},{"text":" ","type":"text"},{"code":"application-identifier","type":"codeVoice"},{"text":" automatically for provisioning-profile–signed","type":"text"},{"text":" ","type":"text"},{"text":"builds; otherwise add an explicit ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" entry:","type":"text"}]},{"type":"codeListing","syntax":"xml","code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"]},{"type":"paragraph","inlineContent":[{"text":"Without it, the first ","type":"text"},{"code":"setValue","type":"codeVoice"},{"text":" fails with ","type":"text"},{"code":"errSecMissingEntitlement","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"OSStatus","type":"codeVoice"},{"text":" −34018). This is a build\/signing condition, not a runtime","type":"text"},{"text":" ","type":"text"},{"text":"prompt. iOS \/ iPadOS \/ tvOS \/ watchOS need no extra entitlement.","type":"text"}]}],"type":"aside","name":"Tip","style":"tip"},{"type":"heading","level":3,"anchor":"Unsigned-builds-and-test-hosts","text":"Unsigned builds and test hosts"},{"inlineContent":[{"text":"A build made with ","type":"text"},{"type":"codeVoice","code":"CODE_SIGNING_ALLOWED=NO"},{"text":" embeds no entitlements at all, so","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"keychain-access-groups"},{"text":" never reaches the binary and every write returns","type":"text"},{"text":" ","type":"text"},{"text":"−34018. Test hosts and most CI invocations are built that way, which puts the","type":"text"},{"text":" ","type":"text"},{"text":"entitlement advice above out of reach: there is nothing to attach it to.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"KeychainKeyValueStore"},{"text":" treats that as an environment condition rather than a","type":"text"},{"text":" ","type":"text"},{"text":"bug: it logs, returns ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", and carries on. Reach for the returned value","type":"text"},{"text":" ","type":"text"},{"text":"where the app has something to fall back to.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let identity = keychain.deviceIdentity()   \/\/ usable even if nothing persisted"],"syntax":"swift"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)","isActive":true},{"text":" already works this way — a failed write","type":"text"},{"text":" ","type":"text"},{"text":"yields a session-local identity instead of a crash. Adopters do not need to","type":"text"},{"text":" ","type":"text"},{"text":"detect XCTest and swap in a different store.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Adding a ","type":"text"},{"type":"codeVoice","code":"keychain-access-groups"},{"text":" entry has a cost worth weighing: it makes the","type":"text"},{"text":" ","type":"text"},{"text":"app require a provisioning profile for any signed build, which breaks ad-hoc and","type":"text"},{"text":" ","type":"text"},{"text":"local unsigned builds that otherwise run fine. Add it because you want the access","type":"text"},{"text":" ","type":"text"},{"text":"group, not to silence −34018.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Encryption, accessibility, iCloud-sync exclusion, and backup exclusion are","type":"text"},{"text":" ","type":"text"},{"text":"identical whichever entitlement you use — the access group only controls","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"which of your own apps","type":"text"}]},{"text":" can read an item, never third parties or the cloud.","type":"text"},{"text":" ","type":"text"},{"text":"For a private device ID, in order of strictness:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Most private:"}],"type":"strong"},{"text":" profile-signed build + ","type":"text"},{"code":"accessGroup: nil","type":"codeVoice"},{"text":", relying on the","type":"text"},{"text":" ","type":"text"},{"text":"implicit ","type":"text"},{"code":"application-identifier","type":"codeVoice"},{"text":" group. No other app — even same-team —","type":"text"},{"text":" ","type":"text"},{"text":"can be entitled to it. Mirrors the iOS default; zero sharing surface.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Practically equivalent:"}],"type":"strong"},{"text":" a ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" array whose only","type":"text"},{"text":" ","type":"text"},{"text":"entry is the team-prefixed bundle id (the snippet above). Use when a","type":"text"},{"text":" ","type":"text"},{"text":"profile-signed build isn’t available (unsigned local \/ CI dev). Only delta:","type":"text"},{"text":" ","type":"text"},{"text":"a same-team app you sign could also declare that string.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Intentional sharing only:"}],"type":"strong"},{"text":" a shared group string. The ","type":"text"},{"inlineContent":[{"type":"text","text":"first"}],"type":"emphasis"},{"text":" element","type":"text"},{"text":" ","type":"text"},{"text":"becomes the default group for new items — never put a shared group first","type":"text"},{"text":" ","type":"text"},{"text":"for private data.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Device-Identity-Pattern","text":"Device-Identity Pattern"},{"inlineContent":[{"text":"The original motivation for ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true},{"text":" was apps without user","type":"text"},{"text":" ","type":"text"},{"text":"auth that still want stable identity for analytics. Mint a UUID once with the","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)","isActive":true},{"text":" helper, hydrate into ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" at launch,","type":"text"},{"text":" ","type":"text"},{"text":"and feed it to ","type":"text"},{"type":"codeVoice","code":"AnalyticsIdentity"},{"text":". The ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"same","type":"text"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"deviceID"},{"text":" is also the stable","type":"text"},{"text":" ","type":"text"},{"text":"feature-flag bucketing identity (the plugin’s ","type":"text"},{"type":"codeVoice","code":"deviceIDKeyPath"},{"text":"), so analytics","type":"text"},{"text":" ","type":"text"},{"text":"and A\/B exposure share one identity:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ `KVKey.deviceID` and `deviceIdentity()` ship with Swidux.","","\/\/ In Store.configured(), before constructing the store:","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.deviceIdentity()   \/\/ reads, or mints-and-persists, a stable UUID","","let initialState = AppState(deviceID: deviceID, \/* … *\/)"],"syntax":"swift"},{"inlineContent":[{"text":"Then in the analytics plugin wiring:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["AnalyticsPlugin(","    service: analytics,","    identity: AnalyticsIdentity(userID: \\.deviceID, properties: { _ in [:] }),","    \/\/ …",")"],"syntax":"swift"},{"inlineContent":[{"text":"The closure-based ","type":"text"},{"type":"codeVoice","code":"userID"},{"text":" keypath runs on every dispatch, so the value","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"text":"must","type":"text"}]},{"text":" live in state — never call into the Keychain from the closure. Hydrate","type":"text"},{"text":" ","type":"text"},{"text":"once; observe state.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Type-safe-Keys","text":"Type-safe Keys"},{"inlineContent":[{"text":"Declare each key once on ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true},{"text":" so the value type travels with the name —","type":"text"},{"text":" ","type":"text"},{"text":"no magic strings at call sites:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"],"syntax":"swift"},{"inlineContent":[{"text":"Then read and write through static-member literals. The compiler enforces","type":"text"},{"text":" ","type":"text"},{"text":"that the value type matches what you declared:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"],"syntax":"swift"},{"inlineContent":[{"text":"A typo or wrong type produces a compile error, not a silent miss at runtime.","type":"text"},{"text":" ","type":"text"},{"text":"Centralizing keys on ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true},{"text":" also gives you autocomplete and a single place","type":"text"},{"text":" ","type":"text"},{"text":"to audit your preference surface.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Wiring","text":"Wiring"},{"type":"heading","level":3,"anchor":"1-Add-to-your-environment","text":"1. Add to your environment"},{"type":"codeListing","code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"2-Hydrate-at-startup","text":"2. Hydrate at startup"},{"inlineContent":[{"text":"Read once into the initial state — never read mid-cycle from a reducer.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"3-Write-from-an-effect","text":"3. Write from an effect"},{"inlineContent":[{"text":"Mutate state in the reducer, return an effect that writes the value:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"],"syntax":"swift"},{"inlineContent":[{"text":"No ","type":"text"},{"type":"codeVoice","code":"try?"},{"text":", no ","type":"text"},{"type":"codeVoice","code":"do\/catch"},{"text":". ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","isActive":true},{"text":" does not throw —","type":"text"},{"text":" ","type":"text"},{"text":"encoder errors are programmer mistakes (e.g. ","type":"text"},{"type":"codeVoice","code":"Float.nan"},{"text":"), so the store logs","type":"text"},{"text":" ","type":"text"},{"text":"them and triggers ","type":"text"},{"type":"codeVoice","code":"assertionFailure"},{"text":" in DEBUG instead of forcing every effect","type":"text"},{"text":" ","type":"text"},{"text":"to handle an ","type":"text"},{"type":"codeVoice","code":"Error"},{"text":" it can’t act on.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Testing","text":"Testing"},{"inlineContent":[{"text":"Inject ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","isActive":true},{"text":" and assert against the same instance:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"],"syntax":"swift"},{"inlineContent":[{"text":"Tests touching real ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"text":" should use a fresh per-test suite and tear","type":"text"},{"text":" ","type":"text"},{"text":"it down explicitly:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Reads-Are-For-Hydration","text":"Reads Are For Hydration"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Reading from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference"},{"text":" mid-cycle (inside a reducer) is an","type":"text"},{"text":" ","type":"text"},{"text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at","type":"text"},{"text":" ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" construction. After hydration, the value lives in state and","type":"text"},{"text":" ","type":"text"},{"text":"downstream code observes state, not the store.","type":"text"}]}],"type":"aside","name":"Important","style":"important"},{"inlineContent":[{"type":"codeVoice","code":"UserDefaults"},{"text":" itself is thread-safe, but a reducer reading while an effect","type":"text"},{"text":" ","type":"text"},{"text":"writes creates ordering ambiguity. Hydrate, observe state, write through","type":"text"},{"text":" ","type":