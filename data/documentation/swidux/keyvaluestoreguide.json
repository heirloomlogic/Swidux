{"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true},{"type":"text","text":" is a small protocol for one-shot scalar values that don’t fit"},{"type":"text","text":" "},{"text":"the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" model. Two implementations ship:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","isActive":true},{"type":"text","text":" — production, backed by any "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":" suite"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","isActive":true},{"text":" — tests, dictionary-backed, reference semantics","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Inject through your ","type":"text"},{"type":"codeVoice","code":"Environment"},{"type":"text","text":", hydrate state at startup, and write from"},{"text":" ","type":"text"},{"text":"effects. Reducers stay pure.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["public protocol KeyValueStore: Sendable {","    func value<Value>(_ key: KVKey<Value>) -> Value?","    func setValue<Value>(_ value: Value?, for key: KVKey<Value>)","    func removeValue<Value>(for key: KVKey<Value>)","    func contains<Value>(_ key: KVKey<Value>) -> Bool","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All values are JSON-encoded as "},{"type":"codeVoice","code":"Data"},{"text":". Reads and writes go through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey"},{"text":",","type":"text"},{"type":"text","text":" "},{"type":"text","text":"which pairs a backing-store name with its "},{"code":"Codable","type":"codeVoice"},{"text":" value type at compile time.","type":"text"}]},{"text":"When to Use What","anchor":"When-to-Use-What","level":2,"type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Need"}]}],[{"type":"paragraph","inlineContent":[{"text":"Use","type":"text"}]}]],[[{"inlineContent":[{"text":"Collection of identifiable entities (decks, cards, sessions)","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"text":" + ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Scalar preference (theme, sort order, last-seen version)"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"}]}]]],"type":"table","header":"row"},{"inlineContent":[{"code":"EntityStore","type":"codeVoice"},{"text":" is for many-of-a-kind data with change tracking and batched","type":"text"},{"type":"text","text":" "},{"type":"text","text":"writes. "},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":" is for one-of-a-kind values that you read once at"},{"text":" ","type":"text"},{"type":"text","text":"startup and overwrite on change."}],"type":"paragraph"},{"text":"Type-safe Keys","anchor":"Type-safe-Keys","level":2,"type":"heading"},{"inlineContent":[{"text":"Declare each key once on ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference","isActive":true},{"text":" so the value type travels with the name —","type":"text"},{"type":"text","text":" "},{"type":"text","text":"no magic strings at call sites:"}],"type":"paragraph"},{"code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then read and write through static-member literals. The compiler enforces"},{"text":" ","type":"text"},{"text":"that the value type matches what you declared:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"]},{"type":"paragraph","inlineContent":[{"text":"A typo or wrong type produces a compile error, not a silent miss at runtime.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Centralizing keys on "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey"},{"text":" also gives you autocomplete and a single place","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to audit your preference surface."}]},{"type":"heading","text":"Wiring","level":2,"anchor":"Wiring"},{"text":"1. Add to your environment","level":3,"anchor":"1-Add-to-your-environment","type":"heading"},{"type":"codeListing","code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"],"syntax":"swift"},{"type":"heading","text":"2. Hydrate at startup","level":3,"anchor":"2-Hydrate-at-startup"},{"inlineContent":[{"text":"Read once into the initial state — never read mid-cycle from a reducer.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"],"type":"codeListing"},{"text":"3. Write from an effect","level":3,"anchor":"3-Write-from-an-effect","type":"heading"},{"inlineContent":[{"type":"text","text":"Mutate state in the reducer, return an effect that writes the value:"}],"type":"paragraph"},{"code":["case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"try?"},{"text":", no ","type":"text"},{"code":"do\/catch","type":"codeVoice"},{"type":"text","text":". "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","isActive":true,"type":"reference"},{"type":"text","text":" does not throw —"},{"type":"text","text":" "},{"type":"text","text":"encoder errors are programmer mistakes (e.g. "},{"code":"Float.nan","type":"codeVoice"},{"type":"text","text":"), so the store logs"},{"text":" ","type":"text"},{"text":"them and triggers ","type":"text"},{"code":"assertionFailure","type":"codeVoice"},{"type":"text","text":" in DEBUG instead of forcing every effect"},{"type":"text","text":" "},{"type":"text","text":"to handle an "},{"code":"Error","type":"codeVoice"},{"type":"text","text":" it can’t act on."}],"type":"paragraph"},{"text":"Testing","anchor":"Testing","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Inject "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","isActive":true,"type":"reference"},{"type":"text","text":" and assert against the same instance:"}],"type":"paragraph"},{"code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Tests touching real "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":" should use a fresh per-test suite and tear"},{"type":"text","text":" "},{"type":"text","text":"it down explicitly:"}],"type":"paragraph"},{"code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"],"type":"codeListing","syntax":"swift"},{"text":"Reads Are For Hydration","anchor":"Reads-Are-For-Hydration","level":2,"type":"heading"},{"style":"important","name":"Important","content":[{"inlineContent":[{"text":"Reading from ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference","isActive":true},{"text":" mid-cycle (inside a reducer) is an","type":"text"},{"text":" ","type":"text"},{"text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" construction. After hydration, the value lives in state and","type":"text"},{"text":" ","type":"text"},{"text":"downstream code observes state, not the store.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"inlineContent":[{"type":"codeVoice","code":"UserDefaults"},{"text":" itself is thread-safe, but a reducer reading while an effect","type":"text"},{"text":" ","type":"text"},{"text":"writes creates ordering ambiguity. Hydrate, observe state, write through","type":"text"},{"text":" ","type":"text"},{"text":"effects — that’s the discipline.","type":"text"}],"type":"paragraph"},{"anchor":"Failure-Modes","text":"Failure Modes","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Missing key"}],"type":"strong"},{"type":"text","text":" — "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)","isActive":true},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". Provide a"},{"type":"text","text":" "},{"type":"text","text":"default at the call site."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Decode failure","type":"text"}],"type":"strong"},{"text":" — returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" and logs through ","type":"text"},{"type":"codeVoice","code":"os.Logger"},{"text":" ","type":"text"},{"text":"(subsystem ","type":"text"},{"type":"codeVoice","code":"\"swidux\""},{"text":", category ","type":"text"},{"type":"codeVoice","code":"\"kvstore\""},{"text":"). On startup, behaves identically","type":"text"},{"text":" ","type":"text"},{"text":"to first launch.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Encode failure","type":"text"}]},{"type":"text","text":" — logged at the same subsystem\/category, then"},{"type":"text","text":" "},{"code":"assertionFailure","type":"codeVoice"},{"type":"text","text":" fires in DEBUG so the bug surfaces during development."},{"type":"text","text":" "},{"type":"text","text":"Production builds log and continue; the in-memory state is unchanged. The"},{"type":"text","text":" "},{"type":"text","text":"API does not throw — there is no useful runtime recovery from inside an"},{"type":"text","text":" "},{"type":"text","text":"effect, and "},{"type":"codeVoice","code":"try?"},{"type":"text","text":" would just hide the problem."}]}]}],"type":"unorderedList"},{"text":"@AppStorage Interop","level":2,"anchor":"AppStorage-Interop","type":"heading"},{"inlineContent":[{"type":"text","text":"There is none, by design. "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","isActive":true},{"type":"text","text":" writes JSON-encoded"},{"type":"text","text":" "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" blobs. SwiftUI’s "},{"type":"codeVoice","code":"@AppStorage"},{"type":"text","text":" only observes native primitive types"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"Bool"},{"type":"text","text":", "},{"type":"codeVoice","code":"Int"},{"text":", ","type":"text"},{"type":"codeVoice","code":"String"},{"type":"text","text":", "},{"type":"codeVoice","code":"Double"},{"text":", ","type":"text"},{"type":"codeVoice","code":"URL"},{"text":", raw ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":"). Two parallel","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"observation channels — Swidux state and "},{"code":"@AppStorage","type":"codeVoice"},{"text":" — would drift.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Swidux state is the source of truth. Read once at hydration, then observe"},{"type":"text","text":" "},{"type":"text","text":"state through the store."}],"type":"paragraph"},{"anchor":"Schema-Migration","text":"Schema Migration","level":2,"type":"heading"},{"inl