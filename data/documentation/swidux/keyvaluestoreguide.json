t)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Backup \/ device migration","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Included","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Excluded with default accessibility","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Throughput","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Fast (in-memory cache)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Slower (system call)","type":"text"}]}]],[[{"inlineContent":[{"text":"Visible to other apps?","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"No (per app\/group)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Optionally (App Groups via ","type":"text"},{"type":"codeVoice","code":"accessGroup:"},{"text":")","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Best for","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Theme, sort order, feature toggles, last-seen version","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Anonymous device ID, opaque tokens","type":"text"}]}]]]},{"inlineContent":[{"text":"The Keychain costs more per access — hydrate once at launch and observe state","type":"text"},{"text":" ","type":"text"},{"text":"afterward, never read inside a reducer.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"macOS sandbox & entitlements","anchor":"macOS-sandbox--entitlements","level":3},{"inlineContent":[{"type":"codeVoice","code":"KeychainKeyValueStore"},{"text":" uses the data-protection keychain, so it never raises","type":"text"},{"text":" ","type":"text"},{"text":"a user prompt — no “Always Allow \/ Deny” dialog, no locked-keychain prompt, no","type":"text"},{"text":" ","type":"text"},{"text":"Touch ID \/ Face ID challenge.","type":"text"}],"type":"paragraph"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"type":"text","text":"sandboxed"}],"type":"emphasis"},{"text":" macOS app still needs a keychain entitlement, even when","type":"text"},{"text":" ","type":"text"},{"text":"not sharing items across an access group. Xcode supplies an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"application-identifier"},{"text":" automatically for provisioning-profile–signed","type":"text"},{"text":" ","type":"text"},{"text":"builds; otherwise add an explicit ","type":"text"},{"type":"codeVoice","code":"keychain-access-groups"},{"text":" entry:","type":"text"}]},{"type":"codeListing","syntax":"xml","code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"]},{"type":"paragraph","inlineContent":[{"text":"Without it, the first ","type":"text"},{"type":"codeVoice","code":"setValue"},{"text":" fails with ","type":"text"},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"OSStatus"},{"text":" −34018). This is a build\/signing condition, not a runtime","type":"text"},{"text":" ","type":"text"},{"text":"prompt. iOS \/ iPadOS \/ tvOS \/ watchOS need no extra entitlement.","type":"text"}]}],"name":"Tip","style":"tip"},{"inlineContent":[{"text":"Encryption, accessibility, iCloud-sync exclusion, and backup exclusion are","type":"text"},{"text":" ","type":"text"},{"text":"identical whichever entitlement you use — the access group only controls","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"which of your own apps","type":"text"}]},{"text":" can read an item, never third parties or the cloud.","type":"text"},{"text":" ","type":"text"},{"text":"For a private device ID, in order of strictness:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Most private:"}]},{"text":" profile-signed build + ","type":"text"},{"type":"codeVoice","code":"accessGroup: nil"},{"text":", relying on the","type":"text"},{"text":" ","type":"text"},{"text":"implicit ","type":"text"},{"type":"codeVoice","code":"application-identifier"},{"text":" group. No other app — even same-team —","type":"text"},{"text":" ","type":"text"},{"text":"can be entitled to it. Mirrors the iOS default; zero sharing surface.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Practically equivalent:"}]},{"text":" a ","type":"text"},{"type":"codeVoice","code":"keychain-access-groups"},{"text":" array whose only","type":"text"},{"text":" ","type":"text"},{"text":"entry is the team-prefixed bundle id (the snippet above). Use when a","type":"text"},{"text":" ","type":"text"},{"text":"profile-signed build isn’t available (unsigned local \/ CI dev). Only delta:","type":"text"},{"text":" ","type":"text"},{"text":"a same-team app you sign could also declare that string.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Intentional sharing only:"}]},{"text":" a shared group string. The ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"first"}]},{"text":" element","type":"text"},{"text":" ","type":"text"},{"text":"becomes the default group for new items — never put a shared group first","type":"text"},{"text":" ","type":"text"},{"text":"for private data.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Device-Identity Pattern","anchor":"Device-Identity-Pattern","level":2},{"inlineContent":[{"text":"The original motivation for ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true,"type":"reference"},{"text":" was apps without user","type":"text"},{"text":" ","type":"text"},{"text":"auth that still want stable identity for analytics. Stash a UUID once, hydrate","type":"text"},{"text":" ","type":"text"},{"text":"into ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" at launch, feed it to ","type":"text"},{"type":"codeVoice","code":"AnalyticsIdentity"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension KVKey where Value == String {","    static let deviceID = KVKey<String>(\"device-id\")","}","","\/\/ In Store.configured(), before constructing the store:","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.value(.deviceID) ?? {","    let new = UUID().uuidString","    kv.setValue(new, for: .deviceID)","    return new","}()","","let initialState = AppState(deviceID: deviceID, \/* … *\/)"]},{"inlineContent":[{"text":"Then in the analytics plugin wiring:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["AnalyticsPlugin(","    service: analytics,","    identity: AnalyticsIdentity(userID: \\.deviceID, properties: { _ in [:] }),","    \/\/ …",")"]},{"inlineContent":[{"text":"The closure-based ","type":"text"},{"type":"codeVoice","code":"userID"},{"text":" keypath runs on every dispatch, so the value","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"text":"must","type":"text"}]},{"text":" live in state — never call into the Keychain from the closure. Hydrate","type":"text"},{"text":" ","type":"text"},{"text":"once; observe state.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Type-safe Keys","anchor":"Type-safe-Keys","level":2},{"inlineContent":[{"text":"Declare each key once on ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true,"type":"reference"},{"text":" so the value type travels with the name —","type":"text"},{"text":" ","type":"text"},{"text":"no magic strings at call sites:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"]},{"inlineContent":[{"text":"Then read and write through static-member literals. The compiler enforces","type":"text"},{"text":" ","type":"text"},{"text":"that the value type matches what you declared:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"]},{"inlineContent":[{"text":"A typo or wrong type produces a compile error, not a silent miss at runtime.","type":"text"},{"text":" ","type":"text"},{"text":"Centralizing keys on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference"},{"text":" also gives you autocomplete and a single place","type":"text"},{"text":" ","type":"text"},{"text":"to audit your preference surface.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Wiring","anchor":"Wiring","level":2},{"type":"heading","text":"1. Add to your environment","anchor":"1-Add-to-your-environment","level":3},{"type":"codeListing","syntax":"swift","code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"]},{"type":"heading","text":"2. Hydrate at startup","anchor":"2-Hydrate-at-startup","level":3},{"inlineContent":[{"text":"Read once into the initial state — never read mid-cycle from a reducer.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"]},{"type":"heading","text":"3. Write from an effect","anchor":"3-Write-from-an-effect","level":3},{"inlineContent":[{"text":"Mutate state in the reducer, return an effect that writes the value:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"]},{"inlineContent":[{"text":"No ","type":"text"},{"type":"codeVoice","code":"try?"},{"text":", no ","type":"text"},{"type":"codeVoice","code":"do\/catch"},{"text":". ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","type":"reference","isActive":true},{"text":" does not throw —","type":"text"},{"text":" ","type":"text"},{"text":"encoder errors are programmer mistakes (e.g. ","type":"text"},{"type":"codeVoice","code":"Float.nan"},{"text":"), so the store logs","type":"text"},{"text":" ","type":"text"},{"text":"them and triggers ","type":"text"},{"type":"codeVoice","code":"assertionFailure"},{"text":" in DEBUG instead of forcing every effect","type":"text"},{"text":" ","type":"text"},{"text":"to handle an ","type":"text"},{"type":"codeVoice","code":"Error"},{"text":" it can’t act on.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Testing","anchor":"Testing","level":2},{"inlineContent":[{"text":"Inject ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","type":"reference","isActive":true},{"text":" and assert against the same instance:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"]},{"inlineContent":[{"text":"Tests touching real ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"text":" should use a fresh per-test suite and tear","type":"text"},{"text":" ","type":"text"},{"text":"it down explicitly:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"]},{"type":"heading","text":"Reads Are For Hydration","anchor":"Reads-Are-For-Hydration","level":2},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reading from "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"},{"type":"text","text":" mid-cycle (inside a reducer) is an"},{"type":"text","text":" "},{"type":"text","text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" construction. After hydration, the value lives in state and"},{"type":"text","text":" "},{"type":"text","text":"downstream code observes state, not the store."}]}],"name":"Important","style":"important"},{"inlineContent":[{"type":"codeVoice","code":"UserDefaults"},{"text":" itself is thread-safe, but a reducer reading while an effect","type":"text"},{"text":" ","type":"text"},{"text":"writes creates ordering ambiguity. Hydrate, observe state, write through","type":"text"},{"text":" ","type":"text"},{"text":"effects — that’s the discipline.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Failure Modes","anchor":"Failure-Modes","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Missing key","type":"text"}]},{"text":" — ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)","isActive":true,"type":"reference"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":". Provide a","type":"text"},{"text":" ","type":"text"},{"text":"default at the call site.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Decode failure","type":"text"}]},{"text":" — returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" and logs through ","type":"text"},{"type":"codeVoice","code":"os.Logger"},{"text":" ","type":"text"},{"text":"(subsystem ","type":"text"},{"type":"codeVoice","code":"\"swidux\""},{"text":", category ","type":"text"},{"type":"codeVoice","code":"\"kvstore\""},{"text":"). On startup, behaves identically","type":"text"},{"text":" ","type":"text"},{"text":"to first launch.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Encode failure","type":"text"}]},{"text":" — logged at the same subsystem\/category, then","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"assertionFailure"},{"text":" fires in DEBUG so the bug surfaces during development.","type":"text"},{"text":" ","type":"text"},{"text":"Production builds log and continue; the in-memory state is unchanged. The","type":"text"},{"text":" ","type":"text"},{"text":"API does not throw — there is no useful runtime recovery from inside an","type":"text"},{"text":" ","type":"text"},{"text":"effect, and ","type":"text"},{"type":"codeVoice","code":"try?"},{"text":" would just hide the problem.","type":"text"}]}]}]},{"type":"heading","text":"@AppStorage Interop","anchor":"AppStorage-Interop","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"There is none, by design. "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference","isActive":true},{"type":"text","text":" writes JSON-encoded"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":" blobs. SwiftUI’s ","type":"text"},{"type":"codeVoice","code":"@AppStorage"},{"text":" only observes native primitive types","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"Bool"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":", ","type":"text"},{"type":"codeVoice","code":"String"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":", ","type":"text"},{"type":"codeVoice","code":"URL"},{"text":", raw ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":"). Two parallel","type":"text"},{"text":" ","type":"text"},{"text":"observation channels — Swidux state and ","type":"text"},{"type":"codeVoice","code":"@AppStorage"},{"text":" — would drift.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Swidux state is the source of truth. Read once at hydration, then observe","type":"text"},{"text":" ","type":"text"},{"text":"state through the store.","type":"text"}]},{"level":2,"type":"heading","text":"Schema Migration","anchor":"Schema-Migration"},{"type":"paragraph","inlineContent":[{"text":"Out of scope for ","type":"text"},{"identifier":"d