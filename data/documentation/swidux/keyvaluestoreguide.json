{"metadata":{"role":"collectionGroup","modules":[{"name":"Swidux"}],"title":"KeyValueStore","roleHeading":"API Collection"},"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"variants":[{"paths":["\/documentation\/swidux\/keyvaluestoreguide"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"type":"text","text":" is a small protocol for one-shot scalar values that don’t fit"},{"type":"text","text":" "},{"type":"text","text":"the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" model. Three implementations ship:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference"},{"type":"text","text":" — production, backed by any "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" suite"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"},{"type":"text","text":" — production, backed by the system Keychain (survives reinstall)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","type":"reference","isActive":true},{"text":" — tests, dictionary-backed, reference semantics","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject through your "},{"code":"Environment","type":"codeVoice"},{"type":"text","text":", hydrate state at startup, and write from"},{"type":"text","text":" "},{"type":"text","text":"effects. Reducers stay pure."}]},{"type":"codeListing","code":["public protocol KeyValueStore: Sendable {","    func value<Value>(_ key: KVKey<Value>) -> Value?","    func setValue<Value>(_ value: Value?, for key: KVKey<Value>)","    func removeValue<Value>(for key: KVKey<Value>)","    func contains<Value>(_ key: KVKey<Value>) -> Bool","}"],"syntax":"swift"},{"inlineContent":[{"text":"All values are JSON-encoded as ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":". Reads and writes go through ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which pairs a backing-store name with its ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":" value type at compile time.","type":"text"}],"type":"paragraph"},{"text":"When to Use What","type":"heading","level":2,"anchor":"When-to-Use-What"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Need"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Collection of identifiable entities (decks, cards, sessions)"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" + "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Scalar preference (theme, sort order, last-seen version)"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference","isActive":true},{"text":" (UserDefaults)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Anonymous device identity that must survive reinstall","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"},{"text":" (Keychain)","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"type":"codeVoice","code":"EntityStore"},{"text":" is for many-of-a-kind data with change tracking and batched","type":"text"},{"text":" ","type":"text"},{"text":"writes. ","type":"text"},{"type":"codeVoice","code":"KeyValueStore"},{"text":" is for one-of-a-kind values that you read once at","type":"text"},{"text":" ","type":"text"},{"text":"startup and overwrite on change.","type":"text"}],"type":"paragraph"},{"text":"UserDefaults vs Keychain","level":3,"anchor":"UserDefaults-vs-Keychain","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Survives reinstall?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes (this-device-only by default)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backup \/ device migration"}]}],[{"type":"paragraph","inlineContent":[{"text":"Included","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Excluded with default accessibility","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Throughput"}]}],[{"type":"paragraph","inlineContent":[{"text":"Fast (in-memory cache)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Slower (system call)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Visible to other apps?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"No (per app\/group)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Optionally (App Groups via ","type":"text"},{"type":"codeVoice","code":"accessGroup:"},{"text":")","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Best for"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Theme, sort order, feature toggles, last-seen version"}]}],[{"type":"paragraph","inlineContent":[{"text":"Anonymous device ID, opaque tokens","type":"text"}]}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Keychain costs more per access — hydrate once at launch and observe state"},{"type":"text","text":" "},{"type":"text","text":"afterward, never read inside a reducer."}]},{"level":3,"anchor":"macOS-sandbox--entitlements","text":"macOS sandbox & entitlements","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" uses the data-protection keychain, so it never raises","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"a user prompt — no “Always Allow \/ Deny” dialog, no locked-keychain prompt, no"},{"type":"text","text":" "},{"text":"Touch ID \/ Face ID challenge.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"sandboxed"}]},{"type":"text","text":" macOS app still needs a keychain entitlement, even when"},{"type":"text","text":" "},{"type":"text","text":"not sharing items across an access group. Xcode supplies an"},{"type":"text","text":" "},{"type":"codeVoice","code":"application-identifier"},{"type":"text","text":" automatically for provisioning-profile–signed"},{"type":"text","text":" "},{"type":"text","text":"builds; otherwise add an explicit "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entry:"}],"type":"paragraph"},{"code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"],"syntax":"xml","type":"codeListing"},{"inlineContent":[{"text":"Without it, the first ","type":"text"},{"type":"codeVoice","code":"setValue"},{"type":"text","text":" fails with "},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"OSStatus"},{"type":"text","text":" −34018). This is a build\/signing condition, not a runtime"},{"type":"text","text":" "},{"type":"text","text":"prompt. iOS \/ iPadOS \/ tvOS \/ watchOS need no extra entitlement."}],"type":"paragraph"}],"style":"tip","name":"Tip"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Encryption, accessibility, iCloud-sync exclusion, and backup exclusion are"},{"type":"text","text":" "},{"text":"identical whichever entitlement you use — the access group only controls","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"which of your own apps","type":"text"}],"type":"emphasis"},{"text":" can read an item, never third parties or the cloud.","type":"text"},{"text":" ","type":"text"},{"text":"For a private device ID, in order of strictness:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Most private:"}]},{"text":" profile-signed build + ","type":"text"},{"type":"codeVoice","code":"accessGroup: nil"},{"text":", relying on the","type":"text"},{"text":" ","type":"text"},{"text":"implicit ","type":"text"},{"type":"codeVoice","code":"application-identifier"},{"text":" group. No other app — even same-team —","type":"text"},{"text":" ","type":"text"},{"text":"can be entitled to it. Mirrors the iOS default; zero sharing surface.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Practically equivalent:"}],"type":"strong"},{"text":" a ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"type":"text","text":" array whose only"},{"type":"text","text":" "},{"type":"text","text":"entry is the team-prefixed bundle id (the snippet above). Use when a"},{"type":"text","text":" "},{"type":"text","text":"profile-signed build isn’t available (unsigned local \/ CI dev). Only delta:"},{"type":"text","text":" "},{"type":"text","text":"a same-team app you sign could also declare that string."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Intentional sharing only:"}],"type":"strong"},{"text":" a shared group string. The ","type":"text"},{"inlineContent":[{"text":"first","type":"text"}],"type":"emphasis"},{"text":" element","type":"text"},{"type":"text","text":" "},{"type":"text","text":"becomes the default group for new items — never put a shared group first"},{"type":"text","text":" "},{"type":"text","text":"for private data."}],"type":"paragraph"}]}]},{"text":"Device-Identity Pattern","level":2,"anchor":"Device-Identity-Pattern","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The original motivation for ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true,"type":"reference"},{"type":"text","text":" was apps without user"},{"type":"text","text":" "},{"text":"auth that still want stable identity for analytics. Stash a UUID once, hydrate","type":"text"},{"type":"text","text":" "},{"type":"text","text":"into "},{"type":"codeVoice","code":"AppState"},{"text":" at launch, feed it to ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["extension KVKey where Value == String {","    static let deviceID = KVKey<String>(\"device-id\")","}","","\/\/ In Store.configured(), before constructing the store:","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.value(.deviceID) ?? {","    let new = UUID().uuidString","    kv.setValue(new, for: .deviceID)","    return new","}()","","let initialState = AppState(deviceID: deviceID, \/* … *\/)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Then in the analytics plugin wiring:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["AnalyticsPlugin(","    service: analytics,","    identity: AnalyticsIdentity(userID: \\.deviceID, properties: { _ in [:] }),","    \/\/ …",")"],"type":"codeListing"},{"inlineContent":[{"text":"The closure-based ","type":"text"},{"code":"userID","type":"codeVoice"},{"text":" keypath runs on every dispatch, so the value","type":"text"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"must","type":"text"}]},{"text":" live in state — never call into the Keychain from the closure. Hydrate","type":"text"},{"text":" ","type":"text"},{"text":"once; observe state.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Type-safe Keys","anchor":"Type-safe-Keys"},{"inlineContent":[{"type":"text","text":"Declare each key once on "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true},{"type":"text","text":" so the value type travels with the name —"},{"type":"text","text":" "},{"type":"text","text":"no magic strings at call sites:"}],"type":"paragraph"},{"syntax":"swift","code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Then read and write through static-member literals. The compiler enforces","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that the value type matches what you declared:"}]},{"type":"codeListing","code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"A typo or wrong type produces a compile error, not a silent miss at runtime."},{"type":"text","text":" "},{"text":"Centralizing keys on ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference","isActive":true},{"text":" also gives you autocomplete and a single place","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to audit your preference surface."}],"type":"paragraph"},{"type":"heading","anchor":"Wiring","text":"Wiring","level":2},{"text":"1. Add to your environment","anchor":"1-Add-to-your-environment","type":"heading","level":3},{"type":"codeListing","code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"],"syntax":"swift"},{"level":3,"anchor":"2-Hydrate-at-startup","type":"heading","text":"2. Hydrate at startup"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read once into the initial state — never read mid-cycle from a reducer."}]},{"type":"codeListing","syntax":"swift","code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"]},{"type":"heading","anchor":"3-Write-from-an-effect","text":"3. Write from an effect","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mutate state in the reducer, return an effect that writes the value:"}]},{"type":"codeListing","code":["case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"try?"},{"type":"text","text":", no "},{"type":"codeVoice","code":"do\/catch"},{"text":". ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)"},{"type":"text","text":" does not throw —"},{"type":"text","text":" "},{"type":"text","text":"encoder errors are programmer mistakes (e.g. "},{"code":"Float.nan","type":"codeVoice"},{"type":"text","text":"), so the store logs"},{"text":" ","type":"text"},{"type":"text","text":"them and triggers "},{"type":"codeVoice","code":"assertionFailure"},{"text":" in DEBUG instead of forcing every effect","type":"text"},{"text":" ","type":"text"},{"text":"to handle an ","type":"text"},{"code":"Error","type":"codeVoice"},{"text":" it can’t act on.","type":"text"}]},{"type":"heading","anchor":"Testing","level":2,"text":"Testing"},{"inlineContent":[{"type":"text","text":"Inject "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","isActive":true},{"text":" and assert against the same instance:","type":"text"}],"type":"paragraph"},{"code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Tests touching real "},{"code":"UserDefaults","type":"codeVoice"},{"text":" should use a fresh per-test suite and tear","type":"text"},{"text":" ","type":"text"},{"text":"it down explicitly:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"]},{"text":"Reads Are For Hydration","anchor":"Reads-Are-For-Hydration","level":2,"type":"heading"},{"name":"Important","content":[{"inlineContent":[{"type":"text","text":"Reading from "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"},{"type":"text","text":" mid-cycle (inside a reducer) is an"},{"type":"text","text":" "},{"type":"text","text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppState"},{"text":" construction. After hydration, the value lives in state and","type":"text"},{"text":" ","type":"text"},{"text":"downstream code observes state, not the store.","type":"text"}],"type":"paragraph"}],"type":"aside","style":"important"},{"inlineContent":[{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":" itself is thread-safe, but a reducer reading while an effect"},{"text":" ","type":"text"},{"text":"writes creates ordering ambiguity. Hydrate, observe state, write through","type":"text"},{"text":" ","type":"text"},{"text":"effects — that’s the discipline.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Failure Modes","level":2,"anchor":"Failure-Modes"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Missing key"}]},{"type":"text","text":" — "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)","type":"reference"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":". Provide a"},{"type":"text","text":" "},{"type":"text","text":"default at the call site."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Decode failure"}],"type":"strong"},{"type":"text","text":" — returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and logs through "},{"code":"os.Logger","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(subsystem "},{"type":"codeVoice","code":"\"swidux\""},{"text":", category ","type":"text"},{"type":"codeVoice","code":"\"kvstore\""},{"text":"). On startup, behaves identically","type":"text"},{"text":" ","type":"text"},{"text":"to first launch.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Encode failure","type":"text"}]},{"text":" — logged at the same subsystem\/category, then","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":" fires in DEBUG so the bug surfaces during development."},{"type":"text","text":" "},{"type":"text","text":"Production builds log and continue; the in-memory state is unchanged. The"},{"type":"text","text":" "},{"type":"text","text":"API does not throw — there is no useful runtime recovery from inside an"},{"type":"text","text":" "},{"type":"text","text":"effect, and "},{"code":"try?","type":"codeVoice"},{"type":"text","text":" would just hide the problem."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"AppStorage-Interop","text":"@AppStorage Interop","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"There is none, by design. "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","isActive":true},{"type":"text","text":" writes JSON-encoded"},{"type":"text","text":" "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" blobs. SwiftUI’s "},{"type":"codeVoice","code":"@AppStorage"},{"text":" only observes native primitive types","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"("},{"type":"codeVoice","code":"Bool"},{"type":"text","text":", "},{"type":"codeVoice","code":"Int"},{"type":"text","text":", "},{"code":"String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":", ","type":"text"},{"code":"URL","type":"codeVoice"},{"text":", raw ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":"). Two parallel","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"observation channels — Swidux state and "},{"code":"@AppStorage","type":"codeVoice"},{"type":"text","text":" — would drift."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swidux state is the source of truth. Read once at hydration, then observe"},{"type":"text","text":" "},{"type":"text","text":"state through the store."}]},{"anchor":"Schema-Migration","text":"Schema Migration","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Out of scope for "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"},{"text":". If a ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" shape changes","type":"text"},{"type":"text","text":" "},{"type":"text","text":"incompatibly, declare a new versioned key:"}]},{"syntax":"swift","code":["\/\/ before:","extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","\/\/ after a breaking shape change:","extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme.v2\")","}"],"type":"