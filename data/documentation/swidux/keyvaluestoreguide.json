{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"topicSections":[{"title":"Keys","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KVKey"],"anchor":"Keys"},{"title":"Protocol","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"],"anchor":"Protocol"},{"title":"Implementations","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore"],"anchor":"Implementations"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/keyvaluestoreguide"]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"title":"Reference","generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"anchor":"Reference"}],"kind":"article","primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"text":" is a small protocol for one-shot scalar values that don’t fit","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" model. Three implementations ship:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","isActive":true},{"type":"text","text":" — production, backed by any "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" suite"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference"},{"type":"text","text":" — production, backed by the system Keychain (survives reinstall)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","type":"reference","isActive":true},{"text":" — tests, dictionary-backed, reference semantics","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject through your "},{"type":"codeVoice","code":"Environment"},{"type":"text","text":", hydrate state at startup, and write from"},{"type":"text","text":" "},{"type":"text","text":"effects. Reducers stay pure."}]},{"type":"codeListing","code":["public protocol KeyValueStore: Sendable {","    func value<Value>(_ key: KVKey<Value>) -> Value?","    func setValue<Value>(_ value: Value?, for key: KVKey<Value>)","    func removeValue<Value>(for key: KVKey<Value>)","    func contains<Value>(_ key: KVKey<Value>) -> Bool","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"All values are JSON-encoded as "},{"type":"codeVoice","code":"Data"},{"type":"text","text":". Reads and writes go through "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true,"type":"reference"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which pairs a backing-store name with its "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" value type at compile time."}],"type":"paragraph"},{"level":2,"text":"When to Use What","anchor":"When-to-Use-What","type":"heading"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Need"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Collection of identifiable entities (decks, cards, sessions)"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" + ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true,"type":"reference"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Scalar preference (theme, sort order, last-seen version)"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference","isActive":true},{"text":" (UserDefaults)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Anonymous device identity that must survive reinstall"}],"type":"paragraph"}],[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference"},{"text":" (Keychain)","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"code":"EntityStore","type":"codeVoice"},{"text":" is for many-of-a-kind data with change tracking and batched","type":"text"},{"text":" ","type":"text"},{"text":"writes. ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":" is for one-of-a-kind values that you read once at","type":"text"},{"text":" ","type":"text"},{"text":"startup and overwrite on change.","type":"text"}],"type":"paragraph"},{"level":3,"text":"UserDefaults vs Keychain","anchor":"UserDefaults-vs-Keychain","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","isActive":true,"type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Survives reinstall?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes (this-device-only by default)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backup \/ device migration"}]}],[{"type":"paragraph","inlineContent":[{"text":"Included","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Excluded with default accessibility"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Throughput","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Fast (in-memory cache)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Slower (system call)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Visible to other apps?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"No (per app\/group)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Optionally (App Groups via "},{"type":"codeVoice","code":"accessGroup:"},{"type":"text","text":")"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Best for","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Theme, sort order, feature toggles, last-seen version","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Anonymous device ID, opaque tokens"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Keychain costs more per access — hydrate once at launch and observe state"},{"type":"text","text":" "},{"type":"text","text":"afterward, never read inside a reducer."}]},{"type":"heading","anchor":"macOS-sandbox--entitlements","level":3,"text":"macOS sandbox & entitlements"},{"type":"paragraph","inlineContent":[{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" uses the data-protection keychain, so it never raises","type":"text"},{"text":" ","type":"text"},{"text":"a user prompt — no “Always Allow \/ Deny” dialog, no locked-keychain prompt, no","type":"text"},{"text":" ","type":"text"},{"text":"Touch ID \/ Face ID challenge.","type":"text"}]},{"style":"tip","type":"aside","name":"Tip","content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"text":"sandboxed","type":"text"}]},{"type":"text","text":" macOS app still needs a keychain entitlement, even when"},{"type":"text","text":" "},{"type":"text","text":"not sharing items across an access group. Xcode supplies an"},{"type":"text","text":" "},{"type":"codeVoice","code":"application-identifier"},{"type":"text","text":" automatically for provisioning-profile–signed"},{"type":"text","text":" "},{"type":"text","text":"builds; otherwise add an explicit "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entry:"}],"type":"paragraph"},{"code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"],"type":"codeListing","syntax":"xml"},{"inlineContent":[{"text":"Without it, the first ","type":"text"},{"code":"setValue","type":"codeVoice"},{"text":" fails with ","type":"text"},{"code":"errSecMissingEntitlement","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"OSStatus","type":"codeVoice"},{"text":" −34018). This is a build\/signing condition, not a runtime","type":"text"},{"text":" ","type":"text"},{"text":"prompt. iOS \/ iPadOS \/ tvOS \/ watchOS need no extra entitlement.","type":"text"}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"Encryption, accessibility, iCloud-sync exclusion, and backup exclusion are","type":"text"},{"text":" ","type":"text"},{"text":"identical whichever entitlement you use — the access group only controls","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"which of your own apps","type":"text"}]},{"text":" can read an item, never third parties or the cloud.","type":"text"},{"text":" ","type":"text"},{"text":"For a private device ID, in order of strictness:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Most private:","type":"text"}]},{"text":" profile-signed build + ","type":"text"},{"code":"accessGroup: nil","type":"codeVoice"},{"text":", relying on the","type":"text"},{"text":" ","type":"text"},{"text":"implicit ","type":"text"},{"code":"application-identifier","type":"codeVoice"},{"text":" group. No other app — even same-team —","type":"text"},{"text":" ","type":"text"},{"text":"can be entitled to it. Mirrors the iOS default; zero sharing surface.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Practically equivalent:","type":"text"}]},{"type":"text","text":" a "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" array whose only"},{"text":" ","type":"text"},{"text":"entry is the team-prefixed bundle id (the snippet above). Use when a","type":"text"},{"text":" ","type":"text"},{"text":"profile-signed build isn’t available (unsigned local \/ CI dev). Only delta:","type":"text"},{"text":" ","type":"text"},{"text":"a same-team app you sign could also declare that string.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Intentional sharing only:"}]},{"text":" a shared group string. The ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"first"}]},{"text":" element","type":"text"},{"text":" ","type":"text"},{"text":"becomes the default group for new items — never put a shared group first","type":"text"},{"text":" ","type":"text"},{"text":"for private data.","type":"text"}]}]}]},{"anchor":"Device-Identity-Pattern","type":"heading","text":"Device-Identity Pattern","level":2},{"type":"paragraph","inlineContent":[{"text":"The original motivation for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference"},{"text":" was apps without user","type":"text"},{"text":" ","type":"text"},{"text":"auth that still want stable identity for analytics. Stash a UUID once, hydrate","type":"text"},{"text":" ","type":"text"},{"text":"into ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" at launch, feed it to ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["extension KVKey where Value == String {","    static let deviceID = KVKey<String>(\"device-id\")","}","","\/\/ In Store.configured(), before constructing the store:","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.value(.deviceID) ?? {","    let new = UUID().uuidString","    kv.setValue(new, for: .deviceID)","    return new","}()","","let initialState = AppState(deviceID: deviceID, \/* … *\/)"]},{"type":"paragraph","inlineContent":[{"text":"Then in the analytics plugin wiring:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["AnalyticsPlugin(","    service: analytics,","    identity: AnalyticsIdentity(userID: \\.deviceID, properties: { _ in [:] }),","    \/\/ …",")"]},{"type":"paragraph","inlineContent":[{"text":"The closure-based ","type":"text"},{"code":"userID","type":"codeVoice"},{"text":" keypath runs on every dispatch, so the value","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"must"}],"type":"strong"},{"text":" live in state — never call into the Keychain from the closure. Hydrate","type":"text"},{"text":" ","type":"text"},{"text":"once; observe state.","type":"text"}]},{"level":2,"type":"heading","text":"Type-safe Keys","anchor":"Type-safe-Keys"},{"inlineContent":[{"type":"text","text":"Declare each key once on "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true},{"type":"text","text":" so the value type travels with the name —"},{"type":"text","text":" "},{"type":"text","text":"no magic strings at call sites:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"]},{"inlineContent":[{"type":"text","text":"Then read and write through static-member literals. The compiler enforces"},{"type":"text","text":" "},{"type":"text","text":"that the value type matches what you declared:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"]},{"inlineContent":[{"text":"A typo or wrong type produces a compile error, not a silent miss at runtime.","type":"text"},{"text":" ","type":"text"},{"text":"Centralizing keys on ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference","isActive":true},{"text":" also gives you autocomplete and a single place","type":"text"},{"text":" ","type":"text"},{"text":"to audit your preference surface.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Wiring","anchor":"Wiring"},{"level":3,"type":"heading","text":"1. Add to your environment","anchor":"1-Add-to-your-environment"},{"syntax":"swift","type":"codeListing","code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"]},{"level":3,"type":"heading","text":"2. Hydrate at startup","anchor":"2-Hydrate-at-startup"},{"inlineContent":[{"type":"text","text":"Read once into the initial state — never read mid-cycle from a reducer."}],"type":"paragraph"},{"type":"codeListing","code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"],"syntax":"swift"},{"text":"3. Write from an effect","type":"heading","level":3,"anchor":"3-Write-from-an-effect"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mutate state in the reducer, return an effect that writes the value:"}]},{"type":"codeListing","code":["case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"No ","type":"text"},{"code":"try?","type":"codeVoice"},{"text":", no ","type":"text"},{"code":"do\/catch","type":"codeVoice"},{"text":". ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","isActive":true,"type":"reference"},{"text":" does not throw —","type":"text"},{"text":" ","type":"text"},{"text":"encoder errors are programmer mistakes (e.g. ","type":"text"},{"code":"Float.nan","type":"codeVoice"},{"text":"), so the store logs","type":"text"},{"text":" ","type":"text"},{"text":"them and triggers ","type":"text"},{"code":"assertionFailure","type":"codeVoice"},{"text":" in DEBUG instead of forcing every effect","type":"text"},{"text":" ","type":"text"},{"text":"to handle an ","type":"text"},{"code":"Error","type":"codeVoice"},{"text":" it can’t act on.","type":"text"}]},{"text":"Testing","type":"heading","level":2,"anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"Inject ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","isActive":true,"type":"reference"},{"text":" and assert against the same instance:","type":"text"}]},{"type":"codeListing","code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tests touching real "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" should use a fresh per-test suite and tear"},{"type":"text","text":" "},{"type":"text","text":"it down explicitly:"}]},{"code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Reads Are For Hydration","anchor":"Reads-Are-For-Hydration","type":"heading"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Reading from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference"},{"text":" mid-cycle (inside a reducer) is an","type":"text"},{"text":" ","type":"text"},{"text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at","type":"text"},{"text":" ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" construction. After hydration, the value lives in state and","type":"text"},{"text":" ","type":"text"},{"text":"downstream code observes state, not the store.","type":"text"}]}],"type":"aside","style":"important"},{"inlineContent":[{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":" itself is thread-safe, but a reducer reading while an effect"},{"type":"text","text":" "},{"type":"text","text":"writes creates ordering ambiguity. Hydrate, observe state, write through"},{"type":"text","text":" "},{"type":"text","text":"effects — that’s the discipline."}],"type":"paragraph"},{"level":2,"text":"Failure Modes","anchor":"Failure-Modes","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Missing key"}],"type":"strong"},{"type":"text","text":" — "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". Provide a"},{"type":"text","text":" "},{"type":"text","text":"default at the call site."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Decode failure"}],"type":"strong"},{"text":" — returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" and logs through ","type":"text"},{"type":"codeVoice","code":"os.Logger"},{"text":" ","type":"text"},{"text":"(subsystem ","type":"text"},{"type":"codeVoice","code":"\"swidux\""},{"text":", category ","type":"text"},{"type":"codeVoice","code":"\"kvstore\""},{"text":"). On startup, behaves identically","type":"text"},{"text":" ","type":"text"},{"text":"to first launch.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Encode failure","type":"text"}]},{"text":" — logged at the same subsystem\/category, then","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"assertionFailure"},{"text":" fires in DEBUG so the bug surfaces during development.","type":"text"},{"text":" ","type":"text"},{"text":"Production builds log and continue; the in-memory state is unchanged. The","type":"text"},{"text":" ","type":"text"},{"text":"API does not throw — there is no useful runtime recovery from inside an","type":"text"},{"text":" ","type":"text"},{"text":"effect, and ","type":"text"},{"type":"codeVoice","code":"try?"},{"text":" would just hide the problem.","type":"text"}]}]}],"type":"unorderedList"},{"text":"@AppStorage Interop","level":2,"anchor":"AppStorage-Interop","type":"heading"},{"inlineContent":[{"type":"text","text":"There is none, by design. "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference","isActive":true},{"type":"text","text":" writes JSON-encoded"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":" blobs. SwiftUI’s ","type":"text"},{"type":"codeVoice","code":"@AppStorage"},{"text":" only observes native primitive types","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"Bool"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":", ","type":"text"},{"type":"codeVoice","code":"String"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":", ","type":"text"},{"type":"codeVoice","code":"URL"},{"text":", raw ","type":"text"}