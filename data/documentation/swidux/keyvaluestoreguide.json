{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"kind":"article","sections":[],"metadata":{"modules":[{"name":"Swidux"}],"role":"collectionGroup","roleHeading":"API Collection","title":"KeyValueStore"},"abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference","isActive":true},{"text":" is a small protocol for one-shot scalar values that don’t fit","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":" model. Three implementations ship:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference"},{"text":" — production, backed by any ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" suite","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference"},{"text":" — production, backed by the system Keychain (survives reinstall)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","type":"reference"},{"type":"text","text":" — tests, dictionary-backed, reference semantics"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Inject through your ","type":"text"},{"type":"codeVoice","code":"Environment"},{"text":", hydrate state at startup, and write from","type":"text"},{"text":" ","type":"text"},{"text":"effects. Reducers stay pure.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public protocol KeyValueStore: Sendable {","    func value<Value>(_ key: KVKey<Value>) -> Value?","    @discardableResult","    func setValue<Value>(_ value: Value?, for key: KVKey<Value>) -> Bool","    @discardableResult","    func removeValue<Value>(for key: KVKey<Value>) -> Bool","    func contains<Value>(_ key: KVKey<Value>) -> Bool","}"],"type":"codeListing"},{"inlineContent":[{"text":"All values are JSON-encoded as ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":". Reads and writes go through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which pairs a backing-store name with its ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" value type at compile time.","type":"text"}],"type":"paragraph"},{"text":"When to Use What","level":2,"anchor":"When-to-Use-What","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Need","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Collection of identifiable entities (decks, cards, sessions)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" + ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true,"type":"reference"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Scalar preference (theme, sort order, last-seen version)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"},{"text":" (UserDefaults)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Anonymous device identity that must survive reinstall","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"},{"text":" (Keychain)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Last-known-good entitlement cache (offline pro gate)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"},{"text":" (Keychain) — backs ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"code":"EntityStore","type":"codeVoice"},{"text":" is for many-of-a-kind data with change tracking and batched","type":"text"},{"text":" ","type":"text"},{"text":"writes. ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":" is for one-of-a-kind values that you read once at","type":"text"},{"text":" ","type":"text"},{"text":"startup and overwrite on change.","type":"text"}],"type":"paragraph"},{"text":"UserDefaults vs Keychain","level":3,"anchor":"UserDefaults-vs-Keychain","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","isActive":true,"type":"reference"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true,"type":"reference"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Survives reinstall?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes (this-device-only by default)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Backup \/ device migration","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Included","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Excluded with default accessibility","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Throughput","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Fast (in-memory cache)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Slower (system call)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Visible to other apps?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No (per app\/group)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Optionally (App Groups via ","type":"text"},{"code":"accessGroup:","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Best for","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Theme, sort order, feature toggles, last-seen version","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Anonymous device ID, opaque tokens, last-known-good entitlement","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"The Keychain costs more per access — hydrate once at launch and observe state","type":"text"},{"text":" ","type":"text"},{"text":"afterward, never read inside a reducer.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Prefer the Keychain for anything a user could gain by forging it. A","type":"text"},{"text":" ","type":"text"},{"text":"last-known-good entitlement cache is the clearest case: it grants pro offline,","type":"text"},{"text":" ","type":"text"},{"text":"so a ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" plist (editable directly or via a doctored-backup restore)","type":"text"},{"text":" ","type":"text"},{"text":"lets a spoofed value unlock the app. ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" ","type":"text"},{"text":"persists that cache through an injected ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":", so back it with the","type":"text"},{"text":" ","type":"text"},{"text":"Keychain.","type":"text"}],"type":"paragraph"},{"text":"macOS sandbox & entitlements","level":3,"anchor":"macOS-sandbox--entitlements","type":"heading"},{"inlineContent":[{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" uses the data-protection keychain, so it never raises","type":"text"},{"text":" ","type":"text"},{"text":"a user prompt — no “Always Allow \/ Deny” dialog, no locked-keychain prompt, no","type":"text"},{"text":" ","type":"text"},{"text":"Touch ID \/ Face ID challenge.","type":"text"}],"type":"paragraph"},{"name":"Tip","content":[{"inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"text":"sandboxed","type":"text"}],"type":"emphasis"},{"text":" macOS app still needs a keychain entitlement, even when","type":"text"},{"text":" ","type":"text"},{"text":"not sharing items across an access group. Xcode supplies an","type":"text"},{"text":" ","type":"text"},{"code":"application-identifier","type":"codeVoice"},{"text":" automatically for provisioning-profile–signed","type":"text"},{"text":" ","type":"text"},{"text":"builds; otherwise add an explicit ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" entry:","type":"text"}],"type":"paragraph"},{"code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"],"syntax":"xml","type":"codeListing"},{"inlineContent":[{"text":"Without it, the first ","type":"text"},{"code":"setValue","type":"codeVoice"},{"text":" fails with ","type":"text"},{"code":"errSecMissingEntitlement","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"OSStatus","type":"codeVoice"},{"text":" −34018). This is a build\/signing condition, not a runtime","type":"text"},{"text":" ","type":"text"},{"text":"prompt. iOS \/ iPadOS \/ tvOS \/ watchOS need no extra entitlement.","type":"text"}],"type":"paragraph"}],"style":"tip","type":"aside"},{"text":"Unsigned builds and test hosts","level":3,"anchor":"Unsigned-builds-and-test-hosts","type":"heading"},{"inlineContent":[{"text":"A build made with ","type":"text"},{"code":"CODE_SIGNING_ALLOWED=NO","type":"codeVoice"},{"text":" embeds no entitlements at all, so","type":"text"},{"text":" ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" never reaches the binary and every write returns","type":"text"},{"text":" ","type":"text"},{"text":"−34018. Test hosts and most CI invocations are built that way, which puts the","type":"text"},{"text":" ","type":"text"},{"text":"entitlement advice above out of reach: there is nothing to attach it to.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" treats that as an environment condition rather than a","type":"text"},{"text":" ","type":"text"},{"text":"bug: it logs, returns ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", and carries on. Reach for the returned value","type":"text"},{"text":" ","type":"text"},{"text":"where the app has something to fall back to.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let identity = keychain.deviceIdentity()   \/\/ usable even if nothing persisted"],"type":"codeListing"},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)","type":"reference","isActive":true},{"text":" already works this way — a failed write","type":"text"},{"text":" ","type":"text"},{"text":"yields a session-local identity instead of a crash. Adopters do not need to","type":"text"},{"text":" ","type":"text"},{"text":"detect XCTest and swap in a different store.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Adding a ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" entry has a cost worth weighing: it makes the","type":"text"},{"text":" ","type":"text"},{"text":"app require a provisioning profile for any signed build, which breaks ad-hoc and","type":"text"},{"text":" ","type":"text"},{"text":"local unsigned builds that otherwise run fine. Add it because you want the access","type":"text"},{"text":" ","type":"text"},{"text":"group, not to silence −34018.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Encryption, accessibility, iCloud-sync exclusion, and backup exclusion are","type":"text"},{"text":" ","type":"text"},{"text":"identical whichever entitlement you use — the access group only controls","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"which of your own apps","type":"text"}],"type":"emphasis"},{"text":" can read an item, never third parties or the cloud.","type":"text"},{"text":" ","type":"text"},{"text":"For a private device ID, in order of strictness:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Most private:"}],"type":"strong"},{"text":" profile-signed build + ","type":"text"},{"code":"accessGroup: nil","type":"codeVoice"},{"text":", relying on the","type":"text"},{"text":" ","type":"text"},{"text":"implicit ","type":"text"},{"code":"application-identifier","type":"codeVoice"},{"text":" group. No other app — even same-team —","type":"text"},{"type":"text","text":" "},{"text":"can be entitled to it. Mirrors the iOS default; zero sharing surface.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Practically equivalent:"}],"type":"strong"},{"text":" a ","type":"text"},{"type":"codeVoice","code":"keychain-access-groups"},{"text":" array whose only","type":"text"},{"text":" ","type":"text"},{"text":"entry is the team-prefixed bundle id (the snippet above). Use when a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"profile-signed build isn’t available (unsigned local \/ CI dev). Only delta:"},{"type":"text","text":" "},{"type":"text","text":"a same-team app you sign could also declare that string."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Intentional sharing only:","type":"text"}]},{"type":"text","text":" a shared group string. The "},{"type":"emphasis","inlineContent":[{"text":"first","type":"text"}]},{"type":"text","text":" element"},{"type":"text","text":" "},{"type":"text","text":"becomes the default group for new items — never put a shared group first"},{"type":"text","text":" "},{"type":"text","text":"for private data."}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Device-Identity Pattern","type":"heading","level":2,"anchor":"Device-Identity-Pattern"},{"inlineContent":[{"text":"The original motivation for ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true,"type":"reference"},{"text":" was apps without user","type":"text"},{"text":" ","type":"text"},{"text":"auth that still want stable identity for analytics. Mint a UUID once with the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)","isActive":true,"type":"reference"},{"text":" helper, hydrate into ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" at launch,","type":"text"},{"text":" ","type":"text"},{"text":"and feed it to ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":". The ","type":"text"},{"inlineContent":[{"type":"text","text":"same"}],"type":"emphasis"},{"text":" ","type":"text"},{"code":"deviceID","type":"codeVoice"},{"text":" is also the stable","type":"text"},{"text":" ","type":"text"},{"text":"feature-flag bucketing identity (the plugin’s ","type":"text"},{"code":"deviceIDKeyPath","type":"codeVoice"},{"text":"), so analytics","type":"text"},{"text":" ","type":"text"},{"text":"and A\/B exposure share one identity:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ `KVKey.deviceID` and `deviceIdentity()` ship with Swidux.","","\/\/ In Store.configured(), before constructing the store:","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.deviceIdentity()   \/\/ reads, or mints-and-persists, a stable UUID","","let initialState = AppState(deviceID: deviceID, \/* … *\/)"]},{"inlineContent":[{"text":"Then in the analytics plugin wiring:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["AnalyticsPlugin(","    service: analytics,","    identity: AnalyticsIdentity(userID: \\.deviceID, properties: { _ in [:] }),","    \/\/ …",")"]},{"inlineContent":[{"text":"The closure-based ","type":"text"},{"code":"userID","type":"codeVoice"},{"text":" keypath runs on every dispatch, so the value","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"must"}],"type":"strong"},{"text":" live in state — never call into the Keychain from the closure. Hydrate","type":"text"},{"text":" ","type":"text"},{"text":"once; observe state.","type":"text"}],"type":"paragraph"},{"text":"Type-safe Keys","type":"heading","level":2,"anchor":"Type-safe-Keys"},{"inlineContent":[{"text":"Declare each key once on ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true,"type":"reference"},{"text":" so the value type travels with the name —","type":"text"},{"text":" ","type":"text"},{"text":"no magic strings at call sites:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"]},{"inlineContent":[{"text":"Then read and write through static-member literals. The compiler enforces","type":"text"},{"text":" ","type":"text"},{"text":"that the value type matches what you declared:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"]},{"inlineContent":[{"text":"A typo or wrong type produces a compile error, not a silent miss at runtime.","type":"text"},{"text":" ","type":"text"},{"text":"Centralizing keys on ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true,"type":"reference"},{"text":" also gives you autocomplete and a single place","type":"text"},{"text":" ","type":"text"},{"text":"to audit your preference surface.","type":"text"}],"type":"paragraph"},{"text":"Wiring","type":"heading","level":2,"anchor":"Wiring"},{"text":"1. Add to your environment","type":"heading","level":3,"anchor":"1-Add-to-your-environment"},{"type":"codeListing","syntax":"swift","code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"]},{"text":"2. Hydrate at startup","type":"heading","level":3,"anchor":"2-Hydrate-at-startup"},{"inlineContent":[{"text":"Read once into the initial state — never read mid-cycle from a reducer.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"]},{"text":"3. Write from an effect","type":"heading","level":3,"anchor":"3-Write-from-an-effect"},{"inlineContent":[{"text":"Mutate state in the reducer, return an effect that writes the value:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"]},{"inlineContent":[{"text":"No ","type":"text"},{"code":"try?","type":"codeVoice"},{"text":", no ","type":"text"},{"code":"do\/catch","type":"codeVoice"},{"text":". ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","isActive":true,"type":"reference"},{"text":" does not throw —","type":"text"},{"text":" ","type":"text"},{"text":"encoder errors are programmer mistakes (e.g. ","type":"text"},{"code":"Float.nan","type":"codeVoice"},{"text":"), so the store logs","type":"text"},{"text":" ","type":"text"},{"text":"them and triggers ","type":"text"},{"code":"assertionFailure","type":"codeVoice"},{"text":" in DEBUG instead of forcing every effect","type":"text"},{"text":" ","type":"text"},{"text":"to handle an ","type":"text"},{"code":"Error","type":"codeVoice"},{"text":" it can’t act on.","type":"text"}],"type":"paragraph"},{"text":"Testing","type":"heading","level":2,"anchor":"Testing"},{"inlineContent":[{"text":"Inject ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","isActive":true,"type":"reference"},{"text":" and assert against the same instance:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"]},{"inlineContent":[{"text":"Tests touching real ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" should use a fresh per-test suite and tear","type":"text"},{"text":" ","type":"text"},{"text":"it down explicitly:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"]},{"text":"Reads Are For Hydration","type":"heading","level":2,"anchor":"Reads-Are-For-Hydration"},{"name":"Important","style":"important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Reading from "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference","isActive":true},{"type":"text","text":" mid-cycle (inside a reducer) is an"},{"type":"text","text":" "},{"type":"text","text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" construction. After hydration, the value lives in state and"},{"type":"text","text":" "},{"type":"text","text":"downstream code observes state, not the store."}],"type":"paragraph"}]},{"inlineContent":[{"code":"UserDefaults","type":"codeVoice"},{"text":" itself is thread-safe, but a reducer reading while an effect","type":"text"},{"text":" ","type":"text"},{"text":"writes creates ordering ambiguity. Hydrate, observe state, write through","type":"text"},{"text":" ","type":"text"},{"text":"effects — that’s the discipline.","type":"text"}],"type":"paragraph"},{"text":"Failure Modes","type":"heading","level":2,"anchor":"Failure-Modes"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Missing key","type":"text"}]},{"type":"text","text":" — "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)","type":"reference","isActive":true},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":". Provide a"},{"type":"text","text":" "},{"type":"text","text":"default at the call site."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Decode failure","type":"text"}]},{"type":"text","text":" — returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" and logs through "},{"code":"os.Logger","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(subsystem "},{"code":"\"swidux\"","type":"codeVoice"},{"type":"text","text":", category "},{"code":"\"kvstore\"","type":"codeVoice"},{"type":"text","text":"). On startup, behaves identically"},{"type":"text","text":" "},{"type":"text","text":"to first launch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Encode failure","type":"text"}]},{"type":"text","text":" — logged at the same subsystem\/category, then"},{"type":"text","text":" "},{"code":"assertionFailure","type":"codeVoice"},{"type":"text","text":" fires in DEBUG so the bug surfaces during development."},{"type":"text","text":" "},{"type":"text","text":"Production builds log and continue; the in-memory state is unchanged. The"},{"type":"text","text":" "},{"type":"text","text":"API does not throw — there is no useful runtime recovery from inside an"},{"type":"text","text":" "},{"type":"text","text":"effect, and "},{"code":"try?","type":"codeVoice"},{"type":"text","text":" would just hide the problem."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Keychain unreachable","type":"text"}]},{"type":"text","text":" — an unsigned build, a locked device, or a missing"},{"type":"text","text":" "},{"type":"text","text":"entitlement makes "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference","isActive":true},{"type":"text","text":" writes fail for reasons no caller"},{"type":"text","text":" "},{"type":"text","text":"can fix. These log and return "},{"code":"false","type":"codeVoice"},{"type":"text","text":"; they do "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" trap, because a test"},{"type":"text","text":" "},{"type":"text","text":"host built without code signing would otherwise crash on its first write."},{"type":"text","text":" "},{"type":"text","text":"Malformed queries still assert in DEBUG."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"code":"setValue","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"removeValue","type":"codeVoice"},{"text":" return ","type":"text"},{"code":"@discardableResult Bool","type":"codeVoice"},{"text":" — ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" when the","type":"text"},{"text":" ","type":"text"},{"text":"store holds the intended state. Ignore it for ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":", which has no","type":"text"},{"text":" ","type":"text"},{"text":"reachability failure to report; check it for the Keychain wherever a fallback","type":"text"},{"text":" ","type":"text"},{"text":"exists.","type":"text"}],"type":"paragraph"},{"text":"@AppStorage Interop","type":"heading","level":2,"anchor":"AppStorage-Interop"},{"inlineContent":[{"text":"There is none, by design. ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","isActive":true,"type