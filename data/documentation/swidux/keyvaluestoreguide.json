{"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/keyvaluestoreguide"]}],"metadata":{"role":"collectionGroup","title":"KeyValueStore","modules":[{"name":"Swidux"}],"roleHeading":"API Collection"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"},"sections":[],"abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"topicSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KVKey"],"anchor":"Keys","title":"Keys"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"],"anchor":"Protocol","title":"Protocol"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore"],"anchor":"Implementations","title":"Implementations"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference","generated":true,"title":"Reference"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"type":"text","text":" is a small protocol for one-shot scalar values that don’t fit"},{"type":"text","text":" "},{"type":"text","text":"the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" model. Three implementations ship:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","isActive":true,"type":"reference"},{"text":" — production, backed by any ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":" suite"}]}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"},{"text":" — production, backed by the system Keychain (survives reinstall)","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","type":"reference","isActive":true},{"text":" — tests, dictionary-backed, reference semantics","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject through your "},{"code":"Environment","type":"codeVoice"},{"type":"text","text":", hydrate state at startup, and write from"},{"type":"text","text":" "},{"type":"text","text":"effects. Reducers stay pure."}]},{"syntax":"swift","type":"codeListing","code":["public protocol KeyValueStore: Sendable {","    func value<Value>(_ key: KVKey<Value>) -> Value?","    func setValue<Value>(_ value: Value?, for key: KVKey<Value>)","    func removeValue<Value>(for key: KVKey<Value>)","    func contains<Value>(_ key: KVKey<Value>) -> Bool","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All values are JSON-encoded as "},{"code":"Data","type":"codeVoice"},{"type":"text","text":". Reads and writes go through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which pairs a backing-store name with its "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" value type at compile time."}]},{"type":"heading","level":2,"anchor":"When-to-Use-What","text":"When to Use What"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Need","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Use","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Collection of identifiable entities (decks, cards, sessions)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" + ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true,"type":"reference"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Scalar preference (theme, sort order, last-seen version)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"},{"text":" (UserDefaults)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Anonymous device identity that must survive reinstall","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"},{"text":" (Keychain)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Last-known-good entitlement cache (offline pro gate)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"},{"text":" (Keychain) — backs ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"code":"EntityStore","type":"codeVoice"},{"type":"text","text":" is for many-of-a-kind data with change tracking and batched"},{"type":"text","text":" "},{"type":"text","text":"writes. "},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":" is for one-of-a-kind values that you read once at"},{"type":"text","text":" "},{"type":"text","text":"startup and overwrite on change."}]},{"type":"heading","level":3,"anchor":"UserDefaults-vs-Keychain","text":"UserDefaults vs Keychain"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Survives reinstall?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"No","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes (this-device-only by default)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Backup \/ device migration","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Included","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Excluded with default accessibility","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Throughput","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Fast (in-memory cache)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Slower (system call)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Visible to other apps?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"No (per app\/group)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Optionally (App Groups via ","type":"text"},{"code":"accessGroup:","type":"codeVoice"},{"text":")","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Best for","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Theme, sort order, feature toggles, last-seen version","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Anonymous device ID, opaque tokens, last-known-good entitlement","type":"text"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Keychain costs more per access — hydrate once at launch and observe state"},{"type":"text","text":" "},{"type":"text","text":"afterward, never read inside a reducer."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefer the Keychain for anything a user could gain by forging it. A"},{"type":"text","text":" "},{"type":"text","text":"last-known-good entitlement cache is the clearest case: it grants pro offline,"},{"type":"text","text":" "},{"type":"text","text":"so a "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":" plist (editable directly or via a doctored-backup restore)"},{"type":"text","text":" "},{"type":"text","text":"lets a spoofed value unlock the app. "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"persists that cache through an injected "},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":", so back it with the"},{"type":"text","text":" "},{"type":"text","text":"Keychain."}]},{"type":"heading","level":3,"anchor":"macOS-sandbox--entitlements","text":"macOS sandbox & entitlements"},{"type":"paragraph","inlineContent":[{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" uses the data-protection keychain, so it never raises"},{"type":"text","text":" "},{"type":"text","text":"a user prompt — no “Always Allow \/ Deny” dialog, no locked-keychain prompt, no"},{"type":"text","text":" "},{"type":"text","text":"Touch ID \/ Face ID challenge."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"sandboxed","type":"text"}]},{"text":" macOS app still needs a keychain entitlement, even when","type":"text"},{"text":" ","type":"text"},{"text":"not sharing items across an access group. Xcode supplies an","type":"text"},{"text":" ","type":"text"},{"code":"application-identifier","type":"codeVoice"},{"text":" automatically for provisioning-profile–signed","type":"text"},{"text":" ","type":"text"},{"text":"builds; otherwise add an explicit ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" entry:","type":"text"}]},{"code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"],"type":"codeListing","syntax":"xml"},{"type":"paragraph","inlineContent":[{"text":"Without it, the first ","type":"text"},{"code":"setValue","type":"codeVoice"},{"text":" fails with ","type":"text"},{"code":"errSecMissingEntitlement","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"OSStatus","type":"codeVoice"},{"text":" −34018). This is a build\/signing condition, not a runtime","type":"text"},{"text":" ","type":"text"},{"text":"prompt. iOS \/ iPadOS \/ tvOS \/ watchOS need no extra entitlement.","type":"text"}]}],"type":"aside","style":"tip","name":"Tip"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Encryption, accessibility, iCloud-sync exclusion, and backup exclusion are"},{"type":"text","text":" "},{"type":"text","text":"identical whichever entitlement you use — the access group only controls"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"which of your own apps","type":"text"}]},{"type":"text","text":" can read an item, never third parties or the cloud."},{"type":"text","text":" "},{"type":"text","text":"For a private device ID, in order of strictness:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Most private:","type":"text"}],"type":"strong"},{"text":" profile-signed build + ","type":"text"},{"code":"accessGroup: nil","type":"codeVoice"},{"text":", relying on the","type":"text"},{"text":" ","type":"text"},{"text":"implicit ","type":"text"},{"code":"application-identifier","type":"codeVoice"},{"text":" group. No other app — even same-team —","type":"text"},{"text":" ","type":"text"},{"text":"can be entitled to it. Mirrors the iOS default; zero sharing surface.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Practically equivalent:","type":"text"}],"type":"strong"},{"text":" a ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" array whose only","type":"text"},{"text":" ","type":"text"},{"text":"entry is the team-prefixed bundle id (the snippet above). Use when a","type":"text"},{"text":" ","type":"text"},{"text":"profile-signed build isn’t available (unsigned local \/ CI dev). Only delta:","type":"text"},{"text":" ","type":"text"},{"text":"a same-team app you sign could also declare that string.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Intentional sharing only:","type":"text"}],"type":"strong"},{"text":" a shared group string. The ","type":"text"},{"inlineContent":[{"text":"first","type":"text"}],"type":"emphasis"},{"text":" element","type":"text"},{"text":" ","type":"text"},{"text":"becomes the default group for new items — never put a shared group first","type":"text"},{"text":" ","type":"text"},{"text":"for private data.","type":"text"}]}]}]},{"type":"heading","level":2,"anchor":"Device-Identity-Pattern","text":"Device-Identity Pattern"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The original motivation for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"},{"type":"text","text":" was apps without user"},{"type":"text","text":" "},{"type":"text","text":"auth that still want stable identity for analytics. Mint a UUID once with the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)"},{"type":"text","text":" helper, hydrate into "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":" at launch,"},{"type":"text","text":" "},{"type":"text","text":"and feed it to "},{"code":"AnalyticsIdentity","type":"codeVoice"},{"type":"text","text":". The "},{"type":"emphasis","inlineContent":[{"text":"same","type":"text"}]},{"type":"text","text":" "},{"code":"deviceID","type":"codeVoice"},{"type":"text","text":" is also the stable"},{"text":" ","type":"text"},{"text":"feature-flag bucketing identity (the plugin’s ","type":"text"},{"code":"deviceIDKeyPath","type":"codeVoice"},{"type":"text","text":"), so analytics"},{"type":"text","text":" "},{"type":"text","text":"and A\/B exposure share one identity:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ `KVKey.deviceID` and `deviceIdentity()` ship with Swidux.","","\/\/ In Store.configured(), before constructing the store:","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.deviceIdentity()   \/\/ reads, or mints-and-persists, a stable UUID","","let initialState = AppState(deviceID: deviceID, \/* … *\/)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then in the analytics plugin wiring:"}]},{"syntax":"swift","type":"codeListing","code":["AnalyticsPlugin(","    service: analytics,","    identity: AnalyticsIdentity(userID: \\.deviceID, properties: { _ in [:] }),","    \/\/ …",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The closure-based "},{"code":"userID","type":"codeVoice"},{"type":"text","text":" keypath runs on every dispatch, so the value"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"must","type":"text"}]},{"type":"text","text":" live in state — never call into the Keychain from the closure. Hydrate"},{"type":"text","text":" "},{"type":"text","text":"once; observe state."}]},{"type":"heading","level":2,"anchor":"Type-safe-Keys","text":"Type-safe Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare each key once on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey"},{"type":"text","text":" so the value type travels with the name —"},{"type":"text","text":" "},{"type":"text","text":"no magic strings at call sites:"}]},{"syntax":"swift","type":"codeListing","code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"]},{"type":"paragraph","inlineContent":[{"text":"Then read and write through static-member literals. The compiler enforces","type":"text"},{"text":" ","type":"text"},{"text":"that the value type matches what you declared:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"]},{"type":"paragraph","inlineContent":[{"text":"A typo or wrong type produces a compile error, not a silent miss at runtime.","type":"text"},{"text":" ","type":"text"},{"text":"Centralizing keys on ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference"},{"text":" also gives you autocomplete and a single place","type":"text"},{"text":" ","type":"text"},{"text":"to audit your preference surface.","type":"text"}]},{"type":"heading","level":2,"anchor":"Wiring","text":"Wiring"},{"type":"heading","level":3,"anchor":"1-Add-to-your-environment","text":"1. Add to your environment"},{"syntax":"swift","type":"codeListing","code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"]},{"text":"2. Hydrate at startup","type":"heading","level":3,"anchor":"2-Hydrate-at-startup"},{"type":"paragraph","inlineContent":[{"text":"Read once into the initial state — never read mid-cycle from a reducer.","type":"text"}]},{"code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"],"syntax":"swift","type":"codeListing"},{"text":"3. Write from an effect","type":"heading","level":3,"anchor":"3-Write-from-an-effect"},{"type":"paragraph","inlineContent":[{"text":"Mutate state in the reducer, return an effect that writes the value:","type":"text"}]},{"code":["case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"No ","type":"text"},{"code":"try?","type":"codeVoice"},{"text":", no ","type":"text"},{"type":"codeVoice","code":"do\/catch"},{"text":". ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","isActive":true},{"type":"text","text":" does not throw —"},{"text":" ","type":"text"},{"text":"encoder errors are programmer mistakes (e.g. ","type":"text"},{"code":"Float.nan","type":"codeVoice"},{"type":"text","text":"), so the store logs"},{"type":"text","text":" "},{"type":"text","text":"them and triggers "},{"code":"assertionFailure","type":"codeVoice"},{"type":"text","text":" in DEBUG instead of forcing every effect"},{"text":" ","type":"text"},{"type":"text","text":"to handle an "},{"code":"Error","type":"codeVoice"},{"type":"text","text":" it can’t act on."}]},{"text":"Testing","type":"heading","level":2,"anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore"},{"text":" and assert against the same instance:","type":"text"}]},{"code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Tests touching real ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":" should use a fresh per-test suite and tear"},{"type":"text","text":" "},{"type":"text","text":"it down explicitly:"}],"type":"paragraph"},{"code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"],"type":"codeListing","syntax":"swift"},{"text":"Reads Are For Hydration","level":2,"anchor":"Reads-Are-For-Hydration","type":"heading"},{"name":"Important","type":"aside","style":"important","content":[{"inlineContent":[{"text":"Reading from ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference","isActive":true},{"text":" mid-cycle (inside a reducer) is an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at"},{"text":" ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" construction. After hydration, the value lives in state and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"downstream code observes state, not the store."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"code":"UserDefaults","type":"codeVoice"},{"text":" itself is thread-safe, but a reducer reading while an effect","type":"text"},{"text":" ","type":"text"},{"text":"writes creates ordering ambiguity. Hydrate, observe state, write through","type":"text"},{"text":" ","type":"text"},{"text":"effects — that’s the discipline.","type":"text"}]},{"text":"Failure Modes","level":2,"anchor":"Failure-Modes","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Missing key"}],"type":"strong"},{"type":"text","text":" — "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)","isActive":true},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":". Provide a","type":"text"},{"type":"text","text":" "},{"text":"default at the call site.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Decode failure"}]},{"type":"text","text":" — returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and logs through "},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":" "},{"type":"text","text":"(subsystem "},{"type":"codeVoice","code":"\"swidux\""},{"type":"text","text":", category "},{"type":"codeVoice","code":"\"kvstore\""},{"text":"). On startup, behaves identically","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to first launch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Encode failure","type":"text"}]},{"type":"text","text":" — logged at the same subsystem\/category, then"},{"type":"text","text":" "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":" fires in DEBUG so the bug surfaces during development."},{"type":"text","text":" "},{"text":"Production builds log and continue; the in-memory state is unchanged. The","type":"text"},{"text":" ","type":"text"},{"text":"API does not throw — there is no useful runtime recovery from inside an","type":"text"},{"text":" ","type":"text"},{"text":"effect, and ","type":"text"},{"code":"try?","type":"codeVoice"},{"text":" would just hide the problem.","type":"text"}],"type":"paragraph"}]}]},{"text":"@AppStorage Interop","anchor":"AppStorage-Interop","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"There is none, by design. ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference","isActive":true},{"text":" writes JSON-encoded","type":"text"},{"text":" ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" blobs. SwiftUI’s ","type":"text"},{"code":"@AppStorage","type":"codeVoice"},{"text":" only observes native primitive types","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"String","