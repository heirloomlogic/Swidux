{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true},{"type":"text","text":" is a small protocol for one-shot scalar values that don’t fit"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" model. Three implementations ship:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","isActive":true},{"type":"text","text":" — production, backed by any "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" suite"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true},{"type":"text","text":" — production, backed by the system Keychain (survives reinstall)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","isActive":true},{"type":"text","text":" — tests, dictionary-backed, reference semantics"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Inject through your "},{"type":"codeVoice","code":"Environment"},{"type":"text","text":", hydrate state at startup, and write from"},{"type":"text","text":" "},{"type":"text","text":"effects. Reducers stay pure."}],"type":"paragraph"},{"code":["public protocol KeyValueStore: Sendable {","    func value<Value>(_ key: KVKey<Value>) -> Value?","    func setValue<Value>(_ value: Value?, for key: KVKey<Value>)","    func removeValue<Value>(for key: KVKey<Value>)","    func contains<Value>(_ key: KVKey<Value>) -> Bool","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"All values are JSON-encoded as ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":". Reads and writes go through ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true},{"text":",","type":"text"},{"type":"text","text":" "},{"type":"text","text":"which pairs a backing-store name with its "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" value type at compile time."}],"type":"paragraph"},{"text":"When to Use What","anchor":"When-to-Use-What","level":2,"type":"heading"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Need"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Collection of identifiable entities (decks, cards, sessions)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" + "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Scalar preference (theme, sort order, last-seen version)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference"},{"type":"text","text":" (UserDefaults)"}]}]],[[{"inlineContent":[{"type":"text","text":"Anonymous device identity that must survive reinstall"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true},{"type":"text","text":" (Keychain)"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"code":"EntityStore","type":"codeVoice"},{"text":" is for many-of-a-kind data with change tracking and batched","type":"text"},{"text":" ","type":"text"},{"text":"writes. ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":" is for one-of-a-kind values that you read once at","type":"text"},{"text":" ","type":"text"},{"text":"startup and overwrite on change.","type":"text"}],"type":"paragraph"},{"text":"UserDefaults vs Keychain","anchor":"UserDefaults-vs-Keychain","level":3,"type":"heading"},{"rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Survives reinstall?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes (this-device-only by default)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Backup \/ device migration"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Included"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Excluded with default accessibility","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Throughput","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Fast (in-memory cache)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Slower (system call)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Visible to other apps?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No (per app\/group)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Optionally (App Groups via ","type":"text"},{"code":"accessGroup:","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Best for","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Theme, sort order, feature toggles, last-seen version"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Anonymous device ID, opaque tokens","type":"text"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"The Keychain costs more per access — hydrate once at launch and observe state"},{"type":"text","text":" "},{"type":"text","text":"afterward, never read inside a reducer."}],"type":"paragraph"},{"text":"macOS sandbox & entitlements","anchor":"macOS-sandbox--entitlements","level":3,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" uses the data-protection keychain, so it never raises"},{"type":"text","text":" "},{"type":"text","text":"a user prompt — no “Always Allow \/ Deny” dialog, no locked-keychain prompt, no"},{"type":"text","text":" "},{"type":"text","text":"Touch ID \/ Face ID challenge."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"type":"text","text":"sandboxed"}],"type":"emphasis"},{"text":" macOS app still needs a keychain entitlement, even when","type":"text"},{"text":" ","type":"text"},{"text":"not sharing items across an access group. Xcode supplies an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"application-identifier"},{"text":" automatically for provisioning-profile–signed","type":"text"},{"text":" ","type":"text"},{"text":"builds; otherwise add an explicit ","type":"text"},{"type":"codeVoice","code":"keychain-access-groups"},{"text":" entry:","type":"text"}]},{"type":"codeListing","syntax":"xml","code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"]},{"type":"paragraph","inlineContent":[{"text":"Without it, the first ","type":"text"},{"type":"codeVoice","code":"setValue"},{"text":" fails with ","type":"text"},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"OSStatus"},{"text":" −34018). This is a build\/signing condition, not a runtime","type":"text"},{"text":" ","type":"text"},{"text":"prompt. iOS \/ iPadOS \/ tvOS \/ watchOS need no extra entitlement.","type":"text"}]}],"style":"tip","name":"Tip","type":"aside"},{"inlineContent":[{"type":"text","text":"Encryption, accessibility, iCloud-sync exclusion, and backup exclusion are"},{"type":"text","text":" "},{"type":"text","text":"identical whichever entitlement you use — the access group only controls"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"which of your own apps","type":"text"}]},{"type":"text","text":" can read an item, never third parties or the cloud."},{"type":"text","text":" "},{"type":"text","text":"For a private device ID, in order of strictness:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Most private:"}]},{"text":" profile-signed build + ","type":"text"},{"type":"codeVoice","code":"accessGroup: nil"},{"text":", relying on the","type":"text"},{"text":" ","type":"text"},{"text":"implicit ","type":"text"},{"type":"codeVoice","code":"application-identifier"},{"text":" group. No other app — even same-team —","type":"text"},{"text":" ","type":"text"},{"text":"can be entitled to it. Mirrors the iOS default; zero sharing surface.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Practically equivalent:"}],"type":"strong"},{"text":" a ","type":"text"},{"type":"codeVoice","code":"keychain-access-groups"},{"text":" array whose only","type":"text"},{"text":" ","type":"text"},{"text":"entry is the team-prefixed bundle id (the snippet above). Use when a","type":"text"},{"text":" ","type":"text"},{"text":"profile-signed build isn’t available (unsigned local \/ CI dev). Only delta:","type":"text"},{"text":" ","type":"text"},{"text":"a same-team app you sign could also declare that string.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Intentional sharing only:"}]},{"type":"text","text":" a shared group string. The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"first"}]},{"type":"text","text":" element"},{"type":"text","text":" "},{"type":"text","text":"becomes the default group for new items — never put a shared group first"},{"type":"text","text":" "},{"type":"text","text":"for private data."}]}]}],"type":"orderedList"},{"type":"heading","text":"Device-Identity Pattern","anchor":"Device-Identity-Pattern","level":2},{"inlineContent":[{"text":"The original motivation for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference"},{"text":" was apps without user","type":"text"},{"type":"text","text":" "},{"type":"text","text":"auth that still want stable identity for analytics. Stash a UUID once, hydrate"},{"type":"text","text":" "},{"type":"text","text":"into "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":" at launch, feed it to "},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["extension KVKey where Value == String {","    static let deviceID = KVKey<String>(\"device-id\")","}","","\/\/ In Store.configured(), before constructing the store:","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.value(.deviceID) ?? {","    let new = UUID().uuidString","    kv.setValue(new, for: .deviceID)","    return new","}()","","let initialState = AppState(deviceID: deviceID, \/* … *\/)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Then in the analytics plugin wiring:","type":"text"}],"type":"paragraph"},{"code":["AnalyticsPlugin(","    service: analytics,","    identity: AnalyticsIdentity(userID: \\.deviceID, properties: { _ in [:] }),","    \/\/ …",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The closure-based ","type":"text"},{"code":"userID","type":"codeVoice"},{"type":"text","text":" keypath runs on every dispatch, so the value"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"must"}]},{"type":"text","text":" live in state — never call into the Keychain from the closure. Hydrate"},{"type":"text","text":" "},{"type":"text","text":"once; observe state."}],"type":"paragraph"},{"type":"heading","text":"Type-safe Keys","anchor":"Type-safe-Keys","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare each key once on "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference"},{"text":" so the value type travels with the name —","type":"text"},{"text":" ","type":"text"},{"text":"no magic strings at call sites:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"]},{"inlineContent":[{"text":"Then read and write through static-member literals. The compiler enforces","type":"text"},{"text":" ","type":"text"},{"text":"that the value type matches what you declared:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"],"type":"codeListing"},{"inlineContent":[{"text":"A typo or wrong type produces a compile error, not a silent miss at runtime.","type":"text"},{"text":" ","type":"text"},{"text":"Centralizing keys on ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey"},{"text":" also gives you autocomplete and a single place","type":"text"},{"text":" ","type":"text"},{"text":"to audit your preference surface.","type":"text"}],"type":"paragraph"},{"text":"Wiring","anchor":"Wiring","level":2,"type":"heading"},{"text":"1. Add to your environment","anchor":"1-Add-to-your-environment","level":3,"type":"heading"},{"code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"2. Hydrate at startup","anchor":"2-Hydrate-at-startup","level":3,"type":"heading"},{"inlineContent":[{"text":"Read once into the initial state — never read mid-cycle from a reducer.","type":"text"}],"type":"paragraph"},{"code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"],"syntax":"swift","type":"codeListing"},{"text":"3. Write from an effect","anchor":"3-Write-from-an-effect","level":3,"type":"heading"},{"inlineContent":[{"text":"Mutate state in the reducer, return an effect that writes the value:","type":"text"}],"type":"paragraph"},{"code":["case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"No ","type":"text"},{"code":"try?","type":"codeVoice"},{"text":", no ","type":"text"},{"code":"do\/catch","type":"codeVoice"},{"text":". ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","type":"reference"},{"text":" does not throw —","type":"text"},{"text":" ","type":"text"},{"text":"encoder errors are programmer mistakes (e.g. ","type":"text"},{"code":"Float.nan","type":"codeVoice"},{"text":"), so the store logs","type":"text"},{"text":" ","type":"text"},{"text":"them and triggers ","type":"text"},{"code":"assertionFailure","type":"codeVoice"},{"text":" in DEBUG instead of forcing every effect","type":"text"},{"text":" ","type":"text"},{"text":"to handle an ","type":"text"},{"code":"Error","type":"codeVoice"},{"text":" it can’t act on.","type":"text"}],"type":"paragraph"},{"text":"Testing","anchor":"Testing","level":2,"type":"heading"},{"inlineContent":[{"text":"Inject ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","type":"reference"},{"text":" and assert against the same instance:","type":"text"}],"type":"paragraph"},{"code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Tests touching real ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" should use a fresh per-test suite and tear","type":"text"},{"text":" ","type":"text"},{"text":"it down explicitly:","type":"text"}],"type":"paragraph"},{"code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"],"syntax":"swift","type":"codeListing"},{"text":"Reads Are For Hydration","anchor":"Reads-Are-For-Hydration","level":2,"type":"heading"},{"content":[{"inlineContent":[{"text":"Reading from ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"text":" mid-cycle (inside a reducer) is an","type":"text"},{"text":" ","type":"text"},{"text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" construction. After hydration, the value lives in state and","type":"text"},{"text":" ","type":"text"},{"text":"downstream code observes state, not the store.","type":"text"}],"type":"paragraph"}],"style":"important","name":"Important","type":"aside"},{"inlineContent":[{"code":"UserDefaults","type":"codeVoice"},{"text":" itself is thread-safe, but a reducer reading while an effect","type":"text"},{"text":" ","type":"text"},{"text":"writes creates ordering ambiguity. Hydrate, observe state, write through","type":"text"},{"text":" ","type":"text"},{"text":"effects — that’s the discipline.","type":"text"}],"type":"paragraph"},{"text":"Failure Modes","anchor":"Failure-Modes","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Missing key"}]},{"type":"text","text":" — "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)"},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":". Provide a"},{"type":"text","text":" "},{"type":"text","text":"default at the call site."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Decode failure"}]},{"type":"text","text":" — returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" and logs through "},{"code":"os.Logger","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"(subsystem "},{"code":"\"swidux\"","type":"codeVoice"},{"type":"text","text":", category "},{"code":"\"kvstore\"","type":"codeVoice"},{"type":"text","text":"). On startup, behaves identically"},{"type":"text","text":" "},{"type":"text","text":"to first launch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Encode failure"}]},{"type":"text","text":" — logged at the same subsystem\/category, then"},{"type":"text","text":" "},{"code":"assertionFailure","type":"codeVoice"},{"type":"text","text":" fires in DEBUG so the bug surfaces during development."},{"type":"text","text":" "},{"type":"text","text":"Production builds log and continue; the in-memory state is unchanged. The"},{"type":"text","text":" "},{"type":"text","text":"API does not throw — there is no useful runtime recovery from inside an"},{"type":"text","text":" "},{"type":"text","text":"effect, and "},{"code":"try?","type":"codeVoice"},{"type":"text","text":" would just hide the problem."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"@AppStorage Interop","anchor":"AppStorage-Interop","level":2,"type":"heading"},{"inlineContent":[{"text":"There is none, by design. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference"},{"text":" writes JSON-encoded","type":"text"},{"text":" ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" blobs. SwiftUI’s ","type":"text"},{"code":"@AppStorage","type":"codeVoice"},{"text":" only observes native primitive types","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":", ","type":"text"},{"code":"URL","type":"codeVoice"},{"text":", raw ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":"). Two parallel","type":"text"},{"text":" ","type":"text"},{"text":"observation channels — Swidux state and ","type":"text"},{"code":"@AppStorage","type":"codeVoice"},{"text":" — would drift.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Swidux state is the source of truth. Read once at hydration, then observe","type":"text"},{"text":" ","type":"text"},{"text":"state through the store.","type":"text"}],"type":"paragraph"},{"text":"Schema Migration","anchor":"Schema-Migration","level":2,"type":"heading"},{"inlineContent":[{"text":"Out of scope for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference"},{"text":". If a ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" shape changes","type":"text"},{"text":" ","type":"text"},{"text":"incompatibly, declare a new versioned key:","type":"text"}],"type":"paragraph"},{"code":["\/\/ before:","extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","\/\/ after a breaking shape change:","extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme.v2\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Old keys can be cleaned up at startup with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/removeValue(for:)","type":"reference"},{"text":" ","type":"text"},{