{"sections":[],"abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true},{"type":"text","text":" is a small protocol for one-shot scalar values that don’t fit"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" model. Three implementations ship:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference"},{"text":" — production, backed by any ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"text":" suite","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference"},{"text":" — production, backed by the system Keychain (survives reinstall)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","type":"reference"},{"text":" — tests, dictionary-backed, reference semantics","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Inject through your "},{"type":"codeVoice","code":"Environment"},{"type":"text","text":", hydrate state at startup, and write from"},{"type":"text","text":" "},{"type":"text","text":"effects. Reducers stay pure."}],"type":"paragraph"},{"code":["public protocol KeyValueStore: Sendable {","    func value<Value>(_ key: KVKey<Value>) -> Value?","    func setValue<Value>(_ value: Value?, for key: KVKey<Value>)","    func removeValue<Value>(for key: KVKey<Value>)","    func contains<Value>(_ key: KVKey<Value>) -> Bool","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"All values are JSON-encoded as "},{"type":"codeVoice","code":"Data"},{"type":"text","text":". Reads and writes go through "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which pairs a backing-store name with its "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" value type at compile time."}],"type":"paragraph"},{"anchor":"When-to-Use-What","text":"When to Use What","type":"heading","level":2},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Need"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Collection of identifiable entities (decks, cards, sessions)"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" + "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Scalar preference (theme, sort order, last-seen version)"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true},{"type":"text","text":" (UserDefaults)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Anonymous device identity that must survive reinstall"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true},{"type":"text","text":" (Keychain)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Last-known-good entitlement cache (offline pro gate)"}]}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true},{"type":"text","text":" (Keychain) — backs "},{"type":"codeVoice","code":"ResilientPaywallService"}]}]]],"type":"table"},{"inlineContent":[{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":" is for many-of-a-kind data with change tracking and batched"},{"type":"text","text":" "},{"type":"text","text":"writes. "},{"type":"codeVoice","code":"KeyValueStore"},{"type":"text","text":" is for one-of-a-kind values that you read once at"},{"type":"text","text":" "},{"type":"text","text":"startup and overwrite on change."}],"type":"paragraph"},{"type":"heading","level":3,"text":"UserDefaults vs Keychain","anchor":"UserDefaults-vs-Keychain"},{"type":"table","rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Survives reinstall?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"No","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes (this-device-only by default)","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"Backup \/ device migration"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Included"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Excluded with default accessibility"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"Throughput","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Fast (in-memory cache)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Slower (system call)","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"Visible to other apps?"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No (per app\/group)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Optionally (App Groups via ","type":"text"},{"code":"accessGroup:","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Best for"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Theme, sort order, feature toggles, last-seen version"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Anonymous device ID, opaque tokens, last-known-good entitlement","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Keychain costs more per access — hydrate once at launch and observe state"},{"type":"text","text":" "},{"type":"text","text":"afterward, never read inside a reducer."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefer the Keychain for anything a user could gain by forging it. A"},{"type":"text","text":" "},{"type":"text","text":"last-known-good entitlement cache is the clearest case: it grants pro offline,"},{"type":"text","text":" "},{"type":"text","text":"so a "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" plist (editable directly or via a doctored-backup restore)"},{"type":"text","text":" "},{"type":"text","text":"lets a spoofed value unlock the app. "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" "},{"type":"text","text":"persists that cache through an injected "},{"type":"codeVoice","code":"KeyValueStore"},{"type":"text","text":", so back it with the"},{"type":"text","text":" "},{"type":"text","text":"Keychain."}]},{"type":"heading","level":3,"text":"macOS sandbox & entitlements","anchor":"macOS-sandbox--entitlements"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" uses the data-protection keychain, so it never raises"},{"type":"text","text":" "},{"type":"text","text":"a user prompt — no “Always Allow \/ Deny” dialog, no locked-keychain prompt, no"},{"type":"text","text":" "},{"type":"text","text":"Touch ID \/ Face ID challenge."}]},{"type":"aside","style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"text":"sandboxed","type":"text"}],"type":"emphasis"},{"text":" macOS app still needs a keychain entitlement, even when","type":"text"},{"text":" ","type":"text"},{"text":"not sharing items across an access group. Xcode supplies an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"application-identifier"},{"text":" automatically for provisioning-profile–signed","type":"text"},{"text":" ","type":"text"},{"text":"builds; otherwise add an explicit ","type":"text"},{"type":"codeVoice","code":"keychain-access-groups"},{"text":" entry:","type":"text"}]},{"type":"codeListing","syntax":"xml","code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"]},{"type":"paragraph","inlineContent":[{"text":"Without it, the first ","type":"text"},{"type":"codeVoice","code":"setValue"},{"text":" fails with ","type":"text"},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"type":"codeVoice","code":"OSStatus"},{"text":" −34018). This is a build\/signing condition, not a runtime","type":"text"},{"text":" ","type":"text"},{"text":"prompt. iOS \/ iPadOS \/ tvOS \/ watchOS need no extra entitlement.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Encryption, accessibility, iCloud-sync exclusion, and backup exclusion are"},{"type":"text","text":" "},{"type":"text","text":"identical whichever entitlement you use — the access group only controls"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"which of your own apps","type":"text"}]},{"type":"text","text":" can read an item, never third parties or the cloud."},{"type":"text","text":" "},{"type":"text","text":"For a private device ID, in order of strictness:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Most private:"}],"type":"strong"},{"text":" profile-signed build + ","type":"text"},{"code":"accessGroup: nil","type":"codeVoice"},{"text":", relying on the","type":"text"},{"text":" ","type":"text"},{"text":"implicit ","type":"text"},{"code":"application-identifier","type":"codeVoice"},{"text":" group. No other app — even same-team —","type":"text"},{"text":" ","type":"text"},{"text":"can be entitled to it. Mirrors the iOS default; zero sharing surface.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Practically equivalent:"}],"type":"strong"},{"text":" a ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"type":"text","text":" array whose only"},{"text":" ","type":"text"},{"text":"entry is the team-prefixed bundle id (the snippet above). Use when a","type":"text"},{"text":" ","type":"text"},{"text":"profile-signed build isn’t available (unsigned local \/ CI dev). Only delta:","type":"text"},{"type":"text","text":" "},{"text":"a same-team app you sign could also declare that string.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Intentional sharing only:","type":"text"}],"type":"strong"},{"text":" a shared group string. The ","type":"text"},{"inlineContent":[{"type":"text","text":"first"}],"type":"emphasis"},{"text":" element","type":"text"},{"text":" ","type":"text"},{"text":"becomes the default group for new items — never put a shared group first","type":"text"},{"text":" ","type":"text"},{"text":"for private data.","type":"text"}]}]}],"type":"orderedList"},{"type":"heading","level":2,"text":"Device-Identity Pattern","anchor":"Device-Identity-Pattern"},{"type":"paragraph","inlineContent":[{"text":"The original motivation for ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"},{"text":" was apps without user","type":"text"},{"text":" ","type":"text"},{"text":"auth that still want stable identity for analytics. Mint a UUID once with the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)"},{"text":" helper, hydrate into ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" at launch,","type":"text"},{"text":" ","type":"text"},{"text":"and feed it to ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":". The ","type":"text"},{"inlineContent":[{"type":"text","text":"same"}],"type":"emphasis"},{"text":" ","type":"text"},{"code":"deviceID","type":"codeVoice"},{"text":" is also the stable","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"feature-flag bucketing identity (the plugin’s "},{"type":"codeVoice","code":"deviceIDKeyPath"},{"type":"text","text":"), so analytics"},{"type":"text","text":" "},{"type":"text","text":"and A\/B exposure share one identity:"}]},{"code":["\/\/ `KVKey.deviceID` and `deviceIdentity()` ship with Swidux.","","\/\/ In Store.configured(), before constructing the store:","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.deviceIdentity()   \/\/ reads, or mints-and-persists, a stable UUID","","let initialState = AppState(deviceID: deviceID, \/* … *\/)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then in the analytics plugin wiring:"}]},{"code":["AnalyticsPlugin(","    service: analytics,","    identity: AnalyticsIdentity(userID: \\.deviceID, properties: { _ in [:] }),","    \/\/ …",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The closure-based "},{"type":"codeVoice","code":"userID"},{"type":"text","text":" keypath runs on every dispatch, so the value"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"must","type":"text"}]},{"type":"text","text":" live in state — never call into the Keychain from the closure. Hydrate"},{"type":"text","text":" "},{"type":"text","text":"once; observe state."}]},{"type":"heading","level":2,"text":"Type-safe Keys","anchor":"Type-safe-Keys"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare each key once on "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true},{"type":"text","text":" so the value type travels with the name —"},{"type":"text","text":" "},{"type":"text","text":"no magic strings at call sites:"}]},{"code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then read and write through static-member literals. The compiler enforces"},{"type":"text","text":" "},{"type":"text","text":"that the value type matches what you declared:"}]},{"code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typo or wrong type produces a compile error, not a silent miss at runtime."},{"type":"text","text":" "},{"type":"text","text":"Centralizing keys on "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true},{"type":"text","text":" also gives you autocomplete and a single place"},{"type":"text","text":" "},{"type":"text","text":"to audit your preference surface."}]},{"level":2,"text":"Wiring","type":"heading","anchor":"Wiring"},{"level":3,"text":"1. Add to your environment","type":"heading","anchor":"1-Add-to-your-environment"},{"code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"2. Hydrate at startup","type":"heading","anchor":"2-Hydrate-at-startup"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read once into the initial state — never read mid-cycle from a reducer."}]},{"code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"3. Write from an effect","type":"heading","anchor":"3-Write-from-an-effect"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mutate state in the reducer, return an effect that writes the value:"}]},{"code":["case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"try?"},{"type":"text","text":", no "},{"type":"codeVoice","code":"do\/catch"},{"type":"text","text":". "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","isActive":true},{"type":"text","text":" does not throw —"},{"type":"text","text":" "},{"type":"text","text":"encoder errors are programmer mistakes (e.g. "},{"type":"codeVoice","code":"Float.nan"},{"type":"text","text":"), so the store logs"},{"type":"text","text":" "},{"type":"text","text":"them and triggers "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":" in DEBUG instead of forcing every effect"},{"type":"text","text":" "},{"type":"text","text":"to handle an "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" it can’t act on."}]},{"level":2,"text":"Testing","type":"heading","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","isActive":true},{"type":"text","text":" and assert against the same instance:"}]},{"code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tests touching real "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" should use a fresh per-test suite and tear"},{"type":"text","text":" "},{"type":"text","text":"it down explicitly:"}]},{"code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Reads Are For Hydration","type":"heading","anchor":"Reads-Are-For-Hydration"},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reading from "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true},{"type":"text","text":" mid-cycle (inside a reducer) is an"},{"type":"text","text":" "},{"type":"text","text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" construction. After hydration, the value lives in state and"},{"type":"text","text":" "},{"type":"text","text":"downstream code observes state, not the store."}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" itself is thread-safe, but a reducer reading while an effect"},{"type":"text","text":" "},{"type":"text","text":"writes creates ordering ambiguity. Hydrate, observe state, write through"},{"type":"text","text":" "},{"type":"text","text":"effects — that’s the discipline."}]},{"level":2,"text":"Failure Modes","type":"heading","anchor":"Failure-Modes"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Missing key","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". Provide a","type":"text"},{"text":" ","type":"text"},{"text":"default at the call site.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Decode failure","type":"text"}],"type":"strong"},{"text":" — returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" and logs through ","type":"text"},{"code":"os.Logger","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(subsystem ","type":"text"},{"code":"\"swidux\"","type":"codeVoice"},{"text":", category ","type":"text"},{"code":"\"kvstore\"","type":"codeVoice"},{"text":"). On startup, behaves identically","type":"text"},{"text":" ","type":"text"},{"text":"to first launch.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Encode failure","type":"text"}],"type":"strong"},{"text":" — logged at the same subsystem\/category, then","type":"text"},{"text":" ","type":"text"},{"code":"assertionFailure","type":"codeVoice"},{"text":" fires in DEBUG so the bug surfaces during development.","type":"text"},{"text":" ","type":"text"},{"text":"Production builds log and continue; the in-memory state is unchanged. The","type":"text"},{"text":" ","type":"text"},{"text":"API does not throw — there is no useful runtime recovery from inside an","type":"text"},{"text":" ","type":"text"},{"text":"effect, and ","type":"text"},{"code":"try?","type":"codeVoice"},{"text":" would just hide the problem.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"@AppStorage Interop","type":"heading","anchor":"AppStorage-Interop"},{"type":"paragraph","inlineContent":[{"type":"text","text":"There is none, by design. "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","isActive":true},{"type":"text","text":" writes JSON-encoded"},{"type":"text","text":" "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" blobs. SwiftUI’s "},{"type":"codeVoice","code":"@AppStorage"},{"type":"text","text":" only observes native primitive types"},{"type":"text","text"