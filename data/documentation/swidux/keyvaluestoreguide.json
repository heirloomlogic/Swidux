{"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"topicSections":[{"title":"Keys","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KVKey"],"anchor":"Keys"},{"title":"Protocol","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"],"anchor":"Protocol"},{"title":"Implementations","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore"],"anchor":"Implementations"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"},"seeAlsoSections":[{"title":"Reference","generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference"}],"abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"kind":"article","metadata":{"modules":[{"name":"Swidux"}],"role":"collectionGroup","roleHeading":"API Collection","title":"KeyValueStore"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"type":"text","text":" is a small protocol for one-shot scalar values that don’t fit"},{"type":"text","text":" "},{"text":"the ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" model. Three implementations ship:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference"},{"text":" — production, backed by any ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" suite","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true,"type":"reference"},{"type":"text","text":" — production, backed by the system Keychain (survives reinstall)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore"},{"text":" — tests, dictionary-backed, reference semantics","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject through your "},{"code":"Environment","type":"codeVoice"},{"text":", hydrate state at startup, and write from","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"effects. Reducers stay pure."}]},{"code":["public protocol KeyValueStore: Sendable {","    func value<Value>(_ key: KVKey<Value>) -> Value?","    func setValue<Value>(_ value: Value?, for key: KVKey<Value>)","    func removeValue<Value>(for key: KVKey<Value>)","    func contains<Value>(_ key: KVKey<Value>) -> Bool","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All values are JSON-encoded as "},{"code":"Data","type":"codeVoice"},{"type":"text","text":". Reads and writes go through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which pairs a backing-store name with its ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" value type at compile time.","type":"text"}]},{"anchor":"When-to-Use-What","type":"heading","text":"When to Use What","level":2},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Need"}]}],[{"inlineContent":[{"type":"text","text":"Use"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"Collection of identifiable entities (decks, cards, sessions)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":" + "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"}]}]],[[{"inlineContent":[{"type":"text","text":"Scalar preference (theme, sort order, last-seen version)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true},{"type":"text","text":" (UserDefaults)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Anonymous device identity that must survive reinstall"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference"},{"type":"text","text":" (Keychain)"}]}]],[[{"inlineContent":[{"type":"text","text":"Last-known-good entitlement cache (offline pro gate)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"type":"text","text":" (Keychain) — backs "},{"type":"codeVoice","code":"ResilientPaywallService"}],"type":"paragraph"}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"code":"EntityStore","type":"codeVoice"},{"text":" is for many-of-a-kind data with change tracking and batched","type":"text"},{"type":"text","text":" "},{"text":"writes. ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":" is for one-of-a-kind values that you read once at","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"startup and overwrite on change."}]},{"level":3,"text":"UserDefaults vs Keychain","anchor":"UserDefaults-vs-Keychain","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore"}]}],[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Survives reinstall?"}]}],[{"inlineContent":[{"type":"text","text":"No"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes (this-device-only by default)"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Backup \/ device migration"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Included"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Excluded with default accessibility"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Throughput"}]}],[{"inlineContent":[{"type":"text","text":"Fast (in-memory cache)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Slower (system call)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Visible to other apps?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No (per app\/group)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Optionally (App Groups via "},{"code":"accessGroup:","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Best for","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Theme, sort order, feature toggles, last-seen version"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Anonymous device ID, opaque tokens, last-known-good entitlement","type":"text"}]}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Keychain costs more per access — hydrate once at launch and observe state"},{"text":" ","type":"text"},{"text":"afterward, never read inside a reducer.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefer the Keychain for anything a user could gain by forging it. A"},{"type":"text","text":" "},{"text":"last-known-good entitlement cache is the clearest case: it grants pro offline,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"so a "},{"code":"UserDefaults","type":"codeVoice"},{"text":" plist (editable directly or via a doctored-backup restore)","type":"text"},{"text":" ","type":"text"},{"text":"lets a spoofed value unlock the app. ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" ","type":"text"},{"text":"persists that cache through an injected ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":", so back it with the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Keychain."}]},{"type":"heading","anchor":"macOS-sandbox--entitlements","level":3,"text":"macOS sandbox & entitlements"},{"inlineContent":[{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" uses the data-protection keychain, so it never raises"},{"text":" ","type":"text"},{"type":"text","text":"a user prompt — no “Always Allow \/ Deny” dialog, no locked-keychain prompt, no"},{"text":" ","type":"text"},{"type":"text","text":"Touch ID \/ Face ID challenge."}],"type":"paragraph"},{"style":"tip","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"inlineContent":[{"text":"sandboxed","type":"text"}],"type":"emphasis"},{"type":"text","text":" macOS app still needs a keychain entitlement, even when"},{"text":" ","type":"text"},{"type":"text","text":"not sharing items across an access group. Xcode supplies an"},{"text":" ","type":"text"},{"code":"application-identifier","type":"codeVoice"},{"type":"text","text":" automatically for provisioning-profile–signed"},{"text":" ","type":"text"},{"text":"builds; otherwise add an explicit ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" entry:","type":"text"}]},{"code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"],"type":"codeListing","syntax":"xml"},{"type":"paragraph","inlineContent":[{"text":"Without it, the first ","type":"text"},{"code":"setValue","type":"codeVoice"},{"text":" fails with ","type":"text"},{"code":"errSecMissingEntitlement","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"OSStatus","type":"codeVoice"},{"text":" −34018). This is a build\/signing condition, not a runtime","type":"text"},{"text":" ","type":"text"},{"text":"prompt. iOS \/ iPadOS \/ tvOS \/ watchOS need no extra entitlement.","type":"text"}]}],"name":"Tip"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Encryption, accessibility, iCloud-sync exclusion, and backup exclusion are"},{"type":"text","text":" "},{"type":"text","text":"identical whichever entitlement you use — the access group only controls"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"which of your own apps","type":"text"}]},{"type":"text","text":" can read an item, never third parties or the cloud."},{"type":"text","text":" "},{"type":"text","text":"For a private device ID, in order of strictness:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Most private:"}]},{"type":"text","text":" profile-signed build + "},{"type":"codeVoice","code":"accessGroup: nil"},{"type":"text","text":", relying on the"},{"type":"text","text":" "},{"type":"text","text":"implicit "},{"type":"codeVoice","code":"application-identifier"},{"type":"text","text":" group. No other app — even same-team —"},{"type":"text","text":" "},{"type":"text","text":"can be entitled to it. Mirrors the iOS default; zero sharing surface."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Practically equivalent:"}]},{"type":"text","text":" a "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" array whose only"},{"type":"text","text":" "},{"type":"text","text":"entry is the team-prefixed bundle id (the snippet above). Use when a"},{"type":"text","text":" "},{"type":"text","text":"profile-signed build isn’t available (unsigned local \/ CI dev). Only delta:"},{"type":"text","text":" "},{"type":"text","text":"a same-team app you sign could also declare that string."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Intentional sharing only:"}]},{"type":"text","text":" a shared group string. The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"first"}]},{"type":"text","text":" element"},{"type":"text","text":" "},{"type":"text","text":"becomes the default group for new items — never put a shared group first"},{"type":"text","text":" "},{"type":"text","text":"for private data."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Device-Identity Pattern","anchor":"Device-Identity-Pattern"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The original motivation for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"},{"type":"text","text":" was apps without user"},{"type":"text","text":" "},{"type":"text","text":"auth that still want stable identity for analytics. Mint a UUID once with the"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)"},{"type":"text","text":" helper, hydrate into "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":" at launch,"},{"type":"text","text":" "},{"type":"text","text":"and feed it to "},{"code":"AnalyticsIdentity","type":"codeVoice"},{"type":"text","text":". The "},{"type":"emphasis","inlineContent":[{"text":"same","type":"text"}]},{"type":"text","text":" "},{"code":"deviceID","type":"codeVoice"},{"type":"text","text":" is also the stable"},{"text":" ","type":"text"},{"text":"feature-flag bucketing identity (the plugin’s ","type":"text"},{"code":"deviceIDKeyPath","type":"codeVoice"},{"text":"), so analytics","type":"text"},{"text":" ","type":"text"},{"text":"and A\/B exposure share one identity:","type":"text"}]},{"type":"codeListing","code":["\/\/ `KVKey.deviceID` and `deviceIdentity()` ship with Swidux.","","\/\/ In Store.configured(), before constructing the store:","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.deviceIdentity()   \/\/ reads, or mints-and-persists, a stable UUID","","let initialState = AppState(deviceID: deviceID, \/* … *\/)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Then in the analytics plugin wiring:","type":"text"}]},{"type":"codeListing","code":["AnalyticsPlugin(","    service: analytics,","    identity: AnalyticsIdentity(userID: \\.deviceID, properties: { _ in [:] }),","    \/\/ …",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The closure-based ","type":"text"},{"code":"userID","type":"codeVoice"},{"text":" keypath runs on every dispatch, so the value","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"must"}],"type":"strong"},{"text":" live in state — never call into the Keychain from the closure. Hydrate","type":"text"},{"text":" ","type":"text"},{"text":"once; observe state.","type":"text"}]},{"type":"heading","level":2,"text":"Type-safe Keys","anchor":"Type-safe-Keys"},{"type":"paragraph","inlineContent":[{"text":"Declare each key once on ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference","isActive":true},{"text":" so the value type travels with the name —","type":"text"},{"text":" ","type":"text"},{"text":"no magic strings at call sites:","type":"text"}]},{"type":"codeListing","code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Then read and write through static-member literals. The compiler enforces","type":"text"},{"text":" ","type":"text"},{"text":"that the value type matches what you declared:","type":"text"}]},{"type":"codeListing","code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A typo or wrong type produces a compile error, not a silent miss at runtime.","type":"text"},{"text":" ","type":"text"},{"text":"Centralizing keys on ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","type":"reference","isActive":true},{"text":" also gives you autocomplete and a single place","type":"text"},{"text":" ","type":"text"},{"text":"to audit your preference surface.","type":"text"}]},{"type":"heading","level":2,"text":"Wiring","anchor":"Wiring"},{"type":"heading","level":3,"text":"1. Add to your environment","anchor":"1-Add-to-your-environment"},{"type":"codeListing","code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"2. Hydrate at startup","anchor":"2-Hydrate-at-startup"},{"type":"paragraph","inlineContent":[{"text":"Read once into the initial state — never read mid-cycle from a reducer.","type":"text"}]},{"type":"codeListing","code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"],"syntax":"swift"},{"type":"heading","level":3,"text":"3. Write from an effect","anchor":"3-Write-from-an-effect"},{"type":"paragraph","inlineContent":[{"text":"Mutate state in the reducer, return an effect that writes the value:","type":"text"}]},{"type":"codeListing","code":["case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"No ","type":"text"},{"code":"try?","type":"codeVoice"},{"text":", no ","type":"text"},{"code":"do\/catch","type":"codeVoice"},{"text":". ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","type":"reference","isActive":true},{"text":" does not throw —","type":"text"},{"text":" ","type":"text"},{"text":"encoder errors are programmer mistakes (e.g. ","type":"text"},{"code":"Float.nan","type":"codeVoice"},{"text":"), so the store logs","type":"text"},{"text":" ","type":"text"},{"text":"them and triggers ","type":"text"},{"code":"assertionFailure","type":"codeVoice"},{"text":" in DEBUG instead of forcing every effect","type":"text"},{"text":" ","type":"text"},{"text":"to handle an ","type":"text"},{"code":"Error","type":"codeVoice"},{"text":" it can’t act on.","type":"text"}]},{"type":"heading","level":2,"text":"Testing","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"Inject ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","type":"reference","isActive":true},{"text":" and assert against the same instance:","type":"text"}]},{"type":"codeListing","code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Tests touching real ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" should use a fresh per-test suite and tear","type":"text"},{"text":" ","type":"text"},{"text":"it down explicitly:","type":"text"}]},{"type":"codeListing","code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"],"syntax":"swift"},{"type":"heading","level":2,"text":"Reads Are For Hydration","anchor":"Reads-Are-For-Hydration"},{"style":"important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"Reading from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"type":"text","text":" mid-cycle (inside a reducer) is an"},{"type":"text","text":" "},{"type":"text","text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at"},{"type":"text","text":" "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":" construction. After hydration, the value lives in state and"},{"type":"text","text":" "},{"type":"text","text":"downstream code observes state, not the store."}],"type":"paragraph"}],"name":"Important"},{"type":"paragraph","inlineContent":[{"code":"UserDefaults","type":"codeVoice"},{"text":" itself is thread-safe, but a reducer reading while an effect","type":"text"},{"text":" ","type":"text"},{"text":"writes creates ordering ambiguity. Hydrate, observe state, write through","type":"text"},{"text":" ","type":"text"},{"text":"effects — that’s the discipline.","type":"text"}]},{"type":"heading","level":2,"text":"Failure Modes","anchor":"Failure-Modes"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Missing key"}]},{"type":"text","text":" — "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)","isActive":true},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". Provide a"},{"type":"text","text":" "},{"type":"text","text":"default at the call site."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Decode failure"}]},{"type":"text","text":" — returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" and logs through "},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":" "},{"type":"text","text":"(subsystem "},{"type":"codeVoice","code":"\"swidux\""},{"type":"text","text":", category "},{"type":"codeVoice","code":"\"kvstore\""},{"type":"text","text":"). On startup, behaves identically"},{"type":"text","text":" "},{"type":"text","text":"to first launch."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Encode failure","type":"text"}]},{"text":" — logged at the same subsystem\/category, then","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":" fires in DEBUG so the bug surfaces during development."},{"type":"text","text":" "},{"type":"text","text":"Production builds log and continue; the in-memory state is unchanged. The"},{"type":"text","text":" "},{"type":"text","text":"API does not throw — there is no useful runtime recovery from inside an"},{"type":"text","text":" "},{"type":"text","text":"effect, and "},{"code":"try?","type":"codeVoice"},{"text":" would just hide the problem.","type":"text"}]}]}]},{"type":"heading","level":2,"text":"@AppStorage Interop","anchor":"AppStorage-Interop"},{"type":"paragraph","inlineContent":[{"text":"There is none, by design. ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","type":"reference","isActive":true},{"type":"text","text":" writes JSON-encoded"},{"type":"text","text":" "},{"code":"Data","type":"codeVoice"},{"text":" blobs. SwiftUI’s ","type":"text"},{"code":"@AppStorage","type":"codeVoice"},{"text":" only observes native primitive types","type":"text"},{"type":"text","text":" "},{"text":"(","type":"text"},{"code":"Bool","type":"codeVoice"},{"type":"text","text":", "},{"code":"Int","type":"codeVoice"},{"text":", ","type":"text"},{"code":"String","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":", ","type":"text"},{"code":"URL","type":"codeVoice"},{"text":", raw ","type":"text"},{"code":"Data","type":"codeVoice"},{"type":"text","text":"). Two parallel"},{"text":" ","type":"tex