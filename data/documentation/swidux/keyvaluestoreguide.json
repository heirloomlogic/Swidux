{"variants":[{"paths":["\/documentation\/swidux\/keyvaluestoreguide"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true,"type":"reference"},{"text":" is a small protocol for one-shot scalar values that don’t fit","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" model. Three implementations ship:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","isActive":true},{"type":"text","text":" — production, backed by any "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":" suite"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true},{"type":"text","text":" — production, backed by the system Keychain (survives reinstall)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","isActive":true},{"type":"text","text":" — tests, dictionary-backed, reference semantics"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Inject through your ","type":"text"},{"code":"Environment","type":"codeVoice"},{"text":", hydrate state at startup, and write from","type":"text"},{"text":" ","type":"text"},{"text":"effects. Reducers stay pure.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public protocol KeyValueStore: Sendable {","    func value<Value>(_ key: KVKey<Value>) -> Value?","    @discardableResult","    func setValue<Value>(_ value: Value?, for key: KVKey<Value>) -> Bool","    @discardableResult","    func removeValue<Value>(for key: KVKey<Value>) -> Bool","    func contains<Value>(_ key: KVKey<Value>) -> Bool","}"]},{"type":"paragraph","inlineContent":[{"text":"All values are JSON-encoded as ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":". Reads and writes go through ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which pairs a backing-store name with its ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" value type at compile time.","type":"text"}]},{"type":"heading","anchor":"When-to-Use-What","level":2,"text":"When to Use What"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Need"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Collection of identifiable entities (decks, cards, sessions)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" + "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Scalar preference (theme, sort order, last-seen version)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true},{"type":"text","text":" (UserDefaults)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Anonymous device identity that must survive reinstall"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true},{"type":"text","text":" (Keychain)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Last-known-good entitlement cache (offline pro gate)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true},{"type":"text","text":" (Keychain) — backs "},{"type":"codeVoice","code":"ResilientPaywallService"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"code":"EntityStore","type":"codeVoice"},{"text":" is for many-of-a-kind data with change tracking and batched","type":"text"},{"text":" ","type":"text"},{"text":"writes. ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":" is for one-of-a-kind values that you read once at","type":"text"},{"text":" ","type":"text"},{"text":"startup and overwrite on change.","type":"text"}]},{"type":"heading","anchor":"UserDefaults-vs-Keychain","level":3,"text":"UserDefaults vs Keychain"},{"rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Survives reinstall?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes (this-device-only by default)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Backup \/ device migration"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Included"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Excluded with default accessibility"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Throughput"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Fast (in-memory cache)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Slower (system call)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Visible to other apps?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No (per app\/group)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Optionally (App Groups via "},{"type":"codeVoice","code":"accessGroup:"},{"type":"text","text":")"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Best for"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Theme, sort order, feature toggles, last-seen version"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Anonymous device ID, opaque tokens, last-known-good entitlement"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"The Keychain costs more per access — hydrate once at launch and observe state","type":"text"},{"text":" ","type":"text"},{"text":"afterward, never read inside a reducer.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Prefer the Keychain for anything a user could gain by forging it. A","type":"text"},{"text":" ","type":"text"},{"text":"last-known-good entitlement cache is the clearest case: it grants pro offline,","type":"text"},{"text":" ","type":"text"},{"text":"so a ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" plist (editable directly or via a doctored-backup restore)","type":"text"},{"text":" ","type":"text"},{"text":"lets a spoofed value unlock the app. ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" ","type":"text"},{"text":"persists that cache through an injected ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":", so back it with the","type":"text"},{"text":" ","type":"text"},{"text":"Keychain.","type":"text"}]},{"type":"heading","anchor":"macOS-sandbox--entitlements","level":3,"text":"macOS sandbox & entitlements"},{"type":"paragraph","inlineContent":[{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" uses the data-protection keychain, so it never raises","type":"text"},{"text":" ","type":"text"},{"text":"a user prompt — no “Always Allow \/ Deny” dialog, no locked-keychain prompt, no","type":"text"},{"text":" ","type":"text"},{"text":"Touch ID \/ Face ID challenge.","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"type":"text","text":"sandboxed"}]},{"type":"text","text":" macOS app still needs a keychain entitlement, even when"},{"type":"text","text":" "},{"type":"text","text":"not sharing items across an access group. Xcode supplies an"},{"type":"text","text":" "},{"type":"codeVoice","code":"application-identifier"},{"type":"text","text":" automatically for provisioning-profile–signed"},{"type":"text","text":" "},{"type":"text","text":"builds; otherwise add an explicit "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entry:"}],"type":"paragraph"},{"code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"],"syntax":"xml","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Without it, the first "},{"type":"codeVoice","code":"setValue"},{"type":"text","text":" fails with "},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"type":"text","text":" "},{"type":"text","text":"("},{"type":"codeVoice","code":"OSStatus"},{"type":"text","text":" −34018). This is a build\/signing condition, not a runtime"},{"type":"text","text":" "},{"type":"text","text":"prompt. iOS \/ iPadOS \/ tvOS \/ watchOS need no extra entitlement."}],"type":"paragraph"}],"type":"aside","style":"tip","name":"Tip"},{"type":"heading","anchor":"Unsigned-builds-and-test-hosts","level":3,"text":"Unsigned builds and test hosts"},{"type":"paragraph","inlineContent":[{"text":"A build made with ","type":"text"},{"code":"CODE_SIGNING_ALLOWED=NO","type":"codeVoice"},{"text":" embeds no entitlements at all, so","type":"text"},{"text":" ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" never reaches the binary and every write returns","type":"text"},{"text":" ","type":"text"},{"text":"−34018. Test hosts and most CI invocations are built that way, which puts the","type":"text"},{"text":" ","type":"text"},{"text":"entitlement advice above out of reach: there is nothing to attach it to.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" treats that as an environment condition rather than a","type":"text"},{"text":" ","type":"text"},{"text":"bug: it logs, returns ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", and carries on. Reach for the returned value","type":"text"},{"text":" ","type":"text"},{"text":"where the app has something to fall back to.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let identity = keychain.deviceIdentity()   \/\/ usable even if nothing persisted"]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)","isActive":true,"type":"reference"},{"text":" already works this way — a failed write","type":"text"},{"text":" ","type":"text"},{"text":"yields a session-local identity instead of a crash. Adopters do not need to","type":"text"},{"text":" ","type":"text"},{"text":"detect XCTest and swap in a different store.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Adding a ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" entry has a cost worth weighing: it makes the","type":"text"},{"text":" ","type":"text"},{"text":"app require a provisioning profile for any signed build, which breaks ad-hoc and","type":"text"},{"text":" ","type":"text"},{"text":"local unsigned builds that otherwise run fine. Add it because you want the access","type":"text"},{"text":" ","type":"text"},{"text":"group, not to silence −34018.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Encryption, accessibility, iCloud-sync exclusion, and backup exclusion are","type":"text"},{"text":" ","type":"text"},{"text":"identical whichever entitlement you use — the access group only controls","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"which of your own apps"}],"type":"emphasis"},{"text":" can read an item, never third parties or the cloud.","type":"text"},{"text":" ","type":"text"},{"text":"For a private device ID, in order of strictness:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Most private:"}]},{"type":"text","text":" profile-signed build + "},{"code":"accessGroup: nil","type":"codeVoice"},{"type":"text","text":", relying on the"},{"type":"text","text":" "},{"type":"text","text":"implicit "},{"code":"application-identifier","type":"codeVoice"},{"type":"text","text":" group. No other app — even same-team —"},{"type":"text","text":" "},{"type":"text","text":"can be entitled to it. Mirrors the iOS default; zero sharing surface."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Practically equivalent:"}]},{"type":"text","text":" a "},{"code":"keychain-access-groups","type":"codeVoice"},{"type":"text","text":" array whose only"},{"type":"text","text":" "},{"type":"text","text":"entry is the team-prefixed bundle id (the snippet above). Use when a"},{"type":"text","text":" "},{"type":"text","text":"profile-signed build isn’t available (unsigned local \/ CI dev). Only delta:"},{"type":"text","text":" "},{"type":"text","text":"a same-team app you sign could also declare that string."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Intentional sharing only:"}]},{"type":"text","text":" a shared group string. The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"first"}]},{"type":"text","text":" element"},{"type":"text","text":" "},{"type":"text","text":"becomes the default group for new items — never put a shared group first"},{"type":"text","text":" "},{"type":"text","text":"for private data."}]}]}]},{"type":"heading","anchor":"Device-Identity-Pattern","level":2,"text":"Device-Identity Pattern"},{"type":"paragraph","inlineContent":[{"text":"The original motivation for ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true,"type":"reference"},{"text":" was apps without user","type":"text"},{"text":" ","type":"text"},{"text":"auth that still want stable identity for analytics. Mint a UUID once with the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)","isActive":true,"type":"reference"},{"text":" helper, hydrate into ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" at launch,","type":"text"},{"text":" ","type":"text"},{"text":"and feed it to ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":". The ","type":"text"},{"inlineContent":[{"type":"text","text":"same"}],"type":"emphasis"},{"text":" ","type":"text"},{"code":"deviceID","type":"codeVoice"},{"text":" is also the stable","type":"text"},{"text":" ","type":"text"},{"text":"feature-flag bucketing identity (the plugin’s ","type":"text"},{"code":"deviceIDKeyPath","type":"codeVoice"},{"text":"), so analytics","type":"text"},{"text":" ","type":"text"},{"text":"and A\/B exposure share one identity:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ `KVKey.deviceID` and `deviceIdentity()` ship with Swidux.","","\/\/ In Store.configured(), before constructing the store:","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.deviceIdentity()   \/\/ reads, or mints-and-persists, a stable UUID","","let initialState = AppState(deviceID: deviceID, \/* … *\/)"]},{"type":"paragraph","inlineContent":[{"text":"Then in the analytics plugin wiring:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["AnalyticsPlugin(","    service: analytics,","    identity: AnalyticsIdentity(userID: \\.deviceID, properties: { _ in [:] }),","    \/\/ …",")"]},{"type":"paragraph","inlineContent":[{"text":"The closure-based ","type":"text"},{"code":"userID","type":"codeVoice"},{"text":" keypath runs on every dispatch, so the value","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"must"}],"type":"strong"},{"text":" live in state — never call into the Keychain from the closure. Hydrate","type":"text"},{"text":" ","type":"text"},{"text":"once; observe state.","type":"text"}]},{"type":"heading","anchor":"Type-safe-Keys","level":2,"text":"Type-safe Keys"},{"type":"paragraph","inlineContent":[{"text":"Declare each key once on ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true,"type":"reference"},{"text":" so the value type travels with the name —","type":"text"},{"text":" ","type":"text"},{"text":"no magic strings at call sites:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"]},{"type":"paragraph","inlineContent":[{"text":"Then read and write through static-member literals. The compiler enforces","type":"text"},{"text":" ","type":"text"},{"text":"that the value type matches what you declared:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"]},{"type":"paragraph","inlineContent":[{"text":"A typo or wrong type produces a compile error, not a silent miss at runtime.","type":"text"},{"text":" ","type":"text"},{"text":"Centralizing keys on ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true,"type":"reference"},{"text":" also gives you autocomplete and a single place","type":"text"},{"text":" ","type":"text"},{"text":"to audit your preference surface.","type":"text"}]},{"type":"heading","anchor":"Wiring","level":2,"text":"Wiring"},{"type":"heading","anchor":"1-Add-to-your-environment","level":3,"text":"1. Add to your environment"},{"type":"codeListing","syntax":"swift","code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"]},{"type":"heading","anchor":"2-Hydrate-at-startup","level":3,"text":"2. Hydrate at startup"},{"type":"paragraph","inlineContent":[{"text":"Read once into the initial state — never read mid-cycle from a reducer.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"]},{"type":"heading","anchor":"3-Write-from-an-effect","level":3,"text":"3. Write from an effect"},{"type":"paragraph","inlineContent":[{"text":"Mutate state in the reducer, return an effect that writes the value:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"]},{"type":"paragraph","inlineContent":[{"text":"No ","type":"text"},{"code":"try?","type":"codeVoice"},{"text":", no ","type":"text"},{"code":"do\/catch","type":"codeVoice"},{"text":". ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","isActive":true,"type":"reference"},{"text":" does not throw —","type":"text"},{"text":" ","type":"text"},{"text":"encoder errors are programmer mistakes (e.g. ","type":"text"},{"code":"Float.nan","type":"codeVoice"},{"text":"), so the store logs","type":"text"},{"text":" ","type":"text"},{"text":"them and triggers ","type":"text"},{"code":"assertionFailure","type":"codeVoice"},{"text":" in DEBUG instead of forcing every effect","type":"text"},{"text":" ","type":"text"},{"text":"to handle an ","type":"text"},{"code":"Error","type":"codeVoice"},{"text":" it can’t act on.","type":"text"}]},{"type":"heading","anchor":"Testing","level":2,"text":"Testing"},{"type":"paragraph","inlineContent":[{"text":"Inject ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","isActive":true,"type":"reference"},{"text":" and assert against the same instance:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"]},{"type":"paragraph","inlineContent":[{"text":"Tests touching real ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" should use a fresh per-test suite and tear","type":"text"},{"text":" ","type":"text"},{"text":"it down explicitly:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"]},{"type":"heading","anchor":"Reads-Are-For-Hydration","level":2,"text":"Reads Are For Hydration"},{"content":[{"inlineContent":[{"type":"text","text":"Reading from "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true},{"type":"text","text":" mid-cycle (inside a reducer) is an"},{"type":"text","text":" "},{"type":"text","text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" construction. After hydration, the value lives in state and"},{"type":"text","text":" "},{"type":"text","text":"downstream code observes state, not the store."}],"type":"paragraph"}],"type":"aside","style":"important","name":"Important"},{"type":"paragraph","inlineContent":[{"code":"UserDefaults","type":"codeVoice"},{"text":" itself is thread-safe, but a reducer reading while an effect","type":"text"},{"text":" ","type":"text"},{"text":"writes creates ordering ambiguity. Hydrate, observe state, write through","type":"text"},{"text":" ","type":"text"},{"text":"effects — that’s the discipline.","type":"text"}]},{"type":"heading","anchor":"Failure-Modes","l