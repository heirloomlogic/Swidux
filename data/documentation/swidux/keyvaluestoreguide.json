{"metadata":{"roleHeading":"API Collection","title":"KeyValueStore","role":"collectionGroup","modules":[{"name":"Swidux"}]},"abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"paths":["\/documentation\/swidux\/keyvaluestoreguide"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"anchor":"Keys","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KVKey"],"title":"Keys"},{"anchor":"Protocol","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"],"title":"Protocol"},{"anchor":"Implementations","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore"],"title":"Implementations"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","interfaceLanguage":"swift"},"kind":"article","seeAlsoSections":[{"generated":true,"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference"}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference","isActive":true},{"type":"text","text":" is a small protocol for one-shot scalar values that don’t fit"},{"type":"text","text":" "},{"type":"text","text":"the "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":" model. Three implementations ship:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore"},{"type":"text","text":" — production, backed by any "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" suite"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true},{"type":"text","text":" — production, backed by the system Keychain (survives reinstall)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","isActive":true,"type":"reference"},{"text":" — tests, dictionary-backed, reference semantics","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inject through your "},{"type":"codeVoice","code":"Environment"},{"type":"text","text":", hydrate state at startup, and write from"},{"type":"text","text":" "},{"type":"text","text":"effects. Reducers stay pure."}]},{"code":["public protocol KeyValueStore: Sendable {","    func value<Value>(_ key: KVKey<Value>) -> Value?","    func setValue<Value>(_ value: Value?, for key: KVKey<Value>)","    func removeValue<Value>(for key: KVKey<Value>)","    func contains<Value>(_ key: KVKey<Value>) -> Bool","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All values are JSON-encoded as "},{"code":"Data","type":"codeVoice"},{"type":"text","text":". Reads and writes go through "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which pairs a backing-store name with its "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" value type at compile time."}]},{"anchor":"When-to-Use-What","level":2,"type":"heading","text":"When to Use What"},{"rows":[[[{"inlineContent":[{"text":"Need","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Collection of identifiable entities (decks, cards, sessions)"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" + ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true,"type":"reference"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Scalar preference (theme, sort order, last-seen version)","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"type":"text","text":" (UserDefaults)"}]}]],[[{"inlineContent":[{"text":"Anonymous device identity that must survive reinstall","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore"},{"type":"text","text":" (Keychain)"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Last-known-good entitlement cache (offline pro gate)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","type":"reference","isActive":true},{"text":" (Keychain) — backs ","type":"text"},{"type":"codeVoice","code":"ResilientPaywallService"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"code":"EntityStore","type":"codeVoice"},{"text":" is for many-of-a-kind data with change tracking and batched","type":"text"},{"text":" ","type":"text"},{"text":"writes. ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":" is for one-of-a-kind values that you read once at","type":"text"},{"text":" ","type":"text"},{"text":"startup and overwrite on change.","type":"text"}],"type":"paragraph"},{"text":"UserDefaults vs Keychain","level":3,"type":"heading","anchor":"UserDefaults-vs-Keychain"},{"rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","isActive":true}],"type":"paragraph"}],[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference","isActive":true}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Survives reinstall?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes (this-device-only by default)","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Backup \/ device migration"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Included"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Excluded with default accessibility"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Throughput"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fast (in-memory cache)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Slower (system call)","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Visible to other apps?"}]}],[{"type":"paragraph","inlineContent":[{"text":"No (per app\/group)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Optionally (App Groups via ","type":"text"},{"type":"codeVoice","code":"accessGroup:"},{"text":")","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Best for","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Theme, sort order, feature toggles, last-seen version"}]}],[{"type":"paragraph","inlineContent":[{"text":"Anonymous device ID, opaque tokens, last-known-good entitlement","type":"text"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The Keychain costs more per access — hydrate once at launch and observe state"},{"type":"text","text":" "},{"type":"text","text":"afterward, never read inside a reducer."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefer the Keychain for anything a user could gain by forging it. A"},{"type":"text","text":" "},{"type":"text","text":"last-known-good entitlement cache is the clearest case: it grants pro offline,"},{"type":"text","text":" "},{"type":"text","text":"so a "},{"type":"codeVoice","code":"UserDefaults"},{"text":" plist (editable directly or via a doctored-backup restore)","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"lets a spoofed value unlock the app. "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":"’s "},{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"persists that cache through an injected "},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":", so back it with the"},{"type":"text","text":" "},{"type":"text","text":"Keychain."}]},{"text":"macOS sandbox & entitlements","anchor":"macOS-sandbox--entitlements","level":3,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" uses the data-protection keychain, so it never raises"},{"type":"text","text":" "},{"type":"text","text":"a user prompt — no “Always Allow \/ Deny” dialog, no locked-keychain prompt, no"},{"type":"text","text":" "},{"type":"text","text":"Touch ID \/ Face ID challenge."}],"type":"paragraph"},{"name":"Tip","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"emphasis","inlineContent":[{"text":"sandboxed","type":"text"}]},{"type":"text","text":" macOS app still needs a keychain entitlement, even when"},{"type":"text","text":" "},{"type":"text","text":"not sharing items across an access group. Xcode supplies an"},{"type":"text","text":" "},{"type":"codeVoice","code":"application-identifier"},{"type":"text","text":" automatically for provisioning-profile–signed"},{"type":"text","text":" "},{"type":"text","text":"builds; otherwise add an explicit "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entry:"}]},{"type":"codeListing","syntax":"xml","code":["<key>keychain-access-groups<\/key>","<array>","    <string>$(AppIdentifierPrefix)com.example.myapp<\/string>","<\/array>"]},{"type":"paragraph","inlineContent":[{"text":"Without it, the first ","type":"text"},{"code":"setValue","type":"codeVoice"},{"type":"text","text":" fails with "},{"code":"errSecMissingEntitlement","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"OSStatus","type":"codeVoice"},{"type":"text","text":" −34018). This is a build\/signing condition, not a runtime"},{"type":"text","text":" "},{"type":"text","text":"prompt. iOS \/ iPadOS \/ tvOS \/ watchOS need no extra entitlement."}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"Encryption, accessibility, iCloud-sync exclusion, and backup exclusion are"},{"type":"text","text":" "},{"type":"text","text":"identical whichever entitlement you use — the access group only controls"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"which of your own apps","type":"text"}]},{"type":"text","text":" can read an item, never third parties or the cloud."},{"type":"text","text":" "},{"type":"text","text":"For a private device ID, in order of strictness:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Most private:"}]},{"type":"text","text":" profile-signed build + "},{"type":"codeVoice","code":"accessGroup: nil"},{"type":"text","text":", relying on the"},{"type":"text","text":" "},{"type":"text","text":"implicit "},{"type":"codeVoice","code":"application-identifier"},{"type":"text","text":" group. No other app — even same-team —"},{"type":"text","text":" "},{"type":"text","text":"can be entitled to it. Mirrors the iOS default; zero sharing surface."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Practically equivalent:"}],"type":"strong"},{"type":"text","text":" a "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" array whose only"},{"type":"text","text":" "},{"type":"text","text":"entry is the team-prefixed bundle id (the snippet above). Use when a"},{"type":"text","text":" "},{"type":"text","text":"profile-signed build isn’t available (unsigned local \/ CI dev). Only delta:"},{"type":"text","text":" "},{"type":"text","text":"a same-team app you sign could also declare that string."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Intentional sharing only:"}]},{"type":"text","text":" a shared group string. The "},{"type":"emphasis","inlineContent":[{"type":"text","text":"first"}]},{"type":"text","text":" element"},{"type":"text","text":" "},{"type":"text","text":"becomes the default group for new items — never put a shared group first"},{"type":"text","text":" "},{"type":"text","text":"for private data."}]}]}],"type":"orderedList"},{"text":"Device-Identity Pattern","level":2,"anchor":"Device-Identity-Pattern","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The original motivation for ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference"},{"text":" was apps without user","type":"text"},{"text":" ","type":"text"},{"text":"auth that still want stable identity for analytics. Mint a UUID once with the","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)","type":"reference"},{"text":" helper, hydrate into ","type":"text"},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" at launch,"},{"type":"text","text":" "},{"type":"text","text":"and feed it to "},{"code":"AnalyticsIdentity","type":"codeVoice"},{"type":"text","text":". The "},{"inlineContent":[{"type":"text","text":"same"}],"type":"emphasis"},{"type":"text","text":" "},{"code":"deviceID","type":"codeVoice"},{"type":"text","text":" is also the stable"},{"type":"text","text":" "},{"type":"text","text":"feature-flag bucketing identity (the plugin’s "},{"code":"deviceIDKeyPath","type":"codeVoice"},{"type":"text","text":"), so analytics"},{"type":"text","text":" "},{"type":"text","text":"and A\/B exposure share one identity:"}]},{"syntax":"swift","code":["\/\/ `KVKey.deviceID` and `deviceIdentity()` ship with Swidux.","","\/\/ In Store.configured(), before constructing the store:","let kv = KeychainKeyValueStore(service: \"com.example.myapp\")","let deviceID = kv.deviceIdentity()   \/\/ reads, or mints-and-persists, a stable UUID","","let initialState = AppState(deviceID: deviceID, \/* … *\/)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then in the analytics plugin wiring:"}],"type":"paragraph"},{"syntax":"swift","code":["AnalyticsPlugin(","    service: analytics,","    identity: AnalyticsIdentity(userID: \\.deviceID, properties: { _ in [:] }),","    \/\/ …",")"],"type":"codeListing"},{"inlineContent":[{"text":"The closure-based ","type":"text"},{"type":"codeVoice","code":"userID"},{"text":" keypath runs on every dispatch, so the value","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"must"}]},{"text":" live in state — never call into the Keychain from the closure. Hydrate","type":"text"},{"text":" ","type":"text"},{"text":"once; observe state.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Type-safe-Keys","text":"Type-safe Keys","type":"heading"},{"inlineContent":[{"type":"text","text":"Declare each key once on "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey"},{"type":"text","text":" so the value type travels with the name —"},{"type":"text","text":" "},{"type":"text","text":"no magic strings at call sites:"}],"type":"paragraph"},{"syntax":"swift","code":["extension KVKey where Value == Theme {","    static let theme = KVKey<Theme>(\"theme\")","}","","extension KVKey where Value == SortOrder {","    static let sortOrder = KVKey<SortOrder>(\"sortOrder\")","}","","extension KVKey where Value == String {","    static let lastSeenVersion = KVKey<String>(\"lastSeenVersion\")","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then read and write through static-member literals. The compiler enforces"},{"type":"text","text":" "},{"type":"text","text":"that the value type matches what you declared:"}],"type":"paragraph"},{"type":"codeListing","code":["let theme = store.value(.theme) ?? .system            \/\/ Theme?","store.setValue(theme, for: .theme)","store.setValue(.alphabetical, for: .sortOrder)","store.removeValue(for: .lastSeenVersion)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"A typo or wrong type produces a compile error, not a silent miss at runtime."},{"type":"text","text":" "},{"type":"text","text":"Centralizing keys on "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KVKey","isActive":true},{"type":"text","text":" also gives you autocomplete and a single place"},{"type":"text","text":" "},{"type":"text","text":"to audit your preference surface."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Wiring","anchor":"Wiring"},{"type":"heading","level":3,"text":"1. Add to your environment","anchor":"1-Add-to-your-environment"},{"type":"codeListing","code":["struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","","    static func live() -> AppEnvironment {","        AppEnvironment(keyValue: UserDefaultsKeyValueStore())","    }","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"2. Hydrate at startup","anchor":"2-Hydrate-at-startup"},{"inlineContent":[{"text":"Read once into the initial state — never read mid-cycle from a reducer.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(","            theme: store.value(.theme) ?? .system,","            sortOrder: store.value(.sortOrder) ?? .alphabetical,","            lastSeenVersion: store.value(.lastSeenVersion)","        )","    }","}","","let env = AppEnvironment.live()","let store = AppStore.configured(state: .hydrated(from: env.keyValue), environment: env)"],"syntax":"swift"},{"type":"heading","level":3,"text":"3. Write from an effect","anchor":"3-Write-from-an-effect"},{"inlineContent":[{"type":"text","text":"Mutate state in the reducer, return an effect that writes the value:"}],"type":"paragraph"},{"type":"codeListing","code":["case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"],"syntax":"swift"},{"inlineContent":[{"text":"No ","type":"text"},{"code":"try?","type":"codeVoice"},{"text":", no ","type":"text"},{"code":"do\/catch","type":"codeVoice"},{"text":". ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","isActive":true},{"text":" does not throw —","type":"text"},{"text":" ","type":"text"},{"text":"encoder errors are programmer mistakes (e.g. ","type":"text"},{"code":"Float.nan","type":"codeVoice"},{"text":"), so the store logs","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"them and triggers "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":" in DEBUG instead of forcing every effect"},{"type":"text","text":" "},{"type":"text","text":"to handle an "},{"type":"codeVoice","code":"Error"},{"type":"text","text":" it can’t act on."}],"type":"paragraph"},{"anchor":"Testing","level":2,"text":"Testing","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Inject ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","isActive":true,"type":"reference"},{"text":" and assert against the same instance:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@Test","@MainActor","func themeChangePersists() async throws {","    let prefs = InMemoryKeyValueStore()","    let env = AppEnvironment(keyValue: prefs)","    let store = AppStore.configured(state: AppState(), environment: env)","","    try await confirmation(expectedCount: 1) { confirm in","        store.send(.themeChanged(.dark))","","        for _ in 0..<50 {","            if prefs.value(.theme) == .dark {","                confirm()","                break","            }","            try await Task.sleep(for: .milliseconds(10))","        }","    }","","    \/\/ Simulate a relaunch.","    let rehydrated = AppState.hydrated(from: prefs)","    #expect(rehydrated.theme == .dark)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Tests touching real "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" should use a fresh per-test suite and tear"},{"type":"text","text":" "},{"type":"text","text":"it down explicitly:"}]},{"syntax":"swift","type":"codeListing","code":["let suiteName = \"myapp.tests.\\(UUID().uuidString)\"","let defaults = UserDefaults(suiteName: suiteName)!","defer { defaults.removePersistentDomain(forName: suiteName) }","","let store = UserDefaultsKeyValueStore(suite: defaults)"]},{"anchor":"Reads-Are-For-Hydration","level":2,"text":"Reads Are For Hydration","type":"heading"},{"content":[{"inlineContent":[{"text":"Reading from ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","isActive":true},{"text":" mid-cycle (inside a reducer) is an","type":"text"},{"text":" ","type":"text"},{"text":"anti-pattern. Reducers must be pure and synchronous; reads happen once at","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" construction. After hydration, the value lives in state and","type":"text"},{"text":" ","type":"text"},{"text":"downstream code observes state, not the store.","type":"text"}],"type":"paragraph"}],"name":"Important","style":"important","type":"aside"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" itself is thread-safe, but a reducer reading while an effect"},{"text":" ","type":"text"},{"text":"writes creates ordering ambiguity. Hydrate, observe state, write through","type":"text"},{"text":" ","type":"text"},{"text":"effects — that’s the discipline.","type":"text"}]},{"anchor":"Failure-Modes","type":"heading","text":"Failure Modes","level":2},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Missing key"}],"type":"strong"},{"text":" — ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)","isActive":true,"type":"reference"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":". Provide a","type":"text"},{"text":" ","type":"text"},{"text":"default at the call site.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Decode failure"}],"type":"strong"},{"text":" — returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" and logs through ","type":"text"},{"code":"os.Logger","type":"codeVoice"},{"text":" ","type":"text"},{"text":"(subsystem ","type":"text"},{"code":"\"swidux\"","type":"codeVoice"},{"text":", category ","type":"text"},{"code":"\"kvstore\"","type":"codeVoice"},{"text":"). On startup, behaves identically","type":"text"},{"text":" ","type":"text"},{"text":"to first launch.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Encode failure"}],"type":"strong"},{"type":"text","text":" — logged at the same subsystem\/category, then"},{"type":"text","text":" "},{"code":"assertionFailure","type":"codeVoice"},{"type":"text","text":" fires in DEBUG so the bug surfaces during development."},{"type":"text","text":" "},{"type":"text","text":"Production builds log and continue; the in-memory state is unchanged. The"},{"type":"text","text":" "},{"type":"text","text":"API does not throw — there is no useful runtime recovery from inside an"},{"type":"text","text":" "},{"type":"text","text":"effect, and "},{"code":"try?","type":"codeVoice"},{"type":"text","text":" would just hide the problem."}]}]}],"type":"unorderedList"},{"text":"@AppStorage Interop","level":2,"type":"heading","anchor":"AppStorage-Interop"},{"inlineContent":[{"type":"text","text":"There is none, by design. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore"},{"type":"text","text":" writes JSON-encoded"},{"type":"text","text":" "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" blobs. SwiftUI’s "},{"code":"@AppStorage","type":"codeVoice"},{"type":"text","text":" only observes native primitive types"},{"type":"text","text":" "},{"type":"text","text":"("},{"code":"Bool","type":"codeVoice"},{"type":"text","text":", "},{"code":"Int","type":"codeVoice"},{"type":"text","text":", "},{"code":"String","type":"codeVoice"},{"type":"text","text":", "},{"code":"Double","type":"codeVoice"},{"text":", ","type":"text"},{"code":"URL","type"