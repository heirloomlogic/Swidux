{"variants":[{"paths":["\/documentation\/swidux\/pluginanalyticsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"title":"Reference","anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"generated":true}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":". Unlike the gate-style plugins (","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"text":"), analytics is an ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"observer"}]},{"text":": it watches actions flow by and emits events, but never blocks dispatch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two surfaces:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Mapper (passive)","type":"text"}]},{"type":"text","text":" — App declares a "},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"type":"text","text":" closure once at registration. The plugin runs it in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action while the user is opted in."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"AnalyticsAction"},{"text":" (explicit)","type":"text"}]},{"type":"text","text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Plus optional ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"auto-identify"}]},{"text":": pass an ","type":"text"},{"type":"codeVoice","code":"AnalyticsIdentity"},{"text":" keypath and the plugin watches userID transitions across dispatches, firing ","type":"text"},{"type":"codeVoice","code":"service.identify"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"service.reset"},{"text":" automatically.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},{"text":". For where this plugin sits in the lifecycle, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Library-target","text":"Library target"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Product: ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Import: ","type":"text"},{"type":"codeVoice","code":"import SwiduxAnalytics"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Provided-implementations","text":"Provided implementations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MockAnalyticsService"},{"type":"text","text":" — silent no-op, for previews and tests."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ConsoleAnalyticsService"},{"text":" — logs every call to ","type":"text"},{"type":"codeVoice","code":"os.Logger"},{"text":". Use this as the default ","type":"text"},{"type":"codeVoice","code":"service:"},{"text":" while the analytics vendor decision is still open: analytics wiring can be developed and QA-tested end to end with no SDK and no vendor commitment. Adopting a real provider later is the usual two-line change in ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For production Mixpanel integrations, the "},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","type":"reference","isActive":true},{"type":"text","text":" companion package provides:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"text":" — an ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" conformer that forwards to the Mixpanel SDK and maps ","type":"text"},{"type":"codeVoice","code":"AnalyticsValue"},{"text":" to native Mixpanel types.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"text":" — a Mixpanel-flavored mock for previews.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Full API documentation lives in the package’s own "},{"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For other backends (Amplitude, PostHog, Segment, custom), implement "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" directly — see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","type":"reference","isActive":true},{"type":"text","text":" Step 3, Path B."}]},{"text":"Types","type":"heading","level":2,"anchor":"Types"},{"level":3,"type":"heading","text":"`AnalyticsPlugin<RootState, RootAction>`","anchor":"AnalyticsPlugin%3CRootState-RootAction%3E"},{"type":"paragraph","inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" "},{"code":"final class","type":"codeVoice"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SwiduxPlugin"},{"text":" conformer. Owns a slice of root state typed as ","type":"text"},{"code":"AnalyticsState","type":"codeVoice"},{"type":"text","text":" and an action enum typed as "},{"code":"AnalyticsAction","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil,","    onConsentChange: (@Sendable (Bool) async -> Void)? = nil",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"onConsentChange"},{"text":" fires on every ","type":"text"},{"type":"codeVoice","code":".setOptedOut"},{"type":"text","text":" dispatch with the new opted-out value. Use it to drive a vendor SDK’s own consent API — see "},{"type":"emphasis","inlineContent":[{"text":"Consent","type":"text"}]},{"type":"text","text":" below."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is a "},{"code":"final class","type":"codeVoice"},{"type":"text","text":" (not a struct) because it tracks pending fire-and-forget service calls so that "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" can deterministically await them — same reason "},{"type":"codeVoice","code":"PersistencePlugin"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UndoPlugin"},{"type":"text","text":" are classes."}]},{"level":3,"type":"heading","text":"`AnalyticsState`","anchor":"AnalyticsState"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sendable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" struct. The slice the plugin owns.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isOptedOut"},{"type":"text","text":" — App-controlled privacy flag. While "},{"type":"codeVoice","code":"true"},{"type":"text","text":", mapper events are dropped, explicit "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":" actions become no-ops, and auto-identify is paused."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" — The most recent screen recorded via "},{"type":"codeVoice","code":".screenView(_:)"},{"type":"text","text":", auto-attached as the "},{"type":"codeVoice","code":"screen"},{"text":" property on subsequent tracked events.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"lastIdentifiedUserID"},{"text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions.","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","level":3,"anchor":"AnalyticsAction","text":"`AnalyticsAction`"},{"code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Convenience factories cover the common no-properties cases:"}]},{"code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"AnalyticsEvent","text":"`AnalyticsEvent`"},{"code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"`AnalyticsValue`","anchor":"AnalyticsValue"},{"type":"paragraph","inlineContent":[{"text":"Closed enum keeping the protocol provider-agnostic and ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":". Each service adapter maps these cases to its native property type."}]},{"code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Literal conformances keep call-sites clean:"}]},{"syntax":"swift","type":"codeListing","code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"]},{"level":3,"type":"heading","text":"`AnalyticsMapper<State, Action>`","anchor":"AnalyticsMapper%3CState-Action%3E"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wraps the declarative "},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"type":"text","text":" closure."}]},{"syntax":"swift","type":"codeListing","code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. "},{"code":".none","type":"codeVoice"},{"type":"text","text":" is the default mapper for plugins that only use explicit "},{"code":"AnalyticsAction","type":"codeVoice"},{"type":"text","text":" dispatches."}]},{"level":3,"type":"heading","text":"`AnalyticsIdentity<State>`","anchor":"AnalyticsIdentity%3CState%3E"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declarative source-of-truth for the active user’s identity."}]},{"syntax":"swift","type":"codeListing","code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The KeyPath convenience init is the typical shape: "},{"type":"codeVoice","code":"AnalyticsIdentity(userID: \\.auth.currentUserID)"},{"text":".","type":"text"}]},{"type":"heading","level":3,"anchor":"AnalyticsService-protocol","text":"`AnalyticsService` (protocol)"},{"code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"reset"},{"type":"text","text":" fire-and-forget; only "},{"type":"codeVoice","code":"flush"},{"type":"text","text":" is awaited."}]},{"type":"heading","level":3,"anchor":"MockAnalyticsService","text":"`MockAnalyticsService`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No-op conformer for previews and development."}]},{"code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"ConsoleAnalyticsService","text":"`ConsoleAnalyticsService`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Logs every "},{"code":"track","type":"codeVoice"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"reset"},{"type":"text","text":"\/"},{"code":"flush","type":"codeVoice"},{"type":"text","text":" to "},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":", with a recursive pretty-printer for "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":". The recommended default before a vendor is chosen."}]},{"type":"codeListing","code":["public struct ConsoleAnalyticsService: AnalyticsService {","    public init(subsystem: String = \"Swidux\", category: String = \"Analytics\")","    \/\/ Each call logs one structured line; output visible in","    \/\/ the Xcode console and Console.app, quiet in Release.","}"],"syntax":"swift"},{"text":"Action semantics","type":"heading","level":2,"anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}]},{"text":"`track(AnalyticsEvent)`","type":"heading","level":3,"anchor":"trackAnalyticsEvent"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns an effect calling "},{"type":"codeVoice","code":"service.track(event)"},{"type":"text","text":", with "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached as the "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" property if the event doesn’t already specify one. Skipped entirely (returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":") when opted out. No state mutation."}]},{"text":"`screenView(String, properties:)`","type":"heading","level":3,"anchor":"screenViewString-properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" to the given name "},{"type":"strong","inlineContent":[{"text":"regardless of opt-out","type":"text"}]},{"type":"text","text":" (the screen state still progresses for when the user opts back in). Returns an effect calling "},{"type":"codeVoice","code":"service.track"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"\"screen_view\""},{"type":"text","text":" event whose properties include "},{"type":"codeVoice","code":"screen_name"},{"type":"text","text":" plus any extras. Skipped (returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":") when opted out."}]},{"text":"`identify(userID:, properties:)`","type":"heading","level":3,"anchor":"identifyuserID-properties"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID = userID"},{"text":" and returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.identify"},{"text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change.","type":"text"}]},{"text":"`alias(newID:, previousID:)`","type":"heading","level":3,"anchor":"aliasnewID-previousID"},{"type":"paragraph","inlineContent":[{"text":"No state mutation. Returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.alias"},{"text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID.","type":"text"}]},{"text":"`reset`","type":"heading","level":3,"anchor":"reset"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID = nil"},{"text":" and returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.reset()"},{"text":". Runs even when opted out — ","type":"text"},{"type":"codeVoice","code":"reset"},{"text":" is by definition a clean-slate operation.","type":"text"}]},{"text":"`setOptedOut(Bool)`","type":"heading","level":3,"anchor":"setOptedOutBool"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"setOptedOut(true)"},{"type":"text","text":" — Sets "},{"type":"codeVoice","code":"isOptedOut = true"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":", returns an effect that invokes "},{"type":"codeVoice","code":"onConsentChange(true)"},{"type":"text","text":" and then calls "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":" to clear server-side identity."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"setOptedOut(false)"},{"type":"text","text":" — Clears the flag. Returns an effect invoking "},{"type":"codeVoice","code":"onConsentChange(false)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when no hook is configured. Auto-identify on the next dispatch will re-establish identity."}]}]}]},{"text":"Consent","type":"heading","level":2,"anchor":"Consent"},{"type":"paragraph","inlineContent":[{"text":"Opting out is enforced ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"plugin-side"}]},{"text":": ","type":"text"},{"type":"codeVoice","code":"track"},{"text":", ","type":"text"},{"type":"codeVoice","code":"screenView"},{"text":", ","type":"text"},{"type":"codeVoice","code":"identify"},{"text":", ","type":"text"},{"type":"codeVoice","code":"alias"},{"text":", the mapper, and auto-identify all return early while ","type":"text"},{"type":"codeVoice","code":"isOptedOut"},{"text":", so nothing reaches the service. Only ","type":"text"},{"type":"codeVoice","code":"reset"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"flush"},{"text":" still pass through.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"That gate stops Swidux-dispatched events. It does not touch the vendor SDK’s own consent switch — so an SDK configured to collect automatic events, or one still holding a queue of its own, can keep sending after the user opts out. ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" deliberately stays at five members (consent APIs differ too much between vendors to abstract, and only the app knows which one it is using), so the bridge is the ","type":"text"},{"type":"codeVoice","code":"onConsentChange"},{"text":" closure.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Semantics: it fires on every ","type":"text"},{"type":"codeVoice","code":".setOptedOut"},{"text":" dispatch with the new value, and on opt-out it runs ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"service.reset()"},{"text":", so the SDK’s opt-out closes the tap before the reset hands it an identity change that is still eligible to be sent. Events already in flight are not retracted.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Treat this as required wiring for any vendor with a consent API, not an optional extra: without it, “opted out” means only that Swidux stopped sending. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},{"text":" Step 9 for the wiring.","type":"text"}]},{"text":"Mapper semantics","type":"heading","level":2,"anchor":"Mapper-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mapper runs in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action while the user is opted in. The plugin:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Skips entirely if the action is an "},{"code":"AnalyticsAction","type":"codeVoice"},{"type":"text","text":" (handled by "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" already, no double-tracking)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Skips when ","type":"text"},{"type":"codeVoice","code":"state.isOptedOut"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Calls ","type":"text"},{"type":"codeVoice","code":"mapper.map(state, action)"},{"text":" and tracks each returned event via ","type":"text"},{"type":"codeVoice","code":"service.track"},{"text":", with ","type":"text"},{"type":"codeVoice","code":"currentScreen"},{"text":" auto-attached as ","type":"text"},{"type":"codeVoice","code":"screen"},{"text":" (unless the event already provides its own ","type":"text"},{"type":"codeVoice","code":"screen"},{"text":").","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in.","type":"text"}]},{"level":2,"type":"heading","text":"Auto-identify semantics","anchor":"Auto-identify-semantics"},{"type":"paragraph","inlineContent":[{"text":"When configured with an ","type":"text"},{"type":"codeVoice","code":"AnalyticsIdentity"},{"text":", the plugin re-evaluates both the ","type":"text"},{"type":"codeVoice","code":"userID"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"userProperties"},{"text":" closures each non-analytics dispatch and diffs the pair ","type":"text"},{"type":"codeVoice","code":"(userID, userProperties)"},{"text":" against the last value sent to the service:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nil → \"u1\""},{"text":" (sign-in): updates ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":", fires "},{"type":"codeVoice","code":"service.identify(userID:\"u1\", properties:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"u1\" → \"u2\""},{"text":" (account switch): updates both, fires ","type":"text"},{"type":"codeVoice","code":"service.identify(userID:\"u2\", properties:)"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Stable userID, ","type":"text"},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" content changed: updates "},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"text":", fires ","type":"text"},{"type":"codeVoice","code":"service.identify(userID:, properties:)"},{"text":" with the new dictionary.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"u1\" → nil"},{"type":"text","text":" (sign-out): clears both, fires "},{"code":"service.reset()","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stable userID and stable "},{"code":"userProperties","type":"codeVoice"},{"type":"text","text":": no-op."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" is re-evaluated every non-analytics dispatch; dictionary equality decides whether to re-fire "},{"type":"codeVoice","code":"identify"},{"type":"text","text":". This keeps derived people-properties (subscription tier, paywall entitlements, feature flags) in sync with state without any explicit "},{"type":"codeVoice","code":".identify"},{"type":"text","text":" plumbing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When opted out, auto-identify is paused: neither "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" nor "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":" is updated. Opting back in re-establishes identity correctly on the next dispatch."}]},{"anchor":"Flushing","text":"Flushing","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnalyticsPlugin.flush()"},{"type":"text","text":" awaits any pending fire-and-forget service calls spawned by "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":", then calls "},{"type":"codeVoice","code":"service.flush()"},{"type":"text","text":". Call this on app shutdown to avoid losing in-flight events:"}]},{"syntax":"swift","type":"codeListing","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"]},{"anchor":"Implementing-an-AnalyticsService","text":"Implementing an `AnalyticsService`","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is provider-agnostic. Your conformer is responsible for translating "},{"type":"codeVoice","code":"AnalyticsEvent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" into whatever the backend SDK expects."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol has five methods, all "},{"type":"codeVoice","code":"async"},{"type":"text","text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical Mixpanel conformer holds a reference to the "},{"type":"codeVoice","code":"Mixpanel.Instance"},{"type":"text","text":" and translates "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" → "},{"type":"codeVoice","code":"MixpanelType"},{"type":"text","text":". An Amplitude conformer holds an "},{"type":"codeVoice","code":"Amplitude"},{"type":"text","text":" instance and translates to "},{"type":"codeVoice","code":"[String: Any]"},{"type":"text","text":". Either way, the plugin stays the same."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note what the protocol does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" require: no opt-out flag (the plugin handles that), no super-property machinery for "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" (the plugin handles that), and no event batching policy (your call)."}]}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"kind":"article","sections":[],"metadata":{"title":"SwiduxAnalytics Reference","role":"article","roleHeading":"Article","modules":[{"name":"Swidux"}]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://Swidux/documentation/Swidux/MacrosReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":