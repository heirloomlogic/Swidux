{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginanalyticsreference"]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"modules":[{"name":"Swidux"}],"title":"SwiduxAnalytics Reference","role":"article","roleHeading":"Article"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"generated":true,"anchor":"Reference"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":". Unlike the gate-style plugins ("},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":"), analytics is an "},{"type":"strong","inlineContent":[{"type":"text","text":"observer"}]},{"type":"text","text":": it watches actions flow by and emits events, but never blocks dispatch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two surfaces:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Mapper (passive)"}]},{"type":"text","text":" — App declares a "},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"type":"text","text":" closure once at registration. The plugin runs it in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action while the user is opted in."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" (explicit)"}]},{"type":"text","text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plus optional "},{"type":"strong","inlineContent":[{"type":"text","text":"auto-identify"}]},{"type":"text","text":": pass an "},{"type":"codeVoice","code":"AnalyticsIdentity"},{"type":"text","text":" keypath and the plugin watches userID transitions across dispatches, firing "},{"type":"codeVoice","code":"service.identify"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"service.reset"},{"type":"text","text":" automatically."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","type":"reference","isActive":true},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Library-target","text":"Library target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxAnalytics"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxAnalytics"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Provided-implementations","text":"Provided implementations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"MockAnalyticsService","type":"codeVoice"},{"text":" — silent no-op, for previews and tests.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ConsoleAnalyticsService","type":"codeVoice"},{"text":" — logs every call to ","type":"text"},{"code":"os.Logger","type":"codeVoice"},{"text":". Use this as the default ","type":"text"},{"code":"service:","type":"codeVoice"},{"text":" while the analytics vendor decision is still open: analytics wiring can be developed and QA-tested end to end with no SDK and no vendor commitment. Adopting a real provider later is the usual two-line change in ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For production Mixpanel integrations, the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},{"type":"text","text":" companion package provides:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" — an "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that forwards to the Mixpanel SDK and maps "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" to native Mixpanel types."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" — a Mixpanel-flavored mock for previews."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Full API documentation lives in the package’s own "},{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For other backends (Amplitude, PostHog, Segment, custom), implement "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" directly — see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},{"type":"text","text":" Step 3, Path B."}]},{"type":"heading","text":"Types","level":2,"anchor":"Types"},{"level":3,"type":"heading","text":"`AnalyticsPlugin<RootState, RootAction>`","anchor":"AnalyticsPlugin%3CRootState-RootAction%3E"},{"inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"type":"codeVoice","code":"AnalyticsState"},{"type":"text","text":" and an action enum typed as "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil,","    onConsentChange: (@Sendable (Bool) async -> Void)? = nil",")"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"onConsentChange"},{"type":"text","text":" fires on every "},{"type":"codeVoice","code":".setOptedOut"},{"type":"text","text":" dispatch with the new opted-out value. Use it to drive a vendor SDK’s own consent API — see "},{"type":"emphasis","inlineContent":[{"text":"Consent","type":"text"}]},{"text":" below.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" (not a struct) because it tracks pending fire-and-forget service calls so that "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" can deterministically await them — same reason "},{"type":"codeVoice","code":"PersistencePlugin"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UndoPlugin"},{"type":"text","text":" are classes."}]},{"type":"heading","text":"`AnalyticsState`","level":3,"anchor":"AnalyticsState"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" struct. The slice the plugin owns."}]},{"type":"codeListing","code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isOptedOut"},{"type":"text","text":" — App-controlled privacy flag. While "},{"type":"codeVoice","code":"true"},{"type":"text","text":", mapper events are dropped, explicit "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":" actions become no-ops, and auto-identify is paused."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" — The most recent screen recorded via "},{"type":"codeVoice","code":".screenView(_:)"},{"type":"text","text":", auto-attached as the "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" property on subsequent tracked events."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions."}],"type":"paragraph"}]}]},{"type":"heading","text":"`AnalyticsAction`","level":3,"anchor":"AnalyticsAction"},{"type":"codeListing","code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Convenience factories cover the common no-properties cases:"}]},{"type":"codeListing","code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"],"syntax":"swift"},{"type":"heading","text":"`AnalyticsEvent`","level":3,"anchor":"AnalyticsEvent"},{"type":"codeListing","code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"],"syntax":"swift"},{"type":"heading","text":"`AnalyticsValue`","level":3,"anchor":"AnalyticsValue"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Closed enum keeping the protocol provider-agnostic and "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":". Each service adapter maps these cases to its native property type."}]},{"type":"codeListing","code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Literal conformances keep call-sites clean:"}]},{"type":"codeListing","code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"],"syntax":"swift"},{"type":"heading","text":"`AnalyticsMapper<State, Action>`","level":3,"anchor":"AnalyticsMapper%3CState-Action%3E"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wraps the declarative "},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"type":"text","text":" closure."}]},{"type":"codeListing","code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. "},{"type":"codeVoice","code":".none"},{"type":"text","text":" is the default mapper for plugins that only use explicit "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" dispatches."}]},{"type":"heading","text":"`AnalyticsIdentity<State>`","level":3,"anchor":"AnalyticsIdentity%3CState%3E"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declarative source-of-truth for the active user’s identity."}]},{"type":"codeListing","code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The KeyPath convenience init is the typical shape: "},{"type":"codeVoice","code":"AnalyticsIdentity(userID: \\.auth.currentUserID)"},{"type":"text","text":"."}]},{"type":"heading","text":"`AnalyticsService` (protocol)","level":3,"anchor":"AnalyticsService-protocol"},{"type":"codeListing","code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"reset"},{"type":"text","text":" fire-and-forget; only "},{"type":"codeVoice","code":"flush"},{"type":"text","text":" is awaited."}]},{"type":"heading","text":"`MockAnalyticsService`","level":3,"anchor":"MockAnalyticsService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No-op conformer for previews and development."}]},{"type":"codeListing","code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"],"syntax":"swift"},{"type":"heading","text":"`ConsoleAnalyticsService`","level":3,"anchor":"ConsoleAnalyticsService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Logs every "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"reset"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"flush"},{"type":"text","text":" to "},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":", with a recursive pretty-printer for "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":". The recommended default before a vendor is chosen."}]},{"type":"codeListing","code":["public struct ConsoleAnalyticsService: AnalyticsService {","    public init(subsystem: String = \"Swidux\", category: String = \"Analytics\")","    \/\/ Each call logs one structured line; output visible in","    \/\/ the Xcode console and Console.app, quiet in Release.","}"],"syntax":"swift"},{"type":"heading","text":"Action semantics","level":2,"anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}]},{"type":"heading","text":"`track(AnalyticsEvent)`","level":3,"anchor":"trackAnalyticsEvent"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns an effect calling "},{"type":"codeVoice","code":"service.track(event)"},{"type":"text","text":", with "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached as the "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" property if the event doesn’t already specify one. Skipped entirely (returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":") when opted out. No state mutation."}]},{"type":"heading","text":"`screenView(String, properties:)`","level":3,"anchor":"screenViewString-properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" to the given name "},{"inlineContent":[{"text":"regardless of opt-out","type":"text"}],"type":"strong"},{"type":"text","text":" (the screen state still progresses for when the user opts back in). Returns an effect calling "},{"type":"codeVoice","code":"service.track"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"\"screen_view\""},{"type":"text","text":" event whose properties include "},{"type":"codeVoice","code":"screen_name"},{"type":"text","text":" plus any extras. Skipped (returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":") when opted out."}]},{"type":"heading","text":"`identify(userID:, properties:)`","level":3,"anchor":"identifyuserID-properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"lastIdentifiedUserID = userID"},{"type":"text","text":" and returns an effect calling "},{"type":"codeVoice","code":"service.identify"},{"type":"text","text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change."}]},{"type":"heading","text":"`alias(newID:, previousID:)`","level":3,"anchor":"aliasnewID-previousID"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No state mutation. Returns an effect calling "},{"type":"codeVoice","code":"service.alias"},{"type":"text","text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID."}]},{"type":"heading","text":"`reset`","level":3,"anchor":"reset"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"lastIdentifiedUserID = nil"},{"type":"text","text":" and returns an effect calling "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":". Runs even when opted out — "},{"type":"codeVoice","code":"reset"},{"type":"text","text":" is by definition a clean-slate operation."}]},{"type":"heading","text":"`setOptedOut(Bool)`","level":3,"anchor":"setOptedOutBool"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"setOptedOut(true)"},{"type":"text","text":" — Sets "},{"type":"codeVoice","code":"isOptedOut = true"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":", returns an effect that invokes "},{"type":"codeVoice","code":"onConsentChange(true)"},{"type":"text","text":" and then calls "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":" to clear server-side identity."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"setOptedOut(false)"},{"type":"text","text":" — Clears the flag. Returns an effect invoking "},{"type":"codeVoice","code":"onConsentChange(false)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when no hook is configured. Auto-identify on the next dispatch will re-establish identity."}],"type":"paragraph"}]}]},{"type":"heading","text":"Consent","level":2,"anchor":"Consent"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Opting out is enforced "},{"inlineContent":[{"text":"plugin-side","type":"text"}],"type":"emphasis"},{"type":"text","text":": "},{"type":"codeVoice","code":"track"},{"type":"text","text":", "},{"type":"codeVoice","code":"screenView"},{"type":"text","text":", "},{"type":"codeVoice","code":"identify"},{"type":"text","text":", "},{"type":"codeVoice","code":"alias"},{"type":"text","text":", the mapper, and auto-identify all return early while "},{"type":"codeVoice","code":"isOptedOut"},{"type":"text","text":", so nothing reaches the service. Only "},{"type":"codeVoice","code":"reset"},{"type":"text","text":" and "},{"type":"codeVoice","code":"flush"},{"type":"text","text":" still pass through."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That gate stops Swidux-dispatched events. It does not touch the vendor SDK’s own consent switch — so an SDK configured to collect automatic events, or one still holding a queue of its own, can keep sending after the user opts out. "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" deliberately stays at five members (consent APIs differ too much between vendors to abstract, and only the app knows which one it is using), so the bridge is the "},{"type":"codeVoice","code":"onConsentChange"},{"type":"text","text":" closure."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Semantics: it fires on every "},{"type":"codeVoice","code":".setOptedOut"},{"type":"text","text":" dispatch with the new value, and on opt-out it runs "},{"inlineContent":[{"text":"before","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":", so the SDK’s opt-out closes the tap before the reset hands it an identity change that is still eligible to be sent. Events already in flight are not retracted."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Treat this as required wiring for any vendor with a consent API, not an optional extra: without it, “opted out” means only that Swidux stopped sending. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},{"type":"text","text":" Step 9 for the wiring."}]},{"type":"heading","text":"Mapper semantics","level":2,"anchor":"Mapper-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mapper runs in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action while the user is opted in. The plugin:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Skips entirely if the action is an "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" (handled by "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" already, no double-tracking)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Skips when "},{"type":"codeVoice","code":"state.isOptedOut"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Calls "},{"type":"codeVoice","code":"mapper.map(state, action)"},{"type":"text","text":" and tracks each returned event via "},{"type":"codeVoice","code":"service.track"},{"type":"text","text":", with "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached as "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" (unless the event already provides its own "},{"type":"codeVoice","code":"screen"},{"type":"text","text":")."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in."}]},{"type":"heading","text":"Auto-identify semantics","level":2,"anchor":"Auto-identify-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When configured with an "},{"type":"codeVoice","code":"AnalyticsIdentity"},{"type":"text","text":", the plugin re-evaluates both the "},{"type":"codeVoice","code":"userID"},{"type":"text","text":" and "},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" closures each non-analytics dispatch and diffs the pair "},{"type":"codeVoice","code":"(userID, userProperties)"},{"type":"text","text":" against the last value sent to the service:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"nil → \"u1\""},{"type":"text","text":" (sign-in): updates "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":", fires "},{"type":"codeVoice","code":"service.identify(userID:\"u1\", properties:)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"\"u1\" → \"u2\""},{"type":"text","text":" (account switch): updates both, fires "},{"type":"codeVoice","code":"service.identify(userID:\"u2\", properties:)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Stable userID, "},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" content changed: updates "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":", fires "},{"type":"codeVoice","code":"service.identify(userID:, properties:)"},{"type":"text","text":" with the new dictionary."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"\"u1\" → nil"},{"type":"text","text":" (sign-out): clears both, fires "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Stable userID and stable "},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":": no-op."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" is re-evaluated every non-analytics dispatch; dictionary equality decides whether to re-fire "},{"type":"codeVoice","code":"identify"},{"type":"text","text":". This keeps derived people-properties (subscription tier, paywall entitlements, feature flags) in sync with state without any explicit "},{"type":"codeVoice","code":".identify"},{"type":"text","text":" plumbing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When opted out, auto-identify is paused: neither "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" nor "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":" is updated. Opting back in re-establishes identity correctly on the next dispatch."}]},{"type":"heading","text":"Flushing","level":2,"anchor":"Flushing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnalyticsPlugin.flush()"},{"type":"text","text":" awaits any pending fire-and-forget service calls spawned by "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":", then calls "},{"type":"codeVoice","code":"service.flush()"},{"type":"text","text":". Call this on app shutdown to avoid losing in-flight events:"}]},{"type":"codeListing","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"],"syntax":"swift"},{"type":"heading","text":"Implementing an `AnalyticsService`","level":2,"anchor":"Implementing-an-AnalyticsService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is provider-agnostic. Your conformer is responsible for translating "},{"type":"codeVoice","code":"AnalyticsEvent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" into whatever the backend SDK expects."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol has five methods, all "},{"type":"codeVoice","code":"async"},{"type":"text","text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical Mixpanel conformer holds a reference to the "},{"type":"codeVoice","code":"Mixpanel.Instance"},{"type":"text","text":" and translates "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" → "},{"type":"codeVoice","code":"MixpanelType"},{"type":"text","text":". An Amplitude conformer holds an "},{"type":"codeVoice","code":"Amplitude"},{"type":"text","text":" instance and translates to "},{"type":"codeVoice","code":"[String: Any]"},{"type":"text","text":". Either way, the plugin stays the same."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note what the protocol does "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" require: no opt-out flag (the plugin handles that), no super-property machinery for "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" (the plugin handles that), and no event batching policy (your call)."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"references":{"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"url":"\/documentation\/swidux\/pluginfeatureflagsreference","title":"SwiduxFeatureFlags Reference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","type":"topic"},"doc://Swidux/documentation/Swidux/MacrosReference":{"url":"\/documentation\/swidux\/macrosreference","title":"Macros","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":")."}],"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","type":"topic"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"url":"\/documentation\/swidux\/undoplugin","title":"UndoPlugin","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}]},"doc://Swidux/documentation/Swidux/Troubleshooting":{"url":"\/documentation\/swidux\/troubleshooting","title":"Troubleshooting","abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","type":"topic"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"url":"\/documentation\/swidux\/entitystoreguide","title":"EntityStore","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"topic"},"https://github.com/heirloomlogic/SwiduxMixpanelAnalytics":{"type":"link","titleInlineContent":[{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"}],"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","url":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"url":"\/documentation\/swidux\/keyvaluestoreguide","title":"KeyValueStore","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"kind":"article","role":"collectionGroup","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","type":"topic"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","url":"\/documentation\/swidux\/pluginarchitecture","title":"Plugin Architecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic","kind":"article","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"url":"\/documentation\/swidux\/pluginkillswitchreference","title":"SwiduxKillswitch Reference","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","type":"topic"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"url":"\/documentation\/swidux\/pluginparentalgatereference","title":"SwiduxParentalGate Reference","abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","type":"topic"},"doc://Swidux/documentation/Swidux/UndoRedo":{"url":"\/documentation\/swidux\/undoredo","title":"Undo \/ Redo","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"type":"text","text":"."}],"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"url":"\/documentation\/swidux\/howtoaddanalytics","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","kind":"article","type":"topic","title":"Add Analytics","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"role":"article"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"url":"\/documentation\/swidux\/persistencemiddlewareguide","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","kind":"article","title":"Persistence Middleware","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"role":"article"},"doc://Swidux/documentation/Swidux":{"role":"collection","url":"\/documentation\/swidux","title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}]},"https://heirloomlogic.github.io/SwiduxMixpanelAnalytics/documentation/swiduxmixpanelanalytics/":{"type":"link","titleInlineContent":[{"type":"text","text":"DocC reference"}],"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","title":"DocC reference","url":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/"},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","url":"\/documentation\/swidux\/gettingstarted","title":"Getting Started with Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","kind":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}]},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"url":"\/documentation\/swidux\/pluginpaywallreference","title":"SwiduxPaywall Reference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic"}}}