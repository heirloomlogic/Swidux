{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginanalyticsreference"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true,"anchor":"Reference","title":"Reference"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic "},{"code":"AnalyticsService","type":"codeVoice"},{"text":". Unlike the gate-style plugins (","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"text":"), analytics is an ","type":"text"},{"inlineContent":[{"type":"text","text":"observer"}],"type":"strong"},{"text":": it watches actions flow by and emits events, but never blocks dispatch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two surfaces:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Mapper (passive)"}]},{"type":"text","text":" — App declares a "},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"type":"text","text":" closure once at registration. The plugin runs it in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action while the user is opted in."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"AnalyticsAction"},{"text":" (explicit)","type":"text"}]},{"type":"text","text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plus optional "},{"inlineContent":[{"type":"text","text":"auto-identify"}],"type":"strong"},{"type":"text","text":": pass an "},{"type":"codeVoice","code":"AnalyticsIdentity"},{"type":"text","text":" keypath and the plugin watches userID transitions across dispatches, firing "},{"type":"codeVoice","code":"service.identify"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"service.reset"},{"type":"text","text":" automatically."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]},{"type":"heading","text":"Library target","anchor":"Library-target","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"code":"SwiduxAnalytics","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"code":"import SwiduxAnalytics","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":"."}]},{"type":"heading","text":"Provided implementations","anchor":"Provided-implementations","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"MockAnalyticsService","type":"codeVoice"},{"type":"text","text":" — silent no-op, for previews and tests."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"ConsoleAnalyticsService","type":"codeVoice"},{"type":"text","text":" — logs every call to "},{"code":"os.Logger","type":"codeVoice"},{"type":"text","text":". Use this as the default "},{"code":"service:","type":"codeVoice"},{"type":"text","text":" while the analytics vendor decision is still open: analytics wiring can be developed and QA-tested end to end with no SDK and no vendor commitment. Adopting a real provider later is the usual two-line change in "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For production Mixpanel integrations, the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},{"type":"text","text":" companion package provides:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" — an "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" conformer that forwards to the Mixpanel SDK and maps "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" to native Mixpanel types."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" — a Mixpanel-flavored mock for previews."}]}]}]},{"inlineContent":[{"text":"For other backends (Amplitude, PostHog, Segment, custom), implement ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" directly — see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","type":"reference"},{"text":" Step 3, Path B.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Types","anchor":"Types"},{"type":"heading","level":3,"text":"`AnalyticsPlugin<RootState, RootAction>`","anchor":"AnalyticsPlugin%3CRootState-RootAction%3E"},{"inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"code":"AnalyticsState","type":"codeVoice"},{"type":"text","text":" and an action enum typed as "},{"code":"AnalyticsAction","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is a "},{"code":"final class","type":"codeVoice"},{"text":" (not a struct) because it tracks pending fire-and-forget service calls so that ","type":"text"},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" can deterministically await them — same reason "},{"code":"PersistencePlugin","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UndoPlugin"},{"type":"text","text":" are classes."}]},{"anchor":"AnalyticsState","type":"heading","level":3,"text":"`AnalyticsState`"},{"type":"paragraph","inlineContent":[{"code":"Sendable","type":"codeVoice"},{"type":"text","text":", "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":" struct. The slice the plugin owns."}]},{"syntax":"swift","type":"codeListing","code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"isOptedOut","type":"codeVoice"},{"type":"text","text":" — App-controlled privacy flag. While "},{"type":"codeVoice","code":"true"},{"type":"text","text":", mapper events are dropped, explicit "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":" actions become no-ops, and auto-identify is paused."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"currentScreen","type":"codeVoice"},{"text":" — The most recent screen recorded via ","type":"text"},{"code":".screenView(_:)","type":"codeVoice"},{"type":"text","text":", auto-attached as the "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" property on subsequent tracked events."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"lastIdentifiedUserID"},{"text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions.","type":"text"}]}]}]},{"anchor":"AnalyticsAction","type":"heading","text":"`AnalyticsAction`","level":3},{"code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Convenience factories cover the common no-properties cases:"}],"type":"paragraph"},{"code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"text":"`AnalyticsEvent`","anchor":"AnalyticsEvent"},{"code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","anchor":"AnalyticsValue","level":3,"text":"`AnalyticsValue`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Closed enum keeping the protocol provider-agnostic and "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":". Each service adapter maps these cases to its native property type."}]},{"code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Literal conformances keep call-sites clean:"}]},{"type":"codeListing","syntax":"swift","code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"]},{"level":3,"anchor":"AnalyticsMapper%3CState-Action%3E","type":"heading","text":"`AnalyticsMapper<State, Action>`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wraps the declarative "},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"type":"text","text":" closure."}]},{"type":"codeListing","syntax":"swift","code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. "},{"type":"codeVoice","code":".none"},{"text":" is the default mapper for plugins that only use explicit ","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"type":"text","text":" dispatches."}]},{"level":3,"anchor":"AnalyticsIdentity%3CState%3E","type":"heading","text":"`AnalyticsIdentity<State>`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declarative source-of-truth for the active user’s identity."}]},{"syntax":"swift","type":"codeListing","code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The KeyPath convenience init is the typical shape: "},{"type":"codeVoice","code":"AnalyticsIdentity(userID: \\.auth.currentUserID)"},{"type":"text","text":"."}]},{"level":3,"anchor":"AnalyticsService-protocol","type":"heading","text":"`AnalyticsService` (protocol)"},{"syntax":"swift","type":"codeListing","code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"]},{"inlineContent":[{"type":"text","text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"reset"},{"type":"text","text":" fire-and-forget; only "},{"type":"codeVoice","code":"flush"},{"type":"text","text":" is awaited."}],"type":"paragraph"},{"text":"`MockAnalyticsService`","anchor":"MockAnalyticsService","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"No-op conformer for previews and development."}],"type":"paragraph"},{"code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"ConsoleAnalyticsService","text":"`ConsoleAnalyticsService`","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Logs every ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"reset","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"flush","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"os.Logger","type":"codeVoice"},{"text":", with a recursive pretty-printer for ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":". The recommended default before a vendor is chosen.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct ConsoleAnalyticsService: AnalyticsService {","    public init(subsystem: String = \"Swidux\", category: String = \"Analytics\")","    \/\/ Each call logs one structured line; output visible in","    \/\/ the Xcode console and Console.app, quiet in Release.","}"]},{"type":"heading","text":"Action semantics","anchor":"Action-semantics","level":2},{"type":"paragraph","inlineContent":[{"text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns.","type":"text"}]},{"type":"heading","text":"`track(AnalyticsEvent)`","anchor":"trackAnalyticsEvent","level":3},{"type":"paragraph","inlineContent":[{"text":"Returns an effect calling ","type":"text"},{"code":"service.track(event)","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"text":" auto-attached as the ","type":"text"},{"code":"screen","type":"codeVoice"},{"text":" property if the event doesn’t already specify one. Skipped entirely (returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":") when opted out. No state mutation.","type":"text"}]},{"type":"heading","text":"`screenView(String, properties:)`","anchor":"screenViewString-properties","level":3},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"text":" to the given name ","type":"text"},{"inlineContent":[{"text":"regardless of opt-out","type":"text"}],"type":"strong"},{"text":" (the screen state still progresses for when the user opts back in). Returns an effect calling ","type":"text"},{"code":"service.track","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"\"screen_view\"","type":"codeVoice"},{"text":" event whose properties include ","type":"text"},{"code":"screen_name","type":"codeVoice"},{"text":" plus any extras. Skipped (returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":") when opted out.","type":"text"}]},{"type":"heading","text":"`identify(userID:, properties:)`","anchor":"identifyuserID-properties","level":3},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"lastIdentifiedUserID = userID"},{"type":"text","text":" and returns an effect calling "},{"type":"codeVoice","code":"service.identify"},{"type":"text","text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change."}],"type":"paragraph"},{"text":"`alias(newID:, previousID:)`","anchor":"aliasnewID-previousID","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"No state mutation. Returns an effect calling "},{"type":"codeVoice","code":"service.alias"},{"type":"text","text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID."}],"type":"paragraph"},{"type":"heading","text":"`reset`","anchor":"reset","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"lastIdentifiedUserID = nil","type":"codeVoice"},{"text":" and returns an effect calling ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":". Runs even when opted out — ","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" is by definition a clean-slate operation.","type":"text"}]},{"level":3,"anchor":"setOptedOutBool","type":"heading","text":"`setOptedOut(Bool)`"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"setOptedOut(true)"},{"type":"text","text":" — Sets "},{"type":"codeVoice","code":"isOptedOut = true"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":", returns an effect calling "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":" to clear server-side identity."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"setOptedOut(false)"},{"type":"text","text":" — Clears the flag without a service call. Auto-identify on the next dispatch will re-establish identity."}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Mapper-semantics","text":"Mapper semantics","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The mapper runs in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action while the user is opted in. The plugin:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Skips entirely if the action is an "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" (handled by "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" already, no double-tracking)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Skips when ","type":"text"},{"code":"state.isOptedOut","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Calls "},{"code":"mapper.map(state, action)","type":"codeVoice"},{"type":"text","text":" and tracks each returned event via "},{"type":"codeVoice","code":"service.track"},{"type":"text","text":", with "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached as "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" (unless the event already provides its own "},{"type":"codeVoice","code":"screen"},{"type":"text","text":")."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in."}]},{"type":"heading","text":"Auto-identify semantics","anchor":"Auto-identify-semantics","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When configured with an "},{"code":"AnalyticsIdentity","type":"codeVoice"},{"type":"text","text":", the plugin re-evaluates both the "},{"code":"userID","type":"codeVoice"},{"type":"text","text":" and "},{"code":"userProperties","type":"codeVoice"},{"type":"text","text":" closures each non-analytics dispatch and diffs the pair "},{"code":"(userID, userProperties)","type":"codeVoice"},{"type":"text","text":" against the last value sent to the service:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nil → \"u1\""},{"type":"text","text":" (sign-in): updates "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" \/ "},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"text":", fires ","type":"text"},{"code":"service.identify(userID:\"u1\", properties:)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"u1\" → \"u2\""},{"type":"text","text":" (account switch): updates both, fires "},{"type":"codeVoice","code":"service.identify(userID:\"u2\", properties:)"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Stable userID, "},{"code":"userProperties","type":"codeVoice"},{"type":"text","text":" content changed: updates "},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"type":"text","text":", fires "},{"code":"service.identify(userID:, properties:)","type":"codeVoice"},{"type":"text","text":" with the new dictionary."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"\"u1\" → nil","type":"codeVoice"},{"text":" (sign-out): clears both, fires ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Stable userID and stable ","type":"text"},{"code":"userProperties","type":"codeVoice"},{"text":": no-op.","type":"text"}]}]}]},{"inlineContent":[{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" is re-evaluated every non-analytics dispatch; dictionary equality decides whether to re-fire "},{"type":"codeVoice","code":"identify"},{"type":"text","text":". This keeps derived people-properties (subscription tier, paywall entitlements, feature flags) in sync with state without any explicit "},{"type":"codeVoice","code":".identify"},{"type":"text","text":" plumbing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When opted out, auto-identify is paused: neither "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" nor "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":" is updated. Opting back in re-establishes identity correctly on the next dispatch."}],"type":"paragraph"},{"level":2,"anchor":"Flushing","text":"Flushing","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"AnalyticsPlugin.flush()"},{"type":"text","text":" awaits any pending fire-and-forget service calls spawned by "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":", then calls "},{"type":"codeVoice","code":"service.flush()"},{"type":"text","text":". Call this on app shutdown to avoid losing in-flight events:"}],"type":"paragraph"},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Implementing-an-AnalyticsService","text":"Implementing an `AnalyticsService`","type":"heading"},{"inlineContent":[{"type":"text","text":"The plugin is provider-agnostic. Your conformer is responsible for translating "},{"type":"codeVoice","code":"AnalyticsEvent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" into whatever the backend SDK expects."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The protocol has five methods, all "},{"type":"codeVoice","code":"async"},{"type":"text","text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A typical Mixpanel conformer holds a reference to the "},{"type":"codeVoice","code":"Mixpanel.Instance"},{"type":"text","text":" and translates "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" → "},{"type":"codeVoice","code":"MixpanelType"},{"type":"text","text":". An Amplitude conformer holds an "},{"type":"codeVoice","code":"Amplitude"},{"type":"text","text":" instance and translates to "},{"type":"codeVoice","code":"[String: Any]"},{"type":"text","text":". Either way, the plugin stays the same."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Note what the protocol does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" require: no opt-out flag (the plugin handles that), no super-property machinery for "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" (the plugin handles that), and no event batching policy (your call)."}],"type":"paragraph"}]}],"metadata":{"role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"SwiduxAnalytics Reference"},"references":{"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","title":"Plugin Architecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","url":"\/documentation\/swidux\/pluginarchitecture","type":"topic"},"https://github.com/heirloomlogic/SwiduxMixpanelAnalytics":{"titleInlineContent":[{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"}],"type":"link","url":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"role":"article","title":"Persistence Middleware","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","url":"\/documentation\/swidux\/persistencemiddlewareguide","type":"topic"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"role":"collectionGroup","title":"KeyValueStore","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","url":"\/documentation\/swidux\/keyvaluestoreguide","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"role":"article","title":"Add Analytics","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","url":