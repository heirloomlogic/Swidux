{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginanalyticsreference"]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"SwiduxAnalytics Reference"},"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"generated":true,"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"title":"Reference"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":". Unlike the gate-style plugins ("},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":"), analytics is an "},{"type":"strong","inlineContent":[{"type":"text","text":"observer"}]},{"type":"text","text":": it watches actions flow by and emits events, but never blocks dispatch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two surfaces:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Mapper (passive)","type":"text"}],"type":"strong"},{"text":" — App declares a ","type":"text"},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"text":" closure once at registration. The plugin runs it in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action while the user is opted in.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"AnalyticsAction","type":"codeVoice"},{"text":" (explicit)","type":"text"}],"type":"strong"},{"text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plus optional "},{"type":"strong","inlineContent":[{"type":"text","text":"auto-identify"}]},{"type":"text","text":": pass an "},{"code":"AnalyticsIdentity","type":"codeVoice"},{"type":"text","text":" keypath and the plugin watches userID transitions across dispatches, firing "},{"code":"service.identify","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"service.reset","type":"codeVoice"},{"type":"text","text":" automatically."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"Library target","anchor":"Library-target"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Import: ","type":"text"},{"type":"codeVoice","code":"import SwiduxAnalytics"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"text":" alongside ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Provided implementations","anchor":"Provided-implementations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin ships with "},{"type":"codeVoice","code":"MockAnalyticsService"},{"type":"text","text":" for previews and tests. For production Mixpanel integrations, the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},{"type":"text","text":" companion package provides:"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" — an "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that forwards to the Mixpanel SDK and maps "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" to native Mixpanel types."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" — a Mixpanel-flavored mock for previews."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"For other backends (Amplitude, PostHog, Segment, custom), implement ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" directly — see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},{"text":" Step 3, Path B.","type":"text"}]},{"text":"Types","level":2,"type":"heading","anchor":"Types"},{"level":3,"anchor":"AnalyticsPlugin%3CRootState-RootAction%3E","type":"heading","text":"`AnalyticsPlugin<RootState, RootAction>`"},{"type":"paragraph","inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"text":" ","type":"text"},{"code":"final class","type":"codeVoice"},{"type":"text","text":" "},{"code":"SwiduxPlugin","type":"codeVoice"},{"text":" conformer. Owns a slice of root state typed as ","type":"text"},{"code":"AnalyticsState","type":"codeVoice"},{"type":"text","text":" and an action enum typed as "},{"code":"AnalyticsAction","type":"codeVoice"},{"type":"text","text":"."}]},{"code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil",")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is a "},{"code":"final class","type":"codeVoice"},{"type":"text","text":" (not a struct) because it tracks pending fire-and-forget service calls so that "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" can deterministically await them — same reason "},{"code":"PersistencePlugin","type":"codeVoice"},{"type":"text","text":" and "},{"code":"UndoPlugin","type":"codeVoice"},{"type":"text","text":" are classes."}]},{"text":"`AnalyticsState`","anchor":"AnalyticsState","level":3,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Sendable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" struct. The slice the plugin owns.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"],"type":"codeListing"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isOptedOut"},{"type":"text","text":" — App-controlled privacy flag. While "},{"code":"true","type":"codeVoice"},{"type":"text","text":", mapper events are dropped, explicit "},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":" actions become no-ops, and auto-identify is paused."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"currentScreen","type":"codeVoice"},{"text":" — The most recent screen recorded via ","type":"text"},{"code":".screenView(_:)","type":"codeVoice"},{"text":", auto-attached as the ","type":"text"},{"code":"screen","type":"codeVoice"},{"type":"text","text":" property on subsequent tracked events."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"lastIdentifiedUserID","type":"codeVoice"},{"type":"text","text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions."}]}]}]},{"type":"heading","text":"`AnalyticsAction`","level":3,"anchor":"AnalyticsAction"},{"syntax":"swift","type":"codeListing","code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"]},{"type":"paragraph","inlineContent":[{"text":"Convenience factories cover the common no-properties cases:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"]},{"type":"heading","text":"`AnalyticsEvent`","level":3,"anchor":"AnalyticsEvent"},{"syntax":"swift","type":"codeListing","code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"]},{"anchor":"AnalyticsValue","text":"`AnalyticsValue`","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Closed enum keeping the protocol provider-agnostic and "},{"type":"codeVoice","code":"Sendable"},{"text":". Each service adapter maps these cases to its native property type.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Literal conformances keep call-sites clean:"}]},{"code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"],"syntax":"swift","type":"codeListing"},{"anchor":"AnalyticsMapper%3CState-Action%3E","text":"`AnalyticsMapper<State, Action>`","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Wraps the declarative ","type":"text"},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"text":" closure.","type":"text"}]},{"code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Returning an empty array is the no-op case. ","type":"text"},{"code":".none","type":"codeVoice"},{"type":"text","text":" is the default mapper for plugins that only use explicit "},{"code":"AnalyticsAction","type":"codeVoice"},{"type":"text","text":" dispatches."}]},{"level":3,"type":"heading","text":"`AnalyticsIdentity<State>`","anchor":"AnalyticsIdentity%3CState%3E"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declarative source-of-truth for the active user’s identity."}]},{"syntax":"swift","type":"codeListing","code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The KeyPath convenience init is the typical shape: "},{"type":"codeVoice","code":"AnalyticsIdentity(userID: \\.auth.currentUserID)"},{"type":"text","text":"."}]},{"text":"`AnalyticsService` (protocol)","type":"heading","anchor":"AnalyticsService-protocol","level":3},{"syntax":"swift","type":"codeListing","code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"reset"},{"type":"text","text":" fire-and-forget; only "},{"code":"flush","type":"codeVoice"},{"type":"text","text":" is awaited."}]},{"text":"`MockAnalyticsService`","type":"heading","anchor":"MockAnalyticsService","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"No-op conformer for previews and development."}]},{"syntax":"swift","type":"codeListing","code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"]},{"level":2,"anchor":"Action-semantics","type":"heading","text":"Action semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}]},{"level":3,"anchor":"trackAnalyticsEvent","type":"heading","text":"`track(AnalyticsEvent)`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns an effect calling "},{"type":"codeVoice","code":"service.track(event)"},{"type":"text","text":", with "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached as the "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" property if the event doesn’t already specify one. Skipped entirely (returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":") when opted out. No state mutation."}]},{"text":"`screenView(String, properties:)`","type":"heading","anchor":"screenViewString-properties","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" to the given name "},{"type":"strong","inlineContent":[{"text":"regardless of opt-out","type":"text"}]},{"type":"text","text":" (the screen state still progresses for when the user opts back in). Returns an effect calling "},{"code":"service.track","type":"codeVoice"},{"type":"text","text":" with a "},{"code":"\"screen_view\"","type":"codeVoice"},{"type":"text","text":" event whose properties include "},{"code":"screen_name","type":"codeVoice"},{"type":"text","text":" plus any extras. Skipped (returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":") when opted out."}]},{"level":3,"anchor":"identifyuserID-properties","type":"heading","text":"`identify(userID:, properties:)`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID = userID"},{"text":" and returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.identify"},{"text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change.","type":"text"}]},{"level":3,"anchor":"aliasnewID-previousID","type":"heading","text":"`alias(newID:, previousID:)`"},{"type":"paragraph","inlineContent":[{"text":"No state mutation. Returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.alias"},{"text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID.","type":"text"}]},{"level":3,"anchor":"reset","type":"heading","text":"`reset`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID = nil"},{"text":" and returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.reset()"},{"text":". Runs even when opted out — ","type":"text"},{"type":"codeVoice","code":"reset"},{"text":" is by definition a clean-slate operation.","type":"text"}]},{"level":3,"anchor":"setOptedOutBool","type":"heading","text":"`setOptedOut(Bool)`"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"setOptedOut(true)","type":"codeVoice"},{"text":" — Sets ","type":"text"},{"code":"isOptedOut = true","type":"codeVoice"},{"text":", clears ","type":"text"},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":", returns an effect calling ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":" to clear server-side identity.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"setOptedOut(false)","type":"codeVoice"},{"text":" — Clears the flag without a service call. Auto-identify on the next dispatch will re-establish identity.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Mapper-semantics","type":"heading","text":"Mapper semantics"},{"type":"paragraph","inlineContent":[{"text":"The mapper runs in ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":" for every non-analytics action while the user is opted in. The plugin:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Skips entirely if the action is an ","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"text":" (handled by ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" already, no double-tracking).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Skips when ","type":"text"},{"code":"state.isOptedOut","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Calls ","type":"text"},{"code":"mapper.map(state, action)","type":"codeVoice"},{"text":" and tracks each returned event via ","type":"text"},{"code":"service.track","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"text":" auto-attached as ","type":"text"},{"code":"screen","type":"codeVoice"},{"text":" (unless the event already provides its own ","type":"text"},{"code":"screen","type":"codeVoice"},{"text":").","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in.","type":"text"}]},{"level":2,"anchor":"Auto-identify-semantics","type":"heading","text":"Auto-identify semantics"},{"type":"paragraph","inlineContent":[{"text":"When configured with an ","type":"text"},{"type":"codeVoice","code":"AnalyticsIdentity"},{"text":", the plugin re-evaluates both the ","type":"text"},{"type":"codeVoice","code":"userID"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"userProperties"},{"text":" closures each non-analytics dispatch and diffs the pair ","type":"text"},{"type":"codeVoice","code":"(userID, userProperties)"},{"text":" against the last value sent to the service:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"nil → \"u1\"","type":"codeVoice"},{"text":" (sign-in): updates ","type":"text"},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"text":", fires ","type":"text"},{"code":"service.identify(userID:\"u1\", properties:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"\"u1\" → \"u2\"","type":"codeVoice"},{"text":" (account switch): updates both, fires ","type":"text"},{"code":"service.identify(userID:\"u2\", properties:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Stable userID, ","type":"text"},{"code":"userProperties","type":"codeVoice"},{"text":" content changed: updates ","type":"text"},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"text":", fires ","type":"text"},{"code":"service.identify(userID:, properties:)","type":"codeVoice"},{"text":" with the new dictionary.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"\"u1\" → nil","type":"codeVoice"},{"text":" (sign-out): clears both, fires ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Stable userID and stable ","type":"text"},{"code":"userProperties","type":"codeVoice"},{"text":": no-op.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"userProperties"},{"text":" is re-evaluated every non-analytics dispatch; dictionary equality decides whether to re-fire ","type":"text"},{"type":"codeVoice","code":"identify"},{"text":". This keeps derived people-properties (subscription tier, paywall entitlements, feature flags) in sync with state without any explicit ","type":"text"},{"type":"codeVoice","code":".identify"},{"text":" plumbing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When opted out, auto-identify is paused: neither ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"text":" nor ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"text":" is updated. Opting back in re-establishes identity correctly on the next dispatch.","type":"text"}]},{"level":2,"anchor":"Flushing","type":"heading","text":"Flushing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnalyticsPlugin.flush()"},{"text":" awaits any pending fire-and-forget service calls spawned by ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":", then calls ","type":"text"},{"type":"codeVoice","code":"service.flush()"},{"text":". Call this on app shutdown to avoid losing in-flight events:","type":"text"}]},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Implementing-an-AnalyticsService","type":"heading","text":"Implementing an `AnalyticsService`"},{"type":"paragraph","inlineContent":[{"text":"The plugin is provider-agnostic. Your conformer is responsible for translating ","type":"text"},{"type":"codeVoice","code":"AnalyticsEvent"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"AnalyticsValue"},{"text":" into whatever the backend SDK expects.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The protocol has five methods, all ","type":"text"},{"type":"codeVoice","code":"async"},{"text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A typical Mixpanel conformer holds a reference to the ","type":"text"},{"type":"codeVoice","code":"Mixpanel.Instance"},{"text":" and translates ","type":"text"},{"type":"codeVoice","code":"AnalyticsValue"},{"text":" → ","type":"text"},{"type":"codeVoice","code":"MixpanelType"},{"text":". An Amplitude conformer holds an ","type":"text"},{"type":"codeVoice","code":"Amplitude"},{"text":" instance and translates to ","type":"text"},{"type":"codeVoice","code":"[String: Any]"},{"text":". Either way, the plugin stays the same.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note what the protocol does ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"text":" require: no opt-out flag (the plugin handles that), no super-property machinery for ","type":"text"},{"type":"codeVoice","code":"currentScreen"},{"text":" (the plugin handles that), and no event batching policy (your call).","type":"text"}]}]}]