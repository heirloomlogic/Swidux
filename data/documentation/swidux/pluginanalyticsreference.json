{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":". Unlike the gate-style plugins ("},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":"), analytics is an "},{"inlineContent":[{"type":"text","text":"observer"}],"type":"strong"},{"type":"text","text":": it watches actions flow by and emits events, but never blocks dispatch."}]},{"type":"paragraph","inlineContent":[{"text":"Two surfaces:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Mapper (passive)","type":"text"}]},{"text":" — App declares a ","type":"text"},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"text":" closure once at registration. The plugin runs it in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action while the user is opted in.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" (explicit)"}]},{"type":"text","text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Plus optional ","type":"text"},{"inlineContent":[{"text":"auto-identify","type":"text"}],"type":"strong"},{"text":": pass an ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":" keypath and the plugin watches userID transitions across dispatches, firing ","type":"text"},{"code":"service.identify","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"service.reset","type":"codeVoice"},{"text":" automatically.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Library target","anchor":"Library-target"},{"items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxAnalytics","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Provided-implementations","text":"Provided implementations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin ships with "},{"type":"codeVoice","code":"MockAnalyticsService"},{"type":"text","text":" for previews and tests. For production Mixpanel integrations, the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},{"type":"text","text":" companion package provides:"}]},{"items":[{"content":[{"inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" — an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that forwards to the Mixpanel SDK and maps ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" to native Mixpanel types.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"text":" — a Mixpanel-flavored mock for previews.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For other backends (Amplitude, PostHog, Segment, custom), implement "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" directly — see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},{"type":"text","text":" Step 3, Path B."}]},{"type":"heading","level":2,"anchor":"Types","text":"Types"},{"type":"heading","level":3,"anchor":"AnalyticsPlugin%3CRootState-RootAction%3E","text":"`AnalyticsPlugin<RootState, RootAction>`"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"type":"codeVoice","code":"AnalyticsState"},{"type":"text","text":" and an action enum typed as "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":"."}]},{"code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil",")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" (not a struct) because it tracks pending fire-and-forget service calls so that "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" can deterministically await them — same reason "},{"type":"codeVoice","code":"PersistencePlugin"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UndoPlugin"},{"type":"text","text":" are classes."}]},{"type":"heading","level":3,"anchor":"AnalyticsState","text":"`AnalyticsState`"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" struct. The slice the plugin owns."}]},{"code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"code":"isOptedOut","type":"codeVoice"},{"text":" — App-controlled privacy flag. While ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", mapper events are dropped, explicit ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" actions become no-ops, and auto-identify is paused.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"currentScreen","type":"codeVoice"},{"text":" — The most recent screen recorded via ","type":"text"},{"code":".screenView(_:)","type":"codeVoice"},{"text":", auto-attached as the ","type":"text"},{"code":"screen","type":"codeVoice"},{"text":" property on subsequent tracked events.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","level":3,"anchor":"AnalyticsAction","text":"`AnalyticsAction`"},{"code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Convenience factories cover the common no-properties cases:"}]},{"code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":3,"anchor":"AnalyticsEvent","text":"`AnalyticsEvent`"},{"code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":3,"anchor":"AnalyticsValue","text":"`AnalyticsValue`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Closed enum keeping the protocol provider-agnostic and "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":". Each service adapter maps these cases to its native property type."}]},{"code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Literal conformances keep call-sites clean:"}]},{"code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":3,"anchor":"AnalyticsMapper%3CState-Action%3E","text":"`AnalyticsMapper<State, Action>`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wraps the declarative "},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"type":"text","text":" closure."}]},{"code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. "},{"type":"codeVoice","code":".none"},{"type":"text","text":" is the default mapper for plugins that only use explicit "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" dispatches."}]},{"type":"heading","level":3,"anchor":"AnalyticsIdentity%3CState%3E","text":"`AnalyticsIdentity<State>`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declarative source-of-truth for the active user’s identity."}]},{"code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The KeyPath convenience init is the typical shape: "},{"type":"codeVoice","code":"AnalyticsIdentity(userID: \\.auth.currentUserID)"},{"type":"text","text":"."}]},{"type":"heading","level":3,"anchor":"AnalyticsService-protocol","text":"`AnalyticsService` (protocol)"},{"code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"reset"},{"type":"text","text":" fire-and-forget; only "},{"type":"codeVoice","code":"flush"},{"type":"text","text":" is awaited."}]},{"type":"heading","level":3,"anchor":"MockAnalyticsService","text":"`MockAnalyticsService`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No-op conformer for previews and development."}]},{"code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"anchor":"Action-semantics","text":"Action semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}]},{"type":"heading","level":3,"anchor":"trackAnalyticsEvent","text":"`track(AnalyticsEvent)`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns an effect calling "},{"type":"codeVoice","code":"service.track(event)"},{"type":"text","text":", with "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached as the "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" property if the event doesn’t already specify one. Skipped entirely (returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":") when opted out. No state mutation."}]},{"type":"heading","level":3,"anchor":"screenViewString-properties","text":"`screenView(String, properties:)`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" to the given name "},{"inlineContent":[{"text":"regardless of opt-out","type":"text"}],"type":"strong"},{"type":"text","text":" (the screen state still progresses for when the user opts back in). Returns an effect calling "},{"type":"codeVoice","code":"service.track"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"\"screen_view\""},{"type":"text","text":" event whose properties include "},{"type":"codeVoice","code":"screen_name"},{"type":"text","text":" plus any extras. Skipped (returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":") when opted out."}]},{"type":"heading","level":3,"anchor":"identifyuserID-properties","text":"`identify(userID:, properties:)`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"lastIdentifiedUserID = userID"},{"type":"text","text":" and returns an effect calling "},{"type":"codeVoice","code":"service.identify"},{"type":"text","text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change."}]},{"type":"heading","level":3,"anchor":"aliasnewID-previousID","text":"`alias(newID:, previousID:)`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No state mutation. Returns an effect calling "},{"type":"codeVoice","code":"service.alias"},{"type":"text","text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID."}]},{"type":"heading","level":3,"anchor":"reset","text":"`reset`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"lastIdentifiedUserID = nil"},{"type":"text","text":" and returns an effect calling "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":". Runs even when opted out — "},{"type":"codeVoice","code":"reset"},{"type":"text","text":" is by definition a clean-slate operation."}]},{"type":"heading","level":3,"anchor":"setOptedOutBool","text":"`setOptedOut(Bool)`"},{"items":[{"content":[{"inlineContent":[{"code":"setOptedOut(true)","type":"codeVoice"},{"text":" — Sets ","type":"text"},{"code":"isOptedOut = true","type":"codeVoice"},{"text":", clears ","type":"text"},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":", returns an effect calling ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":" to clear server-side identity.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"setOptedOut(false)","type":"codeVoice"},{"text":" — Clears the flag without a service call. Auto-identify on the next dispatch will re-establish identity.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","level":2,"anchor":"Mapper-semantics","text":"Mapper semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mapper runs in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action while the user is opted in. The plugin:"}]},{"items":[{"content":[{"inlineContent":[{"text":"Skips entirely if the action is an ","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"text":" (handled by ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" already, no double-tracking).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Skips when ","type":"text"},{"code":"state.isOptedOut","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Calls ","type":"text"},{"code":"mapper.map(state, action)","type":"codeVoice"},{"text":" and tracks each returned event via ","type":"text"},{"code":"service.track","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"text":" auto-attached as ","type":"text"},{"code":"screen","type":"codeVoice"},{"text":" (unless the event already provides its own ","type":"text"},{"code":"screen","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in."}]},{"type":"heading","level":2,"anchor":"Auto-identify-semantics","text":"Auto-identify semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When configured with an "},{"type":"codeVoice","code":"AnalyticsIdentity"},{"type":"text","text":", the plugin re-evaluates both the "},{"type":"codeVoice","code":"userID"},{"type":"text","text":" and "},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" closures each non-analytics dispatch and diffs the pair "},{"type":"codeVoice","code":"(userID, userProperties)"},{"type":"text","text":" against the last value sent to the service:"}]},{"items":[{"content":[{"inlineContent":[{"code":"nil → \"u1\"","type":"codeVoice"},{"text":" (sign-in): updates ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":", fires "},{"type":"codeVoice","code":"service.identify(userID:\"u1\", properties:)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"\"u1\" → \"u2\"","type":"codeVoice"},{"type":"text","text":" (account switch): updates both, fires "},{"code":"service.identify(userID:\"u2\", properties:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Stable userID, "},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" content changed: updates "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":", fires "},{"type":"codeVoice","code":"service.identify(userID:, properties:)"},{"type":"text","text":" with the new dictionary."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"\"u1\" → nil","type":"codeVoice"},{"type":"text","text":" (sign-out): clears both, fires "},{"code":"service.reset()","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Stable userID and stable ","type":"text"},{"code":"userProperties","type":"codeVoice"},{"text":": no-op.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"code":"userProperties","type":"codeVoice"},{"type":"text","text":" is re-evaluated every non-analytics dispatch; dictionary equality decides whether to re-fire "},{"code":"identify","type":"codeVoice"},{"type":"text","text":". This keeps derived people-properties (subscription tier, paywall entitlements, feature flags) in sync with state without any explicit "},{"code":".identify","type":"codeVoice"},{"type":"text","text":" plumbing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When opted out, auto-identify is paused: neither "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" nor "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":" is updated. Opting back in re-establishes identity correctly on the next dispatch."}]},{"level":2,"type":"heading","text":"Flushing","anchor":"Flushing"},{"inlineContent":[{"code":"AnalyticsPlugin.flush()","type":"codeVoice"},{"text":" awaits any pending fire-and-forget service calls spawned by ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":", then calls ","type":"text"},{"code":"service.flush()","type":"codeVoice"},{"type":"text","text":". Call this on app shutdown to avoid losing in-flight events:"}],"type":"paragraph"},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Implementing an `AnalyticsService`","anchor":"Implementing-an-AnalyticsService"},{"inlineContent":[{"type":"text","text":"The plugin is provider-agnostic. Your conformer is responsible for translating "},{"code":"AnalyticsEvent","type":"codeVoice"},{"type":"text","text":" and "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" into whatever the backend SDK expects."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The protocol has five methods, all "},{"code":"async","type":"codeVoice"},{"type":"text","text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical Mixpanel conformer holds a reference to the "},{"type":"codeVoice","code":"Mixpanel.Instance"},{"type":"text","text":" and translates "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" → "},{"type":"codeVoice","code":"MixpanelType"},{"type":"text","text":". An Amplitude conformer holds an "},{"type":"codeVoice","code":"Amplitude"},{"type":"text","text":" instance and translates to "},{"type":"codeVoice","code":"[String: Any]"},{"type":"text","text":". Either way, the plugin stays the same."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note what the protocol does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" require: no opt-out flag (the plugin handles that), no super-property machinery for "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" (the plugin handles that), and no event batching policy (your call)."}]}],"kind":"content"}],"sections":[],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true,"anchor":"Reference"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginanalyticsreference"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"SwiduxAnalytics Reference","modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article"},"kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider