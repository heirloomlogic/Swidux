{"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"generated":true}],"metadata":{"title":"SwiduxAnalytics Reference","modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article"},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":". Unlike the gate-style plugins (","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":"), analytics is an ","type":"text"},{"inlineContent":[{"text":"observer","type":"text"}],"type":"strong"},{"text":": it watches actions flow by and emits events, but never blocks dispatch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two surfaces:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Mapper (passive)","type":"text"}]},{"type":"text","text":" — App declares a "},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"type":"text","text":" closure once at registration. The plugin runs it in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action while the user is opted in."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"AnalyticsAction","type":"codeVoice"},{"text":" (explicit)","type":"text"}]},{"type":"text","text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Plus optional ","type":"text"},{"inlineContent":[{"text":"auto-identify","type":"text"}],"type":"strong"},{"text":": pass an ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":" keypath and the plugin watches userID transitions across dispatches, firing ","type":"text"},{"code":"service.identify","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"service.reset","type":"codeVoice"},{"text":" automatically.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true,"type":"reference"},{"text":". For where this plugin sits in the lifecycle, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"text":"Library target","type":"heading","anchor":"Library-target","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxAnalytics"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxAnalytics"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target dependencies in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" alongside ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"Provided implementations","type":"heading","anchor":"Provided-implementations","level":2},{"type":"paragraph","inlineContent":[{"text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MockAnalyticsService"},{"type":"text","text":" — silent no-op, for previews and tests."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ConsoleAnalyticsService"},{"type":"text","text":" — logs every call to "},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":". Use this as the default "},{"type":"codeVoice","code":"service:"},{"type":"text","text":" while the analytics vendor decision is still open: analytics wiring can be developed and QA-tested end to end with no SDK and no vendor commitment. Adopting a real provider later is the usual two-line change in "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"For production Mixpanel integrations, the ","type":"text"},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","isActive":true,"type":"reference"},{"text":" companion package provides:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" — an "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that forwards to the Mixpanel SDK and maps "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" to native Mixpanel types."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" — a Mixpanel-flavored mock for previews."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Full API documentation lives in the package’s own ","type":"text"},{"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For other backends (Amplitude, PostHog, Segment, custom), implement ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" directly — see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true,"type":"reference"},{"text":" Step 3, Path B.","type":"text"}]},{"text":"Types","type":"heading","anchor":"Types","level":2},{"text":"`AnalyticsPlugin<RootState, RootAction>`","type":"heading","anchor":"AnalyticsPlugin%3CRootState-RootAction%3E","level":3},{"type":"paragraph","inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"text":" ","type":"text"},{"code":"final class","type":"codeVoice"},{"text":" ","type":"text"},{"code":"SwiduxPlugin","type":"codeVoice"},{"text":" conformer. Owns a slice of root state typed as ","type":"text"},{"code":"AnalyticsState","type":"codeVoice"},{"text":" and an action enum typed as ","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil,","    onConsentChange: (@Sendable (Bool) async -> Void)? = nil",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"onConsentChange","type":"codeVoice"},{"text":" fires on every ","type":"text"},{"code":".setOptedOut","type":"codeVoice"},{"text":" dispatch with the new opted-out value. Use it to drive a vendor SDK’s own consent API — see ","type":"text"},{"inlineContent":[{"text":"Consent","type":"text"}],"type":"emphasis"},{"text":" below.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The plugin is a ","type":"text"},{"code":"final class","type":"codeVoice"},{"text":" (not a struct) because it tracks pending fire-and-forget service calls so that ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":" can deterministically await them — same reason ","type":"text"},{"code":"PersistencePlugin","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"UndoPlugin","type":"codeVoice"},{"text":" are classes.","type":"text"}]},{"text":"`AnalyticsState`","type":"heading","anchor":"AnalyticsState","level":3},{"type":"paragraph","inlineContent":[{"code":"Sendable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" struct. The slice the plugin owns.","type":"text"}]},{"code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"],"type":"codeListing","syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isOptedOut"},{"type":"text","text":" — App-controlled privacy flag. While "},{"type":"codeVoice","code":"true"},{"type":"text","text":", mapper events are dropped, explicit "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":" actions become no-ops, and auto-identify is paused."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" — The most recent screen recorded via "},{"type":"codeVoice","code":".screenView(_:)"},{"type":"text","text":", auto-attached as the "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" property on subsequent tracked events."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions."}]}]}]},{"text":"`AnalyticsAction`","type":"heading","anchor":"AnalyticsAction","level":3},{"code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Convenience factories cover the common no-properties cases:","type":"text"}]},{"code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"],"type":"codeListing","syntax":"swift"},{"text":"`AnalyticsEvent`","type":"heading","anchor":"AnalyticsEvent","level":3},{"code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"],"type":"codeListing","syntax":"swift"},{"text":"`AnalyticsValue`","type":"heading","anchor":"AnalyticsValue","level":3},{"type":"paragraph","inlineContent":[{"text":"Closed enum keeping the protocol provider-agnostic and ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":". Each service adapter maps these cases to its native property type.","type":"text"}]},{"code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Literal conformances keep call-sites clean:","type":"text"}]},{"code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"],"type":"codeListing","syntax":"swift"},{"text":"`AnalyticsMapper<State, Action>`","type":"heading","anchor":"AnalyticsMapper%3CState-Action%3E","level":3},{"type":"paragraph","inlineContent":[{"text":"Wraps the declarative ","type":"text"},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"text":" closure.","type":"text"}]},{"code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Returning an empty array is the no-op case. ","type":"text"},{"code":".none","type":"codeVoice"},{"text":" is the default mapper for plugins that only use explicit ","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"text":" dispatches.","type":"text"}]},{"text":"`AnalyticsIdentity<State>`","type":"heading","anchor":"AnalyticsIdentity%3CState%3E","level":3},{"type":"paragraph","inlineContent":[{"text":"Declarative source-of-truth for the active user’s identity.","type":"text"}]},{"code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The KeyPath convenience init is the typical shape: ","type":"text"},{"code":"AnalyticsIdentity(userID: \\.auth.currentUserID)","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"`AnalyticsService` (protocol)","type":"heading","anchor":"AnalyticsService-protocol","level":3},{"code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" fire-and-forget; only ","type":"text"},{"code":"flush","type":"codeVoice"},{"text":" is awaited.","type":"text"}]},{"text":"`MockAnalyticsService`","type":"heading","anchor":"MockAnalyticsService","level":3},{"type":"paragraph","inlineContent":[{"text":"No-op conformer for previews and development.","type":"text"}]},{"code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"],"type":"codeListing","syntax":"swift"},{"text":"`ConsoleAnalyticsService`","type":"heading","anchor":"ConsoleAnalyticsService","level":3},{"type":"paragraph","inlineContent":[{"text":"Logs every ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"reset","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"flush","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"os.Logger","type":"codeVoice"},{"text":", with a recursive pretty-printer for ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":". The recommended default before a vendor is chosen.","type":"text"}]},{"code":["public struct ConsoleAnalyticsService: AnalyticsService {","    public init(subsystem: String = \"Swidux\", category: String = \"Analytics\")","    \/\/ Each call logs one structured line; output visible in","    \/\/ the Xcode console and Console.app, quiet in Release.","}"],"type":"codeListing","syntax":"swift"},{"text":"Action semantics","type":"heading","anchor":"Action-semantics","level":2},{"type":"paragraph","inlineContent":[{"text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns.","type":"text"}]},{"text":"`track(AnalyticsEvent)`","type":"heading","anchor":"trackAnalyticsEvent","level":3},{"type":"paragraph","inlineContent":[{"text":"Returns an effect calling ","type":"text"},{"code":"service.track(event)","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"text":" auto-attached as the ","type":"text"},{"code":"screen","type":"codeVoice"},{"text":" property if the event doesn’t already specify one. Skipped entirely (returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":") when opted out. No state mutation.","type":"text"}]},{"text":"`screenView(String, properties:)`","type":"heading","anchor":"screenViewString-properties","level":3},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"text":" to the given name ","type":"text"},{"inlineContent":[{"text":"regardless of opt-out","type":"text"}],"type":"strong"},{"text":" (the screen state still progresses for when the user opts back in). Returns an effect calling ","type":"text"},{"code":"service.track","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"\"screen_view\"","type":"codeVoice"},{"text":" event whose properties include ","type":"text"},{"code":"screen_name","type":"codeVoice"},{"text":" plus any extras. Skipped (returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":") when opted out.","type":"text"}]},{"text":"`identify(userID:, properties:)`","type":"heading","anchor":"identifyuserID-properties","level":3},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"lastIdentifiedUserID = userID","type":"codeVoice"},{"text":" and returns an effect calling ","type":"text"},{"code":"service.identify","type":"codeVoice"},{"text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change.","type":"text"}]},{"text":"`alias(newID:, previousID:)`","type":"heading","anchor":"aliasnewID-previousID","level":3},{"type":"paragraph","inlineContent":[{"text":"No state mutation. Returns an effect calling ","type":"text"},{"code":"service.alias","type":"codeVoice"},{"text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID.","type":"text"}]},{"text":"`reset`","type":"heading","anchor":"reset","level":3},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"lastIdentifiedUserID = nil","type":"codeVoice"},{"text":" and returns an effect calling ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":". Runs even when opted out — ","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" is by definition a clean-slate operation.","type":"text"}]},{"text":"`setOptedOut(Bool)`","type":"heading","anchor":"setOptedOutBool","level":3},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"setOptedOut(true)"},{"type":"text","text":" — Sets "},{"type":"codeVoice","code":"isOptedOut = true"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":", returns an effect that invokes "},{"type":"codeVoice","code":"onConsentChange(true)"},{"type":"text","text":" and then calls "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":" to clear server-side identity."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"setOptedOut(false)"},{"type":"text","text":" — Clears the flag. Returns an effect invoking "},{"type":"codeVoice","code":"onConsentChange(false)"},{"type":"text","text":", or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when no hook is configured. Auto-identify on the next dispatch will re-establish identity."}]}]}]},{"text":"Consent","type":"heading","anchor":"Consent","level":2},{"type":"paragraph","inlineContent":[{"text":"Opting out is enforced ","type":"text"},{"inlineContent":[{"text":"plugin-side","type":"text"}],"type":"emphasis"},{"text":": ","type":"text"},{"code":"track","type":"codeVoice"},{"text":", ","type":"text"},{"code":"screenView","type":"codeVoice"},{"text":", ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":", ","type":"text"},{"code":"alias","type":"codeVoice"},{"text":", the mapper, and auto-identify all return early while ","type":"text"},{"code":"isOptedOut","type":"codeVoice"},{"text":", so nothing reaches the service. Only ","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"flush","type":"codeVoice"},{"text":" still pass through.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"That gate stops Swidux-dispatched events. It does not touch the vendor SDK’s own consent switch — so an SDK configured to collect automatic events, or one still holding a queue of its own, can keep sending after the user opts out. ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" deliberately stays at five members (consent APIs differ too much between vendors to abstract, and only the app knows which one it is using), so the bridge is the ","type":"text"},{"code":"onConsentChange","type":"codeVoice"},{"text":" closure.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Semantics: it fires on every ","type":"text"},{"code":".setOptedOut","type":"codeVoice"},{"text":" dispatch with the new value, and on opt-out it runs ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":", so the SDK’s opt-out closes the tap before the reset hands it an identity change that is still eligible to be sent. Events already in flight are not retracted.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Treat this as required wiring for any vendor with a consent API, not an optional extra: without it, “opted out” means only that Swidux stopped sending. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true,"type":"reference"},{"text":" Step 9 for the wiring.","type":"text"}]},{"text":"Mapper semantics","type":"heading","anchor":"Mapper-semantics","level":2},{"type":"paragraph","inlineContent":[{"text":"The mapper runs in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action while the user is opted in. The plugin:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Skips entirely if the action is an "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" (handled by "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" already, no double-tracking)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Skips when "},{"type":"codeVoice","code":"state.isOptedOut"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Calls "},{"type":"codeVoice","code":"mapper.map(state, action)"},{"type":"text","text":" and tracks each returned event via "},{"type":"codeVoice","code":"service.track"},{"type":"text","text":", with "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached as "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" (unless the event already provides its own "},{"type":"codeVoice","code":"screen"},{"type":"text","text":")."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in.","type":"text"}]},{"text":"Auto-identify semantics","type":"heading","anchor":"Auto-identify-semantics","level":2},{"type":"paragraph","inlineContent":[{"text":"When configured with an ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":", the plugin re-evaluates both the ","type":"text"},{"code":"userID","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"userProperties","type":"codeVoice"},{"text":" closures each non-analytics dispatch and diffs the pair ","type":"text"},{"code":"(userID, userProperties)","type":"codeVoice"},{"text":" against the last value sent to the service:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nil → \"u1\""},{"type":"text","text":" (sign-in): updates "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":", fires "},{"type":"codeVoice","code":"service.identify(userID:\"u1\", properties:)"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"\"u1\" → \"u2\"","type":"codeVoice"},{"text":" (account switch): updates both, fires ","type":"text"},{"code":"service.identify(userID:\"u2\", properties:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stable userID, "},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" content changed: updates "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"text":", fires ","type":"text"},{"code":"service.identify(userID:, properties:)","type":"codeVoice"},{"text":" with the new dictionary.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"\"u1\" → nil","type":"codeVoice"},{"text":" (sign-out): clears both, fires ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Stable userID and stable ","type":"text"},{"code":"userProperties","type":"codeVoice"},{"text":": no-op.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"userProperties"},{"text":" is re-evaluated every non-analytics dispatch; dictionary equality decides whether to re-fire ","type":"text"},{"type":"codeVoice","code":"identify"},{"text":". This keeps derived people-properties (subscription tier, paywall entitlements, feature flags) in sync with state without any explicit ","type":"text"},{"type":"codeVoice","code":".identify"},{"text":" plumbing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When opted out, auto-identify is paused: neither ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"text":" nor ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"text":" is updated. Opting back in re-establishes identity correctly on the next dispatch.","type":"text"}]},{"text":"Flushing","type":"heading","anchor":"Flushing","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnalyticsPlugin.flush()"},{"text":" awaits any pending fire-and-forget service calls spawned by ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":", then calls ","type":"text"},{"code":"service.flush()","type":"codeVoice"},{"text":". Call this on app shutdown to avoid losing in-flight events:","type":"text"}]},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Implementing an `AnalyticsService`","type":"heading","anchor":"Implementing-an-AnalyticsService","level":2},{"type":"paragraph","inlineContent":[{"text":"The plugin is provider-agnostic. Your conformer is responsible for translating ","type":"text"},{"code":"AnalyticsEvent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" into whatever the backend SDK expects.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The protocol has five methods, all ","type":"text"},{"type":"codeVoice","code":"async"},{"text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical Mixpanel conformer holds a reference to the "},{"type":"codeVoice","code":"Mixpanel.Instance"},{"type":"text","text":" and translates "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" → "},{"type":"codeVoice","code":"MixpanelType"},{"type":"text","text":". An Amplitude conformer holds an "},{"type":"codeVoice","code":"Amplitude"},{"type":"text","text":" instance and translates to "},{"type":"codeVoice","code":"[String: Any]"},{"type":"text","text":". Either way, the plugin stays the same."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note what the protocol does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" require: no opt-out flag (the plugin handles that), no super-property machinery for "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" (the plugin handles that), and no event batching policy (your call)."}]}]}],"abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference"},"sections":[],"variants":[{"paths":["\/documentation\/swidux\/pluginanalyticsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"title":"EntityStore","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"url":"\/documentation\/swidux\/entitystoreguide","kind":"article","role":"article"},"https://heirloomlogic.github.io/SwiduxMixpanelAnalytics/documentation/swiduxmixpanelanalytics/":{"url":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/s