{"metadata":{"roleHeading":"Article","role":"article","title":"SwiduxAnalytics Reference","modules":[{"name":"Swidux"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginanalyticsreference"]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"generated":true,"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"title":"Reference"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":". Unlike the gate-style plugins (","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"text":"), analytics is an ","type":"text"},{"type":"strong","inlineContent":[{"text":"observer","type":"text"}]},{"text":": it watches actions flow by and emits events, but never blocks dispatch.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Two surfaces:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Mapper (passive)"}]},{"type":"text","text":" — App declares a "},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"type":"text","text":" closure once at registration. The plugin runs it in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action while the user is opted in."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" (explicit)"}]},{"type":"text","text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Plus optional ","type":"text"},{"type":"strong","inlineContent":[{"text":"auto-identify","type":"text"}]},{"text":": pass an ","type":"text"},{"type":"codeVoice","code":"AnalyticsIdentity"},{"text":" keypath and the plugin watches userID transitions across dispatches, firing ","type":"text"},{"code":"service.identify","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"service.reset"},{"text":" automatically.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Library target","level":2,"anchor":"Library-target"},{"items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"type":"codeVoice","code":"import SwiduxAnalytics"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"text":" alongside ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Provided implementations","anchor":"Provided-implementations","type":"heading"},{"inlineContent":[{"text":"The plugin ships with ","type":"text"},{"code":"MockAnalyticsService","type":"codeVoice"},{"text":" for previews and tests. For production Mixpanel integrations, the ","type":"text"},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","isActive":true,"type":"reference"},{"text":" companion package provides:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"text":" — an ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that forwards to the Mixpanel SDK and maps "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" to native Mixpanel types."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" — a Mixpanel-flavored mock for previews."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For other backends (Amplitude, PostHog, Segment, custom), implement "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" directly — see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true},{"type":"text","text":" Step 3, Path B."}],"type":"paragraph"},{"level":2,"text":"Types","anchor":"Types","type":"heading"},{"level":3,"text":"`AnalyticsPlugin<RootState, RootAction>`","anchor":"AnalyticsPlugin%3CRootState-RootAction%3E","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"type":"codeVoice","code":"AnalyticsState"},{"type":"text","text":" and an action enum typed as "},{"type":"codeVoice","code":"AnalyticsAction"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The plugin is a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" (not a struct) because it tracks pending fire-and-forget service calls so that "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" can deterministically await them — same reason "},{"code":"PersistencePlugin","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"UndoPlugin","type":"codeVoice"},{"text":" are classes.","type":"text"}],"type":"paragraph"},{"text":"`AnalyticsState`","anchor":"AnalyticsState","level":3,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Equatable"},{"text":" struct. The slice the plugin owns.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isOptedOut"},{"type":"text","text":" — App-controlled privacy flag. While "},{"type":"codeVoice","code":"true"},{"type":"text","text":", mapper events are dropped, explicit "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":" actions become no-ops, and auto-identify is paused."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" — The most recent screen recorded via "},{"type":"codeVoice","code":".screenView(_:)"},{"type":"text","text":", auto-attached as the "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" property on subsequent tracked events."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"`AnalyticsAction`","anchor":"AnalyticsAction","type":"heading"},{"syntax":"swift","code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Convenience factories cover the common no-properties cases:"}]},{"type":"codeListing","syntax":"swift","code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"]},{"type":"heading","anchor":"AnalyticsEvent","text":"`AnalyticsEvent`","level":3},{"type":"codeListing","syntax":"swift","code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"]},{"type":"heading","anchor":"AnalyticsValue","text":"`AnalyticsValue`","level":3},{"type":"paragraph","inlineContent":[{"text":"Closed enum keeping the protocol provider-agnostic and ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":". Each service adapter maps these cases to its native property type.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"]},{"type":"paragraph","inlineContent":[{"text":"Literal conformances keep call-sites clean:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"]},{"type":"heading","anchor":"AnalyticsMapper%3CState-Action%3E","text":"`AnalyticsMapper<State, Action>`","level":3},{"type":"paragraph","inlineContent":[{"text":"Wraps the declarative ","type":"text"},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"text":" closure.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. "},{"type":"codeVoice","code":".none"},{"type":"text","text":" is the default mapper for plugins that only use explicit "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" dispatches."}]},{"level":3,"text":"`AnalyticsIdentity<State>`","type":"heading","anchor":"AnalyticsIdentity%3CState%3E"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declarative source-of-truth for the active user’s identity."}]},{"type":"codeListing","code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The KeyPath convenience init is the typical shape: "},{"type":"codeVoice","code":"AnalyticsIdentity(userID: \\.auth.currentUserID)"},{"type":"text","text":"."}]},{"level":3,"text":"`AnalyticsService` (protocol)","type":"heading","anchor":"AnalyticsService-protocol"},{"type":"codeListing","code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"reset"},{"type":"text","text":" fire-and-forget; only "},{"type":"codeVoice","code":"flush"},{"type":"text","text":" is awaited."}]},{"level":3,"text":"`MockAnalyticsService`","type":"heading","anchor":"MockAnalyticsService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No-op conformer for previews and development."}]},{"type":"codeListing","code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"],"syntax":"swift"},{"level":2,"text":"Action semantics","type":"heading","anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}]},{"level":3,"text":"`track(AnalyticsEvent)`","type":"heading","anchor":"trackAnalyticsEvent"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns an effect calling "},{"type":"codeVoice","code":"service.track(event)"},{"type":"text","text":", with "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached as the "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" property if the event doesn’t already specify one. Skipped entirely (returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":") when opted out. No state mutation."}]},{"level":3,"text":"`screenView(String, properties:)`","type":"heading","anchor":"screenViewString-properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" to the given name "},{"type":"strong","inlineContent":[{"type":"text","text":"regardless of opt-out"}]},{"type":"text","text":" (the screen state still progresses for when the user opts back in). Returns an effect calling "},{"type":"codeVoice","code":"service.track"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"\"screen_view\""},{"type":"text","text":" event whose properties include "},{"type":"codeVoice","code":"screen_name"},{"type":"text","text":" plus any extras. Skipped (returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":") when opted out."}]},{"level":3,"text":"`identify(userID:, properties:)`","type":"heading","anchor":"identifyuserID-properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"lastIdentifiedUserID = userID"},{"type":"text","text":" and returns an effect calling "},{"type":"codeVoice","code":"service.identify"},{"type":"text","text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change."}]},{"level":3,"text":"`alias(newID:, previousID:)`","type":"heading","anchor":"aliasnewID-previousID"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No state mutation. Returns an effect calling "},{"type":"codeVoice","code":"service.alias"},{"type":"text","text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID."}]},{"level":3,"text":"`reset`","anchor":"reset","type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"lastIdentifiedUserID = nil"},{"type":"text","text":" and returns an effect calling "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":". Runs even when opted out — "},{"type":"codeVoice","code":"reset"},{"type":"text","text":" is by definition a clean-slate operation."}],"type":"paragraph"},{"level":3,"text":"`setOptedOut(Bool)`","anchor":"setOptedOutBool","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"setOptedOut(true)"},{"text":" — Sets ","type":"text"},{"type":"codeVoice","code":"isOptedOut = true"},{"text":", clears ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"text":", returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.reset()"},{"text":" to clear server-side identity.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"setOptedOut(false)"},{"text":" — Clears the flag without a service call. Auto-identify on the next dispatch will re-establish identity.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Mapper semantics","anchor":"Mapper-semantics","type":"heading"},{"inlineContent":[{"type":"text","text":"The mapper runs in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action while the user is opted in. The plugin:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Skips entirely if the action is an ","type":"text"},{"type":"codeVoice","code":"AnalyticsAction"},{"text":" (handled by ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" already, no double-tracking).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Skips when ","type":"text"},{"type":"codeVoice","code":"state.isOptedOut"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Calls ","type":"text"},{"type":"codeVoice","code":"mapper.map(state, action)"},{"text":" and tracks each returned event via ","type":"text"},{"type":"codeVoice","code":"service.track"},{"text":", with ","type":"text"},{"type":"codeVoice","code":"currentScreen"},{"text":" auto-attached as ","type":"text"},{"type":"codeVoice","code":"screen"},{"text":" (unless the event already provides its own ","type":"text"},{"type":"codeVoice","code":"screen"},{"text":").","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in."}],"type":"paragraph"},{"level":2,"text":"Auto-identify semantics","anchor":"Auto-identify-semantics","type":"heading"},{"inlineContent":[{"type":"text","text":"When configured with an "},{"type":"codeVoice","code":"AnalyticsIdentity"},{"type":"text","text":", the plugin re-evaluates both the "},{"type":"codeVoice","code":"userID"},{"type":"text","text":" and "},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" closures each non-analytics dispatch and diffs the pair "},{"type":"codeVoice","code":"(userID, userProperties)"},{"type":"text","text":" against the last value sent to the service:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nil → \"u1\""},{"text":" (sign-in): updates ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"text":", fires ","type":"text"},{"type":"codeVoice","code":"service.identify(userID:\"u1\", properties:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"u1\" → \"u2\""},{"type":"text","text":" (account switch): updates both, fires "},{"type":"codeVoice","code":"service.identify(userID:\"u2\", properties:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Stable userID, ","type":"text"},{"type":"codeVoice","code":"userProperties"},{"text":" content changed: updates ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"text":", fires ","type":"text"},{"type":"codeVoice","code":"service.identify(userID:, properties:)"},{"text":" with the new dictionary.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"u1\" → nil"},{"text":" (sign-out): clears both, fires ","type":"text"},{"type":"codeVoice","code":"service.reset()"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Stable userID and stable "},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":": no-op."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" is re-evaluated every non-analytics dispatch; dictionary equality decides whether to re-fire "},{"type":"codeVoice","code":"identify"},{"type":"text","text":". This keeps derived people-properties (subscription tier, paywall entitlements, feature flags) in sync with state without any explicit "},{"type":"codeVoice","code":".identify"},{"type":"text","text":" plumbing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When opted out, auto-identify is paused: neither "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" nor "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":" is updated. Opting back in re-establishes identity correctly on the next dispatch."}],"type":"paragraph"},{"anchor":"Flushing","type":"heading","level":2,"text":"Flushing"},{"inlineContent":[{"code":"AnalyticsPlugin.flush()","type":"codeVoice"},{"text":" awaits any pending fire-and-forget service calls spawned by ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"type":"text","text":", then calls "},{"type":"codeVoice","code":"service.flush()"},{"type":"text","text":". Call this on app shutdown to avoid losing in-flight events:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"]},{"anchor":"Implementing-an-AnalyticsService","type":"heading","level":2,"text":"Implementing an `AnalyticsService`"},{"inlineContent":[{"type":"text","text":"The plugin is provider-agnostic. Your conformer is responsible for translating "},{"type":"codeVoice","code":"AnalyticsEvent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" into whatever the backend SDK expects."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The protocol has five methods, all "},{"type":"codeVoice","code":"async"},{"type":"text","text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A typical Mixpanel conformer holds a reference to the "},{"type":"codeVoice","code":"Mixpanel.Instance"},{"type":"text","text":" and translates "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" → "},{"type":"codeVoice","code":"MixpanelType"},{"type":"text","text":". An Amplitude conformer holds an "},{"type":"codeVoice","code":"Amplitude"},{"type":"text","text":" instance and translates to "},{"type":"codeVoice","code":"[String: Any]"},{"type":"text","text":". Either way, the plugin stays the same."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Note what the protocol does "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" require: no opt-out flag (the plugin handles that), no super-property machinery for "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" (the plugin handles that), and no event batching policy (your call)."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","references":{"https://github.com/heirloomlogic/SwiduxMixpanelAnalytics":{"titleInlineContent":[{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"}],"type":"link","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","title":"SwiduxMixpanelAnalytics","url":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"type":"topic","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"title":"SwiduxPaywall Reference","role":"article","url":"\/documentation\/swidux\/pluginpaywallreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","kind":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"title":"UndoPlugin","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"role":"symbol","type":"topic","url":"\/documentation\/swidux\/undoplugin"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","title":"SwiduxParentalGate Reference","url":"\/documentation\/swidux\/pluginparentalgatereference","type":"topic"},"doc://Swidux/documentation/Swidux":{"kind":"symbol","