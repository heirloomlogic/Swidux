{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true,"title":"Reference","anchor":"Reference"}],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":". Unlike the gate-style plugins ("},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":"), analytics is an "},{"inlineContent":[{"text":"observer","type":"text"}],"type":"strong"},{"type":"text","text":": it watches actions flow by and emits events, but never blocks dispatch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two surfaces:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Mapper (passive)","type":"text"}],"type":"strong"},{"text":" — App declares a ","type":"text"},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"text":" closure once at registration. The plugin runs it in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action while the user is opted in.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"AnalyticsAction","type":"codeVoice"},{"text":" (explicit)","type":"text"}],"type":"strong"},{"text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plus optional "},{"inlineContent":[{"text":"auto-identify","type":"text"}],"type":"strong"},{"type":"text","text":": pass an "},{"code":"AnalyticsIdentity","type":"codeVoice"},{"type":"text","text":" keypath and the plugin watches userID transitions across dispatches, firing "},{"code":"service.identify","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"service.reset","type":"codeVoice"},{"type":"text","text":" automatically."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true,"type":"reference"},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"anchor":"Library-target","level":2,"type":"heading","text":"Library target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxAnalytics","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":" alongside "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":"."}]},{"anchor":"Provided-implementations","level":2,"type":"heading","text":"Provided implementations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"MockAnalyticsService","type":"codeVoice"},{"text":" — silent no-op, for previews and tests.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"ConsoleAnalyticsService","type":"codeVoice"},{"text":" — logs every call to ","type":"text"},{"code":"os.Logger","type":"codeVoice"},{"text":". Use this as the default ","type":"text"},{"code":"service:","type":"codeVoice"},{"text":" while the analytics vendor decision is still open: analytics wiring can be developed and QA-tested end to end with no SDK and no vendor commitment. Adopting a real provider later is the usual two-line change in ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For production Mixpanel integrations, the "},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","isActive":true,"type":"reference"},{"type":"text","text":" companion package provides:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" — an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that forwards to the Mixpanel SDK and maps ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" to native Mixpanel types.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"text":" — a Mixpanel-flavored mock for previews.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For other backends (Amplitude, PostHog, Segment, custom), implement "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" directly — see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true,"type":"reference"},{"type":"text","text":" Step 3, Path B."}]},{"anchor":"Types","level":2,"type":"heading","text":"Types"},{"anchor":"AnalyticsPlugin%3CRootState-RootAction%3E","level":3,"type":"heading","text":"`AnalyticsPlugin<RootState, RootAction>`"},{"type":"paragraph","inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" "},{"code":"final class","type":"codeVoice"},{"type":"text","text":" "},{"code":"SwiduxPlugin","type":"codeVoice"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"code":"AnalyticsState","type":"codeVoice"},{"type":"text","text":" and an action enum typed as "},{"code":"AnalyticsAction","type":"codeVoice"},{"type":"text","text":"."}]},{"code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is a "},{"code":"final class","type":"codeVoice"},{"type":"text","text":" (not a struct) because it tracks pending fire-and-forget service calls so that "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" can deterministically await them — same reason "},{"code":"PersistencePlugin","type":"codeVoice"},{"type":"text","text":" and "},{"code":"UndoPlugin","type":"codeVoice"},{"type":"text","text":" are classes."}]},{"anchor":"AnalyticsState","level":3,"type":"heading","text":"`AnalyticsState`"},{"type":"paragraph","inlineContent":[{"code":"Sendable","type":"codeVoice"},{"type":"text","text":", "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":" struct. The slice the plugin owns."}]},{"code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"],"type":"codeListing","syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"isOptedOut","type":"codeVoice"},{"text":" — App-controlled privacy flag. While ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", mapper events are dropped, explicit ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" actions become no-ops, and auto-identify is paused.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"currentScreen","type":"codeVoice"},{"text":" — The most recent screen recorded via ","type":"text"},{"code":".screenView(_:)","type":"codeVoice"},{"text":", auto-attached as the ","type":"text"},{"code":"screen","type":"codeVoice"},{"text":" property on subsequent tracked events.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"AnalyticsAction","level":3,"type":"heading","text":"`AnalyticsAction`"},{"code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Convenience factories cover the common no-properties cases:"}]},{"code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"],"type":"codeListing","syntax":"swift"},{"anchor":"AnalyticsEvent","level":3,"type":"heading","text":"`AnalyticsEvent`"},{"code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"],"type":"codeListing","syntax":"swift"},{"anchor":"AnalyticsValue","level":3,"type":"heading","text":"`AnalyticsValue`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Closed enum keeping the protocol provider-agnostic and "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":". Each service adapter maps these cases to its native property type."}]},{"code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Literal conformances keep call-sites clean:"}]},{"code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"],"type":"codeListing","syntax":"swift"},{"anchor":"AnalyticsMapper%3CState-Action%3E","level":3,"type":"heading","text":"`AnalyticsMapper<State, Action>`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wraps the declarative "},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"type":"text","text":" closure."}]},{"code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. "},{"code":".none","type":"codeVoice"},{"type":"text","text":" is the default mapper for plugins that only use explicit "},{"code":"AnalyticsAction","type":"codeVoice"},{"type":"text","text":" dispatches."}]},{"anchor":"AnalyticsIdentity%3CState%3E","level":3,"type":"heading","text":"`AnalyticsIdentity<State>`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declarative source-of-truth for the active user’s identity."}]},{"code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The KeyPath convenience init is the typical shape: ","type":"text"},{"code":"AnalyticsIdentity(userID: \\.auth.currentUserID)","type":"codeVoice"},{"text":".","type":"text"}]},{"anchor":"AnalyticsService-protocol","level":3,"type":"heading","text":"`AnalyticsService` (protocol)"},{"code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" fire-and-forget; only ","type":"text"},{"code":"flush","type":"codeVoice"},{"text":" is awaited.","type":"text"}]},{"anchor":"MockAnalyticsService","level":3,"type":"heading","text":"`MockAnalyticsService`"},{"type":"paragraph","inlineContent":[{"text":"No-op conformer for previews and development.","type":"text"}]},{"type":"codeListing","code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"],"syntax":"swift"},{"anchor":"ConsoleAnalyticsService","level":3,"type":"heading","text":"`ConsoleAnalyticsService`"},{"type":"paragraph","inlineContent":[{"text":"Logs every ","type":"text"},{"code":"track","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"reset","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"flush","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"os.Logger","type":"codeVoice"},{"text":", with a recursive pretty-printer for ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":". The recommended default before a vendor is chosen.","type":"text"}]},{"code":["public struct ConsoleAnalyticsService: AnalyticsService {","    public init(subsystem: String = \"Swidux\", category: String = \"Analytics\")","    \/\/ Each call logs one structured line; output visible in","    \/\/ the Xcode console and Console.app, quiet in Release.","}"],"type":"codeListing","syntax":"swift"},{"text":"Action semantics","level":2,"type":"heading","anchor":"Action-semantics"},{"inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}],"type":"paragraph"},{"text":"`track(AnalyticsEvent)`","level":3,"type":"heading","anchor":"trackAnalyticsEvent"},{"inlineContent":[{"type":"text","text":"Returns an effect calling "},{"code":"service.track(event)","type":"codeVoice"},{"type":"text","text":", with "},{"code":"currentScreen","type":"codeVoice"},{"text":" auto-attached as the ","type":"text"},{"code":"screen","type":"codeVoice"},{"type":"text","text":" property if the event doesn’t already specify one. Skipped entirely (returns "},{"code":"nil","type":"codeVoice"},{"text":") when opted out. No state mutation.","type":"text"}],"type":"paragraph"},{"level":3,"text":"`screenView(String, properties:)`","anchor":"screenViewString-properties","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"type":"text","text":" to the given name "},{"type":"strong","inlineContent":[{"type":"text","text":"regardless of opt-out"}]},{"text":" (the screen state still progresses for when the user opts back in). Returns an effect calling ","type":"text"},{"code":"service.track","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"\"screen_view\"","type":"codeVoice"},{"text":" event whose properties include ","type":"text"},{"code":"screen_name","type":"codeVoice"},{"text":" plus any extras. Skipped (returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":") when opted out.","type":"text"}],"type":"paragraph"},{"text":"`identify(userID:, properties:)`","anchor":"identifyuserID-properties","level":3,"type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"lastIdentifiedUserID = userID","type":"codeVoice"},{"text":" and returns an effect calling ","type":"text"},{"code":"service.identify","type":"codeVoice"},{"text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"aliasnewID-previousID","text":"`alias(newID:, previousID:)`","type":"heading"},{"inlineContent":[{"text":"No state mutation. Returns an effect calling ","type":"text"},{"code":"service.alias","type":"codeVoice"},{"text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID.","type":"text"}],"type":"paragraph"},{"text":"`reset`","anchor":"reset","level":3,"type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"lastIdentifiedUserID = nil","type":"codeVoice"},{"text":" and returns an effect calling ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":". Runs even when opted out — ","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" is by definition a clean-slate operation.","type":"text"}],"type":"paragraph"},{"text":"`setOptedOut(Bool)`","anchor":"setOptedOutBool","level":3,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"code":"setOptedOut(true)","type":"codeVoice"},{"type":"text","text":" — Sets "},{"code":"isOptedOut = true","type":"codeVoice"},{"text":", clears ","type":"text"},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"type":"text","text":", returns an effect calling "},{"code":"service.reset()","type":"codeVoice"},{"type":"text","text":" to clear server-side identity."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"setOptedOut(false)","type":"codeVoice"},{"type":"text","text":" — Clears the flag without a service call. Auto-identify on the next dispatch will re-establish identity."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Mapper semantics","anchor":"Mapper-semantics","level":2,"type":"heading"},{"inlineContent":[{"text":"The mapper runs in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action while the user is opted in. The plugin:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Skips entirely if the action is an "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" (handled by "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" already, no double-tracking)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Skips when "},{"code":"state.isOptedOut","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Calls ","type":"text"},{"code":"mapper.map(state, action)","type":"codeVoice"},{"type":"text","text":" and tracks each returned event via "},{"code":"service.track","type":"codeVoice"},{"type":"text","text":", with "},{"code":"currentScreen","type":"codeVoice"},{"text":" auto-attached as ","type":"text"},{"code":"screen","type":"codeVoice"},{"type":"text","text":" (unless the event already provides its own "},{"code":"screen","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in.","type":"text"}]},{"type":"heading","level":2,"text":"Auto-identify semantics","anchor":"Auto-identify-semantics"},{"inlineContent":[{"text":"When configured with an ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":", the plugin re-evaluates both the ","type":"text"},{"code":"userID","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"userProperties","type":"codeVoice"},{"text":" closures each non-analytics dispatch and diffs the pair ","type":"text"},{"code":"(userID, userProperties)","type":"codeVoice"},{"text":" against the last value sent to the service:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"nil → \"u1\"","type":"codeVoice"},{"type":"text","text":" (sign-in): updates "},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"text":", fires ","type":"text"},{"code":"service.identify(userID:\"u1\", properties:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"\"u1\" → \"u2\"","type":"codeVoice"},{"text":" (account switch): updates both, fires ","type":"text"},{"code":"service.identify(userID:\"u2\", properties:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Stable userID, ","type":"text"},{"code":"userProperties","type":"codeVoice"},{"text":" content changed: updates ","type":"text"},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"text":", fires ","type":"text"},{"code":"service.identify(userID:, properties:)","type":"codeVoice"},{"text":" with the new dictionary.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"\"u1\" → nil","type":"codeVoice"},{"text":" (sign-out): clears both, fires ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Stable userID and stable ","type":"text"},{"code":"userProperties","type":"codeVoice"},{"text":": no-op.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"code":"userProperties","type":"codeVoice"},{"type":"text","text":" is re-evaluated every non-analytics dispatch; dictionary equality decides whether to re-fire "},{"code":"identify","type":"codeVoice"},{"type":"text","text":". This keeps derived people-properties (subscription tier, paywall entitlements, feature flags) in sync with state without any explicit "},{"code":".identify","type":"codeVoice"},{"type":"text","text":" plumbing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When opted out, auto-identify is paused: neither "},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"type":"text","text":" nor "},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"type":"text","text":" is updated. Opting back in re-establishes identity correctly on the next dispatch."}],"type":"paragraph"},{"level":2,"text":"Flushing","anchor":"Flushing","type":"heading"},{"inlineContent":[{"code":"AnalyticsPlugin.flush()","type":"codeVoice"},{"type":"text","text":" awaits any pending fire-and-forget service calls spawned by "},{"code":"afterReduce","type":"codeVoice"},{"text":", then calls ","type":"text"},{"code":"service.flush()","type":"codeVoice"},{"text":". Call this on app shutdown to avoid losing in-flight events:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"],"type":"codeListing"},{"level":2,"text":"Implementing an `AnalyticsService`","anchor":"Implementing-an-AnalyticsService","type":"heading"},{"inlineContent":[{"type":"text","text":"The plugin is provider-agnostic. Your conformer is responsible for translating "},{"code":"AnalyticsEvent","type":"codeVoice"},{"type":"text","text":" and "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" into whatever the backend SDK expects."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The protocol has five methods, all "},{"code":"async","type":"codeVoice"},{"type":"text","text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A typical Mixpanel conformer holds a reference to the "},{"code":"Mixpanel.Instance","type":"codeVoice"},{"type":"text","text":" and translates "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" → "},{"code":"MixpanelType","type":"codeVoice"},{"type":"text","text":". An Amplitude conformer holds an "},{"code":"Amplitude","type":"codeVoice"},{"type":"text","text":" instance and translates to "},{"code":"[String: Any]","type":"codeVoice"},{"type":"text","text":". Either way, the plugin stays the same."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Note what the protocol does "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" require: no opt-out flag (the plugin handles that), no super-property machinery for "},{"code":"currentScreen","type":"codeVoice"},{"type":"text","text":" (the plugin handles that), and no event batching policy (your call)."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"paths":["\/documentation\/swidux\/pluginanalyticsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"metadata":{"roleHeading":"Article","title":"SwiduxAnalytics Reference","modules":[{"name":"Swidux"}],"role":"article"},"references":{"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","title":"SwiduxKillswitch Reference","url":"\/documentation\/swidux\/pluginkillswitchreference","abstract":[{"type":"text","text":"Public API surface for the "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}]},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"kind":"article","type":"topic","role":"article","url":"\/documentation\/swidux\/entitystoreguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"title":"EntityStore"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","title":"SwiduxParentalGate Reference","url":"\/documentation\/swidux\/pluginparentalgatereference","abstract":[{"type":"text","text":"API surface for the "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}]},"doc://Swidux/documentation/Swidux":{"kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux"},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","title":"Getting Start