{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"generated":true,"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference"}],"kind":"article","sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article","title":"SwiduxAnalytics Reference"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":". Unlike the gate-style plugins (","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":"), analytics is an ","type":"text"},{"inlineContent":[{"type":"text","text":"observer"}],"type":"strong"},{"text":": it watches actions flow by and emits events, but never blocks dispatch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two surfaces:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Mapper (passive)","type":"text"}]},{"text":" — App declares a ","type":"text"},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"text":" closure once at registration. The plugin runs it in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action while the user is opted in.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"AnalyticsAction"},{"text":" (explicit)","type":"text"}]},{"text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Plus optional ","type":"text"},{"inlineContent":[{"type":"text","text":"auto-identify"}],"type":"strong"},{"text":": pass an ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":" keypath and the plugin watches userID transitions across dispatches, firing ","type":"text"},{"code":"service.identify","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"service.reset","type":"codeVoice"},{"text":" automatically.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true,"type":"reference"},{"text":". For where this plugin sits in the lifecycle, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"level":2,"type":"heading","anchor":"Library-target","text":"Library target"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxAnalytics","type":"codeVoice"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target dependencies in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" alongside ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":".","type":"text"}]},{"level":2,"type":"heading","anchor":"Provided-implementations","text":"Provided implementations"},{"type":"paragraph","inlineContent":[{"text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"MockAnalyticsService","type":"codeVoice"},{"text":" — silent no-op, for previews and tests.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ConsoleAnalyticsService","type":"codeVoice"},{"text":" — logs every call to ","type":"text"},{"code":"os.Logger","type":"codeVoice"},{"text":". Use this as the default ","type":"text"},{"code":"service:","type":"codeVoice"},{"text":" while the analytics vendor decision is still open: analytics wiring can be developed and QA-tested end to end with no SDK and no vendor commitment. Adopting a real provider later is the usual two-line change in ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"For production Mixpanel integrations, the ","type":"text"},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","isActive":true,"type":"reference"},{"text":" companion package provides:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" — an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that forwards to the Mixpanel SDK and maps ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" to native Mixpanel types.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"text":" — a Mixpanel-flavored mock for previews.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Full API documentation lives in the package’s own ","type":"text"},{"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For other backends (Amplitude, PostHog, Segment, custom), implement ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" directly — see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true,"type":"reference"},{"text":" Step 3, Path B.","type":"text"}]},{"level":2,"type":"heading","anchor":"Types","text":"Types"},{"anchor":"AnalyticsPlugin%3CRootState-RootAction%3E","text":"`AnalyticsPlugin<RootState, RootAction>`","type":"heading","level":3},{"inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"text":" ","type":"text"},{"code":"final class","type":"codeVoice"},{"text":" ","type":"text"},{"code":"SwiduxPlugin","type":"codeVoice"},{"text":" conformer. Owns a slice of root state typed as ","type":"text"},{"code":"AnalyticsState","type":"codeVoice"},{"type":"text","text":" and an action enum typed as "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil,","    onConsentChange: (@Sendable (Bool) async -> Void)? = nil",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"onConsentChange","type":"codeVoice"},{"type":"text","text":" fires on every "},{"code":".setOptedOut","type":"codeVoice"},{"type":"text","text":" dispatch with the new opted-out value. Use it to drive a vendor SDK’s own consent API — see "},{"type":"emphasis","inlineContent":[{"text":"Consent","type":"text"}]},{"type":"text","text":" below."}]},{"type":"paragraph","inlineContent":[{"text":"The plugin is a ","type":"text"},{"type":"codeVoice","code":"final class"},{"type":"text","text":" (not a struct) because it tracks pending fire-and-forget service calls so that "},{"code":"flush()","type":"codeVoice"},{"text":" can deterministically await them — same reason ","type":"text"},{"code":"PersistencePlugin","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"UndoPlugin","type":"codeVoice"},{"text":" are classes.","type":"text"}]},{"level":3,"type":"heading","anchor":"AnalyticsState","text":"`AnalyticsState`"},{"type":"paragraph","inlineContent":[{"code":"Sendable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" struct. The slice the plugin owns.","type":"text"}]},{"type":"codeListing","code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"isOptedOut","type":"codeVoice"},{"text":" — App-controlled privacy flag. While ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", mapper events are dropped, explicit ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"identify"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"alias"},{"text":" actions become no-ops, and auto-identify is paused.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"currentScreen"},{"text":" — The most recent screen recorded via ","type":"text"},{"type":"codeVoice","code":".screenView(_:)"},{"text":", auto-attached as the ","type":"text"},{"type":"codeVoice","code":"screen"},{"text":" property on subsequent tracked events.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"lastIdentifiedUserID"},{"text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions.","type":"text"}],"type":"paragraph"}]}]},{"level":3,"type":"heading","anchor":"AnalyticsAction","text":"`AnalyticsAction`"},{"type":"codeListing","code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Convenience factories cover the common no-properties cases:"}]},{"type":"codeListing","code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"AnalyticsEvent","text":"`AnalyticsEvent`"},{"type":"codeListing","code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"AnalyticsValue","text":"`AnalyticsValue`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Closed enum keeping the protocol provider-agnostic and "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":". Each service adapter maps these cases to its native property type."}]},{"type":"codeListing","code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Literal conformances keep call-sites clean:"}]},{"type":"codeListing","code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"AnalyticsMapper%3CState-Action%3E","text":"`AnalyticsMapper<State, Action>`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wraps the declarative "},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"type":"text","text":" closure."}]},{"type":"codeListing","code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. "},{"type":"codeVoice","code":".none"},{"type":"text","text":" is the default mapper for plugins that only use explicit "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" dispatches."}]},{"level":3,"type":"heading","anchor":"AnalyticsIdentity%3CState%3E","text":"`AnalyticsIdentity<State>`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declarative source-of-truth for the active user’s identity."}]},{"type":"codeListing","code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The KeyPath convenience init is the typical shape: "},{"type":"codeVoice","code":"AnalyticsIdentity(userID: \\.auth.currentUserID)"},{"type":"text","text":"."}]},{"level":3,"type":"heading","anchor":"AnalyticsService-protocol","text":"`AnalyticsService` (protocol)"},{"type":"codeListing","code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"reset"},{"type":"text","text":" fire-and-forget; only "},{"type":"codeVoice","code":"flush"},{"type":"text","text":" is awaited."}]},{"level":3,"type":"heading","anchor":"MockAnalyticsService","text":"`MockAnalyticsService`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No-op conformer for previews and development."}]},{"type":"codeListing","code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"],"syntax":"swift"},{"level":3,"type":"heading","anchor":"ConsoleAnalyticsService","text":"`ConsoleAnalyticsService`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Logs every "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"reset"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"flush"},{"type":"text","text":" to "},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":", with a recursive pretty-printer for "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":". The recommended default before a vendor is chosen."}]},{"type":"codeListing","code":["public struct ConsoleAnalyticsService: AnalyticsService {","    public init(subsystem: String = \"Swidux\", category: String = \"Analytics\")","    \/\/ Each call logs one structured line; output visible in","    \/\/ the Xcode console and Console.app, quiet in Release.","}"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Action-semantics","text":"Action semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}]},{"level":3,"type":"heading","anchor":"trackAnalyticsEvent","text":"`track(AnalyticsEvent)`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns an effect calling "},{"type":"codeVoice","code":"service.track(event)"},{"type":"text","text":", with "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached as the "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" property if the event doesn’t already specify one. Skipped entirely (returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":") when opted out. No state mutation."}]},{"level":3,"type":"heading","anchor":"screenViewString-properties","text":"`screenView(String, properties:)`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" to the given name "},{"type":"strong","inlineContent":[{"text":"regardless of opt-out","type":"text"}]},{"type":"text","text":" (the screen state still progresses for when the user opts back in). Returns an effect calling "},{"type":"codeVoice","code":"service.track"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"\"screen_view\""},{"type":"text","text":" event whose properties include "},{"type":"codeVoice","code":"screen_name"},{"type":"text","text":" plus any extras. Skipped (returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":") when opted out."}]},{"level":3,"type":"heading","anchor":"identifyuserID-properties","text":"`identify(userID:, properties:)`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"lastIdentifiedUserID = userID"},{"type":"text","text":" and returns an effect calling "},{"type":"codeVoice","code":"service.identify"},{"type":"text","text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change."}]},{"level":3,"type":"heading","anchor":"aliasnewID-previousID","text":"`alias(newID:, previousID:)`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No state mutation. Returns an effect calling "},{"type":"codeVoice","code":"service.alias"},{"type":"text","text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID."}]},{"level":3,"type":"heading","anchor":"reset","text":"`reset`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"lastIdentifiedUserID = nil"},{"type":"text","text":" and returns an effect calling "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":". Runs even when opted out — "},{"type":"codeVoice","code":"reset"},{"type":"text","text":" is by definition a clean-slate operation."}]},{"level":3,"type":"heading","anchor":"setOptedOutBool","text":"`setOptedOut(Bool)`"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"setOptedOut(true)"},{"text":" — Sets ","type":"text"},{"type":"codeVoice","code":"isOptedOut = true"},{"text":", clears ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"text":", returns an effect that invokes ","type":"text"},{"type":"codeVoice","code":"onConsentChange(true)"},{"text":" and then calls ","type":"text"},{"type":"codeVoice","code":"service.reset()"},{"text":" to clear server-side identity.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"setOptedOut(false)"},{"text":" — Clears the flag. Returns an effect invoking ","type":"text"},{"type":"codeVoice","code":"onConsentChange(false)"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" when no hook is configured. Auto-identify on the next dispatch will re-establish identity.","type":"text"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","anchor":"Consent","text":"Consent"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Opting out is enforced "},{"type":"emphasis","inlineContent":[{"text":"plugin-side","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"track"},{"type":"text","text":", "},{"type":"codeVoice","code":"screenView"},{"type":"text","text":", "},{"type":"codeVoice","code":"identify"},{"type":"text","text":", "},{"type":"codeVoice","code":"alias"},{"type":"text","text":", the mapper, and auto-identify all return early while "},{"type":"codeVoice","code":"isOptedOut"},{"type":"text","text":", so nothing reaches the service. Only "},{"type":"codeVoice","code":"reset"},{"type":"text","text":" and "},{"type":"codeVoice","code":"flush"},{"type":"text","text":" still pass through."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That gate stops Swidux-dispatched events. It does not touch the vendor SDK’s own consent switch — so an SDK configured to collect automatic events, or one still holding a queue of its own, can keep sending after the user opts out. "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" deliberately stays at five members (consent APIs differ too much between vendors to abstract, and only the app knows which one it is using), so the bridge is the "},{"type":"codeVoice","code":"onConsentChange"},{"type":"text","text":" closure."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Semantics: it fires on every "},{"type":"codeVoice","code":".setOptedOut"},{"type":"text","text":" dispatch with the new value, and on opt-out it runs "},{"type":"strong","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":", so the SDK’s opt-out closes the tap before the reset hands it an identity change that is still eligible to be sent. Events already in flight are not retracted."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Treat this as required wiring for any vendor with a consent API, not an optional extra: without it, “opted out” means only that Swidux stopped sending. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true},{"type":"text","text":" Step 9 for the wiring."}]},{"level":2,"type":"heading","anchor":"Mapper-semantics","text":"Mapper semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mapper runs in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action while the user is opted in. The plugin:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Skips entirely if the action is an ","type":"text"},{"type":"codeVoice","code":"AnalyticsAction"},{"text":" (handled by ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" already, no double-tracking).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Skips when ","type":"text"},{"type":"codeVoice","code":"state.isOptedOut"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Calls ","type":"text"},{"type":"codeVoice","code":"mapper.map(state, action)"},{"text":" and tracks each returned event via ","type":"text"},{"type":"codeVoice","code":"service.track"},{"text":", with ","type":"text"},{"type":"codeVoice","code":"currentScreen"},{"text":" auto-attached as ","type":"text"},{"type":"codeVoice","code":"screen"},{"text":" (unless the event already provides its own ","type":"text"},{"type":"codeVoice","code":"screen"},{"text":").","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in."}]},{"level":2,"type":"heading","anchor":"Auto-identify-semantics","text":"Auto-identify semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When configured with an "},{"type":"codeVoice","code":"AnalyticsIdentity"},{"type":"text","text":", the plugin re-evaluates both the "},{"type":"codeVoice","code":"userID"},{"type":"text","text":" and "},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" closures each non-analytics dispatch and diffs the pair "},{"type":"codeVoice","code":"(userID, userProperties)"},{"type":"text","text":" against the last value sent to the service:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"nil → \"u1\""},{"text":" (sign-in): updates ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"text":", fires ","type":"text"},{"type":"codeVoice","code":"service.identify(userID:\"u1\", properties:)"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"\"u1\" → \"u2\""},{"text":" (account switch): updates both, fires ","type":"text"},{"type":"codeVoice","code":"service.identify(userID:\"u2\", properties:)"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Stable userID, ","type":"text"},{"type":"codeVoice","code":"userProperties"},{"text":" content changed: updates ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"text":", fires ","type":"text"},{"type":"codeVoice","code":"service.identify(userID:, properties:)"},{"text":" with the new dictionary.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"\"u1\" → nil"},{"text":" (sign-out): clears both, fires ","type":"text"},{"type":"codeVoice","code":"service.reset()"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Stable userID and stable ","type":"text"},{"type":"codeVoice","code":"userProperties"},{"text":": no-op.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" is re-evaluated every non-analytics dispatch; dictionary equality decides whether to re-fire "},{"type":"codeVoice","code":"identify"},{"type":"text","text":". This keeps derived people-properties (subscription tier, paywall entitlements, feature flags) in sync with state without any explicit "},{"type":"codeVoice","code":".identify"},{"type":"text","text":" plumbing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When opted out, auto-identify is paused: neither "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" nor "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":" is updated. Opting back in re-establishes identity correctly on the next dispatch."}]},{"level":2,"type":"heading","anchor":"Flushing","text":"Flushing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnalyticsPlugin.flush()"},{"type":"text","text":" awaits any pending fire-and-forget service calls spawned by "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":", then calls "},{"type":"codeVoice","code":"service.flush()"},{"type":"text","text":". Call this on app shutdown to avoid losing in-flight events:"}]},{"type":"codeListing","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Implementing-an-AnalyticsService","text":"Implementing an `AnalyticsService`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is provider-agnostic. Your conformer is responsible for translating "},{"type":"codeVoice","code":"AnalyticsEvent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" into whatever the backend SDK expects."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol has five methods, all "},{"type":"codeVoice","code":"async"},{"type":"text","text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical Mixpanel conformer holds a reference to the "},{"type":"codeVoice","code":"Mixpanel.Instance"},{"type":"text","text":" and translates "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" → "},{"type":"codeVoice","code":"MixpanelType"},{"type":"text","text":". An Amplitude conformer holds an "},{"type":"codeVoice","code":"Amplitude"},{"type":"text","text":" instance and translates to "},{"type":"codeVoice","code":"[String: Any]"},{"type":"text","text":". Either way, the plugin stays the same."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note what the protocol does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" require: no opt-out flag (the plugin handles that), no super-property machinery for "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" (the plugin handles that), and no event batching policy (your call)."}]}]}],"variants":[{"paths":["\/documentation\/swidux\/pluginanalyticsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"role":"article","kind":"article","title":"SwiduxFeatureFlags Reference","url":"\/documentation\/swidux\/pluginfeatureflagsreference"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"role":"article","kind":"article","title":"EntityStore","url":"\/documentation\/swidux\/entitystoreguide"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"role":"article","kind":"article","title":"Troubleshooting","url":"\/documentation\/swidux\/troubleshooting"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","url":"\/documentation\/swidux\/keyvaluestoreguide","kind":"article","type":"topic","role":"collectionGroup","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"title":"KeyValueStore"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"role":"symbol","kind":"symbol","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"title":"UndoPlugin","url":"\/documentation\/swidux\/undoplugin"},"https://github.com/heirloomlogic/SwiduxMixpanelAnalytics":{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","url":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","type":"link","title":"SwiduxMixpanelAnalytics","titleInlineContent":[{"type":"codeVoice","code":"SwiduxMixpanelAnalytics"}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"role":"article","kind":"article","title":"Plugin Architecture","url":"\/documentation\/swidux\/pluginarchitecture"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","url":"\/documentation\/swidux\/pluginkillswitchreference","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"title":"SwiduxKillswitch Reference"},"doc://Swidux/documentation/Swidux/UndoRedo":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","url":"\/documentation\/swidux\/undoredo","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":"."}],"title":"Undo \/ Redo"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","url":"\/documentation\/swidux\/pluginparentalgatereference","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"title":"SwiduxParentalGate Reference"},"https://heirloomlogic.github.io/SwiduxMixpanelAnalytics/documentation/swiduxmixpanelanalytics/":{"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","url":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","type":"link","title":"DocC reference","titleInlineContent":[{"type":"text","text":"DocC reference"}]},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"title":"Persistence Middleware","kind":"article","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"url":"\/documentation\/swidux\/persistencemiddlewareguide","type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","url":"\/documentation\/swidux\/pluginpaywallreference","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"title":"SwiduxPaywall Reference"},"doc://Swidux/documentation/Swidux/MacrosReference":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","abstract":[{"text":"Reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" and its property markers (the SwiftData persistence bridge, shipped in ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":").","type":"text"}],"role":"article","kind":"article","title":"Macros","url":"\/documentation\/swidux\/macrosreference"},"doc://Swidux/documentation/Swidux":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"role":"collection","kind":"symbol","title":"Swidux","url":"\/documentation\/swidux"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"role":"article","kind":"article","title":"Add Analytics","url":"\/documentation\/swidux\/howtoaddanalytics"},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"role":"article","kind":"article","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted"}}}