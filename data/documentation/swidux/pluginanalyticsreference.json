{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"anchor":"Reference","title":"Reference"}],"sections":[],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","interfaceLanguage":"swift"},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Swidux"}],"title":"SwiduxAnalytics Reference"},"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"variants":[{"paths":["\/documentation\/swidux\/pluginanalyticsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":". Unlike the gate-style plugins ("},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":"), analytics is an "},{"type":"strong","inlineContent":[{"type":"text","text":"observer"}]},{"type":"text","text":": it watches actions flow by and emits events, but never blocks dispatch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two surfaces:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Mapper (passive)","type":"text"}],"type":"strong"},{"text":" — App declares a ","type":"text"},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"text":" closure once at registration. The plugin runs it in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action while the user is opted in.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"AnalyticsAction","type":"codeVoice"},{"text":" (explicit)","type":"text"}],"type":"strong"},{"text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plus optional "},{"type":"strong","inlineContent":[{"type":"text","text":"auto-identify"}]},{"type":"text","text":": pass an "},{"type":"codeVoice","code":"AnalyticsIdentity"},{"type":"text","text":" keypath and the plugin watches userID transitions across dispatches, firing "},{"type":"codeVoice","code":"service.identify"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"service.reset"},{"type":"text","text":" automatically."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]},{"text":"Library target","anchor":"Library-target","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxAnalytics","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":"."}]},{"text":"Provided implementations","anchor":"Provided-implementations","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin ships with "},{"type":"codeVoice","code":"MockAnalyticsService"},{"type":"text","text":" for previews and tests. For production Mixpanel integrations, the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},{"type":"text","text":" companion package provides:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" — an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that forwards to the Mixpanel SDK and maps ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" to native Mixpanel types.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"text":" — a Mixpanel-flavored mock for previews.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For other backends (Amplitude, PostHog, Segment, custom), implement "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" directly — see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},{"type":"text","text":" Step 3, Path B."}]},{"text":"Types","anchor":"Types","type":"heading","level":2},{"text":"`AnalyticsPlugin<RootState, RootAction>`","anchor":"AnalyticsPlugin%3CRootState-RootAction%3E","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"type":"codeVoice","code":"AnalyticsState"},{"type":"text","text":" and an action enum typed as "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" (not a struct) because it tracks pending fire-and-forget service calls so that "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" can deterministically await them — same reason "},{"type":"codeVoice","code":"PersistencePlugin"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UndoPlugin"},{"type":"text","text":" are classes."}]},{"text":"`AnalyticsState`","anchor":"AnalyticsState","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" struct. The slice the plugin owns."}]},{"type":"codeListing","syntax":"swift","code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"isOptedOut","type":"codeVoice"},{"type":"text","text":" — App-controlled privacy flag. While "},{"code":"true","type":"codeVoice"},{"type":"text","text":", mapper events are dropped, explicit "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":" actions become no-ops, and auto-identify is paused."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"currentScreen","type":"codeVoice"},{"text":" — The most recent screen recorded via ","type":"text"},{"code":".screenView(_:)","type":"codeVoice"},{"type":"text","text":", auto-attached as the "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" property on subsequent tracked events."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions.","type":"text"}]}]}]},{"type":"heading","level":3,"text":"`AnalyticsAction`","anchor":"AnalyticsAction"},{"type":"codeListing","syntax":"swift","code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"]},{"type":"paragraph","inlineContent":[{"text":"Convenience factories cover the common no-properties cases:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"]},{"anchor":"AnalyticsEvent","level":3,"type":"heading","text":"`AnalyticsEvent`"},{"type":"codeListing","syntax":"swift","code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"]},{"anchor":"AnalyticsValue","level":3,"text":"`AnalyticsValue`","type":"heading"},{"inlineContent":[{"text":"Closed enum keeping the protocol provider-agnostic and ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":". Each service adapter maps these cases to its native property type."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"]},{"inlineContent":[{"type":"text","text":"Literal conformances keep call-sites clean:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"]},{"type":"heading","level":3,"text":"`AnalyticsMapper<State, Action>`","anchor":"AnalyticsMapper%3CState-Action%3E"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wraps the declarative "},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"type":"text","text":" closure."}]},{"type":"codeListing","syntax":"swift","code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"]},{"type":"paragraph","inlineContent":[{"text":"Returning an empty array is the no-op case. ","type":"text"},{"type":"codeVoice","code":".none"},{"text":" is the default mapper for plugins that only use explicit ","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"text":" dispatches.","type":"text"}]},{"type":"heading","level":3,"text":"`AnalyticsIdentity<State>`","anchor":"AnalyticsIdentity%3CState%3E"},{"type":"paragraph","inlineContent":[{"text":"Declarative source-of-truth for the active user’s identity.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"]},{"type":"paragraph","inlineContent":[{"text":"The KeyPath convenience init is the typical shape: ","type":"text"},{"code":"AnalyticsIdentity(userID: \\.auth.currentUserID)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","level":3,"text":"`AnalyticsService` (protocol)","anchor":"AnalyticsService-protocol"},{"type":"codeListing","syntax":"swift","code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"]},{"type":"paragraph","inlineContent":[{"text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes ","type":"text"},{"type":"codeVoice","code":"track"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"identify"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"alias"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"reset"},{"text":" fire-and-forget; only ","type":"text"},{"type":"codeVoice","code":"flush"},{"text":" is awaited.","type":"text"}]},{"anchor":"MockAnalyticsService","level":3,"type":"heading","text":"`MockAnalyticsService`"},{"type":"paragraph","inlineContent":[{"text":"No-op conformer for previews and development.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"]},{"type":"heading","level":2,"text":"Action semantics","anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}]},{"type":"heading","level":3,"text":"`track(AnalyticsEvent)`","anchor":"trackAnalyticsEvent"},{"type":"paragraph","inlineContent":[{"text":"Returns an effect calling ","type":"text"},{"code":"service.track(event)","type":"codeVoice"},{"text":", with ","type":"text"},{"type":"codeVoice","code":"currentScreen"},{"text":" auto-attached as the ","type":"text"},{"code":"screen","type":"codeVoice"},{"text":" property if the event doesn’t already specify one. Skipped entirely (returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":") when opted out. No state mutation.","type":"text"}]},{"text":"`screenView(String, properties:)`","anchor":"screenViewString-properties","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"currentScreen"},{"text":" to the given name ","type":"text"},{"inlineContent":[{"text":"regardless of opt-out","type":"text"}],"type":"strong"},{"text":" (the screen state still progresses for when the user opts back in). Returns an effect calling ","type":"text"},{"code":"service.track","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"\"screen_view\"","type":"codeVoice"},{"text":" event whose properties include ","type":"text"},{"code":"screen_name","type":"codeVoice"},{"text":" plus any extras. Skipped (returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":") when opted out.","type":"text"}]},{"text":"`identify(userID:, properties:)`","anchor":"identifyuserID-properties","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"lastIdentifiedUserID = userID"},{"type":"text","text":" and returns an effect calling "},{"type":"codeVoice","code":"service.identify"},{"text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change.","type":"text"}]},{"anchor":"aliasnewID-previousID","level":3,"type":"heading","text":"`alias(newID:, previousID:)`"},{"inlineContent":[{"text":"No state mutation. Returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.alias"},{"text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID.","type":"text"}],"type":"paragraph"},{"anchor":"reset","level":3,"type":"heading","text":"`reset`"},{"inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID = nil"},{"text":" and returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.reset()"},{"text":". Runs even when opted out — ","type":"text"},{"type":"codeVoice","code":"reset"},{"text":" is by definition a clean-slate operation.","type":"text"}],"type":"paragraph"},{"anchor":"setOptedOutBool","level":3,"type":"heading","text":"`setOptedOut(Bool)`"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"setOptedOut(true)","type":"codeVoice"},{"text":" — Sets ","type":"text"},{"code":"isOptedOut = true","type":"codeVoice"},{"text":", clears ","type":"text"},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":", returns an effect calling ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":" to clear server-side identity.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"setOptedOut(false)","type":"codeVoice"},{"text":" — Clears the flag without a service call. Auto-identify on the next dispatch will re-establish identity.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Mapper-semantics","level":2,"type":"heading","text":"Mapper semantics"},{"inlineContent":[{"text":"The mapper runs in ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":" for every non-analytics action while the user is opted in. The plugin:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Skips entirely if the action is an ","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"text":" (handled by ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" already, no double-tracking).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Skips when ","type":"text"},{"code":"state.isOptedOut","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Calls ","type":"text"},{"code":"mapper.map(state, action)","type":"codeVoice"},{"text":" and tracks each returned event via ","type":"text"},{"code":"service.track","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"text":" auto-attached as ","type":"text"},{"code":"screen","type":"codeVoice"},{"text":" (unless the event already provides its own ","type":"text"},{"code":"screen","type":"codeVoice"},{"text":").","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in.","type":"text"}],"type":"paragraph"},{"anchor":"Auto-identify-semantics","level":2,"type":"heading","text":"Auto-identify semantics"},{"inlineContent":[{"text":"When configured with an ","type":"text"},{"type":"codeVoice","code":"AnalyticsIdentity"},{"text":", the plugin re-evaluates both the ","type":"text"},{"type":"codeVoice","code":"userID"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"userProperties"},{"text":" closures each non-analytics dispatch and diffs the pair ","type":"text"},{"type":"codeVoice","code":"(userID, userProperties)"},{"text":" against the last value sent to the service:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"nil → \"u1\"","type":"codeVoice"},{"text":" (sign-in): updates ","type":"text"},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"text":", fires ","type":"text"},{"code":"service.identify(userID:\"u1\", properties:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"\"u1\" → \"u2\"","type":"codeVoice"},{"text":" (account switch): updates both, fires ","type":"text"},{"code":"service.identify(userID:\"u2\", properties:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Stable userID, ","type":"text"},{"code":"userProperties","type":"codeVoice"},{"text":" content changed: updates ","type":"text"},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"text":", fires ","type":"text"},{"code":"service.identify(userID:, properties:)","type":"codeVoice"},{"text":" with the new dictionary.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"\"u1\" → nil","type":"codeVoice"},{"text":" (sign-out): clears both, fires ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Stable userID and stable ","type":"text"},{"code":"userProperties","type":"codeVoice"},{"text":": no-op.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"userProperties"},{"text":" is re-evaluated every non-analytics dispatch; dictionary equality decides whether to re-fire ","type":"text"},{"type":"codeVoice","code":"identify"},{"text":". This keeps derived people-properties (subscription tier, paywall entitlements, feature flags) in sync with state without any explicit ","type":"text"},{"type":"codeVoice","code":".identify"},{"text":" plumbing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When opted out, auto-identify is paused: neither ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"text":" nor ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"text":" is updated. Opting back in re-establishes identity correctly on the next dispatch.","type":"text"}],"type":"paragraph"},{"anchor":"Flushing","level":2,"type":"heading","text":"Flushing"},{"inlineContent":[{"type":"codeVoice","code":"AnalyticsPlugin.flush()"},{"text":" awaits any pending fire-and-forget service calls spawned by ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":", then calls ","type":"text"},{"type":"codeVoice","code":"service.flush()"},{"text":". Call this on app shutdown to avoid losing in-flight events:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"]},{"anchor":"Implementing-an-AnalyticsService","level":2,"type":"heading","text":"Implementing an `AnalyticsService`"},{"inlineContent":[{"text":"The plugin is provider-agnostic. Your conformer is responsible for translating ","type":"text"},{"type":"codeVoice","code":"AnalyticsEvent"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"AnalyticsValue"},{"text":" into whatever the backend SDK expects.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The protocol has five methods, all ","type":"text"},{"type":"codeVoice","code":"async"},{"text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A typical Mixpanel conformer holds a reference to the ","type":"text"},{"type":"codeVoice","code":"Mixpanel.Instance"},{"text":" and translates ","type":"text"},{"type":"codeVoice","code":"AnalyticsValue"},{"text":" → ","type":"text"},{"type":"codeVoice","code":"MixpanelType"},{"text":". An Amplitude conformer holds an ","type":"text"},{"type":"codeVoice","code":"Amplitude"},{"text":" instance and translates to ","type":"text"},{"type":"codeVoice","code":"[String: Any]"},{"text":". Either way, the plugin stays the same.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Note what the protocol does ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" require: no opt-out flag (the plugin handles that), no super-property machinery for ","type":"text"},{"type":"codeVoice","code":"curre