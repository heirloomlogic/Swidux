{"kind":"article","seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"generated":true,"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"]}],"variants":[{"paths":["\/documentation\/swidux\/pluginanalyticsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference"},"metadata":{"role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"SwiduxAnalytics Reference"},"abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":". Unlike the gate-style plugins ("},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":"), analytics is an "},{"type":"strong","inlineContent":[{"type":"text","text":"observer"}]},{"type":"text","text":": it watches actions flow by and emits events, but never blocks dispatch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two surfaces:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Mapper (passive)"}],"type":"strong"},{"text":" — App declares a ","type":"text"},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"text":" closure once at registration. The plugin runs it in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action while the user is opted in.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"AnalyticsAction","type":"codeVoice"},{"type":"text","text":" (explicit)"}],"type":"strong"},{"text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plus optional "},{"type":"strong","inlineContent":[{"type":"text","text":"auto-identify"}]},{"type":"text","text":": pass an "},{"code":"AnalyticsIdentity","type":"codeVoice"},{"type":"text","text":" keypath and the plugin watches userID transitions across dispatches, firing "},{"code":"service.identify","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"service.reset","type":"codeVoice"},{"type":"text","text":" automatically."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Library-target","level":2,"text":"Library target"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxAnalytics","type":"codeVoice"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":" alongside "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Provided-implementations","level":2,"text":"Provided implementations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"MockAnalyticsService","type":"codeVoice"},{"text":" — silent no-op, for previews and tests.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ConsoleAnalyticsService","type":"codeVoice"},{"text":" — logs every call to ","type":"text"},{"code":"os.Logger","type":"codeVoice"},{"text":". Use this as the default ","type":"text"},{"code":"service:","type":"codeVoice"},{"text":" while the analytics vendor decision is still open: analytics wiring can be developed and QA-tested end to end with no SDK and no vendor commitment. Adopting a real provider later is the usual two-line change in ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For production Mixpanel integrations, the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},{"type":"text","text":" companion package provides:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" — an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that forwards to the Mixpanel SDK and maps ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" to native Mixpanel types.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"text":" — a Mixpanel-flavored mock for previews.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Full API documentation lives in the package’s own "},{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For other backends (Amplitude, PostHog, Segment, custom), implement "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" directly — see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},{"type":"text","text":" Step 3, Path B."}]},{"type":"heading","anchor":"Types","level":2,"text":"Types"},{"type":"heading","anchor":"AnalyticsPlugin%3CRootState-RootAction%3E","level":3,"text":"`AnalyticsPlugin<RootState, RootAction>`"},{"type":"paragraph","inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" "},{"code":"final class","type":"codeVoice"},{"type":"text","text":" "},{"code":"SwiduxPlugin","type":"codeVoice"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"code":"AnalyticsState","type":"codeVoice"},{"type":"text","text":" and an action enum typed as "},{"code":"AnalyticsAction","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is a "},{"code":"final class","type":"codeVoice"},{"type":"text","text":" (not a struct) because it tracks pending fire-and-forget service calls so that "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" can deterministically await them — same reason "},{"code":"PersistencePlugin","type":"codeVoice"},{"type":"text","text":" and "},{"code":"UndoPlugin","type":"codeVoice"},{"type":"text","text":" are classes."}]},{"type":"heading","anchor":"AnalyticsState","level":3,"text":"`AnalyticsState`"},{"type":"paragraph","inlineContent":[{"code":"Sendable","type":"codeVoice"},{"type":"text","text":", "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":" struct. The slice the plugin owns."}]},{"type":"codeListing","code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"isOptedOut","type":"codeVoice"},{"text":" — App-controlled privacy flag. While ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", mapper events are dropped, explicit ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" actions become no-ops, and auto-identify is paused.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"currentScreen","type":"codeVoice"},{"text":" — The most recent screen recorded via ","type":"text"},{"code":".screenView(_:)","type":"codeVoice"},{"text":", auto-attached as the ","type":"text"},{"code":"screen","type":"codeVoice"},{"text":" property on subsequent tracked events.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions.","type":"text"}]}]}]},{"type":"heading","anchor":"AnalyticsAction","level":3,"text":"`AnalyticsAction`"},{"type":"codeListing","code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Convenience factories cover the common no-properties cases:"}]},{"type":"codeListing","code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"],"syntax":"swift"},{"type":"heading","anchor":"AnalyticsEvent","level":3,"text":"`AnalyticsEvent`"},{"type":"codeListing","code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"],"syntax":"swift"},{"type":"heading","anchor":"AnalyticsValue","level":3,"text":"`AnalyticsValue`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Closed enum keeping the protocol provider-agnostic and "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":". Each service adapter maps these cases to its native property type."}]},{"type":"codeListing","code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Literal conformances keep call-sites clean:"}]},{"type":"codeListing","code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"],"syntax":"swift"},{"type":"heading","anchor":"AnalyticsMapper%3CState-Action%3E","level":3,"text":"`AnalyticsMapper<State, Action>`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wraps the declarative "},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"type":"text","text":" closure."}]},{"type":"codeListing","code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. "},{"code":".none","type":"codeVoice"},{"type":"text","text":" is the default mapper for plugins that only use explicit "},{"code":"AnalyticsAction","type":"codeVoice"},{"type":"text","text":" dispatches."}]},{"type":"heading","anchor":"AnalyticsIdentity%3CState%3E","level":3,"text":"`AnalyticsIdentity<State>`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declarative source-of-truth for the active user’s identity."}]},{"type":"codeListing","code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The KeyPath convenience init is the typical shape: "},{"code":"AnalyticsIdentity(userID: \\.auth.currentUserID)","type":"codeVoice"},{"type":"text","text":"."}]},{"level":3,"anchor":"AnalyticsService-protocol","type":"heading","text":"`AnalyticsService` (protocol)"},{"code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes "},{"code":"track","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"identify","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"alias","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"reset","type":"codeVoice"},{"type":"text","text":" fire-and-forget; only "},{"code":"flush","type":"codeVoice"},{"type":"text","text":" is awaited."}]},{"text":"`MockAnalyticsService`","anchor":"MockAnalyticsService","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"No-op conformer for previews and development."}]},{"type":"codeListing","code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"],"syntax":"swift"},{"type":"heading","anchor":"ConsoleAnalyticsService","level":3,"text":"`ConsoleAnalyticsService`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Logs every "},{"code":"track","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"identify","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"alias","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"reset","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"flush","type":"codeVoice"},{"type":"text","text":" to "},{"code":"os.Logger","type":"codeVoice"},{"type":"text","text":", with a recursive pretty-printer for "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":". The recommended default before a vendor is chosen."}]},{"type":"codeListing","code":["public struct ConsoleAnalyticsService: AnalyticsService {","    public init(subsystem: String = \"Swidux\", category: String = \"Analytics\")","    \/\/ Each call logs one structured line; output visible in","    \/\/ the Xcode console and Console.app, quiet in Release.","}"],"syntax":"swift"},{"type":"heading","anchor":"Action-semantics","level":2,"text":"Action semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}]},{"level":3,"type":"heading","text":"`track(AnalyticsEvent)`","anchor":"trackAnalyticsEvent"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns an effect calling "},{"type":"codeVoice","code":"service.track(event)"},{"type":"text","text":", with "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached as the "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" property if the event doesn’t already specify one. Skipped entirely (returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":") when opted out. No state mutation."}]},{"level":3,"anchor":"screenViewString-properties","type":"heading","text":"`screenView(String, properties:)`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"currentScreen","type":"codeVoice"},{"type":"text","text":" to the given name "},{"inlineContent":[{"type":"text","text":"regardless of opt-out"}],"type":"strong"},{"type":"text","text":" (the screen state still progresses for when the user opts back in). Returns an effect calling "},{"code":"service.track","type":"codeVoice"},{"type":"text","text":" with a "},{"code":"\"screen_view\"","type":"codeVoice"},{"type":"text","text":" event whose properties include "},{"code":"screen_name","type":"codeVoice"},{"type":"text","text":" plus any extras. Skipped (returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":") when opted out."}]},{"type":"heading","level":3,"anchor":"identifyuserID-properties","text":"`identify(userID:, properties:)`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"lastIdentifiedUserID = userID","type":"codeVoice"},{"type":"text","text":" and returns an effect calling "},{"code":"service.identify","type":"codeVoice"},{"type":"text","text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change."}]},{"type":"heading","level":3,"anchor":"aliasnewID-previousID","text":"`alias(newID:, previousID:)`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No state mutation. Returns an effect calling "},{"code":"service.alias","type":"codeVoice"},{"type":"text","text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID."}]},{"type":"heading","level":3,"anchor":"reset","text":"`reset`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"lastIdentifiedUserID = nil","type":"codeVoice"},{"type":"text","text":" and returns an effect calling "},{"code":"service.reset()","type":"codeVoice"},{"type":"text","text":". Runs even when opted out — "},{"code":"reset","type":"codeVoice"},{"type":"text","text":" is by definition a clean-slate operation."}]},{"level":3,"type":"heading","text":"`setOptedOut(Bool)`","anchor":"setOptedOutBool"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"setOptedOut(true)","type":"codeVoice"},{"type":"text","text":" — Sets "},{"code":"isOptedOut = true","type":"codeVoice"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":", returns an effect calling "},{"code":"service.reset()","type":"codeVoice"},{"type":"text","text":" to clear server-side identity."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"setOptedOut(false)"},{"type":"text","text":" — Clears the flag without a service call. Auto-identify on the next dispatch will re-establish identity."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Mapper-semantics","text":"Mapper semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mapper runs in "},{"code":"afterReduce","type":"codeVoice"},{"type":"text","text":" for every non-analytics action while the user is opted in. The plugin:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Skips entirely if the action is an "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" (handled by "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" already, no double-tracking)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Skips when "},{"type":"codeVoice","code":"state.isOptedOut"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Calls "},{"type":"codeVoice","code":"mapper.map(state, action)"},{"type":"text","text":" and tracks each returned event via "},{"type":"codeVoice","code":"service.track"},{"type":"text","text":", with "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached as "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" (unless the event already provides its own "},{"type":"codeVoice","code":"screen"},{"type":"text","text":")."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in."}]},{"type":"heading","level":2,"anchor":"Auto-identify-semantics","text":"Auto-identify semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When configured with an "},{"code":"AnalyticsIdentity","type":"codeVoice"},{"type":"text","text":", the plugin re-evaluates both the "},{"code":"userID","type":"codeVoice"},{"type":"text","text":" and "},{"code":"userProperties","type":"codeVoice"},{"type":"text","text":" closures each non-analytics dispatch and diffs the pair "},{"code":"(userID, userProperties)","type":"codeVoice"},{"type":"text","text":" against the last value sent to the service:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"nil → \"u1\""},{"type":"text","text":" (sign-in): updates "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":", fires "},{"type":"codeVoice","code":"service.identify(userID:\"u1\", properties:)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"\"u1\" → \"u2\""},{"type":"text","text":" (account switch): updates both, fires "},{"type":"codeVoice","code":"service.identify(userID:\"u2\", properties:)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Stable userID, "},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" content changed: updates "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":", fires "},{"type":"codeVoice","code":"service.identify(userID:, properties:)"},{"type":"text","text":" with the new dictionary."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"\"u1\" → nil"},{"type":"text","text":" (sign-out): clears both, fires "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Stable userID and stable "},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":": no-op."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"code":"userProperties","type":"codeVoice"},{"type":"text","text":" is re-evaluated every non-analytics dispatch; dictionary equality decides whether to re-fire "},{"code":"identify","type":"codeVoice"},{"type":"text","text":". This keeps derived people-properties (subscription tier, paywall entitlements, feature flags) in sync with state without any explicit "},{"code":".identify","type":"codeVoice"},{"type":"text","text":" plumbing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When opted out, auto-identify is paused: neither "},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"type":"text","text":" nor "},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"type":"text","text":" is updated. Opting back in re-establishes identity correctly on the next dispatch."}]},{"type":"heading","level":2,"anchor":"Flushing","text":"Flushing"},{"type":"paragraph","inlineContent":[{"code":"AnalyticsPlugin.flush()","type":"codeVoice"},{"type":"text","text":" awaits any pending fire-and-forget service calls spawned by "},{"code":"afterReduce","type":"codeVoice"},{"type":"text","text":", then calls "},{"code":"service.flush()","type":"codeVoice"},{"type":"text","text":". Call this on app shutdown to avoid losing in-flight events:"}]},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Implementing an `AnalyticsService`","anchor":"Implementing-an-AnalyticsService"},{"inlineContent":[{"type":"text","text":"The plugin is provider-agnostic. Your conformer is responsible for translating "},{"code":"AnalyticsEvent","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" into whatever the backend SDK expects."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The protocol has five methods, all "},{"code":"async","type":"codeVoice"},{"type":"text","text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A typical Mixpanel conformer holds a reference to the "},{"code":"Mixpanel.Instance","type":"codeVoice"},{"type":"text","text":" and translates "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" → "},{"code":"MixpanelType","type":"codeVoice"},{"type":"text","text":". An Amplitude conformer holds an "},{"code":"Amplitude","type":"codeVoice"},{"type":"text","text":" instance and translates to "},{"code":"[String: Any]","type":"codeVoice"},{"type":"text","text":". Either way, the plugin stays the same."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Note what the protocol does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" require: no opt-out flag (the plugin handles that), no super-property machinery for "},{"code":"currentScreen","type":"codeVoice"},{"type":"text","text":" (the plugin handles that), and no event batching policy (your call)."}],"type":"paragraph"}]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","type":"topic","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"role":"article","url":"\/documentation\/swidux\/howtoaddanalytics","title":"Add Analytics"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"topic","kind":"article","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"role":"article","url":"\/documentation\/swidux\/persistencemiddlewareguide","title":"Persistence Middleware"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","type":"topic","kind":"article","abstract":[{"text":"Public API surface for the ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"role":"article","url":"\/documentation\/swidux\/pluginkillswitchreference","title":"SwiduxKillswitch Reference"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"topic","kind":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking.