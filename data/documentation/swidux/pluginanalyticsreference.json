{"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"title":"Reference","anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true}],"kind":"article","identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","interfaceLanguage":"swift"},"metadata":{"title":"SwiduxAnalytics Reference","roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":". Unlike the gate-style plugins (","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":"), analytics is an ","type":"text"},{"type":"strong","inlineContent":[{"text":"observer","type":"text"}]},{"text":": it watches actions flow by and emits events, but never blocks dispatch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two surfaces:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Mapper (passive)"}]},{"type":"text","text":" — App declares a "},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"type":"text","text":" closure once at registration. The plugin runs it in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action while the user is opted in."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" (explicit)"}]},{"type":"text","text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Plus optional ","type":"text"},{"type":"strong","inlineContent":[{"text":"auto-identify","type":"text"}]},{"text":": pass an ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":" keypath and the plugin watches userID transitions across dispatches, firing ","type":"text"},{"code":"service.identify","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"service.reset","type":"codeVoice"},{"text":" automatically.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},{"text":". For where this plugin sits in the lifecycle, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}]},{"text":"Library target","type":"heading","level":2,"anchor":"Library-target"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxAnalytics"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxAnalytics"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target dependencies in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" alongside ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"Provided implementations","type":"heading","level":2,"anchor":"Provided-implementations"},{"type":"paragraph","inlineContent":[{"text":"The plugin ships with ","type":"text"},{"code":"MockAnalyticsService","type":"codeVoice"},{"text":" for previews and tests. For production Mixpanel integrations, the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},{"text":" companion package provides:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":" — an "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" conformer that forwards to the Mixpanel SDK and maps "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" to native Mixpanel types."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" — a Mixpanel-flavored mock for previews."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"For other backends (Amplitude, PostHog, Segment, custom), implement ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" directly — see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},{"text":" Step 3, Path B.","type":"text"}]},{"text":"Types","type":"heading","level":2,"anchor":"Types"},{"text":"`AnalyticsPlugin<RootState, RootAction>`","type":"heading","level":3,"anchor":"AnalyticsPlugin%3CRootState-RootAction%3E"},{"type":"paragraph","inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"text":" ","type":"text"},{"code":"final class","type":"codeVoice"},{"text":" ","type":"text"},{"code":"SwiduxPlugin","type":"codeVoice"},{"text":" conformer. Owns a slice of root state typed as ","type":"text"},{"code":"AnalyticsState","type":"codeVoice"},{"text":" and an action enum typed as ","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil",")"]},{"type":"paragraph","inlineContent":[{"text":"The plugin is a ","type":"text"},{"code":"final class","type":"codeVoice"},{"text":" (not a struct) because it tracks pending fire-and-forget service calls so that ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":" can deterministically await them — same reason ","type":"text"},{"code":"PersistencePlugin","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"UndoPlugin","type":"codeVoice"},{"text":" are classes.","type":"text"}]},{"text":"`AnalyticsState`","type":"heading","level":3,"anchor":"AnalyticsState"},{"type":"paragraph","inlineContent":[{"code":"Sendable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" struct. The slice the plugin owns.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"isOptedOut","type":"codeVoice"},{"text":" — App-controlled privacy flag. While ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", mapper events are dropped, explicit ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" actions become no-ops, and auto-identify is paused.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"currentScreen","type":"codeVoice"},{"text":" — The most recent screen recorded via ","type":"text"},{"code":".screenView(_:)","type":"codeVoice"},{"text":", auto-attached as the ","type":"text"},{"code":"screen","type":"codeVoice"},{"text":" property on subsequent tracked events.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions.","type":"text"}]}]}],"type":"unorderedList"},{"text":"`AnalyticsAction`","type":"heading","level":3,"anchor":"AnalyticsAction"},{"type":"codeListing","syntax":"swift","code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"]},{"type":"paragraph","inlineContent":[{"text":"Convenience factories cover the common no-properties cases:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"]},{"text":"`AnalyticsEvent`","type":"heading","level":3,"anchor":"AnalyticsEvent"},{"type":"codeListing","syntax":"swift","code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"]},{"text":"`AnalyticsValue`","type":"heading","level":3,"anchor":"AnalyticsValue"},{"type":"paragraph","inlineContent":[{"text":"Closed enum keeping the protocol provider-agnostic and ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":". Each service adapter maps these cases to its native property type.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"]},{"type":"paragraph","inlineContent":[{"text":"Literal conformances keep call-sites clean:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"]},{"text":"`AnalyticsMapper<State, Action>`","type":"heading","level":3,"anchor":"AnalyticsMapper%3CState-Action%3E"},{"type":"paragraph","inlineContent":[{"text":"Wraps the declarative ","type":"text"},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"text":" closure.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"]},{"type":"paragraph","inlineContent":[{"text":"Returning an empty array is the no-op case. ","type":"text"},{"code":".none","type":"codeVoice"},{"text":" is the default mapper for plugins that only use explicit ","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"text":" dispatches.","type":"text"}]},{"text":"`AnalyticsIdentity<State>`","type":"heading","level":3,"anchor":"AnalyticsIdentity%3CState%3E"},{"type":"paragraph","inlineContent":[{"text":"Declarative source-of-truth for the active user’s identity.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"]},{"type":"paragraph","inlineContent":[{"text":"The KeyPath convenience init is the typical shape: ","type":"text"},{"code":"AnalyticsIdentity(userID: \\.auth.currentUserID)","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"`AnalyticsService` (protocol)","type":"heading","level":3,"anchor":"AnalyticsService-protocol"},{"type":"codeListing","syntax":"swift","code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"]},{"type":"paragraph","inlineContent":[{"text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" fire-and-forget; only ","type":"text"},{"code":"flush","type":"codeVoice"},{"text":" is awaited.","type":"text"}]},{"text":"`MockAnalyticsService`","type":"heading","level":3,"anchor":"MockAnalyticsService"},{"type":"paragraph","inlineContent":[{"text":"No-op conformer for previews and development.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"]},{"text":"Action semantics","type":"heading","level":2,"anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns.","type":"text"}]},{"text":"`track(AnalyticsEvent)`","type":"heading","level":3,"anchor":"trackAnalyticsEvent"},{"type":"paragraph","inlineContent":[{"text":"Returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.track(event)"},{"type":"text","text":", with "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached as the "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" property if the event doesn’t already specify one. Skipped entirely (returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":") when opted out. No state mutation."}]},{"text":"`screenView(String, properties:)`","type":"heading","level":3,"anchor":"screenViewString-properties"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" to the given name "},{"type":"strong","inlineContent":[{"type":"text","text":"regardless of opt-out"}]},{"type":"text","text":" (the screen state still progresses for when the user opts back in). Returns an effect calling "},{"type":"codeVoice","code":"service.track"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"\"screen_view\""},{"type":"text","text":" event whose properties include "},{"type":"codeVoice","code":"screen_name"},{"type":"text","text":" plus any extras. Skipped (returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":") when opted out."}]},{"text":"`identify(userID:, properties:)`","type":"heading","level":3,"anchor":"identifyuserID-properties"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"lastIdentifiedUserID = userID","type":"codeVoice"},{"type":"text","text":" and returns an effect calling "},{"code":"service.identify","type":"codeVoice"},{"type":"text","text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change."}]},{"text":"`alias(newID:, previousID:)`","type":"heading","level":3,"anchor":"aliasnewID-previousID"},{"type":"paragraph","inlineContent":[{"text":"No state mutation. Returns an effect calling ","type":"text"},{"code":"service.alias","type":"codeVoice"},{"type":"text","text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID."}]},{"level":3,"type":"heading","anchor":"reset","text":"`reset`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"lastIdentifiedUserID = nil","type":"codeVoice"},{"type":"text","text":" and returns an effect calling "},{"code":"service.reset()","type":"codeVoice"},{"type":"text","text":". Runs even when opted out — "},{"code":"reset","type":"codeVoice"},{"text":" is by definition a clean-slate operation.","type":"text"}]},{"text":"`setOptedOut(Bool)`","type":"heading","level":3,"anchor":"setOptedOutBool"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"setOptedOut(true)"},{"type":"text","text":" — Sets "},{"type":"codeVoice","code":"isOptedOut = true"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":", returns an effect calling "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":" to clear server-side identity."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"setOptedOut(false)"},{"type":"text","text":" — Clears the flag without a service call. Auto-identify on the next dispatch will re-establish identity."}]}]}],"type":"unorderedList"},{"anchor":"Mapper-semantics","type":"heading","level":2,"text":"Mapper semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mapper runs in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action while the user is opted in. The plugin:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Skips entirely if the action is an "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" (handled by "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" already, no double-tracking)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Skips when "},{"code":"state.isOptedOut","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Calls "},{"type":"codeVoice","code":"mapper.map(state, action)"},{"type":"text","text":" and tracks each returned event via "},{"type":"codeVoice","code":"service.track"},{"type":"text","text":", with "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached as "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" (unless the event already provides its own "},{"type":"codeVoice","code":"screen"},{"type":"text","text":")."}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in."}],"type":"paragraph"},{"anchor":"Auto-identify-semantics","type":"heading","text":"Auto-identify semantics","level":2},{"type":"paragraph","inlineContent":[{"text":"When configured with an ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"type":"text","text":", the plugin watches the userID closure across every non-analytics dispatch:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"nil → \"u1\"","type":"codeVoice"},{"type":"text","text":" (sign-in): updates "},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"type":"text","text":", fires "},{"type":"codeVoice","code":"service.identify(userID:\"u1\", properties:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"u1\" → \"u2\""},{"type":"text","text":" (account switch): updates "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":", fires "},{"type":"codeVoice","code":"service.identify(userID:\"u2\", properties:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"u1\" → nil"},{"type":"text","text":" (sign-out): updates "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":", fires "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stable userID: no-op."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" is snapshotted from current state at identify time, so any state-derived people properties (e.g. subscription tier) flow with the identify call."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When opted out, auto-identify is paused: "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"text":" updated. This way, opting back in re-establishes identity correctly on the next dispatch.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Flushing","anchor":"Flushing"},{"type":"paragraph","inlineContent":[{"code":"AnalyticsPlugin.flush()","type":"codeVoice"},{"text":" awaits any pending fire-and-forget service calls spawned by ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":", then calls ","type":"text"},{"code":"service.flush()","type":"codeVoice"},{"text":". Call this on app shutdown to avoid losing in-flight events:","type":"text"}]},{"syntax":"swift","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"],"type":"codeListing"},{"level":2,"type":"heading","text":"Implementing an `AnalyticsService`","anchor":"Implementing-an-AnalyticsService"},{"type":"paragraph","inlineContent":[{"text":"The plugin is provider-agnostic. Your conformer is responsible for translating ","type":"text"},{"code":"AnalyticsEvent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" into whatever the backend SDK expects.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The protocol has five methods, all ","type":"text"},{"code":"async","type":"codeVoice"},{"text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A typical Mixpanel conformer holds a reference to the ","type":"text"},{"code":"Mixpanel.Instance","type":"codeVoice"},{"text":" and translates ","type":"text"},{"type":"codeVoice","code":"AnalyticsValue"},{"text":" → ","type":"text"},{"code":"MixpanelType","type":"codeVoice"},{"text":". An Amplitude conformer holds an ","type":"text"},{"code":"Amplitude","type":"codeVoice"},{"text":" instance and translates to ","type":"text"},{"code":"[String: Any]","type":"codeVoice"},{"text":". Either way, the plugin stays the same.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Note what the protocol does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" require: no opt-out flag (the plugin handles that), no super-property machinery for ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"text":" (the plugin handles that), and no event batching policy (your call).","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/swidux\/pluginanalyticsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"references":{"doc://Swidux/documentation/Swidux":{"kind":"symbol","type":"topic","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","url":"\/documentation\/swidux"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"kind":"article","type":"topic","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"title":"EntityStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","role":"article","url":"\/documentation\/swidux\/entitystoreguide"},"doc://Swidux/documentation/Swi