{"metadata":{"roleHeading":"Article","role":"article","title":"SwiduxAnalytics Reference","modules":[{"name":"Swidux"}]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":". Unlike the gate-style plugins ("},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":"), analytics is an "},{"type":"strong","inlineContent":[{"text":"observer","type":"text"}]},{"type":"text","text":": it watches actions flow by and emits events, but never blocks dispatch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two surfaces:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Mapper (passive)","type":"text"}],"type":"strong"},{"type":"text","text":" — App declares a "},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"type":"text","text":" closure once at registration. The plugin runs it in "},{"code":"afterReduce","type":"codeVoice"},{"type":"text","text":" for every non-analytics action while the user is opted in."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"AnalyticsAction","type":"codeVoice"},{"text":" (explicit)","type":"text"}],"type":"strong"},{"type":"text","text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plus optional "},{"type":"strong","inlineContent":[{"text":"auto-identify","type":"text"}]},{"type":"text","text":": pass an "},{"type":"codeVoice","code":"AnalyticsIdentity"},{"type":"text","text":" keypath and the plugin watches userID transitions across dispatches, firing "},{"type":"codeVoice","code":"service.identify"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"service.reset"},{"type":"text","text":" automatically."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}]},{"type":"heading","text":"Library target","anchor":"Library-target","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"code":"SwiduxAnalytics","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"code":"import SwiduxAnalytics","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":"."}]},{"type":"heading","text":"Provided implementations","anchor":"Provided-implementations","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"MockAnalyticsService","type":"codeVoice"},{"type":"text","text":" — silent no-op, for previews and tests."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"ConsoleAnalyticsService","type":"codeVoice"},{"type":"text","text":" — logs every call to "},{"code":"os.Logger","type":"codeVoice"},{"type":"text","text":". Use this as the default "},{"code":"service:","type":"codeVoice"},{"type":"text","text":" while the analytics vendor decision is still open: analytics wiring can be developed and QA-tested end to end with no SDK and no vendor commitment. Adopting a real provider later is the usual two-line change in "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For production Mixpanel integrations, the "},{"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","isActive":true},{"type":"text","text":" companion package provides:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" — an "},{"code":"AnalyticsService","type":"codeVoice"},{"type":"text","text":" conformer that forwards to the Mixpanel SDK and maps "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" to native Mixpanel types."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" — a Mixpanel-flavored mock for previews."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For other backends (Amplitude, PostHog, Segment, custom), implement "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" directly — see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true},{"type":"text","text":" Step 3, Path B."}]},{"type":"heading","text":"Types","anchor":"Types","level":2},{"type":"heading","text":"`AnalyticsPlugin<RootState, RootAction>`","anchor":"AnalyticsPlugin%3CRootState-RootAction%3E","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"type":"codeVoice","code":"AnalyticsState"},{"type":"text","text":" and an action enum typed as "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is a "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" (not a struct) because it tracks pending fire-and-forget service calls so that "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" can deterministically await them — same reason "},{"type":"codeVoice","code":"PersistencePlugin"},{"type":"text","text":" and "},{"type":"codeVoice","code":"UndoPlugin"},{"type":"text","text":" are classes."}]},{"type":"heading","text":"`AnalyticsState`","anchor":"AnalyticsState","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" struct. The slice the plugin owns."}]},{"syntax":"swift","type":"codeListing","code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"isOptedOut","type":"codeVoice"},{"type":"text","text":" — App-controlled privacy flag. While "},{"code":"true","type":"codeVoice"},{"type":"text","text":", mapper events are dropped, explicit "},{"code":"track","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"identify","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"alias","type":"codeVoice"},{"type":"text","text":" actions become no-ops, and auto-identify is paused."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"currentScreen","type":"codeVoice"},{"type":"text","text":" — The most recent screen recorded via "},{"code":".screenView(_:)","type":"codeVoice"},{"type":"text","text":", auto-attached as the "},{"code":"screen","type":"codeVoice"},{"type":"text","text":" property on subsequent tracked events."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"lastIdentifiedUserID","type":"codeVoice"},{"type":"text","text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions."}],"type":"paragraph"}]}]},{"type":"heading","text":"`AnalyticsAction`","anchor":"AnalyticsAction","level":3},{"syntax":"swift","type":"codeListing","code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Convenience factories cover the common no-properties cases:"}]},{"syntax":"swift","type":"codeListing","code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"]},{"type":"heading","text":"`AnalyticsEvent`","anchor":"AnalyticsEvent","level":3},{"syntax":"swift","type":"codeListing","code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"]},{"type":"heading","text":"`AnalyticsValue`","anchor":"AnalyticsValue","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Closed enum keeping the protocol provider-agnostic and "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":". Each service adapter maps these cases to its native property type."}]},{"syntax":"swift","type":"codeListing","code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Literal conformances keep call-sites clean:"}]},{"syntax":"swift","type":"codeListing","code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"]},{"type":"heading","text":"`AnalyticsMapper<State, Action>`","anchor":"AnalyticsMapper%3CState-Action%3E","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wraps the declarative "},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"type":"text","text":" closure."}]},{"syntax":"swift","type":"codeListing","code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. "},{"type":"codeVoice","code":".none"},{"type":"text","text":" is the default mapper for plugins that only use explicit "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" dispatches."}]},{"type":"heading","text":"`AnalyticsIdentity<State>`","anchor":"AnalyticsIdentity%3CState%3E","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declarative source-of-truth for the active user’s identity."}]},{"syntax":"swift","type":"codeListing","code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The KeyPath convenience init is the typical shape: "},{"type":"codeVoice","code":"AnalyticsIdentity(userID: \\.auth.currentUserID)"},{"type":"text","text":"."}]},{"type":"heading","text":"`AnalyticsService` (protocol)","anchor":"AnalyticsService-protocol","level":3},{"syntax":"swift","type":"codeListing","code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"reset"},{"type":"text","text":" fire-and-forget; only "},{"type":"codeVoice","code":"flush"},{"type":"text","text":" is awaited."}]},{"type":"heading","text":"`MockAnalyticsService`","anchor":"MockAnalyticsService","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"No-op conformer for previews and development."}]},{"syntax":"swift","type":"codeListing","code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"]},{"text":"`ConsoleAnalyticsService`","type":"heading","level":3,"anchor":"ConsoleAnalyticsService"},{"inlineContent":[{"type":"text","text":"Logs every "},{"code":"track","type":"codeVoice"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"reset"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"flush"},{"type":"text","text":" to "},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":", with a recursive pretty-printer for "},{"type":"codeVoice","code":"AnalyticsValue"},{"text":". The recommended default before a vendor is chosen.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public struct ConsoleAnalyticsService: AnalyticsService {","    public init(subsystem: String = \"Swidux\", category: String = \"Analytics\")","    \/\/ Each call logs one structured line; output visible in","    \/\/ the Xcode console and Console.app, quiet in Release.","}"]},{"type":"heading","text":"Action semantics","anchor":"Action-semantics","level":2},{"inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}],"type":"paragraph"},{"anchor":"trackAnalyticsEvent","level":3,"type":"heading","text":"`track(AnalyticsEvent)`"},{"inlineContent":[{"text":"Returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.track(event)"},{"text":", with ","type":"text"},{"type":"codeVoice","code":"currentScreen"},{"text":" auto-attached as the ","type":"text"},{"type":"codeVoice","code":"screen"},{"type":"text","text":" property if the event doesn’t already specify one. Skipped entirely (returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":") when opted out. No state mutation."}],"type":"paragraph"},{"anchor":"screenViewString-properties","level":3,"type":"heading","text":"`screenView(String, properties:)`"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"type":"text","text":" to the given name "},{"inlineContent":[{"type":"text","text":"regardless of opt-out"}],"type":"strong"},{"type":"text","text":" (the screen state still progresses for when the user opts back in). Returns an effect calling "},{"type":"codeVoice","code":"service.track"},{"type":"text","text":" with a "},{"code":"\"screen_view\"","type":"codeVoice"},{"type":"text","text":" event whose properties include "},{"type":"codeVoice","code":"screen_name"},{"type":"text","text":" plus any extras. Skipped (returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":") when opted out."}],"type":"paragraph"},{"anchor":"identifyuserID-properties","level":3,"type":"heading","text":"`identify(userID:, properties:)`"},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"lastIdentifiedUserID = userID"},{"type":"text","text":" and returns an effect calling "},{"type":"codeVoice","code":"service.identify"},{"type":"text","text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change."}],"type":"paragraph"},{"anchor":"aliasnewID-previousID","level":3,"type":"heading","text":"`alias(newID:, previousID:)`"},{"inlineContent":[{"type":"text","text":"No state mutation. Returns an effect calling "},{"type":"codeVoice","code":"service.alias"},{"type":"text","text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID."}],"type":"paragraph"},{"anchor":"reset","level":3,"type":"heading","text":"`reset`"},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"lastIdentifiedUserID = nil"},{"type":"text","text":" and returns an effect calling "},{"type":"codeVoice","code":"service.reset()"},{"text":". Runs even when opted out — ","type":"text"},{"type":"codeVoice","code":"reset"},{"text":" is by definition a clean-slate operation.","type":"text"}],"type":"paragraph"},{"anchor":"setOptedOutBool","level":3,"type":"heading","text":"`setOptedOut(Bool)`"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"setOptedOut(true)"},{"text":" — Sets ","type":"text"},{"type":"codeVoice","code":"isOptedOut = true"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":", returns an effect calling "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":" to clear server-side identity."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"setOptedOut(false)"},{"type":"text","text":" — Clears the flag without a service call. Auto-identify on the next dispatch will re-establish identity."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Mapper-semantics","level":2,"type":"heading","text":"Mapper semantics"},{"inlineContent":[{"type":"text","text":"The mapper runs in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action while the user is opted in. The plugin:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Skips entirely if the action is an "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" (handled by "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" already, no double-tracking)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Skips when "},{"type":"codeVoice","code":"state.isOptedOut"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Calls "},{"type":"codeVoice","code":"mapper.map(state, action)"},{"type":"text","text":" and tracks each returned event via "},{"type":"codeVoice","code":"service.track"},{"type":"text","text":", with "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached as "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" (unless the event already provides its own "},{"type":"codeVoice","code":"screen"},{"type":"text","text":")."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in."}],"type":"paragraph"},{"anchor":"Auto-identify-semantics","level":2,"type":"heading","text":"Auto-identify semantics"},{"inlineContent":[{"type":"text","text":"When configured with an "},{"type":"codeVoice","code":"AnalyticsIdentity"},{"type":"text","text":", the plugin re-evaluates both the "},{"type":"codeVoice","code":"userID"},{"type":"text","text":" and "},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" closures each non-analytics dispatch and diffs the pair "},{"type":"codeVoice","code":"(userID, userProperties)"},{"type":"text","text":" against the last value sent to the service:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"nil → \"u1\""},{"type":"text","text":" (sign-in): updates "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":", fires "},{"type":"codeVoice","code":"service.identify(userID:\"u1\", properties:)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"\"u1\" → \"u2\""},{"type":"text","text":" (account switch): updates both, fires "},{"type":"codeVoice","code":"service.identify(userID:\"u2\", properties:)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Stable userID, "},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" content changed: updates "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":", fires "},{"type":"codeVoice","code":"service.identify(userID:, properties:)"},{"type":"text","text":" with the new dictionary."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"\"u1\" → nil"},{"type":"text","text":" (sign-out): clears both, fires "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Stable userID and stable "},{"type":"codeVoice","code":"userProperties"},{"type":"text","text":": no-op."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" is re-evaluated every non-analytics dispatch; dictionary equality decides whether to re-fire "},{"type":"codeVoice","code":"identify"},{"type":"text","text":". This keeps derived people-properties (subscription tier, paywall entitlements, feature flags) in sync with state without any explicit "},{"type":"codeVoice","code":".identify"},{"type":"text","text":" plumbing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When opted out, auto-identify is paused: neither "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" nor "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":" is updated. Opting back in re-establishes identity correctly on the next dispatch."}],"type":"paragraph"},{"anchor":"Flushing","level":2,"type":"heading","text":"Flushing"},{"inlineContent":[{"type":"codeVoice","code":"AnalyticsPlugin.flush()"},{"type":"text","text":" awaits any pending fire-and-forget service calls spawned by "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":", then calls "},{"type":"codeVoice","code":"service.flush()"},{"type":"text","text":". Call this on app shutdown to avoid losing in-flight events:"}],"type":"paragraph"},{"syntax":"swift","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"],"type":"codeListing"},{"anchor":"Implementing-an-AnalyticsService","level":2,"type":"heading","text":"Implementing an `AnalyticsService`"},{"inlineContent":[{"type":"text","text":"The plugin is provider-agnostic. Your conformer is responsible for translating "},{"type":"codeVoice","code":"AnalyticsEvent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" into whatever the backend SDK expects."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The protocol has five methods, all "},{"type":"codeVoice","code":"async"},{"type":"text","text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A typical Mixpanel conformer holds a reference to the "},{"type":"codeVoice","code":"Mixpanel.Instance"},{"type":"text","text":" and translates "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" → "},{"type":"codeVoice","code":"MixpanelType"},{"type":"text","text":". An Amplitude conformer holds an "},{"type":"codeVoice","code":"Amplitude"},{"type":"text","text":" instance and translates to "},{"type":"codeVoice","code":"[String: Any]"},{"type":"text","text":". Either way, the plugin stays the same."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Note what the protocol does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" require: no opt-out flag (the plugin handles that), no super-property machinery for "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" (the plugin handles that), and no event batching policy (your call)."}],"type":"paragraph"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"title":"Reference","anchor":"Reference","generated":true}],"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginanalyticsreference"]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"kind"