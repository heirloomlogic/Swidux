{"variants":[{"paths":["\/documentation\/swidux\/pluginanalyticsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"SwiduxAnalytics Reference"},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":". Unlike the gate-style plugins ("},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":"), analytics is an "},{"type":"strong","inlineContent":[{"type":"text","text":"observer"}]},{"type":"text","text":": it watches actions flow by and emits events, but never blocks dispatch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two surfaces:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Mapper (passive)"}]},{"type":"text","text":" — App declares a "},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"type":"text","text":" closure once at registration. The plugin runs it in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action while the user is opted in."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" (explicit)"}]},{"type":"text","text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Plus optional ","type":"text"},{"inlineContent":[{"text":"auto-identify","type":"text"}],"type":"strong"},{"text":": pass an ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":" keypath and the plugin watches userID transitions across dispatches, firing ","type":"text"},{"code":"service.identify","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"service.reset","type":"codeVoice"},{"type":"text","text":" automatically."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true,"type":"reference"},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Library target","anchor":"Library-target","level":2,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Product: ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxAnalytics"}]}]}]},{"inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Provided implementations","level":2,"type":"heading","anchor":"Provided-implementations"},{"type":"paragraph","inlineContent":[{"text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"MockAnalyticsService","type":"codeVoice"},{"text":" — silent no-op, for previews and tests.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ConsoleAnalyticsService"},{"text":" — logs every call to ","type":"text"},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":". Use this as the default "},{"code":"service:","type":"codeVoice"},{"text":" while the analytics vendor decision is still open: analytics wiring can be developed and QA-tested end to end with no SDK and no vendor commitment. Adopting a real provider later is the usual two-line change in ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"For production Mixpanel integrations, the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},{"type":"text","text":" companion package provides:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" — an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that forwards to the Mixpanel SDK and maps ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" to native Mixpanel types.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":" — a Mixpanel-flavored mock for previews."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"For other backends (Amplitude, PostHog, Segment, custom), implement ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" directly — see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true,"type":"reference"},{"text":" Step 3, Path B.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Types","level":2,"text":"Types"},{"type":"heading","anchor":"AnalyticsPlugin%3CRootState-RootAction%3E","level":3,"text":"`AnalyticsPlugin<RootState, RootAction>`"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"codeVoice","code":"final class"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"type":"codeVoice","code":"AnalyticsState"},{"type":"text","text":" and an action enum typed as "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is a "},{"code":"final class","type":"codeVoice"},{"text":" (not a struct) because it tracks pending fire-and-forget service calls so that ","type":"text"},{"type":"codeVoice","code":"flush()"},{"text":" can deterministically await them — same reason ","type":"text"},{"type":"codeVoice","code":"PersistencePlugin"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"UndoPlugin"},{"type":"text","text":" are classes."}]},{"anchor":"AnalyticsState","text":"`AnalyticsState`","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" struct. The slice the plugin owns."}]},{"syntax":"swift","type":"codeListing","code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"isOptedOut","type":"codeVoice"},{"text":" — App-controlled privacy flag. While ","type":"text"},{"code":"true","type":"codeVoice"},{"text":", mapper events are dropped, explicit ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" actions become no-ops, and auto-identify is paused.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"currentScreen","type":"codeVoice"},{"type":"text","text":" — The most recent screen recorded via "},{"code":".screenView(_:)","type":"codeVoice"},{"type":"text","text":", auto-attached as the "},{"code":"screen","type":"codeVoice"},{"type":"text","text":" property on subsequent tracked events."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions.","type":"text"}]}]}]},{"anchor":"AnalyticsAction","text":"`AnalyticsAction`","type":"heading","level":3},{"syntax":"swift","type":"codeListing","code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"]},{"type":"paragraph","inlineContent":[{"text":"Convenience factories cover the common no-properties cases:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"]},{"level":3,"anchor":"AnalyticsEvent","type":"heading","text":"`AnalyticsEvent`"},{"syntax":"swift","type":"codeListing","code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"]},{"level":3,"anchor":"AnalyticsValue","type":"heading","text":"`AnalyticsValue`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Closed enum keeping the protocol provider-agnostic and "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":". Each service adapter maps these cases to its native property type."}]},{"syntax":"swift","type":"codeListing","code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Literal conformances keep call-sites clean:"}]},{"syntax":"swift","type":"codeListing","code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"]},{"level":3,"anchor":"AnalyticsMapper%3CState-Action%3E","type":"heading","text":"`AnalyticsMapper<State, Action>`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wraps the declarative "},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"type":"text","text":" closure."}]},{"syntax":"swift","type":"codeListing","code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. "},{"type":"codeVoice","code":".none"},{"type":"text","text":" is the default mapper for plugins that only use explicit "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" dispatches."}]},{"level":3,"anchor":"AnalyticsIdentity%3CState%3E","type":"heading","text":"`AnalyticsIdentity<State>`"},{"type":"paragraph","inlineContent":[{"text":"Declarative source-of-truth for the active user’s identity.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The KeyPath convenience init is the typical shape: "},{"type":"codeVoice","code":"AnalyticsIdentity(userID: \\.auth.currentUserID)"},{"type":"text","text":"."}]},{"level":3,"anchor":"AnalyticsService-protocol","type":"heading","text":"`AnalyticsService` (protocol)"},{"syntax":"swift","type":"codeListing","code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"]},{"type":"paragraph","inlineContent":[{"text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" fire-and-forget; only ","type":"text"},{"code":"flush","type":"codeVoice"},{"text":" is awaited.","type":"text"}]},{"text":"`MockAnalyticsService`","type":"heading","level":3,"anchor":"MockAnalyticsService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No-op conformer for previews and development."}]},{"code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"],"type":"codeListing","syntax":"swift"},{"text":"`ConsoleAnalyticsService`","type":"heading","level":3,"anchor":"ConsoleAnalyticsService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Logs every "},{"code":"track","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"identify","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"alias","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"reset","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"flush","type":"codeVoice"},{"type":"text","text":" to "},{"code":"os.Logger","type":"codeVoice"},{"type":"text","text":", with a recursive pretty-printer for "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":". The recommended default before a vendor is chosen."}]},{"code":["public struct ConsoleAnalyticsService: AnalyticsService {","    public init(subsystem: String = \"Swidux\", category: String = \"Analytics\")","    \/\/ Each call logs one structured line; output visible in","    \/\/ the Xcode console and Console.app, quiet in Release.","}"],"type":"codeListing","syntax":"swift"},{"text":"Action semantics","type":"heading","level":2,"anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}]},{"type":"heading","text":"`track(AnalyticsEvent)`","anchor":"trackAnalyticsEvent","level":3},{"inlineContent":[{"text":"Returns an effect calling ","type":"text"},{"code":"service.track(event)","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"text":" auto-attached as the ","type":"text"},{"code":"screen","type":"codeVoice"},{"text":" property if the event doesn’t already specify one. Skipped entirely (returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":") when opted out. No state mutation.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"`screenView(String, properties:)`","anchor":"screenViewString-properties","level":3},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"text":" to the given name ","type":"text"},{"inlineContent":[{"text":"regardless of opt-out","type":"text"}],"type":"strong"},{"text":" (the screen state still progresses for when the user opts back in). Returns an effect calling ","type":"text"},{"code":"service.track","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"\"screen_view\"","type":"codeVoice"},{"text":" event whose properties include ","type":"text"},{"code":"screen_name","type":"codeVoice"},{"text":" plus any extras. Skipped (returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":") when opted out.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"`identify(userID:, properties:)`","anchor":"identifyuserID-properties","level":3},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"lastIdentifiedUserID = userID","type":"codeVoice"},{"text":" and returns an effect calling ","type":"text"},{"code":"service.identify","type":"codeVoice"},{"text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"`alias(newID:, previousID:)`","anchor":"aliasnewID-previousID","level":3},{"inlineContent":[{"text":"No state mutation. Returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.alias"},{"text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID.","type":"text"}],"type":"paragraph"},{"text":"`reset`","anchor":"reset","level":3,"type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID = nil"},{"text":" and returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.reset()"},{"text":". Runs even when opted out — ","type":"text"},{"type":"codeVoice","code":"reset"},{"text":" is by definition a clean-slate operation.","type":"text"}],"type":"paragraph"},{"text":"`setOptedOut(Bool)`","anchor":"setOptedOutBool","level":3,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"setOptedOut(true)"},{"text":" — Sets ","type":"text"},{"type":"codeVoice","code":"isOptedOut = true"},{"text":", clears ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"text":", returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.reset()"},{"text":" to clear server-side identity.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"setOptedOut(false)"},{"type":"text","text":" — Clears the flag without a service call. Auto-identify on the next dispatch will re-establish identity."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Mapper semantics","anchor":"Mapper-semantics","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The mapper runs in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" for every non-analytics action while the user is opted in. The plugin:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Skips entirely if the action is an "},{"code":"AnalyticsAction","type":"codeVoice"},{"type":"text","text":" (handled by "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" already, no double-tracking)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Skips when "},{"type":"codeVoice","code":"state.isOptedOut"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Calls ","type":"text"},{"code":"mapper.map(state, action)","type":"codeVoice"},{"type":"text","text":" and tracks each returned event via "},{"code":"service.track","type":"codeVoice"},{"type":"text","text":", with "},{"code":"currentScreen","type":"codeVoice"},{"type":"text","text":" auto-attached as "},{"code":"screen","type":"codeVoice"},{"type":"text","text":" (unless the event already provides its own "},{"code":"screen","type":"codeVoice"},{"type":"text","text":")."}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in."}],"type":"paragraph"},{"type":"heading","text":"Auto-identify semantics","anchor":"Auto-identify-semantics","level":2},{"type":"paragraph","inlineContent":[{"text":"When configured with an ","type":"text"},{"type":"codeVoice","code":"AnalyticsIdentity"},{"text":", the plugin re-evaluates both the ","type":"text"},{"code":"userID","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"userProperties","type":"codeVoice"},{"text":" closures each non-analytics dispatch and diffs the pair ","type":"text"},{"code":"(userID, userProperties)","type":"codeVoice"},{"text":" against the last value sent to the service:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"nil → \"u1\"","type":"codeVoice"},{"type":"text","text":" (sign-in): updates "},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"text":", fires ","type":"text"},{"code":"service.identify(userID:\"u1\", properties:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"\"u1\" → \"u2\"","type":"codeVoice"},{"text":" (account switch): updates both, fires ","type":"text"},{"type":"codeVoice","code":"service.identify(userID:\"u2\", properties:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Stable userID, ","type":"text"},{"code":"userProperties","type":"codeVoice"},{"text":" content changed: updates ","type":"text"},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"type":"text","text":", fires "},{"type":"codeVoice","code":"service.identify(userID:, properties:)"},{"type":"text","text":" with the new dictionary."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"\"u1\" → nil"},{"type":"text","text":" (sign-out): clears both, fires "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stable userID and stable "},{"code":"userProperties","type":"codeVoice"},{"type":"text","text":": no-op."}]}]}]},{"inlineContent":[{"type":"codeVoice","code":"userProperties"},{"type":"text","text":" is re-evaluated every non-analytics dispatch; dictionary equality decides whether to re-fire "},{"type":"codeVoice","code":"identify"},{"text":". This keeps derived people-properties (subscription tier, paywall entitlements, feature flags) in sync with state without any explicit ","type":"text"},{"code":".identify","type":"codeVoice"},{"text":" plumbing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When opted out, auto-identify is paused: neither "},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":" nor ","type":"text"},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"text":" is updated. Opting back in re-establishes identity correctly on the next dispatch.","type":"text"}],"type":"paragraph"},{"text":"Flushing","anchor":"Flushing","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"AnalyticsPlugin.flush()"},{"type":"text","text":" awaits any pending fire-and-forget service calls spawned by "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":", then calls "},{"type":"codeVoice","code":"service.flush()"},{"type":"text","text":". Call this on app shutdown to avoid losing in-flight events:"}],"type":"paragraph"},{"syntax":"swift","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"],"type":"codeListing"},{"text":"Implementing an `AnalyticsService`","type":"heading","anchor":"Implementing-an-AnalyticsService","level":2},{"inlineContent":[{"type":"text","text":"The plugin is provider-agnostic. Your conformer is responsible for translating "},{"code":"AnalyticsEvent","type":"codeVoice"},{"type":"text","text":" and "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" into whatever the backend SDK expects."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The protocol has five methods, all "},{"type":"codeVoice","code":"async"},{"type":"text","text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A typical Mixpanel conformer holds a reference to the "},{"type":"codeVoice","code":"Mixpanel.Instance"},{"type":"text","text":" and translates "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" → "},{"type":"codeVoice","code":"MixpanelType"},{"type":"text","text":". An Amplitude conformer holds an "},{"type":"codeVoice","code":"Amplitude"},{"type":"text","text":" instance and translates to "},{"type":"codeVoice","code":"[String: Any]"},{"type":"text","text":". Either way, the plugin stays the same."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Note what the protocol does ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" require: no opt-out flag (the plugin handles that), no super-property machinery for "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" (the plugin handles that), and no event batching policy (your call)."}]}]}],"references":{"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","role":"article","url":"\/documentation\/swidux\/persistencemiddlewareguide","type":"topic","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"title":"Persistence Middleware","kind":"article"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","role":"article","url":"\/documentation\/swidux\/pluginfeatureflagsreference","type":"topic","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"title":"SwiduxFeatureFlags Reference","kind":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"url":"\/documentation\/swidux\/undoplugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"kind":"symbol","title":"UndoPlugin","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","role":"collectionGroup","type":"topic","title":"KeyValueStore","url":"\/documentation\/swidux\/keyvaluestoreguide","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"kind":"article"},"https://github.com/heirloomlogic/SwiduxMixpanelAnalytics":{"url":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnal