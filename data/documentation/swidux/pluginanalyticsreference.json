{"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"title":"Reference","generated":true,"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"]}],"kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"article","title":"SwiduxAnalytics Reference","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":". Unlike the gate-style plugins (","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":", ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":"), analytics is an ","type":"text"},{"inlineContent":[{"text":"observer","type":"text"}],"type":"strong"},{"text":": it watches actions flow by and emits events, but never blocks dispatch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two surfaces:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Mapper (passive)","type":"text"}]},{"text":" — App declares a ","type":"text"},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"text":" closure once at registration. The plugin runs it in ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":" for every non-analytics action while the user is opted in.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"AnalyticsAction"},{"text":" (explicit)","type":"text"}]},{"text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Plus optional ","type":"text"},{"type":"strong","inlineContent":[{"text":"auto-identify","type":"text"}]},{"text":": pass an ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":" keypath and the plugin watches userID transitions across dispatches, firing ","type":"text"},{"code":"service.identify","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"service.reset","type":"codeVoice"},{"text":" automatically.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true},{"text":". For where this plugin sits in the lifecycle, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Library target","anchor":"Library-target","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Import: ","type":"text"},{"type":"codeVoice","code":"import SwiduxAnalytics"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target dependencies in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" alongside ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":".","type":"text"}]},{"level":2,"text":"Provided implementations","anchor":"Provided-implementations","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockAnalyticsService"},{"text":" — silent no-op, for previews and tests.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"ConsoleAnalyticsService","type":"codeVoice"},{"text":" — logs every call to ","type":"text"},{"code":"os.Logger","type":"codeVoice"},{"text":". Use this as the default ","type":"text"},{"code":"service:","type":"codeVoice"},{"text":" while the analytics vendor decision is still open: analytics wiring can be developed and QA-tested end to end with no SDK and no vendor commitment. Adopting a real provider later is the usual two-line change in ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"For production Mixpanel integrations, the ","type":"text"},{"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","isActive":true},{"text":" companion package provides:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" — an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that forwards to the Mixpanel SDK and maps ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" to native Mixpanel types.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"text":" — a Mixpanel-flavored mock for previews.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"For other backends (Amplitude, PostHog, Segment, custom), implement ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" directly — see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true},{"text":" Step 3, Path B.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Types","anchor":"Types","type":"heading"},{"level":3,"text":"`AnalyticsPlugin<RootState, RootAction>`","anchor":"AnalyticsPlugin%3CRootState-RootAction%3E","type":"heading"},{"inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"text":" ","type":"text"},{"code":"final class","type":"codeVoice"},{"text":" ","type":"text"},{"code":"SwiduxPlugin","type":"codeVoice"},{"text":" conformer. Owns a slice of root state typed as ","type":"text"},{"code":"AnalyticsState","type":"codeVoice"},{"text":" and an action enum typed as ","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The plugin is a ","type":"text"},{"code":"final class","type":"codeVoice"},{"text":" (not a struct) because it tracks pending fire-and-forget service calls so that ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":" can deterministically await them — same reason ","type":"text"},{"code":"PersistencePlugin","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"UndoPlugin","type":"codeVoice"},{"text":" are classes.","type":"text"}],"type":"paragraph"},{"text":"`AnalyticsState`","anchor":"AnalyticsState","type":"heading","level":3},{"inlineContent":[{"code":"Sendable","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" struct. The slice the plugin owns.","type":"text"}],"type":"paragraph"},{"code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"],"type":"codeListing","syntax":"swift"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isOptedOut"},{"text":" — App-controlled privacy flag. While ","type":"text"},{"type":"codeVoice","code":"true"},{"text":", mapper events are dropped, explicit ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"text":" actions become no-ops, and auto-identify is paused.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"currentScreen"},{"text":" — The most recent screen recorded via ","type":"text"},{"code":".screenView(_:)","type":"codeVoice"},{"text":", auto-attached as the ","type":"text"},{"code":"screen","type":"codeVoice"},{"type":"text","text":" property on subsequent tracked events."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"lastIdentifiedUserID"},{"text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions.","type":"text"}]}]}],"type":"unorderedList"},{"level":3,"text":"`AnalyticsAction`","anchor":"AnalyticsAction","type":"heading"},{"code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Convenience factories cover the common no-properties cases:","type":"text"}],"type":"paragraph"},{"code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"`AnalyticsEvent`","anchor":"AnalyticsEvent","type":"heading"},{"code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"`AnalyticsValue`","anchor":"AnalyticsValue","type":"heading"},{"inlineContent":[{"text":"Closed enum keeping the protocol provider-agnostic and ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":". Each service adapter maps these cases to its native property type.","type":"text"}],"type":"paragraph"},{"code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Literal conformances keep call-sites clean:","type":"text"}],"type":"paragraph"},{"code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"`AnalyticsMapper<State, Action>`","anchor":"AnalyticsMapper%3CState-Action%3E","type":"heading"},{"inlineContent":[{"text":"Wraps the declarative ","type":"text"},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"text":" closure.","type":"text"}],"type":"paragraph"},{"code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Returning an empty array is the no-op case. ","type":"text"},{"code":".none","type":"codeVoice"},{"text":" is the default mapper for plugins that only use explicit ","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"text":" dispatches.","type":"text"}],"type":"paragraph"},{"level":3,"text":"`AnalyticsIdentity<State>`","anchor":"AnalyticsIdentity%3CState%3E","type":"heading"},{"inlineContent":[{"text":"Declarative source-of-truth for the active user’s identity.","type":"text"}],"type":"paragraph"},{"code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The KeyPath convenience init is the typical shape: ","type":"text"},{"code":"AnalyticsIdentity(userID: \\.auth.currentUserID)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"`AnalyticsService` (protocol)","anchor":"AnalyticsService-protocol","type":"heading"},{"code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes ","type":"text"},{"type":"codeVoice","code":"track"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"identify"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"alias"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"reset"},{"text":" fire-and-forget; only ","type":"text"},{"type":"codeVoice","code":"flush"},{"text":" is awaited.","type":"text"}],"type":"paragraph"},{"level":3,"text":"`MockAnalyticsService`","anchor":"MockAnalyticsService","type":"heading"},{"inlineContent":[{"text":"No-op conformer for previews and development.","type":"text"}],"type":"paragraph"},{"code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"`ConsoleAnalyticsService`","anchor":"ConsoleAnalyticsService","type":"heading"},{"inlineContent":[{"text":"Logs every ","type":"text"},{"type":"codeVoice","code":"track"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"identify"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"alias"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"reset"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"flush"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"os.Logger"},{"text":", with a recursive pretty-printer for ","type":"text"},{"type":"codeVoice","code":"AnalyticsValue"},{"text":". The recommended default before a vendor is chosen.","type":"text"}],"type":"paragraph"},{"code":["public struct ConsoleAnalyticsService: AnalyticsService {","    public init(subsystem: String = \"Swidux\", category: String = \"Analytics\")","    \/\/ Each call logs one structured line; output visible in","    \/\/ the Xcode console and Console.app, quiet in Release.","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Action semantics","anchor":"Action-semantics","type":"heading"},{"inlineContent":[{"text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns.","type":"text"}],"type":"paragraph"},{"level":3,"text":"`track(AnalyticsEvent)`","anchor":"trackAnalyticsEvent","type":"heading"},{"inlineContent":[{"text":"Returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.track(event)"},{"text":", with ","type":"text"},{"type":"codeVoice","code":"currentScreen"},{"text":" auto-attached as the ","type":"text"},{"type":"codeVoice","code":"screen"},{"text":" property if the event doesn’t already specify one. Skipped entirely (returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":") when opted out. No state mutation.","type":"text"}],"type":"paragraph"},{"level":3,"text":"`screenView(String, properties:)`","anchor":"screenViewString-properties","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"currentScreen"},{"text":" to the given name ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"regardless of opt-out"}]},{"text":" (the screen state still progresses for when the user opts back in). Returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.track"},{"text":" with a ","type":"text"},{"type":"codeVoice","code":"\"screen_view\""},{"text":" event whose properties include ","type":"text"},{"type":"codeVoice","code":"screen_name"},{"text":" plus any extras. Skipped (returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":") when opted out.","type":"text"}],"type":"paragraph"},{"level":3,"text":"`identify(userID:, properties:)`","anchor":"identifyuserID-properties","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID = userID"},{"text":" and returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.identify"},{"text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change.","type":"text"}],"type":"paragraph"},{"level":3,"text":"`alias(newID:, previousID:)`","anchor":"aliasnewID-previousID","type":"heading"},{"inlineContent":[{"text":"No state mutation. Returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.alias"},{"text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID.","type":"text"}],"type":"paragraph"},{"level":3,"text":"`reset`","anchor":"reset","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID = nil"},{"text":" and returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.reset()"},{"text":". Runs even when opted out — ","type":"text"},{"type":"codeVoice","code":"reset"},{"text":" is by definition a clean-slate operation.","type":"text"}],"type":"paragraph"},{"level":3,"text":"`setOptedOut(Bool)`","anchor":"setOptedOutBool","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"setOptedOut(true)"},{"text":" — Sets ","type":"text"},{"type":"codeVoice","code":"isOptedOut = true"},{"text":", clears ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"text":", returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.reset()"},{"text":" to clear server-side identity.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"setOptedOut(false)"},{"text":" — Clears the flag without a service call. Auto-identify on the next dispatch will re-establish identity.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Mapper semantics","anchor":"Mapper-semantics","type":"heading"},{"inlineContent":[{"text":"The mapper runs in ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":" for every non-analytics action while the user is opted in. The plugin:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Skips entirely if the action is an ","type":"text"},{"type":"codeVoice","code":"AnalyticsAction"},{"text":" (handled by ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" already, no double-tracking).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Skips when ","type":"text"},{"type":"codeVoice","code":"state.isOptedOut"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Calls ","type":"text"},{"type":"codeVoice","code":"mapper.map(state, action)"},{"text":" and tracks each returned event via ","type":"text"},{"type":"codeVoice","code":"service.track"},{"text":", with ","type":"text"},{"type":"codeVoice","code":"currentScreen"},{"text":" auto-attached as ","type":"text"},{"type":"codeVoice","code":"screen"},{"type":"text","text":" (unless the event already provides its own "},{"type":"codeVoice","code":"screen"},{"type":"text","text":")."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in.","type":"text"}]},{"level":2,"text":"Auto-identify semantics","anchor":"Auto-identify-semantics","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"When configured with an ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":", the plugin re-evaluates both the ","type":"text"},{"code":"userID","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"userProperties","type":"codeVoice"},{"text":" closures each non-analytics dispatch and diffs the pair ","type":"text"},{"type":"codeVoice","code":"(userID, userProperties)"},{"text":" against the last value sent to the service:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"nil → \"u1\""},{"text":" (sign-in): updates ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"text":", fires ","type":"text"},{"type":"codeVoice","code":"service.identify(userID:\"u1\", properties:)"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"u1\" → \"u2\""},{"text":" (account switch): updates both, fires ","type":"text"},{"type":"codeVoice","code":"service.identify(userID:\"u2\", properties:)"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Stable userID, ","type":"text"},{"code":"userProperties","type":"codeVoice"},{"text":" content changed: updates ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"text":", fires ","type":"text"},{"type":"codeVoice","code":"service.identify(userID:, properties:)"},{"text":" with the new dictionary.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"\"u1\" → nil"},{"text":" (sign-out): clears both, fires ","type":"text"},{"type":"codeVoice","code":"service.reset()"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Stable userID and stable ","type":"text"},{"type":"codeVoice","code":"userProperties"},{"text":": no-op.","type":"text"}]}]}]},{"inlineContent":[{"type":"codeVoice","code":"userProperties"},{"text":" is re-evaluated every non-analytics dispatch; dictionary equality decides whether to re-fire ","type":"text"},{"type":"codeVoice","code":"identify"},{"text":". This keeps derived people-properties (subscription tier, paywall entitlements, feature flags) in sync with state without any explicit ","type":"text"},{"type":"codeVoice","code":".identify"},{"text":" plumbing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When opted out, auto-identify is paused: neither "},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" nor "},{"type":"codeVoice","code":"lastIdentifiedProperties"},{"type":"text","text":" is updated. Opting back in re-establishes identity correctly on the next dispatch."}],"type":"paragraph"},{"level":2,"text":"Flushing","anchor":"Flushing","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"AnalyticsPlugin.flush()"},{"type":"text","text":" awaits any pending fire-and-forget service calls spawned by "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":", then calls "},{"type":"codeVoice","code":"service.flush()"},{"type":"text","text":". Call this on app shutdown to avoid losing in-flight events:"}],"type":"paragraph"},{"code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Implementing an `AnalyticsService`","anchor":"Implementing-an-AnalyticsService","type":"heading"},{"inlineContent":[{"text":"The plugin is provider-agnostic. Your conformer is responsible for translating ","type":"text"},{"type":"codeVoice","code":"AnalyticsEvent"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"AnalyticsValue"},{"text":" into whatever the backend SDK expects.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The protocol has five methods, all ","type":"text"},{"type":"codeVoice","code":"async"},{"text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A typical Mixpanel conformer holds a reference to the ","type":"text"},{"type":"codeVoice","code":"Mixpanel.Instance"},{"text":" and translates ","type":"text"},{"type":"codeVoice","code":"AnalyticsValue"},{"text":" → ","type":"text"},{"type":"codeVoice","code":"MixpanelType"},{"text":". An Amplitude conformer holds an ","type":"text"},{"type":"codeVoice","code":"Amplitude"},{"text":" instance and translates to ","type":"text"},{"type":"codeVoice","code":"[String: Any]"},{"text":". Either way, the plugin stays the same.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Note what the protocol does ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" require: no opt-out flag (the plugin handles that), no super-property machinery for ","type":"text"},{"type":"codeVoice","code":"currentScreen"},{"text":" (the plugin handles that), and no event batching policy (your call).","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"paths":["\/documentation\/swidux\/pluginanalyticsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","interfaceLanguage":"swift"},"references":{"doc://Swidux/documentation/Swidux/UndoRedo":{"title":"Undo \/ Redo","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":".","type":"text"}],"url":"\/documentation\/swidux\/undoredo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"title":"Swidux","type":"topic","url":"\/documentation\/swidux","role":"collection"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"title":"Add Analytics","url":"\/documentation\/swidux\/howtoaddanalytics","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"title":"SwiduxPaywall Reference","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"url":"\/documentation\/swidux\/pluginpaywallreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"title":"EntityStore","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"tex