{"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference","generated":true}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","interfaceLanguage":"swift"},"kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginanalyticsreference"]}],"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"SwiduxAnalytics Reference"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":". Unlike the gate-style plugins (","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":"), analytics is an ","type":"text"},{"inlineContent":[{"type":"text","text":"observer"}],"type":"strong"},{"text":": it watches actions flow by and emits events, but never blocks dispatch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two surfaces:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Mapper (passive)"}],"type":"strong"},{"type":"text","text":" — App declares a "},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"type":"text","text":" closure once at registration. The plugin runs it in "},{"code":"afterReduce","type":"codeVoice"},{"type":"text","text":" for every non-analytics action while the user is opted in."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" (explicit)"}],"type":"strong"},{"text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Plus optional "},{"type":"strong","inlineContent":[{"type":"text","text":"auto-identify"}]},{"type":"text","text":": pass an "},{"code":"AnalyticsIdentity","type":"codeVoice"},{"type":"text","text":" keypath and the plugin watches userID transitions across dispatches, firing "},{"code":"service.identify","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"service.reset","type":"codeVoice"},{"type":"text","text":" automatically."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","type":"reference","isActive":true},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Library-target","text":"Library target","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxAnalytics"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Add the product to your target dependencies in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Provided implementations","type":"heading","level":2,"anchor":"Provided-implementations"},{"inlineContent":[{"type":"text","text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockAnalyticsService"},{"type":"text","text":" — silent no-op, for previews and tests."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ConsoleAnalyticsService"},{"type":"text","text":" — logs every call to "},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":". Use this as the default "},{"type":"codeVoice","code":"service:"},{"type":"text","text":" while the analytics vendor decision is still open: analytics wiring can be developed and QA-tested end to end with no SDK and no vendor commitment. Adopting a real provider later is the usual two-line change in "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For production Mixpanel integrations, the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},{"type":"text","text":" companion package provides:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" — an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that forwards to the Mixpanel SDK and maps ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" to native Mixpanel types.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":" — a Mixpanel-flavored mock for previews."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Full API documentation lives in the package’s own ","type":"text"},{"isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"For other backends (Amplitude, PostHog, Segment, custom), implement ","type":"text"},{"type":"codeVoice","code":"AnalyticsService"},{"text":" directly — see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},{"text":" Step 3, Path B.","type":"text"}]},{"anchor":"Types","level":2,"text":"Types","type":"heading"},{"anchor":"AnalyticsPlugin%3CRootState-RootAction%3E","level":3,"text":"`AnalyticsPlugin<RootState, RootAction>`","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"text":" ","type":"text"},{"code":"final class","type":"codeVoice"},{"text":" ","type":"text"},{"code":"SwiduxPlugin","type":"codeVoice"},{"text":" conformer. Owns a slice of root state typed as ","type":"text"},{"code":"AnalyticsState","type":"codeVoice"},{"text":" and an action enum typed as ","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"text":".","type":"text"}]},{"syntax":"swift","code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil,","    onConsentChange: (@Sendable (Bool) async -> Void)? = nil",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"onConsentChange","type":"codeVoice"},{"text":" fires on every ","type":"text"},{"code":".setOptedOut","type":"codeVoice"},{"text":" dispatch with the new opted-out value. Use it to drive a vendor SDK’s own consent API — see ","type":"text"},{"inlineContent":[{"type":"text","text":"Consent"}],"type":"emphasis"},{"text":" below.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The plugin is a ","type":"text"},{"type":"codeVoice","code":"final class"},{"text":" (not a struct) because it tracks pending fire-and-forget service calls so that ","type":"text"},{"type":"codeVoice","code":"flush()"},{"text":" can deterministically await them — same reason ","type":"text"},{"code":"PersistencePlugin","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"UndoPlugin","type":"codeVoice"},{"text":" are classes.","type":"text"}]},{"text":"`AnalyticsState`","type":"heading","level":3,"anchor":"AnalyticsState"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" struct. The slice the plugin owns."}]},{"type":"codeListing","syntax":"swift","code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isOptedOut"},{"type":"text","text":" — App-controlled privacy flag. While "},{"type":"codeVoice","code":"true"},{"type":"text","text":", mapper events are dropped, explicit "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":" actions become no-ops, and auto-identify is paused."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" — The most recent screen recorded via "},{"type":"codeVoice","code":".screenView(_:)"},{"type":"text","text":", auto-attached as the "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" property on subsequent tracked events."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions."}]}]}]},{"type":"heading","level":3,"text":"`AnalyticsAction`","anchor":"AnalyticsAction"},{"type":"codeListing","code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Convenience factories cover the common no-properties cases:","type":"text"}]},{"type":"codeListing","code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"],"syntax":"swift"},{"type":"heading","level":3,"text":"`AnalyticsEvent`","anchor":"AnalyticsEvent"},{"type":"codeListing","code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"`AnalyticsValue`","anchor":"AnalyticsValue"},{"type":"paragraph","inlineContent":[{"text":"Closed enum keeping the protocol provider-agnostic and ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":". Each service adapter maps these cases to its native property type.","type":"text"}]},{"type":"codeListing","code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Literal conformances keep call-sites clean:","type":"text"}]},{"type":"codeListing","code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"],"syntax":"swift"},{"type":"heading","level":3,"text":"`AnalyticsMapper<State, Action>`","anchor":"AnalyticsMapper%3CState-Action%3E"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wraps the declarative "},{"type":"codeVoice","code":"(state, action) -> [AnalyticsEvent]"},{"type":"text","text":" closure."}]},{"type":"codeListing","code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Returning an empty array is the no-op case. ","type":"text"},{"type":"codeVoice","code":".none"},{"text":" is the default mapper for plugins that only use explicit ","type":"text"},{"type":"codeVoice","code":"AnalyticsAction"},{"text":" dispatches.","type":"text"}]},{"type":"heading","level":3,"text":"`AnalyticsIdentity<State>`","anchor":"AnalyticsIdentity%3CState%3E"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declarative source-of-truth for the active user’s identity."}]},{"type":"codeListing","code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The KeyPath convenience init is the typical shape: ","type":"text"},{"code":"AnalyticsIdentity(userID: \\.auth.currentUserID)","type":"codeVoice"},{"type":"text","text":"."}]},{"level":3,"text":"`AnalyticsService` (protocol)","type":"heading","anchor":"AnalyticsService-protocol"},{"syntax":"swift","type":"codeListing","code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"]},{"inlineContent":[{"type":"text","text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes "},{"type":"codeVoice","code":"track"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"identify"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"alias"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"reset"},{"type":"text","text":" fire-and-forget; only "},{"type":"codeVoice","code":"flush"},{"type":"text","text":" is awaited."}],"type":"paragraph"},{"level":3,"text":"`MockAnalyticsService`","type":"heading","anchor":"MockAnalyticsService"},{"inlineContent":[{"type":"text","text":"No-op conformer for previews and development."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"]},{"level":3,"text":"`ConsoleAnalyticsService`","type":"heading","anchor":"ConsoleAnalyticsService"},{"inlineContent":[{"text":"Logs every ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"reset","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"flush","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"os.Logger","type":"codeVoice"},{"text":", with a recursive pretty-printer for ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":". The recommended default before a vendor is chosen.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["public struct ConsoleAnalyticsService: AnalyticsService {","    public init(subsystem: String = \"Swidux\", category: String = \"Analytics\")","    \/\/ Each call logs one structured line; output visible in","    \/\/ the Xcode console and Console.app, quiet in Release.","}"],"syntax":"swift"},{"type":"heading","text":"Action semantics","anchor":"Action-semantics","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}]},{"type":"heading","text":"`track(AnalyticsEvent)`","anchor":"trackAnalyticsEvent","level":3},{"type":"paragraph","inlineContent":[{"text":"Returns an effect calling ","type":"text"},{"code":"service.track(event)","type":"codeVoice"},{"text":", with ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"text":" auto-attached as the ","type":"text"},{"code":"screen","type":"codeVoice"},{"text":" property if the event doesn’t already specify one. Skipped entirely (returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":") when opted out. No state mutation.","type":"text"}]},{"type":"heading","text":"`screenView(String, properties:)`","anchor":"screenViewString-properties","level":3},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"currentScreen","type":"codeVoice"},{"text":" to the given name ","type":"text"},{"inlineContent":[{"type":"text","text":"regardless of opt-out"}],"type":"strong"},{"text":" (the screen state still progresses for when the user opts back in). Returns an effect calling ","type":"text"},{"code":"service.track","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"\"screen_view\"","type":"codeVoice"},{"text":" event whose properties include ","type":"text"},{"code":"screen_name","type":"codeVoice"},{"text":" plus any extras. Skipped (returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":") when opted out.","type":"text"}]},{"type":"heading","text":"`identify(userID:, properties:)`","anchor":"identifyuserID-properties","level":3},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"lastIdentifiedUserID = userID","type":"codeVoice"},{"text":" and returns an effect calling ","type":"text"},{"code":"service.identify","type":"codeVoice"},{"text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change.","type":"text"}]},{"anchor":"aliasnewID-previousID","type":"heading","text":"`alias(newID:, previousID:)`","level":3},{"type":"paragraph","inlineContent":[{"text":"No state mutation. Returns an effect calling ","type":"text"},{"type":"codeVoice","code":"service.alias"},{"text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID.","type":"text"}]},{"text":"`reset`","anchor":"reset","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"lastIdentifiedUserID = nil"},{"type":"text","text":" and returns an effect calling "},{"type":"codeVoice","code":"service.reset()"},{"text":". Runs even when opted out — ","type":"text"},{"type":"codeVoice","code":"reset"},{"text":" is by definition a clean-slate operation.","type":"text"}],"type":"paragraph"},{"text":"`setOptedOut(Bool)`","level":3,"anchor":"setOptedOutBool","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"setOptedOut(true)"},{"text":" — Sets ","type":"text"},{"code":"isOptedOut = true","type":"codeVoice"},{"text":", clears ","type":"text"},{"type":"codeVoice","code":"lastIdentifiedUserID"},{"type":"text","text":", returns an effect that invokes "},{"type":"codeVoice","code":"onConsentChange(true)"},{"type":"text","text":" and then calls "},{"type":"codeVoice","code":"service.reset()"},{"type":"text","text":" to clear server-side identity."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"setOptedOut(false)"},{"type":"text","text":" — Clears the flag. Returns an effect invoking "},{"code":"onConsentChange(false)","type":"codeVoice"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when no hook is configured. Auto-identify on the next dispatch will re-establish identity."}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","text":"Consent","anchor":"Consent"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Opting out is enforced "},{"type":"emphasis","inlineContent":[{"type":"text","text":"plugin-side"}]},{"text":": ","type":"text"},{"code":"track","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"screenView"},{"type":"text","text":", "},{"code":"identify","type":"codeVoice"},{"type":"text","text":", "},{"code":"alias","type":"codeVoice"},{"type":"text","text":", the mapper, and auto-identify all return early while "},{"code":"isOptedOut","type":"codeVoice"},{"type":"text","text":", so nothing reaches the service. Only "},{"type":"codeVoice","code":"reset"},{"type":"text","text":" and "},{"type":"codeVoice","code":"flush"},{"type":"text","text":" still pass through."}]},{"inlineContent":[{"type":"text","text":"That gate stops Swidux-dispatched events. It does not touch the vendor SDK’s own consent switch — so an SDK configured to collect automatic events, or one still holding a queue of its own, can keep sending after the user opts out. "},{"type":"codeVoice","code":"AnalyticsService"},{"type":"text","text":" deliberately stays at five members (consent APIs differ too much between vendors to abstract, and only the app knows which one it is using), so the bridge is the "},{"type":"codeVoice","code":"onConsentChange"},{"type":"text","text":" closure."}],"type":"paragraph"},{"inlineContent":[{"text":"Semantics: it fires on every ","type":"text"},{"code":".setOptedOut","type":"codeVoice"},{"text":" dispatch with the new value, and on opt-out it runs ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"service.reset()"},{"text":", so the SDK’s opt-out closes the tap before the reset hands it an identity change that is still eligible to be sent. Events already in flight are not retracted.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Treat this as required wiring for any vendor with a consent API, not an optional extra: without it, “opted out” means only that Swidux stopped sending. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true,"type":"reference"},{"text":" Step 9 for the wiring.","type":"text"}],"type":"paragraph"},{"anchor":"Mapper-semantics","text":"Mapper semantics","type":"heading","level":2},{"inlineContent":[{"text":"The mapper runs in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action while the user is opted in. The plugin:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Skips entirely if the action is an "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" (handled by "},{"type":"codeVoice","code":"reduce"},{"text":" already, no double-tracking).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Skips when ","type":"text"},{"code":"state.isOptedOut","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Calls "},{"type":"codeVoice","code":"mapper.map(state, action)"},{"type":"text","text":" and tracks each returned event via "},{"type":"codeVoice","code":"service.track"},{"type":"text","text":", with "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" auto-attached as "},{"type":"codeVoice","code":"screen"},{"type":"text","text":" (unless the event already provides its own "},{"code":"screen","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in."}]},{"anchor":"Auto-identify-semantics","text":"Auto-identify semantics","type":"heading","level":2},{"inlineContent":[{"text":"When configured with an ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":", the plugin re-evaluates both the ","type":"text"},{"code":"userID","type":"codeVoice"},{"type":"text","text":" and "},{"code":"userProperties","type":"codeVoice"},{"type":"text","text":" closures each non-analytics dispatch and diffs the pair "},{"code":"(userID, userProperties)","type":"codeVoice"},{"text":" against the last value sent to the service:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"nil → \"u1\"","type":"codeVoice"},{"text":" (sign-in): updates ","type":"text"},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"text":", fires ","type":"text"},{"code":"service.identify(userID:\"u1\", properties:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"\"u1\" → \"u2\"","type":"codeVoice"},{"text":" (account switch): updates both, fires ","type":"text"},{"code":"service.identify(userID:\"u2\", properties:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Stable userID, "},{"code":"userProperties","type":"codeVoice"},{"type":"text","text":" content changed: updates "},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"type":"text","text":", fires "},{"code":"service.identify(userID:, properties:)","type":"codeVoice"},{"type":"text","text":" with the new dictionary."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"\"u1\" → nil","type":"codeVoice"},{"text":" (sign-out): clears both, fires ","type":"text"},{"code":"service.reset()","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Stable userID and stable "},{"code":"userProperties","type":"codeVoice"},{"text":": no-op.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"userProperties"},{"text":" is re-evaluated every non-analytics dispatch; dictionary equality decides whether to re-fire ","type":"text"},{"code":"identify","type":"codeVoice"},{"text":". This keeps derived people-properties (subscription tier, paywall entitlements, feature flags) in sync with state without any explicit ","type":"text"},{"code":".identify","type":"codeVoice"},{"text":" plumbing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When opted out, auto-identify is paused: neither ","type":"text"},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"text":" nor ","type":"text"},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"text":" is updated. Opting back in re-establishes identity correctly on the next dispatch.","type":"text"}]},{"type":"heading","text":"Flushing","level":2,"anchor":"Flushing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnalyticsPlugin.flush()"},{"type":"text","text":" awaits any pending fire-and-forget service calls spawned by "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":", then calls "},{"type":"codeVoice","code":"service.flush()"},{"type":"text","text":". Call this on app shutdown to avoid losing in-flight events:"}]},{"type":"codeListing","syntax":"swift","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"]},{"type":"heading","anchor":"Implementing-an-AnalyticsService","level":2,"text":"Implementing an `AnalyticsService`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is provider-agnostic. Your conformer is responsible for translating "},{"type":"codeVoice","code":"AnalyticsEvent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" into whatever the backend SDK expects."}]},{"type":"paragraph","inlineContent":[{"text":"The protocol has five methods, all ","type":"text"},{"code":"async","type":"codeVoice"},{"text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical Mixpanel conformer holds a reference to the "},{"type":"codeVoice","code":"Mixpanel.Instance"},{"type":"text","text":" and translates "},{"type":"codeVoice","code":"AnalyticsValue"},{"type":"text","text":" → "},{"type":"codeVoice","code":"MixpanelType"},{"type":"text","text":". An Amplitude conformer holds an "},{"type":"codeVoice","code":"Amplitude"},{"type":"text","text":" instance and translates to "},{"type":"codeVoice","code":"[String: Any]"},{"type":"text","text":". Either way, the plugin stays the same."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note what the protocol does "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" require: no opt-out flag (the plugin handles that), no super-property machinery for "},{"type":"codeVoice","code":"currentScreen"},{"type":"text","text":" (the plugin handles that), and no event batching policy (your call)."}]}]}],"sections":[],"references":{"https://github.com/heirloomlogic/SwiduxMixpanelAnalytics":{"type":"link","titleInlineContent":[{"code":"SwiduxMixpanelAnalytics","type":"codeVoice"}],"title":"SwiduxMixpanelAnalytics","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","url":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics"},"doc://Swidux/documentation/Swidux/UndoRedo":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","role":"article","kind":"article","url":"\/documentation\/swidux\/undoredo","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":"."}],"type":"topic","title":"Undo \/ Redo"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"type":"topic","kind":"article","title":"SwiduxKillswitch Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","role":"article","url":"\/documentation\/swidux\/pluginkillswitchreference","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}]},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","url":"\/documentation\/swidux\/pluginfeatureflagsreference","type":"topic","role":"article","title":"SwiduxFeatureFlags Reference","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"kind":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"title":"EntityStore","url":"\/documentation\/swidux\/entitystoreguide","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"topic","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/MacrosReference":{"type":"topic","kind":"article","title":"Macros","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","role":"article","url":"\/documentation\/swidux\/macrosreference","abstract":[{"text":"Reference for ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" and its property markers (the SwiftData persistence bridge, shipped in ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":").","type":"text"}]},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","type":"topic","role":"collection","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","kind":"symbol"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"type":"topic","kind":"article","title":"Troubleshooting","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","role":"article","abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"url":"\/documentation\/swidux\/troubleshooting"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","role":"article","kind":"article","type":"topic","url":"\/documentation\/swidux\/persistencemiddlewareguide","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"title":"Persistence Middleware"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","url":"\/documentation\/swidux\/pluginarchitecture","type":"topic","role":"article","title":"Plugin Architecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"kind":"article"},"https://heirloomlogic.github.io/SwiduxMixpanelAnalytics/documentation/swiduxmixpanelanalytics/":{"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","titleInlineContent":[{"text":"DocC reference","type":"text"}],"type":"link","title":"DocC reference","url":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"url":"\/documentation\/swidux\/pluginpaywallreference","title":"SwiduxPaywall Reference","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"url":"\/documentation\/swidux\/undoplugin","title":"UndoPlugin"},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","title":"Getting Started with Swidux","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"kind":"article","url":"\/documentation\/swidux\/gettingstarted"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"title":"SwiduxParentalGate Reference","url":"\/documentation\/swidux\/pluginparentalgatereference","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","url":"\/documentation\/swidux\/howtoaddanalytics","type":"topic","role":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"title":"Add Analytics","kind":"article"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"type":"topic","kind":"article","title":"KeyValueStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","role":"collectionGroup","url":"\/documentation\/swidux\/keyvaluestoreguide","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}]}}}