{"variants":[{"paths":["\/documentation\/swidux\/pluginanalyticsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"title":"SwiduxAnalytics Reference","role":"article"},"kind":"article","primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" is a domain plugin that observes the dispatch cycle and forwards events to a provider-agnostic ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":". Unlike the gate-style plugins (","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":"), analytics is an ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"observer"}]},{"text":": it watches actions flow by and emits events, but never blocks dispatch.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Two surfaces:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Mapper (passive)"}],"type":"strong"},{"text":" — App declares a ","type":"text"},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"text":" closure once at registration. The plugin runs it in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" for every non-analytics action while the user is opted in.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"AnalyticsAction","type":"codeVoice"},{"type":"text","text":" (explicit)"}],"type":"strong"},{"text":" — Screen views, identify\/alias\/reset, ad-hoc tracks, and opt-out toggling. For the things passive observation can’t cover cleanly.","type":"text"}]}]}]},{"inlineContent":[{"text":"Plus optional ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"auto-identify"}]},{"text":": pass an ","type":"text"},{"code":"AnalyticsIdentity","type":"codeVoice"},{"text":" keypath and the plugin watches userID transitions across dispatches, firing ","type":"text"},{"code":"service.identify","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"service.reset","type":"codeVoice"},{"text":" automatically.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true,"type":"reference"},{"text":". For where this plugin sits in the lifecycle, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Library-target","type":"heading","text":"Library target"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxAnalytics","type":"codeVoice"}]}]}]},{"inlineContent":[{"text":"Add the product to your target dependencies in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" alongside ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Provided-implementations","type":"heading","text":"Provided implementations"},{"inlineContent":[{"text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"MockAnalyticsService","type":"codeVoice"},{"text":" — silent no-op, for previews and tests.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ConsoleAnalyticsService","type":"codeVoice"},{"text":" — logs every call to ","type":"text"},{"code":"os.Logger","type":"codeVoice"},{"text":". Use this as the default ","type":"text"},{"code":"service:","type":"codeVoice"},{"text":" while the analytics vendor decision is still open: analytics wiring can be developed and QA-tested end to end with no SDK and no vendor commitment. Adopting a real provider later is the usual two-line change in ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"inlineContent":[{"text":"For production Mixpanel integrations, the ","type":"text"},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxMixpanelAnalytics","isActive":true,"type":"reference"},{"text":" companion package provides:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"text":" — an ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" conformer that forwards to the Mixpanel SDK and maps ","type":"text"},{"code":"AnalyticsValue","type":"codeVoice"},{"text":" to native Mixpanel types.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"text":" — a Mixpanel-flavored mock for previews.","type":"text"}]}]}]},{"inlineContent":[{"text":"For other backends (Amplitude, PostHog, Segment, custom), implement ","type":"text"},{"code":"AnalyticsService","type":"codeVoice"},{"text":" directly — see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true,"type":"reference"},{"text":" Step 3, Path B.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Types","type":"heading","text":"Types"},{"level":3,"anchor":"AnalyticsPlugin%3CRootState-RootAction%3E","type":"heading","text":"`AnalyticsPlugin<RootState, RootAction>`"},{"inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"text":" ","type":"text"},{"code":"final class","type":"codeVoice"},{"text":" ","type":"text"},{"code":"SwiduxPlugin","type":"codeVoice"},{"text":" conformer. Owns a slice of root state typed as ","type":"text"},{"code":"AnalyticsState","type":"codeVoice"},{"text":" and an action enum typed as ","type":"text"},{"type":"codeVoice","code":"AnalyticsAction"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["public init(","    state: WritableKeyPath<RootState, AnalyticsState>,","    action toRootAction: @escaping @Sendable (AnalyticsAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> AnalyticsAction?,","    service: any AnalyticsService,","    mapper: AnalyticsMapper<RootState, RootAction> = .none,","    identity: AnalyticsIdentity<RootState>? = nil",")"]},{"type":"paragraph","inlineContent":[{"text":"The plugin is a ","type":"text"},{"code":"final class","type":"codeVoice"},{"type":"text","text":" (not a struct) because it tracks pending fire-and-forget service calls so that "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":" can deterministically await them — same reason "},{"code":"PersistencePlugin","type":"codeVoice"},{"type":"text","text":" and "},{"code":"UndoPlugin","type":"codeVoice"},{"type":"text","text":" are classes."}]},{"anchor":"AnalyticsState","type":"heading","level":3,"text":"`AnalyticsState`"},{"type":"paragraph","inlineContent":[{"code":"Sendable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" struct. The slice the plugin owns.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["public struct AnalyticsState: Sendable, Equatable {","    public var isOptedOut: Bool","    public var currentScreen: String?","    public internal(set) var lastIdentifiedUserID: String?","","    public init(isOptedOut: Bool = false, currentScreen: String? = nil)","}"]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"isOptedOut"},{"text":" — App-controlled privacy flag. While ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":", mapper events are dropped, explicit "},{"code":"track","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"identify","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"alias","type":"codeVoice"},{"type":"text","text":" actions become no-ops, and auto-identify is paused."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"currentScreen","type":"codeVoice"},{"text":" — The most recent screen recorded via ","type":"text"},{"code":".screenView(_:)","type":"codeVoice"},{"text":", auto-attached as the ","type":"text"},{"code":"screen","type":"codeVoice"},{"text":" property on subsequent tracked events.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"lastIdentifiedUserID","type":"codeVoice"},{"type":"text","text":" — Set by the plugin (read-only from outside the module). Used to detect identity transitions."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"AnalyticsAction","level":3,"text":"`AnalyticsAction`","type":"heading"},{"syntax":"swift","code":["public enum AnalyticsAction: Sendable, Equatable {","    case track(AnalyticsEvent)","    case screenView(String, properties: [String: AnalyticsValue])","    case identify(userID: String, properties: [String: AnalyticsValue])","    case alias(newID: String, previousID: String?)","    case reset","    case setOptedOut(Bool)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Convenience factories cover the common no-properties cases:"}],"type":"paragraph"},{"syntax":"swift","code":[".screenView(\"Profile\")                    \/\/ properties: [:]",".identify(userID: \"u1\")                   \/\/ properties: [:]",".alias(newID: \"user-42\")                  \/\/ previousID: nil"],"type":"codeListing"},{"type":"heading","text":"`AnalyticsEvent`","level":3,"anchor":"AnalyticsEvent"},{"syntax":"swift","code":["public struct AnalyticsEvent: Sendable, Equatable {","    public var name: String","    public var properties: [String: AnalyticsValue]","","    public init(_ name: String, _ properties: [String: AnalyticsValue] = [:])","}"],"type":"codeListing"},{"type":"heading","text":"`AnalyticsValue`","level":3,"anchor":"AnalyticsValue"},{"inlineContent":[{"type":"text","text":"Closed enum keeping the protocol provider-agnostic and "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":". Each service adapter maps these cases to its native property type."}],"type":"paragraph"},{"syntax":"swift","code":["public enum AnalyticsValue: Sendable, Equatable {","    case string(String)","    case int(Int)","    case double(Double)","    case bool(Bool)","    case date(Date)","    case array([AnalyticsValue])","    case dict([String: AnalyticsValue])","    case null","}"],"type":"codeListing"},{"inlineContent":[{"text":"Literal conformances keep call-sites clean:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let props: [String: AnalyticsValue] = [","    \"amount\": 5,           \/\/ .int","    \"tier\": \"pro\",         \/\/ .string","    \"active\": true,        \/\/ .bool","    \"ratio\": 0.5,          \/\/ .double","    \"tags\": [\"a\", \"b\"],    \/\/ .array","]"],"type":"codeListing"},{"level":3,"anchor":"AnalyticsMapper%3CState-Action%3E","text":"`AnalyticsMapper<State, Action>`","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wraps the declarative "},{"code":"(state, action) -> [AnalyticsEvent]","type":"codeVoice"},{"type":"text","text":" closure."}]},{"syntax":"swift","code":["public struct AnalyticsMapper<State, Action>: Sendable {","    public typealias Map = @Sendable (State, Action) -> [AnalyticsEvent]","    public let map: Map","    public init(_ map: @escaping Map)","    public static var none: AnalyticsMapper { ... }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. "},{"code":".none","type":"codeVoice"},{"type":"text","text":" is the default mapper for plugins that only use explicit "},{"code":"AnalyticsAction","type":"codeVoice"},{"type":"text","text":" dispatches."}]},{"level":3,"anchor":"AnalyticsIdentity%3CState%3E","text":"`AnalyticsIdentity<State>`","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declarative source-of-truth for the active user’s identity."}]},{"syntax":"swift","code":["public struct AnalyticsIdentity<State>: Sendable {","    public let userID: @Sendable (State) -> String?","    public let userProperties: @Sendable (State) -> [String: AnalyticsValue]","","    public init(","        userID: @escaping @Sendable (State) -> String?,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","","    public init(","        userID keyPath: KeyPath<State, String?> & Sendable,","        userProperties: @escaping @Sendable (State) -> [String: AnalyticsValue] = { _ in [:] }","    )","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The KeyPath convenience init is the typical shape: ","type":"text"},{"code":"AnalyticsIdentity(userID: \\.auth.currentUserID)","type":"codeVoice"},{"type":"text","text":"."}]},{"anchor":"AnalyticsService-protocol","type":"heading","level":3,"text":"`AnalyticsService` (protocol)"},{"syntax":"swift","code":["public protocol AnalyticsService: Sendable {","    func track(_ event: AnalyticsEvent) async","    func identify(userID: String, properties: [String: AnalyticsValue]) async","    func alias(newID: String, previousID: String?) async","    func reset() async","    func flush() async","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Implementations own batching, retry, network failure handling, and offline queueing. The plugin invokes "},{"code":"track","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"identify","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"alias","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"reset","type":"codeVoice"},{"text":" fire-and-forget; only ","type":"text"},{"code":"flush","type":"codeVoice"},{"text":" is awaited.","type":"text"}],"type":"paragraph"},{"anchor":"MockAnalyticsService","level":3,"text":"`MockAnalyticsService`","type":"heading"},{"inlineContent":[{"text":"No-op conformer for previews and development.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct MockAnalyticsService: AnalyticsService {","    public init()","    \/\/ All methods are no-ops.","}"],"type":"codeListing"},{"level":3,"anchor":"ConsoleAnalyticsService","text":"`ConsoleAnalyticsService`","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Logs every ","type":"text"},{"code":"track","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"identify","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"alias","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"reset","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"flush","type":"codeVoice"},{"type":"text","text":" to "},{"code":"os.Logger","type":"codeVoice"},{"type":"text","text":", with a recursive pretty-printer for "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":". The recommended default before a vendor is chosen."}]},{"syntax":"swift","code":["public struct ConsoleAnalyticsService: AnalyticsService {","    public init(subsystem: String = \"Swidux\", category: String = \"Analytics\")","    \/\/ Each call logs one structured line; output visible in","    \/\/ the Xcode console and Console.app, quiet in Release.","}"],"type":"codeListing"},{"level":2,"anchor":"Action-semantics","text":"Action semantics","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns.","type":"text"}]},{"level":3,"anchor":"trackAnalyticsEvent","text":"`track(AnalyticsEvent)`","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns an effect calling "},{"code":"service.track(event)","type":"codeVoice"},{"type":"text","text":", with "},{"code":"currentScreen","type":"codeVoice"},{"type":"text","text":" auto-attached as the "},{"code":"screen","type":"codeVoice"},{"type":"text","text":" property if the event doesn’t already specify one. Skipped entirely (returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":") when opted out. No state mutation."}]},{"level":3,"anchor":"screenViewString-properties","text":"`screenView(String, properties:)`","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"currentScreen","type":"codeVoice"},{"type":"text","text":" to the given name "},{"inlineContent":[{"type":"text","text":"regardless of opt-out"}],"type":"strong"},{"type":"text","text":" (the screen state still progresses for when the user opts back in). Returns an effect calling "},{"code":"service.track","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"\"screen_view\"","type":"codeVoice"},{"text":" event whose properties include ","type":"text"},{"code":"screen_name","type":"codeVoice"},{"type":"text","text":" plus any extras. Skipped (returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":") when opted out."}]},{"level":3,"anchor":"identifyuserID-properties","text":"`identify(userID:, properties:)`","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"lastIdentifiedUserID = userID","type":"codeVoice"},{"type":"text","text":" and returns an effect calling "},{"code":"service.identify","type":"codeVoice"},{"type":"text","text":". Skipped when opted out. Use this when the app needs to force identity before the auto-identify keypath would observe the change."}]},{"level":3,"anchor":"aliasnewID-previousID","text":"`alias(newID:, previousID:)`","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"No state mutation. Returns an effect calling "},{"code":"service.alias","type":"codeVoice"},{"type":"text","text":". Skipped when opted out. Call once when an anonymous user signs up to link the anonymous distinct ID to the new user ID."}]},{"level":3,"anchor":"reset","text":"`reset`","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"lastIdentifiedUserID = nil","type":"codeVoice"},{"type":"text","text":" and returns an effect calling "},{"code":"service.reset()","type":"codeVoice"},{"type":"text","text":". Runs even when opted out — "},{"code":"reset","type":"codeVoice"},{"type":"text","text":" is by definition a clean-slate operation."}]},{"level":3,"anchor":"setOptedOutBool","text":"`setOptedOut(Bool)`","type":"heading"},{"items":[{"content":[{"inlineContent":[{"code":"setOptedOut(true)","type":"codeVoice"},{"type":"text","text":" — Sets "},{"code":"isOptedOut = true","type":"codeVoice"},{"type":"text","text":", clears "},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"type":"text","text":", returns an effect calling "},{"code":"service.reset()","type":"codeVoice"},{"type":"text","text":" to clear server-side identity."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"setOptedOut(false)","type":"codeVoice"},{"type":"text","text":" — Clears the flag without a service call. Auto-identify on the next dispatch will re-establish identity."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Mapper-semantics","text":"Mapper semantics","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mapper runs in "},{"code":"afterReduce","type":"codeVoice"},{"type":"text","text":" for every non-analytics action while the user is opted in. The plugin:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Skips entirely if the action is an "},{"code":"AnalyticsAction","type":"codeVoice"},{"type":"text","text":" (handled by "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" already, no double-tracking)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Skips when "},{"code":"state.isOptedOut","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Calls "},{"code":"mapper.map(state, action)","type":"codeVoice"},{"type":"text","text":" and tracks each returned event via "},{"code":"service.track","type":"codeVoice"},{"type":"text","text":", with "},{"code":"currentScreen","type":"codeVoice"},{"type":"text","text":" auto-attached as "},{"code":"screen","type":"codeVoice"},{"type":"text","text":" (unless the event already provides its own "},{"code":"screen","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returning an empty array is the no-op case. The mapper closure is allowed to read freely from the post-reducer state — that’s deliberately what gets passed in."}]},{"level":2,"anchor":"Auto-identify-semantics","text":"Auto-identify semantics","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When configured with an "},{"code":"AnalyticsIdentity","type":"codeVoice"},{"type":"text","text":", the plugin re-evaluates both the "},{"code":"userID","type":"codeVoice"},{"type":"text","text":" and "},{"code":"userProperties","type":"codeVoice"},{"type":"text","text":" closures each non-analytics dispatch and diffs the pair "},{"code":"(userID, userProperties)","type":"codeVoice"},{"type":"text","text":" against the last value sent to the service:"}]},{"items":[{"content":[{"inlineContent":[{"code":"nil → \"u1\"","type":"codeVoice"},{"type":"text","text":" (sign-in): updates "},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"type":"text","text":", fires "},{"code":"service.identify(userID:\"u1\", properties:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"\"u1\" → \"u2\"","type":"codeVoice"},{"type":"text","text":" (account switch): updates both, fires "},{"code":"service.identify(userID:\"u2\", properties:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Stable userID, "},{"code":"userProperties","type":"codeVoice"},{"type":"text","text":" content changed: updates "},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"type":"text","text":", fires "},{"code":"service.identify(userID:, properties:)","type":"codeVoice"},{"type":"text","text":" with the new dictionary."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"\"u1\" → nil","type":"codeVoice"},{"type":"text","text":" (sign-out): clears both, fires "},{"code":"service.reset()","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Stable userID and stable "},{"code":"userProperties","type":"codeVoice"},{"type":"text","text":": no-op."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"code":"userProperties","type":"codeVoice"},{"type":"text","text":" is re-evaluated every non-analytics dispatch; dictionary equality decides whether to re-fire "},{"code":"identify","type":"codeVoice"},{"type":"text","text":". This keeps derived people-properties (subscription tier, paywall entitlements, feature flags) in sync with state without any explicit "},{"code":".identify","type":"codeVoice"},{"type":"text","text":" plumbing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When opted out, auto-identify is paused: neither "},{"code":"lastIdentifiedUserID","type":"codeVoice"},{"type":"text","text":" nor "},{"code":"lastIdentifiedProperties","type":"codeVoice"},{"type":"text","text":" is updated. Opting back in re-establishes identity correctly on the next dispatch."}]},{"level":2,"anchor":"Flushing","text":"Flushing","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"AnalyticsPlugin.flush()","type":"codeVoice"},{"type":"text","text":" awaits any pending fire-and-forget service calls spawned by "},{"code":"afterReduce","type":"codeVoice"},{"type":"text","text":", then calls "},{"code":"service.flush()","type":"codeVoice"},{"type":"text","text":". Call this on app shutdown to avoid losing in-flight events:"}]},{"syntax":"swift","code":[".onChange(of: scenePhase) { _, phase in","    if phase == .background {","        Task { await store.analyticsPlugin.flush() }","    }","}"],"type":"codeListing"},{"level":2,"anchor":"Implementing-an-AnalyticsService","text":"Implementing an `AnalyticsService`","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is provider-agnostic. Your conformer is responsible for translating "},{"code":"AnalyticsEvent","type":"codeVoice"},{"type":"text","text":" and "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" into whatever the backend SDK expects."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol has five methods, all "},{"code":"async","type":"codeVoice"},{"type":"text","text":" and non-throwing. Errors are the service’s responsibility: log them, queue for retry, drop them — whatever fits your backend’s reliability model. The plugin will not see them."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical Mixpanel conformer holds a reference to the "},{"code":"Mixpanel.Instance","type":"codeVoice"},{"type":"text","text":" and translates "},{"code":"AnalyticsValue","type":"codeVoice"},{"type":"text","text":" → "},{"code":"MixpanelType","type":"codeVoice"},{"type":"text","text":". An Amplitude conformer holds an "},{"code":"Amplitude","type":"codeVoice"},{"type":"text","text":" instance and translates to "},{"code":"[String: Any]","type":"codeVoice"},{"type":"text","text":". Either way, the plugin stays the same."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note what the protocol does "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" require: no opt-out flag (the plugin handles that), no super-property machinery for "},{"code":"currentScreen","type":"codeVoice"},{"type":"text","text":" (the plugin handles that), and no event batching policy (your call)."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"anchor":"Reference","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsR