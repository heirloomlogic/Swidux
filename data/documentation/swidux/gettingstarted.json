{"abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},"kind":"article","metadata":{"title":"Getting Started with Swidux","modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide walks through the four steps to integrate Swidux: add the package, define your types, wire the store, and connect views."}]},{"text":"Add the Package","type":"heading","anchor":"Add-the-Package","level":2},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Xcode:"}],"type":"strong"},{"type":"text","text":" File > Add Package Dependencies, paste "},{"code":"https:\/\/github.com\/heirloomlogic\/Swidux","type":"codeVoice"},{"type":"text","text":", set "},{"inlineContent":[{"type":"text","text":"Up to Next Major"}],"type":"strong"},{"type":"text","text":" from "},{"code":"1.0.0","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Package.swift:"}],"type":"strong"}]},{"syntax":"swift","type":"codeListing","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/heirloomlogic\/Swidux\", from: \"1.0.0\"),","]"]},{"text":"Define Your Types","type":"heading","anchor":"Define-Your-Types","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Re-export Swidux from "},{"code":"AppState.swift","type":"codeVoice"},{"type":"text","text":" so no other file needs "},{"code":"import Swidux","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","struct AppState: Sendable {","    var items = EntityStore<Item>()","    var tags  = EntityStore<Tag>()","    var ui    = UIState()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Specialize the generic effect system with your action type:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/Effect.swift","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Send","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"@MainActor @Sendable (Action) -> Void"},{"type":"text","text":" — dispatched actions hop back to the MainActor."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","isActive":true},{"type":"text","text":" is a "},{"type":"codeVoice","code":"@Sendable"},{"type":"text","text":" async closure. Run with "},{"type":"codeVoice","code":"Task { @concurrent in }"},{"type":"text","text":" to stay off the MainActor."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Define your action tree and root reducer:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppAction.swift","enum AppAction: Sendable {","    case items(ItemAction)","    case tags(TagAction)","}","","\/\/ App\/AppReducer.swift","struct AppReducer: SwiduxReducer {","    let itemReducer = ItemReducer()","    let tagReducer  = TagReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .items(let action):","            return itemReducer.reduce(state: &state, action: action, environment: environment)","        case .tags(let action):","            return tagReducer.reduce(state: &state, action: action, environment: environment)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feature reducers conform to "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxReducer","type":"reference","isActive":true},{"type":"text","text":" with "},{"code":"Action = FeatureAction","type":"codeVoice"},{"type":"text","text":" and "},{"code":"RootAction = AppAction","type":"codeVoice"},{"type":"text","text":". Return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when no async work is needed:"}]},{"syntax":"swift","type":"codeListing","code":["struct ItemReducer: SwiduxReducer {","    func reduce(state: inout AppState, action: ItemAction, environment: AppEnvironment) -> Effect? {","        switch action {","        case .increment(let id):","            state.items.modify(id) { $0.count += 1 }","        }","        return nil","    }","}"]},{"text":"Wire the AppStore","type":"heading","anchor":"Wire-the-AppStore","level":2},{"type":"paragraph","inlineContent":[{"code":"AppStore","type":"codeVoice"},{"type":"text","text":" owns separate stored properties per state slice so "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" tracks each one independently. "},{"code":"send()","type":"codeVoice"},{"type":"text","text":" uses the snapshot pattern (see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide#The-Snapshot-Pattern","type":"reference","isActive":true},{"type":"text","text":"):"}]},{"syntax":"swift","type":"codeListing","code":["@Observable","final class AppStore: SwiduxDispatcher {","    private(set) var items = EntityStore<Item>()","    private(set) var tags  = EntityStore<Tag>()","    private(set) var ui    = UIState()","","    private let reducer: AppReducer","    private let persistence: PersistencePlugin<AppState, AppAction>","","    func send(_ action: AppAction) {","        var state = AppState(items: items, tags: tags, ui: ui)","        let effect = reducer.reduce(state: &state, action: action, environment: environment)","        persistence.afterReduce(state: &state)","        items = state.items","        tags = state.tags","        ui = state.ui","","        if let effect {","            let send: Send = { [weak self] action in self?.send(action) }","            Task { @concurrent in await effect(send) }","        }","    }","}"]},{"text":"Wire Views","type":"heading","anchor":"Wire-Views","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views read from the store and dispatch actions. They don’t import Swidux or touch the database:"}]},{"syntax":"swift","type":"codeListing","code":["struct ItemListView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        List(store.items.values) { item in","            Text(item.name)","        }","        .toolbar {","            Button(\"Add\") { store.send(.items(.create)) }","        }","    }","}"]},{"text":"Next Steps","type":"heading","anchor":"Next-Steps","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","isActive":true},{"type":"text","text":" — Learn the full "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" API"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true},{"type":"text","text":" — Configure persistence writers"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","isActive":true},{"type":"text","text":" — Understand the snapshot pattern and performance considerations"}]}]}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/swidux\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"title":"Essentials","generated":true,"anchor":"Essentials","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples"]}],"sections":[],"references":{"doc://Swidux/documentation/Swidux/Send":{"url":"\/documentation\/swidux\/send","abstract":[{"text":"A function for dispatching actions back to the store from within an effect.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Send","kind":"symbol","type":"topic","navigatorTitle":[{"text":"Send","kind":"identifier"}],"title":"Send","role":"symbol","fragments":[{"text":"typealias","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Send","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"url":"\/documentation\/swidux\/persistencemiddlewareguide","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","kind":"article","type":"topic","title":"Persistence Middleware","role":"article"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"title":"Architecture & Performance","type":"topic","abstract":[{"type":"text","text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","url":"\/documentation\/swidux\/architectureguide","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/ArchitectureGuide#The-Snapshot-Pattern":{"abstract":[],"type":"topic","title":"The Snapshot Pattern","url":"\/documentation\/swidux\/architectureguide#The-Snapshot-Pattern","kind":"section","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide#The-Snapshot-Pattern"},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"url":"\/documentation\/swidux\/designprinciples","abstract":[{"text":"The philosophy be