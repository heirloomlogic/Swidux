{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article","title":"Getting Started with Swidux"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"],"title":"Reference","anchor":"Reference"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/gettingstarted"]}],"kind":"article","identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"This guide walks through the four steps to integrate Swidux: add the package, define your types, wire the store, and connect views.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Add-the-Package","text":"Add the Package","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Xcode:","type":"text"}],"type":"strong"},{"text":" File > Add Package Dependencies, paste ","type":"text"},{"type":"codeVoice","code":"https:\/\/github.com\/heirloomlogic\/Swidux"},{"text":", set ","type":"text"},{"inlineContent":[{"type":"text","text":"Up to Next Major"}],"type":"strong"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"1.0.0"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Package.swift:"}],"type":"strong"}]},{"code":["dependencies: [","    .package(url: \"https:\/\/github.com\/heirloomlogic\/Swidux\", from: \"1.0.0\"),","]"],"type":"codeListing","syntax":"swift"},{"text":"Define Your Types","type":"heading","level":2,"anchor":"Define-Your-Types"},{"type":"paragraph","inlineContent":[{"text":"Re-export Swidux from ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"text":" so no other file needs ","type":"text"},{"code":"import Swidux","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    var tags  = EntityStore<Tag>()","    @Slice var ui = UIState()","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"@Swidux","type":"codeVoice"},{"text":" generates an ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" companion class and ","type":"text"},{"code":"SwiduxObservable","type":"codeVoice"},{"text":" conformance. ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" marks nested state slices that get their own observer class for per-property observation granularity.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Specialize the generic effect system with your action type:"}]},{"code":["\/\/ App\/Effect.swift","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"],"type":"codeListing","syntax":"swift"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Send"},{"type":"text","text":" is "},{"code":"@MainActor @Sendable (Action) -> Void","type":"codeVoice"},{"type":"text","text":" — dispatched actions hop back to the MainActor."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"@Sendable"},{"type":"text","text":" async closure. Run with "},{"type":"codeVoice","code":"Task { @concurrent in }"},{"type":"text","text":" to stay off the MainActor."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Define your action tree and root reducer:","type":"text"}]},{"code":["\/\/ App\/AppAction.swift","enum AppAction: Sendable {","    case items(ItemAction)","    case tags(TagAction)","}","","\/\/ App\/AppReducer.swift","struct AppReducer: SwiduxReducer {","    let itemReducer = ItemReducer()","    let tagReducer  = TagReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .items(let action):","            return itemReducer.reduce(state: &state, action: action, environment: environment)","        case .tags(let action):","            return tagReducer.reduce(state: &state, action: action, environment: environment)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feature reducers conform to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxReducer"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Action = FeatureAction"},{"type":"text","text":" and "},{"type":"codeVoice","code":"RootAction = AppAction"},{"type":"text","text":". Return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when no async work is needed:"}]},{"code":["struct ItemReducer: SwiduxReducer {","    func reduce(state: inout AppState, action: ItemAction, environment: AppEnvironment) -> Effect? {","        switch action {","        case .increment(let id):","            state.items.modify(id) { $0.count += 1 }","        }","        return nil","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Wire the Store","anchor":"Wire-the-Store","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" is a generic "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" class that owns the dispatch cycle, plugin lifecycle, and observation layer. Define a typealias and a factory method:"}]},{"code":["typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let reducer = AppReducer()","        let environment = AppEnvironment.live()","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.items) { writes, deletes in","                    for item in writes { try? await db.upsert(item) }","                    for id in deletes  { try? await db.delete(id: id) }","                },","            ]","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            persistencePlugin: persistencePlugin","        )","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" handles the snapshot pattern internally — packing the observer tree into a struct, running the reducer, then unpacking only changed properties back. Views access state through "},{"type":"codeVoice","code":"@dynamicMemberLookup"},{"type":"text","text":", which forwards to the generated observer class tree."}]},{"type":"heading","text":"Wire Views","anchor":"Wire-Views","level":2},{"inlineContent":[{"type":"text","text":"Views read from the store and dispatch actions. They don’t import Swidux or touch the database:"}],"type":"paragraph"},{"code":["struct ItemListView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        List(store.items.values) { item in","            Text(item.name)","        }","        .toolbar {","            Button(\"Add\") { store.send(.items(.create)) }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"App-Entry-Point","type":"heading","level":3,"text":"App Entry Point"},{"inlineContent":[{"text":"Own the store with ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" and inject it via ","type":"text"},{"code":".environment()","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Next-Steps","type":"heading","level":2,"text":"Next Steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","isActive":true,"type":"reference"},{"type":"text","text":" — Learn the full "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"type":"text","text":" API"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"reference"},{"text":" — Configure persistence writers","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","isActive":true,"type":"reference"},{"text":" — Understand the snapshot pattern and performance considerations","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"SwiduxObservable","type":"codeVoice"},{"text":" — Hand-write observation bridging for advanced cases","type":"text"}]}]}]}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"title":"SwiduxPaywall Reference","type":"topic","url":"\/documentation\/swidux\/pluginpaywallreference","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/MacrosReference":{"abstract":[{"text":"Reference for ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" and its property markers (the SwiftData persistence bridge, shipped in ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":").","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","title":"Macros","url":"\/documentation\/swidux\/macrosreference","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"kind":"article","type":"topic","title":"EntityStore","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","url":"\/documentation\/swidux\/entitystoregui