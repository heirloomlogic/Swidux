{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"],"generated":true}],"abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","interfaceLanguage":"swift"},"kind":"article","metadata":{"title":"Getting Started with Swidux","modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article"},"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This guide walks through the four steps to integrate Swidux: add the package, define your types, wire the store, and connect views."}],"type":"paragraph"},{"anchor":"Add-the-Package","level":2,"type":"heading","text":"Add the Package"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Xcode:"}],"type":"strong"},{"type":"text","text":" File > Add Package Dependencies, paste "},{"code":"https:\/\/github.com\/heirloomlogic\/Swidux","type":"codeVoice"},{"text":", set ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Up to Next Major"}]},{"type":"text","text":" from "},{"type":"codeVoice","code":"1.0.0"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Package.swift:"}],"type":"strong"}],"type":"paragraph"},{"code":["dependencies: [","    .package(url: \"https:\/\/github.com\/heirloomlogic\/Swidux\", from: \"1.0.0\"),","]"],"type":"codeListing","syntax":"swift"},{"anchor":"Define-Your-Types","text":"Define Your Types","level":2,"type":"heading"},{"inlineContent":[{"text":"Re-export Swidux from ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"type":"text","text":" so no other file needs "},{"code":"import Swidux","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    var tags  = EntityStore<Tag>()","    @Slice var ui = UIState()","}"],"type":"codeListing"},{"inlineContent":[{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" generates an "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" companion class and "},{"code":"SwiduxObservable","type":"codeVoice"},{"type":"text","text":" conformance. "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":" marks nested state slices that get their own observer class for per-property observation granularity."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Specialize the generic effect system with your action type:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/Effect.swift","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Send"},{"type":"text","text":" is "},{"type":"codeVoice","code":"@MainActor @Sendable (Action) -> Void"},{"type":"text","text":" — dispatched actions hop back to the MainActor."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","isActive":true,"type":"reference"},{"type":"text","text":" is a "},{"code":"@Sendable","type":"codeVoice"},{"type":"text","text":" async closure. Run with "},{"code":"Task { @concurrent in }","type":"codeVoice"},{"type":"text","text":" to stay off the MainActor."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Define your action tree and root reducer:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/AppAction.swift","enum AppAction: Sendable {","    case items(ItemAction)","    case tags(TagAction)","}","","\/\/ App\/AppReducer.swift","struct AppReducer: SwiduxReducer {","    let itemReducer = ItemReducer()","    let tagReducer  = TagReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .items(let action):","            return itemReducer.reduce(state: &state, action: action, environment: environment)","        case .tags(let action):","            return tagReducer.reduce(state: &state, action: action, environment: environment)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Feature reducers conform to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxReducer"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"Action = FeatureAction"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"RootAction = AppAction"},{"text":". Return ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" when no async work is needed:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ItemReducer: SwiduxReducer {","    func reduce(state: inout AppState, action: ItemAction, environment: AppEnvironment) -> Effect? {","        switch action {","        case .increment(let id):","            state.items.modify(id) { $0.count += 1 }","        }","        return nil","    }","}"],"type":"codeListing"},{"level":2,"anchor":"Wire-the-Store","text":"Wire the Store","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Store"},{"text":" is a generic ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" class that owns the dispatch cycle, plugin lifecycle, and observation layer. Define a typealias and a factory method:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let reducer = AppReducer()","        let environment = AppEnvironment.live()","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.items) { writes, deletes in","                    for item in writes { try? await db.upsert(item) }","                    for id in deletes  { try? await db.delete(id: id) }","                },","            ]","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            persistencePlugin: persistencePlugin","        )","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"Store"},{"text":" handles the snapshot pattern internally — packing the observer tree into a struct, running the reducer, then unpacking only changed properties back. Views access state through ","type":"text"},{"type":"codeVoice","code":"@dynamicMemberLookup"},{"text":", which forwards to the generated observer class tree.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Wire-Views","text":"Wire Views","type":"heading"},{"inlineContent":[{"text":"Views read from the store and dispatch actions. They don’t import Swidux or touch the database:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ItemListView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        List(store.items.values) { item in","            Text(item.name)","        }","        .toolbar {","            Button(\"Add\") { store.send(.items(.create)) }","        }","    }","}"],"type":"codeListing"},{"level":3,"anchor":"App-Entry-Point","text":"App Entry Point","type":"heading"},{"inlineContent":[{"text":"Own the store with ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" and inject it via ","type":"text"},{"type":"codeVoice","code":".environment()"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","    }","}"],"type":"codeListing"},{"level":2,"anchor":"Next-Steps","text":"Next Steps","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","isActive":true,"type":"reference"},{"type":"text","text":" — Learn the full "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"type":"text","text":" API"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true,"type":"reference"},{"type":"text","text":" — Configure persistence writers"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","isA