rong"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"1.0.0"},{"text":".","type":"text"}]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Package.swift:","type":"text"}]}],"type":"paragraph"},{"type":"codeListing","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/heirloomlogic\/Swidux\", from: \"1.0.0\"),","]"],"syntax":"swift"},{"level":2,"type":"heading","text":"Define Your Types","anchor":"Define-Your-Types"},{"inlineContent":[{"text":"Re-export Swidux from ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":" so no other file needs ","type":"text"},{"type":"codeVoice","code":"import Swidux"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    var tags  = EntityStore<Tag>()","    @Slice var ui = UIState()","}"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" generates an "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" companion class and "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":" conformance. "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" marks nested state slices that get their own observer class for per-property observation granularity."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Specialize the generic effect system with your action type:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ App\/Effect.swift","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Send","type":"reference"},{"type":"text","text":" is "},{"type":"codeVoice","code":"@MainActor @Sendable (Action) -> Void"},{"type":"text","text":" — dispatched actions hop back to the MainActor."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","isActive":true,"type":"reference"},{"type":"text","text":" is a "},{"code":"@Sendable","type":"codeVoice"},{"type":"text","text":" async closure. Run with "},{"type":"codeVoice","code":"Task { @concurrent in }"},{"type":"text","text":" to stay off the MainActor."}]}]}]},{"inlineContent":[{"type":"text","text":"Define your action tree and root reducer:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/AppAction.swift","enum AppAction: Sendable {","    case items(ItemAction)","    case tags(TagAction)","}","","\/\/ App\/AppReducer.swift","struct AppReducer: SwiduxReducer {","    let itemReducer = ItemReducer()","    let tagReducer  = TagReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .items(let action):","            return itemReducer.reduce(state: &state, action: action, environment: environment)","        case .tags(let action):","            return tagReducer.reduce(state: &state, action: action, environment: environment)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Feature reducers conform to ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxReducer","type":"reference","isActive":true},{"text":" with ","type":"text"},{"code":"Action = FeatureAction","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"RootAction = AppAction","type":"codeVoice"},{"text":". Return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when no async work is needed:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ItemReducer: SwiduxReducer {","    func reduce(state: inout AppState, action: ItemAction, environment: AppEnvironment) -> Effect? {","        switch action {","        case .increment(let id):","            state.items.modify(id) { $0.count += 1 }","        }","        return nil","    }","}"],"type":"codeListing"},{"level":2,"type":"heading","anchor":"Wire-the-Store","text":"Wire the Store"},{"inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" is a generic ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" class that owns the dispatch cycle, plugin lifecycle, and observation layer. Define a typealias and a factory method:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let reducer = AppReducer()","        let environment = AppEnvironment.live()","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.items) { writes, deletes in","                    for item in writes { try? await db.upsert(item) }","                    for id in deletes  { try? await db.delete(id: id) }","                },","            ]","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            persistencePlugin: persistencePlugin","        )","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"Store","type":"codeVoice"},{"type":"text","text":" handles the snapshot pattern internally — packing the observer tree into a struct, running the reducer, then unpacking only changed properties back. Views access state through "},{"type":"codeVoice","code":"@dynamicMemberLookup"},{"type":"text","text":", which forwards to the generated observer class tree."}],"type":"paragraph"},{"anchor":"Wire-Views","type":"heading","text":"Wire Views","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views read from the store and dispatch actions. They don’t import Swidux or touch the database:"}]},{"type":"codeListing","code":["struct ItemListView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        List(store.items.values) { item in","            Text(item.name)","        }","        .toolbar {","            Button(\"Add\") { store.send(.items(.create)) }","        }","    }","}"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"App-Entry-Point","text":"App Entry Point"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Own the store with "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" and inject it via "},{"type":"codeVoice","code":".environment()"},{"type":"text","text":":"}]},{"type":"codeListing","code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","    }","}"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Next-Steps","text":"Next Steps"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","isActive":true,"type":"reference"},{"text":" — Learn the full ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" API","type":"text"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"reference","isActive":true},{"text":" — Configure persistence writers","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/docume