n/Swidux/EntityStoreGuide":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"title":"EntityStore","role":"article","url":"\/documentation\/swidux\/entitystoreguide"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"title":"SwiduxPaywall Reference","role":"article","url":"\/documentation\/swidux\/pluginpaywallreference"}}}