 — dispatched actions hop back to the MainActor.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","isActive":true,"type":"reference"},{"text":" is a ","type":"text"},{"code":"@Sendable","type":"codeVoice"},{"text":" async closure. Run with ","type":"text"},{"code":"Task { @concurrent in }","type":"codeVoice"},{"text":" to stay off the MainActor.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Define your action tree and root reducer:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppAction.swift","enum AppAction: Sendable {","    case items(ItemAction)","    case tags(TagAction)","}","","\/\/ App\/AppReducer.swift","struct AppReducer: SwiduxReducer {","    let itemReducer = ItemReducer()","    let tagReducer  = TagReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .items(let action):","            return itemReducer.reduce(state: &state, action: action, environment: environment)","        case .tags(let action):","            return tagReducer.reduce(state: &state, action: action, environment: environment)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Feature reducers conform to ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxReducer","isActive":true},{"text":" with ","type":"text"},{"code":"Action = FeatureAction","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"RootAction = AppAction","type":"codeVoice"},{"text":". Return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when no async work is needed:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ItemReducer: SwiduxReducer {","    func reduce(state: inout AppState, action: ItemAction, environment: AppEnvironment) -> Effect? {","        switch action {","        case .increment(let id):","            state.items.modify(id) { $0.count += 1 }","        }","        return nil","    }","}"]},{"anchor":"Wire-the-Store","type":"heading","text":"Wire the Store","level":2},{"inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" is a generic ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" class that owns the dispatch cycle, plugin lifecycle, and observation layer. Define a typealias and a factory method:","type":"text"}],"type":"paragraph"},{"code":["typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let reducer = AppReducer()","        let environment = AppEnvironment.live()","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.items) { writes, deletes in","                    for item in writes { try? await db.upsert(item) }","                    for id in deletes  { try? await db.delete(id: id) }","                },","            ]","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            persistencePlugin: persistencePlugin","        )","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" handles the snapshot pattern internally — packing the observer tree into a struct, running the reducer, then unpacking only changed properties back. Views access state through "},{"type":"codeVoice","code":"@dynamicMemberLookup"},{"type":"text","text":", which forwards to the generated observer class tree."}],"type":"paragraph"},{"text":"Wire Views","anchor":"Wire-Views","level":2,"type":"heading"},{"inlineContent":[{"text":"Views read from the store and dispatch actions. They don’t import Swidux or touch the database:","type":"text"}],"type":"paragraph"},{"code":["struct ItemListView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        List(store.items.values) { item in","            Text(item.name)","        }","        .toolbar {","            Button(\"Add\") { store.send(.items(.create)) }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"App Entry Point","type":"heading","anchor":"App-Entry-Point","level":3},{"inlineContent":[{"text":"Own the store with ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" and inject it via ","type":"text"},{"code":".environment()","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"text":"Next Steps","type":"heading","anchor":"Next-Steps","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},{"type":"text","text":" — Learn the full "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" API"}]}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},{"type":"text","text":" — Configure persistence writers"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swid