{"metadata":{"roleHeading":"Article","title":"Getting Started with Swidux","modules":[{"name":"Swidux"}],"role":"article"},"variants":[{"paths":["\/documentation\/swidux\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"This guide walks through the four steps to integrate Swidux: add the package, define your types, wire the store, and connect views.","type":"text"}],"type":"paragraph"},{"anchor":"Add-the-Package","level":2,"text":"Add the Package","type":"heading"},{"inlineContent":[{"inlineContent":[{"text":"Xcode:","type":"text"}],"type":"strong"},{"text":" File > Add Package Dependencies, paste ","type":"text"},{"code":"https:\/\/github.com\/heirloomlogic\/Swidux","type":"codeVoice"},{"text":", set ","type":"text"},{"inlineContent":[{"text":"Up to Next Major","type":"text"}],"type":"strong"},{"text":" from ","type":"text"},{"code":"1.0.0","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Package.swift:","type":"text"}],"type":"strong"}],"type":"paragraph"},{"code":["dependencies: [","    .package(url: \"https:\/\/github.com\/heirloomlogic\/Swidux\", from: \"1.0.0\"),","]"],"syntax":"swift","type":"codeListing"},{"text":"Define Your Types","anchor":"Define-Your-Types","level":2,"type":"heading"},{"inlineContent":[{"text":"Re-export Swidux from ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"text":" so no other file needs ","type":"text"},{"code":"import Swidux","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","@SwiduxState","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    var tags  = EntityStore<Tag>()","    @SwiduxNested var ui = UIState()","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"@SwiduxState","type":"codeVoice"},{"text":" generates an ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" companion class and ","type":"text"},{"code":"SwiduxObservable","type":"codeVoice"},{"text":" conformance. ","type":"text"},{"code":"@SwiduxNested","type":"codeVoice"},{"text":" marks nested state slices that get their own observer class for per-property observation granularity.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Specialize the generic effect system with your action type:","type":"text"}],"type":"paragraph"},{"code":["\/\/ App\/Effect.swift","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Send","isActive":true,"type":"reference"},{"text":" is ","type":"text"},{"code":"@MainActor @Sendable (Action) -> Void","type":"codeVoice"},{"text":" — dispatched actions hop back to the MainActor.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","isActive":true,"type":"reference"},{"text":" is a ","type":"text"},{"code":"@Sendable","type":"codeVoice"},{"text":" async closure. Run with ","type":"text"},{"code":"Task { @concurrent in }","type":"codeVoice"},{"text":" to stay off the MainActor.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Define your action tree and root reducer:","type":"text"}],"type":"paragraph"},{"code":["\/\/ App\/AppAction.swift","enum AppAction: Sendable {","    case items(ItemAction)","    case tags(TagAction)","}","","\/\/ App\/AppReducer.swift","struct AppReducer: SwiduxReducer {","    let itemReducer = ItemReducer()","    let tagReducer  = TagReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .items(let action):","            return itemReducer.reduce(state: &state, action: action, environment: environment)","        case .tags(let action):","            return tagReducer.reduce(state: &state, action: action, environment: environment)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Feature reducers conform to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxReducer"},{"text":" with ","type":"text"},{"code":"Action = FeatureAction","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"RootAction = AppAction","type":"codeVoice"},{"text":". Return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when no async work is needed:","type":"text"}],"type":"paragraph"},{"code":["struct ItemReducer: SwiduxReducer {","    func reduce(state: inout AppState, action: ItemAction, environment: AppEnvironment) -> Effect? {","        switch action {","        case .increment(let id):","            state.items.modify(id) { $0.count += 1 }","        }","        return nil","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Wire the Store","anchor":"Wire-the-Store","level":2,"type":"heading"},{"inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" is a generic ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" class that owns the dispatch cycle, plugin lifecycle, and observation layer. Define a typealias and a factory method:","type":"text"}],"type":"paragraph"},{"code":["typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let reducer = AppReducer()","        let environment = AppEnvironment.live()","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.items) { writes, deletes in","                    for item in writes { try? await db.upsert(item) }","                    for id in deletes  { try? await db.delete(id: id) }","                },","            ]","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            persistencePlugin: persistencePlugin","        )","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" handles the snapshot pattern internally — packing the observer tree into a struct, running the reducer, then unpacking only changed properties back. Views access state through ","type":"text"},{"code":"@dynamicMemberLookup","type":"codeVoice"},{"text":", which forwards to the generated observer class tree.","type":"text"}],"type":"paragraph"},{"text":"Wire Views","anchor":"Wire-Views","level":2,"type":"heading"},{"inlineContent":[{"text":"Views read from the store and dispatch actions. They don’t import Swidux or touch the database:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ItemListView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        List(store.items.values) { item in","            Text(item.name)","        }","        .toolbar {","            Button(\"Add\") { store.send(.items(.create)) }","        }","    }","}"],"type":"codeListing"},{"level":3,"text":"App Entry Point","type":"heading","anchor":"App-Entry-Point"},{"inlineContent":[{"text":"Own the store with ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" and inject it via ","type":"text"},{"code":".environment()","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","    }","}"],"type":"codeListing"},{"text":"Next Steps","anchor":"Next-Steps","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},{"text":" — Learn the full ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" API","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},{"text":" — Configure persistence writers","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide"},{"text":" — Understand the snapshot pattern and performance considerations","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"SwiduxObservable","type":"codeVoice"},{"text":" — Hand-write observation bridging for advanced cases","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"seeAlsoSections":[{"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"],"generated":true,"title":"Reference"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Swidux\/docu