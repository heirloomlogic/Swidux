{"metadata":{"role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"Getting Started with Swidux"},"abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/gettingstarted"]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This guide walks through the four steps to integrate Swidux: add the package, define your types, wire the store, and connect views.","type":"text"}]},{"type":"heading","anchor":"Add-the-Package","level":2,"text":"Add the Package"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Xcode:"}],"type":"strong"},{"type":"text","text":" File > Add Package Dependencies, paste "},{"code":"https:\/\/github.com\/heirloomlogic\/Swidux","type":"codeVoice"},{"text":", set ","type":"text"},{"inlineContent":[{"type":"text","text":"Up to Next Major"}],"type":"strong"},{"type":"text","text":" from "},{"code":"1.0.0","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Package.swift:"}],"type":"strong"}]},{"syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/heirloomlogic\/Swidux\", from: \"1.0.0\"),","]"],"type":"codeListing"},{"type":"heading","anchor":"Define-Your-Types","level":2,"text":"Define Your Types"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Re-export Swidux from "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" so no other file needs "},{"type":"codeVoice","code":"import Swidux"},{"type":"text","text":":"}]},{"type":"codeListing","code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    var tags  = EntityStore<Tag>()","    @Slice var ui = UIState()","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" generates an "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" companion class and "},{"code":"SwiduxObservable","type":"codeVoice"},{"text":" conformance. ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" marks nested state slices that get their own observer class for per-property observation granularity.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Specialize the generic effect system with your action type:"}]},{"type":"codeListing","code":["\/\/ App\/Effect.swift","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Send","isActive":true,"type":"reference"},{"text":" is ","type":"text"},{"code":"@MainActor @Sendable (Action) -> Void","type":"codeVoice"},{"text":" — dispatched actions hop back to the MainActor.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","isActive":true,"type":"reference"},{"text":" is a ","type":"text"},{"code":"@Sendable","type":"codeVoice"},{"text":" async closure. Run with ","type":"text"},{"code":"Task { @concurrent in }","type":"codeVoice"},{"text":" to stay off the MainActor.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Define your action tree and root reducer:"}]},{"type":"codeListing","code":["\/\/ App\/AppAction.swift","enum AppAction: Sendable {","    case items(ItemAction)","    case tags(TagAction)","}","","\/\/ App\/AppReducer.swift","struct AppReducer: SwiduxReducer {","    let itemReducer = ItemReducer()","    let tagReducer  = TagReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .items(let action):","            return itemReducer.reduce(state: &state, action: action, environment: environment)","        case .tags(let action):","            return tagReducer.reduce(state: &state, action: action, environment: environment)","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feature reducers conform to "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxReducer","isActive":true,"type":"reference"},{"type":"text","text":" with "},{"code":"Action = FeatureAction","type":"codeVoice"},{"type":"text","text":" and "},{"code":"RootAction = AppAction","type":"codeVoice"},{"type":"text","text":". Return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when no async work is needed:"}]},{"type":"codeListing","code":["struct ItemReducer: SwiduxReducer {","    func reduce(state: inout AppState, action: ItemAction, environment: AppEnvironment) -> Effect? {","        switch action {","        case .increment(let id):","            state.items.modify(id) { $0.count += 1 }","        }","        return nil","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"Wire-the-Store","level":2,"text":"Wire the Store"},{"type":"paragraph","inlineContent":[{"code":"Store","type":"codeVoice"},{"type":"text","text":" is a generic "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" class that owns the dispatch cycle, plugin lifecycle, and observation layer. Define a typealias and a factory method:"}]},{"type":"codeListing","code":["typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let reducer = AppReducer()","        let environment = AppEnvironment.live()","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.items) { writes, deletes in","                    for item in writes { try? await db.upsert(item) }","                    for id in deletes  { try? await db.delete(id: id) }","                },","            ]","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            persistencePlugin: persistencePlugin","        )","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"Store","type":"codeVoice"},{"type":"text","text":" handles the snapshot pattern internally — packing the observer tree into a struct, running the reducer, then unpacking only changed properties back. Views access state through "},{"code":"@dynamicMemberLookup","type":"codeVoice"},{"type":"text","text":", which forwards to the generated observer class tree."}]},{"type":"heading","anchor":"Wire-Views","level":2,"text":"Wire Views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views read from the store and dispatch actions. They don’t import Swidux or touch the database:"}]},{"type":"codeListing","code":["struct ItemListView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        List(store.items.values) { item in","            Text(item.name)","        }","        .toolbar {","            Button(\"Add\") { store.send(.items(.create)) }","        }","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"App-Entry-Point","level":3,"text":"App Entry Point"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Own the store with "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" and inject it via "},{"code":".environment()","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","    }","}"],"syntax":"swift"},{"type":"heading","anchor":"Next-Steps","level":2,"text":"Next Steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","isActive":true,"type":"reference"},{"text":" — Learn the full ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" API","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true,"type":"reference"},{"text":" — Configure persistence writers","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","isActive":true,"type":"reference"},{"text":" — Understand the snapshot pattern and performance considerations","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"SwiduxObservable","type":"codeVoice"},{"text":" — Hand-write observation bridging for advanced cases","type":"text"}]}]}]}],"kind":"content"}],"seeAlsoSections":[{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureF