{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swidux\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide walks through the four steps to integrate Swidux: add the package, define your types, wire the store, and connect views."}]},{"level":2,"type":"heading","text":"Add the Package","anchor":"Add-the-Package"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Xcode:","type":"text"}],"type":"strong"},{"type":"text","text":" File > Add Package Dependencies, paste "},{"type":"codeVoice","code":"https:\/\/github.com\/heirloomlogic\/Swidux"},{"type":"text","text":", set "},{"inlineContent":[{"text":"Up to Next Major","type":"text"}],"type":"strong"},{"type":"text","text":" from "},{"type":"codeVoice","code":"1.0.0"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Package.swift:","type":"text"}],"type":"strong"}]},{"type":"codeListing","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/heirloomlogic\/Swidux\", from: \"1.0.0\"),","]"],"syntax":"swift"},{"level":2,"type":"heading","text":"Define Your Types","anchor":"Define-Your-Types"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Re-export Swidux from "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" so no other file needs "},{"type":"codeVoice","code":"import Swidux"},{"type":"text","text":":"}]},{"type":"codeListing","code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","@Swidux","struct AppState: Equatable, Sendable {","    var items: EntityStore<Item> = .init()","    var tags: EntityStore<Tag> = .init()","    @Slice var ui: UIState = .init()","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" requires an explicit type annotation on every stored property — it needs the type at macro-expansion time, and can’t always infer one from the initializer."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" generates an "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" companion class and "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":" conformance. "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" marks nested state slices that get their own observer class for per-property observation granularity."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Specialize the generic effect system with your action type:"}]},{"type":"codeListing","code":["\/\/ App\/Effect.swift","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Send","type":"reference","isActive":true},{"text":" is ","type":"text"},{"type":"codeVoice","code":"@MainActor @Sendable (Action) -> Void"},{"text":" — dispatched actions hop back to the MainActor.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","type":"reference","isActive":true},{"text":" holds a ","type":"text"},{"type":"codeVoice","code":"@Sendable"},{"text":" async operation and cancellation metadata. Construct it with ","type":"text"},{"type":"codeVoice","code":"Effect { send in ... }"},{"text":"; the store runs its operation off the MainActor.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Define your action tree and root reducer:"}]},{"type":"codeListing","code":["\/\/ App\/AppAction.swift","enum AppAction: Sendable {","    case items(ItemAction)","    case tags(TagAction)","}","","\/\/ App\/AppReducer.swift","struct AppReducer: SwiduxReducer {","    let itemReducer = ItemReducer()","    let tagReducer  = TagReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .items(let action):","            return itemReducer.reduce(state: &state, action: action, environment: environment)","        case .tags(let action):","            return tagReducer.reduce(state: &state, action: action, environment: environment)","        }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feature reducers conform to "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxReducer","type":"reference"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Action = FeatureAction"},{"type":"text","text":" and "},{"type":"codeVoice","code":"RootAction = AppAction"},{"type":"text","text":". Return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when no async work is needed:"}]},{"type":"codeListing","code":["struct ItemReducer: SwiduxReducer {","    func reduce(state: inout AppState, action: ItemAction, environment: AppEnvironment) -> Effect? {","        switch action {","        case .increment(let id):","            state.items.modify(id) { $0.count += 1 }","        }","        return nil","    }","}"],"syntax":"swift"},{"level":2,"type":"heading","text":"Wire the Store","anchor":"Wire-the-Store"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" is a generic "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" class that owns the dispatch cycle, plugin lifecycle, and observation layer. Define a typealias and a factory method:"}]},{"type":"codeListing","code":["typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let reducer = AppReducer()","        let environment = AppEnvironment.live()","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.items) { writes, deletes in","                    for item in writes { try await db.upsert(item) }","                    for id in deletes  { try await db.delete(id: id) }","                },","            ]","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins","        )","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Registering "},{"type":"codeVoice","code":"persistencePlugin"},{"type":"text","text":" on "},{"type":"codeVoice","code":"plugins"},{"type":"text","text":" is all the wiring it needs — "},{"type":"codeVoice","code":"Store"},{"type":"text","text":" finds it there for "},{"type":"codeVoice","code":"store.mutate { … }"},{"type":"text","text":" and undo\/redo, the two paths that drain outside the plugin lifecycle, so you don’t have to name it a second time as "},{"type":"codeVoice","code":"persistencePlugin:"},{"type":"text","text":". That parameter still exists, for draining through a plugin you deliberately didn’t register."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" handles the snapshot pattern internally — packing the observer tree into a struct, running the reducer, then unpacking only changed properties back. Views access state through "},{"type":"codeVoice","code":"@dynamicMemberLookup"},{"type":"text","text":", which forwards to the generated observer class tree."}]},{"level":2,"type":"heading","text":"Wire Views","anchor":"Wire-Views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views read from the store and dispatch actions. They don’t import Swidux or touch the database:"}]},{"type":"codeListing","code":["struct ItemListView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        List(store.items.values) { item in","            Text(item.name)","        }","        .toolbar {","            Button(\"Add\") { store.send(.items(.create)) }","        }","    }","}"],"syntax":"swift"},{"level":3,"type":"heading","text":"App Entry Point","anchor":"App-Entry-Point"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Own the store with "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" and inject it via "},{"type":"codeVoice","code":".environment()"},{"type":"text","text":":"}]},{"type":"codeListing","code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","    }","}"],"syntax":"swift"},{"level":2,"type":"heading","text":"Next Steps","anchor":"Next-Steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"reference","isActive":true},{"text":" — Learn the full ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"text":" API","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"reference","isActive":true},{"text":" — Configure persistence writers","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","type":"reference","isActive":true},{"text":" — Understand the snapshot pattern and performance considerations","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxObservable"},{"text":" — Hand-write observation bridging for advanced cases","type":"text"}]}]}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"article","modules":[{"name":"Swidux"}],"title":"Getting Started with Swidux","roleHeading":"Article"},"seeAlsoSections":[{"generated":true,"title":"Reference","anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/EntityEditingGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistedAssociations","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"]}],"references":{"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"kind":"article","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"title":"Persistence Plugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"topic","url":"\/documentation\/swidux\/pers