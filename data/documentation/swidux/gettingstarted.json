{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"This guide walks through the four steps to integrate Swidux: add the package, define your types, wire the store, and connect views."}],"type":"paragraph"},{"text":"Add the Package","type":"heading","level":2,"anchor":"Add-the-Package"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Xcode:"}]},{"type":"text","text":" File > Add Package Dependencies, paste "},{"type":"codeVoice","code":"https:\/\/github.com\/heirloomlogic\/Swidux"},{"type":"text","text":", set "},{"type":"strong","inlineContent":[{"type":"text","text":"Up to Next Major"}]},{"type":"text","text":" from "},{"type":"codeVoice","code":"1.0.0"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Package.swift:"}]}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/heirloomlogic\/Swidux\", from: \"1.0.0\"),","]"]},{"text":"Define Your Types","type":"heading","level":2,"anchor":"Define-Your-Types"},{"inlineContent":[{"type":"text","text":"Re-export Swidux from "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" so no other file needs "},{"type":"codeVoice","code":"import Swidux"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    var tags  = EntityStore<Tag>()","    @Slice var ui = UIState()","}"]},{"inlineContent":[{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" generates an "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" companion class and "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":" conformance. "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" marks nested state slices that get their own observer class for per-property observation granularity."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Specialize the generic effect system with your action type:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/Effect.swift","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Send"},{"type":"text","text":" is "},{"type":"codeVoice","code":"@MainActor @Sendable (Action) -> Void"},{"type":"text","text":" — dispatched actions hop back to the MainActor."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"@Sendable"},{"type":"text","text":" async closure. Run with "},{"type":"codeVoice","code":"Task { @concurrent in }"},{"type":"text","text":" to stay off the MainActor."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Define your action tree and root reducer:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppAction.swift","enum AppAction: Sendable {","    case items(ItemAction)","    case tags(TagAction)","}","","\/\/ App\/AppReducer.swift","struct AppReducer: SwiduxReducer {","    let itemReducer = ItemReducer()","    let tagReducer  = TagReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .items(let action):","            return itemReducer.reduce(state: &state, action: action, environment: environment)","        case .tags(let action):","            return tagReducer.reduce(state: &state, action: action, environment: environment)","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"Feature reducers conform to "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxReducer","type":"reference"},{"type":"text","text":" with "},{"type":"codeVoice","code":"Action = FeatureAction"},{"type":"text","text":" and "},{"type":"codeVoice","code":"RootAction = AppAction"},{"type":"text","text":". Return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" when no async work is needed:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ItemReducer: SwiduxReducer {","    func reduce(state: inout AppState, action: ItemAction, environment: AppEnvironment) -> Effect? {","        switch action {","        case .increment(let id):","            state.items.modify(id) { $0.count += 1 }","        }","        return nil","    }","}"]},{"text":"Wire the Store","type":"heading","level":2,"anchor":"Wire-the-Store"},{"inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" is a generic "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" class that owns the dispatch cycle, plugin lifecycle, and observation layer. Define a typealias and a factory method:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let reducer = AppReducer()","        let environment = AppEnvironment.live()","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.items) { writes, deletes in","                    for item in writes { try? await db.upsert(item) }","                    for id in deletes  { try? await db.delete(id: id) }","                },","            ]","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            persistencePlugin: persistencePlugin","        )","    }","}"]},{"inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" handles the snapshot pattern internally — packing the observer tree into a struct, running the reducer, then unpacking only changed properties back. Views access state through "},{"type":"codeVoice","code":"@dynamicMemberLookup"},{"type":"text","text":", which forwards to the generated observer class tree."}],"type":"paragraph"},{"text":"Wire Views","type":"heading","level":2,"anchor":"Wire-Views"},{"inlineContent":[{"type":"text","text":"Views read from the store and dispatch actions. They don’t import Swidux or touch the database:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ItemListView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        List(store.items.values) { item in","            Text(item.name)","        }","        .toolbar {","            Button(\"Add\") { store.send(.items(.create)) }","        }","    }","}"]},{"text":"App Entry Point","type":"heading","level":3,"anchor":"App-Entry-Point"},{"inlineContent":[{"type":"text","text":"Own the store with "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" and inject it via "},{"type":"codeVoice","code":".environment()"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","    }","}"]},{"text":"Next Steps","type":"heading","level":2,"anchor":"Next-Steps"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},{"type":"text","text":" — Learn the full "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" API"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},{"type":"text","text":" — Configure persistence writers"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide"},{"type":"text","text":" — Understand the snapshot pattern and performance considerations"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":" — Hand-write observation bridging for advanced cases"}]}]}],"type":"unorderedList"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"kind":"article","sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"],"generated":true,"title":"Reference","anchor":"Reference"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metad