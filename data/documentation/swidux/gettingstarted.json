{"kind":"article","variants":[{"paths":["\/documentation\/swidux\/gettingstarted"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"seeAlsoSections":[{"anchor":"Reference","title":"Reference","generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"]}],"metadata":{"roleHeading":"Article","role":"article","title":"Getting Started with Swidux","modules":[{"name":"Swidux"}]},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"This guide walks through the four steps to integrate Swidux: add the package, define your types, wire the store, and connect views.","type":"text"}],"type":"paragraph"},{"text":"Add the Package","anchor":"Add-the-Package","level":2,"type":"heading"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Xcode:"}],"type":"strong"},{"text":" File > Add Package Dependencies, paste ","type":"text"},{"code":"https:\/\/github.com\/heirloomlogic\/Swidux","type":"codeVoice"},{"text":", set ","type":"text"},{"inlineContent":[{"type":"text","text":"Up to Next Major"}],"type":"strong"},{"text":" from ","type":"text"},{"code":"1.0.0","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Package.swift:","type":"text"}],"type":"strong"}]},{"syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/heirloomlogic\/Swidux\", from: \"1.0.0\"),","]"],"type":"codeListing"},{"level":2,"text":"Define Your Types","type":"heading","anchor":"Define-Your-Types"},{"type":"paragraph","inlineContent":[{"text":"Re-export Swidux from ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"type":"text","text":" so no other file needs "},{"type":"codeVoice","code":"import Swidux"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    var tags  = EntityStore<Tag>()","    @Slice var ui = UIState()","}"]},{"type":"paragraph","inlineContent":[{"code":"@Swidux","type":"codeVoice"},{"text":" generates an ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" companion class and ","type":"text"},{"code":"SwiduxObservable","type":"codeVoice"},{"text":" conformance. ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" marks nested state slices that get their own observer class for per-property observation granularity.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Specialize the generic effect system with your action type:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/Effect.swift","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"]},{"items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Send","type":"reference"},{"text":" is ","type":"text"},{"code":"@MainActor @Sendable (Action) -> Void","type":"codeVoice"},{"text":" — dispatched actions hop back to the MainActor.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","type":"reference"},{"text":" holds a ","type":"text"},{"code":"@Sendable","type":"codeVoice"},{"text":" async operation and cancellation metadata. Construct it with ","type":"text"},{"code":"Effect { send in ... }","type":"codeVoice"},{"text":"; the store runs its operation off the MainActor.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Define your action tree and root reducer:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppAction.swift","enum AppAction: Sendable {","    case items(ItemAction)","    case tags(TagAction)","}","","\/\/ App\/AppReducer.swift","struct AppReducer: SwiduxReducer {","    let itemReducer = ItemReducer()","    let tagReducer  = TagReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .items(let action):","            return itemReducer.reduce(state: &state, action: action, environment: environment)","        case .tags(let action):","            return tagReducer.reduce(state: &state, action: action, environment: environment)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Feature reducers conform to ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxReducer","type":"reference","isActive":true},{"text":" with ","type":"text"},{"code":"Action = FeatureAction","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"RootAction = AppAction","type":"codeVoice"},{"text":". Return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when no async work is needed:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct ItemReducer: SwiduxReducer {","    func reduce(state: inout AppState, action: ItemAction, environment: AppEnvironment) -> Effect? {","        switch action {","        case .increment(let id):","            state.items.modify(id) { $0.count += 1 }","        }","        return nil","    }","}"]},{"level":2,"text":"Wire the Store","type":"heading","anchor":"Wire-the-Store"},{"type":"paragraph","inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" is a generic ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" class that owns the dispatch cycle, plugin lifecycle, and observation layer. Define a typealias and a factory method:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let reducer = AppReducer()","        let environment = AppEnvironment.live()","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.items) { writes, deletes in","                    for item in writes { try await db.upsert(item) }","                    for id in deletes  { try await db.delete(id: id) }","                },","            ]","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            persistencePlugin: persistencePlugin","        )","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" handles the snapshot pattern internally — packing the observer tree into a struct, running the reducer, then unpacking only changed properties back. Views access state through ","type":"text"},{"code":"@dynamicMemberLookup","type":"codeVoice"},{"text":", which forwards to the generated observer class tree.","type":"text"}]},{"level":2,"text":"Wire Views","type":"heading","anchor":"Wire-Views"},{"type":"paragraph","inlineContent":[{"text":"Views read from the store and dispatch actions. They don’t import Swidux or touch the database:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct ItemListView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        List(store.items.values) { item in","            Text(item.name)","        }","        .toolbar {","            Button(\"Add\") { store.send(.items(.create)) }","        }","    }","}"]},{"level":3,"text":"App Entry Point","type":"heading","anchor":"App-Entry-Point"},{"type":"paragraph","inlineContent":[{"text":"Own the store with ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" and inject it via ","type":"text"},{"code":".environment()","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","    }","}"]},{"level":2,"text":"Next Steps","type":"heading","anchor":"Next-Steps"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"reference"},{"text":" — Learn the full ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":" API","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"reference"},{"text":" — Configure persistence writers","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","t