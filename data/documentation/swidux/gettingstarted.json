"strong","inlineContent":[{"type":"text","text":"Up to Next Major"}]},{"text":" from ","type":"text"},{"code":"1.0.0","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Package.swift:"}],"type":"strong"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/heirloomlogic\/Swidux\", from: \"1.0.0\"),","]"]},{"level":2,"type":"heading","text":"Define Your Types","anchor":"Define-Your-Types"},{"inlineContent":[{"text":"Re-export Swidux from ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"type":"text","text":" so no other file needs "},{"code":"import Swidux","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    var tags  = EntityStore<Tag>()","    @Slice var ui = UIState()","}"]},{"inlineContent":[{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" generates an "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" companion class and "},{"code":"SwiduxObservable","type":"codeVoice"},{"type":"text","text":" conformance. "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":" marks nested state slices that get their own observer class for per-property observation granularity."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Specialize the generic effect system with your action type:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/Effect.swift","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Send"},{"type":"text","text":" is "},{"type":"codeVoice","code":"@MainActor @Sendable (Action) -> Void"},{"type":"text","text":" — dispatched actions hop back to the MainActor."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","isActive":true,"type":"reference"},{"text":" is a ","type":"text"},{"code":"@Sendable","type":"codeVoice"},{"text":" async closure. Run with ","type":"text"},{"code":"Task { @concurrent in }","type":"codeVoice"},{"text":" to stay off the MainActor.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Define your action tree and root reducer:"}]},{"code":["\/\/ App\/AppAction.swift","enum AppAction: Sendable {","    case items(ItemAction)","    case tags(TagAction)","}","","\/\/ App\/AppReducer.swift","struct AppReducer: SwiduxReducer {","    let itemReducer = ItemReducer()","    let tagReducer  = TagReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .items(let action):","            return itemReducer.reduce(state: &state, action: action, environment: environment)","        case .tags(let action):","            return tagReducer.reduce(state: &state, action: action, environment: environment)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feature reducers conform to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxReducer"},{"type":"text","text":" with "},{"code":"Action = FeatureAction","type":"codeVoice"},{"type":"text","text":" and "},{"code":"RootAction = AppAction","type":"codeVoice"},{"type":"text","text":". Return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" when no async work is needed:"}]},{"code":["struct ItemReducer: SwiduxReducer {","    func reduce(state: inout AppState, action: ItemAction, environment: AppEnvironment) -> Effect? {","        switch action {","        case .increment(let id):","            state.items.modify(id) { $0.count += 1 }","        }","        return nil","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Wire the Store","type":"heading","anchor":"Wire-the-Store"},{"type":"paragraph","inlineContent":[{"code":"Store","type":"codeVoice"},{"type":"text","text":" is a generic "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" class that owns the dispatch cycle, plugin lifecycle, and observation layer. Define a typealias and a factory method:"}]},{"code":["typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let reducer = AppReducer()","        let environment = AppEnvironment.live()","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.items) { writes, deletes in","                    for item in writes { try? await db.upsert(item) }","                    for id in deletes  { try? await db.delete(id: id) }","                },","            ]","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            persistencePlugin: persistencePlugin","        )","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"Store","type":"codeVoice"},{"type":"text","text":" handles the snapshot pattern internally — packing the observer tree into a struct, running the reducer, then unpacking only changed properties back. Views access state through "},{"code":"@dynamicMemberLookup","type":"codeVoice"},{"type":"text","text":", which forwards to the generated observer class tree."}]},{"level":2,"text":"Wire Views","type":"heading","anchor":"Wire-Views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views read from the store and dispatch actions. They don’t import Swidux or touch the database:"}]},{"code":["struct ItemListView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        List(store.items.values) { item in","            Text(item.name)","        }","        .toolbar {","            Button(\"Add\") { store.send(.items(.create)) }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"App Entry Point","type":"heading","anchor":"App-Entry-Point"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Own the store with "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" and inject it via "},{"code":".environment()","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Next Steps","type":"heading","anchor":"Next-Steps"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","isActive":true,"type":"reference"},{"text":" — Learn the full ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"type":"text","text":" API"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},{"type":"text","text":" — Configure persistence writers"}]}]},{