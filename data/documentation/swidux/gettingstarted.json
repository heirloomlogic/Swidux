ux\/undoplugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"type":"topic","role":"symbol","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","title":"UndoPlugin"},"doc://Swidux/documentation/Swidux/UndoRedo":{"url":"\/documentation\/swidux\/undoredo","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"text":".","type":"text"}],"role":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","kind":"article","title":"Undo \/ Redo"},"doc://Swidux/documentation/Swidux/SwiduxReducer":{"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiduxReducer"}],"navigatorTitle":[{"text":"SwiduxReducer","kind":"identifier"}],"title":"SwiduxReducer","abstract":[{"type":"text","text":"A reducer that transforms state in response to actions."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxReducer","url":"\/documentation\/swidux\/swiduxreducer","role":"symbol"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"url":"\/documentation\/swidux\/persistencemiddlewareguide","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","title":"Persistence Middleware"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"url":"\/documentation\/swidux\/pluginfeatureflagsreference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlag