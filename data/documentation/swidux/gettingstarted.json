{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/gettingstarted"]}],"metadata":{"title":"Getting Started with Swidux","roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"This guide walks through the four steps to integrate Swidux: add the package, define your types, wire the store, and connect views."}],"type":"paragraph"},{"text":"Add the Package","level":2,"anchor":"Add-the-Package","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Xcode:","type":"text"}]},{"type":"text","text":" File > Add Package Dependencies, paste "},{"type":"codeVoice","code":"https:\/\/github.com\/heirloomlogic\/Swidux"},{"type":"text","text":", set "},{"type":"strong","inlineContent":[{"type":"text","text":"Up to Next Major"}]},{"type":"text","text":" from "},{"code":"1.0.0","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Package.swift:"}],"type":"strong"}]},{"type":"codeListing","code":["dependencies: [","    .package(url: \"https:\/\/github.com\/heirloomlogic\/Swidux\", from: \"1.0.0\"),","]"],"syntax":"swift"},{"type":"heading","text":"Define Your Types","level":2,"anchor":"Define-Your-Types"},{"type":"paragraph","inlineContent":[{"text":"Re-export Swidux from ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"type":"text","text":" so no other file needs "},{"type":"codeVoice","code":"import Swidux"},{"type":"text","text":":"}]},{"code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","@Swidux","struct AppState: Equatable, Sendable {","    var items = EntityStore<Item>()","    var tags  = EntityStore<Tag>()","    @Slice var ui = UIState()","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Swidux"},{"text":" generates an ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" companion class and ","type":"text"},{"type":"codeVoice","code":"SwiduxObservable"},{"text":" conformance. ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" marks nested state slices that get their own observer class for per-property observation granularity.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Specialize the generic effect system with your action type:"}]},{"code":["\/\/ App\/Effect.swift","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"],"type":"codeListing","syntax":"swift"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Send"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"@MainActor @Sendable (Action) -> Void"},{"text":" — dispatched actions hop back to the MainActor.","type":"text"}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","type":"reference"},{"text":" is a ","type":"text"},{"code":"@Sendable","type":"codeVoice"},{"text":" async closure. Run with ","type":"text"},{"code":"Task { @concurrent in }","type":"codeVoice"},{"text":" to stay off the MainActor.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Define your action tree and root reducer:"}]},{"code":["\/\/ App\/AppAction.swift","enum AppAction: Sendable {","    case items(ItemAction)","    case tags(TagAction)","}","","\/\/ App\/AppReducer.swift","struct AppReducer: SwiduxReducer {","    let itemReducer = ItemReducer()","    let tagReducer  = TagReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .items(let action):","            return itemReducer.reduce(state: &state, action: action, environment: environment)","        case .tags(let action):","            return tagReducer.reduce(state: &state, action: action, environment: environment)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feature reducers conform to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxReducer"},{"type":"text","text":" with "},{"code":"Action = FeatureAction","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"RootAction = AppAction","type":"codeVoice"},{"text":". Return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" when no async work is needed:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ItemReducer: SwiduxReducer {","    func reduce(state: inout AppState, action: ItemAction, environment: AppEnvironment) -> Effect? {","        switch action {","        case .increment(let id):","            state.items.modify(id) { $0.count += 1 }","        }","        return nil","    }","}"]},{"anchor":"Wire-the-Store","type":"heading","level":2,"text":"Wire the Store"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"text":" is a generic ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" class that owns the dispatch cycle, plugin lifecycle, and observation layer. Define a typealias and a factory method:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured() -> AppStore {","        let reducer = AppReducer()","        let environment = AppEnvironment.live()","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.items) { writes, deletes in","                    for item in writes { try? await db.upsert(item) }","                    for id in deletes  { try? await db.delete(id: id) }","                },","            ]","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            persistencePlugin: persistencePlugin","        )","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"Store","type":"codeVoice"},{"type":"text","text":" handles the snapshot pattern internally — packing the observer tree into a struct, running the reducer, then unpacking only changed properties back. Views access state through "},{"code":"@dynamicMemberLookup","type":"codeVoice"},{"type":"text","text":", which forwards to the generated observer class tree."}]},{"anchor":"Wire-Views","type":"heading","level":2,"text":"Wire Views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views read from the store and dispatch actions. They don’t import Swidux or touch the database:"}]},{"type":"codeListing","syntax":"swift","code":["struct ItemListView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        List(store.items.values) { item in","            Text(item.name)","        }","        .toolbar {","            Button(\"Add\") { store.send(.items(.create)) }","        }","    }","}"]},{"anchor":"App-Entry-Point","type":"heading","level":3,"text":"App Entry Point"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Own the store with "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" and inject it via "},{"type":"codeVoice","code":".environment()"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["@main","struct MyApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","    }","}"]},{"anchor":"Next-Steps","type":"heading","level":2,"text":"Next Steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},{"text":" — Learn the full ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":" API","type":"text"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true,"type":"reference"},{"text":" — Configure persistence writers","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","type":"reference","isActive":true},{"text":" — Understand the snapshot pattern and performance considerations","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":" — Hand-write observation bridging for advanced cases"}],"type":"paragraph"}]}]}]}],"abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"kind":"article","seeAlsoSections":[{"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\