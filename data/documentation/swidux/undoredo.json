dding Undo to Your App"},{"level":3,"type":"heading","anchor":"1-Create-the-plugin","text":"1. Create the plugin"},{"type":"paragraph","inlineContent":[{"text":"Pass declarative predicates to classify which actions are undoable and which coalesce:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"]},{"level":3,"type":"heading","anchor":"2-Register-and-pass-to-Store","text":"2. Register and pass to Store"},{"type":"paragraph","inlineContent":[{"text":"Register the plugin with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference"},{"text":" for lifecycle hooks, and pass it directly to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference"},{"text":" for undo\/redo methods and ","type":"text"},{"code":"canUndo","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"canRedo","type":"codeVoice"},{"text":" tracking:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"]},{"type":"paragraph","inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" handles the rest internally: snapshotting state before undoable actions, restoring via ","type":"text"},{"code":"applyRestore","type":"codeVoice"},{"text":" on undo\/redo, draining persistence changes, and updating ","type":"text"},{"code":"canUndo","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"canRedo","type":"codeVoice"},{"text":".","type":"text"}]},{"level":3,"type":"heading","anchor":"3-Wire-platform-UI","text":"3. Wire platform UI"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"macOS"}],"type":"strong"},{"text":" — replace the Edit menu:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"iOS"}],"type":"strong"},{"text":" — bridge the system UndoManager for shake-to-undo:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"]},{"type":"paragraph","inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" automatically registers undo\/redo actions with the ","type":"text"},{"code":"UndoManager","type":"codeVoice"},{"text":" after each undoable dispatch.","type":"text"}]},{"level":2,"type":"heading","anchor":"Coalescing","text":"Coalescing"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"coalescing","type":"codeVoice"},{"text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing