","title":"KeyValueStore","type":"topic","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","url":"\/documentation\/swidux\/pluginanalyticsreference","kind":"article","role":"article","title":"SwiduxAnalytics Reference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}]},"doc://Swidux/documentation/Swidux/Store":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","url":"\/documentation\/swidux\/store","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Store"}],"kind":"symbol","title":"Store","navigatorTitle":[{"kind":"identifier","text":"Store"}],"type":"topic","abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"type":"text","text":"observation layer."}]},"doc://Swidux/documentation/Swidux/EntityStore":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","url":"\/documentation\/swidux\/entitystore","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"title":"EntityStore","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}],"abstract":[{"type":"text","text":"An ordered, keyed collection of identifiable entities that silently records"},{"type":"text","text":" "},{"type":"text","text":"every mutation for downstream persistence."}]},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","url":"\/documentation\/swidux\/entitystoreguide","role":"article","kind":"article","title":"EntityStore","type":"topic","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}]}}}