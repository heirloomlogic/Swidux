{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}],"title":"Undo \/ Redo"},"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/swidux\/undoredo"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"type":"text","text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"restore(from:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you don’t use "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"type":"text","text":", nothing changes. It’s fully opt-in."}],"type":"paragraph"},{"level":2,"text":"Adding Undo to Your App","anchor":"Adding-Undo-to-Your-App","type":"heading"},{"level":3,"text":"1. Create the plugin","anchor":"1-Create-the-plugin","type":"heading"},{"inlineContent":[{"type":"text","text":"Pass declarative predicates to classify which actions are undoable and which coalesce:"}],"type":"paragraph"},{"code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"2. Register and pass to Store","anchor":"2-Register-and-pass-to-Store","type":"heading"},{"inlineContent":[{"type":"text","text":"Register the plugin with "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","isActive":true,"type":"reference"},{"type":"text","text":" for lifecycle hooks, and pass it directly to "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","isActive":true,"type":"reference"},{"type":"text","text":" for undo\/redo methods and "},{"type":"codeVoice","code":"canUndo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"canRedo"},{"type":"text","text":" tracking:"}],"type":"paragraph"},{"code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" handles the rest internally: snapshotting state before undoable actions, restoring via "},{"type":"codeVoice","code":"applyRestore"},{"type":"text","text":" on undo\/redo, draining persistence changes, and updating "},{"type":"codeVoice","code":"canUndo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"canRedo"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"text":"3. Wire platform UI","anchor":"3-Wire-platform-UI","type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":" — replace the Edit menu:"}],"type":"paragraph"},{"code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"iOS","type":"text"}]},{"type":"text","text":" — bridge the system UndoManager for shake-to-undo:"}],"type":"paragraph"},{"code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" automatically registers undo\/redo actions with the "},{"type":"codeVoice","code":"UndoManager"},{"type":"text","text":" after each undoable dispatch."}],"type":"paragraph"},{"level":2,"text":"Coalescing","anchor":"Coalescing","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"coalescing"},{"type":"text","text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five."}],"type":"paragraph"},{"level":2,"text":"Memory","anchor":"Memory","type":"heading"},{"inlineContent":[{"type":"text","text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use "},{"type":"codeVoice","code":"maxDepth"},{"type":"text","text":" to bound memory for large state:"}],"type":"paragraph"},{"code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"],"type":"codeListing","syntax":"swift"}]}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"title":"Reference","anchor":"Reference"}],"sections":[],"references":{"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"title":"Swidux","type":"topic","url":"\/documentation\/swidux","role":"collection"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"title":"SwiduxPaywall Reference","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"url":"\/documentation\/swidux\/pluginpaywallreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"title":"EntityStore","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","url":"\/documentation\/swidux\/entitystoreguide","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"title":"Persistence Middleware","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","url":"\/documentation\/swidux\/persistencemiddlewareguide","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"title":"SwiduxFeatureFlags Reference","type":"topic","url":"\/documentation\/swidux\/pluginfeatureflagsreference","role":"article"},"doc://Swidux/documentation/Swidux/MacrosReference":{"title":"Macros","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"text":" — the two macros that generate the observation bridge between value-type state and SwiftUI.","type":"text"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","url":"\/documentation\/swidux\/macrosreference","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"title":"SwiduxParentalGate Reference","url":"\/documentation\/swidux\/pluginparentalgatereference","kind":"article","abstract":[{"text":"API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","kind":"article","title":"SwiduxKillswitch Reference","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"url":"\/documentation\/swidux\/pluginkillswitchreference","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/EntityStore":{"title":"EntityStore","url":"\/documentation\/swidux\/entitystore","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}],"abstract":[{"type":"text","text":"An ordered, keyed collection of identifiable entities that silently records"},{"type":"text","text":" "},{"text":"every mutation for downstream persistence.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},"doc://Swidux/documentation/Swidux/Store":{"title":"Store","kind":"symbol","url":"\/documentation\/swidux\/store","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"topic","abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"type":"text","text":"observation layer."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"navigatorTitle":[{"text":"Store","kind":"identifier"}],"role":"symbol"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"title":"UndoPlugin","url":"