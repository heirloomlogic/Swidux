nce for "},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" and its property markers (the SwiftData persistence bridge, shipped in ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":").","type":"text"}]},"doc://Swidux/documentation/Swidux/Troubleshooting":{"type":"topic","title":"Troubleshooting","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","url":"\/documentation\/swidux\/troubleshooting","abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"role":"article","title":"EntityStore","kind":"article","url":"\/documentation\/swidux\/entitystoreguide","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"role":"article","title":"SwiduxKillswitch Reference","kind":"article","url":"\/documentation\/swidux\/pluginkillswitchreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","type":"topic","abstract":[{"type":"text","text":"Public API surface for the "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}]},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"role":"article","title":"SwiduxPaywall Reference","kind":"article","url":"\/documentation\/swidux\/pluginpaywallreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic","abstract":[{"text":"API reference for the ","