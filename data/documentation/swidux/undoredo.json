{"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},"seeAlsoSections":[{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"generated":true,"anchor":"Reference"}],"abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":"."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":"’s "},{"code":"restore(from:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you don’t use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":", nothing changes. It’s fully opt-in."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Adding Undo to Your App","anchor":"Adding-Undo-to-Your-App"},{"level":3,"type":"heading","text":"1. Create the plugin","anchor":"1-Create-the-plugin"},{"inlineContent":[{"type":"text","text":"Pass declarative predicates to classify which actions are undoable and which coalesce:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"]},{"level":3,"type":"heading","text":"2. Register and pass to Store","anchor":"2-Register-and-pass-to-Store"},{"inlineContent":[{"type":"text","text":"Register the plugin with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"type":"text","text":" for lifecycle hooks, and pass it directly to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"type":"text","text":" for undo\/redo methods and "},{"code":"canUndo","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"canRedo","type":"codeVoice"},{"type":"text","text":" tracking:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"]},{"inlineContent":[{"code":"Store","type":"codeVoice"},{"type":"text","text":" handles the rest internally: snapshotting state before undoable actions, restoring via "},{"code":"applyRestore","type":"codeVoice"},{"type":"text","text":" on undo\/redo, draining persistence changes, and updating "},{"code":"canUndo","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"canRedo","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"type":"heading","text":"3. Wire platform UI","anchor":"3-Wire-platform-UI"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS"}]},{"type":"text","text":" — replace the Edit menu:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS"}]},{"type":"text","text":" — bridge the system UndoManager for shake-to-undo:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"]},{"inlineContent":[{"code":"Store","type":"codeVoice"},{"type":"text","text":" automatically registers undo\/redo actions with the "},{"code":"UndoManager","type":"codeVoice"},{"type":"text","text":" after each undoable dispatch."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Coalescing","anchor":"Coalescing"},{"inlineContent":[{"type":"text","text":"The "},{"code":"coalescing","type":"codeVoice"},{"type":"text","text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Memory","anchor":"Memory"},{"inlineContent":[{"type":"text","text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use "},{"code":"maxDepth","type":"codeVoice"},{"type":"text","text":" to bound memory for large state:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"]}]}],"variants":[{"paths":["\/documentation\/swidux\/undoredo"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article","title":"Undo \/ Redo"},"references":{"doc://Swidux/documentation/Swidux/Store":{"abstract":[{"text":"Generic store that owns the dispatch cycle, plugin lifecycle, and","type":"text"},{"text":" ","type":"text"},{"text":"observation layer.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Store"}],"title":"Store","navigatorTitle":[{"kind":"identifier","text":"Store"}],"role":"symbol","kind":"symbol","url":"\/documentation\/swidux\/store"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","url":"\/documentation\/swidux\/pluginanalyticsreference","type":"topic","title":"SwiduxAnalytics Reference","role":"article","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" li