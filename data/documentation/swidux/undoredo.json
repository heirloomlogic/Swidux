{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"restore(from:)"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you don’t use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":", nothing changes. It’s fully opt-in."}]},{"type":"heading","text":"Adding Undo to Your App","level":2,"anchor":"Adding-Undo-to-Your-App"},{"type":"heading","text":"1. Create the plugin","level":3,"anchor":"1-Create-the-plugin"},{"type":"paragraph","inlineContent":[{"text":"Pass declarative predicates to classify which actions are undoable and which coalesce:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"]},{"type":"heading","text":"2. Register and pass to Store","level":3,"anchor":"2-Register-and-pass-to-Store"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register the plugin with "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference","isActive":true},{"type":"text","text":" for lifecycle hooks, and pass it directly to "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference","isActive":true},{"type":"text","text":" for undo\/redo methods and "},{"type":"codeVoice","code":"canUndo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"canRedo"},{"type":"text","text":" tracking:"}]},{"code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"Store"},{"text":" handles the rest internally: snapshotting state before undoable actions, restoring via ","type":"text"},{"type":"codeVoice","code":"applyRestore"},{"text":" on undo\/redo, draining persistence changes, and updating ","type":"text"},{"type":"codeVoice","code":"canUndo"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"canRedo"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"3. Wire platform UI","type":"heading","anchor":"3-Wire-platform-UI"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS"}]},{"type":"text","text":" — replace the Edit menu:"}],"type":"paragraph"},{"code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"iOS","type":"text"}]},{"text":" — bridge the system UndoManager for shake-to-undo:","type":"text"}]},{"type":"codeListing","code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"text":" automatically registers undo\/redo actions with the ","type":"text"},{"type":"codeVoice","code":"UndoManager"},{"text":" after each undoable dispatch.","type":"text"}]},{"type":"heading","level":2,"anchor":"Coalescing","text":"Coalescing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"coalescing"},{"type":"text","text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five."}]},{"type":"heading","level":2,"anchor":"Undo-and-sync","text":"Undo and sync"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Undo is scoped to changes the local user made. If another device deletes an entity and the merge surfaces that mid-session, "},{"code":"restore(from:)","type":"codeVoice"},{"type":"text","text":" will not bring the row back, even though older undo snapshots still contain it."}]},{"type":"paragraph","inlineContent":[{"text":"That has to be the rule, because the alternative is worse than a missing undo step: restoring the row records it as a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"creation"}]},{"text":", which syncs out and re-seeds every peer that had already agreed it was gone. One person’s undo would undo everybody’s delete.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":" tracks this in "},{"type":"codeVoice","code":"remotelyRemovedIDs"},{"type":"text","text":". An ID leaves the set the moment it becomes local again — the user creates it, or the row reappears on disk because the other device undid "},{"type":"emphasis","inlineContent":[{"type":"text","text":"its"}]},{"type":"text","text":" delete — so nothing is permanently un-undoable. See "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"reference","isActive":true},{"type":"text","text":" for the mechanics."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apps that don’t sync never hit this: nothing populates the set, and undo behaves exactly as it always has."}]},{"level":2,"anchor":"Memory","type":"heading","text":"Memory"},{"inlineContent":[{"text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use ","type":"text"},{"type":"codeVoice","code":"maxDepth"},{"text":" to bound memory for large state:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/undoredo"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference","generated":true,"title":"Reference"}],"metadata":{"roleHeading":"Article","role":"article","title":"Undo \/ Redo","modules":[{"name":"Swidux"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},"abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":"."}],"references":{"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"type":"topic","url":"\/documentation\/swidux\/entitystoreguide","kind":"article","role":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"title":"EntityStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},"doc://Swidux/documentation/Swidux/PluginHost":{"type":"topic","abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PluginHost"}],"role":"symbol","kind":"symbol","title":"PluginHost","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","url":"\/documentation\/swidux\/pluginhost","navigatorTitle":[{"kind":"identifier","text":"PluginHost"}]},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"type":"topic","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"role":"collectionGroup","title":"KeyValueStore","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","url":"\/documentation\/swidux\/keyvaluestoreguide"},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","url":"\/documentation\/swidux\/gettingstarted","kind":"article","role":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"title":"Getting Started with Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"role":"article","type":"topic","kind":"article","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","url":"\/documentation\/swidux\/persistencemiddlewareguide","title":"Persistence Middleware"},"doc://Swidux/documentation/Swidux":{"abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"url":"\/documentation\/swidux","kind":"symbol","role":"collection","type":"topic","title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"url":"\/documentation\/swidux\/troubleshooting","kind":"article","role":"article","type":"topic","title":"Troubleshooting","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","url":"\/documentation\/swidux\/pluginkillswitchreference","kind":"article","role":"article","type":"topic","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"title":"SwiduxKillswitch Reference"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"role":"article","type":"topic","kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","url":"\/documentation\/swidux\/pluginfeatureflagsreference","title":"SwiduxFeatureFlags Reference"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"type":"topic","abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"role":"symbol","kind":"symbol","title":"UndoPlugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","url":"\/documentation\/swidux\/undoplugin","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}]},"doc://Swidux/documentation/Swidux/EntityStore":{"type":"topic","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityStore"}],"role":"symbol","kind":"symbol","title":"EntityStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","url":"\/documentation\/swidux\/entitystore","navigatorTitle":[{"kind":"identifier","text":"EntityStore"}]},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"role":"article","type":"topic","kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — p