{"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference","title":"Reference"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/undoredo"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"restore(from:)"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you don’t use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference"},{"type":"text","text":", nothing changes. It’s fully opt-in."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Adding Undo to Your App","anchor":"Adding-Undo-to-Your-App"},{"level":3,"type":"heading","text":"1. Create the plugin","anchor":"1-Create-the-plugin"},{"inlineContent":[{"type":"text","text":"Pass declarative predicates to classify which actions are undoable and which coalesce:"}],"type":"paragraph"},{"code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"],"syntax":"swift","type":"codeListing"},{"text":"2. Register and pass to Store","anchor":"2-Register-and-pass-to-Store","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Register the plugin with "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference"},{"type":"text","text":" for lifecycle hooks, and pass it directly to "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference"},{"type":"text","text":" for undo\/redo methods and "},{"code":"canUndo","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"canRedo","type":"codeVoice"},{"text":" tracking:","type":"text"}],"type":"paragraph"},{"code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"Store","type":"codeVoice"},{"type":"text","text":" handles the rest internally: snapshotting state before undoable actions, restoring via "},{"code":"applyRestore","type":"codeVoice"},{"text":" on undo\/redo, draining persistence changes, and updating ","type":"text"},{"code":"canUndo","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"canRedo","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"3. Wire platform UI","anchor":"3-Wire-platform-UI","level":3,"type":"heading"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"macOS"}],"type":"strong"},{"text":" — replace the Edit menu:","type":"text"}],"type":"paragraph"},{"code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"iOS"}],"type":"strong"},{"text":" — bridge the system UndoManager for shake-to-undo:","type":"text"}],"type":"paragraph"},{"code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"Store","type":"codeVoice"},{"type":"text","text":" automatically registers undo\/redo actions with the "},{"code":"UndoManager","type":"codeVoice"},{"text":" after each undoable dispatch.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Coalescing","type":"heading","anchor":"Coalescing"},{"inlineContent":[{"type":"text","text":"The "},{"code":"coalescing","type":"codeVoice"},{"type":"text","text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five."}],"type":"paragraph"},{"level":2,"anchor":"Undo-and-sync","type":"heading","text":"Undo and sync"},{"inlineContent":[{"type":"text","text":"Undo is scoped to changes the local user made. If another device deletes an entity and the merge surfaces that mid-session, "},{"code":"restore(from:)","type":"codeVoice"},{"type":"text","text":" will not bring the row back, even though older undo snapshots still contain it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That has to be the rule, because the alternative is worse than a missing undo step: restoring the row records it as a "},{"inlineContent":[{"type":"text","text":"creation"}],"type":"strong"},{"type":"text","text":", which syncs out and re-seeds every peer that had already agreed it was gone. One person’s undo would undo everybody’s delete."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":" tracks this in "},{"code":"remotelyRemovedIDs","type":"codeVoice"},{"type":"text","text":". An ID leaves the set the moment it becomes local again — the user creates it, or the row reappears on disk because the other device undid "},{"inlineContent":[{"text":"its","type":"text"}],"type":"emphasis"},{"type":"text","text":" delete — so nothing is permanently un-undoable. See "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"reference"},{"type":"text","text":" for the mechanics."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Apps that don’t sync never hit this: nothing populates the set, and undo behaves exactly as it always has."}],"type":"paragraph"},{"level":2,"anchor":"Memory","type":"heading","text":"Memory"},{"inlineContent":[{"type":"text","text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use "},{"type":"codeVoice","code":"maxDepth"},{"type":"text","text":" to bound memory for large state:"}],"type":"paragraph"},{"code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"],"type":"codeListing","syntax":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},"metadata":{"title":"Undo \/ Redo","modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article"},"abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":".","type":"text"}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://Swidux/documentation/Swidux/GettingStarted":{"url":"\/documentation\/swidux\/gettingstarted","kind":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","title":"Getting Started with Swidux","role":"article"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"url":"\/documentation\/swidux\/pluginfeatureflagsreference","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","type":"topic","title":"SwiduxFeatureFlags Reference","role":"article"},"doc://Swidux/documentation/Swidux":{"role":"collection","url":"\/documentation\/swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","type":"topic","title":"Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}]},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"url":"\/documentation\/swidux\/keyvaluestoreguide","kind":"article","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"title":"KeyValueStore","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","role":"collectionGroup"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"url":"\/documentation\/swidux\/pluginpaywallreference","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic","title":"SwiduxPaywall Reference","role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"url":"\/documentation\/swidux\/undoplugin","kind":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"topic","title":"UndoPlugin","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"url":"\/documentation\/swidux\/pluginanalyticsreference","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","type":"topic","title":"SwiduxAnalytics Referen