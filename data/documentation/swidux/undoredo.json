{"variants":[{"paths":["\/documentation\/swidux\/undoredo"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"text":"’s ","type":"text"},{"code":"restore(from:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you don’t use "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference"},{"type":"text","text":", nothing changes. It’s fully opt-in."}],"type":"paragraph"},{"text":"Adding Undo to Your App","level":2,"type":"heading","anchor":"Adding-Undo-to-Your-App"},{"text":"1. Create the plugin","level":3,"type":"heading","anchor":"1-Create-the-plugin"},{"type":"paragraph","inlineContent":[{"text":"Pass declarative predicates to classify which actions are undoable and which coalesce:","type":"text"}]},{"type":"codeListing","code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"],"syntax":"swift"},{"anchor":"2-Register-and-pass-to-Store","text":"2. Register and pass to Store","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register the plugin with "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","isActive":true},{"text":" for lifecycle hooks, and pass it directly to ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","isActive":true},{"text":" for undo\/redo methods and ","type":"text"},{"type":"codeVoice","code":"canUndo"},{"text":"\/","type":"text"},{"code":"canRedo","type":"codeVoice"},{"text":" tracking:","type":"text"}]},{"type":"codeListing","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" handles the rest internally: snapshotting state before undoable actions, restoring via "},{"type":"codeVoice","code":"applyRestore"},{"text":" on undo\/redo, draining persistence changes, and updating ","type":"text"},{"type":"codeVoice","code":"canUndo"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"canRedo"},{"text":".","type":"text"}]},{"anchor":"3-Wire-platform-UI","text":"3. Wire platform UI","level":3,"type":"heading"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":" — replace the Edit menu:"}],"type":"paragraph"},{"syntax":"swift","code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS"}]},{"text":" — bridge the system UndoManager for shake-to-undo:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" automatically registers undo\/redo actions with the "},{"type":"codeVoice","code":"UndoManager"},{"type":"text","text":" after each undoable dispatch."}],"type":"paragraph"},{"anchor":"Coalescing","text":"Coalescing","level":2,"type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"coalescing","type":"codeVoice"},{"text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five.","type":"text"}],"type":"paragraph"},{"anchor":"Memory","text":"Memory","level":2,"type":"heading"},{"inlineContent":[{"text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use ","type":"text"},{"code":"maxDepth","type":"codeVoice"},{"text":" to bound memory for large state:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"],"type":"codeListing"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},"seeAlsoSections":[{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/S