{"kind":"article","seeAlsoSections":[{"generated":true,"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":"."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/undoredo"]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}],"title":"Undo \/ Redo"},"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":"’s "},{"code":"restore(from:)","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"If you don’t use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference"},{"text":", nothing changes. It’s fully opt-in.","type":"text"}]},{"level":2,"text":"Adding Undo to Your App","anchor":"Adding-Undo-to-Your-App","type":"heading"},{"type":"heading","anchor":"1-Create-the-plugin","level":3,"text":"1. Create the plugin"},{"inlineContent":[{"type":"text","text":"Pass declarative predicates to classify which actions are undoable and which coalesce:"}],"type":"paragraph"},{"type":"codeListing","code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"],"syntax":"swift"},{"type":"heading","text":"2. Register and pass to Store","anchor":"2-Register-and-pass-to-Store","level":3},{"type":"paragraph","inlineContent":[{"text":"Register the plugin with ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"text":" for lifecycle hooks, and pass it directly to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"type":"text","text":" for undo\/redo methods and "},{"type":"codeVoice","code":"canUndo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"canRedo"},{"type":"text","text":" tracking:"}]},{"syntax":"swift","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" handles the rest internally: snapshotting state before undoable actions, restoring via "},{"type":"codeVoice","code":"applyRestore"},{"type":"text","text":" on undo\/redo, draining persistence changes, and updating "},{"type":"codeVoice","code":"canUndo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"canRedo"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","anchor":"3-Wire-platform-UI","level":3,"text":"3. Wire platform UI"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":" — replace the Edit menu:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"iOS","type":"text"}]},{"type":"text","text":" — bridge the system UndoManager for shake-to-undo:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"]},{"inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" automatically registers undo\/redo actions with the "},{"type":"codeVoice","code":"UndoManager"},{"type":"text","text":" after each undoable dispatch."}],"type":"paragraph"},{"level":2,"text":"Coalescing","anchor":"Coalescing","type":"heading"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"coalescing"},{"type":"text","text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five."}],"type":"paragraph"},{"level":2,"text":"Undo and sync","anchor":"Undo-and-sync","type":"heading"},{"inlineContent":[{"type":"text","text":"Undo is scoped to changes the local user made. If another device deletes an entity and the merge surfaces that mid-session, "},{"type":"codeVoice","code":"restore(from:)"},{"type":"text","text":" will not bring the row back, even though older undo snapshots still contain it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That has to be the rule, because the alternative is worse than a missing undo step: restoring the row records it as a "},{"type":"strong","inlineContent":[{"text":"creation","type":"text"}]},{"type":"text","text":", which syncs out and re-seeds every peer that had already agreed it was gone. One person’s undo would undo everybody’s delete."}],"type":"paragraph"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" tracks this in "},{"type":"codeVoice","code":"remotelyRemovedIDs"},{"type":"text","text":". An ID leaves the set the moment it becomes local again — the user creates it, or the row reappears on disk because the other device undid "},{"type":"emphasis","inlineContent":[{"text":"its","type":"text"}]},{"type":"text","text":" delete — so nothing is permanently un-undoable. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},{"type":"text","text":" for the mechanics."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Apps that don’t sync never hit this: nothing populates the set, and undo behaves exactly as it always has."}],"type":"paragraph"},{"level":2,"text":"Memory","anchor":"Memory","type":"heading"},{"inlineContent":[{"type":"text","text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use "},{"type":"codeVoice","code":"maxDepth"},{"type":"text","text":" to bound memory for large state:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},"references":{"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","title":"SwiduxPaywall Reference","url":"\/documentation\/swidux\/pluginpaywallreference","type":"topic","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","title":"UndoPlugin","url":"\/documentation\/swidux\/undoplugin","type":"topic","abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/Store":{"navigatorTitle":[{"text":"Store","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","title":"Store","url":"\/documentation\/swidux\/store","type":"topic","abstract":[{"text":"Generic store that owns 