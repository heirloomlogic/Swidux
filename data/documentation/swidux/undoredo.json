{"seeAlsoSections":[{"anchor":"Reference","generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"restore(from:)"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you don’t use ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"text":", nothing changes. It’s fully opt-in.","type":"text"}],"type":"paragraph"},{"anchor":"Adding-Undo-to-Your-App","type":"heading","level":2,"text":"Adding Undo to Your App"},{"anchor":"1-Create-the-plugin","type":"heading","level":3,"text":"1. Create the plugin"},{"inlineContent":[{"type":"text","text":"Pass declarative predicates to classify which actions are undoable and which coalesce:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"]},{"anchor":"2-Register-and-pass-to-Store","type":"heading","level":3,"text":"2. Register and pass to Store"},{"type":"paragraph","inlineContent":[{"text":"Register the plugin with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference","isActive":true},{"type":"text","text":" for lifecycle hooks, and pass it directly to "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference","isActive":true},{"text":" for undo\/redo methods and ","type":"text"},{"code":"canUndo","type":"codeVoice"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"canRedo"},{"text":" tracking:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" handles the rest internally: snapshotting state before undoable actions, restoring via "},{"type":"codeVoice","code":"applyRestore"},{"type":"text","text":" on undo\/redo, draining persistence changes, and updating "},{"type":"codeVoice","code":"canUndo"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"canRedo"},{"text":".","type":"text"}]},{"anchor":"3-Wire-platform-UI","level":3,"type":"heading","text":"3. Wire platform UI"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"text":" — replace the Edit menu:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS"}]},{"text":" — bridge the system UndoManager for shake-to-undo:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"Store"},{"text":" automatically registers undo\/redo actions with the ","type":"text"},{"type":"codeVoice","code":"UndoManager"},{"text":" after each undoable dispatch.","type":"text"}],"type":"paragraph"},{"anchor":"Coalescing","level":2,"type":"heading","text":"Coalescing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"coalescing"},{"type":"text","text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five."}]},{"anchor":"Undo-and-sync","type":"heading","level":2,"text":"Undo and sync"},{"inlineContent":[{"type":"text","text":"Undo is scoped to changes the local user made. If another device deletes an entity and the merge surfaces that mid-session, "},{"code":"restore(from:)","type":"codeVoice"},{"type":"text","text":" will not bring the row back, even though older undo snapshots still contain it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That has to be the rule, because the alternative is worse than a missing undo step: restoring the row records it as a "},{"type":"strong","inlineContent":[{"text":"creation","type":"text"}]},{"type":"text","text":", which syncs out and re-seeds every peer that had already agreed it was gone. One person’s undo would undo everybody’s delete."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":" tracks this in "},{"code":"remotelyRemovedIDs","type":"codeVoice"},{"type":"text","text":". An ID leaves the set the moment it becomes local again — the user creates it, or the row reappears on disk because the other device undid "},{"type":"emphasis","inlineContent":[{"text":"its","type":"text"}]},{"type":"text","text":" delete — so nothing is permanently un-undoable. See "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"reference","isActive":true},{"type":"text","text":" for the mechanics."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Apps that don’t sync never hit this: nothing populates the set, and undo behaves exactly as it always has."}],"type":"paragraph"},{"anchor":"Memory","type":"heading","level":2,"text":"Memory"},{"inlineContent":[{"type":"text","text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use "},{"code":"maxDepth","type":"codeVoice"},{"type":"text","text":" to bound memory for large state:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"]}]}],"abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"type":"text","text":"."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"paths":["\/documentation\/swidux\/undoredo"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","metadata":{"modules":[{"name":"Swidux"}],"title":"Undo \/ Redo","roleHeading":"Article","role":"article"},"sections":[],"references":{"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"kind":"article","type":"topic","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"url":"\/documentation\/swidux\/persistencemiddlewareguide","role":"article","title":"Persistence Middleware","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","kind":"symbol","title":"UndoPlugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"url":"\/documentation\/swidux\/undoplugin","role":"symbol"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"kind":"article","type":"topic","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"url":"\/documentation\/swidux\/pluginpaywallreference","role