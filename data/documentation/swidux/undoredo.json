e":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","url":"\/documentation\/swidux\/pluginparentalgatereference","abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"kind":"article","role":"article","title":"SwiduxParentalGate Reference"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","url":"\/documentation\/swidux\/keyvaluestoreguide","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"kind":"article","role":"collectionGroup","title":"KeyValueStore"},"doc://Swidux/documentation/Swidux/PluginHost":{"kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PluginHost","kind":"identifier"}],"navigatorTitle":[{"text":"PluginHost","kind":"identifier"}],"abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","role":"symbol","url":"\/documentation\/swidux\/pluginhost","title":"PluginHost","type":"topic"},"doc://Swidux/documentation/Swidux/Store":{"url":"\/documentation\/swidux\/store","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"navigatorTitle":[{"text":"Store","kind":"identifier"}],"abstract":[{"text":"Generic store that owns the dispatch cycle, plugin lifecycle, and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"observation layer."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","role":"symbol","title":"Store","kind":"symbol","type":"topic"},"doc://Swidux/documentation/Swidux/MacrosReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","role":"article","url":"\/documentation\/swidux\/macrosreference","title":"Macros","type":"topic","abstract":[{"type":"text","text":"Reference for "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" and "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":" — the two macros that generate the observation bridge between value-type state and SwiftUI."}],"kind":"article"},"doc://Swidux/documentation/Swidux":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"kind":"symbol","role":"collection","title":"Swidux"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","url":"\/documentation\/swidux\/entitystoreguide","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"kind":"article","role":"article","title":"EntityStore"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","url":"\/documentation\/swidux\/pluginanalyticsreference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"kind":"article","role":"article","title":"SwiduxAnalytics Reference"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","url":"\/documentation\/swidux\/pluginkillswitchreference","abstract":[{"type":"text","text":"Public API surface for 