{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"type":"text","text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":"’s "},{"type":"codeVoice","code":"restore(from:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you don’t use "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"type":"text","text":", nothing changes. It’s fully opt-in."}],"type":"paragraph"},{"text":"Adding Undo to Your App","type":"heading","level":2,"anchor":"Adding-Undo-to-Your-App"},{"text":"1. Create the plugin","type":"heading","level":3,"anchor":"1-Create-the-plugin"},{"inlineContent":[{"type":"text","text":"Pass declarative predicates to classify which actions are undoable and which coalesce:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"]},{"text":"2. Register and pass to Store","type":"heading","level":3,"anchor":"2-Register-and-pass-to-Store"},{"inlineContent":[{"type":"text","text":"Register the plugin with "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference","isActive":true},{"type":"text","text":" for lifecycle hooks, and pass it directly to "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference","isActive":true},{"type":"text","text":" for undo\/redo methods and "},{"type":"codeVoice","code":"canUndo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"canRedo"},{"type":"text","text":" tracking:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"text":" handles the rest internally: snapshotting state before undoable actions, restoring via ","type":"text"},{"type":"codeVoice","code":"applyRestore"},{"text":" on undo\/redo, draining persistence changes, and updating ","type":"text"},{"type":"codeVoice","code":"canUndo"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"canRedo"},{"text":".","type":"text"}]},{"type":"heading","text":"3. Wire platform UI","level":3,"anchor":"3-Wire-platform-UI"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"strong"},{"text":" — replace the Edit menu:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS"}]},{"type":"text","text":" — bridge the system UndoManager for shake-to-undo:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"text":" automatically registers undo\/redo actions with the ","type":"text"},{"type":"codeVoice","code":"UndoManager"},{"type":"text","text":" after each undoable dispatch."}]},{"type":"heading","level":2,"text":"Coalescing","anchor":"Coalescing"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"coalescing"},{"text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five.","type":"text"}],"type":"paragraph"},{"text":"Undo and sync","type":"heading","level":2,"anchor":"Undo-and-sync"},{"inlineContent":[{"text":"Undo is scoped to changes the local user made. If another device deletes an entity and the merge surfaces that mid-session, ","type":"text"},{"type":"codeVoice","code":"restore(from:)"},{"text":" will not bring the row back, even though older undo snapshots still contain it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"That has to be the rule, because the alternative is worse than a missing undo step: restoring the row records it as a ","type":"text"},{"inlineContent":[{"text":"creation","type":"text"}],"type":"strong"},{"text":", which syncs out and re-seeds every peer that had already agreed it was gone. One person’s undo would undo everybody’s delete.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":" tracks this in ","type":"text"},{"type":"codeVoice","code":"remotelyRemovedIDs"},{"type":"text","text":". An ID leaves the set the moment it becomes local again — the user creates it, or the row reappears on disk because the other device undid "},{"type":"emphasis","inlineContent":[{"type":"text","text":"its"}]},{"type":"text","text":" delete — so nothing is permanently un-undoable. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},{"type":"text","text":" for the mechanics."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apps that don’t sync never hit this: nothing populates the set, and undo behaves exactly as it always has."}]},{"level":2,"text":"Memory","type":"heading","anchor":"Memory"},{"inlineContent":[{"type":"text","text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use "},{"type":"codeVoice","code":"maxDepth"},{"type":"text","text":" to bound memory for large state:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"modules":[{"name":"Swidux"}],"title":"Undo \/ Redo","role":"article","roleHeading":"Article"},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference","title":"Reference","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/undoredo"]}],"sections":[],"kind":"article","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"type":"text","text":"."}],"references":{"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"url":"\/documentation\/swidux","title":"Swidux","type":"topic"},"doc://Swidux/documentation/Swidux/GettingStarted":{"kind":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"role":"article","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","url":"\/documentation\/swidux\/troubleshooting","title":"Troubleshooting"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","kind":"article","role":"article","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"url":"\/documentation\/swidux\/pluginkillswitchreference","title":"SwiduxKillswitch Reference","type":"topic"},"doc://Swidux/documentation/Swidux/Store":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"type":"topic","url":"\/documentation\/swidux\/store","abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"type":"text","text":"observation layer."}],"title":"Store","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"Store","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"url":"\/documentation\/swidux\/entitystoreguide","title":"EntityStore","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","role":"article","url":"\/documentation\/swidux\/pluginfeatureflagsreference","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"title":"SwiduxFeatureFlags Reference","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"kind":"article","url":"\/documentation\/swidux\/keyvaluestoreguide","title":"KeyValueStore","role":"collectionGroup","type":"topic","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"},"doc://Swidux/documentation/Swidux/MacrosReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","type":"topic","url":"\/documentation\/swidux\/macrosreference","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":")."}],"title":"Macros","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PluginHost":{"title":"PluginHost","url":"\/documentation\/swidux\/pluginhost","role":"symbol","abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}],"kind":"symbol","navigatorTitle":[{"text":"PluginHost","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PluginHost","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},"doc://Swidux/documentation/Swidux/EntityStore":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}],"type":"topic","url":"\/documentation\/swidux\/entitystore","abstract":[{"type":"text","text":"An ordered, keyed collection of identifiable entities that silently records"},{"type":"text","text":" "},{"type":"text","text":"every mutation for downstream persistence."}],"title":"EntityStore","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"EntityStore","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","kind":"article","role":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"url":"\/documentation\/swidux\/pluginanalyticsreference","title":"SwiduxAnalytics Reference","type":"topic"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"type":"topic","url":"\/documentation\/swidux\/undoplugin","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"title":"UndoPlugin","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","kind":"article","role":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"url":"\/documentation\/swidux\/pluginpaywallreference","title":"SwiduxPaywall Reference","type":"topic"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"url":"\/documentation\/swidux\/persistencemiddlewareguide","title":"Persistence Middleware","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","kind":"article","role":"article","abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"url":"\/documentation\/swidux\/pluginparentalgatereference","title":"SwiduxParentalGate Reference","type":"topic"}}}