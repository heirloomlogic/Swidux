for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"role":"article","kind":"article","title":"SwiduxParentalGate Reference","url":"\/documentation\/swidux\/pluginparentalgatereference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},"doc://Swidux/documentation/Swidux/MacrosReference":{"abstract":[{"text":"Reference for ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" and its property markers (the SwiftData persistence bridge, shipped in ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":").","type":"text"}],"role":"article","kind":"article","title":"Macros","url":"\/documentation\/swidux\/macrosreference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"},"doc://Swidux/documentation/Swidux":{"abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"role":"collection","title":"Swidux","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","url":"\/documentation\/swidux"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"role":"article","kind":"article","title":"SwiduxPaywall Reference","url":"\/documentation\/swidux\/pluginpaywallreference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallRefer