{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"seeAlsoSections":[{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true,"anchor":"Reference"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":"’s ","type":"text"},{"code":"restore(from:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If you don’t use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":", nothing changes. It’s fully opt-in.","type":"text"}]},{"type":"heading","anchor":"Adding-Undo-to-Your-App","level":2,"text":"Adding Undo to Your App"},{"type":"heading","anchor":"1-Create-the-plugin","level":3,"text":"1. Create the plugin"},{"type":"paragraph","inlineContent":[{"text":"Pass declarative predicates to classify which actions are undoable and which coalesce:","type":"text"}]},{"type":"codeListing","code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"],"syntax":"swift"},{"type":"heading","anchor":"2-Register-and-pass-to-Store","level":3,"text":"2. Register and pass to Store"},{"type":"paragraph","inlineContent":[{"text":"Register the plugin with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"text":" for lifecycle hooks, and pass it directly to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"text":" for undo\/redo methods and ","type":"text"},{"code":"canUndo","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"canRedo","type":"codeVoice"},{"text":" tracking:","type":"text"}]},{"type":"codeListing","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" handles the rest internally: snapshotting state before undoable actions, restoring via ","type":"text"},{"code":"applyRestore","type":"codeVoice"},{"text":" on undo\/redo, draining persistence changes, and updating ","type":"text"},{"code":"canUndo","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"canRedo","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","anchor":"3-Wire-platform-UI","level":3,"text":"3. Wire platform UI"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"strong"},{"text":" — replace the Edit menu:","type":"text"}]},{"type":"codeListing","code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"iOS","type":"text"}],"type":"strong"},{"text":" — bridge the system UndoManager for shake-to-undo:","type":"text"}]},{"type":"codeListing","code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" automatically registers undo\/redo actions with the ","type":"text"},{"code":"UndoManager","type":"codeVoice"},{"text":" after each undoable dispatch.","type":"text"}]},{"type":"heading","anchor":"Coalescing","level":2,"text":"Coalescing"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"coalescing","type":"codeVoice"},{"text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five.","type":"text"}]},{"type":"heading","anchor":"Memory","level":2,"text":"Memory"},{"type":"paragraph","inlineCon