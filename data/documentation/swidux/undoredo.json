{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"generated":true,"anchor":"Undo--Redo","title":"Undo \/ Redo","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"]}],"variants":[{"paths":["\/documentation\/swidux\/undoredo"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":".","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"restore(from:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you don’t use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":", nothing changes. It’s fully opt-in."}]},{"text":"Adding Undo to Your App","type":"heading","level":2,"anchor":"Adding-Undo-to-Your-App"},{"text":"1. Create the middleware","type":"heading","level":3,"anchor":"1-Create-the-middleware"},{"syntax":"swift","type":"codeListing","code":["private let undoPlugin = UndoPlugin<AppState, AppAction>()             \/\/ unlimited depth","private let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50) \/\/ or capped"]},{"text":"2. Classify actions","type":"heading","level":3,"anchor":"2-Classify-actions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Decide which actions are undoable and which coalesce (grouping rapid calls like per-keystroke text edits into one undo step):"}]},{"syntax":"swift","type":"codeListing","code":["extension AppAction {","    var isUndoable: Bool {","        switch self {","        case .items(.create), .items(.delete), .items(.rename): true","        case .selectItem, .toggleSidebar: false","        }","    }","","    var isCoalescing: Bool {","        switch self {","        case .items(.rename): true","        default: false","        }","    }","}"]},{"text":"3. Snapshot in send()","type":"heading","level":3,"anchor":"3-Snapshot-in-send"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"willReduce"},{"type":"text","text":" before the reducer runs:"}]},{"syntax":"swift","type":"codeListing","code":["func send(_ action: AppAction) {","    let current = AppState(items: items, tags: tags, ui: ui)","    if action.isUndoable {","        undoPlugin.willReduce(state: current, coalescing: action.isCoalescing)","    }","    var state = current","    \/\/ ... reducer, persistence, assign-back as normal","}"]},{"text":"4. Add undo\/redo methods","type":"heading","level":3,"anchor":"4-Add-undoredo-methods"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"restore(from:)"},{"type":"text","text":" so changes flow through persistence:"}]},{"syntax":"swift","type":"codeListing","code":["func undo() {","    let current = AppState(items: items, tags: tags, ui: ui)","    guard let restored = undoPlugin.undo(current: current) else { return }","    applySnapshot(restored)","}","","func redo() {","    let current = AppState(items: items, tags: tags, ui: ui)","    guard let restored = undoPlugin.redo(current: current) else { return }","    applySnapshot(restored)","}","","private func applySnapshot(_ restored: AppState) {","    var state = AppState(items: items, tags: tags, ui: ui)","    state.items.restore(from: restored.items)  \/\/ records diff for persistence","    state.tags.restore(from: restored.tags)","    state.ui = restored.ui                     \/\/ plain state — assign directly","    persistence.afterReduce(state: &state)","    items = state.items","    tags = state.tags","    ui = state.ui","}"]},{"text":"5. Expose canUndo \/ canRedo","type":"heading","level":3,"anchor":"5-Expose-canUndo--canRedo"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Expose these as observable properties. Call "},{"type":"codeVoice","code":"syncUndoState()"},{"type":"text","text":" after every "},{"type":"codeVoice","code":"send()"},{"type":"text","text":", "},{"type":"codeVoice","code":"undo()"},{"type":"text","text":", and "},{"type":"codeVoice","code":"redo()"},{"type":"text","text":"."}]},{"text":"6. Wire platform UI","type":"heading","level":3,"anchor":"6-Wire-platform-UI"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"macOS"}]},{"type":"text","text":" — replace the Edit menu:"}]},{"syntax":"swift","type":"codeListing","code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS"}]},{"type":"text","text":" — bridge the system UndoManager for shake-to-undo:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ In AppStore:","weak var undoManager: UndoManager?","\/\/ Register after undoable send():  undoManager?.registerUndo(withTarget: self) { $0.undo() }","\/\/ Register after undo():           undoManager?.registerUndo(withTarget: self) { $0.redo() }","\/\/ Register after redo():           undoManager?.registerUndo(withTarget: self) { $0.undo() }","","\/\/ In view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"]},{"text":"Coalescing","type":"heading","level":2,"anchor":"Coalescing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"willReduce(coalescing: true)"},{"type":"text","text":" pushes on the first call, then skips subsequent consecutive coalescing calls — they share the original snapshot. A non-coalescing call or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five."}]},{"text":"Memory","type":"heading","level":2,"anchor":"Memory"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each snapshot is a value-type copy of "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":". Cost is proportional to the number of entities across all stores. Use "},{"type":"codeVoice","code":"maxDepth"},{"type":"text","text":" to bound memory for large state."}]}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","interfaceLanguage":"swift"},"kind":"article","sections":[],"metadata":{"modules":[{"name":"Swidux"}],"title":"Undo \/ Redo","roleHeading":"Article","role":"article"},"references":{"doc://Swidux/documentation/Swidux/UndoPlugin":{"title":"UndoPlugin","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"type":"topic","abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","url":"\/documentation\/swidux\/undoplugin","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux":{"title":"Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI with built-in persistence."}],"role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","url":"\/documentation\/swidux","type":"topic"},"doc://Swidux/documentation/Swidux/EntityStore":{"title":"EntityStore","navigatorTitle":[{"kind":"identifier","text":"EntityStore"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityStore"}],"type":"topic","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","url":"\/documentation\/swidux\/entitystore","kind":"symbol","role":"symbol"}}}