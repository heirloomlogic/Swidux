","url":"\/documentation\/swidux\/entitystoreguide","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","role":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}]},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","title":"Persistence Middleware","url":"\/documentation\/swidux\/persistencemiddlewareguide","role":"article","kind":"article","type":"topic","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"kind":"article","url":"\/documentation\/swidux\/pluginpaywallreference","type":"topic","title":"SwiduxPaywall Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/Store":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","url":"\/documentation\/swidux\/store","navigatorTitle":[{"kind":"identifier","text":"Store"}],"role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Store"}],"title":"Store","abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"text":"observation layer.","type":"text"}]},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"type":"topic","title":"KeyValueStore","url":"\/documentation\/swidux\/keyvaluestoreguide","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","role":"collectionGroup","abstract":[{"text":"Persi