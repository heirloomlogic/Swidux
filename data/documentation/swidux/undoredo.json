{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/swidux\/undoredo"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","title":"Undo \/ Redo","modules":[{"name":"Swidux"}],"role":"article"},"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"generated":true,"title":"Reference","anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":".","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":"’s "},{"code":"restore(from:)","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you don’t use "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":", nothing changes. It’s fully opt-in."}]},{"level":2,"text":"Adding Undo to Your App","type":"heading","anchor":"Adding-Undo-to-Your-App"},{"level":3,"text":"1. Create the plugin","type":"heading","anchor":"1-Create-the-plugin"},{"type":"paragraph","inlineContent":[{"text":"Pass declarative predicates to classify which actions are undoable and which coalesce:","type":"text"}]},{"syntax":"swift","code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"],"type":"codeListing"},{"text":"2. Register and pass to Store","type":"heading","level":3,"anchor":"2-Register-and-pass-to-Store"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register the plugin with "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference","isActive":true},{"type":"text","text":" for lifecycle hooks, and pass it directly to "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference","isActive":true},{"type":"text","text":" for undo\/redo methods and "},{"type":"codeVoice","code":"canUndo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"canRedo"},{"text":" tracking:","type":"text"}]},{"syntax":"swift","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"text":" handles the rest internally: snapshotting state before undoable actions, restoring via ","type":"text"},{"type":"codeVoice","code":"applyRestore"},{"text":" on undo\/redo, draining persistence changes, and updating ","type":"text"},{"type":"codeVoice","code":"canUndo"},{"type":"text","text":"\/"},{"code":"canRedo","type":"codeVoice"},{"type":"text","text":"."}]},{"text":"3. Wire platform UI","type":"heading","level":3,"anchor":"3-Wire-platform-UI"},{"inlineContent":[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"strong"},{"text":" — replace the Edit menu:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"iOS","type":"text"}]},{"text":" — bridge the system UndoManager for shake-to-undo:","type":"text"}]},{"code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"text":" automatically registers undo\/redo actions with the ","type":"text"},{"type":"codeVoice","code":"UndoManager"},{"text":" after each undoable dispatch.","type":"text"}]},{"level":2,"type":"heading","text":"Coalescing","anchor":"Coalescing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"coalescing"},{"text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five.","type":"text"}]},{"level":2,"text":"Memory","type":"heading","anchor":"Memory"},{"type":"paragraph","inlineContent":[{"text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use ","type":"text"},{"code":"maxDepth","type":"codeVoice"},{"text":" to bound memory for large state:","type":"text"}]},{"code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","url":"\/documentation\/swidux\/undoplugin","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"kind":"symbol","title":"UndoPlugin","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}],"type":"topic","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}]},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","url":"\/documentation\/swidux\/persistencemiddlewareguide","kind":"article","role":"article","title":"Persistence Middleware","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","url":"\/documentation\/swidux\/pluginkillswitchreference","role":"article","kind":"article","title":"SwiduxKillswitch Reference","type":"topic","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}]},"doc://Swidux/documentation/Swidux/PluginHost":{"url":"\/documentation\/swidux\/pluginhost","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PluginHost","kind":"identifier"}],"kind":"symbol","title":"PluginHost","navigatorTitle":[{"text":"PluginHost","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}]},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"url":"\/documentation\/swidux\/pluginparentalgatereference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","role":"article","kind":"article","title":"SwiduxParentalGate Reference","type":"topic","abstract":[{"type":"text","text":"API surface for the "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","url":"\/documentation\/swidux\/gettingstarted","title":"Getting Started with Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","kind":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","url":"\/documentation\/