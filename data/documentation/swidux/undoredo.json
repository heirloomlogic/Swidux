{"seeAlsoSections":[{"title":"Reference","anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"generated":true}],"metadata":{"role":"article","roleHeading":"Article","title":"Undo \/ Redo","modules":[{"name":"Swidux"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":"’s ","type":"text"},{"code":"restore(from:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"If you don’t use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":", nothing changes. It’s fully opt-in.","type":"text"}],"type":"paragraph"},{"anchor":"Adding-Undo-to-Your-App","level":2,"type":"heading","text":"Adding Undo to Your App"},{"anchor":"1-Create-the-plugin","level":3,"type":"heading","text":"1. Create the plugin"},{"inlineContent":[{"type":"text","text":"Pass declarative predicates to classify which actions are undoable and which coalesce:"}],"type":"paragraph"},{"code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"],"type":"codeListing","syntax":"swift"},{"text":"2. Register and pass to Store","anchor":"2-Register-and-pass-to-Store","type":"heading","level":3},{"inlineContent":[{"text":"Register the plugin with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference"},{"text":" for lifecycle hooks, and pass it directly to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference"},{"text":" for undo\/redo methods and ","type":"text"},{"code":"canUndo","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"canRedo","type":"codeVoice"},{"text":" tracking:","type":"text"}],"type":"paragraph"},{"code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" handles the rest internally: snapshotting state before undoable actions, restoring via ","type":"text"},{"code":"applyRestore","type":"codeVoice"},{"text":" on undo\/redo, draining persistence changes, and updating ","type":"text"},{"code":"canUndo","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"canRedo","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"3. Wire platform UI","anchor":"3-Wire-platform-UI","type":"heading","level":3},{"inlineContent":[{"inlineContent":[{"type":"text","text":"macOS"}],"type":"strong"},{"text":" — replace the Edit menu:","type":"text"}],"type":"paragraph"},{"code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"iOS"}],"type":"strong"},{"text":" — bridge the system UndoManager for shake-to-undo:","type":"text"}],"type":"paragraph"},{"code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" automatically registers undo\/redo actions with the ","type":"text"},{"code":"UndoManager","type":"codeVoice"},{"text":" after each undoable dispatch.","type":"text"}],"type":"paragraph"},{"text":"Coalescing","anchor":"Coalescing","type":"heading","level":2},{"inlineContent":[{"text":"The ","type":"text"},{"code":"coalescing","type":"codeVoice"},{"text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five.","type":"text"}],"type":"paragraph"},{"text":"Undo and sync","anchor":"Undo-and-sync","type":"heading","level":2},{"inlineContent":[{"text":"Undo is scoped to changes the local user made. If another device deletes an entity and the merge surfaces that mid-session, ","type":"text"},{"code":"restore(from:)","type":"codeVoice"},{"text":" will not bring the row back, even though older undo snapshots still contain it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"That has to be the rule, because the alternative is worse than a missing undo step: restoring the row records it as a ","type":"text"},{"inlineContent":[{"type":"text","text":"creation"}],"type":"strong"},{"text":", which syncs out and re-seeds every peer that had already agreed it was gone. One person’s undo would undo everybody’s delete.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":" tracks this in ","type":"text"},{"code":"remotelyRemovedIDs","type":"codeVoice"},{"text":". An ID leaves the set the moment it becomes local again — the user creates it, or the row reappears on disk because the other device undid ","type":"text"},{"inlineContent":[{"type":"text","text":"its"}],"type":"emphasis"},{"text":" delete — so nothing is permanently un-undoable. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"reference"},{"text":" for the mechanics.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Apps that don’t sync never hit this: nothing populates the set, and undo behaves exactly as it always has.","type":"text"}],"type":"paragraph"},{"text":"Memory","anchor":"Memory","type":"heading","level":2},{"inlineContent":[{"text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use ","type":"text"},{"code":"maxDepth","type":"codeVoice"},{"text":" to bound memory for large state:","type":"text"}],"type":"paragraph"},{"code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},"kind":"article","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/undoredo"]}],"references":{"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"title":"EntityStore","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"url":"\/documentation\/swidux\/entitystoreguide","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/EntityStore":{"title":"EntityStore","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}],"navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"url":"\/documentation\/swidux\/entitystore","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux/GettingStarted":{"title":"Getting Started with Swidux","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type"