{"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/undoredo"]}],"metadata":{"roleHeading":"Article","title":"Undo \/ Redo","role":"article","modules":[{"name":"Swidux"}]},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"restore(from:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you don’t use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":", nothing changes. It’s fully opt-in."}]},{"level":2,"type":"heading","text":"Adding Undo to Your App","anchor":"Adding-Undo-to-Your-App"},{"level":3,"type":"heading","text":"1. Create the plugin","anchor":"1-Create-the-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass declarative predicates to classify which actions are undoable and which coalesce:"}]},{"syntax":"swift","type":"codeListing","code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"]},{"level":3,"type":"heading","text":"2. Register and pass to Store","anchor":"2-Register-and-pass-to-Store"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register the plugin with "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference","isActive":true},{"type":"text","text":" for lifecycle hooks, and pass it directly to "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference","isActive":true},{"type":"text","text":" for undo\/redo methods and "},{"type":"codeVoice","code":"canUndo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"canRedo"},{"type":"text","text":" tracking:"}]},{"code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" handles the rest internally: snapshotting state before undoable actions, restoring via "},{"type":"codeVoice","code":"applyRestore"},{"type":"text","text":" on undo\/redo, draining persistence changes, and updating "},{"type":"codeVoice","code":"canUndo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"canRedo"},{"type":"text","text":"."}]},{"type":"heading","level":3,"anchor":"3-Wire-platform-UI","text":"3. Wire platform UI"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":" — replace the Edit menu:"}]},{"code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"iOS","type":"text"}]},{"text":" — bridge the system UndoManager for shake-to-undo:","type":"text"}]},{"code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" automatically registers undo\/redo actions with the "},{"type":"codeVoice","code":"UndoManager"},{"type":"text","text":" after each undoable dispatch."}]},{"type":"heading","level":2,"anchor":"Coalescing","text":"Coalescing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"coalescing"},{"type":"text","text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five."}]},{"type":"heading","level":2,"anchor":"Memory","text":"Memory"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use "},{"type":"codeVoice","code":"maxDepth"},{"type":"text","text":" to bound memory for large state:"}]},{"code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"],"type":"codeListing","syntax":"swift"}],"kind":"content"}],"abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":".","type":"text"}],"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"anchor":"Reference","title":"Reference","generated":true}],"references":{"doc://Swidux/documentation/Swidux/EntityStore":{"url":"\/documentation\/swidux\/entitystore","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}],"type":"topic","role":"symbol","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"kind":"symbol","title":"EntityStore","navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","role":"article","url":"\/documentation\/swidux\/persistencemiddlewareguide","type":"topic","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"title":"Persistence Midd