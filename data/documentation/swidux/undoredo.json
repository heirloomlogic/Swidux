{"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":".","type":"text"}],"seeAlsoSections":[{"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"restore(from:)"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If you don’t use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":", nothing changes. It’s fully opt-in.","type":"text"}]},{"level":2,"anchor":"Adding-Undo-to-Your-App","type":"heading","text":"Adding Undo to Your App"},{"level":3,"anchor":"1-Create-the-plugin","type":"heading","text":"1. Create the plugin"},{"type":"paragraph","inlineContent":[{"text":"Pass declarative predicates to classify which actions are undoable and which coalesce:","type":"text"}]},{"code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"2-Register-and-pass-to-Store","type":"heading","text":"2. Register and pass to Store"},{"type":"paragraph","inlineContent":[{"text":"Register the plugin with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"text":" for lifecycle hooks, and pass it directly to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"text":" for undo\/redo methods and ","type":"text"},{"type":"codeVoice","code":"canUndo"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"canRedo"},{"text":" tracking:","type":"text"}]},{"code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"text":" handles the rest internally: snapshotting state before undoable actions, restoring via ","type":"text"},{"type":"codeVoice","code":"applyRestore"},{"text":" on undo\/redo, draining persistence changes, and updating ","type":"text"},{"type":"codeVoice","code":"canUndo"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"canRedo"},{"text":".","type":"text"}]},{"level":3,"anchor":"3-Wire-platform-UI","type":"heading","text":"3. Wire platform UI"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"strong"},{"text":" — replace the Edit menu:","type":"text"}]},{"code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"iOS","type":"text"}],"type":"strong"},{"text":" — bridge the system UndoManager for shake-to-undo:","type":"text"}]},{"code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"text":" automatically registers undo\/redo actions with the ","type":"text"},{"type":"codeVoice","code":"UndoManager"},{"text":" after each undoable dispatch.","type":"text"}]},{"level":2,"anchor":"Coalescing","type":"heading","text":"Coalescing"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"coalescing"},{"text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five.","type":"text"}]},{"level":2,"anchor":"Undo-and-sync","type":"heading","text":"Undo and sync"},{"type":"paragraph","inlineContent":[{"text":"Undo is scoped to changes the local user made. If another device deletes an entity and the merge surfaces that mid-session, ","type":"text"},{"type":"codeVoice","code":"restore(from:)"},{"text":" will not bring the row back, even though older undo snapshots still contain it.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"That has to be the rule, because the alternative is worse than a missing undo step: restoring the row records it as a ","type":"text"},{"inlineContent":[{"text":"creation","type":"text"}],"type":"strong"},{"text":", which syncs out and re-seeds every peer that had already agreed it was gone. One person’s undo would undo everybody’s delete.","type":"text"}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" tracks this in ","type":"text"},{"type":"codeVoice","code":"remotelyRemovedIDs"},{"text":". An ID leaves the set the moment it becomes local again — the user creates it, or the row reappears on disk because the other device undid ","type":"text"},{"inlineContent":[{"text":"its","type":"text"}],"type":"emphasis"},{"text":" delete — so nothing is permanently un-undoable. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},{"text":" for the mechanics.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Apps that don’t sync never hit this: nothing populates the set, and undo behaves exactly as it always has.","type":"text"}]},{"level":2,"anchor":"Memory","type":"heading","text":"Memory"},{"type":"paragraph","inlineContent":[{"text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use ","type":"text"},{"type":"codeVoice","code":"maxDepth"},{"text":" to bound memory for large state:","type":"text"}]},{"code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"],"type":"codeListing","syntax":"swift"}]}],"variants":[{"paths":["\/documentation\/swidux\/undoredo"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","role":"article","title":"Undo \/ Redo","modules":[{"name":"Swidux"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},"sections":[],"references":{"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","url":"\/documentation\/swidux\/pluginpaywallreference","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"title":"SwiduxPaywall Reference"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"role":"article","kind":"article","title":"SwiduxFeatureFlags Reference","url":"\/documentation\/swidux\/pluginfeatureflagsreference"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"fragment