{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":"’s ","type":"text"},{"code":"restore(from:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you don’t use ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":", nothing changes. It’s fully opt-in.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Adding Undo to Your App","anchor":"Adding-Undo-to-Your-App"},{"level":3,"type":"heading","text":"1. Create the plugin","anchor":"1-Create-the-plugin"},{"inlineContent":[{"text":"Pass declarative predicates to classify which actions are undoable and which coalesce:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"]},{"level":3,"type":"heading","text":"2. Register and pass to Store","anchor":"2-Register-and-pass-to-Store"},{"inlineContent":[{"text":"Register the plugin with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","isActive":true,"type":"reference"},{"text":" for lifecycle hooks, and pass it directly to ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","isActive":true,"type":"reference"},{"text":" for undo\/redo methods and ","type":"text"},{"code":"canUndo","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"canRedo","type":"codeVoice"},{"text":" tracking:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"]},{"inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" handles the rest internally: snapshotting state before undoable actions, restoring via ","type":"text"},{"code":"applyRestore","type":"codeVoice"},{"text":" on undo\/redo, draining persistence changes, and updating ","type":"text"},{"code":"canUndo","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"canRedo","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"3. Wire platform UI","anchor":"3-Wire-platform-UI"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"macOS"}],"type":"strong"},{"text":" — replace the Edit menu:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"iOS"}],"type":"strong"},{"text":" — bridge the system UndoManager for shake-to-undo:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"]},{"inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" automatically registers undo\/redo actions with the ","type":"text"},{"code":"UndoManager","type":"codeVoice"},{"text":" after each undoable dispatch.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Coalescing","anchor":"Coalescing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"coalescing","type":"codeVoice"},{"text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Memory","anchor":"Memory"},{"inlineContent":[{"text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use ","type":"text"},{"code":"maxDepth","type":"codeVoice"},{"text":" to bound memory for large state:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"]}]}],"sections":[],"seeAlsoSections":[{"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swi