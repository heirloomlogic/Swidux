{"metadata":{"role":"article","roleHeading":"Article","title":"Undo \/ Redo","modules":[{"name":"Swidux"}]},"abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"text":".","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"paths":["\/documentation\/swidux\/undoredo"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},"kind":"article","seeAlsoSections":[{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"generated":true,"anchor":"Reference"}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"type":"text","text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"type":"text","text":"’s "},{"code":"restore(from:)","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you don’t use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":", nothing changes. It’s fully opt-in."}]},{"type":"heading","text":"Adding Undo to Your App","anchor":"Adding-Undo-to-Your-App","level":2},{"type":"heading","text":"1. Create the plugin","anchor":"1-Create-the-plugin","level":3},{"type":"paragraph","inlineContent":[{"text":"Pass declarative predicates to classify which actions are undoable and which coalesce:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"]},{"type":"heading","text":"2. Register and pass to Store","anchor":"2-Register-and-pass-to-Store","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Register the plugin with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"type":"text","text":" for lifecycle hooks, and pass it directly to "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference","isActive":true},{"type":"text","text":" for undo\/redo methods and "},{"code":"canUndo","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"canRedo","type":"codeVoice"},{"type":"text","text":" tracking:"}]},{"type":"codeListing","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"Store","type":"codeVoice"},{"type":"text","text":" handles the rest internally: snapshotting state before undoable actions, restoring via "},{"code":"applyRestore","type":"codeVoice"},{"type":"text","text":" on undo\/redo, draining persistence changes, and updating "},{"code":"canUndo","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"canRedo","type":"codeVoice"},{"type":"text","text":"."}]},{"level":3,"text":"3. Wire platform UI","type":"heading","anchor":"3-Wire-platform-UI"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":" — replace the Edit menu:"}]},{"type":"codeListing","code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS"}]},{"type":"text","text":" — bridge the system UndoManager for shake-to-undo:"}]},{"type":"codeListing","code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" automatically registers undo\/redo actions with the "},{"type":"codeVoice","code":"UndoManager"},{"type":"text","text":" after each undoable dispatch."}]},{"level":2,"text":"Coalescing","type":"heading","anchor":"Coalescing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"coalescing"},{"type":"text","text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five."}]},{"text":"Memory","anchor":"Memory","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use "},{"type":"codeVoice","code":"maxDepth"},{"type":"text","text":" to bound memory for large state:"}],"type":"paragraph"},{"syntax":"swift","code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"],"type":"codeListing"}],"kind":"content"}],"sections":[],"references":{"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"title":"KeyValueStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","url":"\/documentation\/swidux\/keyvaluestoreguide","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"type":"topic","kind":"article","role":"collectionGroup"},"doc://Swidux/documentation/Swidux/EntityStore":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"topic","title":"EntityStore","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"EntityStore","kind":"identifier"}],"navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/swidux\/entitystore","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"te