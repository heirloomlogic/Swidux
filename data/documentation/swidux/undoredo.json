x\/entitystore","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"role":"symbol","title":"EntityStore","type":"topic","kind":"symbol","navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"role":"article","kind":"article","title":"Persistence Middleware","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","url":"\/documentation\/swidux\/persistencemiddlewareguide"},"doc://Swidux/documentation/Swidux/PluginHost":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PluginHost","kind":"identifier"}],"url":"\/documentation\/swidux\/pluginhost","abstract":[{"text":"Ordered registry of plugins that drives the dispatch lifecycle.","type":"text"}],"role":"symbol","title":"PluginHost","type":"topic","kind":"symbol","navigatorTitle":[{"text":"PluginHost","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"url":"\/documentation\/swidux\/entitystoreguide","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","title":"EntityStore","role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"url":"\/documentation\/swidux\/undoplugin","kind":"symbol","type":"topic","abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","title":"UndoPlugin","role":"symbol"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"url":"\/documentation\/swidux\/keyvaluestoreguide","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","title":"KeyValueStore","role":"collectionGroup"}}}