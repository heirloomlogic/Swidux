{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":"."}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true,"title":"Reference","anchor":"Reference"}],"kind":"article","identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article","title":"Undo \/ Redo"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference"},{"type":"text","text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"restore(from:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you don’t use "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference"},{"type":"text","text":", nothing changes. It’s fully opt-in."}]},{"level":2,"type":"heading","text":"Adding Undo to Your App","anchor":"Adding-Undo-to-Your-App"},{"text":"1. Create the plugin","type":"heading","level":3,"anchor":"1-Create-the-plugin"},{"type":"paragraph","inlineContent":[{"text":"Pass declarative predicates to classify which actions are undoable and which coalesce:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"]},{"level":3,"type":"heading","anchor":"2-Register-and-pass-to-Store","text":"2. Register and pass to Store"},{"type":"paragraph","inlineContent":[{"text":"Register the plugin with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","isActive":true,"type":"reference"},{"text":" for lifecycle hooks, and pass it directly to ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","isActive":true,"type":"reference"},{"text":" for undo\/redo methods and ","type":"text"},{"type":"codeVoice","code":"canUndo"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"canRedo"},{"text":" tracking:","type":"text"}]},{"syntax":"swift","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" handles the rest internally: snapshotting state before undoable actions, restoring via ","type":"text"},{"code":"applyRestore","type":"codeVoice"},{"text":" on undo\/redo, draining persistence changes, and updating ","type":"text"},{"code":"canUndo","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"canRedo","type":"codeVoice"},{"text":".","type":"text"}]},{"level":3,"type":"heading","anchor":"3-Wire-platform-UI","text":"3. Wire platform UI"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"macOS","type":"text"}]},{"type":"text","text":" — replace the Edit menu:"}]},{"type":"codeListing","syntax":"swift","code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"iOS","type":"text"}],"type":"strong"},{"type":"text","text":" — bridge the system UndoManager for shake-to-undo:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"]},{"inlineContent":[{"type":"codeVoice","code":"Store"},{"type":"text","text":" automatically registers undo\/redo actions with the "},{"type":"codeVoice","code":"UndoManager"},{"type":"text","text":" after each undoable dispatch."}],"type":"paragraph"},{"anchor":"Coalescing","type":"heading","level":2,"text":"Coalescing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"coalescing"},{"type":"text","text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five."}],"type":"paragraph"},{"anchor":"Memory","type":"heading","level":2,"text":"Memory"},{"inlineContent":[{"type":"text","text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use "},{"type":"codeVoice","code":"maxDepth"},{"type":"text","text":" to bound memory for large state:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"]}]}],"variants":[{"paths":["\/documentation\/swidux\/undoredo"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"references":{"doc://Swidux/documentation/Swidux/Store":{"type":"topic","kind":"symbol","abstract":[{"text":"Generic store that owns the dispatch cycle, plugin lifecycle, and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"observation layer."}],"title":"Store","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"url":"\/documentation\/swidux\/store","navigatorTitle":[{"text":"Store","kind":"identifier"}]},"doc://Swidux/documentation/Swidux":{"kind":"symbol","type":"topic","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","url":"\/documentation\/swidux"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"kind":"article","type":"topic","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"title":"EntityStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","role":"article","url":"\/documentation\/swidux\/entitystoreguide"},"doc://Swidux/documentation/Swidux/PluginHost":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}],"title":"PluginHost","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PluginHost"}],"url":"\/documentation\/swidux\/pluginhost","navigatorTitle":[{"kind":"identifier","text":"PluginHost"}]},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"url":"\/documentation\/swidux\/pluginfeatureflagsreference","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","type":"topic","role":"article","title":"SwiduxFeatureFlags Reference"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"title":"UndoPlugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"url":"\/documentation\/swidux\/undoplugin","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/EntityStore":{"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"An ordered, keyed collection of identifiable entities that silently records"},{"type":"text","text":" "},{"type":"text","text":"every mutation for downstream persistence."}],"title":"EntityStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}],"url":"\/documentation\/swidux\/entitystore","navigatorTitle":[{"kind":"identifier","text":"EntityStore"}]},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"url":"\/documentation\/swidux\/pluginpaywallreference","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic","role":"article","title":"SwiduxPaywall Reference"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"kind":"article","type":"topic","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"title":"Persistence Middleware","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","role":"article","url":"\/documentation\/swidux\/persistencemiddlewareguide"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"kind":"article","type":"topic","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"title":"SwiduxAnalytics Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","role":"article","url":"\/documentation\/swidux\/pluginanalyticsreference"},"doc://Swidux/documentation/Swidux/MacrosReference":{"kind":"article","type":"topic","abstract":[{"text":"Reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" — the two macros that generate the observation bridge between value-type state and SwiftUI.","type":"text"}],"title":"Macros","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","role":"article","url":"\/documentation\/swidux\/macrosreference"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"abstract":[{"type":"text","text":"API surface for the "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"url":"\/documentation\/swidux\/pluginparentalgatereference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","kind":"article","type":"topic","role":"article","title":"SwiduxParentalGate Reference"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"kind":"article","type":"topic","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"title":"KeyValueStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","role":"collectionGroup","url":"\/documentation\/swidux\/keyvaluestoreguide"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"kind":"article","type":"topic","abstract":[{"text":"Public API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"title":"SwiduxKillswitch Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","role":"article","url":"\/documentation\/swidux\/pluginkillswitchreference"},"doc://Swidux/documentation/Swidux/GettingStarted":{"abstract":[{"text":"Add Swidux to your project and wire up unidirectiona