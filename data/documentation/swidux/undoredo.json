{"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference","generated":true,"anchor":"Reference"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":"’s "},{"code":"restore(from:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you don’t use ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"text":", nothing changes. It’s fully opt-in.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Adding-Undo-to-Your-App","text":"Adding Undo to Your App","type":"heading"},{"level":3,"anchor":"1-Create-the-plugin","text":"1. Create the plugin","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass declarative predicates to classify which actions are undoable and which coalesce:"}]},{"type":"codeListing","syntax":"swift","code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"]},{"anchor":"2-Register-and-pass-to-Store","text":"2. Register and pass to Store","level":3,"type":"heading"},{"inlineContent":[{"text":"Register the plugin with ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","isActive":true},{"type":"text","text":" for lifecycle hooks, and pass it directly to "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","isActive":true},{"type":"text","text":" for undo\/redo methods and "},{"code":"canUndo","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"canRedo","type":"codeVoice"},{"type":"text","text":" tracking:"}],"type":"paragraph"},{"code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"Store","type":"codeVoice"},{"type":"text","text":" handles the rest internally: snapshotting state before undoable actions, restoring via "},{"code":"applyRestore","type":"codeVoice"},{"type":"text","text":" on undo\/redo, draining persistence changes, and updating "},{"code":"canUndo","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"canRedo","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"3. Wire platform UI","level":3,"type":"heading","anchor":"3-Wire-platform-UI"},{"inlineContent":[{"inlineContent":[{"text":"macOS","type":"text"}],"type":"strong"},{"text":" — replace the Edit menu:","type":"text"}],"type":"paragraph"},{"code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"inlineContent":[{"text":"iOS","type":"text"}],"type":"strong"},{"type":"text","text":" — bridge the system UndoManager for shake-to-undo:"}],"type":"paragraph"},{"code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" automatically registers undo\/redo actions with the ","type":"text"},{"type":"codeVoice","code":"UndoManager"},{"text":" after each undoable dispatch.","type":"text"}],"type":"paragraph"},{"text":"Coalescing","anchor":"Coalescing","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"coalescing"},{"type":"text","text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five."}],"type":"paragraph"},{"text":"Memory","anchor":"Memory","type":"heading","level":2},{"inlineContent":[{"text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use ","type":"text"},{"type":"codeVoice","code":"maxDepth"},{"text":" to bound memory for large state:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"],"syntax":"swift"}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/undoredo"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"title":"Undo \/ Redo","modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article"},"abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"type":"text","text":"."}],"references":{"doc://Swidux/documentation/Swidux/MacrosReference":{"url":"\/documentation\/swidux\/macrosreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","kind":"article","type":"topic","title":"Macros","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":")."}],"role":"article"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"url":"\/documentation\/swidux\/pluginanalyticsreference","kind":"article","title":"SwiduxAnalytics Reference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\