{"abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":".","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/undoredo"]}],"sections":[],"seeAlsoSections":[{"generated":true,"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference"}],"kind":"article","identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference"},{"type":"text","text":" captures state snapshots before each undoable action. Undo history lives in memory (lost on relaunch), but restored state is persisted normally via "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"restore(from:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you don’t use "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference"},{"type":"text","text":", nothing changes. It’s fully opt-in."}],"type":"paragraph"},{"text":"Adding Undo to Your App","anchor":"Adding-Undo-to-Your-App","level":2,"type":"heading"},{"text":"1. Create the plugin","anchor":"1-Create-the-plugin","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Pass declarative predicates to classify which actions are undoable and which coalesce:"}],"type":"paragraph"},{"syntax":"swift","code":["let isUndoable: @Sendable (AppAction) -> Bool = { action in","    switch action {","    case .items(.create), .items(.delete), .items(.rename): true","    case .selectItem, .toggleSidebar: false","    }","}","","let undoPlugin = UndoPlugin<AppState, AppAction>(","    isUndoable: isUndoable,","    coalescing: { action in","        if case .items(.rename) = action { return true }","        return false","    }",")"],"type":"codeListing"},{"level":3,"text":"2. Register and pass to Store","anchor":"2-Register-and-pass-to-Store","type":"heading"},{"inlineContent":[{"text":"Register the plugin with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","isActive":true,"type":"reference"},{"text":" for lifecycle hooks, and pass it directly to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"type":"text","text":" for undo\/redo methods and "},{"type":"codeVoice","code":"canUndo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"canRedo"},{"type":"text","text":" tracking:"}],"type":"paragraph"},{"code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","","return Store(","    initialState: AppState(),","    reducer: { state, action in","        reducer.reduce(state: &state, action: action, environment: environment)","    },","    plugins: plugins,","    undoPlugin: undoPlugin,","    persistencePlugin: persistencePlugin,","    isUndoable: isUndoable",")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" handles the rest internally: snapshotting state before undoable actions, restoring via ","type":"text"},{"code":"applyRestore","type":"codeVoice"},{"text":" on undo\/redo, draining persistence changes, and updating ","type":"text"},{"code":"canUndo","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"canRedo","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"3. Wire platform UI","type":"heading","level":3,"anchor":"3-Wire-platform-UI"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"macOS"}],"type":"strong"},{"text":" — replace the Edit menu:","type":"text"}]},{"type":"codeListing","code":["WindowGroup { ... }",".commands {","    CommandGroup(replacing: .undoRedo) {","        Button(\"Undo\") { store.undo() }","            .keyboardShortcut(\"z\", modifiers: .command)","            .disabled(!store.canUndo)","        Button(\"Redo\") { store.redo() }","            .keyboardShortcut(\"z\", modifiers: [.command, .shift])","            .disabled(!store.canRedo)","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"iOS"}],"type":"strong"},{"type":"text","text":" — bridge the system UndoManager for shake-to-undo:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ In your view — connect the environment UndoManager:",".onAppear { store.undoManager = undoManager }",".onChange(of: undoManager) { _, new in store.undoManager = new }"]},{"inlineContent":[{"code":"Store","type":"codeVoice"},{"text":" automatically registers undo\/redo actions with the ","type":"text"},{"code":"UndoManager","type":"codeVoice"},{"text":" after each undoable dispatch.","type":"text"}],"type":"paragraph"},{"text":"Coalescing","type":"heading","level":2,"anchor":"Coalescing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"coalescing","type":"codeVoice"},{"text":" predicate groups consecutive matching actions into a single undo step. The first coalescing action captures a snapshot; subsequent consecutive coalescing actions share that snapshot. A non-coalescing action or undo\/redo resets the flag. Typing “hello” produces one undo entry, not five.","type":"text"}]},{"text":"Memory","type":"heading","level":2,"anchor":"Memory"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each snapshot is a value-type copy of your state. Cost is proportional to the number of entities across all stores. Use "},{"type":"codeVoice","code":"maxDepth"},{"type":"text","text":" to bound memory for large state:"}]},{"type":"codeListing","code":["let undoPlugin = UndoPlugin<AppState, AppAction>(maxDepth: 50, ...)"],"syntax":"swift"}]}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","title":"Undo \/ Redo","roleHeading":"Article"},"references":{"doc://Swidux/documentation/Swidux/Troubleshooting":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","title":"Troubleshooting","role":"article","abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"url":"\/documentation\/swidux\/troubleshooting"},"doc://Swidux/documentation/Swidux/GettingStarted":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","role":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"url":"\/documentation\/swidux\/gettingstarted","kind":"article","type":"topic","title":"Getting Started with Swidux"},"doc://Swidux/documentation/Swidux/MacrosReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","role":"article","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":")."}],"url":"\/documentation\/swidux\/macrosreference","kind":"article","type":"topic","title":"Macros"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/swidux","title":"Swidux"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","role":"article","type":"topic","url":"\/documentation\/swidux\/pluginanalyticsreference","title":"SwiduxAnalytics Reference"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","role":"article","abstract":[{"type":"text","text":"Public API surface for the "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"type":"topic","url":"\/documentation\/swidux\/pluginkillswitchreference","kind":"article","title":"SwiduxKillswitch Reference"},"doc://Swidux/documentation/Swidux/EntityStore":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","role":"symbol","abstract":[{"type":"text","text":"An ordered, keyed collection of identifiable entities that silently records"},{"type":"text","text":" "},{"type":"text","text":"every mutation for downstream persistence."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}],"type":"topic","url":"\/documentation\/swidux\/entitystore","kind":"symbol","title":"EntityStore","navigatorTitle":[{"text":"EntityStore","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/Store":{"kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"abstract":[{"text":"Generic store that owns the dispatch cycle, plugin lifecycle, and","type":"text"},{"text":" ","type":"text"},{"text":"observation layer.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","role":"symbol","type":"topic","title":"Store","url":"\/documentation\/swidux\/store","navigatorTitle":[{"text":"Store","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","title":"SwiduxPaywall Reference","role":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"url":"\/documentation\/swidux\/pluginpaywallreference"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","role":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"url":"\/documentation\/swidux\/entitystoreguide","kind":"article","type":"topic","title":"EntityStore"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","title":"SwiduxParentalGate Reference","role":"article","abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"url":"\/documentation\/swidux\/pluginparentalgatereference"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","role":"article","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"url":"\/documentation\/swidux\/persistencemiddlewareguide","kind":"article","type":"topic","title":"Persistence Middleware"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","title":"SwiduxFeatureFlags Reference","role":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"url":"\/documentation\/swidux\/pluginfeatureflagsreference"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"UndoPlugin","kind":"identifier"}],"abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","role":"symbol","url":"\/documentation\/swidux\/undoplugin","title":"UndoPlugin","type":"topic","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}]},"doc://Swidux/documentation/Swidux