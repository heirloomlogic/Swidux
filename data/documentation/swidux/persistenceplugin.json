ouch the same entity again. Running out of attempts is","type":"text"},{"text":" ","type":"text"},{"text":"reported through the writer rather than passing in silence, and the batch","type":"text"},{"text":" ","type":"text"},{"text":"stays pending so a later edit or an explicit ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin\/flush()","type":"reference"},{"text":" tries once more.","type":"text"}],"type":"paragraph"},{"text":"Wiring","anchor":"Wiring","level":2,"type":"heading"},{"code":["let persistence = PersistencePlugin<AppState, AppAction>(","    writers: [","        StateWriter(keyPath: \\.decks) { writes, deletes in ... },","        StateWriter(keyPath: \\.cards) { writes, deletes in ... },","    ],","    debounce: .milliseconds(250)",")","plugins.register(persistence)"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"metadata":{"externalID":"s:6Swidux17PersistencePluginC","symbolKind":"class","title":"PersistencePlugin","roleHeading":"Class","modules":[{"name":"Swidux"}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistencePlugin","kind":"identifier"}],"navigatorTitle":[{"text":"PersistencePlugin","kind":"identifier"}]},"variants":[{"paths":["\/documentation\/swidux\/persistenceplugin"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"url":"\/documentation\/swidux\/architectureguide","abstract":[{"type":"text","text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system."}],"type":"topic","title":"Architecture & Performance","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","role":"article"},"doc://Swidux/documentation/Swidux/BuildingYourFirstApp":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingYourFirstApp",