"type":"text"},{"text":"are cleared at flush time, so the write would only ever reach storage if the","type":"text"},{"text":" ","type":"text"},{"text":"user happened to touch the same entity again. Running out of attempts is","type":"text"},{"text":" ","type":"text"},{"text":"reported through the writer rather than passing in silence, and the batch","type":"text"},{"text":" ","type":"text"},{"text":"stays pending so a later edit or an explicit ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin\/flush()","type":"reference","isActive":true},{"text":" tries once more.","type":"text"}],"type":"paragraph"},{"text":"Wiring","type":"heading","level":2,"anchor":"Wiring"},{"type":"codeListing","code":["let persistence = PersistencePlugin<AppState, AppAction>(","    writers: [","        StateWriter(keyPath: \\.decks) { writes, deletes in ... },","        StateWriter(keyPath: \\.cards) { writes, deletes in ... },","    ],","    debounce: .milliseconds(250)",")","plugins.register(persistence)"],"syntax":"swift"}],"kind":"content"}],"references":{"doc://Swidux/s8SendableP":{"identifier":"doc:\/\/Swidux\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"title":"Add Persistence","type":"topic","kind":"article","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","url":"\/documentation\/swidux\/howtoaddpersistence","role":"article"},"doc://Swidux/documentation/Swidux/PersistencePlugin/afterReduce(state:action:)":{"abstra