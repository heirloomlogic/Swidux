{"abstract":[{"text":"Coalescing persistence plugin.","type":"text"}],"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin\/init(writers:debounce:retry:loopThreshold:logger:onLoopSuspected:)"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin\/afterReduce(state:action:)","doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin\/drainAndScheduleFlush(_:)","doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin\/flush()"]},{"title":"Default Implementations","generated":true,"anchor":"Default-Implementations","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin\/SwiduxPlugin-Implementations"]}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","doc:\/\/Swidux\/s8SendableP","doc:\/\/Swidux\/s16SendableMetatypeP"],"type":"conformsTo"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"paths":["\/documentation\/swidux\/persistenceplugin"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},"metadata":{"externalID":"s:6Swidux17PersistencePluginC","role":"symbol","modules":[{"name":"Swidux"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistencePlugin","kind":"identifier"}],"navigatorTitle":[{"text":"PersistencePlugin","kind":"identifier"}],"roleHeading":"Class","symbolKind":"class","title":"PersistencePlugin"},"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"title":"Persistence & Undo","generated":true,"anchor":"Persistence--Undo","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/StateWriter","doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistencePlugin","kind":"identifier"},{"text":"<","kind":"text"},{"text":"State","kind":"genericParameter"},{"text":", ","kind":"text"},{"text":"Action","kind":"genericParameter"},{"text":">","kind":"text"}],"languages":["swift"]}]},{"kind":"mentions","mentions":["doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","doc:\/\/Swidux\/documentation\/Swidux\/BuildingYourFirstApp","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence"]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"After each reducer call, drains "},{"type":"codeVoice","code":"ChangeSet"},{"type":"text","text":"s from registered "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"into "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" buffers. Restarts a debounce timer on each drain. When the"},{"type":"text","text":" "},{"type":"text","text":"timer fires, flushes all pending writes in a single "},{"type":"codeVoice","code":"Task"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A flush whose save fails is retried on a doubling backoff, bounded by"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy"},{"type":"text","text":". Without that a failed save is silent data loss: the buffers"},{"type":"text","text":" "},{"type":"text","text":"are cleared at flush time, so the write would only ever reach storage if the"},{"text":" ","type":"text"},{"text":"user happened to touch the same entity again. Running out of attempts is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"reported through the writer rather than passing in silence, and the batch"},{"text":" ","type":"text"},{"type":"text","text":"stays pending so a later edit or an explicit "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin\/flush()","type":"reference","isActive":true},{"type":"text","text":" tries once more."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Wiring","text":"Wiring"},{"type":"codeListing","syntax":"swift","code":["let persistence = PersistencePlugin<AppState, AppAction>(","    writers: [","        StateWriter(keyPath: \\.decks) { writes, deletes in ... },","        StateWriter(keyPath: \\.cards) { writes, deletes in ... },","    ],","    debounce: .milliseconds(250)",")","plugins.register(persistence)"]}]}],"references":{"doc://Swidux/documentation/Swidux/PersistencePlugin/drainAndScheduleFlush(_:)":{"abstract":[{"type":"text","text":"Drains ChangeSets and schedules a debounced flush."}],"type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"drainAndScheduleFlush","kind":"identifier"},{"text":"(","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin\/drainAndScheduleFlush(_:)","url":"\/documentation\/swidux\/persistenceplugin\/drainandscheduleflush(_:)","title":"drainAndScheduleFlush(_:)"},"doc://Swidux/documentation/Swidux/PersistencePlugin/SwiduxPlugin-Implementations":{"abstract":[],"type":"topic","role":"collectionGroup","kind":"article","identifier":"doc:\/\/Swid