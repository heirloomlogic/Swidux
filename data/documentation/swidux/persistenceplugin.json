":"into ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" buffers. Restarts a debounce timer on each drain. When the","type":"text"},{"text":" ","type":"text"},{"text":"timer fires, flushes all pending writes in a single ","type":"text"},{"code":"Task","type":"codeVoice"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"A flush whose save fails is retried on a doubling backoff, bounded by","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy","isActive":true,"type":"reference"},{"text":". Without that a failed save is silent data loss: the buffers","type":"text"},{"text":" ","type":"text"},{"text":"are cleared at flush time, so the write would only ever reach storage if the","type":"text"},{"text":" ","type":"text"},{"text":"user happened to touch the same entity again. Running out of attempts is","type":"text"},{"text":" ","type":"text"},{"text":"reported through the writer rather than passing in silence, and the batch","type":"text"},{"text":" ","type":"text"},{"text":"stays pending so a later edit or an explicit ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin\/flush()","isActive":true,"type":"reference"},{"text":" tries once more.","type":"text"}],"type":"paragraph"},{"text":"Wiring","anchor":"Wiring","type":"heading","level":2},{"syntax":"swift","code":["let persistence = PersistencePlugin<AppState, AppAction>(","    writers: [","        StateWriter(keyPath: \\.decks) { writes, deletes in ... },","        StateWriter(keyPath: \\.cards) { writes, deletes in ... },","    ],","    debounce: .milliseconds(250)",")","plugins.register(persistence)"],"type":"codeListing"}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin\/init(writers:debounce:retry:loopThreshold:logger:onLoopSuspected:)"],"anchor":"