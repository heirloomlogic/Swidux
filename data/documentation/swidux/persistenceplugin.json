tes in a single "},{"type":"codeVoice","code":"Task"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A flush whose save fails is retried on a doubling backoff, bounded by"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy","isActive":true},{"type":"text","text":". Without that a failed save is silent data loss: the buffers"},{"type":"text","text":" "},{"type":"text","text":"are cleared at flush time, so the write would only ever reach storage if the"},{"type":"text","text":" "},{"type":"text","text":"user happened to touch the same entity again. Running out of attempts is"},{"type":"text","text":" "},{"type":"text","text":"reported through the writer rather than passing in silence, and the batch"},{"type":"text","text":" "},{"type":"text","text":"stays pending so a later edit or an explicit "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin\/flush()","isActive":true},{"type":"text","text":" tries once more."}]},{"type":"heading","anchor":"Wiring","text":"Wiring","level":2},{"type":"codeListing","code":["let persistence = PersistencePlugin<AppState, AppAction>(","    writers: [","        StateWriter(keyPath: \\.decks) { writes, deletes in ... },","        StateWriter(keyPath: \\.cards) { writes, deletes in ... },","    ],","    debounce: .milliseconds(250)",")","plugins.register(persistence)"],"syntax":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin\/init(writers:debounce:retry:loopThreshold:logger:onLoopSuspected:)"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin\/afterReduce(state:action:)","doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin\/drainAndScheduleFlush(_:)","doc:\/\/