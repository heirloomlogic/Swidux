ng in silence, and the batch","type":"text"},{"text":" ","type":"text"},{"text":"stays pending so a later edit or an explicit ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin\/flush()","type":"reference"},{"text":" tries once more.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Wiring","anchor":"Wiring","type":"heading"},{"syntax":"swift","code":["let persistence = PersistencePlugin<AppState, AppAction>(","    writers: [","        StateWriter(keyPath: \\.decks) { writes, deletes in ... },","        StateWriter(keyPath: \\.cards) { writes, deletes in ... },","    ],","    debounce: .milliseconds(250)",")","plugins.register(persistence)"],"type":"codeListing"}]}],"kind":"symbol","relationshipsSections":[{"type":"conformsTo","title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","doc:\/\/Swidux\/s8SendableP","doc:\/\/Swidux\/s16SendableMetatypeP"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},"references":{"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","title":"Persistence Middleware","url":"\/documentation\/swidux\/persistencemiddlewareguide","type":"topic","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","title":"Add Persistence","url":"\/documentation\/swidux\/howtoaddpersistence","type":"topic","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","tex