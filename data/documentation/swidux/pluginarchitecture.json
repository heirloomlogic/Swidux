ux\/pluginhost","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PluginHost","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"PluginHost","kind":"identifier"}]},"doc://Swidux/documentation/Swidux":{"role":"collection","url":"\/documentation\/swidux","title":"Swidux","type":"topic","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}]},"doc://Swidux/documentation/Swidux/Store":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"abstract":[{"text":"Generic store that owns the dispatch cycle, plugin lifecycle, and","type":"text"},{"text":" ","type":"text"},{"text":"observation layer.","type":"text"}],"title":"Store","role":"symbol","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","url":"\/documentation\/swidux\/store","navigatorTitle":[{"text":"Store","kind":"identifier"}],"kind":"symbol"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"title":"Architecture & Performance","url":"\/documentation\/swidux\/architectureguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","type":"topic","role":"article","abstract":[{"text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system.","type":"text"}],"kind":"article"}}}