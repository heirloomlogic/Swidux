{"sections":[],"metadata":{"modules":[{"name":"Swidux"}],"title":"Plugin Architecture","role":"article","roleHeading":"Article"},"variants":[{"paths":["\/documentation\/swidux\/pluginarchitecture"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"],"title":"Explanation","anchor":"Explanation","generated":true}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Swidux’s plugin system is a single protocol (","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","isActive":true,"type":"reference"},{"text":") with four lifecycle hooks and an ordered registry (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"text":"). All store extensibility flows through this contract. The built-in ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":" use it, and so do domain-specific features like killswitch enforcement and paywall management."}]},{"level":2,"text":"The Dispatch Lifecycle","type":"heading","anchor":"The-Dispatch-Lifecycle"},{"inlineContent":[{"type":"text","text":"Every call to "},{"type":"codeVoice","code":"store.send()"},{"type":"text","text":" drives plugins through a four-phase lifecycle:"}],"type":"paragraph"},{"code":["plugins.willReduce(state:action:)      \/\/ 1. Pre-reduce (read-only state)","appReducer.reduce(state:action:...)    \/\/ 2. App reducer runs","pluginEffects = plugins.reduce(...)    \/\/ 3. Plugin reducers run","plugins.afterReduce(state:action:)     \/\/ 4. Post-reduce cleanup"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"The generic ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"text":" implements this lifecycle internally. You don’t write ","type":"text"},{"code":"send()","type":"codeVoice"},{"text":" by hand — ","type":"text"},{"code":"Store.send()","type":"codeVoice"},{"type":"text","text":" handles packing, reducing, plugin hooks, unpacking, and effect dispatch."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A fifth method, "},{"type":"codeVoice","code":"flush()"},{"text":", runs once at shutdown to drain async buffers.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"All four hooks have default no-op implementations. Each plugin overrides only what it needs.","type":"text"}]},{"text":"Core Middleware vs Domain Plugins","type":"heading","level":2,"anchor":"Core-Middleware-vs-Domain-Plugins"},{"inlineContent":[{"type":"text","text":"The plugin system serves two structurally different roles. Recognizing which one a plugin fills determines where it lives, which hooks it uses, and how it couples to the host app."}],"type":"paragraph"},{"type":"heading","anchor":"Core-Middleware","level":3,"text":"Core Middleware"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":" are ","type":"text"},{"inlineContent":[{"type":"text","text":"action-agnostic infrastructure"}],"type":"strong"},{"text":". They never inspect the ","type":"text"},{"code":"Action","type":"codeVoice"},{"text":" type, never dispatch actions, and never return effects. They couple only to the shape of state:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"type":"text","text":" needs keypaths to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" properties."}]}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":" needs ","type":"text"},{"code":"State: Equatable","type":"codeVoice"},{"type":"text","text":" so it can snapshot and compare."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Because they don’t touch actions, they work with any app that uses Swidux — no wiring required beyond construction.","type":"text"}]},{"text":"Domain Plugins","level":3,"anchor":"Domain-Plugins","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Killswitch, parental gate, and paywall plugins are ","type":"text"},{"inlineContent":[{"text":"domain-specific modules","type":"text"}],"type":"strong"},{"text":" that ship as separate library targets (","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":"). They own their own state slices and action enums, dispatch effects, and must be explicitly wired into the host app’s root types.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each domain plugin stores three wiring pieces:","type":"text"}]},{"code":["private let stateKeyPath: WritableKeyPath<RootState, FeatureState>","private let toRootAction: @Sendable (FeatureAction) -> RootAction","private let extractAction: @Sendable (RootAction) -> FeatureAction?"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The host app provides these at init — the plugin never assumes a specific root type.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Importing at call sites","anchor":"Importing-at-call-sites","type":"heading"},{"inlineContent":[{"text":"Because each domain plugin ships as a ","type":"text"},{"inlineContent":[{"type":"text","text":"separate library target"}],"type":"strong"},{"text":", its state and action types are defined in that module — not in ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":". A common convention is to re-export core Swidux from ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"@_exported import Swidux"},{"text":", but that re-exports ","type":"text"},{"inlineContent":[{"text":"core Swidux only","type":"text"}],"type":"strong"},{"type":"text","text":"; it does not re-export the plugin modules."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"So any file that reads a plugin-owned slice (","type":"text"},{"type":"codeVoice","code":"store.analytics.*"},{"text":", ","type":"text"},{"type":"codeVoice","code":"store.paywall.*"},{"text":", ","type":"text"},{"type":"codeVoice","code":"store.killswitch.*"},{"text":", …) or dispatches a plugin action (","type":"text"},{"type":"codeVoice","code":"AnalyticsAction"},{"text":", ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"text":", …) must import that plugin’s module in ","type":"text"},{"inlineContent":[{"text":"that","type":"text"}],"type":"strong"},{"text":" file:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"touches ","type":"text"},{"type":"codeVoice","code":"store.analytics.*"},{"text":" \/ ","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"text":" → ","type":"text"},{"type":"codeVoice","code":"import SwiduxAnalytics"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"touches ","type":"text"},{"type":"codeVoice","code":"store.paywall.*"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"PaywallAction"},{"text":" → ","type":"text"},{"type":"codeVoice","code":"import SwiduxPaywall"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"touches only ","type":"text"},{"type":"codeVoice","code":"store.ui"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":".ui(...)"},{"text":" (app-module types) → nothing extra","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The easy case to forget is a ","type":"text"},{"inlineContent":[{"text":"View","type":"text"}],"type":"strong"},{"text":" that reads the slice for display — ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AppAction.swift","type":"codeVoice"},{"text":" already import the module, but the View is a different file. Without the import you get:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["property 'isOptedOut' is not available due to missing import of defining module 'SwiduxAnalytics'","property 'isPro' is not available due to missing import of defining module 'SwiduxPaywall'"]},{"type":"paragraph","inlineContent":[{"text":"The fix is to add ","type":"text"},{"code":"import Swidux<Plugin>","type":"codeVoice"},{"text":" to that file.","type":"text"}]},{"type":"heading","anchor":"Comparison","level":3,"text":"Comparison"},{"type":"table","rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"text":"Core Middleware","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Domain Plugins","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"Action knowledge","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"None","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Full — extracts and lifts actions","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Lifecycle hooks","type":"text"}]}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"willReduce","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"afterReduce","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"reduce","type":"codeVoice"},{"text":" only","type":"text"}]}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Returns effects","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"State coupling","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"Keypath to ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" constraint","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Keypath to plugin’s own state slice","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"Wiring","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Construction only","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Keypath + action lifter + action extractor","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"Target","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Core ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":" library","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Separate library target","type":"text"}]}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Opt-in","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"Instantiate and register","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Add state, action case, and register","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"text":"The Decision Rule","level":2,"anchor":"The-Decision-Rule","type":"heading"},{"type":"aside","name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Does the middleware need to know your action type? If ","type":"text"},{"inlineContent":[{"text":"no","type":"text"}],"type":"strong"},{"text":", it’s core middleware — put it in ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":" and use ","type":"text"},{"code":"willReduce","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":". If ","type":"text"},{"inlineContent":[{"text":"yes","type":"text"}],"type":"strong"},{"text":", it’s a domain plugin — give it its own target and use ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":".","type":"text"}]}]},{"text":"Hook Selection Guide","level":2,"anchor":"Hook-Selection-Guide","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"willReduce(state:action:)"}],"type":"strong"},{"text":" — Capture state ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"text":" the reducer mutates it. State is read-only. Use for snapshots (undo) or pre-mutation analytics.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"reduce(state:action:) -> Effect?"}]},{"text":" — Handle domain-specific actions ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"after","type":"text"}]},{"text":" the app reducer. Mutate the plugin’s state slice and return effects. This is the only hook that can dispatch actions or do async work.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"afterReduce(state:action:)"}],"type":"strong"},{"text":" — Observe state ","type":"text"},{"inlineContent":[{"text":"after","type":"text"}],"type":"emphasis"},{"text":" all reducing is done. Use for persistence draining, logging, or metrics. Cannot return effects.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"flush() async"}]},{"text":" — Shutdown hook. Flush pending async buffers (persistence writes, analytics batches). Called once when the app exits.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Registration Order","type":"heading","anchor":"Registration-Order","level":2},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","isActive":true,"type":"reference"},{"text":" executes plugins in registration order. Recommended ordering:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)         \/\/ 1. Must snapshot before any mutation","plugins.register(persistencePlugin)  \/\/ 2. Drains changelogs after reducer","plugins.register(killswitchPlugin)   \/\/ 3. Domain plugins in any order","plugins.register(paywallPlugin)"],"syntax":"swift"},{"inlineContent":[{"text":"Undo must come first — it snapshots state in ","type":"text"},{"type":"codeVoice","code":"willReduce"},{"text":", before the app reducer or any plugin modifies it. Persistence typically comes next so its ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":" drain sees the final state. Domain plugins use only ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":", so their relative order rarely matters.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Service-Result Actions and Transition Observation","type":"heading","anchor":"Service-Result-Actions-and-Transition-Observation"},{"inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"text":"service-result action","type":"text"}],"type":"emphasis"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"PaywallPlugin"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"customerInfoUpdated"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"KillswitchPlugin"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"verdictReceived"},{"text":", ","type":"text"},{"type":"codeVoice","code":"FeatureFlagsPlugin"},{"text":"’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"refreshSucceeded"},{"text":" — fires on ","type":"text"},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"text":" fetch, refresh, or stream tick, not","type":"text"},{"text":" ","type":"text"},{"text":"only when the value changed, and unconditionally writes its payload to the","type":"text"},{"text":" ","type":"text"},{"text":"state slice. The payload is frequently identical to what is already there","type":"text"},{"text":" ","type":"text"},{"text":"(a re-delivered entitlement, an unchanged remote config).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Do ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" map analytics or side effects to the raw service-result action:","type":"text"},{"text":" ","type":"text"},{"text":"it fires duplicates by design. Observe the ","type":"text"},{"inlineContent":[{"type":"text","text":"state slice"}],"type":"strong"},{"text":" — or a value","type":"text"},{"text":" ","type":"text"},{"text":"derived from it — instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"State observation is already deduplicated by the framework. ","type":"text"},{"code":"Store.send","type":"codeVoice"},{"text":" ","type":"text"},{"text":"packs the observer into a value-type snapshot, lets reducers mutate the","type":"text"},{"text":" ","type":"text"},{"text":"snapshot, then writes back via ","type":"text"},{"code":"State.apply","type":"codeVoice"},{"text":". For a leaf slice that write","type":"text"},{"text":" ","type":"text"},{"text":"is a plain assignment whose ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" setter equality-gates ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" ","type":"text"},{"text":"values, so a slice whose value did not change emits no notification — and a","type":"text"},{"text":" ","type":"text"},{"text":"value-diffing consumer such as ","type":"text"},{"code":"AnalyticsIdentity.userProperties","type":"codeVoice"},{"text":" (which","type":"text"},{"text":" ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":" re-evaluates and diffs every non-analytics dispatch) sees exactly the","type":"text"},{"text":" ","type":"text"},{"text":"real transitions. This dedup is a property of the ","type":"text"},{"code":"Store","type":"codeVoice"},{"text":", not of any","type":"text"},{"text":" ","type":"text"},{"text":"per-plugin guard, so a no-op service-result cycle is silent to state","type":"text"},{"text":" ","type":"text"},{"text":"observers without any extra reducer logic.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Next Steps","type":"heading","anchor":"Next-Steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},{"type":"text","text":" — Step-by-step guide to creating a domain plugin"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},{"type":"text","text":" — Configure the built-in persistence middleware"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},{"type":"text","text":" — Add undo\/redo with the built-in undo middleware"}],"type":"paragraph"}]}]}]}],"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"references":{"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"kind":"article","role":"article","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"title":"Building a Domain Plugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","url":"\/documentation\/swidux\/buildingadomainplugin","type":"topic"},"doc://Swidux/documentation/Swidux/UndoRedo":{"title":"Undo \/ Redo","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"topic","kind":"article","url":"\/documentation\/swidux\/undoredo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","role":"article"},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"title":"Design Principles","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","abstract":[{"type":"text","text":"The 10 rules that shape every Swidux app, and the reasoning behind them."}],"url":"\/documentation\/swidux\/designprinciples","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"kind":"symbol","role":"symbol","abstract":[{"text":"A plugin that participates in the Swidux dispatch cycle.","type":"text"}],"title":"SwiduxPlugin","navigatorTitle":[{"kind":"identifier","text":"SwiduxPlugin"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","url":"\/documentation\/swidux\/swiduxplugin","fragments":[{"text":"protocol","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiduxPlugin"}],"type":"topic"},"doc://Swidux/documentation/Swidux/EntityStore":{"title":"EntityS