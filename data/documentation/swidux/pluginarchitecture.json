{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swidux’s plugin system is a single protocol ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin"},{"type":"text","text":") with four lifecycle hooks and an ordered registry ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"type":"text","text":"). All store extensibility flows through this contract. The built-in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":" use it, and so do domain-specific features like killswitch enforcement and paywall management."}]},{"level":2,"type":"heading","text":"The Dispatch Lifecycle","anchor":"The-Dispatch-Lifecycle"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every call to "},{"type":"codeVoice","code":"store.send()"},{"type":"text","text":" drives plugins through a four-phase lifecycle:"}]},{"type":"codeListing","syntax":null,"code":["plugins.willReduce(state:action:)      \/\/ 1. Pre-reduce (read-only state)","appReducer.reduce(state:action:...)    \/\/ 2. App reducer runs","pluginEffects = plugins.reduce(...)    \/\/ 3. Plugin reducers run","plugins.afterReduce(state:action:)     \/\/ 4. Post-reduce cleanup"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The generic "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"type":"text","text":" implements this lifecycle internally. You don’t write "},{"type":"codeVoice","code":"send()"},{"type":"text","text":" by hand — "},{"type":"codeVoice","code":"Store.send()"},{"type":"text","text":" handles packing, reducing, plugin hooks, unpacking, and effect dispatch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A fifth method, "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":", runs once at shutdown to drain async buffers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All four hooks have default no-op implementations. Each plugin overrides only what it needs."}]},{"level":2,"type":"heading","text":"Core Middleware vs Domain Plugins","anchor":"Core-Middleware-vs-Domain-Plugins"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin system serves two structurally different roles. Recognizing which one a plugin fills determines where it lives, which hooks it uses, and how it couples to the host app."}]},{"level":3,"type":"heading","text":"Core Middleware","anchor":"Core-Middleware"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":" are "},{"type":"strong","inlineContent":[{"text":"action-agnostic infrastructure","type":"text"}]},{"type":"text","text":". They never inspect the "},{"type":"codeVoice","code":"Action"},{"type":"text","text":" type, never dispatch actions, and never return effects. They couple only to the shape of state:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true},{"type":"text","text":" needs keypaths to "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" properties."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":" needs "},{"type":"codeVoice","code":"State: Equatable"},{"type":"text","text":" so it can snapshot and compare."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because they don’t touch actions, they work with any app that uses Swidux — no wiring required beyond construction."}]},{"level":3,"type":"heading","text":"Domain Plugins","anchor":"Domain-Plugins"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Killswitch, parental gate, and paywall plugins are "},{"type":"strong","inlineContent":[{"text":"domain-specific modules","type":"text"}]},{"type":"text","text":" that ship as separate library targets ("},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":"). They own their own state slices and action enums, dispatch effects, and must be explicitly wired into the host app’s root types."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each domain plugin stores three wiring pieces:"}]},{"type":"codeListing","syntax":"swift","code":["private let stateKeyPath: WritableKeyPath<RootState, FeatureState>","private let toRootAction: @Sendable (FeatureAction) -> RootAction","private let extractAction: @Sendable (RootAction) -> FeatureAction?"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The host app provides these at init — the plugin never assumes a specific root type."}]},{"level":3,"type":"heading","text":"Comparison","anchor":"Comparison"},{"rows":[[[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"text":"Core Middleware","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Domain Plugins","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Action knowledge"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"None","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Full — extracts and lifts actions","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Lifecycle hooks"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"code":"willReduce","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"afterReduce","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"reduce"},{"type":"text","text":" only"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Returns effects"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State coupling"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keypath to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" constraint"}]}],[{"type":"paragraph","inlineContent":[{"text":"Keypath to plugin’s own state slice","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Wiring"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Construction only"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keypath + action lifter + action extractor"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Target"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Core "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" library"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Separate library target"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Opt-in"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Instantiate and register"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add state, action case, and register"}]}]]],"type":"table","header":"row"},{"level":2,"type":"heading","text":"The Decision Rule","anchor":"The-Decision-Rule"},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Does the middleware need to know your action type? If "},{"type":"strong","inlineContent":[{"type":"text","text":"no"}]},{"text":", it’s core middleware — put it in ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":" and use ","type":"text"},{"type":"codeVoice","code":"willReduce"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":". If ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"yes"}]},{"type":"text","text":", it’s a domain plugin — give it its own target and use "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":"."}]}]},{"type":"heading","anchor":"Hook-Selection-Guide","level":2,"text":"Hook Selection Guide"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"willReduce(state:action:)","type":"codeVoice"}]},{"type":"text","text":" — Capture state "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" the reducer mutates it. State is read-only. Use for snapshots (undo) or pre-mutation analytics."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"reduce(state:action:) -> Effect?"}]},{"type":"text","text":" — Handle domain-specific actions "},{"type":"emphasis","inlineContent":[{"type":"text","text":"after"}]},{"type":"text","text":" the app reducer. Mutate the plugin’s state slice and return effects. This is the only hook that can dispatch actions or do async work."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"afterReduce(state:action:)"}]},{"type":"text","text":" — Observe state "},{"type":"emphasis","inlineContent":[{"type":"text","text":"after"}]},{"type":"text","text":" all reducing is done. Use for persistence draining, logging, or metrics. Cannot return effects."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"flush() async"}]},{"text":" — Shutdown hook. Flush pending async buffers (persistence writes, analytics batches). Called once when the app exits.","type":"text"}]}]}]},{"level":2,"anchor":"Registration-Order","type":"heading","text":"Registration Order"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference","isActive":true},{"type":"text","text":" executes plugins in registration order. Recommended ordering:"}]},{"syntax":"swift","type":"codeListing","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)         \/\/ 1. Must snapshot before any mutation","plugins.register(persistencePlugin)  \/\/ 2. Drains changelogs after reducer","plugins.register(killswitchPlugin)   \/\/ 3. Domain plugins in any order","plugins.register(paywallPlugin)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Undo must come first — it snapshots state in "},{"type":"codeVoice","code":"willReduce"},{"text":", before the app reducer or any plugin modifies it. Persistence typically comes next so its ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" drain sees the final state. Domain plugins use only "},{"type":"codeVoice","code":"reduce"},{"text":", so their relative order rarely matters.","type":"text"}]},{"type":"heading","level":2,"text":"Service-Result Actions and Transition Observation","anchor":"Service-Result-Actions-and-Transition-Observation"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"service-result action"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"PaywallPlugin"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"customerInfoUpdated"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"KillswitchPlugin"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"verdictReceived"},{"type":"text","text":", "},{"type":"codeVoice","code":"FeatureFlagsPlugin"},{"type":"text","text":"’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"refreshSucceeded"},{"type":"text","text":" — fires on "},{"type":"strong","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" fetch, refresh, or stream tick, not"},{"text":" ","type":"text"},{"type":"text","text":"only when the value changed, and unconditionally writes its payload to the"},{"type":"text","text":" "},{"type":"text","text":"state slice. The payload is frequently identical to what is already there"},{"type":"text","text":" "},{"type":"text","text":"(a re-delivered entitlement, an unchanged remote config)."}]},{"type":"paragraph","inlineContent":[{"text":"Do ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" map analytics or side effects to the raw service-result action:"},{"text":" ","type":"text"},{"type":"text","text":"it fires duplicates by design. Observe the "},{"type":"strong","inlineContent":[{"type":"text","text":"state slice"}]},{"type":"text","text":" — or a value"},{"text":" ","type":"text"},{"type":"text","text":"derived from it — instead."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"State observation is already deduplicated by the framework. "},{"type":"codeVoice","code":"Store.send"},{"type":"text","text":" "},{"type":"text","text":"packs the observer into a value-type snapshot, lets reducers mutate the"},{"type":"text","text":" "},{"type":"text","text":"snapshot, then writes back via "},{"type":"codeVoice","code":"State.apply"},{"type":"text","text":". For a leaf slice that write"},{"type":"text","text":" "},{"type":"text","text":"is a plain assignment whose "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" setter equality-gates "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" "},{"type":"text","text":"values, so a slice whose value did not change emits no notification — and a"},{"type":"text","text":" "},{"type":"text","text":"value-diffing consumer such as "},{"type":"codeVoice","code":"AnalyticsIdentity.userProperties"},{"type":"text","text":" (which"},{"type":"text","text":" "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":" re-evaluates and diffs every non-analytics dispatch) sees exactly the"},{"type":"text","text":" "},{"type":"text","text":"real transitions. This dedup is a property of the "},{"type":"codeVoice","code":"Store"},{"type":"text","text":", not of any"},{"type":"text","text":" "},{"type":"text","text":"per-plugin guard, so a no-op service-result cycle is silent to state"},{"type":"text","text":" "},{"text":"observers without any extra reducer logic.","type":"text"}]},{"type":"heading","anchor":"Next-Steps","level":2,"text":"Next Steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","isActive":true},{"type":"text","text":" — Step-by-step guide to creating a domain plugin"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true,"type":"reference"},{"text":" — Configure the built-in persistence middleware","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","isActive":true,"type":"reference"},{"text":" — Add undo\/redo with the built-in undo middleware","type":"text"}],"type":"paragraph"}]}]}],"kind":"content"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Explanation","title":"Explanation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples"]}],"metadata":{"modules":[{"name":"Swidux"}],"title":"Plugin Architecture","role":"article","roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginarchitecture"]}],"references":{"doc://Swidux/documentation/Swidux/UndoRedo":{"url":"\/documentation\/swidux\/undoredo","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":"."}],"title":"Undo \/ Redo","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"role":"article","type":"topic","abstract":[{"type":"text","text":"The 10 rules that shape every Swidux app, and the reasoning behind them."}],"kind":"article","url":"\/documentation\/swidux\/designprinciples","title":"Design Principles","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"url":"\/documentation\/swidux\/architectureguide","abstract":[{"text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system.","type":"text"}],"title":"Architecture & Performance","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"url":"\/documentation\/swidux\/persistencemiddlewareguide","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"title":"Persistence Middleware","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","role":"symbol","abstract":[{"type":"text","text":"A plugin that participates in the Swidux dispatch cycle."}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiduxPlugin"}],"navigatorTitle":[{"kind":"identifier","text":"SwiduxPlugin"}],"kind":"symbol","url":"\/documentation\/swidux\/swiduxplugin","title":"SwiduxPlugin"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"title":"Building a Domain Plugin","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},"doc://Swidux/documentation/Swidux":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"kind":"symbol","url":"\/documentation\/swidux","title":"Swidux"},"doc://Swidux/documentation/Swidux/PersistencePlugin":{"role":"symbol","navigatorTitle":[{"text":"PersistencePlugin","kind":"identifier"}],"type":"topic","url":"\/documentation\/swidux\/persistenceplugin","abstract":[{"type":"text","text":"Coalescing persistence plugin."}],"kind":"symbol","title":"PersistencePlugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistencePlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},"doc://Swidux/documentation/Swidux/EntityStore":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","role":"symbol","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"type":"text","text":" "},{"text":"every mutation for downstream persistence.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"EntityStore","kind":"identifier"}],"navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"kind":"symbol","title":"EntityStore","url":"\/documentation\/swidux\/entitystore"},"doc://Swidux/documentation/Swidux/PluginHost":{"url":"\/documentation\/swidux\/pluginhost","abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}],"title":"PluginHost","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PluginHost","kind":"identifier"}],"navigatorTitle":[{"text":"PluginHost","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},"doc://Swidux/documentation/Swidux/Store":{"role":"symbol","navigatorTitle":[{"text":"Store","kind":"identifier"}],"type":"topic","url":"\/documentation\/swidux\/store","abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"type":"text","text":"observation layer."}],"kind":"symbol","title":"Store","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"url":"\/documentation\/swidux\/undoplugin","title":"UndoPlugin","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"}}}