mbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"topic","role":"symbol","title":"PersistencePlugin","navigatorTitle":[{"kind":"identifier","text":"PersistencePlugin"}]}}}