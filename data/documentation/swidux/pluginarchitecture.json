{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},"metadata":{"roleHeading":"Article","role":"article","title":"Plugin Architecture","modules":[{"name":"Swidux"}]},"abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Swidux’s plugin system is a single protocol (","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin"},{"text":") with four lifecycle hooks and an ordered registry (","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"text":"). All store extensibility flows through this contract. The built-in ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"text":" and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":" use it, and so do domain-specific features like killswitch enforcement and paywall management.","type":"text"}]},{"anchor":"The-Dispatch-Lifecycle","type":"heading","level":2,"text":"The Dispatch Lifecycle"},{"type":"paragraph","inlineContent":[{"text":"Every call to ","type":"text"},{"type":"codeVoice","code":"store.send()"},{"text":" drives plugins through a four-phase lifecycle:","type":"text"}]},{"code":["plugins.willReduce(state:action:)      \/\/ 1. Pre-reduce (read-only state)","appReducer.reduce(state:action:...)    \/\/ 2. App reducer runs","pluginEffects = plugins.reduce(...)    \/\/ 3. Plugin reducers run","plugins.afterReduce(state:action:)     \/\/ 4. Post-reduce cleanup"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"The generic ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"text":" implements this lifecycle internally. You don’t write ","type":"text"},{"type":"codeVoice","code":"send()"},{"text":" by hand — ","type":"text"},{"type":"codeVoice","code":"Store.send()"},{"text":" handles packing, reducing, plugin hooks, unpacking, and effect dispatch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A fifth method, ","type":"text"},{"type":"codeVoice","code":"flush()"},{"text":", runs once at shutdown to drain async buffers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"All four hooks have default no-op implementations. Each plugin overrides only what it needs.","type":"text"}]},{"anchor":"Core-Middleware-vs-Domain-Plugins","type":"heading","level":2,"text":"Core Middleware vs Domain Plugins"},{"type":"paragraph","inlineContent":[{"text":"The plugin system serves two structurally different roles. Recognizing which one a plugin fills determines where it lives, which hooks it uses, and how it couples to the host app.","type":"text"}]},{"anchor":"Core-Middleware","type":"heading","level":3,"text":"Core Middleware"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"text":" and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":" are ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"action-agnostic infrastructure"}]},{"text":". They never inspect the ","type":"text"},{"type":"codeVoice","code":"Action"},{"text":" type, never dispatch actions, and never return effects. They couple only to the shape of state:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"type":"text","text":" needs keypaths to "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":" properties."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"type":"text","text":" needs "},{"code":"State: Equatable","type":"codeVoice"},{"type":"text","text":" so it can snapshot and compare."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Because they don’t touch actions, they work with any app that uses Swidux — no wiring required beyond construction.","type":"text"}]},{"anchor":"Domain-Plugins","type":"heading","level":3,"text":"Domain Plugins"},{"type":"paragraph","inlineContent":[{"text":"Killswitch, parental gate, and paywall plugins are ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"domain-specific modules"}]},{"text":" that ship as separate library targets (","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":"). They own their own state slices and action enums, dispatch effects, and must be explicitly wired into the host app’s root types.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each domain plugin stores three wiring pieces:","type":"text"}]},{"code":["private let stateKeyPath: WritableKeyPath<RootState, FeatureState>","private let toRootAction: @Sendable (FeatureAction) -> RootAction","private let extractAction: @Sendable (RootAction) -> FeatureAction?"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The host app provides these at init — the plugin never assumes a specific root type.","type":"text"}]},{"anchor":"Comparison","type":"heading","level":3,"text":"Comparison"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Core Middleware"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Domain Plugins"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action knowledge"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"None"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full — extracts and lifts actions"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Lifecycle hooks"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"willReduce"},{"type":"text","text":" or "},{"type":"codeVoice","code":"afterReduce"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"reduce"},{"type":"text","text":" only"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Returns effects"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State coupling"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keypath to "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":" or "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" constraint"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keypath to plugin’s own state slice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Wiring"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Construction only"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keypath + action lifter + action extractor"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Target"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Core "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" library"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Separate library target"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Opt-in"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Instantiate and register"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Add state, action case, and register"}]}]]]},{"anchor":"The-Decision-Rule","type":"heading","level":2,"text":"The Decision Rule"},{"name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Does the middleware need to know your action type? If "},{"type":"strong","inlineContent":[{"type":"text","text":"no"}]},{"type":"text","text":", it’s core middleware — put it in "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" and use "},{"type":"codeVoice","code":"willReduce"},{"type":"text","text":" or "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":". If "},{"type":"strong","inlineContent":[{"type":"text","text":"yes"}]},{"type":"text","text":", it’s a domain plugin — give it its own target and use "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":"."}]}],"style":"important"},{"anchor":"Hook-Selection-Guide","type":"heading","level":2,"text":"Hook Selection Guide"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"willReduce(state:action:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Capture state "},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"type":"text","text":" the reducer mutates it. State is read-only. Use for snapshots (undo) or pre-mutation analytics."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"reduce(state:action:) -> Effect?","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Handle domain-specific actions "},{"inlineContent":[{"text":"after","type":"text"}],"type":"emphasis"},{"type":"text","text":" the app reducer. Mutate the plugin’s state slice and return effects. This is the only hook that can dispatch actions or do async work."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"afterReduce(state:action:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Observe state "},{"inlineContent":[{"text":"after","type":"text"}],"type":"emphasis"},{"type":"text","text":" all reducing is done. Use for persistence draining, logging, or metrics. Cannot return effects."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"flush() async","type":"codeVoice"}],"type":"strong"},{"text":" — Shutdown hook. Flush pending async buffers (persistence writes, analytics batches). Called once when the app exits.","type":"text"}],"type":"paragraph"}]}]},{"level":2,"text":"Registration Order","anchor":"Registration-Order","type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference","isActive":true},{"type":"text","text":" executes plugins in registration order. Recommended ordering:"}]},{"code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)         \/\/ 1. Must snapshot before any mutation","plugins.register(persistencePlugin)  \/\/ 2. Drains changelogs after reducer","plugins.register(killswitchPlugin)   \/\/ 3. Domain plugins in any order","plugins.register(paywallPlugin)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Undo must come first — it snapshots state in "},{"code":"willReduce","type":"codeVoice"},{"type":"text","text":", before the app reducer or any plugin modifies it. Persistence typically comes next so its "},{"code":"afterReduce","type":"codeVoice"},{"type":"text","text":" drain sees the final state. Domain plugins use only "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":", so their relative order rarely matters."}]},{"anchor":"Next-Steps","level":2,"type":"heading","text":"Next Steps"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","type":"reference","isActive":true},{"text":" — Step-by-step guide to creating a domain plugin","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"reference"},{"text":" — Configure the built-in persistence middleware","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},{"text":" — Add undo\/redo with the built-in undo middleware","type":"text"}]}]}],"type":"unorderedList"}]}],"variants":[{"paths":["\/documentation\/swidux\/pluginarchitecture"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"generated":true,"title":"Explanation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples"],"anchor":"Explanation"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","url":"\/documentation\/swidux\/architectureguide","abstract":[{"type":"text","text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system."}],"title":"Architecture & Performance","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/Store":{"abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"type":"text","text":"observation layer."}],"title":"Store","navigatorTitle":[{"text":"Store","kind":"identifier"}],"url":"\/documentation\/swidux\/store","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"topic","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","type":"topic","kind":"symbol","role":"collection"},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"abstract":[{"text":"The 10 rules that shape every Swidux app, and the reasoning behind them.","type":"text"}],"title":"Design Principles","url":"\/documentation\/swidux\/designprinciples","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","url":"\/documentation\/swidux\/persistencemiddlewareguide","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"title":"Persistence Middleware","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PersistencePlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","navigatorTitle":[{"text":"PersistencePlugin","kind":"identifier"}],"url":"\/documentation\/swidux\/persistenceplugin","abstract":[{"type":"text","text":"Coalescing persistence plugin."}],"title":"PersistencePlugin","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistencePlugin"}],"type":"topic","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux/PluginHost":{"abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}],"title":"PluginHost","navigatorTitle":[{"text":"PluginHost","kind":"identifier"}],"url":"\/documentation\/swidux\/pluginhost","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PluginHost","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"topic","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"title":"UndoPlugin","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"url":"\/documentation\/swidux\/undoplugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"topic","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"title":"Building a Domain Plugin","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/EntityStore":{"abstract":[{"type":"text","text":"An ordered, keyed collection of identifiable entities that silently records"},{"type":"text","text":" "},{"type":"text","text":"every mutation for downstream persistence."}],"url":"\/documentation\/swidux\/entitystore","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","role":"symbol","type":"topic","fragments":[{