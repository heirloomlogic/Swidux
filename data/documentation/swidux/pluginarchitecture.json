xt"}],"title":"Architecture & Performance"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","role":"article","kind":"article","url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"title":"Building a Domain Plugin"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"navigatorTitle":[{"text":"SwiduxPlugin","kind":"identifier"}],"abstract":[{"text":"A plugin that participates in the Swidux dispatch cycle.","type":"text"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiduxPlugin","kind":"identifier"}],"title":"SwiduxPlugin","role":"symbol","url":"\/documentation\/swidux\/swiduxplugin"},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"abstract":[{"type":"text","text":"The 10 rules that shape every Swidux app, and the reasoning behind them."}],"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","title":"Design Principles","role":"article","url":"\/documentation\/swidux\/designprinciples"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"url":"\/documentation\/swidux\/undoplugin","role":"symbol","title":"UndoPlugin","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"UndoPlugin","kind":"identifier"}],"type":"topic"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","role":"article","kind":"article","url":"\/docum