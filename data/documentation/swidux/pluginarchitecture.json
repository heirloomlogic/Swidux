{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginarchitecture"]}],"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"article","title":"Plugin Architecture","roleHeading":"Article","modules":[{"name":"Swidux"}]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swidux’s plugin system is a single protocol ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin"},{"type":"text","text":") with four lifecycle hooks and an ordered registry ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"type":"text","text":"). All store extensibility flows through this contract. The built-in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":" use it, and so do domain-specific features like killswitch enforcement and paywall management."}]},{"type":"heading","text":"The Dispatch Lifecycle","level":2,"anchor":"The-Dispatch-Lifecycle"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every call to "},{"code":"store.send()","type":"codeVoice"},{"type":"text","text":" drives plugins through a four-phase lifecycle:"}]},{"type":"codeListing","code":["plugins.willReduce(state:action:)      \/\/ 1. Pre-reduce (read-only state)","appReducer.reduce(state:action:...)    \/\/ 2. App reducer runs","pluginEffects = plugins.reduce(...)    \/\/ 3. Plugin reducers run","plugins.afterReduce(state:action:)     \/\/ 4. Post-reduce cleanup"],"syntax":null},{"type":"paragraph","inlineContent":[{"text":"The generic ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"text":" implements this lifecycle internally. You don’t write ","type":"text"},{"code":"send()","type":"codeVoice"},{"text":" by hand — ","type":"text"},{"code":"Store.send()","type":"codeVoice"},{"type":"text","text":" handles packing, reducing, plugin hooks, unpacking, and effect dispatch."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A fifth method, "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":", runs once at shutdown to drain async buffers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All four hooks have default no-op implementations. Each plugin overrides only what it needs."}]},{"anchor":"Core-Middleware-vs-Domain-Plugins","type":"heading","level":2,"text":"Core Middleware vs Domain Plugins"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin system serves two structurally different roles. Recognizing which one a plugin fills determines where it lives, which hooks it uses, and how it couples to the host app."}]},{"anchor":"Core-Middleware","type":"heading","level":3,"text":"Core Middleware"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":" are ","type":"text"},{"type":"strong","inlineContent":[{"text":"action-agnostic infrastructure","type":"text"}]},{"text":". They never inspect the ","type":"text"},{"code":"Action","type":"codeVoice"},{"text":" type, never dispatch actions, and never return effects. They couple only to the shape of state:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true,"type":"reference"},{"text":" needs keypaths to ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" properties.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference"},{"text":" needs ","type":"text"},{"code":"State: Equatable","type":"codeVoice"},{"text":" so it can snapshot and compare.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Because they don’t touch actions, they work with any app that uses Swidux — no wiring required beyond construction.","type":"text"}]},{"type":"heading","anchor":"Domain-Plugins","text":"Domain Plugins","level":3},{"type":"paragraph","inlineContent":[{"text":"Killswitch, parental gate, and paywall plugins are ","type":"text"},{"inlineContent":[{"type":"text","text":"domain-specific modules"}],"type":"strong"},{"text":" that ship as separate library targets (","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":"). They own their own state slices and action enums, dispatch effects, and must be explicitly wired into the host app’s root types.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each domain plugin stores three wiring pieces:"}]},{"type":"codeListing","syntax":"swift","code":["private let stateKeyPath: WritableKeyPath<RootState, FeatureState>","private let toRootAction: @Sendable (FeatureAction) -> RootAction","private let extractAction: @Sendable (RootAction) -> FeatureAction?"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The host app provides these at init — the plugin never assumes a specific root type."}]},{"type":"heading","anchor":"Importing-at-call-sites","text":"Importing at call sites","level":3},{"type":"paragraph","inlineContent":[{"text":"Because each domain plugin ships as a ","type":"text"},{"inlineContent":[{"text":"separate library target","type":"text"}],"type":"strong"},{"text":", its state and action types are defined in that module — not in ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":". A common convention is to re-export core Swidux from ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":", but that re-exports ","type":"text"},{"inlineContent":[{"text":"core Swidux only","type":"text"}],"type":"strong"},{"text":"; it does not re-export the plugin modules.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"So any file that reads a plugin-owned slice (","type":"text"},{"code":"store.analytics.*","type":"codeVoice"},{"text":", ","type":"text"},{"code":"store.paywall.*","type":"codeVoice"},{"type":"text","text":", "},{"code":"store.killswitch.*","type":"codeVoice"},{"type":"text","text":", …) or dispatches a plugin action ("},{"code":"AnalyticsAction","type":"codeVoice"},{"type":"text","text":", "},{"code":"PaywallAction","type":"codeVoice"},{"type":"text","text":", …) must import that plugin’s module in "},{"type":"strong","inlineContent":[{"type":"text","text":"that"}]},{"type":"text","text":" file:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"touches "},{"type":"codeVoice","code":"store.analytics.*"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" → "},{"type":"codeVoice","code":"import SwiduxAnalytics"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"touches "},{"type":"codeVoice","code":"store.paywall.*"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":" → "},{"type":"codeVoice","code":"import SwiduxPaywall"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"touches only ","type":"text"},{"code":"store.ui","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".ui(...)","type":"codeVoice"},{"text":" (app-module types) → nothing extra","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The easy case to forget is a ","type":"text"},{"type":"strong","inlineContent":[{"text":"View","type":"text"}]},{"text":" that reads the slice for display — ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":" and ","type":"text"},{"code":"AppAction.swift","type":"codeVoice"},{"type":"text","text":" already import the module, but the View is a different file. Without the import you get:"}]},{"syntax":null,"type":"codeListing","code":["property 'isOptedOut' is not available due to missing import of defining module 'SwiduxAnalytics'","property 'isPro' is not available due to missing import of defining module 'SwiduxPaywall'"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The fix is to add "},{"type":"codeVoice","code":"import Swidux<Plugin>"},{"type":"text","text":" to that file."}]},{"level":3,"text":"Comparison","anchor":"Comparison","type":"heading"},{"rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Core Middleware"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Domain Plugins"}]}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action knowledge"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"None"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Full — extracts and lifts actions","type":"text"}]}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Lifecycle hooks"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"code":"willReduce","type":"codeVoice"},{"type":"text","text":" or "},{"code":"afterReduce","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"reduce","type":"codeVoice"},{"type":"text","text":" only"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Returns effects","type":"text"}],"type":"strong"}]}],[{"inlineContent":[{"type":"text","text":"No"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State coupling"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keypath to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" constraint","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keypath to plugin’s own state slice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Wiring"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Construction only"}]}],[{"type":"paragraph","inlineContent":[{"text":"Keypath + action lifter + action extractor","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Target","type":"text"}],"type":"strong"}]}],[{"inlineContent":[{"text":"Core ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" library"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Separate library target"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Opt-in"}],"type":"strong"}]}],[{"inlineContent":[{"type":"text","text":"Instantiate and register"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Add state, action case, and register"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"text":"The Decision Rule","anchor":"The-Decision-Rule","level":2,"type":"heading"},{"name":"Important","style":"important","content":[{"inlineContent":[{"text":"Does the middleware need to know your action type? If ","type":"text"},{"inlineContent":[{"text":"no","type":"text"}],"type":"strong"},{"text":", it’s core middleware — put it in ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":" and use ","type":"text"},{"type":"codeVoice","code":"willReduce"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":". If ","type":"text"},{"inlineContent":[{"type":"text","text":"yes"}],"type":"strong"},{"text":", it’s a domain plugin — give it its own target and use ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside"},{"text":"Hook Selection Guide","anchor":"Hook-Selection-Guide","level":2,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"willReduce(state:action:)","type":"codeVoice"}]},{"text":" — Capture state ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"text":" the reducer mutates it. State is read-only. Use for snapshots (undo) or pre-mutation analytics.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"reduce(state:action:) -> Effect?"}],"type":"strong"},{"text":" — Handle domain-specific actions ","type":"text"},{"inlineContent":[{"type":"text","text":"after"}],"type":"emphasis"},{"type":"text","text":" the app reducer. Mutate the plugin’s state slice and return effects. This is the only hook that can dispatch actions or do async work."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"afterReduce(state:action:)"}],"type":"strong"},{"text":" — Observe state ","type":"text"},{"inlineContent":[{"text":"after","type":"text"}],"type":"emphasis"},{"text":" all reducing is done. Use for persistence draining, logging, or metrics. Cannot return effects.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"flush() async","type":"codeVoice"}]},{"type":"text","text":" — Shutdown hook. Flush pending async buffers (persistence writes, analytics batches). Called once when the app exits."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","text":"Registration Order","level":2,"anchor":"Registration-Order"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","isActive":true},{"type":"text","text":" executes plugins in registration order. Recommended ordering:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)         \/\/ 1. Must snapshot before any mutation","plugins.register(persistencePlugin)  \/\/ 2. Drains changelogs after reducer","plugins.register(killswitchPlugin)   \/\/ 3. Domain plugins in any order","plugins.register(paywallPlugin)"]},{"inlineContent":[{"type":"text","text":"Undo must come first — it snapshots state in "},{"type":"codeVoice","code":"willReduce"},{"type":"text","text":", before the app reducer or any plugin modifies it. Persistence typically comes next so its "},{"type":"codeVoice","code":"afterReduce"},{"text":" drain sees the final state. Domain plugins use only ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":", so their relative order rarely matters.","type":"text"}],"type":"paragraph"},{"anchor":"Service-Result-Actions-and-Transition-Observation","text":"Service-Result Actions and Transition Observation","type":"heading","level":2},{"inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"type":"text","text":"service-result action"}],"type":"emphasis"},{"text":" — ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"customerInfoUpdated","type":"codeVoice"},{"text":",","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"KillswitchPlugin"},{"type":"text","text":"’s "},{"type":"codeVoice","code":"verdictReceived"},{"type":"text","text":", "},{"type":"codeVoice","code":"FeatureFlagsPlugin"},{"type":"text","text":"’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"refreshSucceeded"},{"type":"text","text":" — fires on "},{"type":"strong","inlineContent":[{"text":"every","type":"text"}]},{"text":" fetch, refresh, or stream tick, not","type":"text"},{"text":" ","type":"text"},{"text":"only when the value changed, and unconditionally writes its payload to the","type":"text"},{"text":" ","type":"text"},{"text":"state slice. The payload is frequently identical to what is already there","type":"text"},{"text":" ","type":"text"},{"text":"(a re-delivered entitlement, an unchanged remote config).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Do ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" map analytics or side effects to the raw service-result action:","type":"text"},{"text":" ","type":"text"},{"text":"it fires duplicates by design. Observe the ","type":"text"},{"inlineContent":[{"text":"state slice","type":"text"}],"type":"strong"},{"text":" — or a value","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"derived from it — instead."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"State observation is already deduplicated by the framework. ","type":"text"},{"type":"codeVoice","code":"Store.send"},{"text":" ","type":"text"},{"text":"packs the observer into a value-type snapshot, lets reducers mutate the","type":"text"},{"text":" ","type":"text"},{"text":"snapshot, then writes back via ","type":"text"},{"type":"codeVoice","code":"State.apply"},{"text":". For a leaf slice that write","type":"text"},{"text":" ","type":"text"},{"text":"is a plain assignment whose ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" setter equality-gates ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" ","type":"text"},{"text":"values, so a slice whose value did not change emits no notification — and a","type":"text"},{"text":" ","type":"text"},{"text":"value-diffing consumer such as ","type":"text"},{"type":"codeVoice","code":"AnalyticsIdentity.userProperties"},{"text":" (which","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AnalyticsPlugin"},{"text":" re-evaluates and diffs every non-analytics dispatch) sees exactly the","type":"text"},{"text":" ","type":"text"},{"text":"real transitions. This dedup is a property of the ","type":"text"},{"type":"codeVoice","code":"Store"},{"text":", not of any","type":"text"},{"text":" ","type":"text"},{"text":"per-plugin guard, so a no-op service-result cycle is silent to state","type":"text"},{"text":" ","type":"text"},{"text":"observers without any extra reducer logic.","type":"text"}]},{"text":"Next Steps","anchor":"Next-Steps","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},{"type":"text","text":" — Step-by-step guide to creating a domain plugin"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true,"type":"reference"},{"text":" — Configure the built-in persistence middleware","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"reference"},{"text":" — Add undo\/redo with the built-in undo middleware","type":"text"}]}]}],"type":"unorderedList"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"title":"Explanation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples"],"anchor":"Explanation","generated":true}],"abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"references":{"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux","type":"topic","kind":"symbol","role":"collection","url":"\/documentation\/swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}]},"doc://Swidux/documentation/Swidux/Store":{"title":"Store","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"navigatorTitle":[{"text":"Store","kind":"identifier"}],"url":"\/documentation\/swidux\/store","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"text":"observation layer.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"role":"article","type":"topic","title":"Persistence Middleware","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","kind":"article","url":"\/documentation\/swidux\/persistencemiddlewareguide","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}]},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"role":"symbol","navigatorTitle":[{"text":"SwiduxPlugin","kind":"identifier"}],"type":"topic","title":"SwiduxPlugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","kind":"symbol","url":"\/documentation\/swidux\/swiduxplugin","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiduxPlugin","kind":"identifier"}],"abstract":[{"type":"text","text":"A plugin that participates in the Swidux dispatch cycle."}]},"doc://Swidux/documentation/Swidux/EntityStore":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"topic","title":"EntityStore","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"EntityStore","kind":"identifier"}],"navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/swidux\/entitystore","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}]},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","title":"Architecture & Performance","abstract":[{"text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system.","type":"text"}],"url":"\/documentation\/swidux\/architectureguide","role":"article","type":"topic"},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","type":"topic","title":"Design Principles","kind":"article","role":"article","url":"\/documentation\/swidux\/designprinciples","abstract":[{"type":"text","text":"The 10 rules that shape every Swidux app, and the reasoning behind them."}]},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","title":"Building a Domain Plugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"url":"\/documentation\/swidux\/buildingadomainplugin","role":"article","type":"topic"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"topic","title":"UndoPlugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/swidux\/undoplugin","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}]},"doc://Swidux/documentation/Swidux/PluginHost":{"role":"symbol","navigatorTitle":[{"text":"PluginHost","kind":"identifier"}],"type":"topic","title":"PluginHost","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","kind":"symbol","url":"\/documentation\/swidux\/pluginhost","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PluginHost","kind":"identifier"}],"abstract":[{"text":"Ordered registry of plugins that drives the dispatch lifecycle.","type":"text"}]},"doc://Swidux/documentation/Swidux/PersistencePlugin":{"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","title":"PersistencePlugin","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistencePlugin"}],"abstract":[{"type":"text","text":"Coalescing persistence plugin."}],"url":"\/documentation\/swidux\/persistenceplugin","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PersistencePlugin"}],"type":"topic"},"doc://Swidux/documentation/Swidux/UndoRedo":{"role":"article","type":"topic","title":"Undo \/ Redo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","kind":"article","url":"\/documentation\/swidux\/undoredo","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":"."}]}}}