{"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"Plugin Architecture"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"Swidux’s plugin system is a single protocol (","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","type":"reference","isActive":true},{"text":") with four lifecycle hooks and an ordered registry (","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference","isActive":true},{"text":"). All store extensibility flows through this contract. The built-in ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":" use it, and so do domain-specific features like killswitch enforcement and paywall management.","type":"text"}]},{"text":"The Dispatch Lifecycle","type":"heading","anchor":"The-Dispatch-Lifecycle","level":2},{"type":"paragraph","inlineContent":[{"text":"Every call to ","type":"text"},{"code":"store.send()","type":"codeVoice"},{"text":" drives plugins through a four-phase lifecycle:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["plugins.willReduce(state:action:)      \/\/ 1. Pre-reduce (read-only state)","appReducer.reduce(state:action:...)    \/\/ 2. App reducer runs","pluginEffects = plugins.reduce(...)    \/\/ 3. Plugin reducers run","plugins.afterReduce(state:action:)     \/\/ 4. Post-reduce cleanup"]},{"type":"paragraph","inlineContent":[{"text":"The generic ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference","isActive":true},{"text":" implements this lifecycle internally. You don’t write ","type":"text"},{"code":"send()","type":"codeVoice"},{"text":" by hand — ","type":"text"},{"code":"Store.send()","type":"codeVoice"},{"text":" handles packing, reducing, plugin hooks, unpacking, and effect dispatch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A fifth method, ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":", runs once at shutdown to drain async buffers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"All four hooks have default no-op implementations. Each plugin overrides only what it needs.","type":"text"}]},{"text":"Core Plugins vs Domain Plugins","type":"heading","anchor":"Core-Plugins-vs-Domain-Plugins","level":2},{"type":"paragraph","inlineContent":[{"text":"The plugin system serves two structurally different roles. Recognizing which one a plugin fills determines where it lives, which hooks it uses, and how it couples to the host app.","type":"text"}]},{"text":"Core Plugins","type":"heading","anchor":"Core-Plugins","level":3},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":" are ","type":"text"},{"inlineContent":[{"text":"action-agnostic infrastructure","type":"text"}],"type":"strong"},{"text":". They never inspect the ","type":"text"},{"code":"Action","type":"codeVoice"},{"text":" type, never dispatch actions, and never return effects. They couple only to the shape of state:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference"},{"text":" needs keypaths to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":" properties.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference"},{"text":" needs ","type":"text"},{"code":"State: Equatable","type":"codeVoice"},{"text":" so it can snapshot and compare.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Because they don’t touch actions, they work with any app that uses Swidux — no wiring required beyond construction.","type":"text"}]},{"text":"Domain Plugins","type":"heading","anchor":"Domain-Plugins","level":3},{"type":"paragraph","inlineContent":[{"text":"Killswitch, parental gate, and paywall plugins are ","type":"text"},{"inlineContent":[{"text":"domain-specific modules","type":"text"}],"type":"strong"},{"text":" that ship as separate library targets (","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":"). They own their own state slices and action enums, dispatch effects, and must be explicitly wired into the host app’s root types.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each domain plugin stores three wiring pieces:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["private let stateKeyPath: WritableKeyPath<RootState, FeatureState>","private let toRootAction: @Sendable (FeatureAction) -> RootAction","private let extractAction: @Sendable (RootAction) -> FeatureAction?"]},{"type":"paragraph","inlineContent":[{"text":"The host app provides these at init — the plugin never assumes a specific root type.","type":"text"}]},{"text":"Importing at call sites","type":"heading","anchor":"Importing-at-call-sites","level":3},{"type":"paragraph","inlineContent":[{"text":"Because each domain plugin ships as a ","type":"text"},{"inlineContent":[{"text":"separate library target","type":"text"}],"type":"strong"},{"text":", its state and action types are defined in that module — not in ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":". A common convention is to re-export core Swidux from ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":", but that re-exports ","type":"text"},{"inlineContent":[{"text":"core Swidux only","type":"text"}],"type":"strong"},{"text":"; it does not re-export the plugin modules.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"So any file that reads a plugin-owned slice (","type":"text"},{"code":"store.analytics.*","type":"codeVoice"},{"text":", ","type":"text"},{"code":"store.paywall.*","type":"codeVoice"},{"text":", ","type":"text"},{"code":"store.killswitch.*","type":"codeVoice"},{"text":", …) or dispatches a plugin action (","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"text":", …) must import that plugin’s module in ","type":"text"},{"inlineContent":[{"text":"that","type":"text"}],"type":"strong"},{"text":" file:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"touches ","type":"text"},{"code":"store.analytics.*","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"AnalyticsAction","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"import SwiduxAnalytics","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"touches ","type":"text"},{"code":"store.paywall.*","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"import SwiduxPaywall","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"touches only ","type":"text"},{"code":"store.ui","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".ui(...)","type":"codeVoice"},{"text":" (app-module types) → nothing extra","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The easy case to forget is a ","type":"text"},{"inlineContent":[{"text":"View","type":"text"}],"type":"strong"},{"text":" that reads the slice for display — ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AppAction.swift","type":"codeVoice"},{"text":" already import the module, but the View is a different file. Without the import you get:","type":"text"}]},{"type":"codeListing","syntax":null,"code":["property 'isOptedOut' is not available due to missing import of defining module 'SwiduxAnalytics'","property 'isPro' is not available due to missing import of defining module 'SwiduxPaywall'"]},{"type":"paragraph","inlineContent":[{"text":"The fix is to add ","type":"text"},{"code":"import Swidux<Plugin>","type":"codeVoice"},{"text":" to that file.","type":"text"}]},{"text":"Comparison","type":"heading","anchor":"Comparison","level":3},{"rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"text":"Core Plugins","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Domain Plugins","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"Action knowledge","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"None","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Full — extracts and lifts actions","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"Lifecycle hooks","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"code":"willReduce","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"afterReduce","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"reduce","type":"codeVoice"},{"text":", plus ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" to react to every dispatch","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"Returns effects","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"State coupling","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Keypath to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":" or ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" constraint","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Keypath to plugin’s own state slice","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"Wiring","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Construction only","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Keypath + action lifter + action extractor","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"Target","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Core ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":" library","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Separate library target","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"text":"Opt-in","type":"text"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Instantiate and register","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Add state, action case, and register","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"text":"The Decision Rule","type":"heading","anchor":"The-Decision-Rule","level":2},{"type":"aside","style":"important","content":[{"inlineContent":[{"text":"Does the plugin need to know your action type? If ","type":"text"},{"inlineContent":[{"text":"no","type":"text"}],"type":"strong"},{"text":", it’s a core plugin — put it in ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":" and use ","type":"text"},{"code":"willReduce","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":". If ","type":"text"},{"inlineContent":[{"text":"yes","type":"text"}],"type":"strong"},{"text":", it’s a domain plugin — give it its own target and handle its own actions in ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":". A domain plugin that must also react to every dispatch, as ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"FeatureFlagsPlugin","type":"codeVoice"},{"text":" do, adds ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Important"},{"text":"Hook Selection Guide","type":"heading","anchor":"Hook-Selection-Guide","level":2},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"willReduce(state:action:)","type":"codeVoice"}]},{"text":" — Capture state ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"text":" the reducer mutates it. State is read-only. Use for snapshots (undo) or pre-mutation analytics.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"reduce(state:action:) -> Effect?","type":"codeVoice"}]},{"text":" — Handle domain-specific actions ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"after","type":"text"}]},{"text":" the app reducer. Mutate the plugin’s state slice and return effects. This is the only hook that can dispatch actions or do async work.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"afterReduce(state:action:)","type":"codeVoice"}]},{"text":" — Observe state ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"after","type":"text"}]},{"text":" all reducing is done. Use for persistence draining, logging, or metrics. Cannot return effects.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"flush() async","type":"codeVoice"}]},{"text":" — Shutdown hook. Flush pending async buffers (persistence writes, analytics batches). Called once when the app exits.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Registration Order","type":"heading","anchor":"Registration-Order","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference","isActive":true},{"text":" executes plugins in registration order. Recommended ordering:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)         \/\/ 1. Must snapshot before any mutation","plugins.register(persistencePlugin)  \/\/ 2. Drains changelogs after reducer","plugins.register(killswitchPlugin)   \/\/ 3. Domain plugins in any order","plugins.register(paywallPlugin)"]},{"type":"paragraph","inlineContent":[{"text":"Undo must come first — it snapshots state in ","type":"text"},{"code":"willReduce","type":"codeVoice"},{"text":", before the app reducer or any plugin modifies it. Persistence typically comes next so its ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" drain sees the final state. Domain plugins handle their own actions in ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":", so their relative order rarely matters.","type":"text"}]},{"text":"Service-Result Actions and Transition Observation","type":"heading","anchor":"Service-Result-Actions-and-Transition-Observation","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"text":"service-result action","type":"text"}],"type":"emphasis"},{"text":" — ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"customerInfoUpdated","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"KillswitchPlugin","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"verdictReceived","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FeatureFlagsPlugin","type":"codeVoice"},{"text":"’s","type":"text"},{"text":" ","type":"text"},{"code":"refreshSucceeded","type":"codeVoice"},{"text":" — fires on ","type":"text"},{"inlineContent":[{"text":"every","type":"text"}],"type":"strong"},{"text":" fetch, refresh, or stream tick, not","type":"text"},{"text":" ","type":"text"},{"text":"only when the value changed, and unconditionally writes its payload to the","type":"text"},{"text":" ","type":"text"},{"text":"state slice. The payload is frequently identical to what is already there","type":"text"},{"text":" ","type":"text"},{"text":"(a re-delivered entitlement, an unchanged remote config).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Do ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" map analytics or side effects to the raw service-result action:","type":"text"},{"text":" ","type":"text"},{"text":"it fires duplicates by design. Observe the ","type":"text"},{"inlineContent":[{"text":"state slice","type":"text"}],"type":"strong"},{"text":" — or a value","type":"text"},{"text":" ","type":"text"},{"text":"derived from it — instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"State observation is already deduplicated by the framework. ","type":"text"},{"code":"Store.send","type":"codeVoice"},{"text":" ","type":"text"},{"text":"packs the observer into a value-type snapshot, lets reducers mutate the","type":"text"},{"text":" ","type":"text"},{"text":"snapshot, then writes back via ","type":"text"},{"code":"State.apply","type":"codeVoice"},{"text":". For a leaf slice that write","type":"text"},{"text":" ","type":"text"},{"text":"is a plain assignment whose ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" setter equality-gates ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" ","type":"text"},{"text":"values, so a slice whose value did not change emits no notification — and a","type":"text"},{"text":" ","type":"text"},{"text":"value-diffing consumer such as ","type":"text"},{"code":"AnalyticsIdentity.userProperties","type":"codeVoice"},{"text":" (which","type":"text"},{"text":" ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":" re-evaluates and diffs every non-analytics dispatch) sees exactly the","type":"text"},{"text":" ","type":"text"},{"text":"real transitions. This dedup is a property of the ","type":"text"},{"code":"Store","type":"codeVoice"},{"text":", not of any","type":"text"},{"text":" ","type":"text"},{"text":"per-plugin guard, so a no-op service-result cycle is silent to state","type":"text"},{"text":" ","type":"text"},{"text":"observers without any extra reducer logic.","type":"text"}]},{"text":"Next Steps","type":"heading","anchor":"Next-Steps","level":2},{"items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","type":"reference"},{"text":" — Step-by-step guide to creating a domain plugin","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"reference"},{"text":" — Configure the built-in persistence plugin","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"reference"},{"text":" — Add undo\/redo with the built-in undo plugin","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginarchitecture"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"seeAlsoSections":[{"generated":true,"title":"Explanation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"],"anchor":"Explanation"}],"references":{"doc://Swidux/documentation/Swidux/SecurityPosture":{"url":"\/documentation\/swidux\/securityposture","abstract":[{"text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one.","type":"text"}],"role":"collectionGroup","type":"topic","kind":"article","title":"Security Posture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"},"doc://Swidux/documentation/Swidux/Store":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","title":"Store","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Store"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Store"}],"url":"\/documentation\/swidux\/store","abstract":[{"text":"Generic store that owns the dispatch cycle, plugin lifecycle, and","type":"text"},{"text":" ","type":"text"},{"text":"observation layer.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","title":"Architecture & Performance","role":"article","kind":"article","url":"\/documentation\/swidux\/architectureguide","type":"topic","abstract":[{"text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system.","type":"text"}]},"doc://Swidux/documentation/Swidux/PersistencePlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","title":"PersistencePlugin","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistencePlugin","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"PersistencePlugin","kind":"identifier"}],"url":"\/documentation\/swidux\/persistenceplugin","abstract":[{"text":"Coalescing persistence plugin.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"url":"\/documentation\/swidux\/persistencemiddlewareguide","title":"Persistence Plugin","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/UndoRedo":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","title":"Undo \/ Redo","role":"article","kind":"article","url":"\/documentation\/swidux\/undoredo","type":"topic","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":".","type":"text"}]},"doc://Swidux/documentation/Swidux/UndoPlugin":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"url":"\/documentation\/swidux\/undoplugin","abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","title":"UndoPlugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"url":"\/documentation\/swidux\/designprinciples","abstract":[{"text":"The 10 rules that shape every Swidux app, and the reasoning behind them.","type":"text"}],"role":"article","type":"topic","kind":"article","title":"Design Principles","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"role":"collection","type":"topic","kind":"symbol","title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"role":"article","type":"topic","kind":"article","title":"Building a Domain Plugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","title":"SwiduxPlugin","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiduxPlugin","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"SwiduxPlugin","kind":"identifier"}],"url":"\/documentation\/swidux\/swiduxplugin","type":"topic","abstract":[{"type":"text","text":"A plugin that participates in the Swidux dispatch cycle."}]},"doc://Swidux/documentation/Swidux/EntityStore":{"abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}],"url":"\/documentation\/swidux\/entitystore","navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"type":"topic","title":"EntityStore","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","role":"symbol"},"doc://Swidux/documentation/Swidux/PluginHost":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","title":"PluginHost","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PluginHost","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"PluginHost","kind":"identifier"}],"url":"\/documentation\/swidux\/pluginhost","type":"topic","abstract":[{"text":"Ordered registry of plugins that drives the dispatch lifecycle.","type":"text"}]}}}