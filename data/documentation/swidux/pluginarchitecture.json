in","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","kind":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"type":"topic","role":"symbol","url":"\/documentation\/swidux\/undoplugin","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}]},"doc://Swidux/documentation/Swidux/PersistencePlugin":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistencePlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","title":"PersistencePlugin","kind":"symbol","abstract":[{"type":"text","text":"Coalescing persistence plugin."}],"type":"topic","role":"symbol","url":"\/documentation\/swidux\/persistenceplugin","navigatorTitle":[{"text":"PersistencePlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/Store":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Store"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","title":"Store","kind":"symbol","abstract":[{"text":"Generic store that owns the dispatch cycle, plugin lifecycle, and","type":"text"},{"text":" ","type":"text"},{"text":"observation layer.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/swidux\/store","navigatorTitle":[{"kind":"identifier","text":"Store"}]},"doc://Swidux/documentation/Swidux/PluginHost":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PluginHost"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","title":"PluginHost","kind":"symbol","abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}],"type":"topic","role":"symbol","url":"\/documentation\/swidux\/pluginhost","navigatorTitle":[{"kind":"identifier","text":"PluginHost"}]},"doc://Swidux/documentation/Swidux/EntityStore":{"abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityStore"}],"navigatorTitle":[{"kind":"identifier","text":"EntityStore"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","title":"EntityStore","kind":"symbol","url":"\/documentation\/swidux\/entitystore"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"kind":"article","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"title":"Persistence Plugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"topic","url":"\/documentation\/swidux\/persistencemiddlewareguide","role":"article"},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"title":"Design Principles","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","kind":"article","abstract":[{"type":"text","text":"The 10 rules that shape every Swidux app, and the reasoning behind them."}],"type":"topic","role":"article","url":"\/documentation\/swidux\/designprinciples"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"abstract":[{"text":"A plugin that participates in the Swidux dispatch cycle.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiduxPlugin"}],"navigatorTitle":[{"kind":"identifier","text":"SwiduxPlugin"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","title":"SwiduxPlugin","kind":"symbol","url":"\/documentation\/swidux\/swiduxplugin"},"doc://Swidux/documentation/Swidux/UndoRedo":{"kind":"article","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":"."}],"title":"Undo \/ Redo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"topic","url":"\/documentation\/swidux\/undoredo","role":"article"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"title":"Building a Domain Plugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","kind":"article","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"type":"topic","role":"article","url":"\/documentation\/swidux\/buildingadomainplugin"}}}