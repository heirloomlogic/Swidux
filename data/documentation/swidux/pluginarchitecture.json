{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","interfaceLanguage":"swift"},"kind":"article","metadata":{"modules":[{"name":"Swidux"}],"role":"article","title":"Plugin Architecture","roleHeading":"Article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"seeAlsoSections":[{"generated":true,"title":"Explanation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"],"anchor":"Explanation"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Swidux’s plugin system is a single protocol (","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","type":"reference","isActive":true},{"text":") with four lifecycle hooks and an ordered registry (","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference","isActive":true},{"text":"). All store extensibility flows through this contract. The built-in ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":" use it, and so do domain-specific features like killswitch enforcement and paywall management.","type":"text"}]},{"level":2,"text":"The Dispatch Lifecycle","type":"heading","anchor":"The-Dispatch-Lifecycle"},{"type":"paragraph","inlineContent":[{"text":"Every call to ","type":"text"},{"type":"codeVoice","code":"store.send()"},{"text":" drives plugins through a four-phase lifecycle:","type":"text"}]},{"syntax":null,"code":["plugins.willReduce(state:action:)      \/\/ 1. Pre-reduce (read-only state)","appReducer.reduce(state:action:...)    \/\/ 2. App reducer runs","pluginEffects = plugins.reduce(...)    \/\/ 3. Plugin reducers run","plugins.afterReduce(state:action:)     \/\/ 4. Post-reduce cleanup"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The generic ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference","isActive":true},{"text":" implements this lifecycle internally. You don’t write ","type":"text"},{"type":"codeVoice","code":"send()"},{"text":" by hand — ","type":"text"},{"type":"codeVoice","code":"Store.send()"},{"text":" handles packing, reducing, plugin hooks, unpacking, and effect dispatch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A fifth method, ","type":"text"},{"type":"codeVoice","code":"flush()"},{"text":", runs once at shutdown to drain async buffers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"All four hooks have default no-op implementations. Each plugin overrides only what it needs.","type":"text"}]},{"level":2,"text":"Core Middleware vs Domain Plugins","type":"heading","anchor":"Core-Middleware-vs-Domain-Plugins"},{"type":"paragraph","inlineContent":[{"text":"The plugin system serves two structurally different roles. Recognizing which one a plugin fills determines where it lives, which hooks it uses, and how it couples to the host app.","type":"text"}]},{"level":3,"text":"Core Middleware","type":"heading","anchor":"Core-Middleware"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":" are ","type":"text"},{"type":"strong","inlineContent":[{"text":"action-agnostic infrastructure","type":"text"}]},{"text":". They never inspect the ","type":"text"},{"type":"codeVoice","code":"Action"},{"text":" type, never dispatch actions, and never return effects. They couple only to the shape of state:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true},{"type":"text","text":" needs keypaths to "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" properties."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":" needs "},{"type":"codeVoice","code":"State: Equatable"},{"type":"text","text":" so it can snapshot and compare."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Because they don’t touch actions, they work with any app that uses Swidux — no wiring required beyond construction.","type":"text"}]},{"level":3,"text":"Domain Plugins","type":"heading","anchor":"Domain-Plugins"},{"type":"paragraph","inlineContent":[{"text":"Killswitch, parental gate, and paywall plugins are ","type":"text"},{"type":"strong","inlineContent":[{"text":"domain-specific modules","type":"text"}]},{"text":" that ship as separate library targets (","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":"). They own their own state slices and action enums, dispatch effects, and must be explicitly wired into the host app’s root types.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each domain plugin stores three wiring pieces:","type":"text"}]},{"syntax":"swift","code":["private let stateKeyPath: WritableKeyPath<RootState, FeatureState>","private let toRootAction: @Sendable (FeatureAction) -> RootAction","private let extractAction: @Sendable (RootAction) -> FeatureAction?"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The host app provides these at init — the plugin never assumes a specific root type.","type":"text"}]},{"level":3,"text":"Importing at call sites","type":"heading","anchor":"Importing-at-call-sites"},{"type":"paragraph","inlineContent":[{"text":"Because each domain plugin ships as a ","type":"text"},{"type":"strong","inlineContent":[{"text":"separate library target","type":"text"}]},{"text":", its state and action types are defined in that module — not in ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":". A common convention is to re-export core Swidux from ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"@_exported import Swidux"},{"text":", but that re-exports ","type":"text"},{"type":"strong","inlineContent":[{"text":"core Swidux only","type":"text"}]},{"text":"; it does not re-export the plugin modules.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"So any file that reads a plugin-owned slice (","type":"text"},{"type":"codeVoice","code":"store.analytics.*"},{"text":", ","type":"text"},{"type":"codeVoice","code":"store.paywall.*"},{"text":", ","type":"text"},{"type":"codeVoice","code":"store.killswitch.*"},{"text":", …) or dispatches a plugin action (","type":"text"},{"type":"codeVoice","code":"AnalyticsAction"},{"text":", ","type":"text"},{"type":"codeVoice","code":"PaywallAction"},{"text":", …) must import that plugin’s module in ","type":"text"},{"type":"strong","inlineContent":[{"text":"that","type":"text"}]},{"text":" file:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"touches "},{"type":"codeVoice","code":"store.analytics.*"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" → "},{"type":"codeVoice","code":"import SwiduxAnalytics"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"touches "},{"type":"codeVoice","code":"store.paywall.*"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":" → "},{"type":"codeVoice","code":"import SwiduxPaywall"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"touches only "},{"type":"codeVoice","code":"store.ui"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".ui(...)"},{"type":"text","text":" (app-module types) → nothing extra"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The easy case to forget is a ","type":"text"},{"type":"strong","inlineContent":[{"text":"View","type":"text"}]},{"text":" that reads the slice for display — ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"AppAction.swift"},{"text":" already import the module, but the View is a different file. Without the import you get:","type":"text"}]},{"syntax":null,"code":["property 'isOptedOut' is not available due to missing import of defining module 'SwiduxAnalytics'","property 'isPro' is not available due to missing import of defining module 'SwiduxPaywall'"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The fix is to add ","type":"text"},{"type":"codeVoice","code":"import Swidux<Plugin>"},{"text":" to that file.","type":"text"}]},{"level":3,"text":"Comparison","type":"heading","anchor":"Comparison"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"text":"Core Middleware","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Domain Plugins","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Action knowledge"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"None","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Full — extracts and lifts actions","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Lifecycle hooks"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"code":"willReduce","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"afterReduce","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"reduce","type":"codeVoice"},{"text":" only","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Returns effects"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"No","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"State coupling"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"Keypath to ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"text":" or ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" constraint","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Keypath to plugin’s own state slice","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Wiring"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"Construction only","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Keypath + action lifter + action extractor","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Target"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"Core ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":" library","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Separate library target","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Opt-in"}],"type":"strong"}]}],[{"type":"paragraph","inlineContent":[{"text":"Instantiate and register","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Add state, action case, and register","type":"text"}]}]]],"type":"table"},{"level":2,"text":"The Decision Rule","type":"heading","anchor":"The-Decision-Rule"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Does the middleware need to know your action type? If ","type":"text"},{"inlineContent":[{"type":"text","text":"no"}],"type":"strong"},{"text":", it’s core middleware — put it in ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":" and use ","type":"text"},{"code":"willReduce","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":". If ","type":"text"},{"inlineContent":[{"type":"text","text":"yes"}],"type":"strong"},{"text":", it’s a domain plugin — give it its own target and use ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":".","type":"text"}]}],"type":"aside","style":"important"},{"level":2,"text":"Hook Selection Guide","type":"heading","anchor":"Hook-Selection-Guide"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"willReduce(state:action:)"}]},{"type":"text","text":" — Capture state "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" the reducer mutates it. State is read-only. Use for snapshots (undo) or pre-mutation analytics."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"reduce(state:action:) -> Effect?"}]},{"type":"text","text":" — Handle domain-specific actions "},{"type":"emphasis","inlineContent":[{"type":"text","text":"after"}]},{"type":"text","text":" the app reducer. Mutate the plugin’s state slice and return effects. This is the only hook that can dispatch actions or do async work."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"afterReduce(state:action:)"}]},{"type":"text","text":" — Observe state "},{"type":"emphasis","inlineContent":[{"type":"text","text":"after"}]},{"type":"text","text":" all reducing is done. Use for persistence draining, logging, or metrics. Cannot return effects."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"flush() async"}]},{"type":"text","text":" — Shutdown hook. Flush pending async buffers (persistence writes, analytics batches). Called once when the app exits."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Registration Order","type":"heading","anchor":"Registration-Order"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference","isActive":true},{"text":" executes plugins in registration order. Recommended ordering:","type":"text"}]},{"syntax":"swift","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)         \/\/ 1. Must snapshot before any mutation","plugins.register(persistencePlugin)  \/\/ 2. Drains changelogs after reducer","plugins.register(killswitchPlugin)   \/\/ 3. Domain plugins in any order","plugins.register(paywallPlugin)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Undo must come first — it snapshots state in ","type":"text"},{"type":"codeVoice","code":"willReduce"},{"text":", before the app reducer or any plugin modifies it. Persistence typically comes next so its ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":" drain sees the final state. Domain plugins use only ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":", so their relative order rarely matters.","type":"text"}]},{"level":2,"text":"Service-Result Actions and Transition Observation","type":"heading","anchor":"Service-Result-Actions-and-Transition-Observation"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"service-result action","type":"text"}]},{"text":" — ","type":"text"},{"type":"codeVoice","code":"PaywallPlugin"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"customerInfoUpdated"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"KillswitchPlugin"},{"text":"’s ","type":"text"},{"type":"codeVoice","code":"verdictReceived"},{"text":", ","type":"text"},{"type":"codeVoice","code":"FeatureFlagsPlugin"},{"text":"’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"refreshSucceeded"},{"text":" — fires on ","type":"text"},{"type":"strong","inlineContent":[{"text":"every","type":"text"}]},{"text":" fetch, refresh, or stream tick, not","type":"text"},{"text":" ","type":"text"},{"text":"only when the value changed, and unconditionally writes its payload to the","type":"text"},{"text":" ","type":"text"},{"text":"state slice. The payload is frequently identical to what is already there","type":"text"},{"text":" ","type":"text"},{"text":"(a re-delivered entitlement, an unchanged remote config).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Do ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" map analytics or side effects to the raw service-result action:","type":"text"},{"text":" ","type":"text"},{"text":"it fires duplicates by design. Observe the ","type":"text"},{"type":"strong","inlineContent":[{"text":"state slice","type":"text"}]},{"text":" — or a value","type":"text"},{"text":" ","type":"text"},{"text":"derived from it — instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"State observation is already deduplicated by the framework. ","type":"text"},{"type":"codeVoice","code":"Store.send"},{"text":" ","type":"text"},{"text":"packs the observer into a value-type snapshot, lets reducers mutate the","type":"text"},{"text":" ","type":"text"},{"text":"snapshot, then writes back via ","type":"text"},{"type":"codeVoice","code":"State.apply"},{"text":". For a leaf slice that write","type":"text"},{"text":" ","type":"text"},{"text":"is a plain assignment whose ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" setter equality-gates ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" ","type":"text"},{"text":"values, so a slice whose value did not change emits no notification — and a","type":"text"},{"text":" ","type":"text"},{"text":"value-diffing consumer such as ","type":"text"},{"type":"codeVoice","code":"AnalyticsIdentity.userProperties"},{"text":" (which","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AnalyticsPlugin"},{"text":" re-evaluates and diffs every non-analytics dispatch) sees exactly the","type":"text"},{"text":" ","type":"text"},{"text":"real transitions. This dedup is a property of the ","type":"text"},{"type":"codeVoice","code":"Store"},{"text":", not of any","type":"text"},{"text":" ","type":"text"},{"text":"per-plugin guard, so a no-op service-result cycle is silent to state","type":"text"},{"text":" ","type":"text"},{"text":"observers without any extra reducer logic.","type":"text"}]},{"level":2,"text":"Next Steps","type":"heading","anchor":"Next-Steps"},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","isActive":true},{"type":"text","text":" — Step-by-step guide to creating a domain plugin"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true},{"type":"text","text":" — Configure the built-in persistence middleware"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","isActive":true},{"type":"text","text":" — Add undo\/redo with the built-in undo middleware"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginarchitecture"]}],"references":{"doc://Swidux/documentation/Swidux":{"abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","url":"\/documentation\/swidux","title":"Swidux","type":"topic","kind":"symbol"},"doc://Swidux/documentation/Swidux/UndoRedo":{"role":"article","title":"Undo \/ Redo","kind":"article","url":"\/documentation\/swidux\/undoredo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"topic","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"type":"text","text":"."}]},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"type":"topic","title":"Design Principles","url":"\/documentation\/swidux\/designprinciples","kind":"article","abstract":[{"type":"text","text":"The 10 rules that shape every Swidux app, and the reasoning behind them."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"type":"topic","title":"UndoPlugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","kind":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"url":"\/documentation\/swidux\/undoplugin","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}]},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"title":"SwiduxPlugin","url":"\/documentation\/swidux\/swiduxplugin","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiduxPlugin","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"SwiduxPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","abstract":[{"type":"text","text":"A plugin that participates in the Swidux dispatch cycle."}],"role":"symbol","type":"topic"},"doc://Swidux/documentation/Swidux/PluginHost":{"type":"topic","title":"PluginHost","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","kind":"symbol","abstract":[{"type":"text","text":"Ordered registry of plugins that drives the dispatch lifecycle."}],"url":"\/documentation\/swidux\/pluginhost","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PluginHost"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PluginHost"}]},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"title":"Persistence Middleware","url":"\/documentation\/swidux\/persistencemiddlewareguide","type":"topic","kind":"article","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","title":"Building a Domain Plugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","kind":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"url":"\/documentation\/swidux\/buildingadomainplugin","role":"article"},"doc://Swidux/documentation/Swidux/EntityStore":{"abstract":[{"type":"text","text":"An ordered, keyed collection of identifiable entities that silently records"},{"type":"text","text":" "},{"type":"text","text":"every mutation for downstream persistence."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","role":"symbol","url":"\/documentation\/swidux\/entitystore","title":"EntityStore","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityStore"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"EntityStore"}],"kind":"symbol"},"doc://Swidux/documentation/Swidux/Store":{"title":"Store","url":"\/documentation\/swidux\/store","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Store"}],"abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"type":"text","text":"observation layer."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Store"}],"role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},"doc://Swidux/documentation/Swidux/PersistencePlugin":{"abstract":[{"type":"text","text":"Coalescing persistence plugin."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","role":"symbol","url":"\/documentation\/swidux\/persistenceplugin","title":"PersistencePlugin","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistencePlugin"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"PersistencePlugin"}],"kind":"symbol"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"type":"topic","title":"Architecture & Performance","url":"\/documentation\/swidux\/architectureguide","kind":"article","abstract":[{"type":"text","text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","role":"article"},"doc://Swidux/documentation/Swidux/SecurityPosture":{"title":"Security Posture","url":"\/documentation\/swidux\/securityposture","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","abstract":[{"type":"text","text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one."}],"role":"collectionGroup","type":"topic"}}}