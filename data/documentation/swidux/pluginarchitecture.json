ns, and effects.","type":"text"}],"title":"Building a Domain Plugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","role":"article","url":"\/documentation\/swidux\/buildingadomainplugin"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system."}],"title":"Architecture & Performance","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","role":"article","url":"\/documentation\/swidux\/architectureguide"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"kind":"symbol","type":"topic","abstract":[{"text":"A plugin that participates in the Swidux dispatch cycle.","type":"text"}],"title":"SwiduxPlugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiduxPlugin"}],"url":"\/documentation\/swidux\/swiduxplugin","navigatorTitle":[{"kind":"identifier","text":"SwiduxPlugin"}]}}}