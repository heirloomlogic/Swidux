{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples"],"title":"Explanation","anchor":"Explanation","generated":true}],"sections":[],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}],"title":"Plugin Architecture"},"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginarchitecture"]}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"Swidux’s plugin system is a single protocol (","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","isActive":true},{"text":") with four lifecycle hooks and an ordered registry (","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","isActive":true},{"text":"). All store extensibility flows through this contract. The built-in ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":" use it, and so do domain-specific features like killswitch enforcement and paywall management.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"The Dispatch Lifecycle","level":2,"anchor":"The-Dispatch-Lifecycle"},{"inlineContent":[{"type":"text","text":"Every call to "},{"type":"codeVoice","code":"store.send()"},{"type":"text","text":" drives plugins through a four-phase lifecycle:"}],"type":"paragraph"},{"code":["plugins.willReduce(state:action:)      \/\/ 1. Pre-reduce (read-only state)","appReducer.reduce(state:action:...)    \/\/ 2. App reducer runs","pluginEffects = plugins.reduce(...)    \/\/ 3. Plugin reducers run","plugins.afterReduce(state:action:)     \/\/ 4. Post-reduce cleanup"],"type":"codeListing","syntax":null},{"inlineContent":[{"type":"text","text":"The generic "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","isActive":true,"type":"reference"},{"text":" implements this lifecycle internally. You don’t write ","type":"text"},{"type":"codeVoice","code":"send()"},{"text":" by hand — ","type":"text"},{"type":"codeVoice","code":"Store.send()"},{"text":" handles packing, reducing, plugin hooks, unpacking, and effect dispatch.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"A fifth method, ","type":"text"},{"code":"flush()","type":"codeVoice"},{"type":"text","text":", runs once at shutdown to drain async buffers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"All four hooks have default no-op implementations. Each plugin overrides only what it needs."}]},{"type":"heading","text":"Core Middleware vs Domain Plugins","level":2,"anchor":"Core-Middleware-vs-Domain-Plugins"},{"inlineContent":[{"text":"The plugin system serves two structurally different roles. Recognizing which one a plugin fills determines where it lives, which hooks it uses, and how it couples to the host app.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Core Middleware","level":3,"anchor":"Core-Middleware"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":" are ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"action-agnostic infrastructure"}]},{"text":". They never inspect the ","type":"text"},{"code":"Action","type":"codeVoice"},{"text":" type, never dispatch actions, and never return effects. They couple only to the shape of state:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"type":"text","text":" needs keypaths to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" properties."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":" needs "},{"type":"codeVoice","code":"State: Equatable"},{"type":"text","text":" so it can snapshot and compare."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Because they don’t touch actions, they work with any app that uses Swidux — no wiring required beyond construction.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Domain Plugins","anchor":"Domain-Plugins","type":"heading"},{"inlineContent":[{"text":"Killswitch, parental gate, and paywall plugins are ","type":"text"},{"type":"strong","inlineContent":[{"text":"domain-specific modules","type":"text"}]},{"text":" that ship as separate library targets (","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":"). They own their own state slices and action enums, dispatch effects, and must be explicitly wired into the host app’s root types.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each domain plugin stores three wiring pieces:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["private let stateKeyPath: WritableKeyPath<RootState, FeatureState>","private let toRootAction: @Sendable (FeatureAction) -> RootAction","private let extractAction: @Sendable (RootAction) -> FeatureAction?"],"type":"codeListing"},{"inlineContent":[{"text":"The host app provides these at init — the plugin never assumes a specific root type.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Comparison","anchor":"Comparison","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"text":"Core Middleware","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Domain Plugins","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action knowledge"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"None","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Full — extracts and lifts actions","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Lifecycle hooks"}]}]}],[{"type":"paragraph","inlineContent":[{"code":"willReduce","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"afterReduce","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"reduce","type":"codeVoice"},{"text":" only","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Returns effects"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"No","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State coupling"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"Keypath to ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"text":" or ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" constraint","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keypath to plugin’s own state slice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Wiring"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Construction only"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keypath + action lifter + action extractor"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Target","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"Core ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":" library"}]}],[{"type":"paragraph","inlineContent":[{"text":"Separate library target","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Opt-in","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"Instantiate and register","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Add state, action case, and register","type":"text"}]}]]],"header":"row","type":"table"},{"level":2,"text":"The Decision Rule","anchor":"The-Decision-Rule","type":"heading"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Does the middleware need to know your action type? If ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"no"}]},{"type":"text","text":", it’s core middleware — put it in "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":" and use "},{"code":"willReduce","type":"codeVoice"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":". If ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"yes"}]},{"text":", it’s a domain plugin — give it its own target and use ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":".","type":"text"}]}],"style":"important","name":"Important","type":"aside"},{"level":2,"text":"Hook Selection Guide","anchor":"Hook-Selection-Guide","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"willReduce(state:action:)"}],"type":"strong"},{"type":"text","text":" — Capture state "},{"inlineContent":[{"type":"text","text":"before"}],"type":"emphasis"},{"type":"text","text":" the reducer mutates it. State is read-only. Use for snapshots (undo) or pre-mutation analytics."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"reduce(state:action:) -> Effect?"}],"type":"strong"},{"type":"text","text":" — Handle domain-specific actions "},{"inlineContent":[{"type":"text","text":"after"}],"type":"emphasis"},{"type":"text","text":" the app reducer. Mutate the plugin’s state slice and return effects. This is the only hook that can dispatch actions or do async work."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"afterReduce(state:action:)"}],"type":"strong"},{"type":"text","text":" — Observe state "},{"inlineContent":[{"type":"text","text":"after"}],"type":"emphasis"},{"type":"text","text":" all reducing is done. Use for persistence draining, logging, or metrics. Cannot return effects."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"flush() async"}],"type":"strong"},{"type":"text","text":" — Shutdown hook. Flush pending async buffers (persistence writes, analytics batches). Called once when the app exits."}]}]}],"type":"unorderedList"},{"level":2,"text":"Registration Order","anchor":"Registration-Order","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference","isActive":true},{"text":" executes plugins in registration order. Recommended ordering:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)         \/\/ 1. Must snapshot before any mutation","plugins.register(persistencePlugin)  \/\/ 2. Drains changelogs after reducer","plugins.register(killswitchPlugin)   \/\/ 3. Domain plugins in any order","plugins.register(paywallPlugin)"],"type":"codeListing"},{"inlineContent":[{"text":"Undo must come first — it snapshots state in ","type":"text"},{"code":"willReduce","type":"codeVoice"},{"text":", before the app reducer or any plugin modifies it. Persistence typically comes next so its ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" drain sees the final state. Domain plugins use only ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":", so their relative order rarely matters.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Next Steps","anchor":"Next-Steps","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},{"type":"text","text":" — Step-by-step guide to creating a domain plugin"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},{"type":"text","text":" — Configure the built-in persistence middleware"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},{"type":"text","text":" — Add undo\/redo with the built-in undo middleware"}]}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/Store":{"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"Store","kind":"identifier"}],"title":"Store","url":"\/documentation\/swidux\/store","navigatorTitle":[{"kind":"identifier","text":"Store"}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","abstract":[{"text":"Generic store that owns the dispatch cycle, plugin lifecycle, and","type":"text"},{"text":" ","type":"text"},{"text":"observation layer.","type":"text"}]},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"title":"Persistence Middleware","url":"\/documentation\/swidux\/persistencemiddlewareguide","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"title":"Architecture & Performance","url":"\/documentation\/swidux\/architectureguide","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide"},"doc://Swidux/documentation/Swidux/UndoRedo":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","kind":"article","type":"topic","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"text":".","type":"text"}],"title":"Undo \/ Redo","url":"\/documentation\/swidux\/undoredo","role":"article"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiduxPlugin","kind":"identifier"}],"title":"SwiduxPlugin","url":"\/documentation\/swidux\/swiduxplugin","navigatorTitle":[{"text":"SwiduxPlugin","kind":"identifier"}],"type":"topic","kind":"symbol","role":"symbol","abstract":[{"type":"text","text":"A plugin that participates in the Swidux dispatch cycle."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin"},"doc://Swidux/documentation/Swidux":{"title":"Swidux","url":"\/documentation\/swidux","type":"topic","kind":"symbol","role":"collectio