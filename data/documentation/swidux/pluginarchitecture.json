{"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginarchitecture"]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"role":"article","modules":[{"name":"Swidux"}],"title":"Plugin Architecture","roleHeading":"Article"},"abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"seeAlsoSections":[{"title":"Explanation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples"],"generated":true,"anchor":"Explanation"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Swidux’s plugin system is a single protocol (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","type":"reference"},{"text":") with four lifecycle hooks and an ordered registry (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference"},{"text":"). All store extensibility flows through this contract. The built-in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference"},{"text":" use it, and so do domain-specific features like killswitch enforcement and paywall management.","type":"text"}]},{"anchor":"The-Dispatch-Lifecycle","level":2,"type":"heading","text":"The Dispatch Lifecycle"},{"type":"paragraph","inlineContent":[{"text":"Every call to ","type":"text"},{"type":"codeVoice","code":"store.send()"},{"text":" drives plugins through a four-phase lifecycle:","type":"text"}]},{"syntax":null,"type":"codeListing","code":["plugins.willReduce(state:action:)      \/\/ 1. Pre-reduce (read-only state)","appReducer.reduce(state:action:...)    \/\/ 2. App reducer runs","pluginEffects = plugins.reduce(...)    \/\/ 3. Plugin reducers run","plugins.afterReduce(state:action:)     \/\/ 4. Post-reduce cleanup"]},{"type":"paragraph","inlineContent":[{"text":"The generic ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference"},{"text":" implements this lifecycle internally. You don’t write ","type":"text"},{"type":"codeVoice","code":"send()"},{"text":" by hand — ","type":"text"},{"type":"codeVoice","code":"Store.send()"},{"text":" handles packing, reducing, plugin hooks, unpacking, and effect dispatch.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A fifth method, ","type":"text"},{"type":"codeVoice","code":"flush()"},{"text":", runs once at shutdown to drain async buffers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"All four hooks have default no-op implementations. Each plugin overrides only what it needs.","type":"text"}]},{"anchor":"Core-Middleware-vs-Domain-Plugins","level":2,"type":"heading","text":"Core Middleware vs Domain Plugins"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin system serves two structurally different roles. Recognizing which one a plugin fills determines where it lives, which hooks it uses, and how it couples to the host app."}]},{"type":"heading","text":"Core Middleware","level":3,"anchor":"Core-Middleware"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"type":"text","text":" and "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference"},{"text":" are ","type":"text"},{"type":"strong","inlineContent":[{"text":"action-agnostic infrastructure","type":"text"}]},{"text":". They never inspect the ","type":"text"},{"type":"codeVoice","code":"Action"},{"text":" type, never dispatch actions, and never return effects. They couple only to the shape of state:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference"},{"text":" needs keypaths to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":" properties.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference"},{"text":" needs ","type":"text"},{"type":"codeVoice","code":"State: Equatable"},{"text":" so it can snapshot and compare.","type":"text"}]}]}]},{"inlineContent":[{"text":"Because they don’t touch actions, they work with any app that uses Swidux — no wiring required beyond construction.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Domain Plugins","level":3,"anchor":"Domain-Plugins"},{"inlineContent":[{"text":"Killswitch, parental gate, and paywall plugins are ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"domain-specific modules"}]},{"type":"text","text":" that ship as separate library targets ("},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":"). They own their own state slices and action enums, dispatch effects, and must be explicitly wired into the host app’s root types."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each domain plugin stores three wiring pieces:"}],"type":"paragraph"},{"syntax":"swift","code":["private let stateKeyPath: WritableKeyPath<RootState, FeatureState>","private let toRootAction: @Sendable (FeatureAction) -> RootAction","private let extractAction: @Sendable (RootAction) -> FeatureAction?"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The host app provides these at init — the plugin never assumes a specific root type."}],"type":"paragraph"},{"anchor":"Comparison","level":3,"type":"heading","text":"Comparison"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"text":"Core Middleware","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Domain Plugins"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Action knowledge","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"None","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Full — extracts and lifts actions","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Lifecycle hooks","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"willReduce"},{"type":"text","text":" or "},{"type":"codeVoice","code":"afterReduce"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"reduce"},{"text":" only","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Returns effects","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"No","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"State coupling","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"Keypath to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":" or ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" constraint","type":"text"}]}],[{"inlineContent":[{"text":"Keypath to plugin’s own state slice","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Wiring","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"Construction only","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Keypath + action lifter + action extractor","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Target","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"Core ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":" library","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Separate library target","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Opt-in","type":"text"}]}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Instantiate and register","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Add state, action case, and register","type":"text"}]}]]]},{"text":"The Decision Rule","type":"heading","anchor":"The-Decision-Rule","level":2},{"name":"Important","type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Does the middleware need to know your action type? If ","type":"text"},{"inlineContent":[{"text":"no","type":"text"}],"type":"strong"},{"text":", it’s core middleware — put it in ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":" and use ","type":"text"},{"code":"willReduce","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"type":"text","text":". If "},{"type":"strong","inlineContent":[{"text":"yes","type":"text"}]},{"text":", it’s a domain plugin — give it its own target and use ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":".","type":"text"}]}]},{"text":"Hook Selection Guide","type":"heading","anchor":"Hook-Selection-Guide","level":2},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"willReduce(state:action:)"}],"type":"strong"},{"text":" — Capture state ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"text":" the reducer mutates it. State is read-only. Use for snapshots (undo) or pre-mutation analytics.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"reduce(state:action:) -> Effect?"}],"type":"strong"},{"type":"text","text":" — Handle domain-specific actions "},{"inlineContent":[{"type":"text","text":"after"}],"type":"emphasis"},{"text":" the app reducer. Mutate the plugin’s state slice and return effects. This is the only hook that can dispatch actions or do async work.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"afterReduce(state:action:)","type":"codeVoice"}]},{"text":" — Observe state ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"after","type":"text"}]},{"text":" all reducing is done. Use for persistence draining, logging, or metrics. Cannot return effects.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"flush() async","type":"codeVoice"}]},{"text":" — Shutdown hook. Flush pending async buffers (persistence writes, analytics batches). Called once when the app exits.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Registration-Order","type":"heading","text":"Registration Order"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"text":" executes plugins in registration order. Recommended ordering:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)         \/\/ 1. Must snapshot before any mutation","plugins.register(persistencePlugin)  \/\/ 2. Drains changelogs after reducer","plugins.register(killswitchPlugin)   \/\/ 3. Domain plugins in any order","plugins.register(paywallPlugin)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Undo must come first — it snapshots state in "},{"code":"willReduce","type":"codeVoice"},{"text":", before the app reducer or any plugin modifies it. Persistence typically comes next so its ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" drain sees the final state. Domain plugins use only ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":", so their relative order rarely matters.","type":"text"}]},{"level":2,"anchor":"Next-Steps","type":"heading","text":"Next Steps"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},{"text":" — Step-by-step guide to creating a domain plugin","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"reference"},{"text":" — Configure the built-in persistence middleware","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},{"text":" — Add undo\/redo with the built-in undo middleware","type":"text"}]}]}],"type":"unorderedList"}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","interfaceLanguage":"swift"},"sections":[],"references":{"doc://Swidux/documentation/Swidux/Store":{"url":"\/documentation\/swidux\/store","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"navigatorTitle":[{"text":"Store","kind":"identifier"}],"abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"text":" ","type":"text"},{"type":"text","text":"observation layer."}],"title":"Store","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","role":"symbol"},"doc://Swidux/documentation/Swidux/EntityStore":{"url":"\/documentation\/swidux\/entitystore","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}],"navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"title":"EntityStore","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","role":"symbol"},"doc://Swidux/documentation/Swidux/PersistencePlugin":{"type":"topic","url":"\/documentation\/swidux\/persistenceplugin","title":"PersistencePlugin","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"PersistencePlugin","kind":"identifier"}],"abstract":[{"type":"text","text":"Coalescing persistence plugin."}],"navigatorTitle":[{"text":"PersistencePlugin","kind":"identifier"}],"role":"symbol"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","kind":"symbol","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"navigatorTitle":[{"text":"SwiduxPlugin","kind":"identifier"}],"type":"topic","role":"symbol","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SwiduxPlugin"}],"title":"SwiduxPlugin",