{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","interfaceLanguage":"swift"},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Swidux"}],"title":"Plugin Architecture"},"abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"kind":"article","sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Swidux’s plugin system is a single protocol ("},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","isActive":true,"type":"reference"},{"type":"text","text":") with four lifecycle hooks and an ordered registry ("},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","isActive":true,"type":"reference"},{"type":"text","text":"). All store extensibility flows through this contract. The built-in "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"type":"text","text":" use it, and so do domain-specific features like killswitch enforcement and paywall management."}],"type":"paragraph"},{"anchor":"The-Dispatch-Lifecycle","level":2,"text":"The Dispatch Lifecycle","type":"heading"},{"inlineContent":[{"type":"text","text":"Every call to "},{"type":"codeVoice","code":"store.send()"},{"type":"text","text":" drives plugins through a four-phase lifecycle:"}],"type":"paragraph"},{"code":["plugins.willReduce(state:action:)      \/\/ 1. Pre-reduce (read-only state)","appReducer.reduce(state:action:...)    \/\/ 2. App reducer runs","pluginEffects = plugins.reduce(...)    \/\/ 3. Plugin reducers run","plugins.afterReduce(state:action:)     \/\/ 4. Post-reduce cleanup"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The generic ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","isActive":true,"type":"reference"},{"text":" implements this lifecycle internally. You don’t write ","type":"text"},{"code":"send()","type":"codeVoice"},{"text":" by hand — ","type":"text"},{"code":"Store.send()","type":"codeVoice"},{"text":" handles packing, reducing, plugin hooks, unpacking, and effect dispatch.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A fifth method, "},{"code":"flush()","type":"codeVoice"},{"type":"text","text":", runs once at shutdown to drain async buffers."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"All four hooks have default no-op implementations. Each plugin overrides only what it needs."}],"type":"paragraph"},{"anchor":"Core-Plugins-vs-Domain-Plugins","level":2,"text":"Core Plugins vs Domain Plugins","type":"heading"},{"inlineContent":[{"type":"text","text":"The plugin system serves two structurally different roles. Recognizing which one a plugin fills determines where it lives, which hooks it uses, and how it couples to the host app."}],"type":"paragraph"},{"level":3,"anchor":"Core-Plugins","text":"Core Plugins","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"type":"text","text":" are "},{"inlineContent":[{"text":"action-agnostic infrastructure","type":"text"}],"type":"strong"},{"type":"text","text":". They never inspect the "},{"code":"Action","type":"codeVoice"},{"type":"text","text":" type, never dispatch actions, and never return effects. They couple only to the shape of state:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"type":"text","text":" needs keypaths to "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":" properties."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"type":"text","text":" needs "},{"type":"codeVoice","code":"State: Equatable"},{"type":"text","text":" so it can snapshot and compare."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Because they don’t touch actions, they work with any app that uses Swidux — no wiring required beyond construction."}],"type":"paragraph"},{"level":3,"anchor":"Domain-Plugins","type":"heading","text":"Domain Plugins"},{"inlineContent":[{"text":"Killswitch, parental gate, and paywall plugins are ","type":"text"},{"inlineContent":[{"text":"domain-specific modules","type":"text"}],"type":"strong"},{"text":" that ship as separate library targets (","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":"). They own their own state slices and action enums, dispatch effects, and must be explicitly wired into the host app’s root types.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each domain plugin stores three wiring pieces:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["private let stateKeyPath: WritableKeyPath<RootState, FeatureState>","private let toRootAction: @Sendable (FeatureAction) -> RootAction","private let extractAction: @Sendable (RootAction) -> FeatureAction?"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The host app provides these at init — the plugin never assumes a specific root type."}],"type":"paragraph"},{"level":3,"anchor":"Importing-at-call-sites","type":"heading","text":"Importing at call sites"},{"inlineContent":[{"text":"Because each domain plugin ships as a ","type":"text"},{"inlineContent":[{"text":"separate library target","type":"text"}],"type":"strong"},{"text":", its state and action types are defined in that module — not in ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":". A common convention is to re-export core Swidux from ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":", but that re-exports ","type":"text"},{"inlineContent":[{"text":"core Swidux only","type":"text"}],"type":"strong"},{"text":"; it does not re-export the plugin modules.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"So any file that reads a plugin-owned slice ("},{"code":"store.analytics.*","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"store.paywall.*"},{"type":"text","text":", "},{"type":"codeVoice","code":"store.killswitch.*"},{"type":"text","text":", …) or dispatches a plugin action ("},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":", …) must import that plugin’s module in "},{"type":"strong","inlineContent":[{"type":"text","text":"that"}]},{"type":"text","text":" file:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"touches "},{"type":"codeVoice","code":"store.analytics.*"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"AnalyticsAction"},{"type":"text","text":" → "},{"type":"codeVoice","code":"import SwiduxAnalytics"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"touches ","type":"text"},{"code":"store.paywall.*","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"import SwiduxPaywall","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"touches only ","type":"text"},{"code":"store.ui","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".ui(...)","type":"codeVoice"},{"text":" (app-module types) → nothing extra","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The easy case to forget is a "},{"type":"strong","inlineContent":[{"type":"text","text":"View"}]},{"type":"text","text":" that reads the slice for display — "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AppAction.swift"},{"type":"text","text":" already import the module, but the View is a different file. Without the import you get:"}],"type":"paragraph"},{"code":["property 'isOptedOut' is not available due to missing import of defining module 'SwiduxAnalytics'","property 'isPro' is not available due to missing import of defining module 'SwiduxPaywall'"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The fix is to add "},{"type":"codeVoice","code":"import Swidux<Plugin>"},{"type":"text","text":" to that file."}],"type":"paragraph"},{"anchor":"Comparison","level":3,"text":"Comparison","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Core Plugins"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Domain Plugins"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action knowledge"}]}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"None"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Full — extracts and lifts actions"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Lifecycle hooks","type":"text"}]}]}],[{"inlineContent":[{"type":"codeVoice","code":"willReduce"},{"type":"text","text":" or "},{"type":"codeVoice","code":"afterReduce"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"reduce"},{"type":"text","text":", plus "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" to react to every dispatch"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Returns effects","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"State coupling","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"Keypath to ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" constraint"}]}],[{"inlineContent":[{"type":"text","text":"Keypath to plugin’s own state slice"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Wiring"}],"type":"strong"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Construction only"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Keypath + action lifter + action extractor","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Target","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Core "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" library"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Separate library target"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Opt-in","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Instantiate and register"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Add state, action case, and register"}],"type":"paragraph"}]]],"type":"table"},{"anchor":"The-Decision-Rule","level":2,"text":"The Decision Rule","type":"heading"},{"style":"important","name":"Important","content":[{"inlineContent":[{"type":"text","text":"Does the plugin need to know your action type? If "},{"type":"strong","inlineContent":[{"text":"no","type":"text"}]},{"type":"text","text":", it’s a core plugin — put it in "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" and use "},{"type":"codeVoice","code":"willReduce"},{"type":"text","text":" or "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":". If "},{"type":"strong","inlineContent":[{"text":"yes","type":"text"}]},{"type":"text","text":", it’s a domain plugin — give it its own target and handle its own actions in "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":". A domain plugin that must also react to every dispatch, as "},{"type":"codeVoice","code":"AnalyticsPlugin"},{"type":"text","text":" and "},{"type":"codeVoice","code":"FeatureFlagsPlugin"},{"type":"text","text":" do, adds "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside"},{"anchor":"Hook-Selection-Guide","level":2,"text":"Hook Selection Guide","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"willReduce(state:action:)","type":"codeVoice"}],"type":"strong"},{"text":" — Capture state ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"emphasis"},{"text":" the reducer mutates it. State is read-only. Use for snapshots (undo) or pre-mutation analytics.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"reduce(state:action:) -> Effect?","type":"codeVoice"}],"type":"strong"},{"text":" — Handle domain-specific actions ","type":"text"},{"inlineContent":[{"type":"text","text":"after"}],"type":"emphasis"},{"text":" the app reducer. Mutate the plugin’s state slice and return effects. This is the only hook that can dispatch actions or do async work.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"afterReduce(state:action:)","type":"codeVoice"}],"type":"strong"},{"text":" — Observe state ","type":"text"},{"inlineContent":[{"type":"text","text":"after"}],"type":"emphasis"},{"text":" all reducing is done. Use for persistence draining, logging, or metrics. Cannot return effects.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"flush() async","type":"codeVoice"}],"type":"strong"},{"text":" — Shutdown hook. Flush pending async buffers (persistence writes, analytics batches). Called once when the app exits.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Registration-Order","level":2,"text":"Registration Order","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","isActive":true,"type":"reference"},{"text":" executes plugins in registration order. Recommended ordering:","type":"text"}],"type":"paragraph"},{"code":["let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)         \/\/ 1. Must snapshot before any mutation","plugins.register(persistencePlugin)  \/\/ 2. Drains changelogs after reducer","plugins.register(killswitchPlugin)   \/\/ 3. Domain plugins in any order","plugins.register(paywallPlugin)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Undo must come first — it snapshots state in ","type":"text"},{"code":"willReduce","type":"codeVoice"},{"text":", before the app reducer or any plugin modifies it. Persistence typically comes next so its ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" drain sees the final state. Domain plugins handle their own actions in ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":", so their relative order rarely matters.","type":"text"}],"type":"paragraph"},{"anchor":"Service-Result-Actions-and-Transition-Observation","level":2,"text":"Service-Result Actions and Transition Observation","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"inlineContent":[{"type":"text","text":"service-result action"}],"type":"emphasis"},{"text":" — ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"customerInfoUpdated","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"KillswitchPlugin","type":"codeVoice"},{"text":"’s ","type":"text"},{"code":"verdictReceived","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FeatureFlagsPlugin","type":"codeVoice"},{"text":"’s","type":"text"},{"text":" ","type":"text"},{"code":"refreshSucceeded","type":"codeVoice"},{"text":" — fires on ","type":"text"},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"text":" fetch, refresh, or stream tick, not","type":"text"},{"text":" ","type":"text"},{"text":"only when the value changed, and unconditionally writes its payload to the","type":"text"},{"text":" ","type":"text"},{"text":"state slice. The payload is frequently identical to what is already there","type":"text"},{"text":" ","type":"text"},{"text":"(a re-delivered entitlement, an unchanged remote config).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Do ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" map analytics or side effects to the raw service-result action:","type":"text"},{"text":" ","type":"text"},{"text":"it fires duplicates by design. Observe the ","type":"text"},{"inlineContent":[{"type":"text","text":"state slice"}],"type":"strong"},{"text":" — or a value","type":"text"},{"text":" ","type":"text"},{"text":"derived from it — instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"State observation is already deduplicated by the framework. ","type":"text"},{"code":"Store.send","type":"codeVoice"},{"text":" ","type":"text"},{"text":"packs the observer into a value-type snapshot, lets reducers mutate the","type":"text"},{"text":" ","type":"text"},{"text":"snapshot, then writes back via ","type":"text"},{"code":"State.apply","type":"codeVoice"},{"text":". For a leaf slice that write","type":"text"},{"text":" ","type":"text"},{"text":"is a plain assignment whose ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" setter equality-gates ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" ","type":"text"},{"text":"values, so a slice whose value did not change emits no notification — and a","type":"text"},{"text":" ","type":"text"},{"text":"value-diffing consumer such as ","type":"text"},{"code":"AnalyticsIdentity.userProperties","type":"codeVoice"},{"text":" (which","type":"text"},{"text":" ","type":"text"},{"code":"AnalyticsPlugin","type":"codeVoice"},{"text":" re-evaluates and diffs every non-analytics dispatch) sees exactly the","type":"text"},{"text":" ","type":"text"},{"text":"real transitions. This dedup is a property of the ","type":"text"},{"code":"Store","type":"codeVoice"},{"text":", not of any","type":"text"},{"text":" ","type":"text"},{"text":"per-plugin guard, so a no-op service-result cycle is silent to state","type":"text"},{"text":" ","type":"text"},{"text":"observers without any extra reducer logic.","type":"text"}],"type":"paragraph"},{"anchor":"Next-Steps","level":2,"text":"Next Steps","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","isActive":true,"type":"reference"},{"text":" — Step-by-step guide to creating a domain plugin","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","isActive":true,"type":"reference"},{"text":" — Configure the built-in persistence plugin","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","isActive":true,"type":"reference"},{"text":" — Add undo\/redo with the built-in undo plugin","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"seeAlsoSections":[{"anchor":"Explanation","generated":true,"title":"Explanation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]}],"variants":[{"paths":["\/documentation\/swidux\/pluginarchitecture"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://Swidux/documentation/Swidux/EntityStore":{"role":"symbol","title":"EntityStore","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityStore"}],"navigatorTitle":[{"kind":"identifier","text":"EntityStore"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"url":"\/documentation\/swidux\/entitystore","type":"topic"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"role":"article","kind":"article","title":"Building a Domain Plugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"url":"\/documentation\/swidux\/buildingadomainplugin","type":"topic"},"doc://Swidux/documentation/Swidux/SwiduxPlugin":{"role":"symbol","url":"\/documentation\/swidux\/swiduxplugin","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiduxPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","title":"SwiduxPlugin","abstract":[{"type":"text","text":"A plugin that participates in the Swidux dispatch cycle."}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"SwiduxPlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/SecurityPosture":{"role":"collectionGroup","kind":"article","title":"Security Posture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","abstract":[{"text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one.","type":"text"}],"url":"\/documentation\/swidux\/securityposture","type":"topic"},"doc://Swidux/documentation/Swidux/PersistencePlugin":{"type":"topic","kind":"symbol","url":"\/documentation\/swidux\/persistenceplugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","abstract":[{"type":"text","text":"Coalescing persistence plugin."}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistencePlugin","kind":"identifier"}],"navigatorTitle":[{"text":"PersistencePlugin","kind":"identifier"}],"title":"PersistencePlugin"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","title":"Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"url":"\/documentation\/swidux","type":"topic","role":"collection"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"role":"article","kind":"article","title":"Architecture & Performance","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","abstract":[{"text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system.","type":"text"}],"url":"\/documentation\/swidux\/architectureguide","type":"topic"},"doc://Swidux/documentation/Swidux/Store":{"role":"symbol","title":"Store","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Store"}],"navigatorTitle":[{"kind":"identifier","text":"Store"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"type":"text","text":"observation layer."}],"url":"\/documentation\/swidux\/store","type":"topic"},"doc://Swidux/documentation/Swidux/UndoRedo":{"abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":".","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"topic","title":"Undo \/ Redo","kind":"article","role":"article","url":"\/documentation\/swidux\/undoredo"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"role":"symbol","kind":"symbol","title":"UndoPlugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"url":"\/documentation\/swidux\/undoplugin","type":"topic"},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"role":"article","title":"Design Principles","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","abstract":[{"type":"text","text":"The 10 rules that shape every Swidux app, and the reasoning behind them."}],"url":"\/documentation\/swidux\/designprinciples","type":"topic"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"topic","title":"Persistence Plugin","kind":"article","role":"article","url":"\/documentation\/swidux\/persistencemiddlewareguide"},"doc://Swidux/documentation/Swidux/PluginHost":{"role":"symbol","title":"PluginHost","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PluginHost","kind":"identifier"}],"navigatorTitle":[{"text":"PluginHost","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","abstract":[{"text":"Ordered registry of plugins that drives the dispatch lifecycle.","type":"text"}],"url":"\/documentation\/swidux\/pluginhost","type":"topic"}}}