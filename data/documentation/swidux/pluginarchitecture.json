,"kind":"symbol","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityStore"}],"navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"abstract":[{"type":"text","text":"An ordered, keyed collection of identifiable entities that silently records"},{"type":"text","text":" "},{"type":"text","text":"every mutation for downstream persistence."}],"role":"symbol"},"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"title":"Architecture & Performance","url":"\/documentation\/swidux\/architectureguide","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","abstract":[{"type":"text","text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system."}],"role":"article"},"doc://Swidux/documentation/Swidux/SecurityPosture":{"title":"Security Posture","url":"\/documentation\/swidux\/securityposture","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","abstract":[{"type":"text","text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one."}],"role":"collectionGroup"},"doc://Swidux/documentation/Swidux/PersistencePlugin":{"navigatorTitle":[{"kind":"identifier","text":"PersistencePlugin"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","url":"\/documentation\/swidux\/persistenceplugin","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Coalescing persistence plugin."}],"title":"PersistencePlugin","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistencePlugin"}]},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","url":"\/documentation\/swidux\/buildingadomainplugin","type":"topic","role":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"title":"Building a Domain Plugin","kind":"article"}}}