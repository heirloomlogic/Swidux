{"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":" works like a dictionary with insertion-order iteration. Entities must conform to "},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"type":"text","text":" with "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" as the ID type."}]},{"type":"codeListing","code":["var cards = EntityStore<Card>()","","cards[card.id] = card                      \/\/ Insert or update — recorded","cards.modify(card.id) { $0.title = \"New\" } \/\/ In-place — recorded only if value changes","cards[card.id] = nil                       \/\/ Delete — recorded","","let card = cards[cardID]                   \/\/ O(1) lookup","let all  = cards.values                    \/\/ Insertion-ordered array","","cards.sort { $0.sortIndex < $1.sortIndex } \/\/ Only marks moved entities","cards.removeAll { $0.isArchived }          \/\/ Rebuilds index in one pass"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every mutation is tracked in a "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","type":"reference"},{"type":"text","text":" that the middleware drains after each reducer call."}]},{"type":"heading","text":"Merging (Re-hydration)","level":2,"anchor":"Merging-Re-hydration"},{"inlineContent":[{"type":"text","text":"Replacing an "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":" after startup destroys any in-memory state that was loaded lazily after initial hydration. Use "},{"type":"codeVoice","code":"merge(from:preferExisting:)"},{"type":"text","text":" instead:"}],"type":"paragraph"},{"type":"codeListing","code":["var merged = EntityStore(allFromDB)","merged.merge(from: existingStore) { existing, incoming in","    existing.calculationState != nil && incoming.calculationState == nil","}","campaigns = merged"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"merge"},{"type":"text","text":" does not record changes — it has hydration semantics like "},{"type":"codeVoice","code":"init(_:)"},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"restore(from:)","anchor":"restorefrom"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"restore(from:)"},{"type":"text","text":" replaces all entities with those from the source store while recording the diff as changes for persistence. Used by undo\/redo (see "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"reference"},{"type":"text","text":")."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Deletions","type":"text"}]},{"type":"text","text":" — IDs in self but absent from source"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Upserts","type":"text"}]},{"type":"text","text":" — IDs that are new or whose values differ"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Unchanged","type":"text"}]},{"type":"text","text":" — identical values produce no change records"}]}]}],"type":"unorderedList"}]}],"abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Reference","generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPayw