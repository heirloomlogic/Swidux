"}],"type":"topic","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","url":"\/documentation\/swidux\/entitystore","kind":"symbol","role":"symbol"}}}