{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"kind":"article","identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference","generated":true,"anchor":"Reference"}],"abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"text":" works like a dictionary with insertion-order iteration. Entities must conform to ","type":"text"},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"UUID"},{"text":" as the ID type.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["var cards = EntityStore<Card>()","","cards[card.id] = card                      \/\/ Insert or update — recorded","cards.modify(card.id) { $0.title = \"New\" } \/\/ In-place — recorded only if value changes","cards[card.id] = nil                       \/\/ Delete — recorded","","let card = cards[cardID]                   \/\/ O(1) lookup","let all  = cards.values                    \/\/ Insertion-ordered array","","cards.sort { $0.sortIndex < $1.sortIndex } \/\/ Only marks moved entities","cards.removeAll { $0.isArchived }          \/\/ Rebuilds index in one pass"]},{"type":"paragraph","inlineContent":[{"text":"Every mutation is tracked in a ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","isActive":true},{"text":" that the middleware drains after each reducer call.","type":"text"}]},{"type":"heading","text":"Bulk Deletion","level":2,"anchor":"Bulk-Deletion"},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"type":"codeVoice","code":"cards[id] = nil"},{"text":" shifts the storage array’s tail and reindexes the shifted entries — O(tail) per delete, so a loop of k subscript deletes costs O(n·k). To delete many entities at once, use ","type":"text"},{"type":"codeVoice","code":"remove(ids:)"},{"text":" (when you have the IDs) or ","type":"text"},{"type":"codeVoice","code":"removeAll(where:)"},{"text":" (when you have a predicate) instead: both remove everything in a single pass with one index rebuild, record the same deletions, and cancel pending upserts exactly like the subscript.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["cards.remove(ids: selection)          \/\/ One pass, not a subscript loop","cards.removeAll { $0.isArchived }"]},{"type":"heading","text":"Merging (Re-hydration)","level":2,"anchor":"Merging-Re-hydration"},{"inlineContent":[{"text":"Replacing an ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" after startup destroys any in-memory state that was loaded lazily after initial hydration. Use ","type":"text"},{"code":"merge(from:shouldReplace:)","type":"codeVoice"},{"text":" instead — entities only in the other store are always added, and the closure decides whether an incoming value overwrites the current one:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Absorb DB rows; take an incoming row only when the current one","\/\/ lacks lazily-computed data.","campaigns.merge(from: EntityStore(allFromDB)) { current, incoming in","    current.calculationState == nil && incoming.calculationState != nil","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"merge","type":"codeVoice"},{"type":"text","text":" does not record changes — it has hydration semantics like "},{"code":"init(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"text":"reconcile vs merge","anchor":"reconcile-vs-merge","type":"heading"},{"inlineContent":[{"type":"text","text":"The two answer different questions:"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"merge(from:shouldReplace:)","type":"codeVoice"}]}],[{"inlineContent":[{"code":"reconcile(with:preserving:removingMissing:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"Stance","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Keep everything, absorb what’s new","type":"text"}]}],[{"inlineContent":[{"text":"Storage is authoritative ","type":"text"},{"inlineContent":[{"type":"text","text":"except"}],"type":"strong"},{"text":" where you say otherwise","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Removes rows"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Never","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"removingMissing"},{"type":"text","text":" and the ID isn’t preserved"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"Conflicts","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Your closure decides, per pair"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Storage wins unless the ID is preserved","type":"text"}]}]]],"type":"table"},{"inlineContent":[{"type":"codeVoice","code":"reconcile"},{"type":"text","text":" is what lets a remote edit or a remote deletion surface mid-session rather than waiting for the next launch. "},{"code":"preserving","type":"codeVoice"},{"type":"text","text":" is the caller’s list of IDs that carry unflushed local intent; the store’s own un-drained "},{"code":"changes","type":"codeVoice"},{"type":"text","text":" are folded in automatically, so a pending local deletion is never resurrected even when "},{"code":"preserving","type":"codeVoice"},{"type":"text","text":" is empty."}],"type":"paragraph"},{"syntax":"swift","code":["cards.reconcile(with: EntityStore(rowsFromDisk), preserving: dirtyIDs, removingMissing: true)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Like "},{"code":"merge","type":"codeVoice"},{"type":"text","text":", it records no changes — every value it writes or removes already reflects what is in storage, so recording them would echo each remote change straight back as a local write."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Most apps never call this directly; "},{"code":"PersistenceCoordinator.rehydrate(into:)","type":"codeVoice"},{"type":"text","text":" does, and computes "},{"code":"preserving","type":"codeVoice"},{"type":"text","text":" for you."}],"type":"paragraph"},{"level":2,"text":"restore(from:)","anchor":"restorefrom","type":"heading"},{"inlineContent":[{"code":"restore(from:)","type":"codeVoice"},{"type":"text","text":" replaces all entities with those from the source store while recording the diff as changes for persistence. Used by undo\/redo (see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},{"type":"text","text":")."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Deletions","type":"text"}]},{"type":"text","text":" — IDs in self but absent from source"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Upserts","type":"text"}]},{"type":"text","text":" — IDs that are new or whose values differ"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Unchanged","type":"text"}]},{"type":"text","text":" — identical values produce no change records"}]}]}],"type":"unorderedList"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/entitystoreguide"]}],"metadata":{"role":"article","modules":[{"name":"Swidux"}],"title":"EntityStore","roleHeading":"Article"},"references":{"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","url":"\/documentation\/swidux\/pluginanalyticsreference","type":"topic","title":"SwiduxAnalytics Reference","role":"article","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}]},"doc://Swidux/documentation/Swidux/MacrosReference":{"role":"article","abstract":[{"type":"text","text":"Reference for "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" and "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":")."}],"title":"Macros","kind":"article","type":"topic","url":"\/documentation\/swidux\/macrosreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Macros