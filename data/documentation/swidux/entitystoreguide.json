{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" works like a dictionary with insertion-order iteration. Entities must conform to "},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"type":"text","text":" with "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" as the ID type."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var cards = EntityStore<Card>()","","cards[card.id] = card                      \/\/ Insert or update — recorded","cards.modify(card.id) { $0.title = \"New\" } \/\/ In-place — recorded only if value changes","cards[card.id] = nil                       \/\/ Delete — recorded","","let card = cards[cardID]                   \/\/ O(1) lookup","let all  = cards.values                    \/\/ Insertion-ordered array","","cards.sort { $0.sortIndex < $1.sortIndex } \/\/ Only marks moved entities","cards.removeAll { $0.isArchived }          \/\/ Rebuilds index in one pass"]},{"inlineContent":[{"type":"text","text":"Every mutation is tracked in a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet"},{"type":"text","text":" that the middleware drains after each reducer call."}],"type":"paragraph"},{"text":"Merging (Re-hydration)","type":"heading","level":2,"anchor":"Merging-Re-hydration"},{"inlineContent":[{"type":"text","text":"Replacing an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" after startup destroys any in-memory state that was loaded lazily after initial hydration. Use "},{"type":"codeVoice","code":"merge(from:preferExisting:)"},{"type":"text","text":" instead:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var merged = EntityStore(allFromDB)","merged.merge(from: existingStore) { existing, incoming in","    existing.calculationState != nil && incoming.calculationState == nil","}","campaigns = merged"]},{"inlineContent":[{"type":"codeVoice","code":"merge"},{"type":"text","text":" does not record changes — it has hydration semantics like "},{"type":"codeVoice","code":"init(_:)"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"restore(from:)","type":"heading","level":2,"anchor":"restorefrom"},{"inlineContent":[{"type":"codeVoice","code":"restore(from:)"},{"type":"text","text":" replaces all entities with those from the source store while recording the diff as changes for persistence. Used by undo\/redo (see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},{"type":"text","text":")."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Deletions","type":"text"}]},{"text":" — IDs in self but absent from source","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Upserts","type":"text"}]},{"text":" — IDs that are new or whose values differ","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Unchanged","type":"text"}]},{"text":" — identical values produce no change records","type":"text"}]}]}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","title":"EntityStore","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/entitystoreguide"]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","interfaceLanguage":"swift"},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosRe