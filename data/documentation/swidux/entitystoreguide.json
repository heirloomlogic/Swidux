t one:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Absorb DB rows; take an incoming row only when the current one","\/\/ lacks lazily-computed data.","campaigns.merge(from: EntityStore(allFromDB)) { current, incoming in","    current.calculationState == nil && incoming.calculationState != nil","}"],"type":"codeListing"},{"inlineContent":[{"code":"merge","type":"codeVoice"},{"text":" does not record changes — it has hydration semantics like ","type":"text"},{"code":"init(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"restore(from:)","anchor":"restorefrom","type":"heading","level":2},{"inlineContent":[{"code":"restore(from:)","type":"codeVoice"},{"text":" replaces all entities with those from the source store while recording the diff as changes for persistence. Used by undo\/redo (see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","isActive":true},{"text":").","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Deletions","type":"text"}],"type":"strong"},{"text":" — IDs in self but absent from source","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Upserts","type":"text"}],"type":"strong"},{"text":" — IDs that are new or whose values differ","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Unchanged","type":"text"}],"type":"strong"},{"text":" — identical values produce no change records","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"references":{"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","type":"topic","k