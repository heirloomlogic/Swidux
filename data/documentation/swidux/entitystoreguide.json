{"abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"kind":"article","seeAlsoSections":[{"title":"Reference","generated":true,"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"]}],"sections":[],"metadata":{"title":"EntityStore","roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":" works like a dictionary with insertion-order iteration. Entities must conform to ","type":"text"},{"code":"Identifiable & Equatable & Sendable","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"UUID","type":"codeVoice"},{"text":" as the ID type.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var cards = EntityStore<Card>()","","cards[card.id] = card                      \/\/ Insert or update — recorded","cards.modify(card.id) { $0.title = \"New\" } \/\/ In-place — recorded only if value changes","cards[card.id] = nil                       \/\/ Delete — recorded","","let card = cards[cardID]                   \/\/ O(1) lookup","let all  = cards.values                    \/\/ Insertion-ordered array","","cards.sort { $0.sortIndex < $1.sortIndex } \/\/ Only marks moved entities","cards.removeAll { $0.isArchived }          \/\/ Rebuilds index in one pass"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every mutation is tracked in a "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","isActive":true,"type":"reference"},{"text":" that the middleware drains after each reducer call.","type":"text"}]},{"text":"Bulk Deletion","level":2,"type":"heading","anchor":"Bulk-Deletion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"code":"cards[id] = nil","type":"codeVoice"},{"type":"text","text":" shifts the storage array’s tail and reindexes the shifted entries — O(tail) per delete, so a loop of k subscript deletes costs O(n·k). To delete many entities at once, use "},{"code":"remove(ids:)","type":"codeVoice"},{"type":"text","text":" (when you have the IDs) or "},{"code":"removeAll(where:)","type":"codeVoice"},{"type":"text","text":" (when you have a predicate) instead: both remove everything in a single pass with one index rebuild, record the same deletions, and cancel pending upserts exactly like the subscript."}]},{"syntax":"swift","code":["cards.remove(ids: selection)          \/\/ One pass, not a subscript loop","cards.removeAll { $0.isArchived }"],"type":"codeListing"},{"text":"Merging (Re-hydration)","level":2,"type":"heading","anchor":"Merging-Re-hydration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replacing an "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" after startup destroys any in-memory state that was loaded lazily after initial hydration. Use "},{"code":"merge(from:shouldReplace:)","type":"codeVoice"},{"type":"text","text":" instead — entities only in the other store are always added, and the closure decides whether an incoming value overwrites the current one:"}]},{"syntax":"swift","code":["\/\/ Absorb DB rows; take an incoming row only when the current one","\/\/ lacks lazily-computed data.","campaigns.merge(from: EntityStore(allFromDB)) { current, incoming in","    current.calculationState == nil && incoming.calculationState != nil","}"],"type":"codeListing"},{"inlineContent":[{"code":"merge","type":"codeVoice"},{"type":"text","text":" does not record changes — it has hydration semantics like "},{"code":"init(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","text":"reconcile vs merge","anchor":"reconcile-vs-merge","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The two answer different questions:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[]}],[{"inlineContent":[{"code":"merge(from:shouldReplace:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"reconcile(with:preserving:removingMissing:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Stance","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Keep everything, absorb what’s new","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Storage is authoritative ","type":"text"},{"type":"strong","inlineContent":[{"text":"except","type":"text"}]},{"text":" where you say otherwise","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Removes rows","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Never","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When ","type":"text"},{"code":"removingMissing","type":"codeVoice"},{"text":" and the ID isn’t preserved","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Conflicts","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Your closure decides, per pair","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Storage wins unless the ID is preserved","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"reconcile"},{"type":"text","text":" is what lets a remote edit or a remote deletion surface mid-session rather than waiting for the next launch. "},{"type":"codeVoice","code":"preserving"},{"type":"text","text":" is the caller’s list of IDs that carry unflushed local intent; the store’s own un-drained "},{"type":"codeVoice","code":"changes"},{"type":"text","text":" are folded in automatically, so a pending local deletion is never resurrected even when "},{"type":"codeVoice","code":"preserving"},{"type":"text","text":" is empty."}]},{"syntax":"swift","code":["cards.reconcile(with: EntityStore(rowsFromDisk), preserving: dirtyIDs, removingMissing: true)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Like "},{"type":"codeVoice","code":"merge"},{"type":"text","text":", it records no changes — every value it writes or removes already reflects what is in storage, so recording them would echo each remote change straight back as a local write."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most apps never call this directly; "},{"type":"codeVoice","code":"PersistenceCoordinator.rehydrate(into:)"},{"type":"text","text":" does, and computes "},{"type":"codeVoice","code":"preserving"},{"type":"text","text":" for you."}]},{"type":"heading","text":"restore(from:)","anchor":"restorefrom","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"restore(from:)"},{"type":"text","text":" replaces all entities with those from the source store while recording the diff as changes for persistence. Used by undo\/redo (see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","isActive":true},{"type":"text","text":")."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Deletions"}],"type":"strong"},{"text":" — IDs in self but absent from source","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Upserts"}],"type":"strong"},{"text":" — IDs that are new or whose values differ","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Unchanged"}],"type":"strong"},{"text":" — identical values produce no change records","type":"text"}]}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/entitystoreguide"]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","interfaceLanguage":"swift"},"references":{"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"role":"collectionGroup","title":"KeyValueStore","kind":"article","type":"topic","url":"\/documentation\/swidux\/keyvaluestoreguide","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","kind":"symbol","role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux","type":"topic","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}]},"doc://Swidux/documentation/Swidux/MacrosReference":{"url":"\/documentation\/swidux\/macrosreference","kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","title":"Macros","type":"topic","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" and its property markers (the SwiftData persistence bridge, shipped in ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":").","type":"text"}]},"doc://Swidux/documentation/Swidux/EntityStore":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}],"navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"title":"EntityStore","kind":"symbol","type":"topic","url":"\/documentation\/swidux\/entitystore","abstract":[{"type":"text","text":"An ordered, keyed collection of identifiable entities that silently records"},{"type":"text","text":" "},{"type":"text","text":"every mutation for downstream persistence."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},"doc://Swidux/documentation/Swidux/UndoRedo":{"role":"article","title":"Undo \/ Redo","kind":"article","type":"topic","url":"\/documentation\/swidux\/undoredo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":"."}]},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"role":"article","title":"SwiduxPaywall Reference","kind":"article","type":"topic","url":"\/documentation\/swidux\/pluginpaywallreference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"url":"\/documentation\/swidux\/pluginparentalgatereference","kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documen