{"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"seeAlsoSections":[{"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference","generated":true}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":" works like a dictionary with insertion-order iteration. Entities must conform to "},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"type":"text","text":" with "},{"type":"codeVoice","code":"UUID"},{"text":" as the ID type.","type":"text"}]},{"type":"codeListing","code":["var cards = EntityStore<Card>()","","cards[card.id] = card                      \/\/ Insert or update — recorded","cards.modify(card.id) { $0.title = \"New\" } \/\/ In-place — recorded only if value changes","cards[card.id] = nil                       \/\/ Delete — recorded","","let card = cards[cardID]                   \/\/ O(1) lookup","let all  = cards.values                    \/\/ Insertion-ordered array","","cards.sort { $0.sortIndex < $1.sortIndex } \/\/ Only marks moved entities","cards.removeAll { $0.isArchived }          \/\/ Rebuilds index in one pass"],"syntax":"swift"},{"inlineContent":[{"text":"Every mutation is tracked in a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","type":"reference"},{"text":" that the middleware drains after each reducer call.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Bulk Deletion","anchor":"Bulk-Deletion"},{"inlineContent":[{"text":"Each ","type":"text"},{"code":"cards[id] = nil","type":"codeVoice"},{"text":" shifts the storage array’s tail and reindexes the shifted entries — O(tail) per delete, so a loop of k subscript deletes costs O(n·k). To delete many entities at once, use ","type":"text"},{"code":"remove(ids:)","type":"codeVoice"},{"text":" (when you have the IDs) or ","type":"text"},{"code":"removeAll(where:)","type":"codeVoice"},{"text":" (when you have a predicate) instead: both remove everything in a single pass with one index rebuild, record the same deletions, and cancel pending upserts exactly like the subscript.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["cards.remove(ids: selection)          \/\/ One pass, not a subscript loop","cards.removeAll { $0.isArchived }"],"syntax":"swift"},{"level":2,"type":"heading","text":"Merging (Re-hydration)","anchor":"Merging-Re-hydration"},{"inlineContent":[{"type":"text","text":"Replacing an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" after startup destroys any in-memory state that was loaded lazily after initial hydration. Use "},{"type":"codeVoice","code":"merge(from:shouldReplace:)"},{"type":"text","text":" instead — entities only in the other store are always added, and the closure decides whether an incoming value overwrites the current one:"}],"type":"paragraph"},{"code":["\/\/ Absorb DB rows; take an incoming row only when the current one","\/\/ lacks lazily-computed data.","campaigns.merge(from: EntityStore(allFromDB)) { current, incoming in","    current.calculationState == nil && incoming.calculationState != nil","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"merge","type":"codeVoice"},{"type":"text","text":" does not record changes — it has hydration semantics like "},{"code":"init(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"reconcile vs merge","anchor":"reconcile-vs-merge"},{"inlineContent":[{"text":"The two answer different questions:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"merge(from:shouldReplace:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"reconcile(with:preserving:removingMissing:)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stance"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep everything, absorb what’s new"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Storage is authoritative "},{"inlineContent":[{"type":"text","text":"except"}],"type":"strong"},{"text":" where you say otherwise","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Removes rows","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Never","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"removingMissing","type":"codeVoice"},{"type":"text","text":" and the ID isn’t preserved"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conflicts"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your closure decides, per pair"}]}],[{"type":"paragraph","inlineContent":[{"text":"Storage wins unless the ID is preserved","type":"text"}]}]]]},{"inlineContent":[{"type":"codeVoice","code":"reconcile"},{"type":"text","text":" is what lets a remote edit or a remote deletion surface mid-session rather than waiting for the next launch. "},{"type":"codeVoice","code":"preserving"},{"type":"text","text":" is the caller’s list of IDs that carry unflushed local intent; the store’s own un-drained "},{"code":"changes","type":"codeVoice"},{"type":"text","text":" are folded in automatically, so a pending local deletion is never resurrected even when "},{"code":"preserving","type":"codeVoice"},{"text":" is empty.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["cards.reconcile(with: EntityStore(rowsFromDisk), preserving: dirtyIDs, removingMissing: true)"]},{"inlineContent":[{"type":"text","text":"Like "},{"type":"codeVoice","code":"merge"},{"type":"text","text":", it records no changes — every value it writes or removes already reflects what is in storage, so recording them would echo each remote change straight back as a local write."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Most apps never call this directly; ","type":"text"},{"type":"codeVoice","code":"PersistenceCoordinator.rehydrate(into:)"},{"text":" does, and computes ","type":"text"},{"type":"codeVoice","code":"preserving"},{"type":"text","text":" for you."}]},{"level":2,"type":"heading","text":"restore(from:)","anchor":"restorefrom"},{"inlineContent":[{"code":"restore(from:)","type":"codeVoice"},{"text":" replaces all entities with those from the source store while recording the diff as changes for persistence. Used by undo\/redo (see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"reference"},{"text":").","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Deletions"}]},{"text":" — IDs in self but absent from source","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Upserts"}],"type":"strong"},{"text":" — IDs that are new or whose values differ","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Unchanged"}]},{"text":" — identical values produce no change records","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"type":"heading","text":"Remote deletions are not undoable","anchor":"Remote-deletions-are-not-undoable"},{"inlineContent":[{"type":"text","text":"One class of ID is skipped: anything "},{"type":"codeVoice","code":"reconcile"},{"type":"text","text":" removed because storage no longer held it. Those IDs are kept in "},{"type":"codeVoice","code":"remotelyRemovedIDs"},{"type":"text","text":", and "},{"type":"codeVoice","code":"restore"},{"type":"text","text":" will neither re-add them nor record a change for them."}],"type":"paragraph"},{"inlineContent":[{"text":"Without that, undo resurrects rows other devices deleted. An undo snapshot taken before the deletion still contains the entity, so restoring it records an ","type":"text"},{"inlineContent":[{"type":"text","text":"upsert"}],"type":"strong"},{"text":" — which flushes as a ","type":"text"},{"inlineContent":[{"type":"text","text":"creation"}],"type":"emphasis"},{"text":" and re-seeds every peer that had already agreed the row was gone. Undo is scoped to what the local user did; a deletion made on another device isn’t that.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"An ID leaves the set as soon as it becomes local again — an explicit ","type":"text"},{"code":"store[id] = entity","type":"codeVoice"},{"text":", or storage handing the row back on a later merge — so a row that another device deletes and then restores is undoable once more. The set survives ","type":"text"},{"code":"resetChanges()","type":"codeVoice"},{"type":"text","text":", because a flush ends a pending write’s life, not a deletion’s."}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ \"3 items were deleted on another device.\"","cards.remotelyRemovedIDs.count"],"syntax":"swift"},{"inlineContent":[{"text":"Stores that never sync never populate it, and ","type":"text"},{"type":"codeVoice","code":"restore"},{"text":" takes exactly the path it did before.","type":"text"}],"type":"paragraph"}]}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","title":"EntityStore","roleHeading":"Article"},"variants":[{"paths":["\/documentation\/swidux\/entitystoreguide"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},"references":{"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"title":"UndoPlugin","url":"\/documentation\/swidux\/undoplugin","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}]},"doc://Swidux/documentation/Swidux/Troubleshooting":{"abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"title":"Troubleshooting","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","url":"\/documentation\/swidux\/troubleshooting","role":"article"},"doc://Swidux/documentation/Swidux/ChangeSet":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","title":"ChangeSet","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ChangeSet","kind":"identifier"}],"url":"\/documentation\/swidux\/changeset","type":"topic","abstract":[{"text":"Tracks which entity IDs have been created\/updated or deleted.","type":"text"}],"navigatorTitle":[{"text":"ChangeSet","kind":"identifier"}],"kind":"symbol"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"title":"KeyValueStore","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","url":"\/documentation\/swidux\/keyvaluestoreguide","role":"collectionGroup"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"title":"Persistence Middleware","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","url":"\/documentation\/swidux\/persistencemiddlewareguide","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"title":"Getting Started with Swidux","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","url":"\/documentation\/swidux\/gettingstarted","role":"article"},"doc://Swidux/documentation/Swidux/EntityStore":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","title":"EntityStore","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}],"url":"\/documentation\/swidux\/entitystore","type":"topic","abstract":[{"text":"An ordered, keyed collection of identifiable entities that silently records","type":"text"},{"text":" ","type":"text"},{"text":"every mutation for downstream persistence.","type":"text"}],"navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"kind":"symbol"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"abstract":[{"text":"API reference for the ","type":