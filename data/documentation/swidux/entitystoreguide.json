{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"role":"article","title":"EntityStore","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":" works like a dictionary with insertion-order iteration. Entities must conform to "},{"code":"Identifiable & Equatable & Sendable","type":"codeVoice"},{"type":"text","text":" with "},{"code":"UUID","type":"codeVoice"},{"type":"text","text":" as the ID type."}],"type":"paragraph"},{"syntax":"swift","code":["var cards = EntityStore<Card>()","","cards[card.id] = card                      \/\/ Insert or update — recorded","cards.modify(card.id) { $0.title = \"New\" } \/\/ In-place — recorded only if value changes","cards[card.id] = nil                       \/\/ Delete — recorded","","let card = cards[cardID]                   \/\/ O(1) lookup","let all  = cards.values                    \/\/ Insertion-ordered array","","cards.sort { $0.sortIndex < $1.sortIndex } \/\/ Only marks moved entities","cards.removeAll { $0.isArchived }          \/\/ Rebuilds index in one pass"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every mutation is tracked in a "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","type":"reference"},{"type":"text","text":" that the middleware drains after each reducer call."}],"type":"paragraph"},{"anchor":"Merging-Re-hydration","text":"Merging (Re-hydration)","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Replacing an "},{"isActive":true,"identifier"