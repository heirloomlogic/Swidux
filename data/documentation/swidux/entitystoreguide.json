{"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" works like a dictionary with insertion-order iteration. Entities must conform to "},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"type":"text","text":" with "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" as the ID type."}]},{"type":"codeListing","syntax":"swift","code":["var cards = EntityStore<Card>()","","cards[card.id] = card                      \/\/ Insert or update — recorded","cards.modify(card.id) { $0.title = \"New\" } \/\/ In-place — recorded only if value changes","cards[card.id] = nil                       \/\/ Delete — recorded","","let card = cards[cardID]                   \/\/ O(1) lookup","let all  = cards.values                    \/\/ Insertion-ordered array","","cards.sort { $0.sortIndex < $1.sortIndex } \/\/ Only marks moved entities","cards.removeAll { $0.isArchived }          \/\/ Rebuilds index in one pass"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every mutation is tracked in a "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","isActive":true},{"type":"text","text":" that the middleware drains after each reducer call."}]},{"type":"heading","anchor":"Bulk-Deletion","level":2,"text":"Bulk Deletion"},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"type":"codeVoice","code":"cards[id] = nil"},{"text":" shifts the storage array’s tail and reindexes the shifted entries — O(tail) per delete, so a loop of k subscript deletes costs O(n·k). To delete many entities at once, use ","type":"text"},{"code":"remove(ids:)","type":"codeVoice"},{"text":" (when you have the IDs) or ","type":"text"},{"code":"removeAll(where:)","type":"codeVoice"},{"text":" (when you have a predicate) instead: both remove everything in a single pass with one index rebuild, record the same deletions, and cancel pending upserts exactly like the subscript.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["cards.remove(ids: selection)          \/\/ One pass, not a subscript loop","cards.removeAll { $0.isArchived }"]},{"type":"heading","anchor":"Merging-Re-hydration","level":2,"text":"Merging (Re-hydration)"},{"type":"paragraph","inlineContent":[{"text":"Replacing an ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" after startup destroys any in-memory state that was loaded lazily after initial hydration. Use ","type":"text"},{"type":"codeVoice","code":"merge(from:shouldReplace:)"},{"text":" instead — entities only in the other store are always added, and the closure decides whether an incoming value overwrites the current one:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Absorb DB rows; take an incoming row only when the current one","\/\/ lacks lazily-computed data.","campaigns.merge(from: EntityStore(allFromDB)) { current, incoming in","    current.calculationState == nil && incoming.calculationState != nil","}"]},{"type":"paragraph","inlineContent":[{"code":"merge","type":"codeVoice"},{"text":" does not record changes — it has hydration semantics like ","type":"text"},{"code":"init(_:)","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"restore(from:)","type":"heading","level":2,"anchor":"restorefrom"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"restore(from:)"},{"text":" replaces all entities with those from the source store while recording the diff as changes for persistence. Used by undo\/redo (see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"reference","isActive":true},{"text":").","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Deletions","type":"text"}]},{"text":" — IDs in self but absent from source","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Upserts","type":"text"}],"type":"strong"},{"text":" — IDs that are new or whose values differ","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Unchanged","type":"text"}],"type":"strong"},{"text":" — identical values produce no change records","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"EntityStore"},"abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/entitystoreguide"]}],"sections":[],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference","title":"Reference"}],"references":{"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"type":"topic","identifier