{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" works like a dictionary with insertion-order iteration. Entities must conform to "},{"code":"Identifiable & Equatable & Sendable","type":"codeVoice"},{"type":"text","text":" with "},{"code":"UUID","type":"codeVoice"},{"type":"text","text":" as the ID type."}]},{"code":["var cards = EntityStore<Card>()","","cards[card.id] = card                      \/\/ Insert or update — recorded","cards.modify(card.id) { $0.title = \"New\" } \/\/ In-place — recorded only if value changes","cards[card.id] = nil                       \/\/ Delete — recorded","","let card = cards[cardID]                   \/\/ O(1) lookup","let all  = cards.values                    \/\/ Insertion-ordered array","","cards.sort { $0.sortIndex < $1.sortIndex } \/\/ Only marks moved entities","cards.removeAll { $0.isArchived }          \/\/ Rebuilds index in one pass"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Every mutation is tracked in a "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","isActive":true},{"type":"text","text":" that the middleware drains after each reducer call."}],"type":"paragraph"},{"text":"Merging (Re-hydration)","anchor":"Merging-Re-hydration","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Replacing an "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"text":" after startup destroys any in-memory state that was loaded lazily after initial hydration. Use ","type":"text"},{"type":"codeVoice","code":"merge(from:shouldReplace:)"},{"text":" instead — entities only in the other store are always added, and the closure decides whether an incoming value overwrites the current one:","type":"text"}],"type":"paragraph"},{"code":["\/\/ Absorb DB rows; take an incoming row only when the current one","\/\/ lacks lazily-computed data.","campaigns.merge(from: EntityStore(allFromDB)) { current, incoming in","    current.calculationState == nil && incoming.calculationState != nil","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"merge","type":"codeVoice"},{"type":"text","text":" does not record changes — it has hydration semantics like "},{"code":"init(_:)","type":"codeVoice"},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"restore(from:)","anchor":"restorefrom"},{"type":"paragraph","inlineContent":[{"code":"restore(from:)","type":"codeVoice"},{"type":"text","text":" replaces all entities with those from the source store while recording the diff as changes for persistence. Used by undo\/redo (see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},{"text":").","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Deletions"}],"type":"strong"},{"text":" — IDs in self but absent from source","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Upserts"}],"type":"strong"},{"text":" — IDs that are new or whose values differ","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Unchanged","type":"text"}]},{"type":"text","text":" — identical values produce no change records"}]}]}],"type":"unorderedList"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"modules":[{"name":"Swidux"}],"title":"EntityStore","role":"article","roleHeading":"Article"},"kind":"art