{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" works like a dictionary with insertion-order iteration. Entities must conform to "},{"code":"Identifiable & Equatable & Sendable","type":"codeVoice"},{"type":"text","text":" with "},{"code":"UUID","type":"codeVoice"},{"type":"text","text":" as the ID type."}]},{"type":"codeListing","syntax":"swift","code":["var cards = EntityStore<Card>()","","cards[card.id] = card                      \/\/ Insert or update — recorded","cards.modify(card.id) { $0.title = \"New\" } \/\/ In-place — recorded only if value changes","cards[card.id] = nil                       \/\/ Delete — recorded","","let card = cards[cardID]                   \/\/ O(1) lookup","let all  = cards.values                    \/\/ Insertion-ordered array","","cards.sort { $0.sortIndex < $1.sortIndex } \/\/ Only marks moved entities","cards.removeAll { $0.isArchived }          \/\/ Rebuilds index in one pass"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every mutation is tracked in a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet"},{"type":"text","text":" that the middleware drains after each reducer call."}]},{"type":"heading","text":"Merging (Re-hydration)","anchor":"Merging-Re-hydration","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replacing an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" after startup destroys any in-memory state that was loaded lazily after initial hydration. Use "},{"code":"merge(from:shouldReplace:)","type":"codeVoice"},{"type":"text","text":" instead — entities only in the other store are always added, and the closure decides whether an incoming value overwrites the current one:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Absorb DB rows; take an incoming row only when the current one","\/\/ lacks lazily-computed data.","campaigns.merge(from: EntityStore(allFromDB)) { current, incoming in","    current.calculationState == nil && incoming.calculationState != nil","}"]},{"type":"paragraph","inlineContent":[{"code":"merge","type":"codeVoice"},{"type":"text","text":" does not record changes — it has hydration semantics like "},{"code":"init(_:)","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","text":"restore(from:)","anchor":"restorefrom","level":2},{"type":"paragraph","inlineContent":[{"code":"restore(from:)","type":"codeVoice"},{"type":"text","text":" replaces all entities with those from the source store while recording the diff as changes for persistence. Used by undo\/redo (see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},{"type":"text","text":")."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Deletions","type":"text"}]},{"type":"text","text":" — IDs in self but absent from source"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Upserts","type":"text"}]},{"type":"text","text":" — IDs that are new or whose values differ"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Unchanged","type":"text"}]},{"type":"text","text":" — identical values produce no change records"}],"type":"paragraph"}]}]}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"kind":"article","seeAlsoSections":[{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/