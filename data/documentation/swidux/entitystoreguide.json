{"abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","interfaceLanguage":"swift"},"kind":"article","metadata":{"modules":[{"name":"Swidux"}],"title":"EntityStore","roleHeading":"Article","role":"article"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" works like a dictionary with insertion-order iteration. Entities must conform to "},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"type":"text","text":" with "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" as the ID type."}]},{"syntax":"swift","type":"codeListing","code":["var cards = EntityStore<Card>()","","cards[card.id] = card                      \/\/ Insert or update — recorded","cards.modify(card.id) { $0.title = \"New\" } \/\/ In-place — recorded only if value changes","cards[card.id] = nil                       \/\/ Delete — recorded","","let card = cards[cardID]                   \/\/ O(1) lookup","let all  = cards.values                    \/\/ Insertion-ordered array","","cards.sort { $0.sortIndex < $1.sortIndex } \/\/ Only marks moved entities","cards.removeAll { $0.isArchived }          \/\/ Rebuilds index in one pass"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every mutation is tracked in a "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","isActive":true},{"type":"text","text":" that the middleware drains after each reducer call."}]},{"text":"Merging (Re-hydration)","type":"heading","level":2,"anchor":"Merging-Re-hydration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replacing an "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"type":"text","text":" after startup destroys any in-memory state that was loaded lazily after initial hydration. Use "},{"type":"codeVoice","code":"merge(from:preferExisting:)"},{"type":"text","text":" instead:"}]},{"syntax":"swift","type":"codeListing","code":["var merged = EntityStore(allFromDB)","merged.merge(from: existingStore) { existing, incoming in","    existing.calculationState != nil && incoming.calculationState == nil","}","campaigns = merged"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"merge"},{"type":"text","text":" does not record changes — it has hydration semantics like "},{"type":"codeVoice","code":"init(_:)"},{"type":"text","text":"."}]},{"text":"restore(from:)","type":"heading","level":2,"anchor":"restorefrom"},{"type":"paragraph","inlineContent":[{"code":"restore(from:)","type":"codeVoice"},{"type":"text","text":" replaces all entities with those from the source store while recording the diff as changes for persistence. Used by undo\/redo (see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","isActive":true},{"type":"text","text":")."}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Deletions"}]},{"type":"text","text":" — IDs in self but absent from source"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Upserts"}],"type":"strong"},{"type":"text","text":" — IDs that are new or whose values differ"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Unchanged"}],"type":"strong"},{"type":"text","text":" — identical values produce no change records"}],"type":"paragraph"}]}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/swidux\/entitystoreguide"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentati