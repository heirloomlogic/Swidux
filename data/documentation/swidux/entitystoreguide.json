":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","url":"\/documentation\/swidux\/persistencemiddlewareguide","title":"Persistence Middleware"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","url":"\/documentation\/swidux\/pluginkillswitchreference","kind":"article","role":"article","type":"topic","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"title":"SwiduxKillswitch Reference"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"role":"article","type":"topic","kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","url":"\/documentation\/swidux\/pluginpaywallreference","title":"SwiduxPaywall Reference"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"type":"topic","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"role":"collectionGroup","title":"KeyValueStore","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","url":"\/documentation\/swidux\/keyvaluestoreguide"},"doc://Swidux/documentation/Swidux/MacrosReference":{"role":"article","type":"topic","kind":"article","abstract":[{"text":"Reference for ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" and its property markers (the SwiftData persistence bridge, shipped in ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":").","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","url":"\/documentation\/swidux\/macrosreference","title":"Macros"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"role":"article","type":"topic","kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","url":"\/documentation\/swidux\/pluginfeatureflagsreference","title":"SwiduxFeatureFlags Reference"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"type":"topic","abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"role":"symbol","kind":"symbol","title":"UndoPlugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","url":"\/documentation\/swidux\/undoplugin","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","url":"\/documentation\/swidux\/gettingstarted","kind":"article","role":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"title":"Getting Started with Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"url":"\/documentation\/swidux\/pluginparentalgatereference","kind":"article","role":"article","type":"topic","title":"SwiduxParentalGate Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},"doc://Swidux/documentation/Swidux/ChangeSet":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"ChangeSet"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Tracks which entity IDs have been created\/updated or deleted."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ChangeSet"}],"url":"\/documentation\/swidux\/changeset","title":"ChangeSet"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"url":"\/documentation\/swidux\/pluginanalyticsreference","kind":"article","role":"article","type":"topic","title":"SwiduxAnalytics Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"url":"\/documentation\/swidux\/troubleshooting","kind":"article","role":"article","type":"topic","title":"Troubleshooting","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"},"doc://Swidux/documentation/Swidux":{"abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"url":"\/documentation\/swidux","kind":"symbol","role":"collection","type":"topic","title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux"}}}