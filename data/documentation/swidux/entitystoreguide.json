:true,"type":"reference"},{"type":"text","text":")."}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Deletions"}],"type":"strong"},{"text":" — IDs in self but absent from source","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Upserts"}],"type":"strong"},{"text":" — IDs that are new or whose values differ","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Unchanged"}],"type":"strong"},{"text":" — identical values produce no change records","type":"text"}]}]}]}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"references":{"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"type":"topic","title":"SwiduxFeatureFlags Reference","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"url":"\/documentation\/swidux\/pluginfeatureflagsreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/UndoRedo":{"type":"topic","title":"Undo \/ Redo","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/swidux\/undoredo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux":{"type":"topic","title":"Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, an