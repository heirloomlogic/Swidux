{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" works like a dictionary with insertion-order iteration. Entities must conform to "},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"type":"text","text":" with "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" as the ID type."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var cards = EntityStore<Card>()","","cards[card.id] = card                      \/\/ Insert or update — recorded","cards.modify(card.id) { $0.title = \"New\" } \/\/ In-place — recorded only if value changes","cards[card.id] = nil                       \/\/ Delete — recorded","","let card = cards[cardID]                   \/\/ O(1) lookup","let all  = cards.values                    \/\/ Insertion-ordered array","","cards.sort { $0.sortIndex < $1.sortIndex } \/\/ Only marks moved entities","cards.removeAll { $0.isArchived }          \/\/ Rebuilds index in one pass"]},{"inlineContent":[{"type":"text","text":"Every mutation is tracked in a "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","isActive":true},{"type":"text","text":" that the middleware drains after each reducer call."}],"type":"paragraph"},{"text":"Merging (Re-hydration)","anchor":"Merging-Re-hydration","level":2,"type":"heading"},{"inlineContent":[{"text":"Replacing an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":" after startup destroys any in-memory state that was loaded lazily after initial hydration. Use ","type":"text"},{"type":"codeVoice","code":"merge(from:preferExisting:)"},{"text":" instead:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var merged = EntityStore(allFromDB)","merged.merge(from: existingStore) { existing, incoming in","    existing.calculationState != nil && incoming.calculationState == nil","}","campaigns = merged"]},{"inlineContent":[{"type":"codeVoice","code":"merge"},{"type":"text","text":" does not record changes — it has hydration semantics like "},{"type":"codeVoice","code":"init(_:)"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"restore(from:)","anchor":"restorefrom","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"restore(from:)"},{"text":" replaces all entities with those from the source store while recording the diff as changes for persistence. Used by undo\/redo (see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","isActive":true},{"text":").","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Deletions"}]},{"type":"text","text":" — IDs in self but absent from source"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Upserts"}],"type":"strong"},{"text":" — IDs that are new or whose values differ","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Unchanged"}]},{"type":"text","text":" — identical values produce no change records"}],"type":"paragraph"}]}]}]}],"abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"variants":[{"paths":["\/documentation\/swidux\/entitystoreguide"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","