{"seeAlsoSections":[{"generated":true,"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/entitystoreguide"]}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" works like a dictionary with insertion-order iteration. Entities must conform to "},{"code":"Identifiable & Equatable & Sendable","type":"codeVoice"},{"type":"text","text":" with "},{"code":"UUID","type":"codeVoice"},{"type":"text","text":" as the ID type."}]},{"syntax":"swift","type":"codeListing","code":["var cards = EntityStore<Card>()","","cards[card.id] = card                      \/\/ Insert or update — recorded","cards.modify(card.id) { $0.title = \"New\" } \/\/ In-place — recorded only if value changes","cards[card.id] = nil                       \/\/ Delete — recorded","","let card = cards[cardID]                   \/\/ O(1) lookup","let all  = cards.values                    \/\/ Insertion-ordered array","","cards.sort { $0.sortIndex < $1.sortIndex } \/\/ Only marks moved entities","cards.removeAll { $0.isArchived }          \/\/ Rebuilds index in one pass"]},{"type":"paragraph","inlineContent":[{"text":"Every mutation is tracked in a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","type":"reference"},{"text":" that the middleware drains after each reducer call.","type":"text"}]},{"type":"heading","text":"Bulk Deletion","level":2,"anchor":"Bulk-Deletion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"cards[id] = nil"},{"type":"text","text":" shifts the storage array’s tail and reindexes the shifted entries — O(tail) per delete, so a loop of k subscript deletes costs O(n·k). To delete many entities at once, use "},{"type":"codeVoice","code":"remove(ids:)"},{"type":"text","text":" (when you have the IDs) or "},{"type":"codeVoice","code":"removeAll(where:)"},{"type":"text","text":" (when you have a predicate) instead: both remove everything in a single pass with one index rebuild, record the same deletions, and cancel pending upserts exactly like the subscript."}]},{"syntax":"swift","type":"codeListing","code":["cards.remove(ids: selection)          \/\/ One pass, not a subscript loop","cards.removeAll { $0.isArchived }"]},{"type":"heading","text":"Merging (Re-hydration)","level":2,"anchor":"Merging-Re-hydration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replacing an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" after startup destroys any in-memory state that was loaded lazily after initial hydration. Use "},{"type":"codeVoice","code":"merge(from:shouldReplace:)"},{"type":"text","text":" instead — entities only in the other store are always added, and the closure decides whether an incoming value overwrites the current one:"}]},{"code":["\/\/ Absorb DB rows; take an incoming row only when the current one","\/\/ lacks lazily-computed data.","campaigns.merge(from: EntityStore(allFromDB)) { current, incoming in","    current.calculationState == nil && incoming.calculationState != nil","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"merge","type":"codeVoice"},{"type":"text","text":" does not record changes — it has hydration semantics like "},{"type":"codeVoice","code":"init(_:)"},{"type":"text","text":"."}]},{"type":"heading","level":3,"text":"reconcile vs merge","anchor":"reconcile-vs-merge"},{"type":"paragraph","inlineContent":[{"text":"The two answer different questions:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[]}],[{"type":"paragraph","inlineContent":[{"code":"merge(from:shouldReplace:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"reconcile(with:preserving:removingMissing:)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Stance"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep everything, absorb what’s new"}]}],[{"type":"paragraph","inlineContent":[{"text":"Storage is authoritative ","type":"text"},{"inlineContent":[{"type":"text","text":"except"}],"type":"strong"},{"text":" where you say otherwise","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Removes rows","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Never"}]}],[{"type":"paragraph","inlineContent":[{"text":"When ","type":"text"},{"code":"removingMissing","type":"codeVoice"},{"text":" and the ID isn’t preserved","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Conflicts"}]}],[{"type":"paragraph","inlineContent":[{"text":"Your closure decides, per pair","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Storage wins unless the ID is preserved"}]}]]]},{"type":"paragraph","inlineContent":[{"code":"reconcile","type":"codeVoice"},{"text":" is what lets a remote edit or a remote deletion surface mid-session rather than waiting for the next launch. ","type":"text"},{"code":"preserving","type":"codeVoice"},{"text":" is the caller’s list of IDs that carry unflushed local intent; the store’s own un-drained ","type":"text"},{"code":"changes","type":"codeVoice"},{"text":" are folded in automatically, so a pending local deletion is never resurrected even when ","type":"text"},{"code":"preserving","type":"codeVoice"},{"text":" is empty.","type":"text"}]},{"code":["cards.reconcile(with: EntityStore(rowsFromDisk), preserving: dirtyIDs, removingMissing: true)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Like "},{"type":"codeVoice","code":"merge"},{"type":"text","text":", it records no changes — every value it writes or removes already reflects what is in storage, so recording them would echo each remote change straight back as a local write."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Most apps never call this directly; "},{"type":"codeVoice","code":"PersistenceCoordinator.rehydrate(into:)"},{"type":"text","text":" does, and computes "},{"type":"codeVoice","code":"preserving"},{"type":"text","text":" for you."}]},{"text":"restore(from:)","type":"heading","level":2,"anchor":"restorefrom"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"restore(from:)"},{"type":"text","text":" replaces all entities with those from the source store while recording the diff as changes for persistence. Used by undo\/redo (see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","isActive":true},{"type":"text","text":")."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Deletions","type":"text"}],"type":"strong"},{"text":" — IDs in self but absent from source","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Upserts"}]},{"type":"text","text":" — IDs that are new or whose values differ"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Unchanged"}]},{"type":"text","text":" — identical values produce no change records"}]}]}]},{"level":3,"text":"Remote deletions are not undoable","type":"heading","anchor":"Remote-deletions-are-not-undoable"},{"inlineContent":[{"text":"One class of ID is skipped: anything ","type":"text"},{"type":"codeVoice","code":"reconcile"},{"text":" removed because storage no longer held it. Those IDs are kept in ","type":"text"},{"type":"codeVoice","code":"remotelyRemovedIDs"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"restore"},{"text":" will neither re-add them nor record a change for them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Without that, undo resurrects rows other devices deleted. An undo snapshot taken before the deletion still contains the entity, so restoring it records an "},{"type":"strong","inlineContent":[{"type":"text","text":"upsert"}]},{"type":"text","text":" — which flushes as a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"creation"}]},{"type":"text","text":" and re-seeds every peer that had already agreed the row was gone. Undo is scoped to what the local user did; a deletion made on another device isn’t that."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An ID leaves the set as soon as it becomes local again — an explicit "},{"code":"store[id] = entity","type":"codeVoice"},{"type":"text","text":", or storage handing the row back on a later merge — so a row that another device deletes and then restores is undoable once more. The set survives "},{"code":"resetChanges()","type":"codeVoice"},{"type":"text","text":", because a flush ends a pending write’s life, not a deletion’s."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ \"3 items were deleted on another device.\"","cards.remotelyRemovedIDs.count"],"type":"codeListing"},{"inlineContent":[{"text":"Stores that never sync never populate it, and ","type":"text"},{"code":"restore","type":"codeVoice"},{"text":" takes exactly the path it did before.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"EntityStore","modules":[{"name":"Swidux"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},"abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"title":"SwiduxParentalGate Reference","url":"\/documentation\/swidux\/pluginparentalgatereference","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/EntityStore":{"title":"EntityStore","url":"\/documentation\/swidux\/entitystore","kind":"symbol","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityStore"}],"navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"abstract":[{"type":"text","text":"An ordered, keyed collection of identifiable entities that silently records"},{"type":"text","text":" "},{"type":"text","text":"every mutation for downstream persistence."}],"role":"symbol"},"doc://Swidux/documentation/Swidux/MacrosReference":{"type":"topic","kind":"article","title":"Macros","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosR