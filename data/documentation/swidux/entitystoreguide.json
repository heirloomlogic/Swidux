{"abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"variants":[{"paths":["\/documentation\/swidux\/entitystoreguide"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" works like a dictionary with insertion-order iteration. Entities must conform to ","type":"text"},{"type":"codeVoice","code":"Identifiable & Equatable & Sendable"},{"type":"text","text":" with "},{"code":"UUID","type":"codeVoice"},{"type":"text","text":" as the ID type."}],"type":"paragraph"},{"code":["var cards = EntityStore<Card>()","","cards[card.id] = card                      \/\/ Insert or update — recorded","cards.modify(card.id) { $0.title = \"New\" } \/\/ In-place — recorded only if value changes","cards[card.id] = nil                       \/\/ Delete — recorded","","let card = cards[cardID]                   \/\/ O(1) lookup","let all  = cards.values                    \/\/ Insertion-ordered array","","cards.sort { $0.sortIndex < $1.sortIndex } \/\/ Only marks moved entities","cards.removeAll { $0.isArchived }          \/\/ Rebuilds index in one pass"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Every mutation is tracked in a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet"},{"type":"text","text":" that the middleware drains after each reducer call."}],"type":"paragraph"},{"anchor":"Bulk-Deletion","level":2,"type":"heading","text":"Bulk Deletion"},{"inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"cards[id] = nil"},{"type":"text","text":" shifts the storage array’s tail and reindexes the shifted entries — O(tail) per delete, so a loop of k subscript deletes costs O(n·k). To delete many entities at once, use "},{"type":"codeVoice","code":"remove(ids:)"},{"type":"text","text":" (when you have the IDs) or "},{"type":"codeVoice","code":"removeAll(where:)"},{"type":"text","text":" (when you have a predicate) instead: both remove everything in a single pass with one index rebuild, record the same deletions, and cancel pending upserts exactly like the subscript."}],"type":"paragraph"},{"code":["cards.remove(ids: selection)          \/\/ One pass, not a subscript loop","cards.removeAll { $0.isArchived }"],"type":"codeListing","syntax":"swift"},{"anchor":"Merging-Re-hydration","level":2,"type":"heading","text":"Merging (Re-hydration)"},{"inlineContent":[{"text":"Replacing an ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"type":"text","text":" after startup destroys any in-memory state that was loaded lazily after initial hydration. Use "},{"type":"codeVoice","code":"merge(from:shouldReplace:)"},{"type":"text","text":" instead — entities only in the other store are always added, and the closure decides whether an incoming value overwrites the current one:"}],"type":"paragraph"},{"code":["\/\/ Absorb DB rows; take an incoming row only when the current one","\/\/ lacks lazily-computed data.","campaigns.merge(from: EntityStore(allFromDB)) { current, incoming in","    current.calculationState == nil && incoming.calculationState != nil","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"merge","type":"codeVoice"},{"type":"text","text":" does not record changes — it has hydration semantics like "},{"code":"init(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"restore(from:)","anchor":"restorefrom","type":"heading"},{"inlineContent":[{"code":"restore(from:)","type":"codeVoice"},{"type":"text","text":" replaces all entities with those from the source store while recording the diff as changes for persistence. Used by undo\/redo (see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"reference","isActive":true},{"type":"text","text":")."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Deletions"}]},{"text":" — IDs in self but absent from source","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Upserts"}]},{"text":" — IDs that are new or whose values differ","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Unchanged"}]},{"text":" — identical values produce no change records","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"roleHeading":"Article","role":"article","title":"EntityStore","modules":[{"name":"Swidux"}]},"seeAlsoSections":[{"title":"Reference","generated":true,"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","interfaceLanguage":"swift"},"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"references":{"doc://Swidux/documentation/Swidux/GettingStarted":{"identifier":"doc:\/\/Swidux\/docu