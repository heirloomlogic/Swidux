{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" works like a dictionary with insertion-order iteration. Entities must conform to ","type":"text"},{"code":"Identifiable & Equatable & Sendable","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"UUID","type":"codeVoice"},{"text":" as the ID type.","type":"text"}]},{"syntax":"swift","code":["var cards = EntityStore<Card>()","","cards[card.id] = card                      \/\/ Insert or update — recorded","cards.modify(card.id) { $0.title = \"New\" } \/\/ In-place — recorded only if value changes","cards[card.id] = nil                       \/\/ Delete — recorded","","let card = cards[cardID]                   \/\/ O(1) lookup","let all  = cards.values                    \/\/ Insertion-ordered array","","cards.sort { $0.sortIndex < $1.sortIndex } \/\/ Only marks moved entities","cards.removeAll { $0.isArchived }          \/\/ Rebuilds index in one pass"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every mutation is tracked in a "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","type":"reference","isActive":true},{"type":"text","text":" that the middleware drains after each reducer call."}],"type":"paragraph"},{"level":2,"text":"Merging (Re-hydration)","anchor":"Merging-Re-hydration","type":"heading"},{"inlineContent":[{"text":"Replacing an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"type":"text","text":" after startup destroys any in-memory state that was loaded lazily after initial hydration. Use "},{"code":"merge(from:preferExisting:)","type":"codeVoice"},{"type":"text","text":" instead:"}],"type":"paragraph"},{"syntax":"swift","code":["var merged = EntityStore(allFromDB)","me