","cards.sort { $0.sortIndex < $1.sortIndex } \/\/ Only marks moved entities","cards.removeAll { $0.isArchived }          \/\/ Rebuilds index in one pass"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Every mutation is tracked in a ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet","isActive":true,"type":"reference"},{"text":" that the middleware drains after each reducer call.","type":"text"}]},{"anchor":"Bulk-Deletion","text":"Bulk Deletion","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Each "},{"code":"cards[id] = nil","type":"codeVoice"},{"type":"text","text":" shifts the storage array’s tail and reindexes the shifted entries — O(tail) per delete, so a loop of k subscript deletes costs O(n·k). To delete many entities at once, use "},{"code":"remove(ids:)","type":"codeVoice"},{"type":"text","text":" (when you have the IDs) or "},{"code":"removeAll(where:)","type":"codeVoice"},{"type":"text","text":" (when you have a predicate) instead: both remove everything in a single pass with one index rebuild, record the same deletions, and cancel pending upserts exactly like the subscript."}],"type":"paragraph"},{"code":["cards.remove(ids: selection)          \/\/ One pass, not a subscript loop","cards.removeAll { $0.isArchived }"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Merging-Re-hydration","type":"heading","text":"Merging (Re-hydration)"},{"type":"paragraph","inlineContent":[{"text":"Replacing an ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" after startup destroys any in-memory state that was loaded lazily after initial hydration. Use ","type":"text"},{"code":"merge(from:shouldReplace:)","type":"codeVoice"},{"text":" instead — entities only in the other store are always added, and the closure decides whether an incoming value overwrites the current one:","type":"text"}]},{"code":["\/\/ Absorb DB rows; take an incoming row only when the current one","\/\/ lacks lazily-computed data.","campaigns.merge(from: EntityStore(allFromDB)) { current, incoming in","    current.calculationState == nil && incoming.calculationState != nil","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"merge","type":"codeVoice"},{"text":" does not record changes — it has hydration semantics like ","type":"text"},{"code":"init(_:)","type":"codeVoice"},{"text":".","type":"text"}]},{"level":3,"anchor":"reconcile-vs-merge","type":"heading","text":"reconcile vs merge"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The two answer different questions:"}]},{"header":"row","rows":[[[{"inlineContent":[],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"merge(from:shouldReplace:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"reconcile(with:preserving:removingMissing:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Stance"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Keep everything, absorb what’s new"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Storage is authoritative "},{"type":"strong","inlineContent":[{"text":"except","type":"text"}]},{"type":"text","text":" where you say otherwise"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Removes rows"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Never"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"removingMissing"},{"type":"text","text":" and the ID isn’t preserved"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Conflicts"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Your closure decides, per pair"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Storage wins unless the ID is preserved"}],"type":"paragraph"}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"code":"reconcile","type":"codeVoice"},{"text":" is what lets a remote edit or a remote deletion surface mid-session rather than waiting for the next launch. ","type":"text"},{"code":"preserving","type":"codeVoice"},{"text":" is the caller’s list of IDs that carry unflushed local intent; the store’s own un-drained ","type":"text"},{"code":"changes","type":"codeVoice"},{"text":" are folded in automatically, so a pending local deletion is never resurrected even when ","type":"text"},{"code":"preserving","type":"codeVoice"},{"text":" is empty.","type":"text"}]},{"code":["cards.reconcile(with: EntityStore(rowsFromDisk), preserving: dirtyIDs, removingMissing: true)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Like ","type":"text"},{"code":"merge","type":"codeVoice"},{"text":", it records no changes — every value it writes or removes already reflects what is in storage, so recording them would echo each remote change straight back as a local write.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Most apps never call this directly; ","type":"text"},{"code":"PersistenceCoordinator.rehydrate(into:)","type":"codeVoice"},{"text":" does, and computes ","type":"text"},{"code":"preserving","type":"codeVoice"},{"text":" for you.","type":"text"}]},{"level":2,"anchor":"restorefrom","type":"heading","text":"restore(from:)"},{"type":"paragraph","inlineContent":[{"code":"restore(from:)","type":"codeVoice"},{"text":" replaces all entities with those from the source store while recording the diff as changes for persistence. Used by undo\/redo (see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","isActive":true,"type":"reference"},{"text":").","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Deletions"}],"type":"strong"},{"text":" — IDs in self but absent from source","typ