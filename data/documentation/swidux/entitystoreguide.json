,{"text":" instead — entities only in the other store are always added, and the closure decides whether an incoming value overwrites the current one:","type":"text"}]},{"code":["\/\/ Absorb DB rows; take an incoming row only when the current one","\/\/ lacks lazily-computed data.","campaigns.merge(from: EntityStore(allFromDB)) { current, incoming in","    current.calculationState == nil && incoming.calculationState != nil","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"merge","type":"codeVoice"},{"text":" does not record changes — it has hydration semantics like ","type":"text"},{"code":"init(_:)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","level":2,"anchor":"restorefrom","text":"restore(from:)"},{"type":"paragraph","inlineContent":[{"code":"restore(from:)","type":"codeVoice"},{"text":" replaces all entities with those from the source store while recording the diff as changes for persistence. Used by undo\/redo (see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},{"text":").","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Deletions","type":"text"}],"type":"strong"},{"type":"text","text":" — IDs in self but absent from source"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Upserts","type":"text"}]},{"text":" — IDs that are new or whose values differ","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Unchanged"}],"type":"strong"},{"text":" — identical values produce no change records","type":"text"}],"type":"paragraph"}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},"schemaVersion":{"minor":3,"major":0,"patc