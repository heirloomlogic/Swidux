{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", so any view can react to it.","type":"text"}]},{"type":"heading","level":2,"anchor":"Before-you-start","text":"Before you start"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes you already have a Swidux app wired up: an ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", an ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":", an ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"text":", and a ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory. If not, work through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference"},{"text":" first.","type":"text"}]},{"type":"heading","text":"Step 1: Add the dependency","level":2,"anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" is a separate product in the "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" package. Add it to the target that wires the store:"}]},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"]},{"type":"paragraph","inlineContent":[{"text":"If you re-export Swidux from ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"text":" (recommended), import ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" directly in ","type":"text"},{"code":"AppStore.swift","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"text":" where the types are referenced.","type":"text"}]},{"type":"heading","text":"Step 2: Add state and actions","level":2,"anchor":"Step-2-Add-state-and-actions"},{"type":"paragraph","inlineContent":[{"text":"Mount a ","type":"text"},{"code":"KillswitchState","type":"codeVoice"},{"text":" slice on your root state and add an action case that wraps ","type":"text"},{"code":"KillswitchAction","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"],"syntax":"swift"},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"]},{"name":"Tip","style":"tip","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"import SwiduxKillswitch","type":"codeVoice"},{"text":" is needed in ","type":"text"},{"inlineContent":[{"text":"every","type":"text"}],"type":"emphasis"},{"text":" file that touches ","type":"text"},{"code":"store.killswitch.*","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"KillswitchAction","type":"codeVoice"},{"text":" — including views that read the verdict for display. ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"inlineContent":[{"type":"text","text":"The plugin’s reducer handles "},{"type":"codeVoice","code":".killswitch"},{"type":"text","text":" actions itself. Your root reducer should fall through:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"],"type":"codeListing"},{"type":"heading","text":"Step 3: Wire the plugin","level":2,"anchor":"Step-3-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"text":"Inside ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":", build a "},{"code":"KillswitchPlugin","type":"codeVoice"},{"type":"text","text":" and register it on the plugin host. Use "},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"type":"text","text":" for the production service:"}]},{"type":"codeListing","code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(static: \"https:\/\/example.com\/killswitch.json\")","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"appVersion"},{"type":"text","text":" closure runs every time "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":" evaluates, so it reflects the build that’s actually running. The plugin’s default "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" argument opens URLs through "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" or "},{"type":"codeVoice","code":"NSWorkspace"},{"type":"text","text":"; pass your own closure if you route URLs through a coordinator."}]},{"type":"heading","level":2,"anchor":"Step-4-Trigger-fetch-on-launch","text":"Step 4: Trigger fetch on launch"},{"inlineContent":[{"text":"Dispatch ","type":"text"},{"code":".killswitch(.fetch)","type":"codeVoice"},{"text":" from your root view’s ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" so the verdict is available before the user can interact:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"},{"text":" is cache-aware: if the last fetch is within ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch ","type":"text"},{"type":"codeVoice","code":".killswitch(.forceFetch)"},{"type":"text","text":" instead, which bypasses the freshness gate."}]},{"inlineContent":[{"text":"If the network call fails and a cached config is available, the plugin dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from the cache ","type":"text"},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"text":" ","type":"text"},{"code":".fetchFailed(message)","type":"codeVoice"},{"text":". Your UI keeps a usable verdict and can still surface the error.","type":"text"}],"type":"paragraph"},{"text":"Step 5: Render the verdict","anchor":"Step-5-Render-the-verdict","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The simplest path is the bundled "},{"type":"codeVoice","code":"killswitchBlocker(verdict:onUpdate:)"},{"type":"text","text":" view modifier. It overlays a non-dismissible blocker when the verdict is "},{"type":"codeVoice","code":".blocked"},{"type":"text","text":" and disables the underlying content while it is:"}],"type":"paragraph"},{"code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":".unknown","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" render nothing — the blocker only appears once the verdict comes back as "},{"type":"codeVoice","code":".blocked(...)"},{"text":". The Update button calls the ","type":"text"},{"code":"onUpdate","type":"codeVoice"},{"text":" closure, which dispatches ","type":"text"},{"type":"codeVoice","code":".killswitch(.openUpdateURL)"},{"text":". The plugin checks ","type":"text"},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":" and opens the URL through ","type":"text"},{"type":"codeVoice","code":"UIApplication"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"NSWorkspace"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"],"type":"codeListing"},{"inlineContent":[{"text":"The closure receives the verdict’s ","type":"text"},{"code":"title","type":"codeVoice"},{"text":", ","type":"text"},{"code":"message","type":"codeVoice"},{"text":", and a ","type":"text"},{"code":"hasUpdateURL","type":"codeVoice"},{"text":" flag derived from ","type":"text"},{"code":"canOpenUpdateURL","type":"codeVoice"},{"text":", so your custom view doesn’t have to pattern-match the verdict itself.","type":"text"}],"type":"paragraph"},{"text":"Hosting the JSON config","anchor":"Hosting-the-JSON-config","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The endpoint you pass to "},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"type":"text","text":" serves a JSON document matching "},{"code":"KillswitchConfig","type":"codeVoice"},{"type":"text","text":". Every field is optional. The four operational shapes you’ll actually use:"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"1. Soft minimum version (most common).","type":"text"}]},{"text":" Force everyone below the floor to update; let everyone else through.","type":"text"}],"type":"paragraph"},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"2. Emergency block of a specific bad build."}],"type":"strong"},{"text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue.","type":"text"}],"type":"paragraph"},{"code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"inlineContent":[{"text":"3. Range block.","type":"text"}],"type":"strong"},{"text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes).","type":"text"}],"type":"paragraph"},{"code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"type":"text","text":"Range entries use the literal string "},{"type":"codeVoice","code":"\"a.b.c..<x.y.z\""},{"type":"text","text":" — half-open, lower bound inclusive, upper bound exclusive."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"4. Allow everyone."}],"type":"strong"},{"text":" Sometimes you just want the killswitch live but quiet.","type":"text"}],"type":"paragraph"},{"code":["{}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"text":"Rules combine. Adding all of them in one document lets you lift the floor ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"text":" knock out a specific bad build ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:","type":"text"}],"type":"paragraph"},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"anchor":"Where-to-host-it","text":"Where to host it","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The contract is small: a public "},{"code":"GET","type":"codeVoice"},{"type":"text","text":" that returns "},{"type":"codeVoice","code":"KillswitchConfig"},{"text":"-shaped JSON. It’s read on every cold launch, the plugin is fail-open, and it caches the result client-side — so the backend can be trivial. The one requirement that actually shapes the choice: ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"a killswitch’s value is how fast you can push an emergency block."}]},{"text":" Anything that needs a redeploy or a git build to change the config defeats the purpose.","type":"text"}],"type":"paragraph"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Option"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Change config without redeploy?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Propagation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Notes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Cloudflare Worker + Workers KV"}]},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"(recommended)","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅ ","type":"text"},{"type":"codeVoice","code":"wrangler kv key put"},{"type":"text","text":" or dashboard"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"seconds"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Flip in seconds, edge-cached, room to add logic (geo\/gradual\/per-build) later. Runnable example below."}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Static object (R2 \/ S3 + CDN)","type":"text"}]}],[{"inlineContent":[{"text":"✅ re-upload object","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"seconds (after purge)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Zero code. Must set ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":" as object metadata; no room to grow.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Static site \/ Pages (git-backed)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"❌ commit + build","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"~minutes"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The trap: build latency kills the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"emergency"}]},{"text":" use case.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"GitHub raw \/ Gist","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅ edit file"}],"type":"paragraph"}],[{"inlineContent":[{"text":"unpredictable","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Not a production CDN; you don’t control ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":", stale exactly when freshness matters.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Your own app backend"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"instant"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The trap: it’s the service most likely down precisely when you need the killswitch.","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Recommended: Cloudflare Worker + KV."}],"type":"strong"},{"type":"text","text":" The config lives in a KV key; the Worker returns it with a short "},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":". You push an emergency block by writing one KV key — no redeploy. A complete, runnable example is in "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"type":"text","text":" — one Worker, keyed "},{"type":"codeVoice","code":"GET \/<appID>\/<resource>"},{"type":"text","text":", that serves killswitch "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" feature-flag config for every app in a portfolio from a single URL and a single KV namespace (the Cloudflare dashboard becomes the one place you edit a value). The short version: create a KV namespace → seed "},{"type":"codeVoice","code":"…\/killswitch"},{"type":"text","text":" → "},{"type":"codeVoice","code":"wrangler deploy"},{"type":"text","text":" → point "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:)"},{"type":"text","text":" at "},{"type":"codeVoice","code":"https:\/\/<host>\/<appID>\/killswitch"},{"type":"text","text":". See also "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/DEPLOY.md"},{"type":"text","text":" for the multi-app operating convention."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Minimal alternative: a static object"}],"type":"strong"},{"text":" (Cloudflare R2, S3, any object store fronted by a CDN). Upload ","type":"text"},{"code":"killswitch.json","type":"codeVoice"},{"text":", set a short ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":" on the object, re-upload to change it. Zero code; you give up the room to add server-side logic later. Equivalent push-in-seconds latency for this use case.","type":"text"}]},{"type":"heading","level":3,"anchor":"Freshness-the-backend-cant-fix-client-staleness","text":"Freshness: the backend can’t fix client staleness"},{"type":"paragraph","inlineContent":[{"text":"The plugin caches the fetched config for ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":" (","type":"text"},{"inlineContent":[{"text":"default 3600s","type":"text"}],"type":"strong"},{"text":") regardless of how fresh your endpoint is. With the default, a perfectly deployed emergency block still won’t reach an already-launched app for up to an hour — and no backend choice changes that. If fast emergency response matters:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lower "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":" to ~300–900s in "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Dispatch ","type":"text"},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"text":" on app-foreground — it bypasses the freshness gate, so a returning user re-checks immediately.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep your endpoint’s edge "},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":" at or below "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":"; caching longer at the edge than the client will re-ask buys nothing."}]},{"type":"heading","anchor":"Testing","text":"Testing","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"KillswitchService.mock(result:cached:cacheLifetime:)","type":"codeVoice"},{"type":"text","text":" to drive the plugin from a test without hitting the network:"}]},{"type":"codeListing","code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked, fromNetwork: true)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The mock factory’s ","type":"text"},{"code":"result","type":"codeVoice"},{"text":" closure can also throw. With no cached config, the plugin dispatches only ","type":"text"},{"code":".fetchFailed","type":"codeVoice"},{"text":". With a cached config, it dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from cache ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"code":".fetchFailed","type":"codeVoice"},{"type":"text","text":", so test the fallback path with both "},{"code":