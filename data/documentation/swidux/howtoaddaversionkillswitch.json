{"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"anchor":"How-to-Guides","title":"How-to Guides"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch"},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddaversionkillswitch"]}],"metadata":{"role":"article","roleHeading":"Article","title":"Add a Version Killswitch","modules":[{"name":"Swidux"}]},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", so any view can react to it.","type":"text"}]},{"level":2,"type":"heading","text":"Before you start","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired up: an "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and a "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory. If not, work through "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}]},{"level":2,"type":"heading","text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" is a separate product in the "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" package. Add it to the target that wires the store:"}]},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you re-export Swidux from "},{"code":"AppState.swift","type":"codeVoice"},{"type":"text","text":" (recommended), import "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" directly in "},{"type":"codeVoice","code":"AppStore.swift"},{"text":" and ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"text":" where the types are referenced.","type":"text"}]},{"level":2,"anchor":"Step-2-Add-state-and-actions","type":"heading","text":"Step 2: Add state and actions"},{"inlineContent":[{"text":"Mount a ","type":"text"},{"code":"KillswitchState","type":"codeVoice"},{"text":" slice on your root state and add an action case that wraps ","type":"text"},{"code":"KillswitchAction","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"],"syntax":"swift","type":"codeListing"},{"code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"],"syntax":"swift","type":"codeListing"},{"name":"Tip","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"import SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" is needed in "},{"inlineContent":[{"text":"every","type":"text"}],"type":"emphasis"},{"type":"text","text":" file that touches "},{"code":"store.killswitch.*","type":"codeVoice"},{"type":"text","text":" or "},{"code":"KillswitchAction","type":"codeVoice"},{"type":"text","text":" — including views that read the verdict for display. "},{"code":"@_exported import Swidux","type":"codeVoice"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"The plugin’s reducer handles "},{"code":".killswitch","type":"codeVoice"},{"type":"text","text":" actions itself. Your root reducer should fall through:"}],"type":"paragraph"},{"code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Step-3-Wire-the-plugin","type":"heading","text":"Step 3: Wire the plugin"},{"inlineContent":[{"type":"text","text":"Inside "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":", build a "},{"type":"codeVoice","code":"KillswitchPlugin"},{"type":"text","text":" and register it on the plugin host. Use "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":" for the production service:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(static: \"https:\/\/example.com\/killswitch.json\")","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"appVersion","type":"codeVoice"},{"text":" closure runs every time ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":" evaluates, so it reflects the build that’s actually running. The plugin’s default ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" argument opens URLs through ","type":"text"},{"code":"UIApplication","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"NSWorkspace","type":"codeVoice"},{"text":"; pass your own closure if you route URLs through a coordinator.","type":"text"}],"type":"paragraph"},{"anchor":"Step-4-Trigger-fetch-on-launch","level":2,"text":"Step 4: Trigger fetch on launch","type":"heading"},{"inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".killswitch(.fetch)"},{"type":"text","text":" from your root view’s "},{"type":"codeVoice","code":".task"},{"type":"text","text":" so the verdict is available before the user can interact:"}],"type":"paragraph"},{"syntax":"swift","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":".fetch","type":"codeVoice"},{"type":"text","text":" is cache-aware: if the last fetch is within "},{"code":"cacheLifetime","type":"codeVoice"},{"type":"text","text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch "},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"type":"text","text":" instead, which bypasses the freshness gate."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the network call fails and a cached config is available, the plugin dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from the cache "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed(message)"},{"type":"text","text":". Your UI keeps a usable verdict and can still surface the error."}],"type":"paragraph"},{"text":"Step 5: Render the verdict","type":"heading","level":2,"anchor":"Step-5-Render-the-verdict"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest path is the bundled "},{"type":"codeVoice","code":"killswitchBlocker(verdict:onUpdate:)"},{"type":"text","text":" view modifier. It overlays a non-dismissible blocker when the verdict is "},{"type":"codeVoice","code":".blocked"},{"type":"text","text":" and disables the underlying content while it is:"}]},{"code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":".unknown","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" render nothing — the blocker only appears once the verdict comes back as ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":". The Update button calls the ","type":"text"},{"code":"onUpdate","type":"codeVoice"},{"text":" closure, which dispatches ","type":"text"},{"code":".killswitch(.openUpdateURL)","type":"codeVoice"},{"text":". The plugin checks ","type":"text"},{"code":"canOpenUpdateURL","type":"codeVoice"},{"text":" and opens the URL through ","type":"text"},{"code":"UIApplication","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"NSWorkspace","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:"}]},{"code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The closure receives the verdict’s ","type":"text"},{"type":"codeVoice","code":"title"},{"text":", ","type":"text"},{"type":"codeVoice","code":"message"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"hasUpdateURL"},{"text":" flag derived from ","type":"text"},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":", so your custom view doesn’t have to pattern-match the verdict itself.","type":"text"}]},{"anchor":"Hosting-the-JSON-config","type":"heading","level":2,"text":"Hosting the JSON config"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The endpoint you pass to "},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"type":"text","text":" serves a JSON document matching "},{"code":"KillswitchConfig","type":"codeVoice"},{"type":"text","text":". Every field is optional. The four operational shapes you’ll actually use:"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"1. Soft minimum version (most common).","type":"text"}],"type":"strong"},{"text":" Force everyone below the floor to update; let everyone else through.","type":"text"}]},{"type":"codeListing","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"2. Emergency block of a specific bad build."}]},{"type":"text","text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue."}]},{"type":"codeListing","code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"3. Range block."}]},{"text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes).","type":"text"}]},{"type":"codeListing","code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Range entries use the literal string "},{"type":"codeVoice","code":"\"a.b.c..<x.y.z\""},{"type":"text","text":" — half-open, lower bound inclusive, upper bound exclusive."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"4. Allow everyone.","type":"text"}]},{"type":"text","text":" Sometimes you just want the killswitch live but quiet."}]},{"syntax":"json","code":["{}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rules combine. Adding all of them in one document lets you lift the floor "},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"type":"text","text":" knock out a specific bad build "},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"type":"text","text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:"}]},{"syntax":"json","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing"},{"level":3,"anchor":"Where-to-host-it","type":"heading","text":"Where to host it"},{"type":"paragraph","inlineContent":[{"text":"The contract is small: a public ","type":"text"},{"code":"GET","type":"codeVoice"},{"text":" that returns ","type":"text"},{"code":"KillswitchConfig","type":"codeVoice"},{"text":"-shaped JSON. It’s read on every cold launch, the plugin is fail-open, and it caches the result client-side — so the backend can be trivial. The one requirement that actually shapes the choice: ","type":"text"},{"inlineContent":[{"text":"a killswitch’s value is how fast you can push an emergency block.","type":"text"}],"type":"strong"},{"text":" Anything that needs a redeploy or a git build to change the config defeats the purpose.","type":"text"}]},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Option"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Change config without redeploy?"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Propagation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Notes"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Cloudflare Worker + Workers KV"}]},{"type":"text","text":" "},{"inlineContent":[{"text":"(recommended)","type":"text"}],"type":"emphasis"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"✅ ","type":"text"},{"type":"codeVoice","code":"wrangler kv key put"},{"text":" or dashboard","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"seconds"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Flip in seconds, edge-cached, room to add logic (geo\/gradual\/per-build) later. Runnable example below."}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Static object (R2 \/ S3 + CDN)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"✅ re-upload object"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"seconds (after purge)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Zero code. Must set ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":" as object metadata; no room to grow.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Static site \/ Pages (git-backed)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"❌ commit + build","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"~minutes"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The trap: build latency kills the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"emergency"}]},{"type":"text","text":" use case."}]}]],[[{"type":"paragraph","inlineContent":[{"text":"GitHub raw \/ Gist","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"✅ edit file"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"unpredictable"}]}],[{"inlineContent":[{"text":"Not a production CDN; you don’t control ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":", stale exactly when freshness matters.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Your own app backend","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}],[{"inlineContent":[{"text":"instant","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The trap: it’s the service most likely down precisely when you need the killswitch.","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Recommended: Cloudflare Worker + KV."}]},{"text":" The config lives in a KV key; the Worker returns it with a short ","type":"text"},{"type":"codeVoice","code":"Cache-Control"},{"text":". You push an emergency block by writing one KV key — no redeploy. A complete, runnable example is in ","type":"text"},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"text":" — one Worker, keyed ","type":"text"},{"type":"codeVoice","code":"GET \/<appID>\/<resource>"},{"text":", that serves killswitch ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"text":" feature-flag config for every app in a portfolio from a single URL and a single KV namespace (the Cloudflare dashboard becomes the one place you edit a value). The short version: create a KV namespace → seed ","type":"text"},{"type":"codeVoice","code":"…\/killswitch"},{"text":" → ","type":"text"},{"type":"codeVoice","code":"wrangler deploy"},{"text":" → point ","type":"text"},{"type":"codeVoice","code":"KillswitchService.live(endpoint:)"},{"text":" at ","type":"text"},{"type":"codeVoice","code":"https:\/\/<host>\/<appID>\/killswitch"},{"text":". See also ","type":"text"},{"type":"codeVoice","code":"Examples\/ConfigWorker\/DEPLOY.md"},{"text":" for the multi-app operating convention.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Minimal alternative: a static object"}],"type":"strong"},{"text":" (Cloudflare R2, S3, any object store fronted by a CDN). Upload ","type":"text"},{"code":"killswitch.json","type":"codeVoice"},{"text":", set a short ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":" on the object, re-upload to change it. Zero code; you give up the room to add server-side logic later. Equivalent push-in-seconds latency for this use case.","type":"text"}],"type":"paragraph"},{"text":"Freshness: the backend can’t fix client staleness","type":"heading","level":3,"anchor":"Freshness-the-backend-cant-fix-client-staleness"},{"inlineContent":[{"type":"text","text":"The plugin caches the fetched config for "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":" ("},{"type":"strong","inlineContent":[{"type":"text","text":"default 3600s"}]},{"type":"text","text":") regardless of how fresh your endpoint is. With the default, a perfectly deployed emergency block still won’t reach an already-launched app for up to an hour — and no backend choice changes that. If fast emergency response matters:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lower "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":" to ~300–900s in "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Dispatch ","type":"text"},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"text":" on app-foreground — it bypasses the freshness gate, so a returning user re-checks immediately.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Keep your endpoint’s edge "},{"code":"Cache-Control","type":"codeVoice"},{"type":"text","text":" at or below "},{"code":"cacheLifetime","type":"codeVoice"},{"text":"; caching longer at the edge than the client will re-ask buys nothing.","type":"text"}],"type":"paragraph"},{"text":"Testing","type":"heading","level":2,"anchor":"Testing"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"KillswitchService.mock(result:cached:cacheLifetime:)"},{"type":"text","text":" to drive the plugin from a test without hitting the network:"}],"type":"paragraph"},{"code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked, fromNetwork: true)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The mock factory’s ","type":"text"},{"code":"result","type":"codeVoice"},{"text":" closure can also throw. With no cached config, the plugin dispatches only ","type":"text"},{"code":".fetchFailed","type":"codeVoice"},{"text":". With a cached config, it dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from cache ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":".fetchFailed","type":"codeVoice"},{"text":", so test the fallback path with both ","type":"text"},{"code":"result:","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cached:","type":"codeVoice"},{"text":" set:","type":"text"}],"type":"paragraph"},{"code":["service: .mock(","    result: { throw URLError(.notConnectedToInternet) },","    cached: KillswitchConfig(minimumSupportedVersion: \"1.0.0\")",")"],"syntax":"swift","type":"codeListing"}]}],"sections":[],"references":{"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","title":"Add a Parental Gate","role":"article","identifier"