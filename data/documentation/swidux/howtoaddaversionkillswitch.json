{"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/swidux\/howtoaddaversionkillswitch"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article","title":"Add a Version Killswitch"},"abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"anchor":"How-to-Guides","title":"How-to Guides"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", so any view can react to it."}]},{"level":2,"anchor":"Before-you-start","type":"heading","text":"Before you start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired up: an "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and a "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory. If not, work through "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference","isActive":true},{"type":"text","text":" first."}]},{"level":2,"anchor":"Step-1-Add-the-dependency","type":"heading","text":"Step 1: Add the dependency"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" is a separate product in the "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" package. Add it to the target that wires the store:"}]},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you re-export Swidux from "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" (recommended), import "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" directly in "},{"type":"codeVoice","code":"AppStore.swift"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" where the types are referenced."}]},{"level":2,"anchor":"Step-2-Add-state-and-actions","type":"heading","text":"Step 2: Add state and actions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mount a "},{"type":"codeVoice","code":"KillswitchState"},{"type":"text","text":" slice on your root state and add an action case that wraps "},{"type":"codeVoice","code":"KillswitchAction"},{"type":"text","text":":"}]},{"code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"],"syntax":"swift","type":"codeListing"},{"code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin’s reducer handles "},{"type":"codeVoice","code":".killswitch"},{"type":"text","text":" actions itself. Your root reducer should fall through:"}]},{"code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Step-3-Wire-the-plugin","type":"heading","text":"Step 3: Wire the plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inside "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":", build a "},{"type":"codeVoice","code":"KillswitchPlugin"},{"type":"text","text":" and register it on the plugin host. Use "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":" for the production service:"}]},{"code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(string: \"https:\/\/example.com\/killswitch.json\")!","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"appVersion"},{"type":"text","text":" closure runs every time "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":" evaluates, so it reflects the build that’s actually running. The plugin’s default "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" argument opens URLs through "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" or "},{"type":"codeVoice","code":"NSWorkspace"},{"type":"text","text":"; pass your own closure if you route URLs through a coordinator."}]},{"level":2,"anchor":"Step-4-Trigger-fetch-on-launch","type":"heading","text":"Step 4: Trigger fetch on launch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".killswitch(.fetch)"},{"type":"text","text":" from your root view’s "},{"type":"codeVoice","code":".task"},{"type":"text","text":" so the verdict is available before the user can interact:"}]},{"code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"},{"type":"text","text":" is cache-aware: if the last fetch is within "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch "},{"type":"codeVoice","code":".killswitch(.forceFetch)"},{"type":"text","text":" instead, which bypasses the freshness gate."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the network call fails and a cached config is available, the plugin dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from the cache "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed(message)"},{"type":"text","text":". Your UI keeps a usable verdict and can still surface the error."}]},{"level":2,"anchor":"Step-5-Render-the-verdict","type":"heading","text":"Step 5: Render the verdict"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest path is the bundled "},{"type":"codeVoice","code":"killswitchBlocker(verdict:onUpdate:)"},{"type":"text","text":" view modifier. It overlays a non-dismissible blocker when the verdict is "},{"type":"codeVoice","code":".blocked"},{"type":"text","text":" and disables the underlying content while it is:"}]},{"code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unknown"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":" render nothing — the blocker only appears once the verdict comes back as ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"text":". The Update button calls the ","type":"text"},{"code":"onUpdate","type":"codeVoice"},{"type":"text","text":" closure, which dispatches "},{"code":".killswitch(.openUpdateURL)","type":"codeVoice"},{"text":". The plugin checks ","type":"text"},{"code":"canOpenUpdateURL","type":"codeVoice"},{"text":" and opens the URL through ","type":"text"},{"code":"UIApplication","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"NSWorkspace","type":"codeVoice"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The closure receives the verdict’s ","type":"text"},{"type":"codeVoice","code":"title"},{"type":"text","text":", "},{"type":"codeVoice","code":"message"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"hasUpdateURL"},{"text":" flag derived from ","type":"text"},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":", so your custom view doesn’t have to pattern-match the verdict itself.","type":"text"}]},{"anchor":"Hosting-the-JSON-config","level":2,"type":"heading","text":"Hosting the JSON config"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The endpoint you pass to "},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"text":" serves a JSON document matching ","type":"text"},{"code":"KillswitchConfig","type":"codeVoice"},{"text":". Every field is optional. The four operational shapes you’ll actually use:","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"1. Soft minimum version (most common)."}],"type":"strong"},{"text":" Force everyone below the floor to update; let everyone else through.","type":"text"}]},{"syntax":"json","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"2. Emergency block of a specific bad build."}]},{"text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue.","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"3. Range block."}]},{"text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes).","type":"text"}],"type":"paragraph"},{"code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"text":"Range entries use the literal string ","type":"text"},{"code":"\"a.b.c..<x.y.z\"","type":"codeVoice"},{"text":" — half-open, lower bound inclusive, upper bound exclusive.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"4. Allow everyone."}],"type":"strong"},{"type":"text","text":" Sometimes you just want the killswitch live but quiet."}]},{"syntax":"json","code":["{}"],"type":"codeListing"},{"inlineContent":[{"text":"Rules combine. Adding all of them in one document lets you lift the floor ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" knock out a specific bad build "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Serve the JSON with a short "},{"type":"codeVoice","code":"Cache-Control"},{"text":" (60–300 seconds) — the plugin already caches client-side via ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"text":", but a short edge-cache TTL keeps your origin from getting hammered after you push a config change.","type":"text"}],"type":"paragraph"},{"text":"Testing","level":2,"type":"heading","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"KillswitchService.mock(result:cached:cacheLifetime:)"},{"type":"text","text":" to drive the plugin from a test without hitting the network:"}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mock factory’s "},{"type":"codeVoice","code":"result"},{"type":"text","text":" closure can also throw. With no cached config, the plugin dispatches only "},{"type":"codeVoice","code":".fetchFailed"},{"type":"text","text":". With a cached config, it dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from cache "},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed"},{"type":"text","text":", so test the fallback path with both "},{"type":"codeVoice","code":"result:"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cached:"},{"type":"text","text":" set:"}]},{"syntax":"swift","type":"codeListing","code":["service: .mock(","    result: { throw URLError(.notConnectedToInternet) },","    cached: KillswitchConfig(minimumSupportedVersion: \"1.0.0\")",")"]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch"},"sections":[],"references":{"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"url":"\/documentation\/swidux\/pluginkillswitchreference","kind":"article","abstract":[{"text":"Public API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"title":"SwiduxKillswitch Reference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","role":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","kind":"article","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}]},"doc://Swidux/documentation/Swidux/AgentSkill":{"url":"\/documentation\/swidux\/agentskill","kind":"article","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"title":"Using the Swidux Agent Skill","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","title":"Add Feature Flags","url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}]},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","kind":"symbol","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","title":"Add a Parental Gate","url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}]},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}]},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","title":"Building a Domain Plugin","url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","url":"\/documentation\/swidux\/pluginarchitecture","title":"Plugin Architecture","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"url":"\/documentation\/swidux\/howtoaddanalytics","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"title":"Add Analytics","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","role":"article"}}}