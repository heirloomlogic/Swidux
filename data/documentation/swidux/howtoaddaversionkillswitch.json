{"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", so any view can react to it."}],"type":"paragraph"},{"anchor":"Before-you-start","type":"heading","level":2,"text":"Before you start"},{"inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired up: an "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and a "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory. If not, work through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"type":"text","text":" first."}],"type":"paragraph"},{"anchor":"Step-1-Add-the-dependency","type":"heading","level":2,"text":"Step 1: Add the dependency"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" is a separate product in the "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" package. Add it to the target that wires the store:"}]},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you re-export Swidux from "},{"code":"AppState.swift","type":"codeVoice"},{"type":"text","text":" (recommended), import "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" directly in "},{"code":"AppStore.swift","type":"codeVoice"},{"type":"text","text":" and "},{"code":"AppState.swift","type":"codeVoice"},{"type":"text","text":" where the types are referenced."}]},{"text":"Step 2: Add state and actions","type":"heading","level":2,"anchor":"Step-2-Add-state-and-actions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mount a "},{"type":"codeVoice","code":"KillswitchState"},{"type":"text","text":" slice on your root state and add an action case that wraps "},{"type":"codeVoice","code":"KillswitchAction"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"]},{"type":"aside","style":"tip","name":"Tip","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxKillswitch"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.killswitch.*"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"KillswitchAction"},{"text":" — including views that read the verdict for display. ","type":"text"},{"type":"codeVoice","code":"@_exported import Swidux"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}],"type":"paragraph"}]},{"inlineContent":[{"text":"The plugin’s reducer handles ","type":"text"},{"type":"codeVoice","code":".killswitch"},{"text":" actions itself. Your root reducer should fall through:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"]},{"type":"heading","text":"Step 3: Wire the plugin","anchor":"Step-3-Wire-the-plugin","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inside "},{"type":"codeVoice","code":"Store.configured()"},{"text":", build a ","type":"text"},{"type":"codeVoice","code":"KillswitchPlugin"},{"text":" and register it on the plugin host. Use ","type":"text"},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":" for the production service:"}]},{"syntax":"swift","code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(static: \"https:\/\/example.com\/killswitch.json\")","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"appVersion","type":"codeVoice"},{"type":"text","text":" closure runs every time "},{"code":".fetch","type":"codeVoice"},{"text":" evaluates, so it reflects the build that’s actually running. The plugin’s default ","type":"text"},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" argument opens URLs through "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" or "},{"type":"codeVoice","code":"NSWorkspace"},{"type":"text","text":"; pass your own closure if you route URLs through a coordinator."}]},{"type":"heading","text":"Step 4: Trigger fetch on launch","anchor":"Step-4-Trigger-fetch-on-launch","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".killswitch(.fetch)"},{"type":"text","text":" from your root view’s "},{"type":"codeVoice","code":".task"},{"type":"text","text":" so the verdict is available before the user can interact:"}]},{"syntax":"swift","type":"codeListing","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"},{"type":"text","text":" is cache-aware: if the last fetch is within "},{"code":"cacheLifetime","type":"codeVoice"},{"text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch ","type":"text"},{"type":"codeVoice","code":".killswitch(.forceFetch)"},{"type":"text","text":" instead, which bypasses the freshness gate."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the network call fails and a cached config is available, the plugin dispatches "},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from the cache ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":".fetchFailed(message)","type":"codeVoice"},{"text":". Your UI keeps a usable verdict and can still surface the error.","type":"text"}]},{"level":2,"type":"heading","text":"Step 5: Render the verdict","anchor":"Step-5-Render-the-verdict"},{"inlineContent":[{"type":"text","text":"The simplest path is the bundled "},{"type":"codeVoice","code":"killswitchBlocker(verdict:onUpdate:)"},{"type":"text","text":" view modifier. It overlays a non-dismissible blocker when the verdict is "},{"type":"codeVoice","code":".blocked"},{"text":" and disables the underlying content while it is:","type":"text"}],"type":"paragraph"},{"code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unknown"},{"type":"text","text":" and "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" render nothing — the blocker only appears once the verdict comes back as "},{"type":"codeVoice","code":".blocked(...)"},{"text":". The Update button calls the ","type":"text"},{"code":"onUpdate","type":"codeVoice"},{"type":"text","text":" closure, which dispatches "},{"code":".killswitch(.openUpdateURL)","type":"codeVoice"},{"type":"text","text":". The plugin checks "},{"code":"canOpenUpdateURL","type":"codeVoice"},{"type":"text","text":" and opens the URL through "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"NSWorkspace"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:"}]},{"type":"codeListing","code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The closure receives the verdict’s ","type":"text"},{"code":"title","type":"codeVoice"},{"text":", ","type":"text"},{"code":"message","type":"codeVoice"},{"text":", and a ","type":"text"},{"code":"hasUpdateURL","type":"codeVoice"},{"text":" flag derived from ","type":"text"},{"code":"canOpenUpdateURL","type":"codeVoice"},{"text":", so your custom view doesn’t have to pattern-match the verdict itself.","type":"text"}]},{"type":"heading","level":2,"text":"Hosting the JSON config","anchor":"Hosting-the-JSON-config"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The endpoint you pass to "},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"type":"text","text":" serves a JSON document matching "},{"code":"KillswitchConfig","type":"codeVoice"},{"text":". Every field is optional. The four operational shapes you’ll actually use:","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"1. Soft minimum version (most common)."}],"type":"strong"},{"type":"text","text":" Force everyone below the floor to update; let everyone else through."}]},{"type":"codeListing","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"2. Emergency block of a specific bad build.","type":"text"}],"type":"strong"},{"text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue.","type":"text"}]},{"type":"codeListing","code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"3. Range block.","type":"text"}]},{"type":"text","text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes)."}]},{"type":"codeListing","code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Range entries use the literal string "},{"code":"\"a.b.c..<x.y.z\"","type":"codeVoice"},{"type":"text","text":" — half-open, lower bound inclusive, upper bound exclusive."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"4. Allow everyone."}]},{"type":"text","text":" Sometimes you just want the killswitch live but quiet."}]},{"type":"codeListing","code":["{}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rules combine. Adding all of them in one document lets you lift the floor "},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"type":"text","text":" knock out a specific bad build "},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"type":"heading","text":"Where to host it","anchor":"Where-to-host-it","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The contract is small: a public "},{"type":"codeVoice","code":"GET"},{"text":" that returns ","type":"text"},{"code":"KillswitchConfig","type":"codeVoice"},{"text":"-shaped JSON. It’s read on every cold launch, the plugin is fail-open, and it caches the result client-side — so the backend can be trivial. The one requirement that actually shapes the choice: ","type":"text"},{"inlineContent":[{"type":"text","text":"a killswitch’s value is how fast you can push an emergency block."}],"type":"strong"},{"text":" Anything that needs a redeploy or a git build to change the config defeats the purpose.","type":"text"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Option","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Change config without redeploy?"}]}],[{"type":"paragraph","inlineContent":[{"text":"Propagation","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Notes"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Cloudflare Worker + Workers KV"}]},{"text":" ","type":"text"},{"inlineContent":[{"text":"(recommended)","type":"text"}],"type":"emphasis"}]}],[{"inlineContent":[{"type":"text","text":"✅ "},{"type":"codeVoice","code":"wrangler kv key put"},{"type":"text","text":" or dashboard"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"seconds"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Flip in seconds, edge-cached, room to add logic (geo\/gradual\/per-build) later. Runnable example below."}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Static object (R2 \/ S3 + CDN)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅ re-upload object","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"seconds (after purge)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Zero code. Must set "},{"code":"Cache-Control","type":"codeVoice"},{"type":"text","text":" as object metadata; no room to grow."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"Static site \/ Pages (git-backed)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"❌ commit + build"}]}],[{"type":"paragraph","inlineContent":[{"text":"~minutes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The trap: build latency kills the ","type":"text"},{"inlineContent":[{"text":"emergency","type":"text"}],"type":"emphasis"},{"text":" use case.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"GitHub raw \/ Gist","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"✅ edit file"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"unpredictable"}]}],[{"type":"paragraph","inlineContent":[{"text":"Not a production CDN; you don’t control ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":", stale exactly when freshness matters.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Your own app backend","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"✅"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"instant"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The trap: it’s the service most likely down precisely when you need the killswitch."}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Recommended: Cloudflare Worker + KV.","type":"text"}]},{"type":"text","text":" The config lives in a KV key; the Worker returns it with a short "},{"code":"Cache-Control","type":"codeVoice"},{"text":". You push an emergency block by writing one KV key — no redeploy. A complete, runnable example is in ","type":"text"},{"code":"Examples\/ConfigWorker\/","type":"codeVoice"},{"text":" — one Worker, keyed ","type":"text"},{"code":"GET \/<appID>\/<resource>","type":"codeVoice"},{"text":", that serves killswitch ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" feature-flag config for every app in a portfolio from a single URL and a single KV namespace (the Cloudflare dashboard becomes the one place you edit a value). The short version: create a KV namespace → seed ","type":"text"},{"code":"…\/killswitch","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"wrangler deploy","type":"codeVoice"},{"text":" → point ","type":"text"},{"code":"KillswitchService.live(endpoint:)","type":"codeVoice"},{"text":" at ","type":"text"},{"code":"https:\/\/<host>\/<appID>\/killswitch","type":"codeVoice"},{"text":". See also ","type":"text"},{"code":"Examples\/ConfigWorker\/DEPLOY.md","type":"codeVoice"},{"text":" for the multi-app operating convention.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Minimal alternative: a static object","type":"text"}]},{"text":" (Cloudflare R2, S3, any object store fronted by a CDN). Upload ","type":"text"},{"type":"codeVoice","code":"killswitch.json"},{"text":", set a short ","type":"text"},{"type":"codeVoice","code":"Cache-Control"},{"text":" on the object, re-upload to change it. Zero code; you give up the room to add server-side logic later. Equivalent push-in-seconds latency for this use case.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Freshness: the backend can’t fix client staleness","type":"heading","anchor":"Freshness-the-backend-cant-fix-client-staleness"},{"inlineContent":[{"text":"The plugin caches the fetched config for ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":" (","type":"text"},{"type":"strong","inlineContent":[{"text":"default 3600s","type":"text"}]},{"text":") regardless of how fresh your endpoint is. With the default, a perfectly deployed emergency block still won’t reach an already-launched app for up to an hour — and no backend choice changes that. If fast emergency response matters:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Lower ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":" to ~300–900s in ","type":"text"},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".killswitch(.forceFetch)"},{"type":"text","text":" on app-foreground — it bypasses the freshness gate, so a returning user re-checks immediately."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep your endpoint’s edge "},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":" at or below "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":"; caching longer at the edge than the client will re-ask buys nothing."}]},{"type":"heading","text":"Testing","level":2,"anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"KillswitchService.mock(result:cached:cacheLifetime:)"},{"type":"text","text":" to drive the plugin from a test without hitting the network:"}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked, fromNetwork: true)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The mock factory’s ","type":"text"},{"code":"result","type":"codeVoice"},{"text":" closure can also throw. With no cached config, the plugin dispatches only ","type":"text"},{"code":".fetchFailed","type":"codeVoice"},{"text":". With a cached config, it dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from cache ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"text":" ","type":"text"},{"code":".fetchFailed","type":"codeVoice"},{"text":", so test the fallback path with both ","type":"text"},{"type":"codeVoice","code":"result:"},{"text":" and ","type":"text"},{"type":"codeVoice","c