{"kind":"article","metadata":{"role":"article","title":"Add a Version Killswitch","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"sections":[],"variants":[{"paths":["\/documentation\/swidux\/howtoaddaversionkillswitch"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"anchor":"How-to-Guides","generated":true,"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", so any view can react to it."}]},{"type":"heading","anchor":"Before-you-start","level":2,"text":"Before you start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired up: an "},{"type":"codeVoice","code":"AppState"},{"text":", an ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", an ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and a "},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory. If not, work through ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"type":"text","text":" first."}]},{"type":"heading","level":2,"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" is a separate product in the ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":" package. Add it to the target that wires the store:","type":"text"}]},{"type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If you re-export Swidux from ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":" (recommended), import ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" directly in ","type":"text"},{"type":"codeVoice","code":"AppStore.swift"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":" where the types are referenced.","type":"text"}]},{"type":"heading","level":2,"text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions"},{"type":"paragraph","inlineContent":[{"text":"Mount a ","type":"text"},{"type":"codeVoice","code":"KillswitchState"},{"text":" slice on your root state and add an action case that wraps ","type":"text"},{"type":"codeVoice","code":"KillswitchAction"},{"text":":","type":"text"}]},{"type":"codeListing","code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@SwiduxState","nonisolated struct AppState: Equatable, Sendable {","    @SwiduxNested var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"],"syntax":"swift"},{"code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The plugin’s reducer handles "},{"code":".killswitch","type":"codeVoice"},{"type":"text","text":" actions itself. Your root reducer should fall through:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"]},{"text":"Step 3: Wire the plugin","type":"heading","level":2,"anchor":"Step-3-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inside "},{"code":"Store.configured()","type":"codeVoice"},{"text":", build a ","type":"text"},{"code":"KillswitchPlugin","type":"codeVoice"},{"type":"text","text":" and register it on the plugin host. Use "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":" for the production service:"}]},{"code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(string: \"https:\/\/example.com\/killswitch.json\")!","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"appVersion","type":"codeVoice"},{"text":" closure runs every time ","type":"text"},{"type":"codeVoice","code":".fetch"},{"text":" evaluates, so it reflects the build that’s actually running. The plugin’s default ","type":"text"},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" argument opens URLs through "},{"code":"UIApplication","type":"codeVoice"},{"type":"text","text":" or "},{"code":"NSWorkspace","type":"codeVoice"},{"type":"text","text":"; pass your own closure if you route URLs through a coordinator."}]},{"type":"heading","anchor":"Step-4-Trigger-fetch-on-launch","level":2,"text":"Step 4: Trigger fetch on launch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".killswitch(.fetch)"},{"text":" from your root view’s ","type":"text"},{"type":"codeVoice","code":".task"},{"type":"text","text":" so the verdict is available before the user can interact:"}]},{"type":"codeListing","syntax":"swift","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"},{"type":"text","text":" is cache-aware: if the last fetch is within "},{"code":"cacheLifetime","type":"codeVoice"},{"text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch ","type":"text"},{"type":"codeVoice","code":".killswitch(.forceFetch)"},{"text":" instead, which bypasses the freshness gate.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the network call fails and a cached config is available, the plugin dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from the cache "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed(message)"},{"type":"text","text":". Your UI keeps a usable verdict and can still surface the error."}]},{"type":"heading","level":2,"text":"Step 5: Render the verdict","anchor":"Step-5-Render-the-verdict"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest path is the bundled "},{"code":"killswitchBlocker(verdict:onUpdate:)","type":"codeVoice"},{"type":"text","text":" view modifier. It overlays a non-dismissible blocker when the verdict is "},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" and disables the underlying content while it is:"}]},{"type":"codeListing","syntax":"swift","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"]},{"type":"paragraph","inlineContent":[{"code":".unknown","type":"codeVoice"},{"type":"text","text":" and "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" render nothing — the blocker only appears once the verdict comes back as "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":". The Update button calls the "},{"code":"onUpdate","type":"codeVoice"},{"type":"text","text":" closure, which dispatches "},{"type":"codeVoice","code":".killswitch(.openUpdateURL)"},{"type":"text","text":". The plugin checks "},{"type":"codeVoice","code":"canOpenUpdateURL"},{"type":"text","text":" and opens the URL through "},{"code":"UIApplication","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"NSWorkspace","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:","type":"text"}]},{"code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The closure receives the verdict’s ","type":"text"},{"type":"codeVoice","code":"title"},{"type":"text","text":", "},{"code":"message","type":"codeVoice"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"hasUpdateURL"},{"text":" flag derived from ","type":"text"},{"code":"canOpenUpdateURL","type":"codeVoice"},{"text":", so your custom view doesn’t have to pattern-match the verdict itself.","type":"text"}]},{"text":"Hosting the JSON config","type":"heading","level":2,"anchor":"Hosting-the-JSON-config"},{"inlineContent":[{"type":"text","text":"The endpoint you pass to "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":" serves a JSON document matching "},{"code":"KillswitchConfig","type":"codeVoice"},{"text":". Every field is optional. The four operational shapes you’ll actually use:","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"1. Soft minimum version (most common).","type":"text"}],"type":"strong"},{"type":"text","text":" Force everyone below the floor to update; let everyone else through."}]},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"2. Emergency block of a specific bad build.","type":"text"}],"type":"strong"},{"text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue.","type":"text"}]},{"syntax":"json","type":"codeListing","code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"3. Range block."}],"type":"strong"},{"text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes).","type":"text"}]},{"code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Range entries use the literal string "},{"type":"codeVoice","code":"\"a.b.c..<x.y.z\""},{"type":"text","text":" — half-open, lower bound inclusive, upper bound exclusive."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"4. Allow everyone."}]},{"type":"text","text":" Sometimes you just want the killswitch live but quiet."}]},{"code":["{}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"type":"text","text":"Rules combine. Adding all of them in one document lets you lift the floor "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"text":" knock out a specific bad build ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:"}],"type":"paragraph"},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Serve the JSON with a short "},{"type":"codeVoice","code":"Cache-Control"},{"text":" (60–300 seconds) — the plugin already caches client-side via ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"text":", but a short edge-cache TTL keeps your origin from getting hammered after you push a config change.","type":"text"}]},{"text":"Testing","type":"heading","level":2,"anchor":"Testing"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"KillswitchService.mock(result:cached:cacheLifetime:)","type":"codeVoice"},{"type":"text","text":" to drive the plugin from a test without hitting the network:"}],"type":"paragraph"},{"code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The mock factory’s ","type":"text"},{"code":"result","type":"codeVoice"},{"type":"text","text":" closure can also throw. With no cached config, the plugin dispatches only "},{"code":".fetchFailed","type":"codeVoice"},{"text":". With a cached config, it dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"type":"text","text":" from cache "},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" "},{"code":".fetchFailed","type":"codeVoice"},{"type":"text","text":", so test the fallback path with both "},{"code":"result:","type":"codeVoice"},{"type":"text","text":" and "},{"code":"cached:","type":"codeVoice"},{"type":"text","text":" set:"}],"type":"paragraph"},{"code":["service: .mock(","    result: { throw URLError(.notConnectedToInternet) },","    cached: KillswitchConfig(minimumSupportedVersion: \"1.0.0\")",")"],"type":"codeListing","syntax":"swift"}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://Swidux/documentation/Swidux":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","role":"collection","kind":"symbol","title":"Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}]},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","url":"\/documentation\/swidux\/buildingadomainplugin","title":"Building a Domain Plugin","role":"article","kind":"article","type":"topic","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}]},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","title":"Using the Swidux Agent Skill","role":"article","kind":"article","type":"topic","abstract":[{"text":"Install the bundled ","type":"text"},{"code":"swidux-ref","type":"codeVoice"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"kind":"article","title":"Add a Paywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"kind":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","type":"topic","title":"Add a Parental Gate","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"type":"topic","url":"\/documentation\/swidux\/pluginkillswitchreference","title":"SwiduxKillswitch Reference","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","role":"article","abstract":[{"type":"text","text":"Public API surface for the "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"kind":"article","url":"\/documentation\/swidux\/pluginarchitecture","type":"topic","title":"Plugin Architecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","url":"\/documentation\/swidux\/gettingstarted","role":"article","kind":"article","title":"Getting Started with Swidux","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}]}}}