{"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"anchor":"How-to-Guides"}],"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"Add a Version Killswitch"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/swidux\/howtoaddaversionkillswitch"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", so any view can react to it."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Before you start","anchor":"Before-you-start"},{"inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired up: an "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", an "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", an "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and a "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory. If not, work through "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" is a separate product in the "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":" package. Add it to the target that wires the store:"}],"type":"paragraph"},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"If you re-export Swidux from "},{"code":"AppState.swift","type":"codeVoice"},{"type":"text","text":" (recommended), import "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" directly in "},{"code":"AppStore.swift","type":"codeVoice"},{"type":"text","text":" and "},{"code":"AppState.swift","type":"codeVoice"},{"type":"text","text":" where the types are referenced."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions"},{"inlineContent":[{"type":"text","text":"Mount a "},{"code":"KillswitchState","type":"codeVoice"},{"type":"text","text":" slice on your root state and add an action case that wraps "},{"code":"KillswitchAction","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"],"type":"codeListing","syntax":"swift"},{"code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The plugin’s reducer handles "},{"code":".killswitch","type":"codeVoice"},{"type":"text","text":" actions itself. Your root reducer should fall through:"}],"type":"paragraph"},{"code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Step 3: Wire the plugin","anchor":"Step-3-Wire-the-plugin"},{"inlineContent":[{"type":"text","text":"Inside "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":", build a "},{"code":"KillswitchPlugin","type":"codeVoice"},{"type":"text","text":" and register it on the plugin host. Use "},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"type":"text","text":" for the production service:"}],"type":"paragraph"},{"code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(string: \"https:\/\/example.com\/killswitch.json\")!","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"code":"appVersion","type":"codeVoice"},{"type":"text","text":" closure runs every time "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":" evaluates, so it reflects the build that’s actually running. The plugin’s default "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" argument opens URLs through "},{"code":"UIApplication","type":"codeVoice"},{"type":"text","text":" or "},{"code":"NSWorkspace","type":"codeVoice"},{"type":"text","text":"; pass your own closure if you route URLs through a coordinator."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 4: Trigger fetch on launch","anchor":"Step-4-Trigger-fetch-on-launch"},{"inlineContent":[{"type":"text","text":"Dispatch "},{"code":".killswitch(.fetch)","type":"codeVoice"},{"type":"text","text":" from your root view’s "},{"code":".task","type":"codeVoice"},{"type":"text","text":" so the verdict is available before the user can interact:"}],"type":"paragraph"},{"code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":".fetch","type":"codeVoice"},{"type":"text","text":" is cache-aware: if the last fetch is within "},{"code":"cacheLifetime","type":"codeVoice"},{"type":"text","text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch "},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"type":"text","text":" instead, which bypasses the freshness gate."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the network call fails and a cached config is available, the plugin dispatches "},{"code":".verdictReceived(...)","type":"codeVoice"},{"type":"text","text":" from the cache "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" "},{"code":".fetchFailed(message)","type":"codeVoice"},{"type":"text","text":". Your UI keeps a usable verdict and can still surface the error."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 5: Render the verdict","anchor":"Step-5-Render-the-verdict"},{"inlineContent":[{"type":"text","text":"The simplest path is the bundled "},{"code":"killswitchBlocker(verdict:onUpdate:)","type":"codeVoice"},{"type":"text","text":" view modifier. It overlays a non-dismissible blocker when the verdict is "},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" and disables the underlying content while it is:"}],"type":"paragraph"},{"code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":".unknown","type":"codeVoice"},{"type":"text","text":" and "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" render nothing — the blocker only appears once the verdict comes back as "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":". The Update button calls the "},{"code":"onUpdate","type":"codeVoice"},{"type":"text","text":" closure, which dispatches "},{"code":".killswitch(.openUpdateURL)","type":"codeVoice"},{"type":"text","text":". The plugin checks "},{"code":"canOpenUpdateURL","type":"codeVoice"},{"type":"text","text":" and opens the URL through "},{"code":"UIApplication","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"NSWorkspace","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:"}],"type":"paragraph"},{"code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The closure receives the verdict’s "},{"code":"title","type":"codeVoice"},{"type":"text","text":", "},{"code":"message","type":"codeVoice"},{"type":"text","text":", and a "},{"code":"hasUpdateURL","type":"codeVoice"},{"type":"text","text":" flag derived from "},{"code":"canOpenUpdateURL","type":"codeVoice"},{"type":"text","text":", so your custom view doesn’t have to pattern-match the verdict itself."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Hosting the JSON config","anchor":"Hosting-the-JSON-config"},{"inlineContent":[{"type":"text","text":"The endpoint you pass to "},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"type":"text","text":" serves a JSON document matching "},{"code":"KillswitchConfig","type":"codeVoice"},{"type":"text","text":". Every field is optional. The four operational shapes you’ll actually use:"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"1. Soft minimum version (most common)."}]},{"type":"text","text":" Force everyone below the floor to update; let everyone else through."}],"type":"paragraph"},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"2. Emergency block of a specific bad build."}]},{"type":"text","text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue."}],"type":"paragraph"},{"code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"3. Range block."}]},{"type":"text","text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes)."}],"type":"paragraph"},{"code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"type":"text","text":"Range entries use the literal string "},{"code":"\"a.b.c..<x.y.z\"","type":"codeVoice"},{"type":"text","text":" — half-open, lower bound inclusive, upper bound exclusive."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"4. Allow everyone."}]},{"type":"text","text":" Sometimes you just want the killswitch live but quiet."}],"type":"paragraph"},{"code":["{}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"text":"Rules combine. Adding all of them in one document lets you lift the floor ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" knock out a specific bad build ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:","type":"text"}],"type":"paragraph"},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"text":"Serve the JSON with a short ","type":"text"},{"type":"codeVoice","code":"Cache-Control"},{"text":" (60–300 seconds) — the plugin already caches client-side via ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":", but a short edge-cache TTL keeps your origin from getting hammered after you push a config change.","type":"text"}],"type":"paragraph"},{"text":"Testing","anchor":"Testing","level":2,"type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"KillswitchService.mock(result:cached:cacheLifetime:)"},{"text":" to drive the plugin from a test without hitting the network:","type":"text"}],"type":"paragraph"},{"code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mock factory’s "},{"code":"result","type":"codeVoice"},{"type":"text","text":" closure can also throw. With no cached config, the plugin dispatches only "},{"code":".fetchFailed","type":"codeVoice"},{"text":". With a cached config, it dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" from cache ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed"},{"type":"text","text":", so test the fallback path with both "},{"code":"result:","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cached:"},{"type":"text","text":" set:"}]},{"type":"codeListing","syntax":"swift","code":["service: .mock(","    result: { throw URLError(.notConnectedToInternet) },","    cached: KillswitchConfig(minimumSupportedVersion: \"1.0.0\")",")"]}]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","url":"\/documentation\/swidux\/howtoaddanalytics","kind":"article","type":"topic","title":"Add Analytics","role":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","role":"article","title":"Getting Started with Swidux","type":"topic","url":"\/documentation\/swidux\/gettingstarted","kind":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","url":"\/documentation\/swidux\/pluginkillswitchreference","title":"SwiduxKillswitch Reference","type":"topic","kind":"article","role":"article","abstract":[{"text":"Public API surface for the ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article","type":"topic","title":"Add Feature Flags","role":"article","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"url":"\/documentation\/swidux\/pluginarchitecture","title":"Plugin Architecture","kind":"article"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","url":"\/documentation\/swidux\/buildingadomainplugin","title":"Building a Domain Plugin","type":"topic","kind":"article","role":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}]},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","kind":"symbol","type":"topic","title":"Swidux","role":"collection","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","type":"topic","title":"Add a Parental Gate","role":"article","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}]},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","title":"Using the Swidux Agent Skill","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}]},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","role":"article","title":"Add a Paywall","type":"topic","url":"\/documentation\/swidux\/howtoaddapaywall","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}]}}}