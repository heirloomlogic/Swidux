 or ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"text":" closures.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddpersistence","type":"topic","title":"Add Persistence","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","role":"article"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","title":"SwiduxKillswitch Reference","role":"article","kind":"article","url":"\/documentation\/swidux\/pluginkillswitchreference","abstract":[{"text":"Public API surface for the ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddaparentalgate","type":"topic","title":"Add a Parental Gate","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","role":"article"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","title":"Cancel Effects","role":"article","kind":"article","url":"\/documentation\/swidux\/howtocanceleffects","abstract":[{"text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","title":"Add Analytics","role":"article","kind":"article","url":"\/documentation\/swidux\/howtoaddanalytics","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" p