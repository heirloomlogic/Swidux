{"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides","title":"How-to Guides"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", so any view can react to it.","type":"text"}],"type":"paragraph"},{"text":"Before you start","anchor":"Before-you-start","level":2,"type":"heading"},{"inlineContent":[{"text":"This guide assumes you already have a Swidux app wired up: an ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", an ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":", an ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory. If not, work through ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference","isActive":true},{"text":" first.","type":"text"}],"type":"paragraph"},{"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" is a separate product in the ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":" package. Add it to the target that wires the store:","type":"text"}],"type":"paragraph"},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"If you re-export Swidux from ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":" (recommended), import ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" directly in ","type":"text"},{"type":"codeVoice","code":"AppStore.swift"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":" where the types are referenced.","type":"text"}],"type":"paragraph"},{"text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions","level":2,"type":"heading"},{"inlineContent":[{"text":"Mount a ","type":"text"},{"type":"codeVoice","code":"KillswitchState"},{"text":" slice on your root state and add an action case that wraps ","type":"text"},{"type":"codeVoice","code":"KillswitchAction"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@SwiduxState","nonisolated struct AppState: Equatable, Sendable {","    @SwiduxNested var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"],"syntax":"swift","type":"codeListing"},{"code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The plugin’s reducer handles ","type":"text"},{"type":"codeVoice","code":".killswitch"},{"text":" actions itself. Your root reducer should fall through:","type":"text"}],"type":"paragraph"},{"code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Step 3: Wire the plugin","anchor":"Step-3-Wire-the-plugin","level":2,"type":"heading"},{"inlineContent":[{"text":"Inside ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":", build a ","type":"text"},{"type":"codeVoice","code":"KillswitchPlugin"},{"type":"text","text":" and register it on the plugin host. Use "},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"text":" for the production service:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(string: \"https:\/\/example.com\/killswitch.json\")!","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"appVersion","type":"codeVoice"},{"type":"text","text":" closure runs every time "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":" evaluates, so it reflects the build that’s actually running. The plugin’s default "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" argument opens URLs through "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" or "},{"type":"codeVoice","code":"NSWorkspace"},{"type":"text","text":"; pass your own closure if you route URLs through a coordinator."}]},{"type":"heading","text":"Step 4: Trigger fetch on launch","level":2,"anchor":"Step-4-Trigger-fetch-on-launch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".killswitch(.fetch)"},{"type":"text","text":" from your root view’s "},{"type":"codeVoice","code":".task"},{"type":"text","text":" so the verdict is available before the user can interact:"}]},{"code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":".fetch","type":"codeVoice"},{"type":"text","text":" is cache-aware: if the last fetch is within "},{"code":"cacheLifetime","type":"codeVoice"},{"type":"text","text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch "},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"type":"text","text":" instead, which bypasses the freshness gate."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the network call fails and a cached config is available, the plugin dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from the cache "},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"type":"text","text":" "},{"code":".fetchFailed(message)","type":"codeVoice"},{"type":"text","text":". Your UI keeps a usable verdict and can still surface the error."}]},{"anchor":"Step-5-Render-the-verdict","type":"heading","text":"Step 5: Render the verdict","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest path is the bundled "},{"code":"killswitchBlocker(verdict:onUpdate:)","type":"codeVoice"},{"text":" view modifier. It overlays a non-dismissible blocker when the verdict is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" and disables the underlying content while it is:","type":"text"}]},{"code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":".unknown","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" render nothing — the blocker only appears once the verdict comes back as ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":". The Update button calls the ","type":"text"},{"type":"codeVoice","code":"onUpdate"},{"text":" closure, which dispatches ","type":"text"},{"code":".killswitch(.openUpdateURL)","type":"codeVoice"},{"text":". The plugin checks ","type":"text"},{"code":"canOpenUpdateURL","type":"codeVoice"},{"text":" and opens the URL through ","type":"text"},{"code":"UIApplication","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"NSWorkspace","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:","type":"text"}],"type":"paragraph"},{"code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The closure receives the verdict’s ","type":"text"},{"type":"codeVoice","code":"title"},{"text":", ","type":"text"},{"type":"codeVoice","code":"message"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"hasUpdateURL"},{"text":" flag derived from ","type":"text"},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":", so your custom view doesn’t have to pattern-match the verdict itself.","type":"text"}],"type":"paragraph"},{"anchor":"Hosting-the-JSON-config","level":2,"text":"Hosting the JSON config","type":"heading"},{"inlineContent":[{"text":"The endpoint you pass to ","type":"text"},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"text":" serves a JSON document matching ","type":"text"},{"type":"codeVoice","code":"KillswitchConfig"},{"text":". Every field is optional. The four operational shapes you’ll actually use:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"1. Soft minimum version (most common).","type":"text"}]},{"text":" Force everyone below the floor to update; let everyone else through.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"json","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"2. Emergency block of a specific bad build."}],"type":"strong"},{"type":"text","text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue."}]},{"syntax":"json","code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"3. Range block."}],"type":"strong"},{"type":"text","text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes)."}]},{"type":"codeListing","syntax":"json","code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Range entries use the literal string "},{"code":"\"a.b.c..<x.y.z\"","type":"codeVoice"},{"type":"text","text":" — half-open, lower bound inclusive, upper bound exclusive."}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"4. Allow everyone."}]},{"type":"text","text":" Sometimes you just want the killswitch live but quiet."}]},{"type":"codeListing","syntax":"json","code":["{}"]},{"type":"paragraph","inlineContent":[{"text":"Rules combine. Adding all of them in one document lets you lift the floor ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"text":" knock out a specific bad build ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:","type":"text"}]},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"text":"Serve the JSON with a short ","type":"text"},{"type":"codeVoice","code":"Cache-Control"},{"text":" (60–300 seconds) — the plugin already caches client-side via ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"text":", but a short edge-cache TTL keeps your origin from getting hammered after you push a config change.","type":"text"}],"type":"paragraph"},{"text":"Testing","anchor":"Testing","level":2,"type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"KillswitchService.mock(result:cached:cacheLifetime:)"},{"text":" to drive the plugin from a test without hitting the network:","type":"text"}],"type":"paragraph"},{"code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The mock factory’s ","type":"text"},{"code":"result","type":"codeVoice"},{"text":" closure can also throw. With no cached config, the plugin dispatches only ","type":"text"},{"code":".fetchFailed","type":"codeVoice"},{"text":". With a cached config, it dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from cache ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"text":" ","type":"text"},{"code":".fetchFailed","type":"codeVoice"},{"text":", so test the fallback path with both ","type":"text"},{"code":"result:","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cached:","type":"codeVoice"},{"text":" set:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["service: .mock(","    result: { throw URLError(.notConnectedToInternet) },","    cached: KillswitchConfig(minimumSupportedVersion: \"1.0.0\")",")"],"type":"codeListing"}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article","title":"Add a Version Killswitch"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddaversionkillswitch"]}],"references":{"d