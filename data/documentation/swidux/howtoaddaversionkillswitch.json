{"abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddaversionkillswitch"]}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", so any view can react to it.","type":"text"}]},{"type":"heading","anchor":"Before-you-start","text":"Before you start","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired up: an "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", an "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", an "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and a "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory. If not, work through "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference"},{"type":"text","text":" first."}]},{"type":"heading","anchor":"Step-1-Add-the-dependency","text":"Step 1: Add the dependency","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" is a separate product in the "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" package. Add it to the target that wires the store:"}]},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you re-export Swidux from "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" (recommended), import "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" directly in "},{"type":"codeVoice","code":"AppStore.swift"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" where the types are referenced."}]},{"text":"Step 2: Add state and actions","level":2,"type":"heading","anchor":"Step-2-Add-state-and-actions"},{"inlineContent":[{"type":"text","text":"Mount a "},{"type":"codeVoice","code":"KillswitchState"},{"type":"text","text":" slice on your root state and add an action case that wraps "},{"type":"codeVoice","code":"KillswitchAction"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"],"type":"codeListing"},{"syntax":"swift","code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"],"type":"codeListing"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxKillswitch"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"text":"every","type":"text"}]},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.killswitch.*"},{"type":"text","text":" or "},{"type":"codeVoice","code":"KillswitchAction"},{"type":"text","text":" — including views that read the verdict for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","name":"Tip","style":"tip"},{"inlineContent":[{"text":"The plugin’s reducer handles ","type":"text"},{"code":".killswitch","type":"codeVoice"},{"text":" actions itself. Your root reducer should fall through:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"]},{"level":2,"type":"heading","text":"Step 3: Wire the plugin","anchor":"Step-3-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inside "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":", build a "},{"type":"codeVoice","code":"KillswitchPlugin"},{"type":"text","text":" and register it on the plugin host. Use "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":" for the production service:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(static: \"https:\/\/example.com\/killswitch.json\")","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"]},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"appVersion"},{"type":"text","text":" closure runs every time "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":" evaluates, so it reflects the build that’s actually running. The plugin’s default "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" argument opens URLs through "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" or "},{"type":"codeVoice","code":"NSWorkspace"},{"type":"text","text":"; pass your own closure if you route URLs through a coordinator."}],"type":"paragraph"},{"text":"Step 4: Trigger fetch on launch","anchor":"Step-4-Trigger-fetch-on-launch","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".killswitch(.fetch)"},{"type":"text","text":" from your root view’s "},{"type":"codeVoice","code":".task"},{"type":"text","text":" so the verdict is available before the user can interact:"}],"type":"paragraph"},{"code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":".fetch"},{"type":"text","text":" is cache-aware: if the last fetch is within "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch "},{"type":"codeVoice","code":".killswitch(.forceFetch)"},{"type":"text","text":" instead, which bypasses the freshness gate."}],"type":"paragraph"},{"inlineContent":[{"text":"If the network call fails and a cached config is available, the plugin dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from the cache ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":".fetchFailed(message)","type":"codeVoice"},{"text":". Your UI keeps a usable verdict and can still surface the error.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Step 5: Render the verdict","anchor":"Step-5-Render-the-verdict","type":"heading"},{"inlineContent":[{"text":"The simplest path is the bundled ","type":"text"},{"type":"codeVoice","code":"killswitchBlocker(verdict:onUpdate:)"},{"text":" view modifier. It overlays a non-dismissible blocker when the verdict is ","type":"text"},{"type":"codeVoice","code":".blocked"},{"text":" and disables the underlying content while it is:","type":"text"}],"type":"paragraph"},{"code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":".unknown"},{"type":"text","text":" and "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" render nothing — the blocker only appears once the verdict comes back as "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":". The Update button calls the "},{"type":"codeVoice","code":"onUpdate"},{"type":"text","text":" closure, which dispatches "},{"type":"codeVoice","code":".killswitch(.openUpdateURL)"},{"type":"text","text":". The plugin checks "},{"type":"codeVoice","code":"canOpenUpdateURL"},{"type":"text","text":" and opens the URL through "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"NSWorkspace"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:"}],"type":"paragraph"},{"code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The closure receives the verdict’s ","type":"text"},{"code":"title","type":"codeVoice"},{"text":", ","type":"text"},{"code":"message","type":"codeVoice"},{"text":", and a ","type":"text"},{"code":"hasUpdateURL","type":"codeVoice"},{"text":" flag derived from ","type":"text"},{"code":"canOpenUpdateURL","type":"codeVoice"},{"text":", so your custom view doesn’t have to pattern-match the verdict itself.","type":"text"}],"type":"paragraph"},{"anchor":"Hosting-the-JSON-config","level":2,"type":"heading","text":"Hosting the JSON config"},{"inlineContent":[{"type":"text","text":"The endpoint you pass to "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":" serves a JSON document matching "},{"type":"codeVoice","code":"KillswitchConfig"},{"type":"text","text":". Every field is optional. The four operational shapes you’ll actually use:"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"1. Soft minimum version (most common).","type":"text"}],"type":"strong"},{"text":" Force everyone below the floor to update; let everyone else through.","type":"text"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"2. Emergency block of a specific bad build."}],"type":"strong"},{"type":"text","text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue."}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"3. Range block."}]},{"type":"text","text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes)."}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"inlineContent":[{"text":"Range entries use the literal string ","type":"text"},{"code":"\"a.b.c..<x.y.z\"","type":"codeVoice"},{"text":" — half-open, lower bound inclusive, upper bound exclusive.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"4. Allow everyone.","type":"text"}],"type":"strong"},{"type":"text","text":" Sometimes you just want the killswitch live but quiet."}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{}"]},{"inlineContent":[{"text":"Rules combine. Adding all of them in one document lets you lift the floor ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" knock out a specific bad build ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:","type":"text"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"text":"Where to host it","type":"heading","level":3,"anchor":"Where-to-host-it"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The contract is small: a public "},{"code":"GET","type":"codeVoice"},{"type":"text","text":" that returns "},{"code":"KillswitchConfig","type":"codeVoice"},{"type":"text","text":"-shaped JSON. It’s read on every cold launch, the plugin is fail-open, and it caches the result client-side — so the backend can be trivial. The one requirement that actually shapes the choice: "},{"inlineContent":[{"text":"a killswitch’s value is how fast you can push an emergency block.","type":"text"}],"type":"strong"},{"type":"text","text":" Anything that needs a redeploy or a git build to change the config defeats the purpose."}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Option","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Change config without redeploy?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Propagation","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Notes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Cloudflare Worker + Workers KV","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"(recommended)","type":"text"}],"type":"emphasis"}]}],[{"type":"paragraph","inlineContent":[{"text":"✅ ","type":"text"},{"type":"codeVoice","code":"wrangler kv key put"},{"text":" or dashboard","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"seconds"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Flip in seconds, edge-cached, room to add logic (geo\/gradual\/per-build) later. Runnable example below."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Static object (R2 \/ S3 + CDN)"}]}],[{"type":"paragraph","inlineContent":[{"text":"✅ re-upload object","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"seconds (after purge)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Zero code. Must set "},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":" as object metadata; no room to grow."}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Static site \/ Pages (git-backed)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"❌ commit + build"}]}],[{"type":"paragraph","inlineContent":[{"text":"~minutes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The trap: build latency kills the "},{"type":"emphasis","inlineContent":[{"text":"emergency","type":"text"}]},{"type":"text","text":" use case."}]}]],[[{"type":"paragraph","inlineContent":[{"text":"GitHub raw \/ Gist","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"✅ edit file","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"unpredictable","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Not a production CDN; you don’t control ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":", stale exactly when freshness matters.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your own app backend"}]}],[{"type":"paragraph","inlineContent":[{"text":"✅","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"instant"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The trap: it’s the service most likely down precisely when you need the killswitch."}]}]]]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Recommended: Cloudflare Worker + KV."}]},{"text":" The config lives in a KV key; the Worker returns it with a short ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":". You push an emergency block by writing one KV key — no redeploy. A complete, runnable example is in ","type":"text"},{"code":"Examples\/ConfigWorker\/","type":"codeVoice"},{"text":" — one Worker, keyed ","type":"text"},{"code":"GET \/<appID>\/<resource>","type":"codeVoice"},{"text":", that serves killswitch ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"text":" feature-flag config for every app in a portfolio from a single URL and a single KV namespace (the Cloudflare dashboard becomes the one place you edit a value). The short version: create a KV namespace → seed ","type":"text"},{"code":"…\/killswitch","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"wrangler deploy","type":"codeVoice"},{"text":" → point ","type":"text"},{"code":"KillswitchService.live(endpoint:)","type":"codeVoice"},{"text":" at ","type":"text"},{"code":"https:\/\/<host>\/<appID>\/killswitch","type":"codeVoice"},{"text":". See also ","type":"text"},{"code":"Examples\/ConfigWorker\/DEPLOY.md","type":"codeVoice"},{"text":" for the multi-app operating convention.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Minimal alternative: a static object"}]},{"text":" (Cloudflare R2, S3, any object store fronted by a CDN). Upload ","type":"text"},{"code":"killswitch.json","type":"codeVoice"},{"type":"text","text":", set a short "},{"type":"codeVoice","code":"Cache-Control"},{"text":" on the object, re-upload to change it. Zero code; you give up the room to add server-side logic later. Equivalent push-in-seconds latency for this use case.","type":"text"}]},{"level":3,"anchor":"Freshness-the-backend-cant-fix-client-staleness","type":"heading","text":"Freshness: the backend can’t fix client staleness"},{"inlineContent":[{"type":"text","text":"The plugin caches the fetched config for "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":" ("},{"type":"strong","inlineContent":[{"text":"default 3600s","type":"text"}]},{"type":"text","text":") regardless of how fresh your endpoint is. With the default, a perfectly deployed emergency block still won’t reach an already-launched app for up to an hour — and no backend choice changes that. If fast emergency response matters:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Lower "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":" to ~300–900s in "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".killswitch(.forceFetch)"},{"type":"text","text":" on app-foreground — it bypasses the freshness gate, so a returning user re-checks immediately."}]}]}]},{"inlineContent":[{"type":"text","text":"Keep your endpoint’s edge "},{"code":"Cache-Control","type":"codeVoice"},{"type":"text","text":" at or below "},{"code":"cacheLifetime","type":"codeVoice"},{"type":"text","text":"; caching longer at the edge than the client will re-ask buys nothing."}],"type":"paragraph"},{"level":2,"anchor":"Testing","type":"heading","text":"Testing"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"KillswitchService.mock(result:cached:cacheLifetime:)","type":"codeVoice"},{"type":"text","text":" to drive the plugin from a test without hitting the network:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"]},{"inlineContent":[{"type":"text","text":"The mock factory’s "},{"type":"codeVoice","code":"result"},{"text":" closure can also throw. With no cached config, the plugin dispatches only ","type":"text"},{"type":"codeVoice","code":".fetchFailed"},{"text":". With a cached config, it dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" from cache ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"text":