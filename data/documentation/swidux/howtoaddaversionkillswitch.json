{"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", so any view can react to it.","type":"text"}]},{"level":2,"text":"Before you start","type":"heading","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes you already have a Swidux app wired up: an ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", an ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":", an ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory. If not, work through ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference","isActive":true},{"text":" first.","type":"text"}]},{"level":2,"text":"Step 1: Add the dependency","type":"heading","anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" is a separate product in the ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":" package. Add it to the target that wires the store:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"]},{"type":"paragraph","inlineContent":[{"text":"If you re-export Swidux from ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":" (recommended), import ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" directly in ","type":"text"},{"type":"codeVoice","code":"AppStore.swift"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":" where the types are referenced.","type":"text"}]},{"level":2,"text":"Step 2: Add state and actions","type":"heading","anchor":"Step-2-Add-state-and-actions"},{"type":"paragraph","inlineContent":[{"text":"Mount a ","type":"text"},{"type":"codeVoice","code":"KillswitchState"},{"text":" slice on your root state and add an action case that wraps ","type":"text"},{"type":"codeVoice","code":"KillswitchAction"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"]},{"type":"paragraph","inlineContent":[{"text":"The plugin’s reducer handles ","type":"text"},{"type":"codeVoice","code":".killswitch"},{"text":" actions itself. Your root reducer should fall through:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"]},{"level":2,"text":"Step 3: Wire the plugin","type":"heading","anchor":"Step-3-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"text":"Inside ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":", build a ","type":"text"},{"type":"codeVoice","code":"KillswitchPlugin"},{"text":" and register it on the plugin host. Use ","type":"text"},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"text":" for the production service:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(string: \"https:\/\/example.com\/killswitch.json\")!","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"appVersion"},{"text":" closure runs every time ","type":"text"},{"type":"codeVoice","code":".fetch"},{"text":" evaluates, so it reflects the build that’s actually running. The plugin’s default ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" argument opens URLs through ","type":"text"},{"type":"codeVoice","code":"UIApplication"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"NSWorkspace"},{"text":"; pass your own closure if you route URLs through a coordinator.","type":"text"}]},{"level":2,"text":"Step 4: Trigger fetch on launch","type":"heading","anchor":"Step-4-Trigger-fetch-on-launch"},{"type":"paragraph","inlineContent":[{"text":"Dispatch ","type":"text"},{"type":"codeVoice","code":".killswitch(.fetch)"},{"text":" from your root view’s ","type":"text"},{"type":"codeVoice","code":".task"},{"text":" so the verdict is available before the user can interact:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"},{"text":" is cache-aware: if the last fetch is within ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch ","type":"text"},{"type":"codeVoice","code":".killswitch(.forceFetch)"},{"text":" instead, which bypasses the freshness gate.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the network call fails and a cached config is available, the plugin dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" from the cache ","type":"text"},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":".fetchFailed(message)"},{"text":". Your UI keeps a usable verdict and can still surface the error.","type":"text"}]},{"level":2,"text":"Step 5: Render the verdict","type":"heading","anchor":"Step-5-Render-the-verdict"},{"type":"paragraph","inlineContent":[{"text":"The simplest path is the bundled ","type":"text"},{"type":"codeVoice","code":"killswitchBlocker(verdict:onUpdate:)"},{"text":" view modifier. It overlays a non-dismissible blocker when the verdict is ","type":"text"},{"type":"codeVoice","code":".blocked"},{"text":" and disables the underlying content while it is:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unknown"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":" render nothing — the blocker only appears once the verdict comes back as ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"text":". The Update button calls the ","type":"text"},{"type":"codeVoice","code":"onUpdate"},{"text":" closure, which dispatches ","type":"text"},{"type":"codeVoice","code":".killswitch(.openUpdateURL)"},{"text":". The plugin checks ","type":"text"},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":" and opens the URL through ","type":"text"},{"type":"codeVoice","code":"UIApplication"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"NSWorkspace"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"]},{"type":"paragraph","inlineContent":[{"text":"The closure receives the verdict’s ","type":"text"},{"type":"codeVoice","code":"title"},{"text":", ","type":"text"},{"type":"codeVoice","code":"message"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"hasUpdateURL"},{"text":" flag derived from ","type":"text"},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":", so your custom view doesn’t have to pattern-match the verdict itself.","type":"text"}]},{"level":2,"text":"Hosting the JSON config","type":"heading","anchor":"Hosting-the-JSON-config"},{"type":"paragraph","inlineContent":[{"text":"The endpoint you pass to ","type":"text"},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":" serves a JSON document matching "},{"type":"codeVoice","code":"KillswitchConfig"},{"type":"text","text":". Every field is optional. The four operational shapes you’ll actually use:"}]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"1. Soft minimum version (most common)."}]},{"text":" Force everyone below the floor to update; let everyone else through.","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing"},{"inlineContent":[{"inlineContent":[{"text":"2. Emergency block of a specific bad build.","type":"text"}],"type":"strong"},{"type":"text","text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue."}],"type":"paragraph"},{"syntax":"json","code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"3. Range block.","type":"text"}]},{"text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes).","type":"text"}],"type":"paragraph"},{"syntax":"json","type":"codeListing","code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"inlineContent":[{"text":"Range entries use the literal string ","type":"text"},{"type":"codeVoice","code":"\"a.b.c..<x.y.z\""},{"text":" — half-open, lower bound inclusive, upper bound exclusive.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"4. Allow everyone.","type":"text"}],"type":"strong"},{"type":"text","text":" Sometimes you just want the killswitch live but quiet."}]},{"type":"codeListing","code":["{}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"text":"Rules combine. Adding all of them in one document lets you lift the floor ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" knock out a specific bad build "},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"type":"text","text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:"}]},{"type":"codeListing","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"text":"Where to host it","type":"heading","level":3,"anchor":"Where-to-host-it"},{"inlineContent":[{"type":"text","text":"The contract is small: a public "},{"type":"codeVoice","code":"GET"},{"type":"text","text":" that returns "},{"type":"codeVoice","code":"KillswitchConfig"},{"type":"text","text":"-shaped JSON. It’s read on every cold launch, the plugin is fail-open, and it caches the result client-side — so the backend can be trivial. The one requirement that actually shapes the choice: "},{"inlineContent":[{"type":"text","text":"a killswitch’s value is how fast you can push an emergency block."}],"type":"strong"},{"text":" Anything that needs a redeploy or a git build to change the config defeats the purpose.","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Option","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Change config without redeploy?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Propagation","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Notes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Cloudflare Worker + Workers KV","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"(recommended)"}],"type":"emphasis"}]}],[{"type":"paragraph","inlineContent":[{"text":"✅ ","type":"text"},{"type":"codeVoice","code":"wrangler kv key put"},{"type":"text","text":" or dashboard"}]}],[{"inlineContent":[{"text":"seconds","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Flip in seconds, edge-cached, room to add logic (geo\/gradual\/per-build) later. Runnable example below.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Static object (R2 \/ S3 + CDN)"}]}],[{"inlineContent":[{"text":"✅ re-upload object","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"seconds (after purge)","type":"text"}]}],[{"inlineContent":[{"text":"Zero code. Must set ","type":"text"},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":" as object metadata; no room to grow."}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Static site \/ Pages (git-backed)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌ commit + build"}],"type":"paragraph"}],[{"inlineContent":[{"text":"~minutes","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The trap: build latency kills the "},{"inlineContent":[{"text":"emergency","type":"text"}],"type":"emphasis"},{"type":"text","text":" use case."}]}]],[[{"inlineContent":[{"type":"text","text":"GitHub raw \/ Gist"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅ edit file"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"unpredictable"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Not a production CDN; you don’t control ","type":"text"},{"type":"codeVoice","code":"Cache-Control"},{"text":", stale exactly when freshness matters.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Your own app backend"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}],[{"inlineContent":[{"text":"instant","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The trap: it’s the service most likely down precisely when you need the killswitch.","type":"text"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Recommended: Cloudflare Worker + KV.","type":"text"}]},{"text":" The config lives in a KV key; the Worker returns it with a short ","type":"text"},{"type":"codeVoice","code":"Cache-Control"},{"text":". You push an emergency block by writing one KV key — no redeploy. A complete, runnable example is in ","type":"text"},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"text":" — one Worker, keyed ","type":"text"},{"type":"codeVoice","code":"GET \/<appID>\/<resource>"},{"text":", that serves killswitch ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"type":"text","text":" feature-flag config for every app in a portfolio from a single URL and a single KV namespace (the Cloudflare dashboard becomes the one place you edit a value). The short version: create a KV namespace → seed "},{"type":"codeVoice","code":"…\/killswitch"},{"text":" → ","type":"text"},{"type":"codeVoice","code":"wrangler deploy"},{"type":"text","text":" → point "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:)"},{"type":"text","text":" at "},{"type":"codeVoice","code":"https:\/\/<host>\/<appID>\/killswitch"},{"type":"text","text":". See also "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/DEPLOY.md"},{"type":"text","text":" for the multi-app operating convention."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Minimal alternative: a static object","type":"text"}],"type":"strong"},{"type":"text","text":" (Cloudflare R2, S3, any object store fronted by a CDN). Upload "},{"type":"codeVoice","code":"killswitch.json"},{"type":"text","text":", set a short "},{"type":"codeVoice","code":"Cache-Control"},{"text":" on the object, re-upload to change it. Zero code; you give up the room to add server-side logic later. Equivalent push-in-seconds latency for this use case.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Freshness: the backend can’t fix client staleness","anchor":"Freshness-the-backend-cant-fix-client-staleness"},{"inlineContent":[{"text":"The plugin caches the fetched config for ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"text":" (","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"default 3600s"}]},{"type":"text","text":") regardless of how fresh your endpoint is. With the default, a perfectly deployed emergency block still won’t reach an already-launched app for up to an hour — and no backend choice changes that. If fast emergency response matters:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Lower "},{"type":"codeVoice","code":"cacheLifetime"},{"text":" to ~300–900s in ","type":"text"},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Dispatch ","type":"text"},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"text":" on app-foreground — it bypasses the freshness gate, so a returning user re-checks immediately.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Keep your endpoint’s edge ","type":"text"},{"type":"codeVoice","code":"Cache-Control"},{"text":" at or below ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"text":"; caching longer at the edge than the client will re-ask buys nothing.","type":"text"}]},{"text":"Testing","type":"heading","level":2,"anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"KillswitchService.mock(result:cached:cacheLifetime:)","type":"codeVoice"},{"type":"text","text":" to drive the plugin from a test without hitting the network:"}]},{"syntax":"swift","type":"codeListing","code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"]},{"inlineContent":[{"text":"The mock factory’s ","type":"text"},{"type":"codeVoice","code":"result"},{"text":" closure can also throw. With no cached config, the plugin dispatches only ","type":"text"},{"type":"codeVoice","code":".fetchFailed"},{"text":". With a cached config, it dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" from cache ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed"},{"type":"text","text":", so test the fallback path with both "},{"type":"codeVoice","code":"result:"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cached:"},{"type":"text","text":" set:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["service: .mock(","    result: { throw URLError(.notConnectedToInternet) },","    cached: KillswitchConfig(minimumSupportedVersion: \"1.0.0\")",")"]}]}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"generated":true,"anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","title":"Add a Version Killswitch","modules":[{"name":"Swidux"}],"role":"article"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"kind":"article","sections":[],"variants":[{"paths":["\/documentation\/swidux\/howtoaddaversionkillswitch"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"references":{"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","url":"\/documentation\/swidux\/pluginarchitecture","title":"Plugin Architecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic","kind":"article","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","url":"\/documentation\/swidux\/gettingstarted","title":"Getting Started with Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","kind":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}]},"doc://Swidux/documentation/Swidux":{"role":"collection","url":"\/documentation\/swidux","title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","type":"topic","kind":"symbol","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","role":"article","title":"Add a Parental Gate","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}]},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"role":"article","url":"\/documentation\/swidux\/buildingadomainplugin","title":"Building a Domain Plugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","type":"topic","kind":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","url":"\/documentation\/swidux\/pluginkillswitchreference","role":"article","kind":"article","title":"SwiduxKillswitch Reference","type":"topic","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}]},"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","kind":"article","role":"article","title":"Using the Swidux Agent Skill","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}]},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"url":"\/documentation\/swidux\/howtoaddfeatureflags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","role":"article","kind":"article","title":"Add Feature Flags","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}]},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","url":"\/documentation\/swidux\/howtoaddanalytics","kind":"article","role":"article","title":"Add Analytics","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}]},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","url":"\/documentation\/swidux\/howtoaddapaywall","kind":"article","role":"article","title":"Add a Paywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}]}}}