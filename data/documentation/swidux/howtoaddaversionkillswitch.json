{"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"anchor":"How-to-Guides"}],"kind":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"variants":[{"paths":["\/documentation\/swidux\/howtoaddaversionkillswitch"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your "},{"code":"AppState","type":"codeVoice"},{"text":", so any view can react to it.","type":"text"}]},{"level":2,"text":"Before you start","anchor":"Before-you-start","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired up: an "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", an "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", an "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and a "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory. If not, work through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"type":"text","text":" first."}]},{"level":2,"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" is a separate product in the "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":" package. Add it to the target that wires the store:"}]},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you re-export Swidux from "},{"code":"AppState.swift","type":"codeVoice"},{"type":"text","text":" (recommended), import "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" directly in "},{"code":"AppStore.swift","type":"codeVoice"},{"type":"text","text":" and "},{"code":"AppState.swift","type":"codeVoice"},{"type":"text","text":" where the types are referenced."}]},{"level":2,"text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mount a "},{"code":"KillswitchState","type":"codeVoice"},{"type":"text","text":" slice on your root state and add an action case that wraps "},{"code":"KillswitchAction","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"],"syntax":"swift","type":"codeListing"},{"code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"],"syntax":"swift","type":"codeListing"},{"style":"tip","name":"Tip","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"import SwiduxKillswitch","type":"codeVoice"},{"text":" is needed in ","type":"text"},{"inlineContent":[{"type":"text","text":"every"}],"type":"emphasis"},{"text":" file that touches ","type":"text"},{"code":"store.killswitch.*","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"KillswitchAction","type":"codeVoice"},{"text":" — including views that read the verdict for display. ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside"},{"type":"paragraph","inlineContent":[{"text":"The plugin’s reducer handles ","type":"text"},{"code":".killswitch","type":"codeVoice"},{"text":" actions itself. Your root reducer should fall through:","type":"text"}]},{"code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Step 3: Wire the plugin","anchor":"Step-3-Wire-the-plugin","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Inside ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":", build a ","type":"text"},{"code":"KillswitchPlugin","type":"codeVoice"},{"text":" and register it on the plugin host. Use ","type":"text"},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"text":" for the production service:","type":"text"}]},{"code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(static: \"https:\/\/example.com\/killswitch.json\")","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"appVersion","type":"codeVoice"},{"text":" closure runs every time ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":" evaluates, so it reflects the build that’s actually running. The plugin’s default ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" argument opens URLs through ","type":"text"},{"code":"UIApplication","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"NSWorkspace","type":"codeVoice"},{"text":"; pass your own closure if you route URLs through a coordinator.","type":"text"}]},{"level":2,"text":"Step 4: Trigger fetch on launch","anchor":"Step-4-Trigger-fetch-on-launch","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Dispatch ","type":"text"},{"code":".killswitch(.fetch)","type":"codeVoice"},{"text":" from your root view’s ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" so the verdict is available before the user can interact:","type":"text"}]},{"code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":".fetch","type":"codeVoice"},{"text":" is cache-aware: if the last fetch is within ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch ","type":"text"},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"type":"text","text":" instead, which bypasses the freshness gate."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the network call fails and a cached config is available, the plugin dispatches "},{"code":".verdictReceived(...)","type":"codeVoice"},{"type":"text","text":" from the cache "},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":".fetchFailed(message)","type":"codeVoice"},{"text":". Your UI keeps a usable verdict and can still surface the error.","type":"text"}]},{"level":2,"text":"Step 5: Render the verdict","anchor":"Step-5-Render-the-verdict","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The simplest path is the bundled ","type":"text"},{"code":"killswitchBlocker(verdict:onUpdate:)","type":"codeVoice"},{"text":" view modifier. It overlays a non-dismissible blocker when the verdict is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" and disables the underlying content while it is:","type":"text"}]},{"code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":".unknown","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" render nothing — the blocker only appears once the verdict comes back as ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":". The Update button calls the ","type":"text"},{"code":"onUpdate","type":"codeVoice"},{"text":" closure, which dispatches ","type":"text"},{"code":".killswitch(.openUpdateURL)","type":"codeVoice"},{"text":". The plugin checks ","type":"text"},{"code":"canOpenUpdateURL","type":"codeVoice"},{"text":" and opens the URL through ","type":"text"},{"code":"UIApplication","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"NSWorkspace","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:","type":"text"}]},{"code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The closure receives the verdict’s ","type":"text"},{"code":"title","type":"codeVoice"},{"text":", ","type":"text"},{"code":"message","type":"codeVoice"},{"text":", and a ","type":"text"},{"code":"hasUpdateURL","type":"codeVoice"},{"text":" flag derived from ","type":"text"},{"code":"canOpenUpdateURL","type":"codeVoice"},{"text":", so your custom view doesn’t have to pattern-match the verdict itself.","type":"text"}]},{"level":2,"text":"Hosting the JSON config","anchor":"Hosting-the-JSON-config","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The endpoint you pass to ","type":"text"},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"text":" serves a JSON document matching ","type":"text"},{"code":"KillswitchConfig","type":"codeVoice"},{"text":". Every field is optional. The four operational shapes you’ll actually use:","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"1. Soft minimum version (most common).","type":"text"}],"type":"strong"},{"text":" Force everyone below the floor to update; let everyone else through.","type":"text"}]},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json","type":"codeListing"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"2. Emergency block of a specific bad build.","type":"text"}],"type":"strong"},{"text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue.","type":"text"}]},{"code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json","type":"codeListing"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"3. Range block.","type":"text"}],"type":"strong"},{"text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes).","type":"text"}]},{"code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Range entries use the literal string ","type":"text"},{"code":"\"a.b.c..<x.y.z\"","type":"codeVoice"},{"text":" — half-open, lower bound inclusive, upper bound exclusive.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"4. Allow everyone.","type":"text"}],"type":"strong"},{"text":" Sometimes you just want the killswitch live but quiet.","type":"text"}]},{"code":["{}"],"syntax":"json","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Rules combine. Adding all of them in one document lets you lift the floor ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" knock out a specific bad build ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:","type":"text"}]},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json","type":"codeListing"},{"level":3,"text":"Where to host it","anchor":"Where-to-host-it","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The contract is small: a public ","type":"text"},{"code":"GET","type":"codeVoice"},{"text":" that returns ","type":"text"},{"code":"KillswitchConfig","type":"codeVoice"},{"text":"-shaped JSON. It’s read on every cold launch, the plugin is fail-open, and it caches the result client-side — so the backend can be trivial. The one requirement that actually shapes the choice: ","type":"text"},{"inlineContent":[{"text":"a killswitch’s value is how fast you can push an emergency block.","type":"text"}],"type":"strong"},{"text":" Anything that needs a redeploy or a git build to change the config defeats the purpose.","type":"text"}]},{"rows":[[[{"inlineContent":[{"text":"Option","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Change config without redeploy?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Propagation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Notes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Cloudflare Worker + Workers KV"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"(recommended)"}],"type":"emphasis"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅ ","type":"text"},{"code":"wrangler kv key put","type":"codeVoice"},{"text":" or dashboard","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"seconds","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Flip in seconds, edge-cached, room to add logic (geo\/gradual\/per-build) later. Runnable example below.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Static object (R2 \/ S3 + CDN)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅ re-upload object","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"seconds (after purge)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Zero code. Must set ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":" as object metadata; no room to grow.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Static site \/ Pages (git-backed)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"❌ commit + build","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"~minutes","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The trap: build latency kills the ","type":"text"},{"inlineContent":[{"type":"text","text":"emergency"}],"type":"emphasis"},{"text":" use case.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"GitHub raw \/ Gist","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅ edit file","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"unpredictable","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Not a production CDN; you don’t control ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":", stale exactly when freshness matters.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Your own app backend","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"instant","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The trap: it’s the service most likely down precisely when you need the killswitch.","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Recommended: Cloudflare Worker + KV.","type":"text"}],"type":"strong"},{"text":" The config lives in a KV key; the Worker returns it with a short ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":". You push an emergency block by writing one KV key — no redeploy. A complete, runnable example is in ","type":"text"},{"code":"Examples\/ConfigWorker\/","type":"codeVoice"},{"text":" — one Worker, keyed ","type":"text"},{"code":"GET \/<appID>\/<resource>","type":"codeVoice"},{"text":", that serves killswitch ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" feature-flag config for every app in a portfolio from a single URL and a single KV namespace (the Cloudflare dashboard becomes the one place you edit a value). The short version: create a KV namespace → seed ","type":"text"},{"code":"…\/killswitch","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"wrangler deploy","type":"codeVoice"},{"text":" → point ","type":"text"},{"code":"KillswitchService.live(endpoint:)","type":"codeVoice"},{"text":" at ","type":"text"},{"code":"https:\/\/<host>\/<appID>\/killswitch","type":"codeVoice"},{"text":". See also ","type":"text"},{"code":"Examples\/ConfigWorker\/DEPLOY.md","type":"codeVoice"},{"text":" for the multi-app operating convention.","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Minimal alternative: a static object","type":"text"}],"type":"strong"},{"text":" (Cloudflare R2, S3, any object store fronted by a CDN). Upload ","type":"text"},{"code":"killswitch.json","type":"codeVoice"},{"text":", set a short ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":" on the object, re-upload to change it. Zero code; you give up the room to add server-side logic later. Equivalent push-in-seconds latency for this use case.","type":"text"}]},{"level":3,"text":"Freshness: the backend can’t fix client staleness","anchor":"Freshness-the-backend-cant-fix-client-staleness","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The plugin caches the fetched config for ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":" (","type":"text"},{"inlineContent":[{"text":"default 3600s","type":"text"}],"type":"strong"},{"text":") regardless of how fresh your endpoint is. With the default, a perfectly deployed emergency block still won’t reach an already-launched app for up to an hour — and no backend choice changes that. If fast emergency response matters:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Lower "},{"code":"cacheLifetime","type":"codeVoice"},{"type":"text","text":" to ~300–900s in "},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Dispatch "},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"type":"text","text":" on app-foreground — it bypasses the freshness gate, so a returning user re-checks immediately."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Keep your endpoint’s edge ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":" at or below ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":"; caching longer at the edge than the client will re-ask buys nothing.","type":"text"}]},{"level":2,"text":"Testing","anchor":"Testing","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"KillswitchService.mock(result:cached:cacheLifetime:)","type":"codeVoice"},{"text":" to drive the plugin from a test without hitting the network:","type":"text"}]},{"code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked, fromNetwork: true)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The mock factory’s ","type":"text"},{"code":"result","type":"codeVoice"},{"text":" closure can also throw. With no cached config, the plugin dispatches only ","type":"text"},{"code":".fetchFailed","type":"codeVoice"},{"text":". With a cached config, it dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from cache ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":".fetchFailed","type":"codeVoice"},{"text":", so test the fallback path with both ","type":"text"},{"code":"result:","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"cached:","type":"codeVoice"},{"text":" set:","type":"text"}]},{"code":["service: .mock(","    result: { throw URLError(.notConnectedToInternet) },","    cached: KillswitchConfig(minimumSupportedVersion: \"1.0.0\")",")"],"syntax":"swift","type":"codeListing"}]}],"metadata":{"modules":[{"name":"Swidux"}],"title":"Add a Version Killswitch","roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"text"