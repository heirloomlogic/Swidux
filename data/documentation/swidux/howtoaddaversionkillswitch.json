{"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides","title":"How-to Guides","generated":true}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"title":"Add a Version Killswitch","modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article"},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","interfaceLanguage":"swift"},"abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddaversionkillswitch"]}],"kind":"article","primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", so any view can react to it."}]},{"type":"heading","text":"Before you start","level":2,"anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired up: an "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and a "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory. If not, work through "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}]},{"anchor":"Step-1-Add-the-dependency","text":"Step 1: Add the dependency","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" is a separate product in the "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" package. Add it to the target that wires the store:"}]},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"]},{"inlineContent":[{"text":"If you re-export Swidux from ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":" (recommended), import ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" directly in "},{"type":"codeVoice","code":"AppStore.swift"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" where the types are referenced."}],"type":"paragraph"},{"level":2,"text":"Step 2: Add state and actions","type":"heading","anchor":"Step-2-Add-state-and-actions"},{"inlineContent":[{"type":"text","text":"Mount a "},{"type":"codeVoice","code":"KillswitchState"},{"type":"text","text":" slice on your root state and add an action case that wraps "},{"type":"codeVoice","code":"KillswitchAction"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"],"type":"codeListing"},{"syntax":"swift","code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The plugin’s reducer handles "},{"type":"codeVoice","code":".killswitch"},{"type":"text","text":" actions itself. Your root reducer should fall through:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"],"type":"codeListing"},{"level":2,"text":"Step 3: Wire the plugin","type":"heading","anchor":"Step-3-Wire-the-plugin"},{"inlineContent":[{"type":"text","text":"Inside "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":", build a "},{"type":"codeVoice","code":"KillswitchPlugin"},{"type":"text","text":" and register it on the plugin host. Use "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":" for the production service:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(string: \"https:\/\/example.com\/killswitch.json\")!","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"appVersion","type":"codeVoice"},{"text":" closure runs every time ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":" evaluates, so it reflects the build that’s actually running. The plugin’s default ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" argument opens URLs through ","type":"text"},{"code":"UIApplication","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"NSWorkspace","type":"codeVoice"},{"text":"; pass your own closure if you route URLs through a coordinator.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Step 4: Trigger fetch on launch","type":"heading","anchor":"Step-4-Trigger-fetch-on-launch"},{"inlineContent":[{"text":"Dispatch ","type":"text"},{"code":".killswitch(.fetch)","type":"codeVoice"},{"text":" from your root view’s ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" so the verdict is available before the user can interact:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":".fetch","type":"codeVoice"},{"text":" is cache-aware: if the last fetch is within ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch ","type":"text"},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"text":" instead, which bypasses the freshness gate.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the network call fails and a cached config is available, the plugin dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from the cache ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed(message)"},{"type":"text","text":". Your UI keeps a usable verdict and can still surface the error."}],"type":"paragraph"},{"type":"heading","text":"Step 5: Render the verdict","level":2,"anchor":"Step-5-Render-the-verdict"},{"type":"paragraph","inlineContent":[{"text":"The simplest path is the bundled ","type":"text"},{"type":"codeVoice","code":"killswitchBlocker(verdict:onUpdate:)"},{"text":" view modifier. It overlays a non-dismissible blocker when the verdict is ","type":"text"},{"type":"codeVoice","code":".blocked"},{"text":" and disables the underlying content while it is:","type":"text"}]},{"type":"codeListing","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unknown"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":" render nothing — the blocker only appears once the verdict comes back as ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"text":". The Update button calls the ","type":"text"},{"type":"codeVoice","code":"onUpdate"},{"text":" closure, which dispatches ","type":"text"},{"type":"codeVoice","code":".killswitch(.openUpdateURL)"},{"text":". The plugin checks ","type":"text"},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":" and opens the URL through ","type":"text"},{"type":"codeVoice","code":"UIApplication"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"NSWorkspace"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:","type":"text"}]},{"type":"codeListing","code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The closure receives the verdict’s ","type":"text"},{"type":"codeVoice","code":"title"},{"text":", ","type":"text"},{"type":"codeVoice","code":"message"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"hasUpdateURL"},{"text":" flag derived from ","type":"text"},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":", so your custom view doesn’t have to pattern-match the verdict itself.","type":"text"}]},{"type":"heading","text":"Hosting the JSON config","level":2,"anchor":"Hosting-the-JSON-config"},{"type":"paragraph","inlineContent":[{"text":"The endpoint you pass to ","type":"text"},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"text":" serves a JSON document matching ","type":"text"},{"type":"codeVoice","code":"KillswitchConfig"},{"text":". Every field is optional. The four operational shapes you’ll actually use:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"1. Soft minimum version (most common)."}]},{"text":" Force everyone below the floor to update; let everyone else through.","type":"text"}]},{"type":"codeListing","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"2. Emergency block of a specific bad build.","type":"text"}],"type":"strong"},{"text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue.","type":"text"}]},{"syntax":"json","code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"3. Range block.","type":"text"}]},{"text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes).","type":"text"}]},{"syntax":"json","code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing"},{"inlineContent":[{"text":"Range entries use the literal string ","type":"text"},{"type":"codeVoice","code":"\"a.b.c..<x.y.z\""},{"type":"text","text":" — half-open, lower bound inclusive, upper bound exclusive."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"4. Allow everyone.","type":"text"}],"type":"strong"},{"text":" Sometimes you just want the killswitch live but quiet.","type":"text"}]},{"syntax":"json","code":["{}"],"type":"codeListing"},{"inlineContent":[{"text":"Rules combine. Adding all of them in one document lets you lift the floor ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"text":" knock out a specific bad build ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:"}],"type":"paragraph"},{"type":"codeListing","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"text":"Serve the JSON with a short ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":" (60–300 seconds) — the plugin already caches client-side via ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":", but a short edge-cache TTL keeps your origin from getting hammered after you push a config change.","type":"text"}]},{"anchor":"Testing","text":"Testing","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"KillswitchService.mock(result:cached:cacheLifetime:)"},{"type":"text","text":" to drive the plugin from a test without hitting the network:"}],"type":"paragraph"},{"code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The mock factory’s ","type":"text"},{"type":"codeVoice","code":"result"},{"type":"text","text":" closure can also throw. With no cached config, the plugin dispatches only "},{"code":".fetchFailed","type":"codeVoice"},{"type":"text","text":". With a cached config, it dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from cache "},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":".fetchFailed"},{"type":"text","text":", so test the fallback path with both "},{"type":"codeVoice","code":"result:"},{"type":"text","text":" and "},{"code":"cached:","type":"codeVoice"},{"type":"text","text":" set:"}],"type":"paragraph"},{"syntax":"swift","code":["service: .mock(","    result: { throw URLError(.notConnectedToInternet) },","    cached: KillswitchConfig(minimumSupportedVersion: \"1.0.0\")",")"],"type":"codeListing"}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"title":"Add a Paywall","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","role":"article","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"title":"SwiduxKillswitch Reference","url":"\/documentation\/swidux\/pluginkillswitchreference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","role":"article","kind":"article","abstract":[{"text":"Public API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}]},"doc://Swidux/documentation/Swidux":{"role":"collection","url":"\/documentation\/swidux","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux","type":"topic","title":"Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","url":"\/documentation\/swidux\/pluginarchitecture","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic","title":"Plugin Architecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}]},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"title":"Add a Parental Gate","url":"\/documentation\/swidux\/howtoaddaparentalgate","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","role":"article","kind":"article","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}]},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"role":"article","url":"\/documentation\/swidux\/buildingadomainplugin","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","type":"topic","title":"Building a Domain Plugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","role":"article","kind":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}]},"doc://Swidux/documentation/Swidux/AgentSkill":{"title":"Using the Swidux Agent Skill","url":"\/documentation\/swidux\/agentskill","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","role":"article","kind":"article","abstract":[{"text":"Install the bundled ","type":"text"},{"type":"codeVoice","code":"swidux-ref"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}]}}}