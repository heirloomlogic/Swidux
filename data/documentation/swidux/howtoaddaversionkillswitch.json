{"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"anchor":"How-to-Guides","title":"How-to Guides"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", so any view can react to it.","type":"text"}]},{"level":2,"text":"Before you start","anchor":"Before-you-start","type":"heading"},{"inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired up: an "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", an "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and a "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory. If not, work through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"type":"text","text":" first."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" is a separate product in the "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" package. Add it to the target that wires the store:"}],"type":"paragraph"},{"type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"If you re-export Swidux from "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" (recommended), import "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" directly in "},{"type":"codeVoice","code":"AppStore.swift"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" where the types are referenced."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions"},{"inlineContent":[{"type":"text","text":"Mount a "},{"code":"KillswitchState","type":"codeVoice"},{"type":"text","text":" slice on your root state and add an action case that wraps "},{"code":"KillswitchAction","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"],"type":"codeListing"},{"code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The plugin’s reducer handles "},{"type":"codeVoice","code":".killswitch"},{"type":"text","text":" actions itself. Your root reducer should fall through:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"],"type":"codeListing"},{"anchor":"Step-3-Wire-the-plugin","level":2,"type":"heading","text":"Step 3: Wire the plugin"},{"inlineContent":[{"type":"text","text":"Inside "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":", build a "},{"type":"codeVoice","code":"KillswitchPlugin"},{"type":"text","text":" and register it on the plugin host. Use "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":" for the production service:"}],"type":"paragraph"},{"code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(static: \"https:\/\/example.com\/killswitch.json\")","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The "},{"code":"appVersion","type":"codeVoice"},{"type":"text","text":" closure runs every time "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":" evaluates, so it reflects the build that’s actually running. The plugin’s default "},{"code":"openURL","type":"codeVoice"},{"text":" argument opens URLs through ","type":"text"},{"type":"codeVoice","code":"UIApplication"},{"text":" or ","type":"text"},{"code":"NSWorkspace","type":"codeVoice"},{"text":"; pass your own closure if you route URLs through a coordinator.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Step-4-Trigger-fetch-on-launch","text":"Step 4: Trigger fetch on launch","type":"heading"},{"inlineContent":[{"text":"Dispatch ","type":"text"},{"code":".killswitch(.fetch)","type":"codeVoice"},{"text":" from your root view’s ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" so the verdict is available before the user can interact:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":".fetch","type":"codeVoice"},{"text":" is cache-aware: if the last fetch is within ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch ","type":"text"},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"text":" instead, which bypasses the freshness gate.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the network call fails and a cached config is available, the plugin dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from the cache ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"type":"text","text":" "},{"code":".fetchFailed(message)","type":"codeVoice"},{"text":". Your UI keeps a usable verdict and can still surface the error.","type":"text"}]},{"level":2,"anchor":"Step-5-Render-the-verdict","type":"heading","text":"Step 5: Render the verdict"},{"inlineContent":[{"text":"The simplest path is the bundled ","type":"text"},{"code":"killswitchBlocker(verdict:onUpdate:)","type":"codeVoice"},{"type":"text","text":" view modifier. It overlays a non-dismissible blocker when the verdict is "},{"type":"codeVoice","code":".blocked"},{"type":"text","text":" and disables the underlying content while it is:"}],"type":"paragraph"},{"type":"codeListing","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"],"syntax":"swift"},{"inlineContent":[{"code":".unknown","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" render nothing — the blocker only appears once the verdict comes back as ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":". The Update button calls the "},{"code":"onUpdate","type":"codeVoice"},{"type":"text","text":" closure, which dispatches "},{"code":".killswitch(.openUpdateURL)","type":"codeVoice"},{"type":"text","text":". The plugin checks "},{"code":"canOpenUpdateURL","type":"codeVoice"},{"type":"text","text":" and opens the URL through "},{"code":"UIApplication","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"NSWorkspace","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:"}],"type":"paragraph"},{"syntax":"swift","code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The closure receives the verdict’s "},{"code":"title","type":"codeVoice"},{"type":"text","text":", "},{"code":"message","type":"codeVoice"},{"type":"text","text":", and a "},{"code":"hasUpdateURL","type":"codeVoice"},{"type":"text","text":" flag derived from "},{"code":"canOpenUpdateURL","type":"codeVoice"},{"type":"text","text":", so your custom view doesn’t have to pattern-match the verdict itself."}],"type":"paragraph"},{"level":2,"anchor":"Hosting-the-JSON-config","text":"Hosting the JSON config","type":"heading"},{"inlineContent":[{"type":"text","text":"The endpoint you pass to "},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"type":"text","text":" serves a JSON document matching "},{"code":"KillswitchConfig","type":"codeVoice"},{"type":"text","text":". Every field is optional. The four operational shapes you’ll actually use:"}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"1. Soft minimum version (most common).","type":"text"}]},{"type":"text","text":" Force everyone below the floor to update; let everyone else through."}],"type":"paragraph"},{"syntax":"json","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"2. Emergency block of a specific bad build.","type":"text"}]},{"type":"text","text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue."}],"type":"paragraph"},{"syntax":"json","code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"3. Range block.","type":"text"}]},{"type":"text","text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes)."}],"type":"paragraph"},{"syntax":"json","code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Range entries use the literal string "},{"code":"\"a.b.c..<x.y.z\"","type":"codeVoice"},{"type":"text","text":" — half-open, lower bound inclusive, upper bound exclusive."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"4. Allow everyone.","type":"text"}]},{"type":"text","text":" Sometimes you just want the killswitch live but quiet."}],"type":"paragraph"},{"syntax":"json","code":["{}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Rules combine. Adding all of them in one document lets you lift the floor "},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" knock out a specific bad build "},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:"}],"type":"paragraph"},{"syntax":"json","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing"},{"level":3,"anchor":"Where-to-host-it","text":"Where to host it","type":"heading"},{"inlineContent":[{"type":"text","text":"The contract is small: a public "},{"code":"GET","type":"codeVoice"},{"type":"text","text":" that returns "},{"code":"KillswitchConfig","type":"codeVoice"},{"type":"text","text":"-shaped JSON. It’s read on every cold launch, the plugin is fail-open, and it caches the result client-side — so the backend can be trivial. The one requirement that actually shapes the choice: "},{"type":"strong","inlineContent":[{"text":"a killswitch’s value is how fast you can push an emergency block.","type":"text"}]},{"type":"text","text":" Anything that needs a redeploy or a git build to change the config defeats the purpose."}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Option","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Change config without redeploy?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Propagation","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Notes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Cloudflare Worker + Workers KV"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"(recommended)"}],"type":"emphasis"}]}],[{"type":"paragraph","inlineContent":[{"text":"✅ ","type":"text"},{"code":"wrangler kv key put","type":"codeVoice"},{"text":" or dashboard","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"seconds","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Flip in seconds, edge-cached, room to add logic (geo\/gradual\/per-build) later. Runnable example below.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Static object (R2 \/ S3 + CDN)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"✅ re-upload object","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"seconds (after purge)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Zero code. Must set ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":" as object metadata; no room to grow.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Static site \/ Pages (git-backed)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"❌ commit + build","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"~minutes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The trap: build latency kills the ","type":"text"},{"inlineContent":[{"type":"text","text":"emergency"}],"type":"emphasis"},{"text":" use case.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"GitHub raw \/ Gist","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"✅ edit file","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"unpredictable","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Not a production CDN; you don’t control ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":", stale exactly when freshness matters.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Your own app backend","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"instant"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The trap: it’s the service most likely down precisely when you need the killswitch.","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"inlineContent":[{"text":"Recommended: Cloudflare Worker + KV.","type":"text"}],"type":"strong"},{"text":" The config lives in a KV key; the Worker returns it with a short ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":". You push an emergency block by writing one KV key — no redeploy. A complete, runnable example is in ","type":"text"},{"code":"Examples\/ConfigWorker\/","type":"codeVoice"},{"text":" — one Worker, keyed ","type":"text"},{"code":"GET \/<appID>\/<resource>","type":"codeVoice"},{"text":", that serves killswitch ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" feature-flag config for every app in a portfolio from a single URL and a single KV namespace (the Cloudflare dashboard becomes the one place you edit a value). The short version: create a KV namespace → seed ","type":"text"},{"code":"…\/killswitch","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"wrangler deploy","type":"codeVoice"},{"text":" → point ","type":"text"},{"code":"KillswitchService.live(endpoint:)","type":"codeVoice"},{"text":" at ","type":"text"},{"code":"https:\/\/<host>\/<appID>\/killswitch","type":"codeVoice"},{"text":". See also ","type":"text"},{"code":"Examples\/ConfigWorker\/DEPLOY.md","type":"codeVoice"},{"text":" for the multi-app operating convention.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Minimal alternative: a static object","type":"text"}],"type":"strong"},{"text":" (Cloudflare R2, S3, any object store fronted by a CDN). Upload ","type":"text"},{"code":"killswitch.json","type":"codeVoice"},{"text":", set a short ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":" on the object, re-upload to change it. Zero code; you give up the room to add server-side logic later. Equivalent push-in-seconds latency for this use case.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Freshness-the-backend-cant-fix-client-staleness","type":"heading","text":"Freshness: the backend can’t fix client staleness"},{"inlineContent":[{"text":"The plugin caches the fetched config for ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":" (","type":"text"},{"inlineContent":[{"text":"default 3600s","type":"text"}],"type":"strong"},{"text":") regardless of how fresh your endpoint is. With the default, a perfectly deployed emergency block still won’t reach an already-launched app for up to an hour — and no backend choice changes that. If fast emergency response matters:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Lower "},{"code":"cacheLifetime","type":"codeVoice"},{"type":"text","text":" to ~300–900s in "},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Dispatch "},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"type":"text","text":" on app-foreground — it bypasses the freshness gate, so a returning user re-checks immediately."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Keep your endpoint’s edge ","type":"text"},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":" at or below "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":"; caching longer at the edge than the client will re-ask buys nothing."}],"type":"paragraph"},{"level":2,"anchor":"Testing","type":"heading","text":"Testing"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"KillswitchService.mock(result:cached:cacheLifetime:)"},{"type":"text","text":" to drive the plugin from a test without hitting the network:"}],"type":"paragraph"},{"syntax":"swift","code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mock factory’s "},{"code":"result","type":"codeVoice"},{"type":"text","text":" closure can also throw. With no cached config, the plugin dispatches only "},{"code":".fetchFailed","type":"codeVoice"},{"type":"text","text":". With a cached config, it dispatches "},{"code":".verdictReceived(...)","type":"codeVoice"},{"type":"text","text":" from cache "},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":".fetchFailed","type":"codeVoice"},{"type":"text","text":", so test the fallback path with both "},{"code":"result:","type":"codeVoice"},{"type":"text","text":" and "},{"code":"cached:","type":"codeVoice"},{"type":"text","text":" set:"}]},{"type":"codeListing","code":["service: .mock(","    result: { throw URLError(.notConnectedToInternet) },","    cached: KillswitchConfig(minimumSupportedVersion: \"1.0.0\")",")"],"syntax":"swift"}]}],"kind":"article","identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"paths":["\/documentation\/swidux\/howtoaddaversionkillswitch"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"Add a Version Killswitch"},"references":{"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"type":"topic","url":"\/documentation\/swidux\/howtoaddfeatureflags","title":"Add Feature Flags","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux":{"kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","url":"\/documentation\/swidux\/howtoaddaparentalgate","title":"Add a Parental Gate","kind":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","title":"Using the Swidux Agent Skill","kind":"article","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"role":"article","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"type":"topic","url":"\/documentation\/swidux\/howtoaddanalytics","title":"Add Analytics","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}]},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","url":"\/documentation\/swidux\/buildingadomainplugin","title":"Building a Domain Plugin","kind":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","title":"Plugin Architecture","url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","title":"SwiduxKillswitch Reference","url":"\/documentation\/swidux\/pluginkillswitchreference","abstract":[{"type":"text","text":"Public API surface for the "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}]}}}