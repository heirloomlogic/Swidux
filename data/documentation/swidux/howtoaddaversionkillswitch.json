{"variants":[{"paths":["\/documentation\/swidux\/howtoaddaversionkillswitch"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your ","type":"text"},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", so any view can react to it."}],"type":"paragraph"},{"text":"Before you start","anchor":"Before-you-start","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes you already have a Swidux app wired up: an ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", an ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", an ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory. If not, work through "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}]},{"level":2,"text":"Step 1: Add the dependency","type":"heading","anchor":"Step-1-Add-the-dependency"},{"inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" is a separate product in the ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" package. Add it to the target that wires the store:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"]},{"inlineContent":[{"text":"If you re-export Swidux from ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"text":" (recommended), import ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" directly in "},{"type":"codeVoice","code":"AppStore.swift"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" where the types are referenced."}],"type":"paragraph"},{"type":"heading","anchor":"Step-2-Add-state-and-actions","level":2,"text":"Step 2: Add state and actions"},{"type":"paragraph","inlineContent":[{"text":"Mount a ","type":"text"},{"type":"codeVoice","code":"KillswitchState"},{"type":"text","text":" slice on your root state and add an action case that wraps "},{"code":"KillswitchAction","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"],"syntax":"swift"},{"type":"codeListing","code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"],"syntax":"swift"},{"style":"tip","name":"Tip","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxKillswitch"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.killswitch.*"},{"type":"text","text":" or "},{"code":"KillswitchAction","type":"codeVoice"},{"type":"text","text":" — including views that read the verdict for display. "},{"code":"@_exported import Swidux","type":"codeVoice"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin’s reducer handles "},{"type":"codeVoice","code":".killswitch"},{"type":"text","text":" actions itself. Your root reducer should fall through:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"]},{"type":"heading","level":2,"text":"Step 3: Wire the plugin","anchor":"Step-3-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inside "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":", build a "},{"type":"codeVoice","code":"KillswitchPlugin"},{"type":"text","text":" and register it on the plugin host. Use "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":" for the production service:"}]},{"type":"codeListing","code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(static: \"https:\/\/example.com\/killswitch.json\")","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"appVersion","type":"codeVoice"},{"type":"text","text":" closure runs every time "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":" evaluates, so it reflects the build that’s actually running. The plugin’s default "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" argument opens URLs through "},{"code":"UIApplication","type":"codeVoice"},{"type":"text","text":" or "},{"code":"NSWorkspace","type":"codeVoice"},{"type":"text","text":"; pass your own closure if you route URLs through a coordinator."}]},{"type":"heading","text":"Step 4: Trigger fetch on launch","anchor":"Step-4-Trigger-fetch-on-launch","level":2},{"type":"paragraph","inlineContent":[{"text":"Dispatch ","type":"text"},{"type":"codeVoice","code":".killswitch(.fetch)"},{"text":" from your root view’s ","type":"text"},{"type":"codeVoice","code":".task"},{"text":" so the verdict is available before the user can interact:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"},{"type":"text","text":" is cache-aware: if the last fetch is within "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch "},{"type":"codeVoice","code":".killswitch(.forceFetch)"},{"type":"text","text":" instead, which bypasses the freshness gate."}]},{"type":"paragraph","inlineContent":[{"text":"If the network call fails and a cached config is available, the plugin dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" from the cache ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":".fetchFailed(message)"},{"type":"text","text":". Your UI keeps a usable verdict and can still surface the error."}]},{"anchor":"Step-5-Render-the-verdict","text":"Step 5: Render the verdict","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The simplest path is the bundled ","type":"text"},{"code":"killswitchBlocker(verdict:onUpdate:)","type":"codeVoice"},{"text":" view modifier. It overlays a non-dismissible blocker when the verdict is ","type":"text"},{"type":"codeVoice","code":".blocked"},{"text":" and disables the underlying content while it is:","type":"text"}]},{"syntax":"swift","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":".unknown"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":" render nothing — the blocker only appears once the verdict comes back as ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"text":". The Update button calls the ","type":"text"},{"type":"codeVoice","code":"onUpdate"},{"text":" closure, which dispatches ","type":"text"},{"type":"codeVoice","code":".killswitch(.openUpdateURL)"},{"text":". The plugin checks ","type":"text"},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":" and opens the URL through ","type":"text"},{"type":"codeVoice","code":"UIApplication"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"NSWorkspace"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"],"type":"codeListing"},{"inlineContent":[{"text":"The closure receives the verdict’s ","type":"text"},{"code":"title","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"message"},{"type":"text","text":", and a "},{"type":"codeVoice","code":"hasUpdateURL"},{"type":"text","text":" flag derived from "},{"type":"codeVoice","code":"canOpenUpdateURL"},{"type":"text","text":", so your custom view doesn’t have to pattern-match the verdict itself."}],"type":"paragraph"},{"anchor":"Hosting-the-JSON-config","type":"heading","text":"Hosting the JSON config","level":2},{"type":"paragraph","inlineContent":[{"text":"The endpoint you pass to ","type":"text"},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"text":" serves a JSON document matching ","type":"text"},{"code":"KillswitchConfig","type":"codeVoice"},{"text":". Every field is optional. The four operational shapes you’ll actually use:","type":"text"}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"1. Soft minimum version (most common).","type":"text"}],"type":"strong"},{"type":"text","text":" Force everyone below the floor to update; let everyone else through."}]},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"2. Emergency block of a specific bad build."}]},{"text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue.","type":"text"}],"type":"paragraph"},{"code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"inlineContent":[{"text":"3. Range block.","type":"text"}],"type":"strong"},{"text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes).","type":"text"}],"type":"paragraph"},{"code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Range entries use the literal string "},{"type":"codeVoice","code":"\"a.b.c..<x.y.z\""},{"type":"text","text":" — half-open, lower bound inclusive, upper bound exclusive."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"4. Allow everyone.","type":"text"}]},{"text":" Sometimes you just want the killswitch live but quiet.","type":"text"}],"type":"paragraph"},{"code":["{}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"text":"Rules combine. Adding all of them in one document lets you lift the floor ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"text":" knock out a specific bad build ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:","type":"text"}],"type":"paragraph"},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json","type":"codeListing"},{"anchor":"Where-to-host-it","level":3,"text":"Where to host it","type":"heading"},{"inlineContent":[{"type":"text","text":"The contract is small: a public "},{"code":"GET","type":"codeVoice"},{"text":" that returns ","type":"text"},{"code":"KillswitchConfig","type":"codeVoice"},{"type":"text","text":"-shaped JSON. It’s read on every cold launch, the plugin is fail-open, and it caches the result client-side — so the backend can be trivial. The one requirement that actually shapes the choice: "},{"inlineContent":[{"text":"a killswitch’s value is how fast you can push an emergency block.","type":"text"}],"type":"strong"},{"type":"text","text":" Anything that needs a redeploy or a git build to change the config defeats the purpose."}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Option"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Change config without redeploy?"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Propagation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Notes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Cloudflare Worker + Workers KV"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"(recommended)"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅ ","type":"text"},{"code":"wrangler kv key put","type":"codeVoice"},{"text":" or dashboard","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"seconds"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Flip in seconds, edge-cached, room to add logic (geo\/gradual\/per-build) later. Runnable example below."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Static object (R2 \/ S3 + CDN)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅ re-upload object","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"seconds (after purge)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Zero code. Must set ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"type":"text","text":" as object metadata; no room to grow."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Static site \/ Pages (git-backed)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"❌ commit + build"}]}],[{"type":"paragraph","inlineContent":[{"text":"~minutes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The trap: build latency kills the "},{"inlineContent":[{"text":"emergency","type":"text"}],"type":"emphasis"},{"type":"text","text":" use case."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"GitHub raw \/ Gist"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"✅ edit file"}]}],[{"type":"paragraph","inlineContent":[{"text":"unpredictable","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Not a production CDN; you don’t control "},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":", stale exactly when freshness matters."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your own app backend"}]}],[{"type":"paragraph","inlineContent":[{"text":"✅","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"instant"}]}],[{"type":"paragraph","inlineContent":[{"text":"The trap: it’s the service most likely down precisely when you need the killswitch.","type":"text"}]}]]]},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Recommended: Cloudflare Worker + KV."}],"type":"strong"},{"text":" The config lives in a KV key; the Worker returns it with a short ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":". You push an emergency block by writing one KV key — no redeploy. A complete, runnable example is in ","type":"text"},{"code":"Examples\/ConfigWorker\/","type":"codeVoice"},{"type":"text","text":" — one Worker, keyed "},{"code":"GET \/<appID>\/<resource>","type":"codeVoice"},{"type":"text","text":", that serves killswitch "},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"type":"text","text":" feature-flag config for every app in a portfolio from a single URL and a single KV namespace (the Cloudflare dashboard becomes the one place you edit a value). The short version: create a KV namespace → seed "},{"code":"…\/killswitch","type":"codeVoice"},{"type":"text","text":" → "},{"code":"wrangler deploy","type":"codeVoice"},{"type":"text","text":" → point "},{"code":"KillswitchService.live(endpoint:)","type":"codeVoice"},{"type":"text","text":" at "},{"code":"https:\/\/<host>\/<appID>\/killswitch","type":"codeVoice"},{"type":"text","text":". See also "},{"code":"Examples\/ConfigWorker\/DEPLOY.md","type":"codeVoice"},{"type":"text","text":" for the multi-app operating convention."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Minimal alternative: a static object","type":"text"}]},{"text":" (Cloudflare R2, S3, any object store fronted by a CDN). Upload ","type":"text"},{"type":"codeVoice","code":"killswitch.json"},{"text":", set a short ","type":"text"},{"type":"codeVoice","code":"Cache-Control"},{"text":" on the object, re-upload to change it. Zero code; you give up the room to add server-side logic later. Equivalent push-in-seconds latency for this use case.","type":"text"}],"type":"paragraph"},{"text":"Freshness: the backend can’t fix client staleness","type":"heading","level":3,"anchor":"Freshness-the-backend-cant-fix-client-staleness"},{"inlineContent":[{"text":"The plugin caches the fetched config for ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"text":" (","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"default 3600s"}]},{"text":") regardless of how fresh your endpoint is. With the default, a perfectly deployed emergency block still won’t reach an already-launched app for up to an hour — and no backend choice changes that. If fast emergency response matters:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Lower ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"text":" to ~300–900s in ","type":"text"},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".killswitch(.forceFetch)"},{"type":"text","text":" on app-foreground — it bypasses the freshness gate, so a returning user re-checks immediately."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Keep your endpoint’s edge ","type":"text"},{"type":"codeVoice","code":"Cache-Control"},{"text":" at or below ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"text":"; caching longer at the edge than the client will re-ask buys nothing.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Testing","anchor":"Testing","type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"KillswitchService.mock(result:cached:cacheLifetime:)"},{"text":" to drive the plugin from a test without hitting the network:","type":"text"}],"type":"paragraph"},{"code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The mock factory’s "},{"type":"codeVoice","code":"result"},{"type":"text","text":" closure can also throw. With no cached config, the plugin dispatches only "},{"type":"codeVoice","code":".fetchFailed"},{"text":". With a cached config, it dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from cache ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"code":".fetchFailed","type":"codeVoice"},{"type":"text","text":", so test the fallback