{"sections":[],"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true}],"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"Add a Version Killswitch"},"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"variants":[{"paths":["\/documentation\/swidux\/howtoaddaversionkillswitch"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", so any view can react to it."}],"type":"paragraph"},{"text":"Before you start","level":2,"anchor":"Before-you-start","type":"heading"},{"inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired up: an "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", an "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and a "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory. If not, work through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"type":"text","text":" first."}],"type":"paragraph"},{"text":"Step 1: Add the dependency","level":2,"anchor":"Step-1-Add-the-dependency","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" is a separate product in the "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" package. Add it to the target that wires the store:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"]},{"inlineContent":[{"type":"text","text":"If you re-export Swidux from "},{"code":"AppState.swift","type":"codeVoice"},{"type":"text","text":" (recommended), import "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" directly in "},{"type":"codeVoice","code":"AppStore.swift"},{"type":"text","text":" and "},{"code":"AppState.swift","type":"codeVoice"},{"type":"text","text":" where the types are referenced."}],"type":"paragraph"},{"level":2,"text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions","type":"heading"},{"inlineContent":[{"text":"Mount a ","type":"text"},{"type":"codeVoice","code":"KillswitchState"},{"text":" slice on your root state and add an action case that wraps ","type":"text"},{"type":"codeVoice","code":"KillswitchAction"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"],"type":"codeListing"},{"syntax":"swift","code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"],"type":"codeListing"},{"content":[{"inlineContent":[{"type":"text","text":""},{"code":"import SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" is needed in "},{"inlineContent":[{"type":"text","text":"every"}],"type":"emphasis"},{"text":" file that touches ","type":"text"},{"code":"store.killswitch.*","type":"codeVoice"},{"type":"text","text":" or "},{"code":"KillswitchAction","type":"codeVoice"},{"type":"text","text":" — including views that read the verdict for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Tip","style":"tip","type":"aside"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin’s reducer handles "},{"code":".killswitch","type":"codeVoice"},{"text":" actions itself. Your root reducer should fall through:","type":"text"}]},{"type":"codeListing","code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"],"syntax":"swift"},{"text":"Step 3: Wire the plugin","level":2,"anchor":"Step-3-Wire-the-plugin","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Inside ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":", build a ","type":"text"},{"code":"KillswitchPlugin","type":"codeVoice"},{"text":" and register it on the plugin host. Use ","type":"text"},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":" for the production service:"}]},{"type":"codeListing","code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(static: \"https:\/\/example.com\/killswitch.json\")","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"appVersion"},{"type":"text","text":" closure runs every time "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":" evaluates, so it reflects the build that’s actually running. The plugin’s default "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" argument opens URLs through "},{"code":"UIApplication","type":"codeVoice"},{"type":"text","text":" or "},{"code":"NSWorkspace","type":"codeVoice"},{"type":"text","text":"; pass your own closure if you route URLs through a coordinator."}]},{"type":"heading","anchor":"Step-4-Trigger-fetch-on-launch","text":"Step 4: Trigger fetch on launch","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".killswitch(.fetch)"},{"type":"text","text":" from your root view’s "},{"type":"codeVoice","code":".task"},{"type":"text","text":" so the verdict is available before the user can interact:"}]},{"type":"codeListing","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":".fetch","type":"codeVoice"},{"type":"text","text":" is cache-aware: if the last fetch is within "},{"code":"cacheLifetime","type":"codeVoice"},{"type":"text","text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch "},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"type":"text","text":" instead, which bypasses the freshness gate."}]},{"inlineContent":[{"type":"text","text":"If the network call fails and a cached config is available, the plugin dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from the cache "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed(message)"},{"type":"text","text":". Your UI keeps a usable verdict and can still surface the error."}],"type":"paragraph"},{"level":2,"text":"Step 5: Render the verdict","anchor":"Step-5-Render-the-verdict","type":"heading"},{"inlineContent":[{"type":"text","text":"The simplest path is the bundled "},{"type":"codeVoice","code":"killswitchBlocker(verdict:onUpdate:)"},{"type":"text","text":" view modifier. It overlays a non-dismissible blocker when the verdict is "},{"type":"codeVoice","code":".blocked"},{"text":" and disables the underlying content while it is:","type":"text"}],"type":"paragraph"},{"code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":".unknown"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":" render nothing — the blocker only appears once the verdict comes back as ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":". The Update button calls the "},{"type":"codeVoice","code":"onUpdate"},{"type":"text","text":" closure, which dispatches "},{"type":"codeVoice","code":".killswitch(.openUpdateURL)"},{"type":"text","text":". The plugin checks "},{"type":"codeVoice","code":"canOpenUpdateURL"},{"type":"text","text":" and opens the URL through "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"NSWorkspace"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"]},{"type":"paragraph","inlineContent":[{"text":"The closure receives the verdict’s ","type":"text"},{"code":"title","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"message"},{"type":"text","text":", and a "},{"type":"codeVoice","code":"hasUpdateURL"},{"type":"text","text":" flag derived from "},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":", so your custom view doesn’t have to pattern-match the verdict itself.","type":"text"}]},{"type":"heading","level":2,"text":"Hosting the JSON config","anchor":"Hosting-the-JSON-config"},{"inlineContent":[{"type":"text","text":"The endpoint you pass to "},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"type":"text","text":" serves a JSON document matching "},{"code":"KillswitchConfig","type":"codeVoice"},{"type":"text","text":". Every field is optional. The four operational shapes you’ll actually use:"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"1. Soft minimum version (most common)."}],"type":"strong"},{"text":" Force everyone below the floor to update; let everyone else through.","type":"text"}]},{"type":"codeListing","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"2. Emergency block of a specific bad build.","type":"text"}]},{"type":"text","text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue."}]},{"code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"3. Range block."}]},{"text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes).","type":"text"}]},{"type":"codeListing","code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"inlineContent":[{"type":"text","text":"Range entries use the literal string "},{"type":"codeVoice","code":"\"a.b.c..<x.y.z\""},{"type":"text","text":" — half-open, lower bound inclusive, upper bound exclusive."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"4. Allow everyone."}],"type":"strong"},{"text":" Sometimes you just want the killswitch live but quiet.","type":"text"}],"type":"paragraph"},{"code":["{}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"text":"Rules combine. Adding all of them in one document lets you lift the floor ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" knock out a specific bad build ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:"}]},{"type":"codeListing","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"type":"heading","level":3,"text":"Where to host it","anchor":"Where-to-host-it"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The contract is small: a public "},{"code":"GET","type":"codeVoice"},{"type":"text","text":" that returns "},{"type":"codeVoice","code":"KillswitchConfig"},{"type":"text","text":"-shaped JSON. It’s read on every cold launch, the plugin is fail-open, and it caches the result client-side — so the backend can be trivial. The one requirement that actually shapes the choice: "},{"inlineContent":[{"type":"text","text":"a killswitch’s value is how fast you can push an emergency block."}],"type":"strong"},{"type":"text","text":" Anything that needs a redeploy or a git build to change the config defeats the purpose."}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Option"}]}],[{"inlineContent":[{"type":"text","text":"Change config without redeploy?"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Propagation"}]}],[{"inlineContent":[{"type":"text","text":"Notes"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Cloudflare Worker + Workers KV","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"(recommended)","type":"text"}],"type":"emphasis"}]}],[{"type":"paragraph","inlineContent":[{"text":"✅ ","type":"text"},{"type":"codeVoice","code":"wrangler kv key put"},{"text":" or dashboard","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"seconds","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Flip in seconds, edge-cached, room to add logic (geo\/gradual\/per-build) later. Runnable example below.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Static object (R2 \/ S3 + CDN)"}]}],[{"inlineContent":[{"type":"text","text":"✅ re-upload object"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"seconds (after purge)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Zero code. Must set ","type":"text"},{"type":"codeVoice","code":"Cache-Control"},{"text":" as object metadata; no room to grow.","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"Static site \/ Pages (git-backed)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌ commit + build"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"~minutes"}]}],[{"type":"paragraph","inlineContent":[{"text":"The trap: build latency kills the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"emergency","type":"text"}]},{"text":" use case.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"GitHub raw \/ Gist"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"✅ edit file"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"unpredictable"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Not a production CDN; you don’t control "},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":", stale exactly when freshness matters."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your own app backend"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"✅"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"instant"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The trap: it’s the service most likely down precisely when you need the killswitch."}]}]]]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Recommended: Cloudflare Worker + KV."}]},{"text":" The config lives in a KV key; the Worker returns it with a short ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":". You push an emergency block by writing one KV key — no redeploy. A complete, runnable example is in ","type":"text"},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"text":" — one Worker, keyed ","type":"text"},{"type":"codeVoice","code":"GET \/<appID>\/<resource>"},{"type":"text","text":", that serves killswitch "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" feature-flag config for every app in a portfolio from a single URL and a single KV namespace (the Cloudflare dashboard becomes the one place you edit a value). The short version: create a KV namespace → seed "},{"type":"codeVoice","code":"…\/killswitch"},{"type":"text","text":" → "},{"type":"codeVoice","code":"wrangler deploy"},{"type":"text","text":" → point "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:)"},{"type":"text","text":" at "},{"type":"codeVoice","code":"https:\/\/<host>\/<appID>\/killswitch"},{"type":"text","text":". See also "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/DEPLOY.md"},{"type":"text","text":" for the multi-app operating convention."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Minimal alternative: a static object"}],"type":"strong"},{"type":"text","text":" (Cloudflare R2, S3, any object store fronted by a CDN). Upload "},{"code":"killswitch.json","type":"codeVoice"},{"type":"text","text":", set a short "},{"code":"Cache-Control","type":"codeVoice"},{"type":"text","text":" on the object, re-upload to change it. Zero code; you give up the room to add server-side logic later. Equivalent push-in-seconds latency for this use case."}]},{"anchor":"Freshness-the-backend-cant-fix-client-staleness","type":"heading","level":3,"text":"Freshness: the backend can’t fix client staleness"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin caches the fetched config for "},{"code":"cacheLifetime","type":"codeVoice"},{"type":"text","text":" ("},{"inlineContent":[{"type":"text","text":"default 3600s"}],"type":"strong"},{"type":"text","text":") regardless of how fresh your endpoint is. With the default, a perfectly deployed emergency block still won’t reach an already-launched app for up to an hour — and no backend choice changes that. If fast emergency response matters:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Lower ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"text":" to ~300–900s in ","type":"text"},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Dispatch ","type":"text"},{"type":"codeVoice","code":".killswitch(.forceFetch)"},{"text":" on app-foreground — it bypasses the freshness gate, so a returning user re-checks immediately.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep your endpoint’s edge "},{"code":"Cache-Control","type":"codeVoice"},{"type":"text","text":" at or below "},{"code":"cacheLifetime","type":"codeVoice"},{"type":"text","text":"; caching longer at the edge than the client will re-ask buys nothing."}]},{"anchor":"Testing","type":"heading","level":2,"text":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"KillswitchService.mock(result:cached:cacheLifetime:)","type":"codeVoice"},{"type":"text","text":" to drive the plugin from a test without hitting the network:"}]},{"type":"codeListing","code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked, fromNetwork: true)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mock factory’s "},{"code":"result","type":"codeVoice"},{"type":"text","text":" closure can also throw. With no cached config, the plugin dispatches only "},{"code":".fetchFailed","type":"codeVoice"},{"type":"text","text":". With a cached config, it dispatches "},{"code":".verdictReceived(...)","type":"codeVoice"},{"type":"text","text":" from cache "},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"type":"text","text":" "},{"code":".fetchFailed","type":"codeVoice"},{"type":"text","text":", so test the fallback path with both "},{"code":"result:","type":"codeVoice"},{"type":"text","text":" and "},{"code":"cached:","type":"codeVoice"},{"type":"text","text":" set:"}]},{"type":"codeListing","code":["service: .mock(","    result: { throw URLError(.notConnectedToInternet) },","    cached: KillswitchConfig(minimumSupportedVersion: \"1.0.0\")",")"],"syntax":"swift"}]}],"kind":"article","references":{"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"title":"Add Feature Flags","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"kind":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","role":"article"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"title":"Building a Domain Plugin","role":"article","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","url":"\/documentation\/swidux\/buildingadomainplugin","kind":"article"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"title":"Cancel Effects","role":"article","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","url":"\/documentation\/swidux\/howtocanceleffects","kind":"article"},"doc://Swidux/documentation/Swidux/SecurityPosture":{"role":"collectionGroup","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","type":"topic","url":"\/documentation\/swidux\/securityposture","abstract":[{"type":"text","text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one."}],"kind":"article","title":"Security Posture"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"title":"Add a Paywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"kind":"article","url":"\/documentation\/swidux\/howtoaddapaywall",