{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", so any view can react to it.","type":"text"}],"type":"paragraph"},{"text":"Before you start","anchor":"Before-you-start","type":"heading","level":2},{"inlineContent":[{"text":"This guide assumes you already have a Swidux app wired up: an ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", an ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":", an ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory. If not, work through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"text":" first.","type":"text"}],"type":"paragraph"},{"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" is a separate product in the ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":" package. Add it to the target that wires the store:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"],"syntax":"swift"},{"inlineContent":[{"text":"If you re-export Swidux from ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":" (recommended), import ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" directly in ","type":"text"},{"type":"codeVoice","code":"AppStore.swift"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":" where the types are referenced.","type":"text"}],"type":"paragraph"},{"text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions","type":"heading","level":2},{"inlineContent":[{"text":"Mount a ","type":"text"},{"type":"codeVoice","code":"KillswitchState"},{"text":" slice on your root state and add an action case that wraps ","type":"text"},{"type":"codeVoice","code":"KillswitchAction"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"],"syntax":"swift"},{"type":"codeListing","code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"],"syntax":"swift"},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"code":"import SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" is needed in "},{"inlineContent":[{"type":"text","text":"every"}],"type":"emphasis"},{"type":"text","text":" file that touches "},{"code":"store.killswitch.*","type":"codeVoice"},{"type":"text","text":" or "},{"code":"KillswitchAction","type":"codeVoice"},{"type":"text","text":" — including views that read the verdict for display. "},{"code":"@_exported import Swidux","type":"codeVoice"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}],"style":"tip","name":"Tip"},{"inlineContent":[{"text":"The plugin’s reducer handles ","type":"text"},{"type":"codeVoice","code":".killswitch"},{"text":" actions itself. Your root reducer should fall through:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"],"syntax":"swift"},{"text":"Step 3: Wire the plugin","anchor":"Step-3-Wire-the-plugin","type":"heading","level":2},{"inlineContent":[{"text":"Inside ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":", build a ","type":"text"},{"type":"codeVoice","code":"KillswitchPlugin"},{"text":" and register it on the plugin host. Use ","type":"text"},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"text":" for the production service:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(static: \"https:\/\/example.com\/killswitch.json\")","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"appVersion"},{"text":" closure runs every time ","type":"text"},{"type":"codeVoice","code":".fetch"},{"text":" evaluates, so it reflects the build that’s actually running. The plugin’s default ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" argument opens URLs through ","type":"text"},{"type":"codeVoice","code":"UIApplication"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"NSWorkspace"},{"text":"; pass your own closure if you route URLs through a coordinator.","type":"text"}],"type":"paragraph"},{"text":"Step 4: Trigger fetch on launch","anchor":"Step-4-Trigger-fetch-on-launch","type":"heading","level":2},{"inlineContent":[{"text":"Dispatch ","type":"text"},{"type":"codeVoice","code":".killswitch(.fetch)"},{"text":" from your root view’s ","type":"text"},{"type":"codeVoice","code":".task"},{"text":" so the verdict is available before the user can interact:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":".fetch"},{"text":" is cache-aware: if the last fetch is within ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch ","type":"text"},{"type":"codeVoice","code":".killswitch(.forceFetch)"},{"text":" instead, which bypasses the freshness gate.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the network call fails and a cached config is available, the plugin dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" from the cache ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":".fetchFailed(message)"},{"text":". Your UI keeps a usable verdict and can still surface the error.","type":"text"}],"type":"paragraph"},{"text":"Step 5: Render the verdict","anchor":"Step-5-Render-the-verdict","type":"heading","level":2},{"inlineContent":[{"text":"The simplest path is the bundled ","type":"text"},{"type":"codeVoice","code":"killswitchBlocker(verdict:onUpdate:)"},{"text":" view modifier. It overlays a non-dismissible blocker when the verdict is ","type":"text"},{"type":"codeVoice","code":".blocked"},{"text":" and disables the underlying content while it is:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":".unknown"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":" render nothing — the blocker only appears once the verdict comes back as ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"text":". The Update button calls the ","type":"text"},{"type":"codeVoice","code":"onUpdate"},{"text":" closure, which dispatches ","type":"text"},{"type":"codeVoice","code":".killswitch(.openUpdateURL)"},{"text":". The plugin checks ","type":"text"},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":" and opens the URL through ","type":"text"},{"type":"codeVoice","code":"UIApplication"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"NSWorkspace"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"],"syntax":"swift"},{"inlineContent":[{"text":"The closure receives the verdict’s ","type":"text"},{"type":"codeVoice","code":"title"},{"text":", ","type":"text"},{"type":"codeVoice","code":"message"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"hasUpdateURL"},{"text":" flag derived from ","type":"text"},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":", so your custom view doesn’t have to pattern-match the verdict itself.","type":"text"}],"type":"paragraph"},{"text":"Hosting the JSON config","anchor":"Hosting-the-JSON-config","type":"heading","level":2},{"inlineContent":[{"text":"The endpoint you pass to ","type":"text"},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"text":" serves a JSON document matching ","type":"text"},{"type":"codeVoice","code":"KillswitchConfig"},{"text":". Every field is optional. The four operational shapes you’ll actually use:","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"1. Soft minimum version (most common)."}],"type":"strong"},{"text":" Force everyone below the floor to update; let everyone else through.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"2. Emergency block of a specific bad build."}],"type":"strong"},{"text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"3. Range block."}],"type":"strong"},{"text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes).","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"inlineContent":[{"text":"Range entries use the literal string ","type":"text"},{"type":"codeVoice","code":"\"a.b.c..<x.y.z\""},{"text":" — half-open, lower bound inclusive, upper bound exclusive.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"4. Allow everyone."}],"type":"strong"},{"text":" Sometimes you just want the killswitch live but quiet.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["{}"],"syntax":"json"},{"inlineContent":[{"text":"Rules combine. Adding all of them in one document lets you lift the floor ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" knock out a specific bad build ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"text":"Where to host it","anchor":"Where-to-host-it","type":"heading","level":3},{"inlineContent":[{"text":"The contract is small: a public ","type":"text"},{"type":"codeVoice","code":"GET"},{"text":" that returns ","type":"text"},{"type":"codeVoice","code":"KillswitchConfig"},{"text":"-shaped JSON. It’s read on every cold launch, the plugin is fail-open, and it caches the result client-side — so the backend can be trivial. The one requirement that actually shapes the choice: ","type":"text"},{"inlineContent":[{"type":"text","text":"a killswitch’s value is how fast you can push an emergency block."}],"type":"strong"},{"text":" Anything that needs a redeploy or a git build to change the config defeats the purpose.","type":"text"}],"type":"paragraph"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Option"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Change config without redeploy?"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Propagation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Notes"}],"type":"paragraph"}]],[[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Cloudflare Worker + Workers KV"}],"type":"strong"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"(recommended)"}],"type":"emphasis"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅ "},{"code":"wrangler kv key put","type":"codeVoice"},{"type":"text","text":" or dashboard"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"seconds"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Flip in seconds, edge-cached, room to add logic (geo\/gradual\/per-build) later. Runnable example below."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Static object (R2 \/ S3 + CDN)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅ re-upload object"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"seconds (after purge)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Zero code. Must set "},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":" as object metadata; no room to grow."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Static site \/ Pages (git-backed)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌ commit + build"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"~minutes"}]}],[{"type":"paragraph","inlineContent":[{"text":"The trap: build latency kills the ","type":"text"},{"inlineContent":[{"type":"text","text":"emergency"}],"type":"emphasis"},{"text":" use case.","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"GitHub raw \/ Gist"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"✅ edit file","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"unpredictable","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Not a production CDN; you don’t control "},{"code":"Cache-Control","type":"codeVoice"},{"type":"text","text":", stale exactly when freshness matters."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your own app backend"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"✅"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"instant"}]}],[{"inlineContent":[{"type":"text","text":"The trap: it’s the service most likely down precisely when you need the killswitch."}],"type":"paragraph"}]]],"header":"row"},{"inlineContent":[{"inlineContent":[{"type":"text","text":"Recommended: Cloudflare Worker + KV."}],"type":"strong"},{"type":"text","text":" The config lives in a KV key; the Worker returns it with a short "},{"code":"Cache-Control","type":"codeVoice"},{"type":"text","text":". You push an emergency block by writing one KV key — no redeploy. A complete, runnable example is in "},{"code":"Examples\/ConfigWorker\/","type":"codeVoice"},{"type":"text","text":" — one Worker, keyed "},{"code":"GET \/<appID>\/<resource>","type":"codeVoice"},{"type":"text","text":", that serves killswitch "},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"type":"text","text":" feature-flag config for every app in a portfolio from a single URL and a single KV namespace (the Cloudflare dashboard becomes the one place you edit a value). The short version: create a KV namespace → seed "},{"code":"…\/killswitch","type":"codeVoice"},{"type":"text","text":" → "},{"code":"wrangler deploy","type":"codeVoice"},{"type":"text","text":" → point "},{"code":"KillswitchService.live(endpoint:)","type":"codeVoice"},{"type":"text","text":" at "},{"code":"https:\/\/<host>\/<appID>\/killswitch","type":"codeVoice"},{"type":"text","text":". See also "},{"code":"Examples\/ConfigWorker\/DEPLOY.md","type":"codeVoice"},{"type":"text","text":" for the multi-app operating convention."}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"text":"Minimal alternative: a static object","type":"text"}],"type":"strong"},{"text":" (Cloudflare R2, S3, any object store fronted by a CDN). Upload ","type":"text"},{"type":"codeVoice","code":"killswitch.json"},{"text":", set a short ","type":"text"},{"type":"codeVoice","code":"Cache-Control"},{"text":" on the object, re-upload to change it. Zero code; you give up the room to add server-side logic later. Equivalent push-in-seconds latency for this use case.","type":"text"}],"type":"paragraph"},{"text":"Freshness: the backend can’t fix client staleness","anchor":"Freshness-the-backend-cant-fix-client-staleness","type":"heading","level":3},{"inlineContent":[{"text":"The plugin caches the fetched config for ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"text":" (","type":"text"},{"inlineContent":[{"type":"text","text":"default 3600s"}],"type":"strong"},{"text":") regardless of how fresh your endpoint is. With the default, a perfectly deployed emergency block still won’t reach an already-launched app for up to an hour — and no backend choice changes that. If fast emergency response matters:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Lower "},{"code":"cacheLifetime","type":"codeVoice"},{"type":"text","text":" to ~300–900s in "},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Dispatch "},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"type":"text","text":" on app-foreground — it bypasses the freshness gate, so a returning user re-checks immediately."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Keep your endpoint’s edge ","type":"text"},{"type":"codeVoice","code":"Cache-Control"},{"text":" at or below ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"text":"; caching longer at the edge than the client will re-ask buys nothing.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Testing","type":"heading","anchor":"Testing"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"KillswitchService.mock(result:cached:cacheLifetime:)"},{"text":" to drive the plugin from a test without hitting the network:","type":"text"}],"type":"paragraph"},{"code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked, fromNetwork: true)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The mock factory’s ","type":"text"},{"type":"codeVoice","code":"result"},{"text":" closure can also throw. With no cached config, the plugin dispatches only ","type":"text"},{"type":"codeVoice","code":".fetchFailed"},{"text":". With a cached config, it dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" from cache ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":".fetchFailed"},{"type":"text","text":", so test the fallback path with both "},{"code":"result:","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cached:"},{"text":" set:","typ