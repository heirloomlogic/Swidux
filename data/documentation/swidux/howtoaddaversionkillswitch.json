{"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", so any view can react to it."}]},{"anchor":"Before-you-start","type":"heading","level":2,"text":"Before you start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired up: an "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and a "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory. If not, work through "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}]},{"anchor":"Step-1-Add-the-dependency","type":"heading","level":2,"text":"Step 1: Add the dependency"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" is a separate product in the "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" package. Add it to the target that wires the store:"}]},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you re-export Swidux from "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" (recommended), import "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" directly in "},{"type":"codeVoice","code":"AppStore.swift"},{"type":"text","text":" and "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" where the types are referenced."}]},{"anchor":"Step-2-Add-state-and-actions","type":"heading","level":2,"text":"Step 2: Add state and actions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mount a "},{"type":"codeVoice","code":"KillswitchState"},{"type":"text","text":" slice on your root state and add an action case that wraps "},{"type":"codeVoice","code":"KillswitchAction"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin’s reducer handles "},{"type":"codeVoice","code":".killswitch"},{"type":"text","text":" actions itself. Your root reducer should fall through:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"]},{"anchor":"Step-3-Wire-the-plugin","type":"heading","level":2,"text":"Step 3: Wire the plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inside "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":", build a "},{"type":"codeVoice","code":"KillswitchPlugin"},{"type":"text","text":" and register it on the plugin host. Use "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":" for the production service:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(string: \"https:\/\/example.com\/killswitch.json\")!","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"appVersion"},{"type":"text","text":" closure runs every time "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":" evaluates, so it reflects the build that’s actually running. The plugin’s default "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" argument opens URLs through "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" or "},{"type":"codeVoice","code":"NSWorkspace"},{"type":"text","text":"; pass your own closure if you route URLs through a coordinator."}]},{"anchor":"Step-4-Trigger-fetch-on-launch","type":"heading","level":2,"text":"Step 4: Trigger fetch on launch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".killswitch(.fetch)"},{"type":"text","text":" from your root view’s "},{"type":"codeVoice","code":".task"},{"type":"text","text":" so the verdict is available before the user can interact:"}]},{"syntax":"swift","type":"codeListing","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"},{"type":"text","text":" is cache-aware: if the last fetch is within "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch "},{"type":"codeVoice","code":".killswitch(.forceFetch)"},{"type":"text","text":" instead, which bypasses the freshness gate."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the network call fails and a cached config is available, the plugin dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from the cache "},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed(message)"},{"type":"text","text":". Your UI keeps a usable verdict and can still surface the error."}]},{"anchor":"Step-5-Render-the-verdict","type":"heading","level":2,"text":"Step 5: Render the verdict"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest path is the bundled "},{"type":"codeVoice","code":"killswitchBlocker(verdict:onUpdate:)"},{"type":"text","text":" view modifier. It overlays a non-dismissible blocker when the verdict is "},{"type":"codeVoice","code":".blocked"},{"type":"text","text":" and disables the underlying content while it is:"}]},{"syntax":"swift","type":"codeListing","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unknown"},{"type":"text","text":" and "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" render nothing — the blocker only appears once the verdict comes back as "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":". The Update button calls the "},{"type":"codeVoice","code":"onUpdate"},{"type":"text","text":" closure, which dispatches "},{"type":"codeVoice","code":".killswitch(.openUpdateURL)"},{"type":"text","text":". The plugin checks "},{"type":"codeVoice","code":"canOpenUpdateURL"},{"type":"text","text":" and opens the URL through "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"NSWorkspace"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:"}]},{"syntax":"swift","type":"codeListing","code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The closure receives the verdict’s "},{"type":"codeVoice","code":"title"},{"type":"text","text":", "},{"type":"codeVoice","code":"message"},{"type":"text","text":", and a "},{"type":"codeVoice","code":"hasUpdateURL"},{"type":"text","text":" flag derived from "},{"type":"codeVoice","code":"canOpenUpdateURL"},{"type":"text","text":", so your custom view doesn’t have to pattern-match the verdict itself."}]},{"anchor":"Hosting-the-JSON-config","type":"heading","level":2,"text":"Hosting the JSON config"},{"type":"paragraph","inlineContent":[{"text":"The endpoint you pass to ","type":"text"},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"text":" serves a JSON document matching ","type":"text"},{"code":"KillswitchConfig","type":"codeVoice"},{"text":". Every field is optional. The four operational shapes you’ll actually use:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"1. Soft minimum version (most common).","type":"text"}]},{"type":"text","text":" Force everyone below the floor to update; let everyone else through."}]},{"syntax":"json","type":"codeListing","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"2. Emergency block of a specific bad build."}]},{"text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue.","type":"text"}],"type":"paragraph"},{"code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"3. Range block."}]},{"type":"text","text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes)."}],"type":"paragraph"},{"type":"codeListing","syntax":"json","code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"inlineContent":[{"type":"text","text":"Range entries use the literal string "},{"type":"codeVoice","code":"\"a.b.c..<x.y.z\""},{"type":"text","text":" — half-open, lower bound inclusive, upper bound exclusive."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"4. Allow everyone."}]},{"type":"text","text":" Sometimes you just want the killswitch live but quiet."}]},{"type":"codeListing","code":["{}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rules combine. Adding all of them in one document lets you lift the floor "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" knock out a specific bad build "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:"}]},{"type":"codeListing","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Serve the JSON with a short "},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":" (60–300 seconds) — the plugin already caches client-side via "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":", but a short edge-cache TTL keeps your origin from getting hammered after you push a config change."}]},{"type":"heading","anchor":"Testing","level":2,"text":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"KillswitchService.mock(result:cached:cacheLifetime:)"},{"type":"text","text":" to drive the plugin from a test without hitting the network:"}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The mock factory’s "},{"type":"codeVoice","code":"result"},{"type":"text","text":" closure can also throw. With no cached config, the plugin dispatches only "},{"type":"codeVoice","code":".fetchFailed"},{"type":"text","text":". With a cached config, it dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from cache "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed"},{"type":"text","text":", so test the fallback path with both "},{"type":"codeVoice","code":"result:"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cached:"},{"type":"text","text":" set:"}]},{"type":"codeListing","code":["service: .mock(","    result: { throw URLError(.notConnectedToInternet) },","    cached: KillswitchConfig(minimumSupportedVersion: \"1.0.0\")",")"],"syntax":"swift"}],"kind":"content"}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}],"title":"Add a Version Killswitch"},"variants":[{"paths":["\/documentation\/swidux\/howtoaddaversionkillswitch"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides","generated":true}],"references":{"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"title":"Add Feature Flags","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux/GettingStarted":{"abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"url":"\/documentation\/swidux\/gettingstarted","title":"Getting Started with Swidux","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},"doc://Swidux/documentation/Swidux/AgentSkill":{"url":"\/documentation\/swidux\/agentskill","abstract":[{"text":"Install the bundled ","type":"text"},{"code":"swidux-ref","type":"codeVoice"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"title":"Using the Swidux Agent Skill","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"title":"Add a Parental Gate","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"title":"Building a Domain Plugin","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},"doc://Swidux/documentation/Swidux":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"kind":"symbol","url":"\/documentation\/swidux","title":"Swidux"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"role":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"kind":"article","title":"Add a Paywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"url":"\/documentation\/swidux\/pluginkillswitchreference","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"title":"SwiduxKillswitch Reference","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"title":"Plugin Architecture","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"url":"\/documentation\/swidux\/howtoaddanalytics","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify.","type":"text"}],"title":"Add Analytics","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"}}}