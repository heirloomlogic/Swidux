{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation","title":"Related Documentation"},{"title":"How-to Guides","generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides"}],"variants":[{"paths":["\/documentation\/swidux\/howtoaddaversionkillswitch"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch"},"abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Swidux"}],"title":"Add a Version Killswitch"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", so any view can react to it."}],"type":"paragraph"},{"text":"Before you start","type":"heading","level":2,"anchor":"Before-you-start"},{"inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired up: an "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and a "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory. If not, work through "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true,"type":"reference"},{"text":" first.","type":"text"}],"type":"paragraph"},{"text":"Step 1: Add the dependency","type":"heading","level":2,"anchor":"Step-1-Add-the-dependency"},{"inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" is a separate product in the ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":" package. Add it to the target that wires the store:","type":"text"}],"type":"paragraph"},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"If you re-export Swidux from ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":" (recommended), import ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" directly in ","type":"text"},{"code":"AppStore.swift","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":" where the types are referenced.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Step-2-Add-state-and-actions","text":"Step 2: Add state and actions","type":"heading"},{"inlineContent":[{"type":"text","text":"Mount a "},{"type":"codeVoice","code":"KillswitchState"},{"type":"text","text":" slice on your root state and add an action case that wraps "},{"type":"codeVoice","code":"KillswitchAction"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"],"syntax":"swift","type":"codeListing"},{"type":"codeListing","code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"],"syntax":"swift"},{"name":"Tip","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxKillswitch"},{"text":" is needed in ","type":"text"},{"inlineContent":[{"type":"text","text":"every"}],"type":"emphasis"},{"type":"text","text":" file that touches "},{"code":"store.killswitch.*","type":"codeVoice"},{"type":"text","text":" or "},{"code":"KillswitchAction","type":"codeVoice"},{"type":"text","text":" — including views that read the verdict for display. "},{"code":"@_exported import Swidux","type":"codeVoice"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"type":"text","text":"."}]}],"type":"aside"},{"type":"paragraph","inlineContent":[{"text":"The plugin’s reducer handles ","type":"text"},{"type":"codeVoice","code":".killswitch"},{"text":" actions itself. Your root reducer should fall through:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"]},{"anchor":"Step-3-Wire-the-plugin","level":2,"text":"Step 3: Wire the plugin","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Inside "},{"code":"Store.configured()","type":"codeVoice"},{"text":", build a ","type":"text"},{"code":"KillswitchPlugin","type":"codeVoice"},{"text":" and register it on the plugin host. Use ","type":"text"},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"text":" for the production service:","type":"text"}]},{"code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(static: \"https:\/\/example.com\/killswitch.json\")","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"appVersion","type":"codeVoice"},{"type":"text","text":" closure runs every time "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":" evaluates, so it reflects the build that’s actually running. The plugin’s default "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" argument opens URLs through "},{"code":"UIApplication","type":"codeVoice"},{"type":"text","text":" or "},{"code":"NSWorkspace","type":"codeVoice"},{"type":"text","text":"; pass your own closure if you route URLs through a coordinator."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Step 4: Trigger fetch on launch","anchor":"Step-4-Trigger-fetch-on-launch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dispatch "},{"type":"codeVoice","code":".killswitch(.fetch)"},{"type":"text","text":" from your root view’s "},{"type":"codeVoice","code":".task"},{"type":"text","text":" so the verdict is available before the user can interact:"}]},{"type":"codeListing","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":".fetch","type":"codeVoice"},{"text":" is cache-aware: if the last fetch is within ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch ","type":"text"},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"text":" instead, which bypasses the freshness gate.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the network call fails and a cached config is available, the plugin dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" from the cache ","type":"text"},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":".fetchFailed(message)"},{"text":". Your UI keeps a usable verdict and can still surface the error.","type":"text"}]},{"type":"heading","level":2,"text":"Step 5: Render the verdict","anchor":"Step-5-Render-the-verdict"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest path is the bundled "},{"type":"codeVoice","code":"killswitchBlocker(verdict:onUpdate:)"},{"type":"text","text":" view modifier. It overlays a non-dismissible blocker when the verdict is "},{"type":"codeVoice","code":".blocked"},{"type":"text","text":" and disables the underlying content while it is:"}]},{"code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":".unknown","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" render nothing — the blocker only appears once the verdict comes back as ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":". The Update button calls the ","type":"text"},{"code":"onUpdate","type":"codeVoice"},{"text":" closure, which dispatches ","type":"text"},{"code":".killswitch(.openUpdateURL)","type":"codeVoice"},{"text":". The plugin checks ","type":"text"},{"code":"canOpenUpdateURL","type":"codeVoice"},{"text":" and opens the URL through ","type":"text"},{"code":"UIApplication","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"NSWorkspace","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:","type":"text"}]},{"code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The closure receives the verdict’s "},{"code":"title","type":"codeVoice"},{"type":"text","text":", "},{"code":"message","type":"codeVoice"},{"type":"text","text":", and a "},{"code":"hasUpdateURL","type":"codeVoice"},{"type":"text","text":" flag derived from "},{"code":"canOpenUpdateURL","type":"codeVoice"},{"type":"text","text":", so your custom view doesn’t have to pattern-match the verdict itself."}]},{"type":"heading","anchor":"Hosting-the-JSON-config","level":2,"text":"Hosting the JSON config"},{"type":"paragraph","inlineContent":[{"text":"The endpoint you pass to ","type":"text"},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"text":" serves a JSON document matching ","type":"text"},{"code":"KillswitchConfig","type":"codeVoice"},{"text":". Every field is optional. The four operational shapes you’ll actually use:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"1. Soft minimum version (most common)."}]},{"text":" Force everyone below the floor to update; let everyone else through.","type":"text"}]},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"2. Emergency block of a specific bad build.","type":"text"}]},{"type":"text","text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue."}]},{"code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"3. Range block.","type":"text"}],"type":"strong"},{"text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes).","type":"text"}]},{"code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Range entries use the literal string "},{"code":"\"a.b.c..<x.y.z\"","type":"codeVoice"},{"type":"text","text":" — half-open, lower bound inclusive, upper bound exclusive."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"4. Allow everyone."}],"type":"strong"},{"type":"text","text":" Sometimes you just want the killswitch live but quiet."}]},{"code":["{}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rules combine. Adding all of them in one document lets you lift the floor "},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" knock out a specific bad build "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:"}]},{"type":"codeListing","syntax":"json","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"anchor":"Where-to-host-it","type":"heading","level":3,"text":"Where to host it"},{"inlineContent":[{"text":"The contract is small: a public ","type":"text"},{"type":"codeVoice","code":"GET"},{"text":" that returns ","type":"text"},{"type":"codeVoice","code":"KillswitchConfig"},{"text":"-shaped JSON. It’s read on every cold launch, the plugin is fail-open, and it caches the result client-side — so the backend can be trivial. The one requirement that actually shapes the choice: ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"a killswitch’s value is how fast you can push an emergency block."}]},{"text":" Anything that needs a redeploy or a git build to change the config defeats the purpose.","type":"text"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Option"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Change config without redeploy?","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Propagation"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Notes"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Cloudflare Worker + Workers KV"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"(recommended)","type":"text"}]}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅ ","type":"text"},{"code":"wrangler kv key put","type":"codeVoice"},{"text":" or dashboard","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"seconds"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Flip in seconds, edge-cached, room to add logic (geo\/gradual\/per-build) later. Runnable example below.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Static object (R2 \/ S3 + CDN)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅ re-upload object","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"seconds (after purge)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Zero code. Must set ","type":"text"},{"type":"codeVoice","code":"Cache-Control"},{"text":" as object metadata; no room to grow.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Static site \/ Pages (git-backed)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"❌ commit + build","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"~minutes"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The trap: build latency kills the ","type":"text"},{"inlineContent":[{"type":"text","text":"emergency"}],"type":"emphasis"},{"text":" use case.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"GitHub raw \/ Gist"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅ edit file"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"unpredictable"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Not a production CDN; you don’t control "},{"code":"Cache-Control","type":"codeVoice"},{"type":"text","text":", stale exactly when freshness matters."}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Your own app backend","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"instant"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The trap: it’s the service most likely down precisely when you need the killswitch."}]}]]]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Recommended: Cloudflare Worker + KV.","type":"text"}]},{"type":"text","text":" The config lives in a KV key; the Worker returns it with a short "},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":". You push an emergency block by writing one KV key — no redeploy. A complete, runnable example is in "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"type":"text","text":" — one Worker, keyed "},{"type":"codeVoice","code":"GET \/<appID>\/<resource>"},{"type":"text","text":", that serves killswitch "},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"type":"text","text":" feature-flag config for every app in a portfolio from a single URL and a single KV namespace (the Cloudflare dashboard becomes the one place you edit a value). The short version: create a KV namespace → seed "},{"code":"…\/killswitch","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"wrangler deploy","type":"codeVoice"},{"text":" → point ","type":"text"},{"code":"KillswitchService.live(endpoint:)","type":"codeVoice"},{"text":" at ","type":"text"},{"code":"https:\/\/<host>\/<appID>\/killswitch","type":"codeVoice"},{"type":"text","text":". See also "},{"code":"Examples\/ConfigWorker\/DEPLOY.md","type":"codeVoice"},{"type":"text","text":" for the multi-app operating convention."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Minimal alternative: a static object"}],"type":"strong"},{"text":" (Cloudflare R2, S3, any object store fronted by a CDN). Upload ","type":"text"},{"type":"codeVoice","code":"killswitch.json"},{"text":", set a short ","type":"text"},{"type":"codeVoice","code":"Cache-Control"},{"text":" on the object, re-upload to change it. Zero code; you give up the room to add server-side logic later. Equivalent push-in-seconds latency for this use case.","type":"text"}]},{"type":"heading","level":3,"anchor":"Freshness-the-backend-cant-fix-client-staleness","text":"Freshness: the backend can’t fix client staleness"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin caches the fetched config for "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":" ("},{"inlineContent":[{"type":"text","text":"default 3600s"}],"type":"strong"},{"type":"text","text":") regardless of how fresh your endpoint is. With the default, a perfectly deployed emergency block still won’t reach an already-launched app for up to an hour — and no backend choice changes that. If fast emergency response matters:"}]},{"items":[{"content":[{"inlineContent":[{"text":"Lower ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":" to ~300–900s in "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Dispatch ","type":"text"},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"text":" on app-foreground — it bypasses the freshness gate, so a returning user re-checks immediately.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Keep your endpoint’s edge "},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":" at or below "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":"; caching longer at the edge than the client will re-ask buys nothing."}],"type":"paragraph"},{"anchor":"Testing","type":"heading","text":"Testing","level":2},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"KillswitchService.mock(result:cached:cacheLifetime:)","type":"codeVoice"},{"type":"text","text":" to drive the plugin from a test without hitting the network:"}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked, fromNetwork: true)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The mock factory’s ","type":"text"},{"type":"codeVoice","code":"result"},{"type":"text","text":" closure can also throw. With no cached config, the plugin dispatches only "},{"type":"codeVoice","code":".fetchFailed"},{"type":"text","text":". With a cached config, it dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from cache "},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed"},{"type":"text","text":", so test the fallback path with both "},{"type":"codeVoice","code":"result:"},{"type":"text","text":" and "},{"type":"codeVoice","code":"cached:"},{"type":"text","text":" set:"}]},{"type":"codeListing","syntax":"swift","code":["service: .mock(","    result: { throw URLError(.notConnectedToInternet) },","    cached: KillswitchConfig(minimumSupportedVersion: \"1.0.0\")",")"]}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","kind":"article","url":"\/documentation\/swidux\/agentskill","role":"article","title":"Using the Swidux Agent Skill","abstract":[{"text":"Install the bundled ","type":"text"},{"code":"swidux-ref","type":"codeVoice"},{"text":" ski