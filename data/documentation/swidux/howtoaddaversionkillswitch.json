{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddaversionkillswitch"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By the end of this guide your app fetches a JSON config from a URL you control, evaluates it against the running version, and presents a blocking sheet whenever the server marks the build as unsupported. The verdict lives in your "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", so any view can react to it."}]},{"text":"Before you start","type":"heading","level":2,"anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired up: an "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and a "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory. If not, work through "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}]},{"text":"Step 1: Add the dependency","type":"heading","level":2,"anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" is a separate product in the "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" package. Add it to the target that wires the store:"}]},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxKillswitch\", package: \"Swidux\"),","    ]",")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you re-export Swidux from "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" (recommended), import "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" directly in "},{"type":"codeVoice","code":"AppStore.swift"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" where the types are referenced."}]},{"text":"Step 2: Add state and actions","level":2,"type":"heading","anchor":"Step-2-Add-state-and-actions"},{"type":"paragraph","inlineContent":[{"text":"Mount a ","type":"text"},{"type":"codeVoice","code":"KillswitchState"},{"text":" slice on your root state and add an action case that wraps ","type":"text"},{"type":"codeVoice","code":"KillswitchAction"},{"text":":","type":"text"}]},{"code":["\/\/ App\/AppState.swift","import SwiduxKillswitch","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var killswitch: KillswitchState = .init()","    \/\/ ... your other slices","}"],"syntax":"swift","type":"codeListing"},{"syntax":"swift","code":["\/\/ App\/AppAction.swift","import SwiduxKillswitch","","enum AppAction: Sendable {","    case killswitch(KillswitchAction)","    \/\/ ... your other cases","}"],"type":"codeListing"},{"type":"aside","name":"Tip","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"import SwiduxKillswitch"},{"text":" is needed in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"text":" file that touches ","type":"text"},{"type":"codeVoice","code":"store.killswitch.*"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"KillswitchAction"},{"text":" — including views that read the verdict for display. ","type":"text"},{"type":"codeVoice","code":"@_exported import Swidux"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}],"style":"tip"},{"type":"paragraph","inlineContent":[{"text":"The plugin’s reducer handles ","type":"text"},{"type":"codeVoice","code":".killswitch"},{"text":" actions itself. Your root reducer should fall through:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .killswitch:","        return nil","    \/\/ ... your other cases","    }","}"]},{"type":"heading","text":"Step 3: Wire the plugin","anchor":"Step-3-Wire-the-plugin","level":2},{"type":"paragraph","inlineContent":[{"text":"Inside ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":", build a ","type":"text"},{"code":"KillswitchPlugin","type":"codeVoice"},{"text":" and register it on the plugin host. Use ","type":"text"},{"code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)","type":"codeVoice"},{"text":" for the production service:","type":"text"}]},{"code":["\/\/ App\/AppStore.swift","import SwiduxKillswitch","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        \/\/ ... existing reducer \/ undo \/ persistence setup","","        let killswitchPlugin = KillswitchPlugin<AppState, AppAction>(","            state: \\.killswitch,","            action: AppAction.killswitch,","            extractAction: {","                if case .killswitch(let a) = $0 { return a }","                return nil","            },","            service: KillswitchService.live(","                endpoint: URL(static: \"https:\/\/example.com\/killswitch.json\")","            ),","            appVersion: {","                Bundle.main.infoDictionary?[\"CFBundleShortVersionString\"] as? String ?? \"0.0.0\"","            }","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","        plugins.register(killswitchPlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"appVersion"},{"type":"text","text":" closure runs every time "},{"type":"codeVoice","code":".fetch"},{"text":" evaluates, so it reflects the build that’s actually running. The plugin’s default ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" argument opens URLs through ","type":"text"},{"type":"codeVoice","code":"UIApplication"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"NSWorkspace"},{"text":"; pass your own closure if you route URLs through a coordinator.","type":"text"}]},{"text":"Step 4: Trigger fetch on launch","type":"heading","level":2,"anchor":"Step-4-Trigger-fetch-on-launch"},{"inlineContent":[{"text":"Dispatch ","type":"text"},{"type":"codeVoice","code":".killswitch(.fetch)"},{"text":" from your root view’s ","type":"text"},{"type":"codeVoice","code":".task"},{"text":" so the verdict is available before the user can interact:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":".fetch","type":"codeVoice"},{"text":" is cache-aware: if the last fetch is within ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":" and a cached config is on disk, the plugin evaluates the cached config and skips the network. That makes a launch fetch cheap to issue on every cold start. For a manual refresh — pull-to-refresh, a “Check for updates” button, or a post-purchase health check — dispatch ","type":"text"},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"text":" instead, which bypasses the freshness gate.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If the network call fails and a cached config is available, the plugin dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from the cache ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":".fetchFailed(message)"},{"text":". Your UI keeps a usable verdict and can still surface the error.","type":"text"}]},{"anchor":"Step-5-Render-the-verdict","text":"Step 5: Render the verdict","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simplest path is the bundled "},{"code":"killswitchBlocker(verdict:onUpdate:)","type":"codeVoice"},{"type":"text","text":" view modifier. It overlays a non-dismissible blocker when the verdict is "},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" and disables the underlying content while it is:"}]},{"type":"codeListing","syntax":"swift","code":["struct RootView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        ContentView()","            .task { store.send(.killswitch(.fetch)) }","            .killswitchBlocker(verdict: store.killswitch.verdict) {","                store.send(.killswitch(.openUpdateURL))","            }","    }","}"]},{"type":"paragraph","inlineContent":[{"code":".unknown","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" render nothing — the blocker only appears once the verdict comes back as "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":". The Update button calls the "},{"type":"codeVoice","code":"onUpdate"},{"text":" closure, which dispatches ","type":"text"},{"type":"codeVoice","code":".killswitch(.openUpdateURL)"},{"type":"text","text":". The plugin checks "},{"type":"codeVoice","code":"canOpenUpdateURL"},{"type":"text","text":" and opens the URL through "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"NSWorkspace"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"If the default blocker styling doesn’t match your design, use the second overload with a custom view builder:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".killswitchBlocker(verdict: store.killswitch.verdict) { title, message, hasUpdateURL in","    MyBlockerView(","        title: title ?? \"Update required\",","        message: message,","        showsUpdateButton: hasUpdateURL,","        onUpdate: { store.send(.killswitch(.openUpdateURL)) }","    )","}"]},{"type":"paragraph","inlineContent":[{"text":"The closure receives the verdict’s ","type":"text"},{"type":"codeVoice","code":"title"},{"text":", ","type":"text"},{"type":"codeVoice","code":"message"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"hasUpdateURL"},{"text":" flag derived from ","type":"text"},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":", so your custom view doesn’t have to pattern-match the verdict itself.","type":"text"}]},{"type":"heading","text":"Hosting the JSON config","anchor":"Hosting-the-JSON-config","level":2},{"type":"paragraph","inlineContent":[{"text":"The endpoint you pass to ","type":"text"},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"text":" serves a JSON document matching ","type":"text"},{"type":"codeVoice","code":"KillswitchConfig"},{"text":". Every field is optional. The four operational shapes you’ll actually use:","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"1. Soft minimum version (most common).","type":"text"}]},{"text":" Force everyone below the floor to update; let everyone else through.","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"2. Emergency block of a specific bad build.","type":"text"}]},{"text":" A point release shipped with a corruption bug; block exactly those builds and let everyone else continue.","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","    \"blockedVersions\": [\"1.4.2\", \"1.4.3\"],","    \"blockedTitle\": \"Critical update available\",","    \"blockedMessage\": \"This build has a known data-loss issue. Please update.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"3. Range block.","type":"text"}]},{"text":" A whole range of builds is unsupported (e.g., everything between two breaking server changes).","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Builds 1.4.0 through 1.4.4 are no longer supported.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"type":"paragraph","inlineContent":[{"text":"Range entries use the literal string ","type":"text"},{"type":"codeVoice","code":"\"a.b.c..<x.y.z\""},{"text":" — half-open, lower bound inclusive, upper bound exclusive.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"4. Allow everyone.","type":"text"}]},{"text":" Sometimes you just want the killswitch live but quiet.","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{}"]},{"type":"paragraph","inlineContent":[{"text":"Rules combine. Adding all of them in one document lets you lift the floor ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"text":" knock out a specific bad build ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"text":" gate a known-broken range — checks run minimum-version → blocked-versions → blocked-ranges, returning the first match:","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.4.2\"],","    \"blockedRanges\": [\"1.5.0..<1.5.3\"],","    \"blockedTitle\": \"Update required\",","    \"blockedMessage\": \"Please update Counter to keep using it.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"type":"heading","text":"Where to host it","anchor":"Where-to-host-it","level":3},{"type":"paragraph","inlineContent":[{"text":"The contract is small: a public ","type":"text"},{"type":"codeVoice","code":"GET"},{"text":" that returns ","type":"text"},{"type":"codeVoice","code":"KillswitchConfig"},{"text":"-shaped JSON. It’s read on every cold launch, the plugin is fail-open, and it caches the result client-side — so the backend can be trivial. The one requirement that actually shapes the choice: ","type":"text"},{"type":"strong","inlineContent":[{"text":"a killswitch’s value is how fast you can push an emergency block.","type":"text"}]},{"text":" Anything that needs a redeploy or a git build to change the config defeats the purpose.","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Option","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Change config without redeploy?","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Propagation","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Notes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Cloudflare Worker + Workers KV"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"(recommended)","type":"text"}]}]}],[{"type":"paragraph","inlineContent":[{"text":"✅ ","type":"text"},{"code":"wrangler kv key put","type":"codeVoice"},{"text":" or dashboard","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"seconds","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Flip in seconds, edge-cached, room to add logic (geo\/gradual\/per-build) later. Runnable example below.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Static object (R2 \/ S3 + CDN)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"✅ re-upload object","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"seconds (after purge)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Zero code. Must set ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":" as object metadata; no room to grow.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Static site \/ Pages (git-backed)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"❌ commit + build","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"~minutes","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The trap: build latency kills the ","type":"text"},{"inlineContent":[{"type":"text","text":"emergency"}],"type":"emphasis"},{"text":" use case.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"GitHub raw \/ Gist","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"✅ edit file","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"unpredictable","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Not a production CDN; you don’t control "},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":", stale exactly when freshness matters."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"Your own app backend","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"✅","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"instant","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The trap: it’s the service most likely down precisely when you need the killswitch.","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Recommended: Cloudflare Worker + KV.","type":"text"}]},{"type":"text","text":" The config lives in a KV key; the Worker returns it with a short "},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":". You push an emergency block by writing one KV key — no redeploy. A complete, runnable example is in "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"type":"text","text":" — one Worker, keyed "},{"type":"codeVoice","code":"GET \/<appID>\/<resource>"},{"type":"text","text":", that serves killswitch "},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" feature-flag config for every app in a portfolio from a single URL and a single KV namespace (the Cloudflare dashboard becomes the one place you edit a value). The short version: create a KV namespace → seed ","type":"text"},{"code":"…\/killswitch","type":"codeVoice"},{"text":" → ","type":"text"},{"type":"codeVoice","code":"wrangler deploy"},{"type":"text","text":" → point "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:)"},{"type":"text","text":" at "},{"type":"codeVoice","code":"https:\/\/<host>\/<appID>\/killswitch"},{"type":"text","text":". See also "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/DEPLOY.md"},{"type":"text","text":" for the multi-app operating convention."}]},{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Minimal alternative: a static object"}],"type":"strong"},{"type":"text","text":" (Cloudflare R2, S3, any object store fronted by a CDN). Upload "},{"code":"killswitch.json","type":"codeVoice"},{"type":"text","text":", set a short "},{"type":"codeVoice","code":"Cache-Control"},{"type":"text","text":" on the object, re-upload to change it. Zero code; you give up the room to add server-side logic later. Equivalent push-in-seconds latency for this use case."}]},{"anchor":"Freshness-the-backend-cant-fix-client-staleness","level":3,"text":"Freshness: the backend can’t fix client staleness","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The plugin caches the fetched config for ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":" (","type":"text"},{"inlineContent":[{"type":"text","text":"default 3600s"}],"type":"strong"},{"text":") regardless of how fresh your endpoint is. With the default, a perfectly deployed emergency block still won’t reach an already-launched app for up to an hour — and no backend choice changes that. If fast emergency response matters:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Lower "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":" to ~300–900s in "},{"type":"codeVoice","code":"KillswitchService.live(endpoint:fetchTimeout:cacheLifetime:session:)"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Dispatch ","type":"text"},{"code":".killswitch(.forceFetch)","type":"codeVoice"},{"text":" on app-foreground — it bypasses the freshness gate, so a returning user re-checks immediately.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Keep your endpoint’s edge ","type":"text"},{"code":"Cache-Control","type":"codeVoice"},{"text":" at or below ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":"; caching longer at the edge than the client will re-ask buys nothing.","type":"text"}]},{"type":"heading","text":"Testing","anchor":"Testing","level":2},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"KillswitchService.mock(result:cached:cacheLifetime:)","type":"codeVoice"},{"text":" to drive the plugin from a test without hitting the network:","type":"text"}]},{"type":"codeListing","code":["@MainActor","@Test func blockedVersion_yieldsBlockedVerdict() async throws {","    var state = AppState()","    let plugin = KillswitchPlugin<AppState, AppAction>(","        state: \\.killswitch,","        action: AppAction.killswitch,","        extractAction: { if case .killswitch(let a) = $0 { return a }; return nil },","        service: .mock(result: {","            KillswitchConfig(minimumSupportedVersion: \"2.0.0\")","        }),","        appVersion: { \"1.0.0\" },","        openURL: { _ in }","    )","","    let effect = try #require(","        plugin.reduce(state: &state, action: .killswitch(.fetch))","    )","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .killswitch(.verdictReceived(.blocked, fromNetwork: true)) = dispatched.first {","        \/\/ pass","    } else {","        Issue.record(\"expected blocked verdict, got \\(dispatched)\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The mock factory’s ","type":"text"},{"code":"result","type":"codeVoice"},{"text":" closure can also throw. With no cached config, the plugin dispatches only ","type":"text"},{"code":".fetchFailed","type":"codeVoice"},{"text":". With a cached config, it dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" fr