{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/swidux\/pluginfeatureflagsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","title":"SwiduxFeatureFlags Reference","modules":[{"name":"Swidux"}],"role":"article"},"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" is a domain plugin that owns a ","type":"text"},{"code":"FeatureFlagsState","type":"codeVoice"},{"type":"text","text":" slice, fetches a JSON wire format via a provider-agnostic "},{"code":"FeatureFlagsService","type":"codeVoice"},{"type":"text","text":", and answers reads against state. Bucketing is pure FNV-1a so reads are synchronous and offline-capable."}]},{"type":"paragraph","inlineContent":[{"text":"Three flag types from one wire format:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"boolean"}],"type":"strong"},{"text":" — on\/off with rollout percentage (0–100).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"variant","type":"text"}]},{"type":"text","text":" — string-typed weighted variants for A\/B tests."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"value"}],"type":"strong"},{"text":" — typed remote-tunable scalar (","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Int"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"String"},{"text":").","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Library target","type":"heading","anchor":"Library-target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"code":"SwiduxFeatureFlags","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxFeatureFlags"}]}]}]},{"anchor":"Wire-format","type":"heading","text":"Wire format","level":2},{"type":"codeListing","syntax":"json","code":["{","  \"version\": 1,","  \"flags\": {","    \"new_onboarding\": { \"type\": \"boolean\", \"rollout\": 25 },","    \"checkout_layout\": {","      \"type\": \"variant\",","      \"variants\": [","        { \"value\": \"control\", \"weight\": 50 },","        { \"value\": \"treatment\", \"weight\": 50 }","      ]","    },","    \"max_free_uploads\": { \"type\": \"value\", \"value\": 5 }","  }","}"]},{"inlineContent":[{"type":"text","text":"The plugin rejects unknown "},{"type":"codeVoice","code":"version"},{"type":"text","text":" values and falls back to the last-known-good cache. Defaults always live in Swift at the call site — this keeps them type-checked and forces “what if missing?” thinking."}],"type":"paragraph"},{"anchor":"Bucketing-and-identity","level":2,"type":"heading","text":"Bucketing and identity"},{"inlineContent":[{"code":"bucket = FNV1a(bucketingID + \":\" + flagKey) % 100","type":"codeVoice"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Stable per ","type":"text"},{"code":"(bucketingID, flagKey)","type":"codeVoice"},{"type":"text","text":" pair forever."}],"type":"strong"},{"type":"text","text":" Same input always produces the same bucket."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Per-flag.","type":"text"}],"type":"strong"},{"text":" A user isn’t always in the “early” group across different flags.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Identity resolution.","type":"text"}],"type":"strong"},{"text":" When a ","type":"text"},{"type":"codeVoice","code":"userIDKeyPath"},{"type":"text","text":" is configured "},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"type":"text","text":" the current user ID is non-nil, that is used. Otherwise the install ID is used. Anonymous users get a stable per-install identity; logged-in users get stable cross-device assignment. A user’s variant "},{"inlineContent":[{"type":"text","text":"can"}],"type":"emphasis"},{"type":"text","text":" shift once at login — acceptable for nearly all real use cases."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"FNV-1a was chosen because it’s simple, dependency-free, and matches GrowthBook’s algorithm so apps migrating from GrowthBook get compatible buckets."}]},{"level":2,"text":"Evaluation order","type":"heading","anchor":"Evaluation-order"},{"type":"paragraph","inlineContent":[{"text":"For each read, in priority:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Local override present?","type":"text"}],"type":"strong"},{"type":"text","text":" Return it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Flag in remote config?"}],"type":"strong"},{"type":"text","text":" Evaluate (rollout \/ variant assignment \/ value lookup)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Otherwise","type":"text"}]},{"text":" return the Swift-side default.","type":"text"}]}]}],"type":"orderedList"},{"level":2,"text":"Persistence","type":"heading","anchor":"Persistence"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Install ID"}]},{"text":" persisted to ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":" on first generation. Read at hydration via "},{"type":"codeVoice","code":"FeatureFlagsState.hydrated(from:defaultConfig:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Last-known config"}],"type":"strong"},{"text":" persisted after every successful refresh. Hydrates as fallback before first network success.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Local overrides","type":"text"}]},{"text":" ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"type":"text","text":" persisted by default. Restart = clean state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"exposedKeys"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" persisted. New session = fresh exposure events."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","text":"Exposure tracking","level":2,"anchor":"Exposure-tracking"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A\/B testing is only analytically valid if you know which users actually saw each variant — bucketing alone is insufficient because the code path branching on the flag might never execute."}]},{"syntax":"swift","type":"codeListing","code":["store.send(.featureFlags(.recordExposure(key: \"checkout_layout\")))"]},{"type":"paragraph","inlineContent":[{"text":"Or via the SwiftUI sugar:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["WizardView()","    .recordsExposure(of: .checkoutLayout, store: store, action: AppAction.featureFlags)"]},{"type":"paragraph","inlineContent":[{"text":"The plugin dedupes per session and fires the optional ","type":"text"},{"type":"codeVoice","code":"onExposure"},{"text":" callback (passed at plugin init). Wire that callback to your analytics plugin to forward exposures as events.","type":"text"}]},{"level":2,"text":"Refresh policy","type":"heading","anchor":"Refresh-policy"},{"type":"codeListing","code":["public enum RefreshPolicy: Sendable {","    case manual                                      \/\/ every .refresh fetches","    case automatic(minInterval: TimeInterval)        \/\/ debounce; default 300s","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Apps dispatch ","type":"text"},{"code":".refresh","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"App.scenePhase","type":"codeVoice"},{"text":" transitions; the plugin’s debouncing makes this safe to call frequently. The plugin does not subscribe to ","type":"text"},{"code":"UIApplication","type":"codeVoice"},{"text":" notifications — wiring stays in the host app.","type":"text"}]},{"type":"heading","anchor":"Service-protocol","level":2,"text":"Service protocol"},{"type":"codeListing","code":["public protocol FeatureFlagsService: Sendable {","    func fetch() async throws -> FeatureFlagsConfig","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"One method. Caching, hydration, evaluation all live in the plugin."}]},{"type":"heading","anchor":"Built-in-HTTPFeatureFlagsService","level":3,"text":"Built-in: `HTTPFeatureFlagsService`"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" + "},{"type":"codeVoice","code":"JSONDecoder"},{"type":"text","text":". Apps host their JSON anywhere — static file on a CDN, Cloudflare Worker, their own server. Zero backend infrastructure required. "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"type":"text","text":" is a runnable shared Worker serving flags + killswitch for a whole portfolio from one URL ("},{"type":"codeVoice","code":"GET \/<appID>\/flags"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Third-party adapters (LaunchDarkly, GrowthBook, Statsig) conform to the same protocol without changing the plugin."}]},{"type":"heading","level":2,"anchor":"Typed-flag-keys","text":"Typed flag keys"},{"type":"codeListing","syntax":"swift","code":["public struct BoolFlag: Sendable, Hashable","public struct VariantFlag<Variant: RawRepresentable & Sendable> where Variant.RawValue == String","public struct ValueFlag<Value: Sendable>"]},{"inlineContent":[{"text":"Read API on ","type":"text"},{"type":"codeVoice","code":"FeatureFlagsState"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["state.isEnabled(.newOnboarding, default: false)","state.variant(of: .checkoutLayout)","state.value(of: .maxFreeUploads)"]},{"inlineContent":[{"type":"text","text":"Reads are pure synchronous functions. Per-property observation works as it does for any other state slice — views re-render only when the flag they read changes."}],"type":"paragraph"},{"type":"heading","text":"Action semantics (selected)","anchor":"Action-semantics-selected","level":2},{"inlineContent":[{"type":"codeVoice","code":"refreshSucceeded(FeatureFlagsConfig, fetchedAt:)"},{"type":"text","text":" is dispatched on every "},{"code":".refresh","type":"codeVoice"},{"type":"text","text":" (including debounced refreshes that return an unchanged config). Consume config transitions by observing "},{"code":"FeatureFlagsState","type":"codeVoice"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"API reference fo