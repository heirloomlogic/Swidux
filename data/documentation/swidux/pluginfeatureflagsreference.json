{"sections":[],"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"generated":true,"anchor":"Reference","title":"Reference"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginfeatureflagsreference"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" is a domain plugin that owns a ","type":"text"},{"code":"FeatureFlagsState","type":"codeVoice"},{"text":" slice, fetches a JSON wire format via a provider-agnostic ","type":"text"},{"code":"FeatureFlagsService","type":"codeVoice"},{"text":", and answers reads against state. Bucketing is pure FNV-1a so reads are synchronous and offline-capable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Three flag types from one wire format:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"boolean","type":"text"}]},{"type":"text","text":" — on\/off with rollout percentage (0–100)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"variant","type":"text"}],"type":"strong"},{"type":"text","text":" — string-typed weighted variants for A\/B tests."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"value"}],"type":"strong"},{"type":"text","text":" — typed remote-tunable scalar ("},{"type":"codeVoice","code":"Bool"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"String"},{"type":"text","text":")."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Library target","type":"heading","level":2,"anchor":"Library-target"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxFeatureFlags"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import: "},{"code":"import SwiduxFeatureFlags","type":"codeVoice"}]}]}],"type":"unorderedList"},{"text":"Wire format","type":"heading","level":2,"anchor":"Wire-format"},{"code":["{","  \"version\": 1,","  \"flags\": {","    \"new_onboarding\": { \"type\": \"boolean\", \"rollout\": 25 },","    \"checkout_layout\": {","      \"type\": \"variant\",","      \"variants\": [","        { \"value\": \"control\", \"weight\": 50 },","        { \"value\": \"treatment\", \"weight\": 50 }","      ]","    },","    \"max_free_uploads\": { \"type\": \"value\", \"value\": 5 }","  }","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"text":"The plugin rejects unknown ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" values and falls back to the last-known-good cache. Defaults always live in Swift at the call site — this keeps them type-checked and forces “what if missing?” thinking.","type":"text"}],"type":"paragraph"},{"anchor":"Bucketing-and-identity","level":2,"type":"heading","text":"Bucketing and identity"},{"inlineContent":[{"code":"bucket = FNV1a(bucketingID + \":\" + flagKey) % 100","type":"codeVoice"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Stable per "},{"type":"codeVoice","code":"(bucketingID, flagKey)"},{"type":"text","text":" pair forever."}],"type":"strong"},{"text":" Same input always produces the same bucket.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Per-flag.","type":"text"}]},{"text":" A user isn’t always in the “early” group across different flags.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Identity resolution.","type":"text"}],"type":"strong"},{"text":" When a ","type":"text"},{"type":"codeVoice","code":"userIDKeyPath"},{"text":" is configured ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" the current user ID is non-nil, that is used. Otherwise the ","type":"text"},{"inlineContent":[{"text":"device ID","type":"text"}],"type":"strong"},{"text":" is used (the plugin’s required ","type":"text"},{"type":"codeVoice","code":"deviceIDKeyPath"},{"text":"). Anonymous users get a stable per-install identity; logged-in users get stable cross-device assignment. A user’s variant ","type":"text"},{"inlineContent":[{"text":"can","type":"text"}],"type":"emphasis"},{"text":" shift once at login — acceptable for nearly all real use cases.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"FNV-1a was chosen because it’s simple, dependency-free, and matches GrowthBook’s algorithm so apps migrating from GrowthBook get compatible buckets.","type":"text"}]},{"type":"heading","text":"The device ID must be stable across reinstall","anchor":"The-device-ID-must-be-stable-across-reinstall","level":3},{"type":"paragraph","inlineContent":[{"text":"Bucketing is only stable if the fallback identity is. The plugin takes a non-optional ","type":"text"},{"code":"deviceIDKeyPath: KeyPath<State, String>","type":"codeVoice"},{"type":"text","text":" into your "},{"code":"AppState","type":"codeVoice"},{"text":", so the ","type":"text"},{"inlineContent":[{"type":"text","text":"app"}],"type":"emphasis"},{"type":"text","text":" owns the identity and the "},{"type":"emphasis","inlineContent":[{"text":"same","type":"text"}]},{"type":"text","text":" value can drive analytics ("},{"type":"codeVoice","code":"AnalyticsIdentity(userID: \\.deviceID, …)"},{"type":"text","text":") — one identity, so A\/B exposure correlates with the user analytics reports against."}]},{"inlineContent":[{"type":"text","text":"Mint it once at launch with the shared core helper, backed by the Keychain so it survives reinstall, and seed it into the slice via "},{"code":"hydrated(from:deviceID:)","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ In Store.configured()","let deviceID = KeychainKeyValueStore(service: \"com.example.app\").deviceIdentity()","","let plugin = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags, action: AppAction.featureFlags, extractAction: { … },","    service: service,","    deviceIDKeyPath: \\.deviceID,          \/\/ app-owned, Keychain-backed","    userIDKeyPath: \\.auth.currentUserID,  \/\/ optional; authed identity wins when set","    keyValueStore: kv",")","","let initial = AppState(","    featureFlags: .hydrated(from: kv, deviceID: deviceID),","    deviceID: deviceID",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":"-backed identity regenerates on reinstall (QA ad-hoc builds, test installs), which silently re-buckets users and breaks A\/B assignment — use "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" for the identity. The flags "},{"inlineContent":[{"type":"text","text":"config cache"}],"type":"emphasis"},{"type":"text","text":" can still live in a lighter store."}],"type":"paragraph"},{"level":2,"anchor":"Evaluation-order","text":"Evaluation order","type":"heading"},{"inlineContent":[{"text":"For each read, in priority:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Local override present?"}],"type":"strong"},{"text":" Return it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Flag in remote config?"}]},{"text":" Evaluate (rollout \/ variant assignment \/ value lookup).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Otherwise","type":"text"}]},{"text":" return the Swift-side default.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Persistence","level":2,"type":"heading","anchor":"Persistence"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Device ID"}]},{"type":"text","text":" is app-owned and minted once via "},{"code":"KeyValueStore.deviceIdentity()","type":"codeVoice"},{"type":"text","text":" (Keychain-backed). Seeded into the slice at "},{"code":"FeatureFlagsState.hydrated(from:deviceID:)","type":"codeVoice"},{"type":"text","text":" and kept in sync from "},{"code":"deviceIDKeyPath","type":"codeVoice"},{"type":"text","text":". The plugin no longer mints its own bucketing identity."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Last-known config"}]},{"text":" persisted after every successful refresh. Hydrates as fallback before first network success.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Local overrides","type":"text"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" persisted by default. Restart = clean state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"exposedKeys","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"type":"text","text":" persisted. New session = fresh exposure events."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Governance: no forever flags","anchor":"Governance-no-forever-flags","type":"heading"},{"inlineContent":[{"type":"text","text":"Owner and expiry are "},{"inlineContent":[{"type":"text","text":"required"}],"type":"strong"},{"type":"text","text":" metadata for every flag, enforced by a single unit test rather than the wire format (the JSON stays dumb and fail-open). Declare a manifest with the type-erasing factories — "},{"code":"owner","type":"codeVoice"},{"type":"text","text":" and "},{"code":"expires","type":"codeVoice"},{"type":"text","text":" are non-optional, so a flag can’t be registered without them — and the keys are single-sourced from the typed flag declarations:"}],"type":"paragraph"},{"syntax":"swift","code":["enum FlagManifest {","    static let all: [FlagDescriptor] = [","        .bool(.newOnboarding, owner: \"growth\",","              expires: Date(timeIntervalSince1970: 1_788_000_000), purpose: \"New onboarding flow\"),","        .variant(.checkoutLayout, owner: \"checkout\",","                 expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Checkout A\/B\"),","    ]","}","","@Test func noForeverFlags() {","    let report = FlagGovernance.expirationReport(FlagManifest.all)","    #expect(report == nil, \"\\(report ?? \"\")\")   \/\/ failure names each expired flag + owner","}"],"type":"codeListing"},{"inlineContent":[{"text":"When a flag passes its expiry, the test fails and the report names the flag, its owner, and how long it’s been expired — so a stale flag gets retired instead of living forever. This has no effect on runtime evaluation.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"The manifest is the single declaration site, so a typed flag key never added to it escapes governance. Closing that gap fully would need a macro; until then, convention plus code review covers it."}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"level":2,"text":"Exposure tracking","anchor":"Exposure-tracking","type":"heading"},{"inlineContent":[{"text":"A\/B testing is only analytically valid if you know which users actually saw each variant — bucketing alone is insufficient because the code path branching on the flag might never execute.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["store.send(.featureFlags(.recordExposure(key: \"checkout_layout\")))"],"type":"codeListing"},{"inlineContent":[{"text":"Or via the SwiftUI sugar:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["WizardView()","    .recordsExposure(of: .checkoutLayout, store: store, action: AppAction.featureFlags)"],"type":"codeListing"},{"inlineContent":[{"text":"The plugin dedupes per session and fires the optional ","type":"text"},{"code":"onExposure","type":"codeVoice"},{"text":" callback (passed at plugin init). Wire that callback to your analytics plugin to forward exposures as events.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Refresh policy","anchor":"Refresh-policy","type":"heading"},{"syntax":"swift","code":["public enum RefreshPolicy: Sendable {","    case manual                                      \/\/ every .refresh fetches","    case automatic(minInterval: TimeInterval)        \/\/ debounce; default 300s","}"],"type":"codeListing"},{"inlineContent":[{"text":"Apps dispatch ","type":"text"},{"code":".refresh","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"App.scenePhase","type":"codeVoice"},{"text":" transitions; the plugin’s debouncing makes this safe to call frequently. The plugin does not subscribe to ","type":"text"},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" notifications — wiring stays in the host app."}],"type":"paragraph"},{"text":"Service protocol","level":2,"type":"heading","anchor":"Service-protocol"},{"syntax":"swift","type":"codeListing","code":["public protocol FeatureFlagsService: Sendable {","    func fetch() async throws -> FeatureFlagsConfig","}"]},{"inlineContent":[{"type":"text","text":"One method. Caching, hydration, evaluation all live in the plugin."}],"type":"paragraph"},{"text":"Built-in: `HTTPFeatureFlagsService`","level":3,"type":"heading","anchor":"Built-in-HTTPFeatureFlagsService"},{"inlineContent":[{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" + "},{"type":"codeVoice","code":"JSONDecoder"},{"type":"text","text":". Apps host their JSON anywhere — static file on a CDN, Cloudflare Worker, their own server. Zero backend infrastructure required. "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"type":"text","text":" is a runnable shared Worker serving flags + killswitch for a whole portfolio from one URL ("},{"type":"codeVoice","code":"GET \/<appID>\/flags"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"text":"The URL must be ","type":"text"},{"type":"strong","inlineContent":[{"text":"HTTPS","type":"text"}]},{"text":" (","type":"text"},{"type":"codeVoice","code":"http"},{"text":" is allowed only for ","type":"text"},{"type":"codeVoice","code":"localhost"},{"text":" development servers; anything else is a precondition failure at init). Responses over 1 MB and non-2xx statuses throw, and malformed variant definitions (empty array, negative weights, weights not summing to 100) fail decoding — in every case the plugin keeps its last-known-good cached config.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Third-party adapters (LaunchDarkly, GrowthBook, Statsig) conform to the same protocol without changing the plugin.","type":"text"}],"type":"paragraph"},{"text":"Typed flag keys","level":2,"type":"heading","anchor":"Typed-flag-keys"},{"syntax":"swift","type":"codeListing","code":["public struct BoolFlag: Sendable, Hashable","public struct VariantFlag<Variant: RawRepresentable & Sendable> where Variant.RawValue == String","public struct ValueFlag<Value: Sendable>"]},{"inlineContent":[{"text":"Read API on ","type":"text"},{"code":"FeatureFlagsState","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["state.isEnabled(.newOnboarding, default: false)","state.variant(of: .checkoutLayout)","state.value(of: .maxFreeUploads)"]},{"inlineContent":[{"text":"Reads are pure synchronous functions. Per-property observation works as it does for any other state slice — views re-render only when the flag they read changes.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Action semantics (selected)","level":2,"anchor":"Action-semantics-selected"},{"type":"paragraph","inlineContent":[{"code":"refreshSucceeded(FeatureFlagsConfig, fetchedAt:)","type":"codeVoice"},{"text":" is dispatched on every ","type":"text"},{"code":".refresh","type":"codeVoice"},{"text":" (including debounced refreshes that return an unchanged config). Consume config transitions by observing ","type":"text"},{"code":"FeatureFlagsState","type":"codeVoice"},{"text":" or a value derived from it — not by mapping this action. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","type":"reference"},{"text":".","type":"text"}]}]}],"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article","title":"SwiduxFeatureFlags Reference"},"references":{"doc://Swidux/documentation/Swidux/GettingStarted":{"title":"Getting Started with Swidux","kind":"article","url":"\/documentation\/swidux\/gettingstarted","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/MacrosReference":{"url":"\/documentation\/swidux\/macrosreference","kind":"article","title":"Macros","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":")."}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","role":"article"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","kind":"symbol","title":"Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"title":"SwiduxPaywall Reference","kind":"article","url":"\/documentation\/swidux\/pluginpaywallreference","type":"topic","identifier":"