{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginfeatureflagsreference"]}],"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" is a domain plugin that owns a "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":" slice, fetches a JSON wire format via a provider-agnostic "},{"code":"FeatureFlagsService","type":"codeVoice"},{"type":"text","text":", and answers reads against state. Bucketing is pure FNV-1a so reads are synchronous and offline-capable."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three flag types from one wire format:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"boolean"}]},{"type":"text","text":" — on\/off with rollout percentage (0–100)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"variant"}],"type":"strong"},{"type":"text","text":" — string-typed weighted variants for A\/B tests."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"value"}]},{"type":"text","text":" — typed remote-tunable scalar ("},{"type":"codeVoice","code":"Bool"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"String"},{"type":"text","text":")."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Library target","anchor":"Library-target","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Product: ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxFeatureFlags"}],"type":"paragraph"}]}]},{"type":"heading","text":"Wire format","anchor":"Wire-format","level":2},{"code":["{","  \"version\": 1,","  \"flags\": {","    \"new_onboarding\": { \"type\": \"boolean\", \"rollout\": 25 },","    \"checkout_layout\": {","      \"type\": \"variant\",","      \"variants\": [","        { \"value\": \"control\", \"weight\": 50 },","        { \"value\": \"treatment\", \"weight\": 50 }","      ]","    },","    \"max_free_uploads\": { \"type\": \"value\", \"value\": 5 }","  }","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin rejects unknown "},{"type":"codeVoice","code":"version"},{"type":"text","text":" values and falls back to the last-known-good cache. Defaults always live in Swift at the call site — this keeps them type-checked and forces “what if missing?” thinking."}]},{"type":"heading","text":"Bucketing and identity","level":2,"anchor":"Bucketing-and-identity"},{"inlineContent":[{"type":"codeVoice","code":"bucket = FNV1a(bucketingID + \":\" + flagKey) % 100"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Stable per ","type":"text"},{"code":"(bucketingID, flagKey)","type":"codeVoice"},{"text":" pair forever.","type":"text"}],"type":"strong"},{"type":"text","text":" Same input always produces the same bucket."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Per-flag."}],"type":"strong"},{"text":" A user isn’t always in the “early” group across different flags.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Identity resolution."}],"type":"strong"},{"type":"text","text":" When a "},{"type":"codeVoice","code":"userIDKeyPath"},{"type":"text","text":" is configured "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" the current user ID is non-nil, that is used. Otherwise the "},{"type":"strong","inlineContent":[{"type":"text","text":"device ID"}]},{"type":"text","text":" is used (the plugin’s required "},{"type":"codeVoice","code":"deviceIDKeyPath"},{"type":"text","text":"). Anonymous users get a stable per-install identity; logged-in users get stable cross-device assignment. A user’s variant "},{"type":"emphasis","inlineContent":[{"type":"text","text":"can"}]},{"type":"text","text":" shift once at login — acceptable for nearly all real use cases."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"FNV-1a was chosen because it’s simple, dependency-free, and matches GrowthBook’s algorithm so apps migrating from GrowthBook get compatible buckets."}],"type":"paragraph"},{"type":"heading","text":"The device ID must be stable across reinstall","anchor":"The-device-ID-must-be-stable-across-reinstall","level":3},{"inlineContent":[{"type":"text","text":"Bucketing is only stable if the fallback identity is. The plugin takes a non-optional "},{"code":"deviceIDKeyPath: KeyPath<State, String>","type":"codeVoice"},{"type":"text","text":" into your "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", so the "},{"inlineContent":[{"type":"text","text":"app"}],"type":"emphasis"},{"text":" owns the identity and the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"same","type":"text"}]},{"type":"text","text":" value can drive analytics ("},{"type":"codeVoice","code":"AnalyticsIdentity(userID: \\.deviceID, …)"},{"text":") — one identity, so A\/B exposure correlates with the user analytics reports against.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mint it once at launch with the shared core helper, backed by the Keychain so it survives reinstall, and seed it into the slice via "},{"type":"codeVoice","code":"hydrated(from:deviceID:)"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ In Store.configured()","let deviceID = KeychainKeyValueStore(service: \"com.example.app\").deviceIdentity()","","let plugin = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags, action: AppAction.featureFlags, extractAction: { … },","    service: service,","    deviceIDKeyPath: \\.deviceID,          \/\/ app-owned, Keychain-backed","    userIDKeyPath: \\.auth.currentUserID,  \/\/ optional; authed identity wins when set","    keyValueStore: kv",")","","let initial = AppState(","    featureFlags: .hydrated(from: kv, deviceID: deviceID),","    deviceID: deviceID",")"]},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"UserDefaults"},{"text":"-backed identity regenerates on reinstall (QA ad-hoc builds, test installs), which silently re-buckets users and breaks A\/B assignment — use ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" for the identity. The flags ","type":"text"},{"inlineContent":[{"type":"text","text":"config cache"}],"type":"emphasis"},{"type":"text","text":" can still live in a lighter store."}],"type":"paragraph"},{"type":"heading","text":"Evaluation order","level":2,"anchor":"Evaluation-order"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For each read, in priority:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Local override present?"}],"type":"strong"},{"type":"text","text":" Return it."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Flag in remote config?","type":"text"}]},{"text":" Evaluate (rollout \/ variant assignment \/ value lookup).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Otherwise"}],"type":"strong"},{"type":"text","text":" return the Swift-side default."}],"type":"paragraph"}]}]},{"type":"heading","text":"Persistence","level":2,"anchor":"Persistence"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Device ID"}],"type":"strong"},{"type":"text","text":" is app-owned and minted once via "},{"type":"codeVoice","code":"KeyValueStore.deviceIdentity()"},{"type":"text","text":" (Keychain-backed). Seeded into the slice at "},{"code":"FeatureFlagsState.hydrated(from:deviceID:)","type":"codeVoice"},{"type":"text","text":" and kept in sync from "},{"code":"deviceIDKeyPath","type":"codeVoice"},{"type":"text","text":". The plugin no longer mints its own bucketing identity."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Last-known config"}],"type":"strong"},{"type":"text","text":" persisted after every successful refresh. Hydrates as fallback before first network success."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Local overrides"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" persisted by default. Restart = clean state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"exposedKeys"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" persisted. New session = fresh exposure events."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Governance: no forever flags","anchor":"Governance-no-forever-flags"},{"inlineContent":[{"type":"text","text":"Owner and expiry are "},{"type":"strong","inlineContent":[{"type":"text","text":"required"}]},{"type":"text","text":" metadata for every flag, enforced by a single unit test rather than the wire format (the JSON stays dumb and fail-open). Declare a manifest with the type-erasing factories — "},{"type":"codeVoice","code":"owner"},{"type":"text","text":" and "},{"type":"codeVoice","code":"expires"},{"type":"text","text":" are non-optional, so a flag can’t be registered without them — and the keys are single-sourced from the typed flag declarations:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["enum FlagManifest {","    static let all: [FlagDescriptor] = [","        .bool(.newOnboarding, owner: \"growth\",","              expires: Date(timeIntervalSince1970: 1_788_000_000), purpose: \"New onboarding flow\"),","        .variant(.checkoutLayout, owner: \"checkout\",","                 expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Checkout A\/B\"),","    ]","}","","@Test func noForeverFlags() {","    let report = FlagGovernance.expirationReport(FlagManifest.all)","    #expect(report == nil, \"\\(report ?? \"\")\")   \/\/ failure names each expired flag + owner","}"]},{"inlineContent":[{"type":"text","text":"When a flag passes its expiry, the test fails and the report names the flag, its owner, and how long it’s been expired — so a stale flag gets retired instead of living forever. This has no effect on runtime evaluation."}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The manifest is the single declaration site, so a typed flag key never added to it escapes governance. Closing that gap fully would need a macro; until then, convention plus code review covers it."}]}],"type":"aside","style":"note"},{"anchor":"Exposure-tracking","type":"heading","level":2,"text":"Exposure tracking"},{"type":"paragraph","inlineContent":[{"text":"A\/B testing is only analytically valid if you know which users actually saw each variant — bucketing alone is insufficient because the code path branching on the flag might never execute.","type":"text"}]},{"code":["store.send(.featureFlags(.recordExposure(key: \"checkout_layout\")))"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or via the SwiftUI sugar:"}]},{"code":["WizardView()","    .recordsExposure(of: .checkoutLayout, store: store, action: AppAction.featureFlags)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin dedupes per session and fires the optional "},{"code":"onExposure","type":"codeVoice"},{"type":"text","text":" callback (passed at plugin init). Wire that callback to your analytics plugin to forward exposures as events."}]},{"anchor":"Refresh-policy","type":"heading","level":2,"text":"Refresh policy"},{"code":["public enum RefreshPolicy: Sendable {","    case manual                                      \/\/ every .refresh fetches","    case automatic(minInterval: TimeInterval)        \/\/ debounce; default 300s","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apps dispatch "},{"code":".refresh","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"App.scenePhase","type":"codeVoice"},{"type":"text","text":" transitions; the plugin’s debouncing makes this safe to call frequently. The plugin does not subscribe to "},{"code":"UIApplication","type":"codeVoice"},{"type":"text","text":" notifications — wiring stays in the host app."}]},{"type":"heading","anchor":"Service-protocol","level":2,"text":"Service protocol"},{"code":["public protocol FeatureFlagsService: Sendable {","    func fetch() async throws -> FeatureFlagsConfig","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"One method. Caching, hydration, evaluation all live in the plugin.","type":"text"}]},{"anchor":"Built-in-HTTPFeatureFlagsService","type":"heading","level":3,"text":"Built-in: `HTTPFeatureFlagsService`"},{"inlineContent":[{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" + "},{"type":"codeVoice","code":"JSONDecoder"},{"type":"text","text":". Apps host their JSON anywhere — static file on a CDN, Cloudflare Worker, their own server. Zero backend infrastructure required. "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"type":"text","text":" is a runnable shared Worker serving flags + killswitch for a whole portfolio from one URL ("},{"type":"codeVoice","code":"GET \/<appID>\/flags"},{"type":"text","text":")."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The URL must be "},{"inlineContent":[{"type":"text","text":"HTTPS"}],"type":"strong"},{"type":"text","text":" ("},{"type":"codeVoice","code":"http"},{"type":"text","text":" is allowed only for "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":" development servers; anything else is a precondition failure at init). Responses over 1 MB and non-2xx statuses throw, and malformed variant definitions (empty array, negative weights, weights not summing to 100) fail decoding — in every case the plugin keeps its last-known-good cached config."}]},{"type":"paragraph","inlineContent":[{"text":"Third-party adapters (LaunchDarkly, GrowthBook, Statsig) conform to the same protocol without changing the plugin.","type":"text"}]},{"anchor":"Typed-flag-keys","type":"heading","level":2,"text":"Typed flag keys"},{"type":"codeListing","syntax":"swift","code":["public struct BoolFlag: Sendable, Hashable","public struct VariantFlag<Variant: RawRepresentable & Sendable> where Variant.RawValue == String","public struct ValueFlag<Value: Sendable>"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read API on "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["state.isEnabled(.newOnboarding, default: false)","state.variant(of: .checkoutLayout)","state.value(of: .maxFreeUploads)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reads are pure synchronous functions. Per-property observation works as it does for any other state slice — views re-render only when the flag they read changes."}]},{"type":"heading","level":2,"text":"Action semantics (selected)","anchor":"Action-semantics-selected"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"refreshSucceeded(FeatureFlagsConfig, fetchedAt:)"},{"type":"text","text":" is dispatched on every "},{"type":"codeVoice","code":".refresh"},{"type":"text","text":" (including debounced refreshes that return an unchanged config). Consume config transitions by observing "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","type":"reference","isActive":true},{"type":"text","text":"."}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},"seeAlsoSections":[{"generated":true,"title":"Reference","anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"]}],"metadata":{"modules":[{"name":"Swidux"}],"title":"SwiduxFeatureFlags Reference","role":"article","roleHeading":"Article"},"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"references":{"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","kind":"symbol","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"title":"Swidux","role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux","type":"topic"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"role":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","kind":"article","title":"EntityStore","url":"\/documentation\/swidux\/entitystoreguide","type":"topic"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"url":"\/documentation\/swidux\/undoplugin","kind":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"title":"UndoPlugin","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"topic"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"role":"article","abstract":[{"type":"text","text":"Public API surface for the "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","kind":"article","title":"SwiduxKillswitch Reference","url":"\/documentation\/swidux\/pluginkillswitchreference","type":"topic"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"role":"collectionGroup","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","kind":"article","title":"KeyValueStore","url":"\/documentation\/swidux\/keyvaluestoreguide","type":"topic"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"role":"article","abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","kind":"article","title":"Troubleshooting","url":"\/documentation\/swidux\/troubleshooting","type":"topic"},"doc://Swidux/documentation/Swidux/MacrosReference":{"role":"article","abstract":[{"type":"text","text":"Reference for "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" and "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":")."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","kind":"article","title":"Macros","url":"\/documentation\/swidux\/macrosreference","type":"topic"},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"type":"topic","title":"Service-Result Actions and Transition Observation","url":"\/documentation\/swidux\/pluginarchitecture#Service-Result-Actions-and-Transition-Observation","abstract":[],"kind":"section","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation"},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","kind":"article","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","type":"topic"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"role":"article","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","kind":"article","title":"SwiduxPaywall Reference","url":"\/documentation\/swidux\/pluginpaywallreference","type":"topic"},"doc://Swidux/documentation/Swidux/UndoRedo":{"role":"article","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":"."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","kind":"article","title":"Undo \/ Redo","url":"\/documentation\/swidux\/undoredo","type":"topic"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"url":"\/documentation\/swidux\/pluginanalyticsreference","kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"title":"SwiduxAnalytics Reference","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","type":"topic"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"role":"article","abstract":[{"type":"text","text":"API surface for the "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","kind":"article","title":"SwiduxParentalGate Reference","url":"\/documentation\/swidux\/pluginparentalgatereference","type":"topic"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"role":"article","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","kind":"article","title":"Persistence Middleware","url":"\/documentation\/swidux\/persistencemiddlewareguide","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"title":"Add Feature Flags","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"topic"}}}