{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginfeatureflagsreference"]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"anchor":"Reference","title":"Reference"}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Swidux"}],"title":"SwiduxFeatureFlags Reference"},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" is a domain plugin that owns a "},{"code":"FeatureFlagsState","type":"codeVoice"},{"type":"text","text":" slice, fetches a JSON wire format via a provider-agnostic "},{"code":"FeatureFlagsService","type":"codeVoice"},{"type":"text","text":", and answers reads against state. Bucketing is pure FNV-1a so reads are synchronous and offline-capable."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Three flag types from one wire format:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"boolean"}]},{"type":"text","text":" — on\/off with rollout percentage (0–100)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"variant"}]},{"type":"text","text":" — string-typed weighted variants for A\/B tests."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"value"}]},{"type":"text","text":" — typed remote-tunable scalar ("},{"code":"Bool","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"String","type":"codeVoice"},{"type":"text","text":")."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Library-target","text":"Library target","level":2,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product: "},{"code":"SwiduxFeatureFlags","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import: "},{"code":"import SwiduxFeatureFlags","type":"codeVoice"}]}]}],"type":"unorderedList"},{"anchor":"Wire-format","text":"Wire format","level":2,"type":"heading"},{"syntax":"json","code":["{","  \"version\": 1,","  \"flags\": {","    \"new_onboarding\": { \"type\": \"boolean\", \"rollout\": 25 },","    \"checkout_layout\": {","      \"type\": \"variant\",","      \"variants\": [","        { \"value\": \"control\", \"weight\": 50 },","        { \"value\": \"treatment\", \"weight\": 50 }","      ]","    },","    \"max_free_uploads\": { \"type\": \"value\", \"value\": 5 }","  }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The plugin rejects unknown "},{"code":"version","type":"codeVoice"},{"type":"text","text":" values and falls back to the last-known-good cache. Defaults always live in Swift at the call site — this keeps them type-checked and forces “what if missing?” thinking."}],"type":"paragraph"},{"anchor":"Bucketing-and-identity","text":"Bucketing and identity","level":2,"type":"heading"},{"inlineContent":[{"code":"bucket = FNV1a(bucketingID + \":\" + flagKey) % 100","type":"codeVoice"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Stable per "},{"type":"codeVoice","code":"(bucketingID, flagKey)"},{"type":"text","text":" pair forever."}]},{"type":"text","text":" Same input always produces the same bucket."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Per-flag."}]},{"type":"text","text":" A user isn’t always in the “early” group across different flags."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Identity resolution.","type":"text"}]},{"type":"text","text":" When a "},{"code":"userIDKeyPath","type":"codeVoice"},{"type":"text","text":" is configured "},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" the current user ID is non-nil, that is used. Otherwise the ","type":"text"},{"inlineContent":[{"type":"text","text":"device ID"}],"type":"strong"},{"text":" is used (the plugin’s required ","type":"text"},{"code":"deviceIDKeyPath","type":"codeVoice"},{"text":"). Anonymous users get a stable per-install identity; logged-in users get stable cross-device assignment. A user’s variant ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"can","type":"text"}]},{"type":"text","text":" shift once at login — acceptable for nearly all real use cases."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"FNV-1a was chosen because it’s simple, dependency-free, and matches GrowthBook’s algorithm so apps migrating from GrowthBook get compatible buckets."}],"type":"paragraph"},{"level":3,"type":"heading","text":"The device ID must be stable across reinstall","anchor":"The-device-ID-must-be-stable-across-reinstall"},{"inlineContent":[{"type":"text","text":"Bucketing is only stable if the fallback identity is. The plugin takes a non-optional "},{"code":"deviceIDKeyPath: KeyPath<State, String>","type":"codeVoice"},{"type":"text","text":" into your "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", so the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"app"}]},{"type":"text","text":" owns the identity and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"type":"text","text":" value can drive analytics ("},{"code":"AnalyticsIdentity(userID: \\.deviceID, …)","type":"codeVoice"},{"type":"text","text":") — one identity, so A\/B exposure correlates with the user analytics reports against."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Mint it once at launch with the shared core helper, backed by the Keychain so it survives reinstall, and seed it into the slice via ","type":"text"},{"code":"hydrated(from:deviceID:)","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["\/\/ In Store.configured()","let deviceID = KeychainKeyValueStore(service: \"com.example.app\").deviceIdentity()","","let plugin = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags, action: AppAction.featureFlags, extractAction: { … },","    service: service,","    deviceIDKeyPath: \\.deviceID,          \/\/ app-owned, Keychain-backed","    userIDKeyPath: \\.auth.currentUserID,  \/\/ optional; authed identity wins when set","    keyValueStore: kv",")","","let initial = AppState(","    featureFlags: .hydrated(from: kv, deviceID: deviceID),","    deviceID: deviceID",")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":"-backed identity regenerates on reinstall (QA ad-hoc builds, test installs), which silently re-buckets users and breaks A\/B assignment — use "},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" for the identity. The flags "},{"inlineContent":[{"type":"text","text":"config cache"}],"type":"emphasis"},{"type":"text","text":" can still live in a lighter store."}]},{"level":2,"type":"heading","text":"Evaluation order","anchor":"Evaluation-order"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For each read, in priority:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Local override present?"}]},{"text":" Return it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Flag in remote config?"}]},{"type":"text","text":" Evaluate (rollout \/ variant assignment \/ value lookup)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Otherwise","type":"text"}]},{"type":"text","text":" return the Swift-side default."}]}]}]},{"level":2,"type":"heading","text":"Persistence","anchor":"Persistence"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Device ID","type":"text"}]},{"type":"text","text":" is app-owned and minted once via "},{"type":"codeVoice","code":"KeyValueStore.deviceIdentity()"},{"type":"text","text":" (Keychain-backed). Seeded into the slice at "},{"type":"codeVoice","code":"FeatureFlagsState.hydrated(from:deviceID:)"},{"type":"text","text":" and kept in sync from "},{"type":"codeVoice","code":"deviceIDKeyPath"},{"type":"text","text":". The plugin no longer mints its own bucketing identity."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Last-known config","type":"text"}]},{"type":"text","text":" persisted after every successful refresh. Hydrates as fallback before first network success."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Local overrides","type":"text"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" persisted by default. Restart = clean state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"exposedKeys"}],"type":"strong"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" persisted. New session = fresh exposure events."}]}]}]},{"text":"Governance: no forever flags","anchor":"Governance-no-forever-flags","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Owner and expiry are "},{"type":"strong","inlineContent":[{"type":"text","text":"required"}]},{"type":"text","text":" metadata for every flag, enforced by a single unit test rather than the wire format (the JSON stays dumb and fail-open). Declare a manifest with the type-erasing factories — "},{"code":"owner","type":"codeVoice"},{"type":"text","text":" and "},{"code":"expires","type":"codeVoice"},{"type":"text","text":" are non-optional, so a flag can’t be registered without them — and the keys are single-sourced from the typed flag declarations:"}],"type":"paragraph"},{"code":["enum FlagManifest {","    static let all: [FlagDescriptor] = [","        .bool(.newOnboarding, owner: \"growth\",","              expires: Date(timeIntervalSince1970: 1_788_000_000), purpose: \"New onboarding flow\"),","        .variant(.checkoutLayout, owner: \"checkout\",","                 expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Checkout A\/B\"),","    ]","}","","@Test func noForeverFlags() {","    let report = FlagGovernance.expirationReport(FlagManifest.all)","    #expect(report == nil, \"\\(report ?? \"\")\")   \/\/ failure names each expired flag + owner","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a flag passes its expiry, the test fails and the report names the flag, its owner, and how long it’s been expired — so a stale flag gets retired instead of living forever. This has no effect on runtime evaluation."}]},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"The manifest is the single declaration site, so a typed flag key never added to it escapes governance. Closing that gap fully would need a macro; until then, convention plus code review covers it."}],"type":"paragraph"}],"type":"aside","style":"note"},{"level":2,"anchor":"Exposure-tracking","type":"heading","text":"Exposure tracking"},{"inlineContent":[{"type":"text","text":"A\/B testing is only analytically valid if you know which users actually saw each variant — bucketing alone is insufficient because the code path branching on the flag might never execute."}],"type":"paragraph"},{"code":["store.send(.featureFlags(.recordExposure(key: \"checkout_layout\")))"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Or via the SwiftUI sugar:"}],"type":"paragraph"},{"code":["WizardView()","    .recordsExposure(of: .checkoutLayout, store: store, action: AppAction.featureFlags)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The plugin dedupes per session and fires the optional "},{"type":"codeVoice","code":"onExposure"},{"type":"text","text":" callback (passed at plugin init). Wire that callback to your analytics plugin to forward exposures as events."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Refresh policy","anchor":"Refresh-policy"},{"type":"codeListing","code":["public enum RefreshPolicy: Sendable {","    case manual                                      \/\/ every .refresh fetches","    case automatic(minInterval: TimeInterval)        \/\/ debounce; default 300s","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apps dispatch "},{"code":".refresh","type":"codeVoice"},{"type":"text","text":" from "},{"code":"App.scenePhase","type":"codeVoice"},{"type":"text","text":" transitions; the plugin’s debouncing makes this safe to call frequently. The plugin does not subscribe to "},{"code":"UIApplication","type":"codeVoice"},{"type":"text","text":" notifications — wiring stays in the host app."}]},{"type":"heading","level":2,"text":"Service protocol","anchor":"Service-protocol"},{"type":"codeListing","code":["public protocol FeatureFlagsService: Sendable {","    func fetch() async throws -> FeatureFlagsConfig","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"One method. Caching, hydration, evaluation all live in the plugin."}]},{"type":"heading","level":3,"text":"Built-in: `HTTPFeatureFlagsService`","anchor":"Built-in-HTTPFeatureFlagsService"},{"type":"paragraph","inlineContent":[{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" + "},{"type":"codeVoice","code":"JSONDecoder"},{"type":"text","text":". Apps host their JSON anywhere — static file on a CDN, Cloudflare Worker, their own server. Zero backend infrastructure required. "},{"code":"Examples\/ConfigWorker\/","type":"codeVoice"},{"type":"text","text":" is a runnable shared Worker serving flags + killswitch for a whole portfolio from one URL ("},{"code":"GET \/<appID>\/flags","type":"codeVoice"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The URL must be "},{"inlineContent":[{"type":"text","text":"HTTPS"}],"type":"strong"},{"type":"text","text":" ("},{"code":"http","type":"codeVoice"},{"type":"text","text":" is allowed only for "},{"code":"localhost","type":"codeVoice"},{"type":"text","text":" development servers; anything else is a precondition failure at init). Responses over 1 MB and non-2xx statuses throw, and malformed variant definitions (empty array, negative weights, weights not summing to 100) fail decoding — in every case the plugin keeps its last-known-good cached config."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Third-party adapters (LaunchDarkly, GrowthBook, Statsig) conform to the same protocol without changing the plugin."}]},{"type":"heading","level":2,"text":"Typed flag keys","anchor":"Typed-flag-keys"},{"type":"codeListing","code":["public struct BoolFlag: Sendable, Hashable","public struct VariantFlag<Variant: RawRepresentable & Sendable> where Variant.RawValue == String","public struct ValueFlag<Value: Sendable>"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read API on "},{"code":"FeatureFlagsState","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["state.isEnabled(.newOnboarding, default: false)","state.variant(of: .checkoutLayout)","state.value(of: .maxFreeUploads)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reads are pure synchronous functions. Per-property observation works as it does for any other state slice — views re-render only when the flag they read changes."}]},{"text":"Action semantics (selected)","anchor":"Action-semantics-selected","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"refreshSucceeded(FeatureFlagsConfig, fetchedAt:)","type":"codeVoice"},{"type":"text","text":" is dispatched on every "},{"code":".refresh","type":"codeVoice"},{"type":"text","text":" (including debounced refreshes that return an unchanged config). Consume config transitions by observing "},{"code":"FeatureFlagsState","type":"codeVoice"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation"},{"type":"text","text":"."}]}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/UndoRedo":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"topic","kind":"article","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":".","type":"text"}],"role":"article","url":"\/documentation\/swidux\/undoredo","title":"Undo \/ Redo"},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"title":"Service-Result Actions and Transition Observation","abstract":[],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","url":"\/documentation\/swidux\/pluginarchitecture#Service-Result-Actions-and-Transition-Observation","kind":"section"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","type":"topic","kind":"article","abstract":[{"type":"text","text":"API surface for the "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"role":"article","url":"\/documentation\/swidux\/pluginparentalgatereference","title":"SwiduxParentalGate Reference"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"topic","kind":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"role":"article","url":"\/documentation\/swidux\/entitystoreguide","title":"EntityStore"},"doc://Swidux/documentation/Swidux/GettingStarted":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","kind":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"role":"article","url":"\/documentation\/swidux\/gettingstarted","title":"Getting Started with Swidux"},"doc://Swidux/documentation/Swidux/MacrosReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","type":"topic","kind":"article","abstract":[{"type":"text","text":"Reference for "},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":")."}],"role":"article","url":"\/documentation\/swidux\/macrosreference","title":"Macros"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","type":"topic","kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"role":"article","url":"\/documentation\/swidux\/pluginanalyticsreference","title":"SwiduxAnalytics Reference"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","kind":"symbol","title":"Swidux"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"topic","kind":"article","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"role":"article","url":"\/documentation\/swidux\/persistencemiddlewareguide","title":"Persistence Middleware"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"topic","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"role":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","title":"Add Feature Flags"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","type":"topic","kind":"article","abstract":[{"text":"Public API surface for the ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"role":"article","url":"\/documentation\/swidux\/pluginkillswitchreference","title":"SwiduxKillswitch Reference"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"role":"article","url":"\/documentation\/swidux\/pluginpaywallreference","title":"SwiduxPaywall Reference"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"title":"KeyValueStore","kind":"article","url":"\/documentation\/swidux\/keyvaluestoreguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"type":"topic","role":"collectionGroup"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"url":"\/documentation\/swidux\/undoplugin","title":"UndoPlugin"}}}