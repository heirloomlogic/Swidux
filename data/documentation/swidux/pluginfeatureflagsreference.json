nKillswitchReference","url":"\/documentation\/swidux\/pluginkillswitchreference","abstract":[{"text":"Public API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"title":"SwiduxKillswitch Reference","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","url":"\/documentation\/swidux\/pluginanalyticsreference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"title":"SwiduxAnalytics Reference","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","role":"collection","type":"topic","kind":"symbol"},"doc://Swidux/documentation/Swidux/MacrosReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","url":"\/documentation\/swidux\/macrosreference","abstract":[{"text":"Reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" and its property markers (the SwiftData persistence bridge, shipped in ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text"