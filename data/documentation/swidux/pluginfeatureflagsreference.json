{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},"abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"seeAlsoSections":[{"title":"Reference","anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"role":"article","modules":[{"name":"Swidux"}],"title":"SwiduxFeatureFlags Reference","roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" is a domain plugin that owns a ","type":"text"},{"code":"FeatureFlagsState","type":"codeVoice"},{"text":" slice, fetches a JSON wire format via a provider-agnostic ","type":"text"},{"code":"FeatureFlagsService","type":"codeVoice"},{"text":", and answers reads against state. Bucketing is pure FNV-1a so reads are synchronous and offline-capable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Three flag types from one wire format:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"boolean","type":"text"}],"type":"strong"},{"text":" — on\/off with rollout percentage (0–100).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"variant","type":"text"}],"type":"strong"},{"text":" — string-typed weighted variants for A\/B tests.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"value","type":"text"}],"type":"strong"},{"text":" — typed remote-tunable scalar (","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"String","type":"codeVoice"},{"text":").","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Library-target","level":2,"type":"heading","text":"Library target"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxFeatureFlags","type":"codeVoice"}]}]}],"type":"unorderedList"},{"anchor":"Wire-format","level":2,"type":"heading","text":"Wire format"},{"syntax":"json","type":"codeListing","code":["{","  \"version\": 1,","  \"flags\": {","    \"new_onboarding\": { \"type\": \"boolean\", \"rollout\": 25 },","    \"checkout_layout\": {","      \"type\": \"variant\",","      \"variants\": [","        { \"value\": \"control\", \"weight\": 50 },","        { \"value\": \"treatment\", \"weight\": 50 }","      ]","    },","    \"max_free_uploads\": { \"type\": \"value\", \"value\": 5 }","  }","}"]},{"inlineContent":[{"text":"The plugin rejects unknown ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" values and falls back to the last-known-good cache. Defaults always live in Swift at the call site — this keeps them type-checked and forces “what if missing?” thinking.","type":"text"}],"type":"paragraph"},{"anchor":"Bucketing-and-identity","level":2,"type":"heading","text":"Bucketing and identity"},{"inlineContent":[{"code":"bucket = FNV1a(bucketingID + \":\" + flagKey) % 100","type":"codeVoice"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Stable per ","type":"text"},{"type":"codeVoice","code":"(bucketingID, flagKey)"},{"text":" pair forever.","type":"text"}],"type":"strong"},{"text":" Same input always produces the same bucket.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Per-flag.","type":"text"}],"type":"strong"},{"text":" A user isn’t always in the “early” group across different flags.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Identity resolution.","type":"text"}],"type":"strong"},{"text":" When a ","type":"text"},{"code":"userIDKeyPath","type":"codeVoice"},{"text":" is configured ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" the current user ID is non-nil, that is used. Otherwise the install ID is used. Anonymous users get a stable per-install identity; logged-in users get stable cross-device assignment. A user’s variant ","type":"text"},{"inlineContent":[{"text":"can","type":"text"}],"type":"emphasis"},{"text":" shift once at login — acceptable for nearly all real use cases.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"FNV-1a was chosen because it’s simple, dependency-free, and matches GrowthBook’s algorithm so apps migrating from GrowthBook get compatible buckets.","type":"text"}],"type":"paragraph"},{"anchor":"Evaluation-order","level":2,"type":"heading","text":"Evaluation order"},{"inlineContent":[{"text":"For each read, in priority:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Local override present?","type":"text"}],"type":"strong"},{"text":" Return it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Flag in remote config?","type":"text"}],"type":"strong"},{"text":" Evaluate (rollout \/ variant assignment \/ value lookup).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Otherwise","type":"text"}],"type":"strong"},{"text":" return the Swift-side default.","type":"text"}]}]}],"type":"orderedList"},{"anchor":"Persistence","level":2,"type":"heading","text":"Persistence"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Install ID","type":"text"}],"type":"strong"},{"text":" persisted to ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":" on first generation. Read at hydration via ","type":"text"},{"code":"FeatureFlagsState.hydrated(from:defaultConfig:)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Last-known config","type":"text"}],"type":"strong"},{"text":" persisted after every successful refresh. Hydrates as fallback before first network success.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Local overrides","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" persisted by default. Restart = clean state.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"exposedKeys"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" persisted. New session = fresh exposure events.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Exposure-tracking","level":2,"type":"heading","text":"Exposure tracking"},{"inlineContent":[{"text":"A\/B testing is only analytically valid if you know which users actually saw each variant — bucketing alone is insufficient because the code path branching on the flag might never execute.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["store.send(.featureFlags(.recordExposure(key: \"checkout_layout\")))"]},{"inlineContent":[{"text":"Or via the SwiftUI sugar:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["WizardView()","    .recordsExposure(of: .checkoutLayout, store: store, action: AppAction.featureFlags)"]},{"inlineContent":[{"text":"The plugin dedupes per session and fires the optional ","type":"text"},{"code":"onExposure","type":"codeVoice"},{"text":" callback (passed at plugin init). Wire that callback to your analytics plugin to forward exposures as events.","type":"text"}],"type":"paragraph"},{"anchor":"Refresh-policy","level":2,"type":"heading","text":"Refresh policy"},{"syntax":"swift","type":"codeListing","code":["public enum RefreshPolicy: Sendable {","    case manual                                      \/\/ every .refresh fetches","    case automatic(minInterval: TimeInterval)        \/\/ debounce; default 300s","}"]},{"inlineContent":[{"text":"Apps dispatch ","type":"text"},{"code":".refresh","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"App.scenePhase","type":"codeVoice"},{"text":" transitions; the plugin’s debouncing makes this safe to call frequently. The plugin does not subscribe to ","type":"text"},{"code":"UIApplication","type":"codeVoice"},{"text":" notifications — wiring stays in the host app.","type":"text"}],"type":"paragraph"},{"anchor":"Service-protocol","level":2,"type":"heading","text":"Service protocol"},{"syntax":"swift","type":"codeListing","code":["public protocol FeatureFlagsService: Sendable {","    func fetch() async throws -> FeatureFlagsConfig","}"]},{"inlineContent":[{"text":"One method. Caching, hydration, evaluation all live in the plugin.","type":"text"}],"type":"paragraph"},{"anchor":"Built-in-HTTPFeatureFlagsService","level":3,"type":"heading","text":"Built-in: `HTTPFeatureFlagsService`"},{"inlineContent":[{"code":"URLSession","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"JSONDecoder","type":"codeVoice"},{"text":". Apps host their JSON anywhere — static file on a CDN, Cloudflare Worker, their own server. Zero backend infrastructure required. ","type":"text"},{"code":"Examples\/ConfigWorker\/","type":"codeVoice"},{"text":" is a runnable shared Worker serving flags + killswitch for a whole portfolio from one URL (","type":"text"},{"code":"GET \/<appID>\/flags","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The URL must be ","type":"text"},{"inlineContent":[{"type":"text","text":"HTTPS"}],"type":"strong"},{"text":" (","type":"text"},{"code":"http","type":"codeVoice"},{"text":" is allowed only for ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":" development servers; anything else is a precondition failure at init). Responses over 1 MB and non-2xx statuses throw, and malformed variant definitions (empty array, negative weights, weights not summing to 100) fail decoding — in every case the plugin keeps its last-known-good cached config.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Third-party adapters (LaunchDarkly, GrowthBook, Statsig) conform to the same protocol without changing the plugin.","type":"text"}],"type":"paragraph"},{"anchor":"Typed-flag-keys","level":2,"type":"heading","text":"Typed flag keys"},{"syntax":"swift","type":"codeListing","code":["public struct BoolFlag: Sendable, Hashable","public struct VariantFlag<Variant: RawRepresentable & Sendable> where Variant.RawValue == String","public struct ValueFlag<Value: Sendable>"]},{"inlineContent":[{"text":"Read API on ","type":"text"},{"code":"FeatureFlagsState","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["state.isEnabled(.newOnboarding, default: false)","state.variant(of: .checkoutLayout)","state.value(of: .maxFreeUploads)"]},{"inlineContent":[{"text":"Reads are pure synchronous functions. Per-property observation works as it does for any other state slice — views re-render only when the flag they read changes.","type":"text"}],"type":"paragraph"},{"anchor":"Action-semantics-selected","level":2,"type":"heading","text":"Action semantics (selected)"},{"inlineContent":[{"code":"refreshSucceeded(FeatureFlagsConfig, fetchedAt:)","type":"codeVoice"},{"text":" is dispatched on every ","type":"text"},{"code":".refresh","type":"codeVoice"},{"text":" (including debounced refreshes that return an unchanged config). Consume config transitions by observing ","type":"text"},{"code":"FeatureFlagsState","type":"codeVoice"},{"text":" or a value derived from it — not by mapping this action. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginfeatureflagsreference"]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"url":"\/documentation\/swidux\/howtoaddfeatureflags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single