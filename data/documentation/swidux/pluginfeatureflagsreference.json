{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference","title":"Reference","generated":true}],"variants":[{"paths":["\/documentation\/swidux\/pluginfeatureflagsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" is a domain plugin that owns a "},{"type":"codeVoice","code":"FeatureFlagsState"},{"text":" slice, fetches a JSON wire format via a provider-agnostic ","type":"text"},{"code":"FeatureFlagsService","type":"codeVoice"},{"text":", and answers reads against state. Bucketing is pure FNV-1a so reads are synchronous and offline-capable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three flag types from one wire format:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"boolean","type":"text"}]},{"text":" — on\/off with rollout percentage (0–100).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"variant"}]},{"type":"text","text":" — string-typed weighted variants for A\/B tests."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"value","type":"text"}]},{"type":"text","text":" — typed remote-tunable scalar ("},{"code":"Bool","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"String"},{"type":"text","text":")."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","isActive":true},{"text":".","type":"text"}]},{"text":"Library target","level":2,"anchor":"Library-target","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"code":"SwiduxFeatureFlags","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxFeatureFlags","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Wire-format","text":"Wire format","level":2},{"type":"codeListing","syntax":"json","code":["{","  \"version\": 1,","  \"flags\": {","    \"new_onboarding\": { \"type\": \"boolean\", \"rollout\": 25 },","    \"checkout_layout\": {","      \"type\": \"variant\",","      \"variants\": [","        { \"value\": \"control\", \"weight\": 50 },","        { \"value\": \"treatment\", \"weight\": 50 }","      ]","    },","    \"max_free_uploads\": { \"type\": \"value\", \"value\": 5 }","  }","}"]},{"type":"paragraph","inlineContent":[{"text":"The plugin rejects unknown ","type":"text"},{"type":"codeVoice","code":"version"},{"text":" values and falls back to the last-known-good cache. Defaults always live in Swift at the call site — this keeps them type-checked and forces “what if missing?” thinking.","type":"text"}]},{"type":"heading","anchor":"Bucketing-and-identity","text":"Bucketing and identity","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"bucket = FNV1a(bucketingID + \":\" + flagKey) % 100"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Stable per "},{"type":"codeVoice","code":"(bucketingID, flagKey)"},{"type":"text","text":" pair forever."}],"type":"strong"},{"text":" Same input always produces the same bucket.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Per-flag."}],"type":"strong"},{"text":" A user isn’t always in the “early” group across different flags.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Identity resolution.","type":"text"}]},{"type":"text","text":" When a "},{"code":"userIDKeyPath","type":"codeVoice"},{"type":"text","text":" is configured "},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"type":"text","text":" the current user ID is non-nil, that is used. Otherwise the "},{"inlineContent":[{"type":"text","text":"device ID"}],"type":"strong"},{"type":"text","text":" is used (the plugin’s required "},{"code":"deviceIDKeyPath","type":"codeVoice"},{"text":"). Anonymous users get a stable per-install identity; logged-in users get stable cross-device assignment. A user’s variant ","type":"text"},{"inlineContent":[{"type":"text","text":"can"}],"type":"emphasis"},{"text":" shift once at login — acceptable for nearly all real use cases.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"FNV-1a was chosen because it’s simple, dependency-free, and matches GrowthBook’s algorithm so apps migrating from GrowthBook get compatible buckets.","type":"text"}]},{"text":"The device ID must be stable across reinstall","type":"heading","level":3,"anchor":"The-device-ID-must-be-stable-across-reinstall"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bucketing is only stable if the fallback identity is. The plugin takes a non-optional "},{"type":"codeVoice","code":"deviceIDKeyPath: KeyPath<State, String>"},{"type":"text","text":" into your "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", so the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"app"}]},{"type":"text","text":" owns the identity and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"type":"text","text":" value can drive analytics ("},{"type":"codeVoice","code":"AnalyticsIdentity(userID: \\.deviceID, …)"},{"type":"text","text":") — one identity, so A\/B exposure correlates with the user analytics reports against."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mint it once at launch with the shared core helper, backed by the Keychain so it survives reinstall, and seed it into the slice via "},{"type":"codeVoice","code":"hydrated(from:deviceID:)"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ In Store.configured()","let deviceID = KeychainKeyValueStore(service: \"com.example.app\").deviceIdentity()","","let plugin = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags, action: AppAction.featureFlags, extractAction: { … },","    service: service,","    deviceIDKeyPath: \\.deviceID,          \/\/ app-owned, Keychain-backed","    userIDKeyPath: \\.auth.currentUserID,  \/\/ optional; authed identity wins when set","    keyValueStore: kv",")","","let initial = AppState(","    featureFlags: .hydrated(from: kv, deviceID: deviceID),","    deviceID: deviceID",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":"-backed identity regenerates on reinstall (QA ad-hoc builds, test installs), which silently re-buckets users and breaks A\/B assignment — use "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" for the identity. The flags "},{"type":"emphasis","inlineContent":[{"type":"text","text":"config cache"}]},{"type":"text","text":" can still live in a lighter store."}]},{"text":"Evaluation order","type":"heading","level":2,"anchor":"Evaluation-order"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For each read, in priority:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Local override present?","type":"text"}]},{"type":"text","text":" Return it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Flag in remote config?","type":"text"}]},{"type":"text","text":" Evaluate (rollout \/ variant assignment \/ value lookup)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Otherwise","type":"text"}]},{"type":"text","text":" return the Swift-side default."}]}]}]},{"text":"Persistence","type":"heading","level":2,"anchor":"Persistence"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Device ID","type":"text"}]},{"type":"text","text":" is app-owned and minted once via "},{"type":"codeVoice","code":"KeyValueStore.deviceIdentity()"},{"type":"text","text":" (Keychain-backed). Seeded into the slice at "},{"type":"codeVoice","code":"FeatureFlagsState.hydrated(from:deviceID:)"},{"type":"text","text":" and kept in sync from "},{"type":"codeVoice","code":"deviceIDKeyPath"},{"type":"text","text":". The plugin no longer mints its own bucketing identity."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Last-known config","type":"text"}]},{"type":"text","text":" persisted after every successful refresh. Hydrates as fallback before first network success."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Local overrides","type":"text"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" persisted by default. Restart = clean state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"exposedKeys","type":"codeVoice"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" persisted. New session = fresh exposure events."}]}]}]},{"text":"Governance: no forever flags","type":"heading","level":2,"anchor":"Governance-no-forever-flags"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Owner and expiry are "},{"type":"strong","inlineContent":[{"type":"text","text":"required"}]},{"type":"text","text":" metadata for every flag, enforced by a single unit test rather than the wire format (the JSON stays dumb and fail-open). Declare a manifest with the type-erasing factories — "},{"type":"codeVoice","code":"owner"},{"type":"text","text":" and "},{"type":"codeVoice","code":"expires"},{"type":"text","text":" are non-optional, so a flag can’t be registered without them — and the keys are single-sourced from the typed flag declarations:"}]},{"type":"codeListing","syntax":"swift","code":["enum FlagManifest {","    static let all: [FlagDescriptor] = [","        .bool(.newOnboarding, owner: \"growth\",","              expires: Date(timeIntervalSince1970: 1_788_000_000), purpose: \"New onboarding flow\"),","        .variant(.checkoutLayout, owner: \"checkout\",","                 expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Checkout A\/B\"),","    ]","}","","@Test func noForeverFlags() {","    let report = FlagGovernance.expirationReport(FlagManifest.all)","    #expect(report == nil, \"\\(report ?? \"\")\")   \/\/ failure names each expired flag + owner","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a flag passes its expiry, the test fails and the report names the flag, its owner, and how long it’s been expired — so a stale flag gets retired instead of living forever. This has no effect on runtime evaluation."}]},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The manifest is the single declaration site, so a typed flag key never added to it escapes governance. Closing that gap fully would need a macro; until then, convention plus code review covers it."}]}]},{"text":"Exposure tracking","type":"heading","level":2,"anchor":"Exposure-tracking"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A\/B testing is only analytically valid if you know which users actually saw each variant — bucketing alone is insufficient because the code path branching on the flag might never execute."}]},{"type":"codeListing","syntax":"swift","code":["store.send(.featureFlags(.recordExposure(key: \"checkout_layout\")))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or via the SwiftUI sugar:"}]},{"type":"codeListing","syntax":"swift","code":["WizardView()","    .recordsExposure(of: .checkoutLayout, store: store, action: AppAction.featureFlags)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin dedupes per session and fires the optional "},{"type":"codeVoice","code":"onExposure"},{"type":"text","text":" callback (passed at plugin init). Wire that callback to your analytics plugin to forward exposures as events."}]},{"text":"Refresh policy","type":"heading","level":2,"anchor":"Refresh-policy"},{"type":"codeListing","syntax":"swift","code":["public enum RefreshPolicy: Sendable {","    case manual                                      \/\/ every .refresh fetches","    case automatic(minInterval: TimeInterval)        \/\/ debounce; default 300s","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apps dispatch "},{"type":"codeVoice","code":".refresh"},{"type":"text","text":" from "},{"type":"codeVoice","code":"App.scenePhase"},{"type":"text","text":" transitions; the plugin’s debouncing makes this safe to call frequently. The plugin does not subscribe to "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" notifications — wiring stays in the host app."}]},{"text":"Service protocol","type":"heading","level":2,"anchor":"Service-protocol"},{"type":"codeListing","syntax":"swift","code":["public protocol FeatureFlagsService: Sendable {","    func fetch() async throws -> FeatureFlagsConfig","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One method. Caching, hydration, evaluation all live in the plugin."}]},{"text":"Built-in: `HTTPFeatureFlagsService`","type":"heading","level":3,"anchor":"Built-in-HTTPFeatureFlagsService"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" + "},{"type":"codeVoice","code":"JSONDecoder"},{"type":"text","text":". Apps host their JSON anywhere — static file on a CDN, Cloudflare Worker, their own server. Zero backend infrastructure required. "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"type":"text","text":" is a runnable shared Worker serving flags + killswitch for a whole portfolio from one URL ("},{"type":"codeVoice","code":"GET \/<appID>\/flags"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The URL must be "},{"type":"strong","inlineContent":[{"type":"text","text":"HTTPS"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"http"},{"type":"text","text":" is allowed only for "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":" development servers; anything else is a precondition failure at init). Responses over 1 MB and non-2xx statuses throw, and malformed variant definitions (empty array, negative weights, weights not summing to 100) fail decoding — in every case the plugin keeps its last-known-good cached config."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Third-party adapters (LaunchDarkly, GrowthBook, Statsig) conform to the same protocol without changing the plugin."}]},{"text":"Typed flag keys","type":"heading","level":2,"anchor":"Typed-flag-keys"},{"type":"codeListing","syntax":"swift","code":["public struct BoolFlag: Sendable, Hashable","public struct VariantFlag<Variant: RawRepresentable & Sendable> where Variant.RawValue == String","public struct ValueFlag<Value: Sendable>"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read API on "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["state.isEnabled(.newOnboarding, default: false)","state.variant(of: .checkoutLayout)","state.value(of: .maxFreeUploads)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reads are pure synchronous functions. Per-property observation works as it does for any other state slice — views re-render only when the flag they read changes."}]},{"text":"Action semantics (selected)","type":"heading","level":2,"anchor":"Action-semantics-selected"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"refreshSucceeded(FeatureFlagsConfig, fetchedAt:)"},{"type":"text","text":" is dispatched on every "},{"type":"codeVoice","code":".refresh"},{"type":"text","text":" (including debounced refreshes that return an unchanged config). Consume config transitions by observing "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation"},{"type":"text","text":"."}]}],"kind":"content"}],"sections":[],"abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"metadata":{"modules":[{"name":"Swidux"}],"title":"SwiduxFeatureFlags Reference","roleHeading":"Article","role":"article"},"references":{"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"title":"Add Feature Flags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"topic","url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"role":"article","kind":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"title":"UndoPlugin","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"UndoPlugin","kind":"identifier"}],"url":"\/documentation\/swidux\/undoplugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}]},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","title":"KeyValueStore","type":"topic","url":"\/documentation\/swidux\/keyvaluestoreguide","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"role":"collectionGroup","kind":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"title":"EntityStore","type":"topic","url":"\/documentation\/swidux\/entitystoreguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change t