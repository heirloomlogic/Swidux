while adopting Swidux, and what each one actually means.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"url":"\/documentation\/swidux\/pluginanalyticsreference","kind":"article","title":"SwiduxAnalytics Reference","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","role":"article"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"title":"SwiduxKillswitch Reference","kind":"article","url":"\/documentation\/swidux\/pluginkillswitchreference","abstract":[{"type":"text","text":"Public API surface for the "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"title":"UndoPlugin","url":"\/documentation\/swidux\/undoplugin","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"kind":"symbol"},"doc://Swidux/documentation/Swidux/UndoRedo":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","role":"article","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"topic","kind":"article","title":"Undo \/ Redo","url":"\/documentation\/swidux\/undoredo"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"title":"KeyValueStore","kind":"article","url":"\/documentation\/swidux\/keyvaluestoreguide","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"role":"collectionGroup"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"title":"EntityStore","kind":"article","url":"\/documentation\/swidux\/entitystoreguide","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","kind":"section","abstract":[],"url":"\/documentation\/swidux\/pluginarchitecture#Service-Result-Actions-and-Transition-Observation","title":"Service-Result Actions and Transition Observation"}}}