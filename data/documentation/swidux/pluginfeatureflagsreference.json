ation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"title":"Troubleshooting","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","role":"article","kind":"article","abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"url":"\/documentation\/swidux\/troubleshooting"},"doc://Swidux/documentation/Swidux/UndoRedo":{"title":"Undo \/ Redo","type":"topic","url":"\/documentation\/swidux\/undoredo","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":"."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","role":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"title":"Getting Started with Swidux","type":"topic","url":"\/documentation\/swidux\/gettingstarted","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"role":"article","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"title":"EntityStore","kind":"article","type":"topic","url":"\/documentation\/swidux\/entitystoreguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"title":"Persistence Middleware","type":"topic","url":"\/documentation\/swidux\/persistencemiddlewareguide","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","role":"article"},"doc://Swidux/do