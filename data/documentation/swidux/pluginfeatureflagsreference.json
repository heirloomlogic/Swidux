{"metadata":{"title":"SwiduxFeatureFlags Reference","roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article"},"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference","generated":true,"anchor":"Reference"}],"kind":"article","sections":[],"variants":[{"paths":["\/documentation\/swidux\/pluginfeatureflagsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" is a domain plugin that owns a "},{"code":"FeatureFlagsState","type":"codeVoice"},{"type":"text","text":" slice, fetches a JSON wire format via a provider-agnostic "},{"code":"FeatureFlagsService","type":"codeVoice"},{"type":"text","text":", and answers reads against state. Bucketing is pure FNV-1a so reads are synchronous and offline-capable."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Three flag types from one wire format:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"boolean"}],"type":"strong"},{"type":"text","text":" — on\/off with rollout percentage (0–100)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"variant"}],"type":"strong"},{"type":"text","text":" — string-typed weighted variants for A\/B tests."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"value"}],"type":"strong"},{"type":"text","text":" — typed remote-tunable scalar ("},{"type":"codeVoice","code":"Bool"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"String"},{"type":"text","text":")."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Library target","anchor":"Library-target"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"code":"import SwiduxFeatureFlags","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"type":"heading","text":"Wire format","anchor":"Wire-format"},{"type":"codeListing","syntax":"json","code":["{","  \"version\": 1,","  \"flags\": {","    \"new_onboarding\": { \"type\": \"boolean\", \"rollout\": 25 },","    \"checkout_layout\": {","      \"type\": \"variant\",","      \"variants\": [","        { \"value\": \"control\", \"weight\": 50 },","        { \"value\": \"treatment\", \"weight\": 50 }","      ]","    },","    \"max_free_uploads\": { \"type\": \"value\", \"value\": 5 }","  }","}"]},{"inlineContent":[{"type":"text","text":"The plugin rejects unknown "},{"code":"version","type":"codeVoice"},{"type":"text","text":" values and falls back to the last-known-good cache. Defaults always live in Swift at the call site — this keeps them type-checked and forces “what if missing?” thinking."}],"type":"paragraph"},{"type":"heading","text":"Bucketing and identity","anchor":"Bucketing-and-identity","level":2},{"inlineContent":[{"code":"bucket = FNV1a(bucketingID + \":\" + flagKey) % 100","type":"codeVoice"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Stable per "},{"type":"codeVoice","code":"(bucketingID, flagKey)"},{"type":"text","text":" pair forever."}],"type":"strong"},{"text":" Same input always produces the same bucket.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Per-flag."}]},{"type":"text","text":" A user isn’t always in the “early” group across different flags."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Identity resolution.","type":"text"}]},{"text":" When a ","type":"text"},{"code":"userIDKeyPath","type":"codeVoice"},{"text":" is configured ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" the current user ID is non-nil, that is used. Otherwise the ","type":"text"},{"inlineContent":[{"type":"text","text":"device ID"}],"type":"strong"},{"type":"text","text":" is used (the plugin’s required "},{"code":"deviceIDKeyPath","type":"codeVoice"},{"type":"text","text":"). Anonymous users get a stable per-install identity; logged-in users get stable cross-device assignment. A user’s variant "},{"inlineContent":[{"type":"text","text":"can"}],"type":"emphasis"},{"type":"text","text":" shift once at login — acceptable for nearly all real use cases."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"FNV-1a was chosen because it’s simple, dependency-free, and matches GrowthBook’s algorithm so apps migrating from GrowthBook get compatible buckets."}],"type":"paragraph"},{"level":3,"text":"The device ID must be stable across reinstall","anchor":"The-device-ID-must-be-stable-across-reinstall","type":"heading"},{"inlineContent":[{"type":"text","text":"Bucketing is only stable if the fallback identity is. The plugin takes a non-optional "},{"code":"deviceIDKeyPath: KeyPath<State, String>","type":"codeVoice"},{"type":"text","text":" into your "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", so the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"app"}]},{"type":"text","text":" owns the identity and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"type":"text","text":" value can drive analytics ("},{"code":"AnalyticsIdentity(userID: \\.deviceID, …)","type":"codeVoice"},{"type":"text","text":") — one identity, so A\/B exposure correlates with the user analytics reports against."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Mint it once at launch with the shared core helper, backed by the Keychain so it survives reinstall, and seed it into the slice via "},{"code":"hydrated(from:deviceID:)","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ In Store.configured()","let deviceID = KeychainKeyValueStore(service: \"com.example.app\").deviceIdentity()","","let plugin = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags, action: AppAction.featureFlags, extractAction: { … },","    service: service,","    deviceIDKeyPath: \\.deviceID,          \/\/ app-owned, Keychain-backed","    userIDKeyPath: \\.auth.currentUserID,  \/\/ optional; authed identity wins when set","    keyValueStore: kv",")","","let initial = AppState(","    featureFlags: .hydrated(from: kv, deviceID: deviceID),","    deviceID: deviceID",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":"-backed identity regenerates on reinstall (QA ad-hoc builds, test installs), which silently re-buckets users and breaks A\/B assignment — use "},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" for the identity. The flags "},{"type":"emphasis","inlineContent":[{"type":"text","text":"config cache"}]},{"type":"text","text":" can still live in a lighter store."}],"type":"paragraph"},{"level":2,"text":"Evaluation order","anchor":"Evaluation-order","type":"heading"},{"inlineContent":[{"type":"text","text":"For each read, in priority:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Local override present?","type":"text"}]},{"text":" Return it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Flag in remote config?"}],"type":"strong"},{"type":"text","text":" Evaluate (rollout \/ variant assignment \/ value lookup)."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Otherwise"}]},{"type":"text","text":" return the Swift-side default."}],"type":"paragraph"}]}],"type":"orderedList"},{"level":2,"text":"Persistence","anchor":"Persistence","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Device ID"}]},{"type":"text","text":" is app-owned and minted once via "},{"code":"KeyValueStore.deviceIdentity()","type":"codeVoice"},{"type":"text","text":" (Keychain-backed). Seeded into the slice at "},{"code":"FeatureFlagsState.hydrated(from:deviceID:)","type":"codeVoice"},{"type":"text","text":" and kept in sync from "},{"code":"deviceIDKeyPath","type":"codeVoice"},{"type":"text","text":". The plugin no longer mints its own bucketing identity."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Last-known config"}]},{"type":"text","text":" persisted after every successful refresh. Hydrates as fallback before first network success."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Local overrides"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" persisted by default. Restart = clean state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"exposedKeys"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" persisted. New session = fresh exposure events."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Governance: no forever flags","anchor":"Governance-no-forever-flags","type":"heading"},{"inlineContent":[{"type":"text","text":"Owner and expiry are "},{"type":"strong","inlineContent":[{"text":"required","type":"text"}]},{"type":"text","text":" metadata for every flag, enforced by a single unit test rather than the wire format (the JSON stays dumb and fail-open). Declare a manifest with the type-erasing factories — "},{"code":"owner","type":"codeVoice"},{"type":"text","text":" and "},{"code":"expires","type":"codeVoice"},{"type":"text","text":" are non-optional, so a flag can’t be registered without them — and the keys are single-sourced from the typed flag declarations:"}],"type":"paragraph"},{"syntax":"swift","code":["enum FlagManifest {","    static let all: [FlagDescriptor] = [","        .bool(.newOnboarding, owner: \"growth\",","              expires: Date(timeIntervalSince1970: 1_788_000_000), purpose: \"New onboarding flow\"),","        .variant(.checkoutLayout, owner: \"checkout\",","                 expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Checkout A\/B\"),","    ]","}","","@Test func noForeverFlags() {","    let report = FlagGovernance.expirationReport(FlagManifest.all)","    #expect(report == nil, \"\\(report ?? \"\")\")   \/\/ failure names each expired flag + owner","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"When a flag passes its expiry, the test fails and the report names the flag, its owner, and how long it’s been expired — so a stale flag gets retired instead of living forever. This has no effect on runtime evaluation."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"The manifest is the single declaration site, so a typed flag key never added to it escapes governance. Closing that gap fully would need a macro; until then, convention plus code review covers it.","type":"text"}]}],"style":"note","name":"Note","type":"aside"},{"level":2,"text":"Exposure tracking","anchor":"Exposure-tracking","type":"heading"},{"inlineContent":[{"type":"text","text":"A\/B testing is only analytically valid if you know which users actually saw each variant — bucketing alone is insufficient because the code path branching on the flag might never execute."}],"type":"paragraph"},{"syntax":"swift","code":["store.send(.featureFlags(.recordExposure(key: \"checkout_layout\")))"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or via the SwiftUI sugar:"}],"type":"paragraph"},{"syntax":"swift","code":["WizardView()","    .recordsExposure(of: .checkoutLayout, store: store, action: AppAction.featureFlags)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The plugin dedupes per session and fires the optional "},{"code":"onExposure","type":"codeVoice"},{"type":"text","text":" callback (passed at plugin init). Wire that callback to your analytics plugin to forward exposures as events."}],"type":"paragraph"},{"level":2,"text":"Refresh policy","anchor":"Refresh-policy","type":"heading"},{"syntax":"swift","code":["public enum RefreshPolicy: Sendable {","    case manual                                      \/\/ every .refresh fetches","    case automatic(minInterval: TimeInterval)        \/\/ debounce; default 300s","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Apps dispatch "},{"code":".refresh","type":"codeVoice"},{"type":"text","text":" from "},{"code":"App.scenePhase","type":"codeVoice"},{"type":"text","text":" transitions; the plugin’s debouncing makes this safe to call frequently. The plugin does not subscribe to "},{"code":"UIApplication","type":"codeVoice"},{"type":"text","text":" notifications — wiring stays in the host app."}],"type":"paragraph"},{"level":2,"text":"Service protocol","anchor":"Service-protocol","type":"heading"},{"syntax":"swift","code":["public protocol FeatureFlagsService: Sendable {","    func fetch() async throws -> FeatureFlagsConfig","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"One method. Caching, hydration, evaluation all live in the plugin."}],"type":"paragraph"},{"level":3,"text":"Built-in: `HTTPFeatureFlagsService`","anchor":"Built-in-HTTPFeatureFlagsService","type":"heading"},{"inlineContent":[{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" + "},{"code":"JSONDecoder","type":"codeVoice"},{"type":"text","text":". Apps host their JSON anywhere — static file on a CDN, Cloudflare Worker, their own server. Zero backend infrastructure required. "},{"code":"Examples\/ConfigWorker\/","type":"codeVoice"},{"type":"text","text":" is a runnable shared Worker serving flags + killswitch for a whole portfolio from one URL ("},{"code":"GET \/<appID>\/flags","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The URL must be "},{"type":"strong","inlineContent":[{"text":"HTTPS","type":"text"}]},{"type":"text","text":" ("},{"code":"http","type":"codeVoice"},{"type":"text","text":" is allowed only for "},{"code":"localhost","type":"codeVoice"},{"type":"text","text":" development servers; anything else is a precondition failure at init). Responses over 1 MB and non-2xx statuses throw, and malformed variant definitions (empty array, negative weights, weights not summing to 100) fail decoding — in every case the plugin keeps its last-known-good cached config."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Third-party adapters (LaunchDarkly, GrowthBook, Statsig) conform to the same protocol without changing the plugin."}],"type":"paragraph"},{"level":2,"text":"Typed flag keys","anchor":"Typed-flag-keys","type":"heading"},{"syntax":"swift","code":["public struct BoolFlag: Sendable, Hashable","public struct VariantFlag<Variant: RawRepresentable & Sendable> where Variant.RawValue == String","public struct ValueFlag<Value: Sendable>"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Read API on "},{"code":"FeatureFlagsState","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["state.isEnabled(.newOnboarding, default: false)","state.variant(of: .checkoutLayout)","state.value(of: .maxFreeUploads)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Reads are pure synchronous functions. Per-property observation works as it does for any other state slice — views re-render only when the flag they read changes."}],"type":"paragraph"},{"level":2,"text":"Action semantics (selected)","anchor":"Action-semantics-selected","type":"heading"},{"inlineContent":[{"code":"refreshSucceeded(FeatureFlagsConfig, fetchedAt:)","type":"codeVoice"},{"type":"text","text":" is dispatched on every "},{"code":".refresh","type":"codeVoice"},{"type":"text","text":" (including debounced refreshes that return an unchanged config). Consume config transitions by observing "},{"code":"FeatureFlagsState","type":"codeVoice"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation"},{"type":"text","text":"."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","interfaceLanguage":"swift"},"references":{"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","url":"\/documentation\/swidux\/pluginarchitecture#Service-Result-Actions-and-Transition-Observation","title":"Service-Result Actions and Transition Observation","abstract":[],"kind":"section"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"type":"topic","title":"Troubleshooting","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","url":"\/documentation\/swidux\/troubleshooting","abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"role":"collectionGroup","title":"KeyValueStore","kind":"article","url":"\/documentation\/swidux\/keyvaluestoreguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","type":"topic","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}]},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"title":"Persistence Middleware","url":"\/documentation\/swidux\/persistencemiddlewareguide","type":"topic","kind":"article","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"role":"article","title":"SwiduxKillswitch Reference","kind":"article","url":"\/documentation\/swidux\/pluginkillswitchreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","type":"topic","abstract":[{"type":"text","text":"Public API surface for the "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","kind":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","role":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"role":"article","title":"EntityStore","kind":"article","url":"\/documentation\/swidux\/entitystoreguide","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"role":"article","title":"SwiduxAnalytics Reference","kind":"article","url":"\/documentation\/swidux\/pluginanalyticsreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","type":"topic","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}]},"doc://Swidux/documentation/Swidux/UndoRedo":{"role":"article","title":"Undo \/ Redo","kind":"article","url":"\/documentation\/swidux\/undoredo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"topic","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"type":"text","text":"."}]},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"title":"Add Feature Flags","url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux/MacrosReference":{"role":"article","title":"Macros","kind":"article","url":"\/documentation\/swidux\/macrosreference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","abstract":[{"type":"text","text":"Reference for "},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" and its property markers (the SwiftData persistence bridge, shipped in ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":").","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"role":"article","title":"SwiduxParentalGate Reference","kind":"article","url":"\/documentation\/swidux\/pluginparentalgatereference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","type":"topic","abstract":[{"type":"text","text":"API surface for the "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"role":"article","title":"SwiduxPaywall Reference","kind":"article","url":"\/documentation\/swidux\/pluginpaywallreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}]},"doc://Swidux/documentation/Swidux/UndoPlugin":{"type":"topic","title":"UndoPlugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","kind":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"url":"\/documentation\/swidux\/undoplugin","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}]},"doc://Swidux/documentation/Swidux":{"abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","url":"\/documentation\/swidux","title":"Swidux","type":"topic","kind":"symbol"}}}