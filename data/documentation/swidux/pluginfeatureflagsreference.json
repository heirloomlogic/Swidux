dux\/UndoRedo","kind":"article","url":"\/documentation\/swidux\/undoredo","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":"."}]},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"role":"article","type":"topic","title":"Persistence Middleware","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","kind":"article","url":"\/documentation\/swidux\/persistencemiddlewareguide","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}]},"doc://Swidux/documentation/Swidux/MacrosReference":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","title":"Macros","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":")."}],"url":"\/documentation\/swidux\/macrosreference","role":"article","type":"topic"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","title":"Troubleshooting","abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"url":"\/documentation\/swidux\/troubleshooting","role":"article","type":"topic"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"role":"article","type":"topic","title":"SwiduxParentalGate Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","kind":"article","url":"\/documentation\/swidux\/pluginparentalgatereference","abstract":[{"text":"API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}]},"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"topic","title":"UndoPlugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"kind":"symbol","role":"symbol","url":"\/documentation\/swidux\/undoplugin","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","title":"SwiduxKillswitch Reference","url":"\/documentation\/swidux\/pluginkillswitchreference","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"type":"topic","kind":"article","role":"article"}}}