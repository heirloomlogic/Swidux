{"variants":[{"paths":["\/documentation\/swidux\/pluginfeatureflagsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"article","metadata":{"roleHeading":"Article","role":"article","title":"SwiduxFeatureFlags Reference","modules":[{"name":"Swidux"}]},"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference","title":"Reference","generated":true}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" is a domain plugin that owns a ","type":"text"},{"code":"FeatureFlagsState","type":"codeVoice"},{"text":" slice, fetches a JSON wire format via a provider-agnostic ","type":"text"},{"code":"FeatureFlagsService","type":"codeVoice"},{"text":", and answers reads against state. Bucketing is pure FNV-1a so reads are synchronous and offline-capable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Three flag types from one wire format:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"boolean"}],"type":"strong"},{"type":"text","text":" — on\/off with rollout percentage (0–100)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"variant"}],"type":"strong"},{"type":"text","text":" — string-typed weighted variants for A\/B tests."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"value"}],"type":"strong"},{"type":"text","text":" — typed remote-tunable scalar ("},{"code":"Bool","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"String","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Library-target","level":2,"text":"Library target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"code":"SwiduxFeatureFlags","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"code":"import SwiduxFeatureFlags","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Wire-format","level":2,"text":"Wire format"},{"type":"codeListing","code":["{","  \"version\": 1,","  \"flags\": {","    \"new_onboarding\": { \"type\": \"boolean\", \"rollout\": 25 },","    \"checkout_layout\": {","      \"type\": \"variant\",","      \"variants\": [","        { \"value\": \"control\", \"weight\": 50 },","        { \"value\": \"treatment\", \"weight\": 50 }","      ]","    },","    \"max_free_uploads\": { \"type\": \"value\", \"value\": 5 }","  }","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"text":"The plugin rejects unknown ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" values and falls back to the last-known-good cache. Defaults always live in Swift at the call site — this keeps them type-checked and forces “what if missing?” thinking.","type":"text"}]},{"type":"heading","anchor":"Bucketing-and-identity","level":2,"text":"Bucketing and identity"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"bucket = FNV1a(bucketingID + \":\" + flagKey) % 100"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Stable per "},{"type":"codeVoice","code":"(bucketingID, flagKey)"},{"type":"text","text":" pair forever."}],"type":"strong"},{"text":" Same input always produces the same bucket.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Per-flag."}],"type":"strong"},{"text":" A user isn’t always in the “early” group across different flags.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Identity resolution.","type":"text"}]},{"type":"text","text":" When a "},{"type":"codeVoice","code":"userIDKeyPath"},{"type":"text","text":" is configured "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" the current user ID is non-nil, that is used. Otherwise the "},{"inlineContent":[{"type":"text","text":"device ID"}],"type":"strong"},{"type":"text","text":" is used (the plugin’s required "},{"type":"codeVoice","code":"deviceIDKeyPath"},{"type":"text","text":"). Anonymous users get a stable per-install identity; logged-in users get stable cross-device assignment. A user’s variant "},{"inlineContent":[{"type":"text","text":"can"}],"type":"emphasis"},{"type":"text","text":" shift once at login — acceptable for nearly all real use cases."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"FNV-1a was chosen because it’s simple, dependency-free, and matches GrowthBook’s algorithm so apps migrating from GrowthBook get compatible buckets.","type":"text"}],"type":"paragraph"},{"anchor":"The-device-ID-must-be-stable-across-reinstall","level":3,"type":"heading","text":"The device ID must be stable across reinstall"},{"inlineContent":[{"type":"text","text":"Bucketing is only stable if the fallback identity is. The plugin takes a non-optional "},{"code":"deviceIDKeyPath: KeyPath<State, String>","type":"codeVoice"},{"type":"text","text":" into your "},{"type":"codeVoice","code":"AppState"},{"text":", so the ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"app","type":"text"}]},{"text":" owns the identity and the ","type":"text"},{"inlineContent":[{"type":"text","text":"same"}],"type":"emphasis"},{"text":" value can drive analytics (","type":"text"},{"type":"codeVoice","code":"AnalyticsIdentity(userID: \\.deviceID, …)"},{"type":"text","text":") — one identity, so A\/B exposure correlates with the user analytics reports against."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mint it once at launch with the shared core helper, backed by the Keychain so it survives reinstall, and seed it into the slice via "},{"code":"hydrated(from:deviceID:)","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","code":["\/\/ In Store.configured()","let deviceID = KeychainKeyValueStore(service: \"com.example.app\").deviceIdentity()","","let plugin = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags, action: AppAction.featureFlags, extractAction: { … },","    service: service,","    deviceIDKeyPath: \\.deviceID,          \/\/ app-owned, Keychain-backed","    userIDKeyPath: \\.auth.currentUserID,  \/\/ optional; authed identity wins when set","    keyValueStore: kv",")","","let initial = AppState(","    featureFlags: .hydrated(from: kv, deviceID: deviceID),","    deviceID: deviceID",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":"-backed identity regenerates on reinstall (QA ad-hoc builds, test installs), which silently re-buckets users and breaks A\/B assignment — use "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"text":" for the identity. The flags ","type":"text"},{"inlineContent":[{"type":"text","text":"config cache"}],"type":"emphasis"},{"type":"text","text":" can still live in a lighter store."}],"type":"paragraph"},{"level":2,"text":"Evaluation order","anchor":"Evaluation-order","type":"heading"},{"inlineContent":[{"type":"text","text":"For each read, in priority:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Local override present?","type":"text"}]},{"type":"text","text":" Return it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Flag in remote config?","type":"text"}]},{"type":"text","text":" Evaluate (rollout \/ variant assignment \/ value lookup)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Otherwise","type":"text"}]},{"type":"text","text":" return the Swift-side default."}]}]}],"type":"orderedList"},{"level":2,"text":"Persistence","anchor":"Persistence","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Device ID","type":"text"}]},{"type":"text","text":" is app-owned and minted once via "},{"type":"codeVoice","code":"KeyValueStore.deviceIdentity()"},{"type":"text","text":" (Keychain-backed). Seeded into the slice at "},{"type":"codeVoice","code":"FeatureFlagsState.hydrated(from:deviceID:)"},{"type":"text","text":" and kept in sync from "},{"type":"codeVoice","code":"deviceIDKeyPath"},{"type":"text","text":". The plugin no longer mints its own bucketing identity."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Last-known config","type":"text"}]},{"type":"text","text":" persisted after every successful refresh. Hydrates as fallback before first network success."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Local overrides"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" persisted by default. Restart = clean state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"exposedKeys","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" persisted. New session = fresh exposure events.","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","anchor":"Governance-no-forever-flags","level":2,"text":"Governance: no forever flags"},{"inlineContent":[{"type":"text","text":"Owner and expiry are "},{"inlineContent":[{"text":"required","type":"text"}],"type":"strong"},{"type":"text","text":" metadata for every flag, enforced by a single unit test rather than the wire format (the JSON stays dumb and fail-open). Declare a manifest with the type-erasing factories — "},{"code":"owner","type":"codeVoice"},{"type":"text","text":" and "},{"code":"expires","type":"codeVoice"},{"type":"text","text":" are non-optional, so a flag can’t be registered without them — and the keys are single-sourced from the typed flag declarations:"}],"type":"paragraph"},{"code":["enum FlagManifest {","    static let all: [FlagDescriptor] = [","        .bool(.newOnboarding, owner: \"growth\",","              expires: Date(timeIntervalSince1970: 1_788_000_000), purpose: \"New onboarding flow\"),","        .variant(.checkoutLayout, owner: \"checkout\",","                 expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Checkout A\/B\"),","    ]","}","","@Test func noForeverFlags() {","    let report = FlagGovernance.expirationReport(FlagManifest.all)","    #expect(report == nil, \"\\(report ?? \"\")\")   \/\/ failure names each expired flag + owner","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"When a flag passes its expiry, the test fails and the report names the flag, its owner, and how long it’s been expired — so a stale flag gets retired instead of living forever. This has no effect on runtime evaluation.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"The manifest is the single declaration site, so a typed flag key never added to it escapes governance. Closing that gap fully would need a macro; until then, convention plus code review covers it."}],"type":"paragraph"}]},{"text":"Exposure tracking","anchor":"Exposure-tracking","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"A\/B testing is only analytically valid if you know which users actually saw each variant — bucketing alone is insufficient because the code path branching on the flag might never execute."}],"type":"paragraph"},{"syntax":"swift","code":["store.send(.featureFlags(.recordExposure(key: \"checkout_layout\")))"],"type":"codeListing"},{"inlineContent":[{"text":"Or via the SwiftUI sugar:","type":"text"}],"type":"paragraph"},{"code":["WizardView()","    .recordsExposure(of: .checkoutLayout, store: store, action: AppAction.featureFlags)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The plugin dedupes per session and fires the optional "},{"type":"codeVoice","code":"onExposure"},{"type":"text","text":" callback (passed at plugin init). Wire that callback to your analytics plugin to forward exposures as events."}],"type":"paragraph"},{"anchor":"Refresh-policy","level":2,"type":"heading","text":"Refresh policy"},{"code":["public enum RefreshPolicy: Sendable {","    case manual                                      \/\/ every .refresh fetches","    case automatic(minInterval: TimeInterval)        \/\/ debounce; default 300s","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Apps dispatch ","type":"text"},{"code":".refresh","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"App.scenePhase","type":"codeVoice"},{"text":" transitions; the plugin’s debouncing makes this safe to call frequently. The plugin does not subscribe to ","type":"text"},{"code":"UIApplication","type":"codeVoice"},{"type":"text","text":" notifications — wiring stays in the host app."}],"type":"paragraph"},{"anchor":"Service-protocol","level":2,"type":"heading","text":"Service protocol"},{"code":["public protocol FeatureFlagsService: Sendable {","    func fetch() async throws -> FeatureFlagsConfig","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"One method. Caching, hydration, evaluation all live in the plugin.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Built-in-HTTPFeatureFlagsService","level":3,"text":"Built-in: `HTTPFeatureFlagsService`"},{"type":"paragraph","inlineContent":[{"code":"URLSession","type":"codeVoice"},{"type":"text","text":" + "},{"code":"JSONDecoder","type":"codeVoice"},{"type":"text","text":". Apps host their JSON anywhere — static file on a CDN, Cloudflare Worker, their own server. Zero backend infrastructure required. "},{"code":"Examples\/ConfigWorker\/","type":"codeVoice"},{"type":"text","text":" is a runnable shared Worker serving flags + killswitch for a whole portfolio from one URL ("},{"code":"GET \/<appID>\/flags","type":"codeVoice"},{"text":").","type":"text"}]},{"inlineContent":[{"type":"text","text":"The URL must be "},{"type":"strong","inlineContent":[{"text":"HTTPS","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"http"},{"type":"text","text":" is allowed only for "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":" development servers; anything else is a precondition failure at init). Responses over 1 MB and non-2xx statuses throw, and malformed variant definitions (empty array, negative weights, weights not summing to 100) fail decoding — in every case the plugin keeps its last-known-good cached config."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Third-party adapters (LaunchDarkly, GrowthBook, Statsig) conform to the same protocol without changing the plugin."}],"type":"paragraph"},{"anchor":"Typed-flag-keys","level":2,"type":"heading","text":"Typed flag keys"},{"code":["public struct BoolFlag: Sendable, Hashable","public struct VariantFlag<Variant: RawRepresentable & Sendable> where Variant.RawValue == String","public struct ValueFlag<Value: Sendable>"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Read API on "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["state.isEnabled(.newOnboarding, default: false)","state.variant(of: .checkoutLayout)","state.value(of: .maxFreeUploads)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Reads are pure synchronous functions. Per-property observation works as it does for any other state slice — views re-render only when the flag they read changes."}],"type":"paragraph"},{"anchor":"Action-semantics-selected","level":2,"type":"heading","text":"Action semantics (selected)"},{"inlineContent":[{"type":"codeVoice","code":"refreshSucceeded(FeatureFlagsConfig, fetchedAt:)"},{"type":"text","text":" is dispatched on every "},{"type":"codeVoice","code":".refresh"},{"type":"text","text":" (including debounced refreshes that return an unchanged config). Consume config transitions by observing "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation"},{"type":"text","text":"."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","role":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article","type":"topic","title":"Add Feature Flags"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","role":"article","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"url":"\/documentation\/swidux\/persistencemiddlewareguide","kind":"article","type":"topic","title":"Persistence Middleware"},"doc://Swidux/documentation/Swidux/UndoRedo":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","title":"Undo \/ Redo","role":"article","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":".","type":"text"}],"url":"\/documentation\/swidux\/undoredo"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","title":"Troubleshooting","role":"article","abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"url":"\/documentation\/swidux\/troubleshooting"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"kind":"article","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","role":"collectionGroup","type":"topic","title":"KeyValueStore","url":"\/documentation\/swidux\/keyvaluestoreguide"},"doc://Swidux/documentation/Swidux/MacrosReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","role":"article","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":")."}],"url":"\/documentation\/swidux\/macrosreference","kind":"article","type":"topic","title":"Macros"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","title":"SwiduxParentalGate Reference","role":"article","abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"url":"\/documentation\/swidux\/pluginparentalgatereference"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","role":"article","abstract":[{"type":"text","text":"Public API surface for the "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"type":"topic","url":"\/documentation\/swidux\/pluginkillswitchreference","kind":"article","title":"SwiduxKillswitch Reference"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","title":"SwiduxPaywall Reference","role":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"url":"\/documentation\/swidux\/pluginpaywallreference"},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"abstract":[],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","title":"Service-Result Actions and Transition Observation","kind":"section","type":"topic","url":"\/documentation\/swidux\/pluginarchitecture#Service-Result-Actions-and-Transition-Observation"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","role":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"url":"\/documentation\/swidux\/entitystoreguide","kind":"article","type":"topic","title":"EntityStore"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"UndoPlugin","kind":"identifier"}],"abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","role":"symbol","url":"\/documentation\/swidux\/undoplugin","title":"UndoPlugin","type":"topic","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}]},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/swidux","title":"Swidux"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","role":"article","type":"topic","url":"\/documentation\/swidux\/pluginanalyticsreference","title":"SwiduxAnalytics Reference"},"doc://Swidux/documentation/Swidux/GettingStarted":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","role":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"url":"\/documentation\/swidux\/gettingstarted","kind":"article","type":"topic","title":"Getting Started with Swidux"}}}