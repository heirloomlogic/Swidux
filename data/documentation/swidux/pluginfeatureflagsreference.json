{"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginfeatureflagsreference"]}],"sections":[],"abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference","generated":true,"anchor":"Reference"}],"metadata":{"role":"article","title":"SwiduxFeatureFlags Reference","roleHeading":"Article","modules":[{"name":"Swidux"}]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" is a domain plugin that owns a "},{"type":"codeVoice","code":"FeatureFlagsState"},{"text":" slice, fetches a JSON wire format via a provider-agnostic ","type":"text"},{"type":"codeVoice","code":"FeatureFlagsService"},{"text":", and answers reads against state. Bucketing is pure FNV-1a so reads are synchronous and offline-capable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Three flag types from one wire format:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"boolean","type":"text"}],"type":"strong"},{"text":" — on\/off with rollout percentage (0–100).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"variant"}],"type":"strong"},{"text":" — string-typed weighted variants for A\/B tests.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"value","type":"text"}],"type":"strong"},{"text":" — typed remote-tunable scalar (","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"String"},{"text":").","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Library target","anchor":"Library-target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"type":"codeVoice","code":"import SwiduxFeatureFlags"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Wire format","anchor":"Wire-format"},{"type":"codeListing","syntax":"json","code":["{","  \"version\": 1,","  \"flags\": {","    \"new_onboarding\": { \"type\": \"boolean\", \"rollout\": 25 },","    \"checkout_layout\": {","      \"type\": \"variant\",","      \"variants\": [","        { \"value\": \"control\", \"weight\": 50 },","        { \"value\": \"treatment\", \"weight\": 50 }","      ]","    },","    \"max_free_uploads\": { \"type\": \"value\", \"value\": 5 }","  }","}"]},{"inlineContent":[{"type":"text","text":"The plugin rejects unknown "},{"type":"codeVoice","code":"version"},{"type":"text","text":" values and falls back to the last-known-good cache. Defaults always live in Swift at the call site — this keeps them type-checked and forces “what if missing?” thinking."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Bucketing and identity","anchor":"Bucketing-and-identity"},{"inlineContent":[{"type":"codeVoice","code":"bucket = FNV1a(bucketingID + \":\" + flagKey) % 100"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Stable per ","type":"text"},{"code":"(bucketingID, flagKey)","type":"codeVoice"},{"text":" pair forever.","type":"text"}],"type":"strong"},{"text":" Same input always produces the same bucket.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Per-flag.","type":"text"}],"type":"strong"},{"text":" A user isn’t always in the “early” group across different flags.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Identity resolution."}],"type":"strong"},{"text":" When a ","type":"text"},{"code":"userIDKeyPath","type":"codeVoice"},{"text":" is configured ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" the current user ID is non-nil, that is used. Otherwise the ","type":"text"},{"inlineContent":[{"type":"text","text":"device ID"}],"type":"strong"},{"text":" is used (the plugin’s required ","type":"text"},{"code":"deviceIDKeyPath","type":"codeVoice"},{"text":"). Anonymous users get a stable per-install identity; logged-in users get stable cross-device assignment. A user’s variant ","type":"text"},{"inlineContent":[{"type":"text","text":"can"}],"type":"emphasis"},{"text":" shift once at login — acceptable for nearly all real use cases.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"FNV-1a was chosen because it’s simple, dependency-free, and matches GrowthBook’s algorithm so apps migrating from GrowthBook get compatible buckets."}],"type":"paragraph"},{"text":"The device ID must be stable across reinstall","type":"heading","level":3,"anchor":"The-device-ID-must-be-stable-across-reinstall"},{"inlineContent":[{"type":"text","text":"Bucketing is only stable if the fallback identity is. The plugin takes a non-optional "},{"type":"codeVoice","code":"deviceIDKeyPath: KeyPath<State, String>"},{"type":"text","text":" into your "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", so the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"app"}]},{"type":"text","text":" owns the identity and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"type":"text","text":" value can drive analytics ("},{"type":"codeVoice","code":"AnalyticsIdentity(userID: \\.deviceID, …)"},{"type":"text","text":") — one identity, so A\/B exposure correlates with the user analytics reports against."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Mint it once at launch with the shared core helper, backed by the Keychain so it survives reinstall, and seed it into the slice via "},{"type":"codeVoice","code":"hydrated(from:deviceID:)"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ In Store.configured()","let deviceID = KeychainKeyValueStore(service: \"com.example.app\").deviceIdentity()","","let plugin = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags, action: AppAction.featureFlags, extractAction: { … },","    service: service,","    deviceIDKeyPath: \\.deviceID,          \/\/ app-owned, Keychain-backed","    userIDKeyPath: \\.auth.currentUserID,  \/\/ optional; authed identity wins when set","    keyValueStore: kv",")","","let initial = AppState(","    featureFlags: .hydrated(from: kv, deviceID: deviceID),","    deviceID: deviceID",")"]},{"inlineContent":[{"text":"A ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":"-backed identity regenerates on reinstall (QA ad-hoc builds, test installs), which silently re-buckets users and breaks A\/B assignment — use "},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" for the identity. The flags "},{"inlineContent":[{"type":"text","text":"config cache"}],"type":"emphasis"},{"type":"text","text":" can still live in a lighter store."}],"type":"paragraph"},{"anchor":"Evaluation-order","type":"heading","level":2,"text":"Evaluation order"},{"type":"paragraph","inlineContent":[{"text":"For each read, in priority:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Local override present?"}]},{"type":"text","text":" Return it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Flag in remote config?","type":"text"}]},{"type":"text","text":" Evaluate (rollout \/ variant assignment \/ value lookup)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Otherwise","type":"text"}]},{"text":" return the Swift-side default.","type":"text"}],"type":"paragraph"}]}]},{"text":"Persistence","type":"heading","anchor":"Persistence","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Device ID","type":"text"}]},{"text":" is app-owned and minted once via ","type":"text"},{"type":"codeVoice","code":"KeyValueStore.deviceIdentity()"},{"text":" (Keychain-backed). Seeded into the slice at ","type":"text"},{"type":"codeVoice","code":"FeatureFlagsState.hydrated(from:deviceID:)"},{"text":" and kept in sync from ","type":"text"},{"type":"codeVoice","code":"deviceIDKeyPath"},{"text":". The plugin no longer mints its own bucketing identity.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Last-known config","type":"text"}]},{"text":" persisted after every successful refresh. Hydrates as fallback before first network success.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Local overrides","type":"text"}]},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"text":" persisted by default. Restart = clean state.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"exposedKeys","type":"codeVoice"}]},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"text":" persisted. New session = fresh exposure events.","type":"text"}]}]}]},{"text":"Governance: no forever flags","type":"heading","anchor":"Governance-no-forever-flags","level":2},{"inlineContent":[{"type":"text","text":"Owner and expiry are "},{"type":"strong","inlineContent":[{"text":"required","type":"text"}]},{"type":"text","text":" metadata for every flag, enforced by a single unit test rather than the wire format (the JSON stays dumb and fail-open). Declare a manifest with the type-erasing factories — "},{"code":"owner","type":"codeVoice"},{"type":"text","text":" and "},{"code":"expires","type":"codeVoice"},{"type":"text","text":" are non-optional, so a flag can’t be registered without them — and the keys are single-sourced from the typed flag declarations:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["enum FlagManifest {","    static let all: [FlagDescriptor] = [","        .bool(.newOnboarding, owner: \"growth\",","              expires: Date(timeIntervalSince1970: 1_788_000_000), purpose: \"New onboarding flow\"),","        .variant(.checkoutLayout, owner: \"checkout\",","                 expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Checkout A\/B\"),","    ]","}","","@Test func noForeverFlags() {","    let report = FlagGovernance.expirationReport(FlagManifest.all)","    #expect(report == nil, \"\\(report ?? \"\")\")   \/\/ failure names each expired flag + owner","}"]},{"type":"paragraph","inlineContent":[{"text":"When a flag passes its expiry, the test fails and the report names the flag, its owner, and how long it’s been expired — so a stale flag gets retired instead of living forever. This has no effect on runtime evaluation.","type":"text"}]},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"The manifest is the single declaration site, so a typed flag key never added to it escapes governance. Closing that gap fully would need a macro; until then, convention plus code review covers it."}],"type":"paragraph"}],"type":"aside","style":"note"},{"level":2,"text":"Exposure tracking","type":"heading","anchor":"Exposure-tracking"},{"type":"paragraph","inlineContent":[{"text":"A\/B testing is only analytically valid if you know which users actually saw each variant — bucketing alone is insufficient because the code path branching on the flag might never execute.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["store.send(.featureFlags(.recordExposure(key: \"checkout_layout\")))"]},{"type":"paragraph","inlineContent":[{"text":"Or via the SwiftUI sugar:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["WizardView()","    .recordsExposure(of: .checkoutLayout, store: store, action: AppAction.featureFlags)"]},{"type":"paragraph","inlineContent":[{"text":"The plugin dedupes per session and fires the optional ","type":"text"},{"code":"onExposure","type":"codeVoice"},{"text":" callback (passed at plugin init). Wire that callback to your analytics plugin to forward exposures as events.","type":"text"}]},{"level":2,"text":"Refresh policy","type":"heading","anchor":"Refresh-policy"},{"code":["public enum RefreshPolicy: Sendable {","    case manual                                      \/\/ every .refresh fetches","    case automatic(minInterval: TimeInterval)        \/\/ debounce; default 300s","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Apps dispatch ","type":"text"},{"type":"codeVoice","code":".refresh"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"App.scenePhase"},{"text":" transitions; the plugin’s debouncing makes this safe to call frequently. The plugin does not subscribe to ","type":"text"},{"type":"codeVoice","code":"UIApplication"},{"text":" notifications — wiring stays in the host app.","type":"text"}]},{"anchor":"Service-protocol","level":2,"type":"heading","text":"Service protocol"},{"code":["public protocol FeatureFlagsService: Sendable {","    func fetch() async throws -> FeatureFlagsConfig","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"One method. Caching, hydration, evaluation all live in the plugin.","type":"text"}]},{"level":3,"text":"Built-in: `HTTPFeatureFlagsService`","type":"heading","anchor":"Built-in-HTTPFeatureFlagsService"},{"type":"paragraph","inlineContent":[{"code":"URLSession","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"JSONDecoder","type":"codeVoice"},{"type":"text","text":". Apps host their JSON anywhere — static file on a CDN, Cloudflare Worker, their own server. Zero backend infrastructure required. "},{"code":"Examples\/ConfigWorker\/","type":"codeVoice"},{"type":"text","text":" is a runnable shared Worker serving flags + killswitch for a whole portfolio from one URL ("},{"type":"codeVoice","code":"GET \/<appID>\/flags"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"text":"The URL must be ","type":"text"},{"type":"strong","inlineContent":[{"text":"HTTPS","type":"text"}]},{"text":" (","type":"text"},{"type":"codeVoice","code":"http"},{"text":" is allowed only for ","type":"text"},{"code":"localhost","type":"codeVoice"},{"type":"text","text":" development servers; anything else is a precondition failure at init). Responses over 1 MB and non-2xx statuses throw, and malformed variant definitions (empty array, negative weights, weights not summing to 100) fail decoding — in every case the plugin keeps its last-known-good cached config."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Third-party adapters (LaunchDarkly, GrowthBook, Statsig) conform to the same protocol without changing the plugin."}]},{"level":2,"text":"Typed flag keys","type":"heading","anchor":"Typed-flag-keys"},{"syntax":"swift","type":"codeListing","code":["public struct BoolFlag: Sendable, Hashable","public struct VariantFlag<Variant: RawRepresentable & Sendable> where Variant.RawValue == String","public struct ValueFlag<Value: Sendable>"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read API on "},{"code":"FeatureFlagsState","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["state.isEnabled(.newOnboarding, default: false)","state.variant(of: .checkoutLayout)","state.value(of: .maxFreeUploads)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reads are pure synchronous functions. Per-property observation works as it does for any other state slice — views re-render only when the flag they read changes."}]},{"level":2,"text":"Action semantics (selected)","type":"heading","anchor":"Action-semantics-selected"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"refreshSucceeded(FeatureFlagsConfig, fetchedAt:)"},{"text":" is dispatched on every ","type":"text"},{"code":".refresh","type":"codeVoice"},{"text":" (including debounced refreshes that return an unchanged config). Consume config transitions by observing ","type":"text"},{"code":"FeatureFlagsState","type":"codeVoice"},{"text":" or a value derived from it — not by mapping this action. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","type":"reference","isActive":true},{"text":".","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},"references":{"doc://Swidux/documentation/Swidux/Troubleshooting":{"kind":"article","type":"topic","url":"\/documentation\/swidux\/troubleshooting","abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"title":"Troubleshooting","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"},"doc://Swidux/documentation/Swidux":{"kind":"symbol","type":"topic","url":"\/documentation\/swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"kind":"article","type":"topic","url":"\/documentation\/swidux\/keyvaluestoreguide","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"role":"collectionGroup","title":"KeyValueStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","kind":"article","title":"Add Feature Flags","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"url":"\/documentation\/swidux\/howtoaddfeatureflags","role":"article"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"kind":"article","type":"topic","url":"\/documentation\/swidux\/pluginanalyticsreference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"role":"article","title":"SwiduxAnalytics Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","kind":"symbol","title":"UndoPlugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"url":"\/documentation\/swidux\/undoplugin","role":"symbol"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"kind":"article","type":"topic","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"url":"\/documentation\/swidux\/persistencemiddlewareguide","role":"article","title":"Persistence Middleware","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"kind":"article","type":"topic","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"url":"\/documentation\/swidux\/entitystoreguide","role":"article","title":"EntityStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"kind":"article","type":"topic","abstract":[{"text":"Public API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"url":"\/documentation\/swidux\/pluginkillswitchreference","role":"article","title":"SwiduxKillswitch Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"kind":"article","type":"topic","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"url":"\/documentation\/swidux\/pluginpaywallreference","role":"article","title":"SwiduxPaywall Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"kind":"article","type":"topic","abstract":[{"text":"API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"url":"\/documentation\/swidux\/pluginparentalgatereference","role":"article","title":"SwiduxParentalGate Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"url":"\/documentation\/swidux\/pluginarchitecture#Service-Result-Actions-and-Transition-Observation","abstract":[],"kind":"section","type":"topic","title":"Service-Result Actions and Transition Observation","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation"},"doc://Swidux/documentation/Swidux/GettingStarted":{"kind":"article","type":"topic","url":"\/documentation\/swidux\/gettingstarted","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"title":"Getting Started with Swidux","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},"doc://Swidux/documentation/Swidux/UndoRedo":{"kind":"article","type":"topic","url":"\/documentation\/swidux\/undoredo","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":"."}],"title":"Undo \/ Redo","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},"doc://Swidux/documentation/Swidux/MacrosReference":{"kind":"article","type":"topic","url":"\/documentation\/swidux\/macrosreference","abstract":[{"text":"Reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":")."}],"title":"Macros","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"}}}