{"metadata":{"title":"SwiduxFeatureFlags Reference","role":"article","roleHeading":"Article","modules":[{"name":"Swidux"}]},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" is a domain plugin that owns a ","type":"text"},{"type":"codeVoice","code":"FeatureFlagsState"},{"text":" slice, fetches a JSON wire format via a provider-agnostic ","type":"text"},{"type":"codeVoice","code":"FeatureFlagsService"},{"text":", and answers reads against state. Bucketing is pure FNV-1a so reads are synchronous and offline-capable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Three flag types from one wire format:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"boolean","type":"text"}]},{"text":" — on\/off with rollout percentage (0–100).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"variant","type":"text"}]},{"text":" — string-typed weighted variants for A\/B tests.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"value","type":"text"}]},{"text":" — typed remote-tunable scalar (","type":"text"},{"type":"codeVoice","code":"Bool"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":" \/ ","type":"text"},{"code":"String","type":"codeVoice"},{"text":").","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Library target","anchor":"Library-target"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxFeatureFlags"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxFeatureFlags"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Wire format","anchor":"Wire-format"},{"type":"codeListing","code":["{","  \"version\": 1,","  \"flags\": {","    \"new_onboarding\": { \"type\": \"boolean\", \"rollout\": 25 },","    \"checkout_layout\": {","      \"type\": \"variant\",","      \"variants\": [","        { \"value\": \"control\", \"weight\": 50 },","        { \"value\": \"treatment\", \"weight\": 50 }","      ]","    },","    \"max_free_uploads\": { \"type\": \"value\", \"value\": 5 }","  }","}"],"syntax":"json"},{"inlineContent":[{"text":"The plugin rejects unknown ","type":"text"},{"type":"codeVoice","code":"version"},{"text":" values and falls back to the last-known-good cache. Defaults always live in Swift at the call site — this keeps them type-checked and forces “what if missing?” thinking.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Bucketing and identity","anchor":"Bucketing-and-identity"},{"inlineContent":[{"type":"codeVoice","code":"bucket = FNV1a(bucketingID + \":\" + flagKey) % 100"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Stable per "},{"type":"codeVoice","code":"(bucketingID, flagKey)"},{"type":"text","text":" pair forever."}]},{"type":"text","text":" Same input always produces the same bucket."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Per-flag."}]},{"type":"text","text":" A user isn’t always in the “early” group across different flags."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Identity resolution."}]},{"type":"text","text":" When a "},{"type":"codeVoice","code":"userIDKeyPath"},{"type":"text","text":" is configured "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" the current user ID is non-nil, that is used. Otherwise the "},{"type":"strong","inlineContent":[{"type":"text","text":"device ID"}]},{"type":"text","text":" is used (the plugin’s required "},{"type":"codeVoice","code":"deviceIDKeyPath"},{"type":"text","text":"). Anonymous users get a stable per-install identity; logged-in users get stable cross-device assignment. A user’s variant "},{"type":"emphasis","inlineContent":[{"type":"text","text":"can"}]},{"type":"text","text":" shift once at login — acceptable for nearly all real use cases."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"FNV-1a was chosen because it’s simple, dependency-free, and matches GrowthBook’s algorithm so apps migrating from GrowthBook get compatible buckets.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"The device ID must be stable across reinstall","anchor":"The-device-ID-must-be-stable-across-reinstall"},{"inlineContent":[{"text":"Bucketing is only stable if the fallback identity is. The plugin takes a non-optional ","type":"text"},{"type":"codeVoice","code":"deviceIDKeyPath: KeyPath<State, String>"},{"text":" into your ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", so the ","type":"text"},{"inlineContent":[{"type":"text","text":"app"}],"type":"emphasis"},{"text":" owns the identity and the ","type":"text"},{"inlineContent":[{"type":"text","text":"same"}],"type":"emphasis"},{"text":" value can drive analytics (","type":"text"},{"code":"AnalyticsIdentity(userID: \\.deviceID, …)","type":"codeVoice"},{"text":") — one identity, so A\/B exposure correlates with the user analytics reports against.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Mint it once at launch with the shared core helper, backed by the Keychain so it survives reinstall, and seed it into the slice via ","type":"text"},{"code":"hydrated(from:deviceID:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ In Store.configured()","let deviceID = KeychainKeyValueStore(service: \"com.example.app\").deviceIdentity()","","let plugin = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags, action: AppAction.featureFlags, extractAction: { … },","    service: service,","    deviceIDKeyPath: \\.deviceID,          \/\/ app-owned, Keychain-backed","    userIDKeyPath: \\.auth.currentUserID,  \/\/ optional; authed identity wins when set","    keyValueStore: kv",")","","let initial = AppState(","    featureFlags: .hydrated(from: kv, deviceID: deviceID),","    deviceID: deviceID",")"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":"-backed identity regenerates on reinstall (QA ad-hoc builds, test installs), which silently re-buckets users and breaks A\/B assignment — use "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" for the identity. The flags "},{"type":"emphasis","inlineContent":[{"type":"text","text":"config cache"}]},{"type":"text","text":" can still live in a lighter store."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Evaluation order","anchor":"Evaluation-order"},{"inlineContent":[{"type":"text","text":"For each read, in priority:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Local override present?","type":"text"}],"type":"strong"},{"text":" Return it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Flag in remote config?","type":"text"}],"type":"strong"},{"text":" Evaluate (rollout \/ variant assignment \/ value lookup).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Otherwise","type":"text"}],"type":"strong"},{"text":" return the Swift-side default.","type":"text"}]}]}],"type":"orderedList"},{"type":"heading","level":2,"text":"Persistence","anchor":"Persistence"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Device ID","type":"text"}],"type":"strong"},{"text":" is app-owned and minted once via ","type":"text"},{"type":"codeVoice","code":"KeyValueStore.deviceIdentity()"},{"text":" (Keychain-backed). Seeded into the slice at ","type":"text"},{"type":"codeVoice","code":"FeatureFlagsState.hydrated(from:deviceID:)"},{"text":" and kept in sync from ","type":"text"},{"type":"codeVoice","code":"deviceIDKeyPath"},{"text":". The plugin no longer mints its own bucketing identity.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Last-known config","type":"text"}],"type":"strong"},{"text":" persisted after every successful refresh. Hydrates as fallback before first network success.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Local overrides","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" persisted by default. Restart = clean state.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"exposedKeys"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" persisted. New session = fresh exposure events.","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Governance: no forever flags","anchor":"Governance-no-forever-flags"},{"inlineContent":[{"type":"text","text":"Owner and expiry are "},{"type":"strong","inlineContent":[{"type":"text","text":"required"}]},{"type":"text","text":" metadata for every flag, enforced by a single unit test rather than the wire format (the JSON stays dumb and fail-open). Declare a manifest with the type-erasing factories — "},{"type":"codeVoice","code":"owner"},{"type":"text","text":" and "},{"type":"codeVoice","code":"expires"},{"type":"text","text":" are non-optional, so a flag can’t be registered without them — and the keys are single-sourced from the typed flag declarations:"}],"type":"paragraph"},{"type":"codeListing","code":["enum FlagManifest {","    static let all: [FlagDescriptor] = [","        .bool(.newOnboarding, owner: \"growth\",","              expires: Date(timeIntervalSince1970: 1_788_000_000), purpose: \"New onboarding flow\"),","        .variant(.checkoutLayout, owner: \"checkout\",","                 expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Checkout A\/B\"),","    ]","}","","@Test func noForeverFlags() {","    let report = FlagGovernance.expirationReport(FlagManifest.all)","    #expect(report == nil, \"\\(report ?? \"\")\")   \/\/ failure names each expired flag + owner","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"When a flag passes its expiry, the test fails and the report names the flag, its owner, and how long it’s been expired — so a stale flag gets retired instead of living forever. This has no effect on runtime evaluation."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The manifest is the single declaration site, so a typed flag key never added to it escapes governance. Closing that gap fully would need a macro; until then, convention plus code review covers it."}]}],"type":"aside","name":"Note","style":"note"},{"type":"heading","level":2,"text":"Exposure tracking","anchor":"Exposure-tracking"},{"inlineContent":[{"type":"text","text":"A\/B testing is only analytically valid if you know which users actually saw each variant — bucketing alone is insufficient because the code path branching on the flag might never execute."}],"type":"paragraph"},{"type":"codeListing","code":["store.send(.featureFlags(.recordExposure(key: \"checkout_layout\")))"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Or via the SwiftUI sugar:"}],"type":"paragraph"},{"type":"codeListing","code":["WizardView()","    .recordsExposure(of: .checkoutLayout, store: store, action: AppAction.featureFlags)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The plugin dedupes per session and fires the optional "},{"type":"codeVoice","code":"onExposure"},{"type":"text","text":" callback (passed at plugin init). Wire that callback to your analytics plugin to forward exposures as events."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Refresh policy","anchor":"Refresh-policy"},{"type":"codeListing","code":["public enum RefreshPolicy: Sendable {","    case manual                                      \/\/ every .refresh fetches","    case automatic(minInterval: TimeInterval)        \/\/ debounce; default 300s","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Apps dispatch "},{"type":"codeVoice","code":".refresh"},{"type":"text","text":" from "},{"type":"codeVoice","code":"App.scenePhase"},{"type":"text","text":" transitions; the plugin’s debouncing makes this safe to call frequently. The plugin does not subscribe to "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" notifications — wiring stays in the host app."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Service protocol","anchor":"Service-protocol"},{"type":"codeListing","code":["public protocol FeatureFlagsService: Sendable {","    func fetch() async throws -> FeatureFlagsConfig","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"One method. Caching, hydration, evaluation all live in the plugin."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Built-in: `HTTPFeatureFlagsService`","anchor":"Built-in-HTTPFeatureFlagsService"},{"inlineContent":[{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" + "},{"type":"codeVoice","code":"JSONDecoder"},{"type":"text","text":". Apps host their JSON anywhere — static file on a CDN, Cloudflare Worker, their own server. Zero backend infrastructure required. "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"type":"text","text":" is a runnable shared Worker serving flags + killswitch for a whole portfolio from one URL ("},{"type":"codeVoice","code":"GET \/<appID>\/flags"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The URL must be "},{"type":"strong","inlineContent":[{"type":"text","text":"HTTPS"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"http"},{"type":"text","text":" is allowed only for "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":" development servers; anything else is a precondition failure at init). Responses over 1 MB and non-2xx statuses throw, and malformed variant definitions (empty array, negative weights, weights not summing to 100) fail decoding — in every case the plugin keeps its last-known-good cached config."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Third-party adapters (LaunchDarkly, GrowthBook, Statsig) conform to the same protocol without changing the plugin."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Typed flag keys","anchor":"Typed-flag-keys"},{"type":"codeListing","code":["public struct BoolFlag: Sendable, Hashable","public struct VariantFlag<Variant: RawRepresentable & Sendable> where Variant.RawValue == String","public struct ValueFlag<Value: Sendable>"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Read API on "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["state.isEnabled(.newOnboarding, default: false)","state.variant(of: .checkoutLayout)","state.value(of: .maxFreeUploads)"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Reads are pure synchronous functions. Per-property observation works as it does for any other state slice — views re-render only when the flag they read changes."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Action semantics (selected)","anchor":"Action-semantics-selected"},{"inlineContent":[{"type":"codeVoice","code":"refreshSucceeded(FeatureFlagsConfig, fetchedAt:)"},{"type":"text","text":" is dispatched on every "},{"type":"codeVoice","code":".refresh"},{"type":"text","text":" (including debounced refreshes that return an unchanged config). Consume config transitions by observing "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}],"sections":[],"kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},"seeAlsoSections":[{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"generated":true,"anchor":"Reference"}],"variants":[{"paths":["\/documentation\/swidux\/pluginfeatureflagsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"title":"UndoPlugin","url":"\/documentation\/swidux\/undoplugin","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}]},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","kind":"symbol","title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"title":"SwiduxPaywall Reference","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","url":"\/documentation\/swidux\/pluginpaywallreference","role":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"title":"Getting Started with Swidux","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","url":"\/documentation\/swidux\/gettingstarted","role":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"title":"EntityStore","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","url":"\/documentation\/swidux\/entitystoreguide","role":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","url":"\/documentation\/swidux\/pluginparentalgatereference","title":"SwiduxParentalGate Reference","kind":"article","role":"article","abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"title":"Troubleshooting","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","url":"\/documentation\/swidux\/troubleshooting","role":"article"},"doc://Swidux/documentation/Swidux/MacrosReference":{"kind":"article","title":"Macros","abstract":[{"text":"Reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" and its property markers (the SwiftData persistence bridge, shipped in ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":").","type":"text"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","url":"\/documentation\/swidux\/macrosreference","role":"article"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"title":"KeyValueStore","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","url":"\/documentation\/swidux\/keyvaluestoreguide","role":"collectionGroup"},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"kind":"section","title":"Service-Result Actions and Transition Observation","url":"\/documentation\/swidux\/pluginarchitecture#Service-Result-Actions-and-Transition-Observation","abstract":[],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","title":"Add Feature Flags","role":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"kind":"article"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"abstract":[{"text":"Public API surface for the ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"title":"SwiduxKillswitch Reference","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","url":"\/documentation\/swidux\/pluginkillswitchreference","role":"article"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"title":"Persistence Middleware","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","url":"\/documentation\/swidux\/persistencemiddlewareguide","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"title":"SwiduxAnalytics Reference","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","url":"\/documentation\/swidux\/pluginanalyticsreference","role":"article"},"doc://Swidux/documentation/Swidux/UndoRedo":{"title":"Undo \/ Redo","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":".","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","url":"\/documentation\/swidux\/undoredo","role":"article","type":"topic","kind":"article"}}}