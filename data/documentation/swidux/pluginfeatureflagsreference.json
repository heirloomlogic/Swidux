{"kind":"article","variants":[{"paths":["\/documentation\/swidux\/pluginfeatureflagsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"SwiduxFeatureFlags Reference","role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},"abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference","title":"Reference"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" is a domain plugin that owns a ","type":"text"},{"code":"FeatureFlagsState","type":"codeVoice"},{"text":" slice, fetches a JSON wire format via a provider-agnostic ","type":"text"},{"code":"FeatureFlagsService","type":"codeVoice"},{"text":", and answers reads against state. Bucketing is pure FNV-1a so reads are synchronous and offline-capable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Three flag types from one wire format:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"boolean","type":"text"}],"type":"strong"},{"text":" — on\/off with rollout percentage (0–100).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"variant","type":"text"}],"type":"strong"},{"text":" — string-typed weighted variants for A\/B tests.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"value","type":"text"}],"type":"strong"},{"text":" — typed remote-tunable scalar (","type":"text"},{"type":"codeVoice","code":"Bool"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"String"},{"text":").","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Library-target","type":"heading","text":"Library target","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"type":"codeVoice","code":"import SwiduxFeatureFlags"}],"type":"paragraph"}]}]},{"anchor":"Wire-format","type":"heading","text":"Wire format","level":2},{"code":["{","  \"version\": 1,","  \"flags\": {","    \"new_onboarding\": { \"type\": \"boolean\", \"rollout\": 25 },","    \"checkout_layout\": {","      \"type\": \"variant\",","      \"variants\": [","        { \"value\": \"control\", \"weight\": 50 },","        { \"value\": \"treatment\", \"weight\": 50 }","      ]","    },","    \"max_free_uploads\": { \"type\": \"value\", \"value\": 5 }","  }","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"text":"The plugin rejects unknown ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" values and falls back to the last-known-good cache. Defaults always live in Swift at the call site — this keeps them type-checked and forces “what if missing?” thinking.","type":"text"}],"type":"paragraph"},{"anchor":"Bucketing-and-identity","type":"heading","text":"Bucketing and identity","level":2},{"inlineContent":[{"code":"bucket = FNV1a(bucketingID + \":\" + flagKey) % 100","type":"codeVoice"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Stable per ","type":"text"},{"type":"codeVoice","code":"(bucketingID, flagKey)"},{"text":" pair forever.","type":"text"}],"type":"strong"},{"text":" Same input always produces the same bucket.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Per-flag.","type":"text"}],"type":"strong"},{"text":" A user isn’t always in the “early” group across different flags.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Identity resolution.","type":"text"}],"type":"strong"},{"text":" When a ","type":"text"},{"type":"codeVoice","code":"userIDKeyPath"},{"text":" is configured ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" the current user ID is non-nil, that is used. Otherwise the ","type":"text"},{"inlineContent":[{"text":"device ID","type":"text"}],"type":"strong"},{"text":" is used (the plugin’s required ","type":"text"},{"type":"codeVoice","code":"deviceIDKeyPath"},{"text":"). Anonymous users get a stable per-install identity; logged-in users get stable cross-device assignment. A user’s variant ","type":"text"},{"inlineContent":[{"text":"can","type":"text"}],"type":"emphasis"},{"text":" shift once at login — acceptable for nearly all real use cases.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"FNV-1a was chosen because it’s simple, dependency-free, and matches GrowthBook’s algorithm so apps migrating from GrowthBook get compatible buckets.","type":"text"}],"type":"paragraph"},{"anchor":"The-device-ID-must-be-stable-across-reinstall","type":"heading","text":"The device ID must be stable across reinstall","level":3},{"inlineContent":[{"text":"Bucketing is only stable if the fallback identity is. The plugin takes a non-optional ","type":"text"},{"code":"deviceIDKeyPath: KeyPath<State, String>","type":"codeVoice"},{"text":" into your ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", so the ","type":"text"},{"inlineContent":[{"type":"text","text":"app"}],"type":"emphasis"},{"text":" owns the identity and the ","type":"text"},{"inlineContent":[{"type":"text","text":"same"}],"type":"emphasis"},{"text":" value can drive analytics (","type":"text"},{"code":"AnalyticsIdentity(userID: \\.deviceID, …)","type":"codeVoice"},{"text":") — one identity, so A\/B exposure correlates with the user analytics reports against.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Mint it once at launch with the shared core helper, backed by the Keychain so it survives reinstall, and seed it into the slice via ","type":"text"},{"code":"hydrated(from:deviceID:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["\/\/ In Store.configured()","let deviceID = KeychainKeyValueStore(service: \"com.example.app\").deviceIdentity()","","let plugin = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags, action: AppAction.featureFlags, extractAction: { … },","    service: service,","    deviceIDKeyPath: \\.deviceID,          \/\/ app-owned, Keychain-backed","    userIDKeyPath: \\.auth.currentUserID,  \/\/ optional; authed identity wins when set","    keyValueStore: kv",")","","let initial = AppState(","    featureFlags: .hydrated(from: kv, deviceID: deviceID),","    deviceID: deviceID",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":"-backed identity regenerates on reinstall (QA ad-hoc builds, test installs), which silently re-buckets users and breaks A\/B assignment — use ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" for the identity. The flags ","type":"text"},{"inlineContent":[{"type":"text","text":"config cache"}],"type":"emphasis"},{"text":" can still live in a lighter store.","type":"text"}],"type":"paragraph"},{"anchor":"Evaluation-order","type":"heading","text":"Evaluation order","level":2},{"inlineContent":[{"text":"For each read, in priority:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Local override present?","type":"text"}],"type":"strong"},{"text":" Return it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Flag in remote config?","type":"text"}],"type":"strong"},{"text":" Evaluate (rollout \/ variant assignment \/ value lookup).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Otherwise","type":"text"}],"type":"strong"},{"text":" return the Swift-side default.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Persistence","type":"heading","text":"Persistence","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Device ID","type":"text"}],"type":"strong"},{"text":" is app-owned and minted once via ","type":"text"},{"type":"codeVoice","code":"KeyValueStore.deviceIdentity()"},{"text":" (Keychain-backed). Seeded into the slice at ","type":"text"},{"type":"codeVoice","code":"FeatureFlagsState.hydrated(from:deviceID:)"},{"text":" and kept in sync from ","type":"text"},{"type":"codeVoice","code":"deviceIDKeyPath"},{"text":". The plugin no longer mints its own bucketing identity.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Last-known config","type":"text"}],"type":"strong"},{"text":" persisted after every successful refresh. Hydrates as fallback before first network success.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Local overrides","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" persisted by default. Restart = clean state.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"exposedKeys"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" persisted. New session = fresh exposure events.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Governance-no-forever-flags","type":"heading","text":"Governance: no forever flags","level":2},{"inlineContent":[{"text":"Owner and expiry are ","type":"text"},{"inlineContent":[{"type":"text","text":"required"}],"type":"strong"},{"text":" metadata for every flag, enforced by a single unit test rather than the wire format (the JSON stays dumb and fail-open). Declare a manifest with the type-erasing factories — ","type":"text"},{"code":"owner","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"expires","type":"codeVoice"},{"text":" are non-optional, so a flag can’t be registered without them — and the keys are single-sourced from the typed flag declarations:","type":"text"}],"type":"paragraph"},{"code":["enum FlagManifest {","    static let all: [FlagDescriptor] = [","        .bool(.newOnboarding, owner: \"growth\",","              expires: Date(timeIntervalSince1970: 1_788_000_000), purpose: \"New onboarding flow\"),","        .variant(.checkoutLayout, owner: \"checkout\",","                 expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Checkout A\/B\"),","    ]","}","","@Test func noForeverFlags() {","    let report = FlagGovernance.expirationReport(FlagManifest.all)","    #expect(report == nil, \"\\(report ?? \"\")\")   \/\/ failure names each expired flag + owner","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"When a flag passes its expiry, the test fails and the report names the flag, its owner, and how long it’s been expired — so a stale flag gets retired instead of living forever. This has no effect on runtime evaluation.","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":"The manifest is the single declaration site, so a typed flag key never added to it escapes governance. Closing that gap fully would need a macro; until then, convention plus code review covers it."}],"type":"paragraph"}]},{"anchor":"Exposure-tracking","type":"heading","text":"Exposure tracking","level":2},{"inlineContent":[{"text":"A\/B testing is only analytically valid if you know which users actually saw each variant — bucketing alone is insufficient because the code path branching on the flag might never execute.","type":"text"}],"type":"paragraph"},{"code":["store.send(.featureFlags(.recordExposure(key: \"checkout_layout\")))"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Or via the SwiftUI sugar:","type":"text"}],"type":"paragraph"},{"code":["WizardView()","    .recordsExposure(of: .checkoutLayout, store: store, action: AppAction.featureFlags)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The plugin dedupes per session and fires the optional ","type":"text"},{"code":"onExposure","type":"codeVoice"},{"text":" callback (passed at plugin init). Wire that callback to your analytics plugin to forward exposures as events.","type":"text"}],"type":"paragraph"},{"anchor":"Refresh-policy","type":"heading","text":"Refresh policy","level":2},{"code":["public enum RefreshPolicy: Sendable {","    case manual                                      \/\/ every .refresh fetches","    case automatic(minInterval: TimeInterval)        \/\/ debounce; default 300s","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Apps dispatch ","type":"text"},{"code":".refresh","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"App.scenePhase","type":"codeVoice"},{"text":" transitions; the plugin’s debouncing makes this safe to call frequently. The plugin does not subscribe to ","type":"text"},{"code":"UIApplication","type":"codeVoice"},{"text":" notifications — wiring stays in the host app.","type":"text"}],"type":"paragraph"},{"anchor":"Service-protocol","type":"heading","text":"Service protocol","level":2},{"code":["public protocol FeatureFlagsService: Sendable {","    func fetch() async throws -> FeatureFlagsConfig","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"One method. Caching, hydration, evaluation all live in the plugin.","type":"text"}],"type":"paragraph"},{"anchor":"Built-in-HTTPFeatureFlagsService","type":"heading","text":"Built-in: `HTTPFeatureFlagsService`","level":3},{"inlineContent":[{"code":"URLSession","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"JSONDecoder","type":"codeVoice"},{"text":". Apps host their JSON anywhere — static file on a CDN, Cloudflare Worker, their own server. Zero backend infrastructure required. ","type":"text"},{"code":"Examples\/ConfigWorker\/","type":"codeVoice"},{"text":" is a runnable shared Worker serving flags + killswitch for a whole portfolio from one URL (","type":"text"},{"code":"GET \/<appID>\/flags","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The URL must be ","type":"text"},{"inlineContent":[{"type":"text","text":"HTTPS"}],"type":"strong"},{"text":" (","type":"text"},{"code":"http","type":"codeVoice"},{"text":" is allowed only for ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":" development servers; anything else is a precondition failure at init). Responses over 1 MB and non-2xx statuses throw, and malformed variant definitions (empty array, negative weights, weights not summing to 100) fail decoding — in every case the plugin keeps its last-known-good cached config.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Third-party adapters (LaunchDarkly, GrowthBook, Statsig) conform to the same protocol without changing the plugin.","type":"text"}],"type":"paragraph"},{"anchor":"Typed-flag-keys","type":"heading","text":"Typed flag keys","level":2},{"code":["public struct BoolFlag: Sendable, Hashable","public struct VariantFlag<Variant: RawRepresentable & Sendable> where Variant.RawValue == String","public struct ValueFlag<Value: Sendable>"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Read API on ","type":"text"},{"code":"FeatureFlagsState","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["state.isEnabled(.newOnboarding, default: false)","state.variant(of: .checkoutLayout)","state.value(of: .maxFreeUploads)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Reads are pure synchronous functions. Per-property observation works as it does for any other state slice — views re-render only when the flag they read changes.","type":"text"}],"type":"paragraph"},{"anchor":"Action-semantics-selected","type":"heading","text":"Action semantics (selected)","level":2},{"inlineContent":[{"code":"refreshSucceeded(FeatureFlagsConfig, fetchedAt:)","type":"codeVoice"},{"text":" is dispatched on every ","type":"text"},{"code":".refresh","type":"codeVoice"},{"text":" (including debounced refreshes that return an unchanged config). Consume config transitions by observing ","type":"text"},{"code":"FeatureFlagsState","type":"codeVoice"},{"text":" or a value derived from it — not by mapping this action. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"references":{"doc://Swidux/documentation/Swidux":{"role":"collection","url":"\/documentation\/swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","type":"topic","title":"Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"url":"\/documentation\/swidux\/pluginkillswitchreference","kind":"article","abstract":[{"text":"Public API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","type":"topic","title":"SwiduxKillswitch Reference","role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"url":"\/documentation\/swidux\/undoplugin","kind":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"topic","title":"UndoPlugin","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"title":"Add Feature Flags","url":"\/documentation\/swidux\/howtoaddfeatureflags","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"kind":"article","type":"topic"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"url":"\/documentation\/swidux\/pluginparentalgatereference","kind":"article","abstract":[{"text":"API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","type":"topic","title":"SwiduxParentalGate Reference","role":"article"},"doc://Swidux/documentation/Swidux/UndoRedo":{"url":"\/documentation\/swidux\/undoredo","kind":"article","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":".","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"topic","title":"Undo \/ Redo","role":"article"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"url":"\/documentation\/swidux\/persistencemiddlewareguide","kind":"article","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"topic","title":"Persistence Middleware","role":"article"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"url":"\/documentation\/swidux\/keyvaluestoreguide","kind":"article","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"title":"KeyValueStore","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","role":"collectionGroup"},"doc://Swidux/documentation/Swidux/MacrosReference":{"kind":"article","url":"\/documentation\/swidux\/macrosreference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","abstract":[{"text":"Reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":").","type":"text"}],"title":"Macros","role":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"title":"Service-Result Actions and Transition Observation","abstract":[],"type":"topic","kind":"section","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","url":"\/documentation\/swidux\/pluginarchitecture#Service-Result-Actions-and-Transition-Observation"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"url":"\/documentation\/swidux\/pluginpaywallreference","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic","title":"SwiduxPaywall Reference","role":"article"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"url":"\/documentation\/swidux\/troubleshooting","kind":"article","abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","type":"topic","title":"Troubleshooting","role":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"url":"\/documentation\/swidux\/entitystoreguide","kind":"article","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"topic","title":"EntityStore","role":"article"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"url":"\/documentation\/swidux\/pluginanalyticsreference","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","type":"topic","title":"SwiduxAnalytics Reference","role":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"url":"\/documentation\/swidux\/gettingstarted","kind":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","title":"Getting Started with Swidux","role":"article"}}}