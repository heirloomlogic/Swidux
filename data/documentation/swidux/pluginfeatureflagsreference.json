{"sections":[],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","interfaceLanguage":"swift"},"abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"metadata":{"role":"article","title":"SwiduxFeatureFlags Reference","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"kind":"article","seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"title":"Reference","anchor":"Reference"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" is a domain plugin that owns a ","type":"text"},{"code":"FeatureFlagsState","type":"codeVoice"},{"text":" slice, fetches a JSON wire format via a provider-agnostic ","type":"text"},{"code":"FeatureFlagsService","type":"codeVoice"},{"text":", and answers reads against state. Bucketing is pure FNV-1a so reads are synchronous and offline-capable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three flag types from one wire format:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"boolean"}]},{"type":"text","text":" — on\/off with rollout percentage (0–100)."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"variant"}]},{"text":" — string-typed weighted variants for A\/B tests.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"value"}]},{"text":" — typed remote-tunable scalar (","type":"text"},{"type":"codeVoice","code":"Bool"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Int"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Double"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"String"},{"text":").","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Library target","level":2,"type":"heading","anchor":"Library-target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxFeatureFlags"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"type":"codeVoice","code":"import SwiduxFeatureFlags"}],"type":"paragraph"}]}]},{"text":"Wire format","level":2,"type":"heading","anchor":"Wire-format"},{"code":["{","  \"version\": 1,","  \"flags\": {","    \"new_onboarding\": { \"type\": \"boolean\", \"rollout\": 25 },","    \"checkout_layout\": {","      \"type\": \"variant\",","      \"variants\": [","        { \"value\": \"control\", \"weight\": 50 },","        { \"value\": \"treatment\", \"weight\": 50 }","      ]","    },","    \"max_free_uploads\": { \"type\": \"value\", \"value\": 5 }","  }","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"text":"The plugin rejects unknown ","type":"text"},{"code":"version","type":"codeVoice"},{"type":"text","text":" values and falls back to the last-known-good cache. Defaults always live in Swift at the call site — this keeps them type-checked and forces “what if missing?” thinking."}]},{"anchor":"Bucketing-and-identity","level":2,"type":"heading","text":"Bucketing and identity"},{"type":"paragraph","inlineContent":[{"code":"bucket = FNV1a(bucketingID + \":\" + flagKey) % 100","type":"codeVoice"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Stable per ","type":"text"},{"code":"(bucketingID, flagKey)","type":"codeVoice"},{"text":" pair forever.","type":"text"}],"type":"strong"},{"type":"text","text":" Same input always produces the same bucket."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Per-flag."}],"type":"strong"},{"text":" A user isn’t always in the “early” group across different flags.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Identity resolution."}],"type":"strong"},{"type":"text","text":" When a "},{"type":"codeVoice","code":"userIDKeyPath"},{"type":"text","text":" is configured "},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" the current user ID is non-nil, that is used. Otherwise the install ID is used. Anonymous users get a stable per-install identity; logged-in users get stable cross-device assignment. A user’s variant "},{"inlineContent":[{"type":"text","text":"can"}],"type":"emphasis"},{"text":" shift once at login — acceptable for nearly all real use cases.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"FNV-1a was chosen because it’s simple, dependency-free, and matches GrowthBook’s algorithm so apps migrating from GrowthBook get compatible buckets."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Evaluation order","anchor":"Evaluation-order"},{"type":"paragraph","inlineContent":[{"text":"For each read, in priority:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Local override present?"}],"type":"strong"},{"type":"text","text":" Return it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Flag in remote config?"}]},{"type":"text","text":" Evaluate (rollout \/ variant assignment \/ value lookup)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Otherwise","type":"text"}],"type":"strong"},{"text":" return the Swift-side default.","type":"text"}]}]}]},{"level":2,"type":"heading","text":"Persistence","anchor":"Persistence"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Install ID"}]},{"text":" persisted to ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":" on first generation. Read at hydration via "},{"type":"codeVoice","code":"FeatureFlagsState.hydrated(from:defaultConfig:)"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Last-known config"}]},{"type":"text","text":" persisted after every successful refresh. Hydrates as fallback before first network success."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Local overrides"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" persisted by default. Restart = clean state."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"exposedKeys"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" persisted. New session = fresh exposure events."}]}]}]},{"type":"heading","anchor":"Exposure-tracking","level":2,"text":"Exposure tracking"},{"type":"paragraph","inlineContent":[{"text":"A\/B testing is only analytically valid if you know which users actually saw each variant — bucketing alone is insufficient because the code path branching on the flag might never execute.","type":"text"}]},{"code":["store.send(.featureFlags(.recordExposure(key: \"checkout_layout\")))"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or via the SwiftUI sugar:"}]},{"syntax":"swift","type":"codeListing","code":["WizardView()","    .recordsExposure(of: .checkoutLayout, store: store, action: AppAction.featureFlags)"]},{"type":"paragraph","inlineContent":[{"text":"The plugin dedupes per session and fires the optional ","type":"text"},{"code":"onExposure","type":"codeVoice"},{"text":" callback (passed at plugin init). Wire that callback to your analytics plugin to forward exposures as events.","type":"text"}]},{"text":"Refresh policy","level":2,"type":"heading","anchor":"Refresh-policy"},{"code":["public enum RefreshPolicy: Sendable {","    case manual                                      \/\/ every .refresh fetches","    case automatic(minInterval: TimeInterval)        \/\/ debounce; default 300s","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apps dispatch "},{"type":"codeVoice","code":".refresh"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"App.scenePhase"},{"type":"text","text":" transitions; the plugin’s debouncing makes this safe to call frequently. The plugin does not subscribe to "},{"code":"UIApplication","type":"codeVoice"},{"type":"text","text":" notifications — wiring stays in the host app."}]},{"type":"heading","text":"Service protocol","leve