{"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"generated":true,"anchor":"Reference","title":"Reference"}],"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" is a domain plugin that owns a "},{"code":"FeatureFlagsState","type":"codeVoice"},{"type":"text","text":" slice, fetches a JSON wire format via a provider-agnostic "},{"code":"FeatureFlagsService","type":"codeVoice"},{"type":"text","text":", and answers reads against state. Bucketing is pure FNV-1a so reads are synchronous and offline-capable."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three flag types from one wire format:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"boolean"}],"type":"strong"},{"text":" — on\/off with rollout percentage (0–100).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"variant"}],"type":"strong"},{"text":" — string-typed weighted variants for A\/B tests.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"value"}],"type":"strong"},{"text":" — typed remote-tunable scalar (","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"String","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},{"type":"text","text":"."}]},{"anchor":"Library-target","type":"heading","level":2,"text":"Library target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxFeatureFlags","type":"codeVoice"}],"type":"paragraph"}]}]},{"anchor":"Wire-format","type":"heading","level":2,"text":"Wire format"},{"type":"codeListing","code":["{","  \"version\": 1,","  \"flags\": {","    \"new_onboarding\": { \"type\": \"boolean\", \"rollout\": 25 },","    \"checkout_layout\": {","      \"type\": \"variant\",","      \"variants\": [","        { \"value\": \"control\", \"weight\": 50 },","        { \"value\": \"treatment\", \"weight\": 50 }","      ]","    },","    \"max_free_uploads\": { \"type\": \"value\", \"value\": 5 }","  }","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin rejects unknown "},{"code":"version","type":"codeVoice"},{"type":"text","text":" values and falls back to the last-known-good cache. Defaults always live in Swift at the call site — this keeps them type-checked and forces “what if missing?” thinking."}]},{"anchor":"Bucketing-and-identity","type":"heading","level":2,"text":"Bucketing and identity"},{"type":"paragraph","inlineContent":[{"code":"bucket = FNV1a(bucketingID + \":\" + flagKey) % 100","type":"codeVoice"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Stable per "},{"type":"codeVoice","code":"(bucketingID, flagKey)"},{"type":"text","text":" pair forever."}],"type":"strong"},{"text":" Same input always produces the same bucket.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Per-flag."}],"type":"strong"},{"text":" A user isn’t always in the “early” group across different flags.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Identity resolution."}],"type":"strong"},{"text":" When a ","type":"text"},{"code":"userIDKeyPath","type":"codeVoice"},{"text":" is configured ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"text":" the current user ID is non-nil, that is used. Otherwise the ","type":"text"},{"inlineContent":[{"type":"text","text":"device ID"}],"type":"strong"},{"text":" is used (the plugin’s required ","type":"text"},{"code":"deviceIDKeyPath","type":"codeVoice"},{"text":"). Anonymous users get a stable per-install identity; logged-in users get stable cross-device assignment. A user’s variant ","type":"text"},{"inlineContent":[{"type":"text","text":"can"}],"type":"emphasis"},{"text":" shift once at login — acceptable for nearly all real use cases.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"FNV-1a was chosen because it’s simple, dependency-free, and matches GrowthBook’s algorithm so apps migrating from GrowthBook get compatible buckets."}]},{"anchor":"The-device-ID-must-be-stable-across-reinstall","type":"heading","level":3,"text":"The device ID must be stable across reinstall"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bucketing is only stable if the fallback identity is. The plugin takes a non-optional "},{"code":"deviceIDKeyPath: KeyPath<State, String>","type":"codeVoice"},{"type":"text","text":" into your "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", so the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"app"}]},{"type":"text","text":" owns the identity and the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"same"}]},{"type":"text","text":" value can drive analytics ("},{"code":"AnalyticsIdentity(userID: \\.deviceID, …)","type":"codeVoice"},{"type":"text","text":") — one identity, so A\/B exposure correlates with the user analytics reports against."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mint it once at launch with the shared core helper, backed by the Keychain so it survives reinstall, and seed it into the slice via "},{"code":"hydrated(from:deviceID:)","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["\/\/ In Store.configured()","let deviceID = KeychainKeyValueStore(service: \"com.example.app\").deviceIdentity()","","let plugin = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags, action: AppAction.featureFlags, extractAction: { … },","    service: service,","    deviceIDKeyPath: \\.deviceID,          \/\/ app-owned, Keychain-backed","    userIDKeyPath: \\.auth.currentUserID,  \/\/ optional; authed identity wins when set","    keyValueStore: kv",")","","let initial = AppState(","    featureFlags: .hydrated(from: kv, deviceID: deviceID),","    deviceID: deviceID",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":"-backed identity regenerates on reinstall (QA ad-hoc builds, test installs), which silently re-buckets users and breaks A\/B assignment — use "},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" for the identity. The flags "},{"type":"emphasis","inlineContent":[{"type":"text","text":"config cache"}]},{"type":"text","text":" can still live in a lighter store."}]},{"anchor":"Evaluation-order","type":"heading","level":2,"text":"Evaluation order"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For each read, in priority:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Local override present?"}],"type":"strong"},{"text":" Return it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Flag in remote config?"}],"type":"strong"},{"text":" Evaluate (rollout \/ variant assignment \/ value lookup).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Otherwise"}],"type":"strong"},{"text":" return the Swift-side default.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Persistence","type":"heading","level":2,"text":"Persistence"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Device ID"}],"type":"strong"},{"text":" is app-owned and minted once via ","type":"text"},{"code":"KeyValueStore.deviceIdentity()","type":"codeVoice"},{"text":" (Keychain-backed). Seeded into the slice at ","type":"text"},{"code":"FeatureFlagsState.hydrated(from:deviceID:)","type":"codeVoice"},{"type":"text","text":" and kept in sync from "},{"type":"codeVoice","code":"deviceIDKeyPath"},{"type":"text","text":". The plugin no longer mints its own bucketing identity."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Last-known config"}]},{"type":"text","text":" persisted after every successful refresh. Hydrates as fallback before first network success."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Local overrides"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" persisted by default. Restart = clean state."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"exposedKeys","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" persisted. New session = fresh exposure events.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Governance-no-forever-flags","type":"heading","level":2,"text":"Governance: no forever flags"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Owner and expiry are "},{"type":"strong","inlineContent":[{"type":"text","text":"required"}]},{"type":"text","text":" metadata for every flag, enforced by a single unit test rather than the wire format (the JSON stays dumb and fail-open). Declare a manifest with the type-erasing factories — "},{"code":"owner","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"expires"},{"type":"text","text":" are non-optional, so a flag can’t be registered without them — and the keys are single-sourced from the typed flag declarations:"}]},{"type":"codeListing","code":["enum FlagManifest {","    static let all: [FlagDescriptor] = [","        .bool(.newOnboarding, owner: \"growth\",","              expires: Date(timeIntervalSince1970: 1_788_000_000), purpose: \"New onboarding flow\"),","        .variant(.checkoutLayout, owner: \"checkout\",","                 expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Checkout A\/B\"),","    ]","}","","@Test func noForeverFlags() {","    let report = FlagGovernance.expirationReport(FlagManifest.all)","    #expect(report == nil, \"\\(report ?? \"\")\")   \/\/ failure names each expired flag + owner","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a flag passes its expiry, the test fails and the report names the flag, its owner, and how long it’s been expired — so a stale flag gets retired instead of living forever. This has no effect on runtime evaluation."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The manifest is the single declaration site, so a typed flag key never added to it escapes governance. Closing that gap fully would need a macro; until then, convention plus code review covers it."}]}],"style":"note","type":"aside","name":"Note"},{"level":2,"type":"heading","text":"Exposure tracking","anchor":"Exposure-tracking"},{"inlineContent":[{"type":"text","text":"A\/B testing is only analytically valid if you know which users actually saw each variant — bucketing alone is insufficient because the code path branching on the flag might never execute."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["store.send(.featureFlags(.recordExposure(key: \"checkout_layout\")))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or via the SwiftUI sugar:"}]},{"code":["WizardView()","    .recordsExposure(of: .checkoutLayout, store: store, action: AppAction.featureFlags)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin dedupes per session and fires the optional "},{"type":"codeVoice","code":"onExposure"},{"type":"text","text":" callback (passed at plugin init). Wire that callback to your analytics plugin to forward exposures as events."}]},{"anchor":"Refresh-policy","type":"heading","level":2,"text":"Refresh policy"},{"code":["public enum RefreshPolicy: Sendable {","    case manual                                      \/\/ every .refresh fetches","    case automatic(minInterval: TimeInterval)        \/\/ debounce; default 300s","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Apps dispatch "},{"type":"codeVoice","code":".refresh"},{"type":"text","text":" from "},{"type":"codeVoice","code":"App.scenePhase"},{"type":"text","text":" transitions; the plugin’s debouncing makes this safe to call frequently. The plugin does not subscribe to "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" notifications — wiring stays in the host app."}]},{"anchor":"Service-protocol","type":"heading","level":2,"text":"Service protocol"},{"code":["public protocol FeatureFlagsService: Sendable {","    func fetch() async throws -> FeatureFlagsConfig","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"One method. Caching, hydration, evaluation all live in the plugin."}]},{"anchor":"Built-in-HTTPFeatureFlagsService","type":"heading","level":3,"text":"Built-in: `HTTPFeatureFlagsService`"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" + "},{"type":"codeVoice","code":"JSONDecoder"},{"type":"text","text":". Apps host their JSON anywhere — static file on a CDN, Cloudflare Worker, their own server. Zero backend infrastructure required. "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"type":"text","text":" is a runnable shared Worker serving flags + killswitch for a whole portfolio from one URL ("},{"type":"codeVoice","code":"GET \/<appID>\/flags"},{"type":"text","text":")."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The URL must be "},{"type":"strong","inlineContent":[{"text":"HTTPS","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"http"},{"type":"text","text":" is allowed only for "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":" development servers; anything else is a precondition failure at init). Responses over 1 MB and non-2xx statuses throw, and malformed variant definitions (empty array, negative weights, weights not summing to 100) fail decoding — in every case the plugin keeps its last-known-good cached config."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Third-party adapters (LaunchDarkly, GrowthBook, Statsig) conform to the same protocol without changing the plugin."}]},{"anchor":"Typed-flag-keys","type":"heading","level":2,"text":"Typed flag keys"},{"code":["public struct BoolFlag: Sendable, Hashable","public struct VariantFlag<Variant: RawRepresentable & Sendable> where Variant.RawValue == String","public struct ValueFlag<Value: Sendable>"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read API on "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":":"}]},{"code":["state.isEnabled(.newOnboarding, default: false)","state.variant(of: .checkoutLayout)","state.value(of: .maxFreeUploads)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reads are pure synchronous functions. Per-property observation works as it does for any other state slice — views re-render only when the flag they read changes."}]},{"anchor":"Action-semantics-selected","type":"heading","level":2,"text":"Action semantics (selected)"},{"type":"paragraph","inlineContent":[{"code":"refreshSucceeded(FeatureFlagsConfig, fetchedAt:)","type":"codeVoice"},{"text":" is dispatched on every ","type":"text"},{"code":".refresh","type":"codeVoice"},{"type":"text","text":" (including debounced refreshes that return an unchanged config). Consume config transitions by observing "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true},{"type":"text","text":"."}]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article","title":"SwiduxFeatureFlags Reference"},"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"variants":[{"paths":["\/documentation\/swidux\/pluginfeatureflagsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","url":"\/documentation\/swidux\/pluginanalyticsreference","type":"topic","title":"SwiduxAnalytics Reference","role":"article","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}]},"doc://Swidux/documentation/Swidux/MacrosReference":{"role":"article","abstract":[{"type":"text","text":"Reference for "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" and "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":")."}],"title":"Macros","kind":"article","type":"topic","url":"\/documentation\/swidux\/macrosreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"role":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"title":"SwiduxPaywall Reference","type":"topic","url":"\/documentation\/swidux\/pluginpaywallreference","kind":"article","ide