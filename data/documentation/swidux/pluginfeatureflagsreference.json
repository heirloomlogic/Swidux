{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"kind":"article","primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" is a domain plugin that owns a "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":" slice, fetches a JSON wire format via a provider-agnostic "},{"type":"codeVoice","code":"FeatureFlagsService"},{"type":"text","text":", and answers reads against state. Bucketing is pure FNV-1a so reads are synchronous and offline-capable."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Three flag types from one wire format:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"boolean","type":"text"}]},{"type":"text","text":" — on\/off with rollout percentage (0–100)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"variant"}],"type":"strong"},{"type":"text","text":" — string-typed weighted variants for A\/B tests."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"value"}]},{"type":"text","text":" — typed remote-tunable scalar ("},{"code":"Bool","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Int","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"Double","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"String","type":"codeVoice"},{"type":"text","text":")."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Library-target","text":"Library target","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxFeatureFlags"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxFeatureFlags"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Wire-format","text":"Wire format"},{"type":"codeListing","syntax":"json","code":["{","  \"version\": 1,","  \"flags\": {","    \"new_onboarding\": { \"type\": \"boolean\", \"rollout\": 25 },","    \"checkout_layout\": {","      \"type\": \"variant\",","      \"variants\": [","        { \"value\": \"control\", \"weight\": 50 },","        { \"value\": \"treatment\", \"weight\": 50 }","      ]","    },","    \"max_free_uploads\": { \"type\": \"value\", \"value\": 5 }","  }","}"]},{"inlineContent":[{"type":"text","text":"The plugin rejects unknown "},{"type":"codeVoice","code":"version"},{"type":"text","text":" values and falls back to the last-known-good cache. Defaults always live in Swift at the call site — this keeps them type-checked and forces “what if missing?” thinking."}],"type":"paragraph"},{"anchor":"Bucketing-and-identity","type":"heading","level":2,"text":"Bucketing and identity"},{"inlineContent":[{"type":"codeVoice","code":"bucket = FNV1a(bucketingID + \":\" + flagKey) % 100"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Stable per "},{"type":"codeVoice","code":"(bucketingID, flagKey)"},{"type":"text","text":" pair forever."}]},{"type":"text","text":" Same input always produces the same bucket."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Per-flag."}]},{"text":" A user isn’t always in the “early” group across different flags.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Identity resolution."}]},{"type":"text","text":" When a "},{"code":"userIDKeyPath","type":"codeVoice"},{"type":"text","text":" is configured "},{"inlineContent":[{"type":"text","text":"and"}],"type":"emphasis"},{"type":"text","text":" the current user ID is non-nil, that is used. Otherwise the "},{"inlineContent":[{"type":"text","text":"device ID"}],"type":"strong"},{"type":"text","text":" is used (the plugin’s required "},{"type":"codeVoice","code":"deviceIDKeyPath"},{"type":"text","text":"). Anonymous users get a stable per-install identity; logged-in users get stable cross-device assignment. A user’s variant "},{"inlineContent":[{"type":"text","text":"can"}],"type":"emphasis"},{"type":"text","text":" shift once at login — acceptable for nearly all real use cases."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"FNV-1a was chosen because it’s simple, dependency-free, and matches GrowthBook’s algorithm so apps migrating from GrowthBook get compatible buckets.","type":"text"}]},{"anchor":"The-device-ID-must-be-stable-across-reinstall","type":"heading","level":3,"text":"The device ID must be stable across reinstall"},{"type":"paragraph","inlineContent":[{"text":"Bucketing is only stable if the fallback identity is. The plugin takes a non-optional ","type":"text"},{"type":"codeVoice","code":"deviceIDKeyPath: KeyPath<State, String>"},{"text":" into your ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", so the ","type":"text"},{"inlineContent":[{"type":"text","text":"app"}],"type":"emphasis"},{"text":" owns the identity and the ","type":"text"},{"inlineContent":[{"type":"text","text":"same"}],"type":"emphasis"},{"type":"text","text":" value can drive analytics ("},{"type":"codeVoice","code":"AnalyticsIdentity(userID: \\.deviceID, …)"},{"type":"text","text":") — one identity, so A\/B exposure correlates with the user analytics reports against."}]},{"inlineContent":[{"type":"text","text":"Mint it once at launch with the shared core helper, backed by the Keychain so it survives reinstall, and seed it into the slice via "},{"type":"codeVoice","code":"hydrated(from:deviceID:)"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ In Store.configured()","let deviceID = KeychainKeyValueStore(service: \"com.example.app\").deviceIdentity()","","let plugin = FeatureFlagsPlugin<AppState, AppAction>(","    state: \\.featureFlags, action: AppAction.featureFlags, extractAction: { … },","    service: service,","    deviceIDKeyPath: \\.deviceID,          \/\/ app-owned, Keychain-backed","    userIDKeyPath: \\.auth.currentUserID,  \/\/ optional; authed identity wins when set","    keyValueStore: kv",")","","let initial = AppState(","    featureFlags: .hydrated(from: kv, deviceID: deviceID),","    deviceID: deviceID",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":"-backed identity regenerates on reinstall (QA ad-hoc builds, test installs), which silently re-buckets users and breaks A\/B assignment — use "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" for the identity. The flags "},{"inlineContent":[{"type":"text","text":"config cache"}],"type":"emphasis"},{"text":" can still live in a lighter store.","type":"text"}]},{"level":2,"type":"heading","anchor":"Evaluation-order","text":"Evaluation order"},{"inlineContent":[{"type":"text","text":"For each read, in priority:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Local override present?","type":"text"}]},{"type":"text","text":" Return it."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Flag in remote config?"}]},{"type":"text","text":" Evaluate (rollout \/ variant assignment \/ value lookup)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Otherwise","type":"text"}]},{"text":" return the Swift-side default.","type":"text"}]}]}],"type":"orderedList"},{"text":"Persistence","type":"heading","anchor":"Persistence","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Device ID"}],"type":"strong"},{"text":" is app-owned and minted once via ","type":"text"},{"type":"codeVoice","code":"KeyValueStore.deviceIdentity()"},{"text":" (Keychain-backed). Seeded into the slice at ","type":"text"},{"type":"codeVoice","code":"FeatureFlagsState.hydrated(from:deviceID:)"},{"text":" and kept in sync from ","type":"text"},{"type":"codeVoice","code":"deviceIDKeyPath"},{"text":". The plugin no longer mints its own bucketing identity.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Last-known config"}]},{"type":"text","text":" persisted after every successful refresh. Hydrates as fallback before first network success."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Local overrides"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" persisted by default. Restart = clean state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"exposedKeys"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" persisted. New session = fresh exposure events."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Governance-no-forever-flags","text":"Governance: no forever flags","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Owner and expiry are "},{"inlineContent":[{"type":"text","text":"required"}],"type":"strong"},{"type":"text","text":" metadata for every flag, enforced by a single unit test rather than the wire format (the JSON stays dumb and fail-open). Declare a manifest with the type-erasing factories — "},{"type":"codeVoice","code":"owner"},{"type":"text","text":" and "},{"type":"codeVoice","code":"expires"},{"type":"text","text":" are non-optional, so a flag can’t be registered without them — and the keys are single-sourced from the typed flag declarations:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["enum FlagManifest {","    static let all: [FlagDescriptor] = [","        .bool(.newOnboarding, owner: \"growth\",","              expires: Date(timeIntervalSince1970: 1_788_000_000), purpose: \"New onboarding flow\"),","        .variant(.checkoutLayout, owner: \"checkout\",","                 expires: Date(timeIntervalSince1970: 1_785_000_000), purpose: \"Checkout A\/B\"),","    ]","}","","@Test func noForeverFlags() {","    let report = FlagGovernance.expirationReport(FlagManifest.all)","    #expect(report == nil, \"\\(report ?? \"\")\")   \/\/ failure names each expired flag + owner","}"]},{"inlineContent":[{"type":"text","text":"When a flag passes its expiry, the test fails and the report names the flag, its owner, and how long it’s been expired — so a stale flag gets retired instead of living forever. This has no effect on runtime evaluation."}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":"The manifest is the single declaration site, so a typed flag key never added to it escapes governance. Closing that gap fully would need a macro; until then, convention plus code review covers it."}],"type":"paragraph"}]},{"anchor":"Exposure-tracking","text":"Exposure tracking","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A\/B testing is only analytically valid if you know which users actually saw each variant — bucketing alone is insufficient because the code path branching on the flag might never execute."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["store.send(.featureFlags(.recordExposure(key: \"checkout_layout\")))"]},{"inlineContent":[{"type":"text","text":"Or via the SwiftUI sugar:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["WizardView()","    .recordsExposure(of: .checkoutLayout, store: store, action: AppAction.featureFlags)"]},{"inlineContent":[{"type":"text","text":"The plugin dedupes per session and fires the optional "},{"type":"codeVoice","code":"onExposure"},{"type":"text","text":" callback (passed at plugin init). Wire that callback to your analytics plugin to forward exposures as events."}],"type":"paragraph"},{"anchor":"Refresh-policy","text":"Refresh policy","type":"heading","level":2},{"type":"codeListing","syntax":"swift","code":["public enum RefreshPolicy: Sendable {","    case manual                                      \/\/ every .refresh fetches","    case automatic(minInterval: TimeInterval)        \/\/ debounce; default 300s","}"]},{"inlineContent":[{"type":"text","text":"Apps dispatch "},{"type":"codeVoice","code":".refresh"},{"type":"text","text":" from "},{"type":"codeVoice","code":"App.scenePhase"},{"type":"text","text":" transitions; the plugin’s debouncing makes this safe to call frequently. The plugin does not subscribe to "},{"type":"codeVoice","code":"UIApplication"},{"type":"text","text":" notifications — wiring stays in the host app."}],"type":"paragraph"},{"anchor":"Service-protocol","text":"Service protocol","type":"heading","level":2},{"type":"codeListing","syntax":"swift","code":["public protocol FeatureFlagsService: Sendable {","    func fetch() async throws -> FeatureFlagsConfig","}"]},{"inlineContent":[{"type":"text","text":"One method. Caching, hydration, evaluation all live in the plugin."}],"type":"paragraph"},{"anchor":"Built-in-HTTPFeatureFlagsService","text":"Built-in: `HTTPFeatureFlagsService`","type":"heading","level":3},{"inlineContent":[{"type":"codeVoice","code":"URLSession"},{"type":"text","text":" + "},{"type":"codeVoice","code":"JSONDecoder"},{"type":"text","text":". Apps host their JSON anywhere — static file on a CDN, Cloudflare Worker, their own server. Zero backend infrastructure required. "},{"type":"codeVoice","code":"Examples\/ConfigWorker\/"},{"type":"text","text":" is a runnable shared Worker serving flags + killswitch for a whole portfolio from one URL ("},{"type":"codeVoice","code":"GET \/<appID>\/flags"},{"type":"text","text":")."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The URL must be "},{"inlineContent":[{"type":"text","text":"HTTPS"}],"type":"strong"},{"type":"text","text":" ("},{"type":"codeVoice","code":"http"},{"type":"text","text":" is allowed only for "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":" development servers; anything else is a precondition failure at init). Responses over 1 MB and non-2xx statuses throw, and malformed variant definitions (empty array, negative weights, weights not summing to 100) fail decoding — in every case the plugin keeps its last-known-good cached config."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Third-party adapters (LaunchDarkly, GrowthBook, Statsig) conform to the same protocol without changing the plugin."}],"type":"paragraph"},{"anchor":"Typed-flag-keys","text":"Typed flag keys","type":"heading","level":2},{"type":"codeListing","syntax":"swift","code":["public struct BoolFlag: Sendable, Hashable","public struct VariantFlag<Variant: RawRepresentable & Sendable> where Variant.RawValue == String","public struct ValueFlag<Value: Sendable>"]},{"inlineContent":[{"type":"text","text":"Read API on "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["state.isEnabled(.newOnboarding, default: false)","state.variant(of: .checkoutLayout)","state.value(of: .maxFreeUploads)"]},{"inlineContent":[{"type":"text","text":"Reads are pure synchronous functions. Per-property observation works as it does for any other state slice — views re-render only when the flag they read changes."}],"type":"paragraph"},{"anchor":"Action-semantics-selected","text":"Action semantics (selected)","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"refreshSucceeded(FeatureFlagsConfig, fetchedAt:)"},{"type":"text","text":" is dispatched on every "},{"type":"codeVoice","code":".refresh"},{"type":"text","text":" (including debounced refreshes that return an unchanged config). Consume config transitions by observing "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swidux\/pluginfeatureflagsreference"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference","generated":true}],"sections":[],"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}],"title":"SwiduxFeatureFlags Reference"},"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://Swidux/documentation/Swidux/MacrosReference":{"type":"topic","url":"\/documentation\/swidux\/macrosreference","abstract":[{"text":"Reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" and its property markers (the SwiftData persistence bridge, shipped in ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":").","type":"text"}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","title":"Macros","role":"article"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"type":"topic","url":"\/documentation\/swidux\/pluginpaywallreference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","title":"SwiduxPaywall Reference","role":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","role":"article","url":"\/documentation\/swidux\/entitystoreguide","title":"EntityStore"},"doc://Swidux/documentation/Swidux/GettingStarted":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","title":"Getting Started with Swidux","role":"article","url":"\/documentation\/swidux\/gettingstarted","kind":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}]},"doc://Swidux/documentation/Swidux/UndoRedo":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","role":"article","kind":"article","url":"\/documentation\/swidux\/undoredo","title":"Undo \/ Redo","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","role":"article","url":"\/documentation\/swidux\/pluginparentalgatereference","title":"SwiduxParentalGate Reference"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","role":"article","url":"\/documentation\/swidux\/pluginanalyticsreference","title":"SwiduxAnalytics Reference"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","title":"Add Feature Flags","role":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"url":"\/documentation\/swidux\/pluginarchitecture#Service-Result-Actions-and-Transition-Observation","kind":"section","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","title":"Service-Result Actions and Transition Observation","abstract":[]},"doc://Swidux/documentation/Swidux":{"type":"topic","url":"\/documentation\/swidux","kind":"symbol","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux","role":"collection"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","role":"article","url":"\/documentation\/swidux\/pluginkillswitchreference","title":"SwiduxKillswitch Reference"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"type":"topic","url":"\/documentation\/swidux\/undoplugin","kind":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","title":"UndoPlugin","role":"symbol"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"type":"topic","url":"\/documentation\/swidux\/persistencemiddlewareguide","kind":"article","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","title":"Persistence Middleware","role":"article"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","role":"article","url":"\/documentation\/swidux\/troubleshooting","title":"Troubleshooting"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","role":"collectionGroup","kind":"article","url":"\/documentation\/swidux\/keyvaluestoreguide","title":"KeyValueStore","type":"topic","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}]}}}