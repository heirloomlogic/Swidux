{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginfeatureflagsreference"]}],"metadata":{"role":"article","roleHeading":"Article","title":"SwiduxFeatureFlags Reference","modules":[{"name":"Swidux"}]},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" is a domain plugin that owns a "},{"type":"codeVoice","code":"FeatureFlagsState"},{"text":" slice, fetches a JSON wire format via a provider-agnostic ","type":"text"},{"code":"FeatureFlagsService","type":"codeVoice"},{"text":", and answers reads against state. Bucketing is pure FNV-1a so reads are synchronous and offline-capable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Three flag types from one wire format:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"boolean","type":"text"}]},{"type":"text","text":" — on\/off with rollout percentage (0–100)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"variant","type":"text"}]},{"text":" — string-typed weighted variants for A\/B tests.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"value","type":"text"}],"type":"strong"},{"text":" — typed remote-tunable scalar (","type":"text"},{"code":"Bool","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"Double","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"String","type":"codeVoice"},{"text":").","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Library-target","level":2,"type":"heading","text":"Library target"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxFeatureFlags"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxFeatureFlags","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Wire-format","level":2,"type":"heading","text":"Wire format"},{"code":["{","  \"version\": 1,","  \"flags\": {","    \"new_onboarding\": { \"type\": \"boolean\", \"rollout\": 25 },","    \"checkout_layout\": {","      \"type\": \"variant\",","      \"variants\": [","        { \"value\": \"control\", \"weight\": 50 },","        { \"value\": \"treatment\", \"weight\": 50 }","      ]","    },","    \"max_free_uploads\": { \"type\": \"value\", \"value\": 5 }","  }","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The plugin rejects unknown "},{"type":"codeVoice","code":"version"},{"type":"text","text":" values and falls back to the last-known-good cache. Defaults always live in Swift at the call site — this keeps them type-checked and forces “what if missing?” thinking."}],"type":"paragraph"},{"anchor":"Bucketing-and-identity","level":2,"type":"heading","text":"Bucketing and identity"},{"inlineContent":[{"code":"bucket = FNV1a(bucketingID + \":\" + flagKey) % 100","type":"codeVoice"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Stable per ","type":"text"},{"code":"(bucketingID, flagKey)","type":"codeVoice"},{"text":" pair forever.","type":"text"}],"type":"strong"},{"text":" Same input always produces the same bucket.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Per-flag.","type":"text"}],"type":"strong"},{"text":" A user isn’t always in the “early” group across different flags.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Identity resolution."}]},{"text":" When a ","type":"text"},{"type":"codeVoice","code":"userIDKeyPath"},{"text":" is configured ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"text":" the current user ID is non-nil, that is used. Otherwise the install ID is used. Anonymous users get a stable per-install identity; logged-in users get stable cross-device assignment. A user’s variant ","type":"text"},{"inlineContent":[{"text":"can","type":"text"}],"type":"emphasis"},{"text":" shift once at login — acceptable for nearly all real use cases.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"FNV-1a was chosen because it’s simple, dependency-free, and matches GrowthBook’s algorithm so apps migrating from GrowthBook get compatible buckets.","type":"text"}]},{"level":2,"text":"Evaluation order","type":"heading","anchor":"Evaluation-order"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For each read, in priority:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Local override present?"}]},{"type":"text","text":" Return it."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Flag in remote config?","type":"text"}]},{"text":" Evaluate (rollout \/ variant assignment \/ value lookup).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Otherwise","type":"text"}]},{"text":" return the Swift-side default.","type":"text"}],"type":"paragraph"}]}]},{"anchor":"Persistence","type":"heading","text":"Persistence","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Install ID"}],"type":"strong"},{"text":" persisted to ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":" on first generation. Read at hydration via ","type":"text"},{"code":"FeatureFlagsState.hydrated(from:defaultConfig:)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Last-known config"}]},{"type":"text","text":" persisted after every successful refresh. Hydrates as fallback before first network success."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Local overrides","type":"text"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" persisted by default. Restart = clean state."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"exposedKeys"}]},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" persisted. New session = fresh exposure events."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Exposure tracking","type":"heading","anchor":"Exposure-tracking","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A\/B testing is only analytically valid if you know which users actually saw each variant — bucketing alone is insufficient because the code path branching on the flag might never execute."}]},{"code":["store.send(.featureFlags(.recordExposure(key: \"checkout_layout\")))"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Or via the SwiftUI sugar:","type":"text"}]},{"code":["WizardView()","    .recordsExposure(of: .checkoutLayout, store: store, action: AppAction.featureFlags)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The plugin dedupes per session and fires the optional ","type":"text"},{"code":"onExposure","type":"codeVoice"},{"text":" callback (passed at plugin init). Wire that callback to your analytics plugin to forward exposures as events.","type":"text"}]},{"text":"Refresh policy","type":"heading","anchor":"Refresh-policy","level":2},{"code":["public enum RefreshPolicy: Sendable {","    case manual                                      \/\/ every .refresh fetches","    case automatic(minInterval: TimeInterval)        \/\/ debounce; default 300s","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Apps dispatch ","type":"text"},{"code":".refresh","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"App.scenePhase","type":"codeVoice"},{"text":" transitions; the plugin’s debouncing makes this safe to call frequently. The plugin does not subscribe to ","type":"text"},{"code":"UIApplication","type":"codeVoice"},{"text":" notifications — wiring stays in the host app.","type":"text"}]},{"level":2,"type":"heading","text":"Service protocol","anchor":"Service-protocol"},{"type":"codeListing","syntax":"swift","code":["public protocol FeatureFlagsService: Sendable {","    func fetch() async throws -> FeatureFlagsConfig","}"]},{"inlineContent":[{"type":"text","text":"One method. Caching, hydration, evaluation all live in the plugin."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Built-in: `HTTPFeatureFlagsService`","anchor":"Built-in-HTTPFeatureFlagsService"},{"inlineContent":[{"code":"URLSession","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"JSONDecoder","type":"codeVoice"},{"text":". Apps host their JSON anywhere — static file on a CDN, Cloudflare Worker, their own server. Zero backend infrastructure required. ","type":"text"},{"code":"Examples\/ConfigWorker\/","type":"codeVoice"},{"text":" is a runnable shared Worker serving flags + killswitch for a whole portfolio from one URL (","type":"text"},{"code":"GET \/<appID>\/flags","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Third-party adapters (LaunchDarkly, GrowthBook, Statsig) conform to the same protocol without changing the plugin.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Typed-flag-keys","text":"Typed flag keys","type":"heading"},{"code":["public struct BoolFlag: Sendable, Hashable","public struct VariantFlag<Variant: RawRepresentable & Sendable> where Variant.RawValue == String","public struct ValueFlag<Value: Sendable>"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Read API on ","type":"text"},{"type":"codeVoice","code":"FeatureFlagsState"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["state.isEnabled(.newOnboarding, default: false)","state.variant(of: .checkoutLayout)","state.value(of: .maxFreeUploads)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Reads are pure synchronous functions. Per-property observation works as it does for any other state slice — views re-render only when the flag they read changes."}],"type":"paragraph"},{"level":2,"anchor":"Action-semantics-selected","text":"Action semantics (selected)","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"refreshSucceeded(FeatureFlagsConfig, fetchedAt:)"},{"type":"text","text":" is dispatched on every "},{"type":"codeVoice","code":".refresh"},{"type":"text","text":" (including debounced refreshes that return an unchanged config). Consume config transitions by observing "},{"type":"codeVoice","code":"FeatureFlagsState"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"API reference for the ","type":"t