{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"kind":"article","metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"title":"SwiduxFeatureFlags Reference","role":"article"},"abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginfeatureflagsreference"]}],"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" is a domain plugin that owns a ","type":"text"},{"type":"codeVoice","code":"FeatureFlagsState"},{"text":" slice, fetches a JSON wire format via a provider-agnostic ","type":"text"},{"type":"codeVoice","code":"FeatureFlagsService"},{"text":", and answers reads against state. Bucketing is pure FNV-1a so reads are synchronous and offline-capable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Three flag types from one wire format:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"boolean","type":"text"}]},{"type":"text","text":" — on\/off with rollout percentage (0–100)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"variant","type":"text"}]},{"type":"text","text":" — string-typed weighted variants for A\/B tests."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"value","type":"text"}]},{"type":"text","text":" — typed remote-tunable scalar ("},{"type":"codeVoice","code":"Bool"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Int"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Double"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"String"},{"type":"text","text":")."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Library target","anchor":"Library-target","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxFeatureFlags"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxFeatureFlags"}]}]}],"type":"unorderedList"},{"text":"Wire format","anchor":"Wire-format","type":"heading","level":2},{"code":["{","  \"version\": 1,","  \"flags\": {","    \"new_onboarding\": { \"type\": \"boolean\", \"rollout\": 25 },","    \"checkout_layout\": {","      \"type\": \"variant\",","      \"variants\": [","        { \"value\": \"control\", \"weight\": 50 },","        { \"value\": \"treatment\", \"weight\": 50 }","      ]","    },","    \"max_free_uploads\": { \"type\": \"value\", \"value\": 5 }","  }","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"text":"The plugin rejects unknown ","type":"text"},{"code":"version","type":"codeVoice"},{"text":" values and falls back to the last-known-good cache. Defaults always live in Swift at the call site — this keeps them type-checked and forces “what if missing?” thinking.","type":"text"}]},{"level":2,"type":"heading","anchor":"Bucketing-and-identity","text":"Bucketing and identity"},{"type":"paragraph","inlineContent":[{"code":"bucket = FNV1a(bucketingID + \":\" + flagKey) % 100","type":"codeVoice"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Stable per ","type":"text"},{"type":"codeVoice","code":"(bucketingID, flagKey)"},{"text":" pair forever.","type":"text"}]},{"type":"text","text":" Same input always produces the same bucket."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Per-flag."}]},{"type":"text","text":" A user isn’t always in the “early” group across different flags."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Identity resolution."}]},{"type":"text","text":" When a "},{"type":"codeVoice","code":"userIDKeyPath"},{"text":" is configured ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"text":" the current user ID is non-nil, that is used. Otherwise the install ID is used. Anonymous users get a stable per-install identity; logged-in users get stable cross-device assignment. A user’s variant ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"can","type":"text"}]},{"text":" shift once at login — acceptable for nearly all real use cases.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"FNV-1a was chosen because it’s simple, dependency-free, and matches GrowthBook’s algorithm so apps migrating from GrowthBook get compatible buckets."}]},{"type":"heading","text":"Evaluation order","anchor":"Evaluation-order","level":2},{"inlineContent":[{"type":"text","text":"For each read, in priority:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Local override present?","type":"text"}],"type":"strong"},{"text":" Return it.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Flag in remote config?","type":"text"}]},{"text":" Evaluate (rollout \/ variant assignment \/ value lookup).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Otherwise"}]},{"text":" return the Swift-side default.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Persistence","anchor":"Persistence","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Install ID","type":"text"}],"type":"strong"},{"text":" persisted to ","type":"text"},{"type":"codeVoice","code":"KeyValueStore"},{"type":"text","text":" on first generation. Read at hydration via "},{"type":"codeVoice","code":"FeatureFlagsState.hydrated(from:defaultConfig:)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Last-known config","type":"text"}],"type":"strong"},{"text":" persisted after every successful refresh. Hydrates as fallback before first network success.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Local overrides","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" persisted by default. Restart = clean state.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"exposedKeys"}],"type":"strong"},{"text":" ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"emphasis"},{"text":" persisted. New session = fresh exposure events.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Exposure-tracking","level":2,"text":"Exposure tracking","type":"heading"},{"inlineContent":[{"text":"A\/B testing is only analytically valid if you know which users actually saw each variant — bucketing alone is insufficient because the code path branching on the flag might never execute.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["store.send(.featureFlags(.recordExposure(key: \"checkout_layout\")))"]},{"inlineContent":[{"text":"Or via the SwiftUI sugar:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["WizardView()","    .recordsExposure(of: .checkoutLayout, store: store, action: AppAction.featureFlags)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin dedupes per session and fires the optional "},{"type":"codeVoice","code":"onExposure"},{"type":"text","text":" callback (passed at plugin init). Wire that callback to your analytics plugin to forward exposures as events."}]},{"text":"Refresh policy","anchor":"Refresh-policy","type":"heading","level":2},{"code":["public enum RefreshPolicy: Sendable {","    case manual                                      \/\/ every .refresh fetches","    case automatic(minInterval: TimeInterval)        \/\/ debounce; default 300s","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Apps dispatch ","type":"text"},{"type":"codeVoice","code":".refresh"},{"text":" from ","type":"text"},{"code":"App.scenePhase","type":"codeVoice"},{"text":" transitions; the plugin’s debouncing makes this safe to call frequently. The plugin does not subscribe to ","type":"text"},{"type":"codeVoice","code":"UIApplication"},{"text":" notifications — wiring stays in the host app.","type":"text"}]},{"text":"Service protocol","anchor":"Service-protocol","level":2,"type":"heading"},{"syntax":"swift","type":"codeListing","code":["public protocol FeatureFlagsService: Sendable {","    func fetch() async throws -> FeatureFlagsConfig","}"]},{"inlineContent":[{"text":"One method. Caching, hydration, evaluation all live in the plugin.","type":"text"}],"type":"paragraph"},{"anchor":"Built-in-HTTPFeatureFlagsService","level":3,"text":"Built-in: `HTTPFeatureFlagsService`","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"URLSession"},{"text":" + ","type":"text"},{"type":"codeVoice","code":"JSONDecoder"},{"text":". Apps host their JSON 