tions. Swift’s ","type":"text"},{"code":"_modify","type":"codeVoice"},{"text":" accessor (used by ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":") fires notifications unconditionally. The snapshot pattern routes through ","type":"text"},{"code":"set","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Cross-slice observation isolation.","type":"text"}],"type":"strong"},{"text":" The ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" macro generates a separate ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" class for each ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" property. A view reading ","type":"text"},{"code":"store.items","type":"codeVoice"},{"text":" won’t re-render when only ","type":"text"},{"code":"store.ui","type":"codeVoice"},{"text":" changes, because they live on different observer objects.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" macro generates the observer class tree and "},{"code":"SwiduxObservable","type":"codeVoice"},{"type":"text","text":" conformance automatically. Hand-written conformance is still possible for advanced cases — see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxObservable","isActive":true},{"type":"text","text":"."}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Explicit equality guards (","type":"text"},{"type":"codeVoice","code":"if x != state.x { x = state.x }"},{"text":") are unnecessary. ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" already checks equality on ","type":"text"},{"type":"codeVoice","code":"set"},{"text":". Unconditional assignment is safe.","type":"text"}]}]},{"anchor":"Dispatch-Loop-Detection","type":"heading","level":2,"text":