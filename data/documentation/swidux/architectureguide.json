{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/architectureguide"]}],"kind":"article","identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","interfaceLanguage":"swift"},"abstract":[{"text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples"],"anchor":"Explanation","generated":true,"title":"Explanation"}],"metadata":{"title":"Architecture & Performance","modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"text":"Swidux relies on specific patterns to ensure correct ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" behavior, efficient rendering, and safe concurrency. This article explains the reasoning behind these patterns.","type":"text"}],"type":"paragraph"},{"text":"The Snapshot Pattern","type":"heading","level":2,"anchor":"The-Snapshot-Pattern"},{"inlineContent":[{"code":"Store.send()","type":"codeVoice"},{"text":" copies the observer tree into a local struct, mutates the copy via the reducer, then assigns changed properties back. This happens internally via ","type":"text"},{"code":"SwiduxObservable","type":"codeVoice"},{"text":" — ","type":"text"},{"code":"State(observer:)","type":"codeVoice"},{"text":" packs, ","type":"text"},{"code":"State.apply(_:to:)","type":"codeVoice"},{"text":" unpacks.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The pattern exists for two reasons:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" equality checking."}]},{"type":"text","text":" The "},{"type":"codeVoice","code":"set"},{"type":"text","text":" accessor checks "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" and suppresses no-op notifications. Swift’s "},{"type":"codeVoice","code":"_modify"},{"type":"text","text":" accessor (used by "},{"type":"codeVoice","code":"inout"},{"type":"text","text":") fires notifications unconditionally. The snapshot pattern routes through "},{"type":"codeVoice","code":"set"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Cross-slice observation isolation."}]},{"type":"text","text":" The "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" macro generates a separate "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" class for each "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" property. A view reading "},{"type":"codeVoice","code":"store.items"},{"type":"text","text":" won’t re-render when only "},{"type":"codeVoice","code":"store.ui"},{"type":"text","text":" changes, because they live on different observer objects."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"The ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" macro generates the observer class tree and ","type":"text"},{"code":"SwiduxObservable","type":"codeVoice"},{"text":" conformance automatically. Hand-written conformance is still possible for advanced cases — see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxObservable","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Explicit equality guards (","type":"text"},{"code":"if x != state.x { x = state.x }","type":"codeVoice"},{"text":") are unnecessary. ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" already checks equality on ","type":"text"},{"code":"set","type":"codeVoice"},{"text":". Unconditional assignment is safe.","type":"text"}]}]},{"anchor":"Dispatch-Loop-Detection","type":"heading","level":2,"text":"Dispatch Loop Detection"},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true,"type":"reference"},{"type":"text","text":" warns if "},{"code":"afterReduce","type":"codeVoice"},{"type":"text","text":" is called more than 100 times per debounce interval. This usually means "},{"code":"send()","type":"codeVoice"},{"type":"text","text":" isn’t using the snapshot pattern, causing cascading re-renders that trigger re-dispatches."}],"type":"paragraph"},{"text":"Reducer Weight","type":"heading","level":2,"anchor":"Reducer-Weight"},{"inlineContent":[{"type":"text","text":"Reducers run synchronously on the MainActor. Move O(n²) work into an "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","isActive":true,"type":"reference"},{"type":"text","text":" and dispatch the result back as an action."}],"type":"paragraph"},{"text":"Effect Threading","type":"heading","level":2,"anchor":"Effect-Threading"},{"name":"Important","style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Effects run on Swift concurrency’s cooperative thread pool via "},{"type":"codeVoice","code":"Task { @concurrent in }"},{"type":"text","text":". Blocking calls ("},{"type":"codeVoice","code":"Process.waitUntilExit()"},{"type":"text","text":", "},{"type":"codeVoice","code":"DispatchSemaphore.wait()"},{"type":"text","text":", "},{"type":"codeVoice","code":"Thread.sleep()"},{"type":"text","text":") hold threads hostage. If enough block, the pool starves and the MainActor freezes."}]}]},{"inlineContent":[{"type":"text","text":"Use async alternatives: "},{"code":"terminationHandler","type":"codeVoice"},{"type":"text","text":" + continuation instead of "},{"code":"waitUntilExit()","type":"codeVoice"},{"type":"text","text":", "},{"code":"Task.sleep()","type":"codeVoice"},{"type":"text","text":" instead of "},{"code":"Thread.sleep()","type":"codeVoice"},{"type":"text","text":", async file I\/O instead of "},{"code":"Data(contentsOf:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"references":{"doc://Swidux/documentation/Swidux/DesignPrinciples":{"title":"Design Principles","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","abstract":[{"text":"The 10 rules that shape every Swidux app, and the reasoning behind them.","type":"text"}],"type":"topic","kind":"article","url":"\/documentation\/swidux\/designprinciples","role":"article"},"doc://Swidux/documentation/Swidux/SwiduxObservable":{"type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiduxObservable","kind":"identifier"}],"title":"SwiduxObservable","navigatorTitle":[{"text":"SwiduxObservable","kind":"identifier"}],"abstract":[{"type":"text","text":"Bridges a value-type state struct to an "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" class tree for"},{"type":"text","text":" "},{"type":"text","text":"per-property SwiftUI observation granularity."}],"url":"\/documentation\/swidux\/swiduxobservable","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxObservable","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","title":"Plugin Architecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"url":"\/documentation\/swidux\/pluginarchitecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux":{"type":"topic","title":"Swidux","abstract":