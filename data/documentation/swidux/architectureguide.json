ce"},{"type":"text","text":" accessor checks "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":" and suppresses no-op notifications. Swift’s "},{"code":"_modify","type":"codeVoice"},{"type":"text","text":" accessor (used by "},{"code":"inout","type":"codeVoice"},{"type":"text","text":") fires notifications unconditionally. The snapshot pattern routes through "},{"code":"set","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Cross-slice observation isolation.","type":"text"}],"type":"strong"},{"type":"text","text":" The "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" macro generates a separate "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" class for each "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":" property. A view reading "},{"code":"store.items","type":"codeVoice"},{"type":"text","text":" won’t re-render when only "},{"code":"store.ui","type":"codeVoice"},{"type":"text","text":" changes, because they live on different observer objects."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" macro generates the observer class tree and ","type":"text"},{"code":"SwiduxObservable","type":"codeVoice"},{"text":" conformance automatically. Hand-written conformance is still possible for advanced cases — see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxObservable","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"Explicit equality guards ("},{"type":"codeVoice","code":"if x != state.x { x = state.x }"},{"type":"text","text":") are unnecessary. "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" already checks equality on "},{"type":"codeVoice","code":"set"},{"type":"text","text":". Unconditional assignment is safe."}],"type":"paragr