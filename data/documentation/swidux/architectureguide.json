"code":"_modify"},{"type":"text","text":" accessor (used by "},{"type":"codeVoice","code":"inout"},{"type":"text","text":") fires notifications unconditionally. The snapshot pattern routes through "},{"type":"codeVoice","code":"set"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Cross-slice observation isolation.","type":"text"}]},{"type":"text","text":" The "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" macro generates a separate "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" class for each "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" property. A view reading "},{"type":"codeVoice","code":"store.items"},{"type":"text","text":" won’t re-render when only "},{"type":"codeVoice","code":"store.ui"},{"type":"text","text":" changes, because they live on different observer objects."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" macro generates the observer class tree and "},{"code":"SwiduxObservable","type":"codeVoice"},{"type":"text","text":" conformance automatically. Hand-written conformance is still possible for advanced cases — see "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxObservable","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"inlineContent":[{"text":"Explicit equality guards (","type":"text"},{"type":"codeVoice","code":"if x != state.x { x = state.x }"},{"text":") are unnecessary. ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" already checks equality on ","type":"text"},{"type":"codeVoice","code":"set"},{"text":". Unconditional assignment is safe.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"level":2,"anchor":"Dispatch-Loop-Detection","type":"heading","text":"Dispatch Loop Detection"},{"inlineContent":[{"isAct