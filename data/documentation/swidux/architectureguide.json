xt":" equality checking."}],"type":"strong"},{"text":" The ","type":"text"},{"type":"codeVoice","code":"set"},{"type":"text","text":" accessor checks "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":" and suppresses no-op notifications. Swift’s "},{"code":"_modify","type":"codeVoice"},{"text":" accessor (used by ","type":"text"},{"type":"codeVoice","code":"inout"},{"type":"text","text":") fires notifications unconditionally. The snapshot pattern routes through "},{"code":"set","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Cross-slice observation isolation.","type":"text"}]},{"text":" The ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" macro generates a separate "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" class for each "},{"code":"@Slice","type":"codeVoice"},{"text":" property. A view reading ","type":"text"},{"code":"store.items","type":"codeVoice"},{"type":"text","text":" won’t re-render when only "},{"code":"store.ui","type":"codeVoice"},{"type":"text","text":" changes, because they live on different observer objects."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"The "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" macro generates the observer class tree and "},{"code":"SwiduxObservable","type":"codeVoice"},{"type":"text","text":" conformance automatically. Hand-written conformance is still possible for advanced cases — see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxObservable","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Explicit equality guards (","type":"text"},{"type":"codeVoice","code":"if x != state.x { x = state.x }"},{"text":") are unnecessary. ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" already checks equality on ","type":"text"},{"code":"set","type":"codeVoice"},{"text":". Unconditional assignment is safe.","type":"text"}]}],"type":"aside","style":"note","name":"Note"},{"text":"Dispatch Loop Detection","type":"heading","level":2,"anchor":"Dispatch-Loop-Detection"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"text":" warns if ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":" is called more than 100 times per debounce interval. This usually means ","type":"text"},{"code":"send()","type":"codeVoice"},{"text":" isn’t using the snapshot pattern, causing cascading re-renders that trigger re-dispatches.","type":"text"}]},{"anchor":"Reducer-Weight","level":2,"text":"Reducer Weight","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Reducers run synchronously on the MainActor. Move O(n²) work into an ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","type":"reference","isActive":true},{"text":" and dispatch the result back as an action.","type":"text"}]},{"anchor":"Effect-Threading","level":2,"text":"Effect Threading","type":"heading"},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"text":"Effects run on Swift concurrency’s cooperative thread pool via ","type":"text"},{"type":"codeVoice","code":"Task { @concurrent in }"},{"text":". Blocking calls (","type":"text"},{"type":"codeVoice","code":"Process.waitUntilExit()"},{"text":", ","type":"text"},{"type":"codeVoice","code":"DispatchSemaphore.wait()"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Thread.sleep()"},{"text":") hold threads hostage. If enough block, the pool starves and the MainActor freezes.","type":"text"}],"type":"paragraph"}]},{"inlineContent":[{"text":"Use async alternatives: ","type":"text"},{"type":"codeVoice","code":"terminationHandler"},{"text":" + continuation instead of ","type":"text"},{"code":"waitUntilExit()","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Task.sleep()","type":"codeVoice"},{"text":" instead of ","type":"text"},{"type":"codeVoice","code":"Thread.sleep()"},{"text":", async file I\/O instead of ","type":"text"},{"type":"codeVoice","code":"Data(contentsOf:)"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"references":{"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"url":"\/documentation\/swidux","title":"Swidux","type":"topic"},"doc://Swidux/documentation/Swidux/SwiduxObservable":{"navigatorTitle":[{"text":"SwiduxObservable","kind":"identifier"}],"url":"\/documentation\/swidux\/swiduxobservable","title":"SwiduxObservable","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxObservable","kind":"symbol","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiduxObservable","kind":"identifier"}],"abstract":[{"type":"text","text":"Bridges a value-type state struct to an "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" class tree for"},{"type":"text","text":" "},{"type":"text","text":"per-property SwiftUI observation granularity."}],"type":"topic"},"doc://Swidux/documentation/Swidux/DesignPrinciples":{"title":"Design Principles","url":"\/documentation\/swidux\/designprinciples","role":"article","abstract":[{"text":"The 10 rules that shape every Swidux app, and the reasoning behind them.","type":"text"}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples"},"doc://Swidux/documentation/Swi