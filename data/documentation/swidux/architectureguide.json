xt":" accessor checks ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" and suppresses no-op notifications. Swift’s ","type":"text"},{"code":"_modify","type":"codeVoice"},{"text":" accessor (used by ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":") fires notifications unconditionally. The snapshot pattern routes through ","type":"text"},{"code":"set","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Cross-slice observation isolation.","type":"text"}]},{"text":" The ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" macro generates a separate ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" class for each ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" property. A view reading ","type":"text"},{"code":"store.items","type":"codeVoice"},{"text":" won’t re-render when only ","type":"text"},{"code":"store.ui","type":"codeVoice"},{"text":" changes, because they live on different observer objects.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" macro generates the observer class tree and "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":" conformance automatically. Hand-written conformance is still possible for advanced cases — see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxObservable","type":"reference","isActive":true},{"type":"text","text":"."}]},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Explicit equality guards ("},{"type":"codeVoice","code":"if x != state.x { x = state.x }"},{"type":"text","text":") are unnecessary. "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" already checks equality on "},{"type":"codeVoice","code":"set"},{"type":"text","text":". Unconditional assignment is safe."}]}],"s