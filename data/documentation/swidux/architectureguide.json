ode":"set"},{"type":"text","text":" accessor checks "},{"code":"Equatable","type":"codeVoice"},{"text":" and suppresses no-op notifications. Swift’s ","type":"text"},{"type":"codeVoice","code":"_modify"},{"text":" accessor (used by ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":") fires notifications unconditionally. The snapshot pattern routes through ","type":"text"},{"type":"codeVoice","code":"set"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Cross-slice observation isolation."}]},{"type":"text","text":" The "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" macro generates a separate "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" class for each "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" property. A view reading "},{"type":"codeVoice","code":"store.items"},{"type":"text","text":" won’t re-render when only "},{"type":"codeVoice","code":"store.ui"},{"type":"text","text":" changes, because they live on different observer objects."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" macro generates the observer class tree and "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":" conformance automatically. Hand-written conformance is still possible for advanced cases — see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxObservable","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"Explicit equality guards (","type":"text"},{"type":"codeVoice","code":"if x != state.x { x = state.x }"},{"text":") are unnecessary. ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" already checks equality on "},{"code":"set","type":"codeVoice"},{"text":". Unco