":"codeVoice"},{"type":"text","text":". Unconditional assignment is safe."}]}],"style":"note","type":"aside"},{"level":2,"text":"Dispatch Loop Detection","type":"heading","anchor":"Dispatch-Loop-Detection"},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"text":" warns if ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":" is called more than 100 times per debounce interval. This usually means ","type":"text"},{"type":"codeVoice","code":"send()"},{"text":" isn’t using the snapshot pattern, causing cascading re-renders that trigger re-dispatches.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Reducer Weight","type":"heading","anchor":"Reducer-Weight"},{"inlineContent":[{"text":"Reducers run synchronously on the MainActor. Move O(n²) work into an ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Effect","type":"reference","isActive":true},{"text":" and dispatch the result back as an action.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Effect Threading","type":"heading","anchor":"Effect-Threading"},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Effects run on Swift concurrency’s cooperative thread pool via "},{"code":"Task { @concurrent in }","type":"codeVoice"},{"type":"text","text":". Blocking calls ("},{"code":"Process.waitUntilExit()","type":"codeVoice"},{"type":"text","text":", "},{"code":"DispatchSemaphore.wait()","type":"codeVoice"},{"type":"text","text":", "},{"code":"Thread.sleep()","type":"codeVoice"},{"type":"text","text":") hold threads hostage. If enough block, the pool starves and the MainActor freezes."}]}],"style":"important","type":"aside"},{"inlineContent":[{"text":"Use async alternatives: ","type":"text"},{"type":"codeVoice","code":"terminationHandler"},{"text":" + continuation instead of ","type":"text"},{"type":"codeVoice","code":"waitUntilExit()"},{"text":", ","type":"