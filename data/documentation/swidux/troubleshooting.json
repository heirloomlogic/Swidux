{"seeAlsoSections":[{"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/EntityEditingGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistedAssociations","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true,"title":"Reference"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","interfaceLanguage":"swift"},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/troubleshooting"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"metadata":{"modules":[{"name":"Swidux"}],"title":"Troubleshooting","role":"article","roleHeading":"Article"},"primaryContentSections":[{"content":[{"level":2,"text":"Xcode asks to “Trust & Enable” a macro","anchor":"Xcode-asks-to-Trust--Enable-a-macro","type":"heading"},{"inlineContent":[{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" are compiler plugins, so the first build in Xcode","type":"text"},{"text":" ","type":"text"},{"text":"prompts once per machine to trust the ","type":"text"},{"code":"SwiduxMacros","type":"codeVoice"},{"text":" target. Approve it in the","type":"text"},{"text":" ","type":"text"},{"text":"build error’s fix-it or under ","type":"text"},{"inlineContent":[{"type":"text","text":"Settings → Packages"}],"type":"strong"},{"text":". On CI, pass","type":"text"},{"text":" ","type":"text"},{"code":"-skipMacroValidation","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"xcodebuild","type":"codeVoice"},{"text":" instead — there’s no one to click the","type":"text"},{"text":" ","type":"text"},{"text":"dialog.","type":"text"}],"type":"paragraph"},{"level":2,"text":"The first build is slow","anchor":"The-first-build-is-slow","type":"heading"},{"inlineContent":[{"text":"Swidux depends on ","type":"text"},{"code":"swift-syntax","type":"codeVoice"},{"text":", which the macro system compiles from source","type":"text"},{"text":" ","type":"text"},{"text":"on first build (a few minutes on CI-class hardware). It’s cached afterwards;","type":"text"},{"text":" ","type":"text"},{"text":"nothing is wrong. CI pipelines benefit from caching ","type":"text"},{"code":".build\/","type":"codeVoice"},{"text":" or DerivedData.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Console shows “Re-entrant Store.send(…) — deferring”","anchor":"Console-shows-Re-entrant-Storesend-deferring","type":"heading"},{"inlineContent":[{"text":"Something called ","type":"text"},{"code":"store.send","type":"codeVoice"},{"text":" synchronously from inside a reducer or plugin","type":"text"},{"text":" ","type":"text"},{"text":"hook — usually a plugin observing state and dispatching in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":", or a","type":"text"},{"text":" ","type":"text"},{"code":"Binding","type":"codeVoice"},{"text":" setter fired during view updates. The store defers the inner action","type":"text"},{"text":" ","type":"text"},{"text":"and runs it as a full cycle right after the current one, so state stays","type":"text"},{"text":" ","type":"text"},{"text":"consistent — but the fault log is telling you the design wants that follow-up","type":"text"},{"text":" ","type":"text"},{"text":"dispatched from an ","type":"text"},{"code":"Effect","type":"codeVoice"},{"text":" instead.","type":"text"}],"type":"paragraph"},{"level":2,"text":"`call to main actor-isolated initializer … in a synchronous nonisolated context`","anchor":"call-to-main-actor-isolated-initializer--in-a-synchronous-nonisolated-context","type":"heading"},{"inlineContent":[{"text":"The module is compiling in Swift 5 language mode with","type":"text"},{"text":" ","type":"text"},{"code":"SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"@Swidux nonisolated struct","type":"codeVoice"},{"text":" ","type":"text"},{"text":"only gets a nonisolated synthesized memberwise initializer under ","type":"text"},{"inlineContent":[{"type":"text","text":"Swift 6"},{"type":"text","text":" "},{"type":"text","text":"mode"}],"type":"strong"},{"text":" (","type":"text"},{"code":"SWIFT_VERSION = 6.0","type":"codeVoice"},{"text":"); under Swift 5 mode the macro’s state","type":"text"},{"text":" ","type":"text"},{"text":"reconstruction can’t call it, and adding an explicit ","type":"text"},{"code":"nonisolated init","type":"codeVoice"},{"text":" does","type":"text"},{"text":" ","type":"text"},{"text":"not rescue it. Switch the target to Swift 6 mode.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Error: “stored properties need an explicit type annotation”","anchor":"Error-stored-properties-need-an-explicit-type-annotation","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"var flag = false"},{"type":"text","text":" gives the compiler an inferred type, but macros can’t see"},{"type":"text","text":" "},{"type":"text","text":"it — before this diagnostic existed, such a property was silently skipped and"},{"type":"text","text":" "},{"type":"text","text":"its value reset on every dispatch. Write "},{"type":"codeVoice","code":"var flag: Bool = false"},{"type":"text","text":". The same"},{"type":"text","text":" "},{"type":"text","text":"applies to combined declarations: split "},{"type":"codeVoice","code":"var a, b: Int"},{"type":"text","text":" into separate"},{"type":"text","text":" "},{"type":"text","text":"declarations."}],"type":"paragraph"},{"level":2,"text":"Keychain writes fail with OSStatus −34018 (`errSecMissingEntitlement`)","anchor":"Keychain-writes-fail-with-OSStatus-%E2%88%9234018-errSecMissingEntitlement","type":"heading"},{"inlineContent":[{"type":"text","text":"An unsigned local or CI build is using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"},{"type":"text","text":" without a"},{"type":"text","text":" "},{"type":"text","text":"provisioning profile. This is a signing condition, not a prompt or a bug — the"},{"type":"text","text":" "},{"type":"text","text":"data-protection keychain never prompts."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Nothing is persisted, but nothing crashes either: the write logs, returns"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":", and the app continues. Ship provisioning-profile-signed builds with"},{"type":"text","text":" "},{"type":"codeVoice","code":"accessGroup: nil"},{"type":"text","text":" to get real persistence."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Adding a team-prefixed "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entitlement also works, and is"},{"type":"text","text":" "},{"type":"text","text":"the right call when you want the access group — but weigh it first, because it"},{"type":"text","text":" "},{"type":"text","text":"makes the app require a provisioning profile for every signed build. It is"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" a fix for a test host: "},{"type":"codeVoice","code":"CODE_SIGNING_ALLOWED=NO"},{"type":"text","text":" embeds no entitlements"},{"type":"text","text":" "},{"type":"text","text":"at all, so there is nothing for the entitlement to attach to. Let the write"},{"type":"text","text":" "},{"type":"text","text":"degrade there. Details in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"`Test crashed with signal trap before establishing connection`","anchor":"Test-crashed-with-signal-trap-before-establishing-connection","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"xcodebuild test"},{"type":"text","text":" dies before any test runs, naming nothing useful. If the app"},{"type":"text","text":" "},{"type":"text","text":"mints a device identity or writes a token at launch, suspect the Keychain: the"},{"type":"text","text":" "},{"type":"text","text":"test host is unsigned, the write fails, and a trap takes the process down before"},{"type":"text","text":" "},{"type":"text","text":"the test bundle can attach."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Current versions degrade instead of trapping here, so upgrading Swidux is the"},{"type":"text","text":" "},{"type":"text","text":"fix. To confirm the diagnosis on an older one, run the same scheme with"},{"type":"text","text":" "},{"type":"codeVoice","code":"CODE_SIGNING_ALLOWED=YES"},{"type":"text","text":" — if it gets past launch, the Keychain was the cause."}],"type":"paragraph"},{"level":2,"text":"Edits disappear after a sync tick or an async load","anchor":"Edits-disappear-after-a-sync-tick-or-an-async-load","type":"heading"},{"inlineContent":[{"type":"text","text":"Symptom: a keystroke, a toggle, or a whole entity vanishes — intermittently,"},{"type":"text","text":" "},{"type":"text","text":"usually while something is loading or syncing, and never reproducibly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The cause is almost always a hand-rolled bridge from "},{"type":"codeVoice","code":"async"},{"type":"text","text":" work into the"},{"type":"text","text":" "},{"type":"text","text":"store. "},{"type":"codeVoice","code":"Store"},{"type":"text","text":" keeps state in an "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" observer tree and converts to a"},{"type":"text","text":" "},{"type":"text","text":"value-type snapshot on the way in and out (“pack” and “unpack”). If you pack a"},{"type":"text","text":" "},{"type":"text","text":"snapshot, "},{"type":"codeVoice","code":"await"},{"type":"text","text":" something, and then unpack it, everything dispatched during"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"await"},{"type":"text","text":" is silently overwritten:"}],"type":"paragraph"},{"code":["var snapshot = AppState(observer: store.observer)   \/\/ ← packed BEFORE the await","await loadEverything(into: &snapshot)               \/\/ ← dispatches land here…","AppState.apply(snapshot, to: store.observer)        \/\/ ← …and are discarded here"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"inout State"},{"type":"text","text":" across a suspension point is the tell. The window is only as wide"},{"type":"text","text":" "},{"type":"text","text":"as the "},{"type":"codeVoice","code":"await"},{"type":"text","text":", which is why it presents as a rare glitch rather than a"},{"type":"text","text":" "},{"type":"text","text":"reproducible bug."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)"},{"type":"text","text":" instead. It runs the async work with no"},{"type":"text","text":" "},{"type":"text","text":"access to state, then packs a "},{"type":"emphasis","inlineContent":[{"text":"fresh","type":"text"}]},{"type":"text","text":" snapshot, merges, and unpacks in a single"},{"type":"text","text":" "},{"type":"text","text":"step with no suspension point in between — so no dispatch can interleave:"}],"type":"paragraph"},{"code":["await store.mutate {","    try await api.fetchItems()          \/\/ no state in scope; nothing to stale","} merging: { items, state in","    state.items.merge(from: EntityStore(items)) { _, _ in false }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The persistence stack’s own async entry points already work this way — use"},{"type":"text","text":" "},{"type":"codeVoice","code":"persistence.rehydrate(into: store)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"sync.setSyncEnabled(_:into: store)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"not a snapshot you manage yourself. ("},{"type":"codeVoice","code":"hydrate(into: &state)"},{"type":"text","text":" is the exception,"},{"type":"text","text":" "},{"type":"text","text":"and safe: it runs at launch, before the store exists.)"}],"type":"paragraph"},{"level":2,"text":"Contributors: the lint plugin doesn’t run \/ dev tooling is missing","anchor":"Contributors-the-lint-plugin-doesnt-run--dev-tooling-is-missing","type":"heading"},{"inlineContent":[{"type":"text","text":"Dev tooling (the Persnoop linter, the DocC plugin) is gated behind a"},{"type":"text","text":" "},{"type":"text","text":"gitignored "},{"type":"codeVoice","code":".dev-tooling"},{"type":"text","text":" sentinel file so it never leaks into consumers’"},{"type":"text","text":" "},{"type":"text","text":"dependency graphs. Create it at the package root — and if the package was"},{"type":"text","text":" "},{"type":"text","text":"already built without it, run "},{"type":"codeVoice","code":"swift package purge-cache"},{"type":"text","text":" so SwiftPM re-reads"},{"type":"text","text":" "},{"type":"text","text":"the manifest. See the repository’s "},{"type":"codeVoice","code":"CONTRIBUTING.md"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"A `@Persisted` app crashes only in Release","anchor":"A-Persisted-app-crashes-only-in-Release","type":"heading"},{"inlineContent":[{"text":"If the crash is in fetching, make sure you’re on ≥ 1.3.0: generic","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"#Predicate"},{"text":" over a protocol-required keypath traps under ","type":"text"},{"type":"codeVoice","code":"-O"},{"text":", which is why","type":"text"},{"text":" ","type":"text"},{"text":"the macro generates a per-model ","type":"text"},{"type":"codeVoice","code":"swiduxBatchFetchDescriptor"},{"text":" — one for ","type":"text"},{"type":"codeVoice","code":"id"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"one for ","type":"text"},{"type":"codeVoice","code":"persistentModelID"},{"text":" — and why every by-identifier read goes through","type":"text"},{"text":" ","type":"text"},{"text":"one instead of building a predicate inline. Run ","type":"text"},{"type":"codeVoice","code":"swift test -c release"},{"text":" in CI","type":"text"},{"text":" ","type":"text"},{"text":"to catch this class of issue — Debug builds and default ","type":"text"},{"type":"codeVoice","code":"swift test"},{"text":" pass.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"references":{"doc://Swidux/documentation/Swidux/PersistedAssociations":{"abstract":[{"type":"text","text":"Declare parent and child identities separately, then save an editing session through one local transaction."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistedAssociations","type":"topic","title":"Persisting canonical associations","kind":"article","role":"article","url":"\/documentation\/swidux\/persistedassociations"},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","title":"Getting Started with Swidux","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"url":"\/documentation\/swidux\/gettingstarted","type":"topic"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","type":"topic","title":"SwiduxFeatureFlags Reference","kind":"article","role":"article","url":"\/documentation\/swidux\/pluginfeatureflagsreference"},"doc://Swidux/documentation/Swidux/Store/mutate(awaiting:merging:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mutate"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">("},{"kind":"externalParam","text":"awaiting"},{"kind":"text","text":": () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":", "},{"kind":"externalParam","text":"merging"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":", "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"rethrows"}],"abstract":[{"text":"Runs async work that must not hold state across its suspensions, then","type":"text"},{"text":" ","type":"text"},{"text":"folds the result into a ","type":"text"},{"inlineContent":[{"type":"text","text":"freshly packed"}],"type":"strong"},{"text":" snapshot in one","type":"text"},{"text":" ","type":"text"},{"text":"suspension-free step.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","type":"topic","title":"mutate(awaiting:merging:)","kind":"symbol","role":"symbol","url":"\/documentation\/swidux\/store\/mutate(awaiting:merging:)"},"doc://Swidux/documentation/Swidux/EntityEditingGuide":{"role":"article","kind":"article","title":"Editing canonical entities","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityEditingGuide","abstract":[{"type":"text","text":"Keep editor drafts separate from current application state, then apply their changes as one local group."}],"url":"\/documentation\/swidux\/entityeditingguide","type":"topic"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","title":"EntityStore","kind":"article","url":"\/documentation\/swidux\/entitystoreguide","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"role":"article","kind":"article","title":"SwiduxKillswitch Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","abstract":[{"text":"Public API surface for the ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"url":"\/documentation\/swidux\/pluginkillswitchreference","type":"topic"},"doc://Swidux/documentation/Swidux/KeychainKeyValueStore":{"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","role":"symbol","abstract":[{"text":"A ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":" backed by the system Keychain.","type":"text"}],"url":"\/documentation\/swidux\/keychainkeyvaluestore","type":"topic","title":"KeychainKeyValueStore","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeychainKeyValueStore"}],"navigatorTitle":[{"kind":"identifier","text":"KeychainKeyValueStore"}]},"doc://Swidux/documentation/Swidux/UndoRedo":{"abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":".","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"topic","title":"Undo \/ Redo","kind":"article","role":"article","url":"\/documentation\/swidux\/undoredo"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"topic","title":"Persistence Plugin","kind":"article","role":"article","url":"\/documentation\/swidux\/persistencemiddlewareguide"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"role":"symbol","kind":"symbol","title":"UndoPlugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"url":"\/documentation\/swidux\/undoplugin","type":"topic"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic","title":"SwiduxPaywall Reference","kind":"article","role":"article","url":"\/documentation\/swidux\/pluginpaywallreference"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","type":"topic","title":"KeyValueStore","kind":"article","role":"collectionGroup","url":"\/documentation\/swidux\/keyvaluestoreguide"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"role":"article","kind":"article","title":"SwiduxAnalytics Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"url":"\/documentation\/swidux\/pluginanalyticsreference","type":"topic"},"doc://Swidux/documentation/Swidux/MacrosReference":{"abstract":[{"type":"text","text":"Reference for "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" and "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":").","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","type":"topic","title":"Macros","kind":"article","role":"article","url":"\/documentation\/swidux\/macrosreference"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","title":"Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"url":"\/documentation\/swidux","type":"topic","role":"collection"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"abstract":[{"type":"text","text":"API surface for the "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","type":"topic","title":"SwiduxParentalGate Reference","kind":"article","role":"article","url":"\/documentation\/swidux\/pluginparentalgatereference"}}}