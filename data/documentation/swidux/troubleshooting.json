{"seeAlsoSections":[{"title":"Reference","generated":true,"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Xcode asks to “Trust & Enable” a macro","type":"heading","anchor":"Xcode-asks-to-Trust--Enable-a-macro","level":2},{"inlineContent":[{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" are compiler plugins, so the first build in Xcode","type":"text"},{"text":" ","type":"text"},{"text":"prompts once per machine to trust the ","type":"text"},{"type":"codeVoice","code":"SwiduxMacros"},{"text":" target. Approve it in the","type":"text"},{"text":" ","type":"text"},{"text":"build error’s fix-it or under ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Settings → Packages"}]},{"text":". On CI, pass","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"-skipMacroValidation"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"xcodebuild"},{"text":" instead — there’s no one to click the","type":"text"},{"text":" ","type":"text"},{"text":"dialog.","type":"text"}],"type":"paragraph"},{"anchor":"The-first-build-is-slow","type":"heading","level":2,"text":"The first build is slow"},{"inlineContent":[{"text":"Swidux depends on ","type":"text"},{"type":"codeVoice","code":"swift-syntax"},{"text":", which the macro system compiles from source","type":"text"},{"text":" ","type":"text"},{"text":"on first build (a few minutes on CI-class hardware). It’s cached afterwards;","type":"text"},{"text":" ","type":"text"},{"text":"nothing is wrong. CI pipelines benefit from caching ","type":"text"},{"type":"codeVoice","code":".build\/"},{"text":" or DerivedData.","type":"text"}],"type":"paragraph"},{"anchor":"Console-shows-Re-entrant-Storesend-deferring","type":"heading","level":2,"text":"Console shows “Re-entrant Store.send(…) — deferring”"},{"inlineContent":[{"text":"Something called ","type":"text"},{"type":"codeVoice","code":"store.send"},{"text":" synchronously from inside a reducer or plugin","type":"text"},{"text":" ","type":"text"},{"text":"hook — usually a plugin observing state and dispatching in ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":", or a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Binding"},{"text":" setter fired during view updates. The store defers the inner action","type":"text"},{"text":" ","type":"text"},{"text":"and runs it as a full cycle right after the current one, so state stays","type":"text"},{"text":" ","type":"text"},{"text":"consistent — but the fault log is telling you the design wants that follow-up","type":"text"},{"text":" ","type":"text"},{"text":"dispatched from an ","type":"text"},{"type":"codeVoice","code":"Effect"},{"text":" instead.","type":"text"}],"type":"paragraph"},{"anchor":"call-to-main-actor-isolated-initializer--in-a-synchronous-nonisolated-context","type":"heading","level":2,"text":"`call to main actor-isolated initializer … in a synchronous nonisolated context`"},{"inlineContent":[{"text":"The module is compiling in Swift 5 language mode with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor"},{"text":". A ","type":"text"},{"type":"codeVoice","code":"@Swidux nonisolated struct"},{"text":" ","type":"text"},{"text":"only gets a nonisolated synthesized memberwise initializer under ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Swift 6"},{"type":"text","text":" "},{"type":"text","text":"mode"}]},{"text":" (","type":"text"},{"code":"SWIFT_VERSION = 6.0","type":"codeVoice"},{"text":"); under Swift 5 mode the macro’s state","type":"text"},{"text":" ","type":"text"},{"text":"reconstruction can’t call it, and adding an explicit ","type":"text"},{"code":"nonisolated init","type":"codeVoice"},{"text":" does","type":"text"},{"text":" ","type":"text"},{"text":"not rescue it. Switch the target to Swift 6 mode.","type":"text"}],"type":"paragraph"},{"anchor":"Error-stored-properties-need-an-explicit-type-annotation","type":"heading","level":2,"text":"Error: “stored properties need an explicit type annotation”"},{"inlineContent":[{"type":"codeVoice","code":"var flag = false"},{"text":" gives the compiler an inferred type, but macros can’t see","type":"text"},{"text":" ","type":"text"},{"text":"it — before this diagnostic existed, such a property was silently skipped and","type":"text"},{"text":" ","type":"text"},{"text":"its value reset on every dispatch. Write ","type":"text"},{"type":"codeVoice","code":"var flag: Bool = false"},{"text":". The same","type":"text"},{"text":" ","type":"text"},{"text":"applies to combined declarations: split ","type":"text"},{"type":"codeVoice","code":"var a, b: Int"},{"text":" into separate","type":"text"},{"text":" ","type":"text"},{"text":"declarations.","type":"text"}],"type":"paragraph"},{"anchor":"Keychain-writes-fail-with-OSStatus-%E2%88%9234018-errSecMissingEntitlement","type":"heading","level":2,"text":"Keychain writes fail with OSStatus −34018 (`errSecMissingEntitlement`)"},{"inlineContent":[{"text":"An unsigned local or CI build is using ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true},{"text":" without a","type":"text"},{"text":" ","type":"text"},{"text":"provisioning profile. This is a signing condition, not a prompt or a bug — the","type":"text"},{"text":" ","type":"text"},{"text":"data-protection keychain never prompts.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Nothing is persisted, but nothing crashes either: the write logs, returns","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", and the app continues. Ship provisioning-profile-signed builds with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"accessGroup: nil"},{"text":" to get real persistence.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Adding a team-prefixed ","type":"text"},{"type":"codeVoice","code":"keychain-access-groups"},{"text":" entitlement also works, and is","type":"text"},{"text":" ","type":"text"},{"text":"the right call when you want the access group — but weigh it first, because it","type":"text"},{"text":" ","type":"text"},{"text":"makes the app require a provisioning profile for every signed build. It is","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" a fix for a test host: ","type":"text"},{"type":"codeVoice","code":"CODE_SIGNING_ALLOWED=NO"},{"text":" embeds no entitlements","type":"text"},{"text":" ","type":"text"},{"text":"at all, so there is nothing for the entitlement to attach to. Let the write","type":"text"},{"text":" ","type":"text"},{"text":"degrade there. Details in ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Test-crashed-with-signal-trap-before-establishing-connection","type":"heading","level":2,"text":"`Test crashed with signal trap before establishing connection`"},{"inlineContent":[{"type":"codeVoice","code":"xcodebuild test"},{"text":" dies before any test runs, naming nothing useful. If the app","type":"text"},{"text":" ","type":"text"},{"text":"mints a device identity or writes a token at launch, suspect the Keychain: the","type":"text"},{"text":" ","type":"text"},{"text":"test host is unsigned, the write fails, and a trap takes the process down before","type":"text"},{"text":" ","type":"text"},{"text":"the test bundle can attach.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Current versions degrade instead of trapping here, so upgrading Swidux is the","type":"text"},{"text":" ","type":"text"},{"text":"fix. To confirm the diagnosis on an older one, run the same scheme with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"CODE_SIGNING_ALLOWED=YES"},{"text":" — if it gets past launch, the Keychain was the cause.","type":"text"}],"type":"paragraph"},{"anchor":"Edits-disappear-after-a-sync-tick-or-an-async-load","type":"heading","level":2,"text":"Edits disappear after a sync tick or an async load"},{"inlineContent":[{"text":"Symptom: a keystroke, a toggle, or a whole entity vanishes — intermittently,","type":"text"},{"text":" ","type":"text"},{"text":"usually while something is loading or syncing, and never reproducibly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The cause is almost always a hand-rolled bridge from ","type":"text"},{"type":"codeVoice","code":"async"},{"text":" work into the","type":"text"},{"text":" ","type":"text"},{"text":"store. ","type":"text"},{"type":"codeVoice","code":"Store"},{"text":" keeps state in an ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":" observer tree and converts to a","type":"text"},{"text":" ","type":"text"},{"text":"value-type snapshot on the way in and out (“pack” and “unpack”). If you pack a","type":"text"},{"text":" ","type":"text"},{"text":"snapshot, ","type":"text"},{"type":"codeVoice","code":"await"},{"text":" something, and then unpack it, everything dispatched during","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"type":"codeVoice","code":"await"},{"text":" is silently overwritten:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["var snapshot = AppState(observer: store.observer)   \/\/ ← packed BEFORE the await","await loadEverything(into: &snapshot)               \/\/ ← dispatches land here…","AppState.apply(snapshot, to: store.observer)        \/\/ ← …and are discarded here"]},{"inlineContent":[{"type":"codeVoice","code":"inout State"},{"text":" across a suspension point is the tell. The window is only as wide","type":"text"},{"text":" ","type":"text"},{"text":"as the ","type":"text"},{"type":"codeVoice","code":"await"},{"text":", which is why it presents as a rare glitch rather than a","type":"text"},{"text":" ","type":"text"},{"text":"reproducible bug.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","isActive":true},{"text":" instead. It runs the async work with no","type":"text"},{"text":" ","type":"text"},{"text":"access to state, then packs a ","type":"text"},{"inlineContent":[{"text":"fresh","type":"text"}],"type":"emphasis"},{"text":" snapshot, merges, and unpacks in a single","type":"text"},{"text":" ","type":"text"},{"text":"step with no suspension point in between — so no dispatch can interleave:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["await store.mutate {","    try await api.fetchItems()          \/\/ no state in scope; nothing to stale","} merging: { items, state in","    state.items.merge(from: EntityStore(items)) { _, _ in false }","}"]},{"inlineContent":[{"text":"The persistence stack’s own async entry points already work this way — use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"persistence.rehydrate(into: store)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"sync.setSyncEnabled(_:into: store)"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"not a snapshot you manage yourself. (","type":"text"},{"type":"codeVoice","code":"hydrate(into: &state)"},{"text":" is the exception,","type":"text"},{"text":" ","type":"text"},{"text":"and safe: it runs at launch, before the store exists.)","type":"text"}],"type":"paragraph"},{"anchor":"Contributors-the-lint-plugin-doesnt-run--dev-tooling-is-missing","type":"heading","level":2,"text":"Contributors: the lint plugin doesn’t run \/ dev tooling is missing"},{"inlineContent":[{"text":"Dev tooling (the Persnoop linter, the DocC plugin) is gated behind a","type":"text"},{"text":" ","type":"text"},{"text":"gitignored ","type":"text"},{"type":"codeVoice","code":".dev-tooling"},{"text":" sentinel file so it never leaks into consumers’","type":"text"},{"text":" ","type":"text"},{"text":"dependency graphs. Create it at the package root — and if the package was","type":"text"},{"text":" ","type":"text"},{"text":"already built without it, run ","type":"text"},{"type":"codeVoice","code":"swift package purge-cache"},{"text":" so SwiftPM re-reads","type":"text"},{"text":" ","type":"text"},{"text":"the manifest. See the repository’s ","type":"text"},{"type":"codeVoice","code":"CONTRIBUTING.md"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"A-Persisted-app-crashes-only-in-Release","type":"heading","level":2,"text":"A `@Persisted` app crashes only in Release"},{"inlineContent":[{"text":"If the crash is in fetching, make sure you’re on ≥ 1.3.0: generic","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"#Predicate"},{"text":" over a protocol-required keypath traps under ","type":"text"},{"type":"codeVoice","code":"-O"},{"text":", which is why","type":"text"},{"text":" ","type":"text"},{"text":"the macro generates a per-model ","type":"text"},{"type":"codeVoice","code":"swiduxBatchFetchDescriptor"},{"text":" — one for ","type":"text"},{"type":"codeVoice","code":"id"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"one for ","type":"text"},{"type":"codeVoice","code":"persistentModelID"},{"text":" — and why every by-identifier read goes through","type":"text"},{"text":" ","type":"text"},{"text":"one instead of building a predicate inline. Run ","type":"text"},{"type":"codeVoice","code":"swift test -c release"},{"text":" in CI","type":"text"},{"text":" ","type":"text"},{"text":"to catch this class of issue — Debug builds and default ","type":"text"},{"type":"codeVoice","code":"swift test"},{"text":" pass.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/swidux\/troubleshooting"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","title":"Troubleshooting","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"kind":"article","sections":[],"references":{"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"kind":"article","type":"topic","url":"\/documentation\/swidux\/pluginanalyticsreference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"role":"article","title":"SwiduxAnalytics Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference"},"doc://Swidux/documentation/Swidux/MacrosReference":{"kind":"article","type":"topic","url":"\/documentation\/swidux\/macrosreference","abstract":[{"text":"Reference for ","type":"text"},{