{"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","interfaceLanguage":"swift"},"kind":"article","abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/troubleshooting"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true,"anchor":"Reference","title":"Reference"}],"metadata":{"modules":[{"name":"Swidux"}],"title":"Troubleshooting","roleHeading":"Article","role":"article"},"primaryContentSections":[{"kind":"content","content":[{"text":"Xcode asks to “Trust & Enable” a macro","level":2,"type":"heading","anchor":"Xcode-asks-to-Trust--Enable-a-macro"},{"type":"paragraph","inlineContent":[{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" are compiler plugins, so the first build in Xcode","type":"text"},{"text":" ","type":"text"},{"text":"prompts once per machine to trust the ","type":"text"},{"code":"SwiduxMacros","type":"codeVoice"},{"text":" target. Approve it in the","type":"text"},{"text":" ","type":"text"},{"text":"build error’s fix-it or under ","type":"text"},{"inlineContent":[{"type":"text","text":"Settings → Packages"}],"type":"strong"},{"text":". On CI, pass","type":"text"},{"text":" ","type":"text"},{"code":"-skipMacroValidation","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"xcodebuild","type":"codeVoice"},{"text":" instead — there’s no one to click the","type":"text"},{"text":" ","type":"text"},{"text":"dialog.","type":"text"}]},{"text":"The first build is slow","level":2,"type":"heading","anchor":"The-first-build-is-slow"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swidux depends on "},{"type":"codeVoice","code":"swift-syntax"},{"type":"text","text":", which the macro system compiles from source"},{"type":"text","text":" "},{"type":"text","text":"on first build (a few minutes on CI-class hardware). It’s cached afterwards;"},{"type":"text","text":" "},{"type":"text","text":"nothing is wrong. CI pipelines benefit from caching "},{"type":"codeVoice","code":".build\/"},{"type":"text","text":" or DerivedData."}]},{"text":"Console shows “Re-entrant Store.send(…) — deferring”","level":2,"type":"heading","anchor":"Console-shows-Re-entrant-Storesend-deferring"},{"inlineContent":[{"type":"text","text":"Something called "},{"type":"codeVoice","code":"store.send"},{"type":"text","text":" synchronously from inside a reducer or plugin"},{"type":"text","text":" "},{"type":"text","text":"hook — usually a plugin observing state and dispatching in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":", or a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Binding"},{"type":"text","text":" setter fired during view updates. The store defers the inner action"},{"type":"text","text":" "},{"type":"text","text":"and runs it as a full cycle right after the current one, so state stays"},{"type":"text","text":" "},{"type":"text","text":"consistent — but the fault log is telling you the design wants that follow-up"},{"type":"text","text":" "},{"type":"text","text":"dispatched from an "},{"type":"codeVoice","code":"Effect"},{"type":"text","text":" instead."}],"type":"paragraph"},{"text":"`call to main actor-isolated initializer … in a synchronous nonisolated context`","level":2,"type":"heading","anchor":"call-to-main-actor-isolated-initializer--in-a-synchronous-nonisolated-context"},{"inlineContent":[{"type":"text","text":"The module is compiling in Swift 5 language mode with"},{"type":"text","text":" "},{"type":"codeVoice","code":"SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor"},{"type":"text","text":". A "},{"type":"codeVoice","code":"@Swidux nonisolated struct"},{"type":"text","text":" "},{"type":"text","text":"only gets a nonisolated synthesized memberwise initializer under "},{"type":"strong","inlineContent":[{"text":"Swift 6","type":"text"},{"text":" ","type":"text"},{"text":"mode","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"SWIFT_VERSION = 6.0"},{"type":"text","text":"); under Swift 5 mode the macro’s state"},{"type":"text","text":" "},{"type":"text","text":"reconstruction can’t call it, and adding an explicit "},{"type":"codeVoice","code":"nonisolated init"},{"type":"text","text":" does"},{"type":"text","text":" "},{"type":"text","text":"not rescue it. Switch the target to Swift 6 mode."}],"type":"paragraph"},{"level":2,"text":"Error: “stored properties need an explicit type annotation”","anchor":"Error-stored-properties-need-an-explicit-type-annotation","type":"heading"},{"inlineContent":[{"code":"var flag = false","type":"codeVoice"},{"type":"text","text":" gives the compiler an inferred type, but macros can’t see"},{"type":"text","text":" "},{"type":"text","text":"it — before this diagnostic existed, such a property was silently skipped and"},{"type":"text","text":" "},{"type":"text","text":"its value reset on every dispatch. Write "},{"code":"var flag: Bool = false","type":"codeVoice"},{"type":"text","text":". The same"},{"type":"text","text":" "},{"type":"text","text":"applies to combined declarations: split "},{"code":"var a, b: Int","type":"codeVoice"},{"type":"text","text":" into separate"},{"type":"text","text":" "},{"type":"text","text":"declarations."}],"type":"paragraph"},{"level":2,"text":"Keychain writes fail with OSStatus −34018 (`errSecMissingEntitlement`)","anchor":"Keychain-writes-fail-with-OSStatus-%E2%88%9234018-errSecMissingEntitlement","type":"heading"},{"inlineContent":[{"type":"text","text":"An unsigned local or CI build is using "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true,"type":"reference"},{"type":"text","text":" without a"},{"type":"text","text":" "},{"type":"text","text":"provisioning profile. This is a signing condition, not a prompt or a bug — the"},{"type":"text","text":" "},{"type":"text","text":"data-protection keychain never prompts. Ship provisioning-profile-signed builds"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"accessGroup: nil"},{"type":"text","text":"; for unsigned local\/CI builds add a single"},{"text":" ","type":"text"},{"text":"team-prefixed ","type":"text"},{"code":"keychain-access-groups","type":"codeVoice"},{"text":" entitlement. Details in","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Edits-disappear-after-a-sync-tick-or-an-async-load","text":"Edits disappear after a sync tick or an async load","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Symptom: a keystroke, a toggle, or a whole entity vanishes — intermittently,"},{"type":"text","text":" "},{"type":"text","text":"usually while something is loading or syncing, and never reproducibly."}],"type":"paragraph"},{"inlineContent":[{"text":"The cause is almost always a hand-rolled bridge from ","type":"text"},{"code":"async","type":"codeVoice"},{"text":" work into the","type":"text"},{"text":" ","type":"text"},{"text":"store. ","type":"text"},{"code":"Store","type":"codeVoice"},{"text":" keeps state in an ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" observer tree and converts to a"},{"type":"text","text":" "},{"type":"text","text":"value-type snapshot on the way in and out (“pack” and “unpack”). If you pack a"},{"type":"text","text":" "},{"type":"text","text":"snapshot, "},{"code":"await","type":"codeVoice"},{"type":"text","text":" something, and then unpack it, everything dispatched during"},{"type":"text","text":" "},{"text":"the ","type":"text"},{"code":"await","type":"codeVoice"},{"text":" is silently overwritten:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["var snapshot = AppState(observer: store.observer)   \/\/ ← packed BEFORE the await","await loadEverything(into: &snapshot)               \/\/ ← dispatches land here…","AppState.apply(snapshot, to: store.observer)        \/\/ ← …and are discarded here"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"inout State"},{"text":" across a suspension point is the tell. The window is only as wide","type":"text"},{"text":" ","type":"text"},{"text":"as the ","type":"text"},{"code":"await","type":"codeVoice"},{"type":"text","text":", which is why it presents as a rare glitch rather than a"},{"type":"text","text":" "},{"type":"text","text":"reproducible bug."}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","isActive":true,"type":"reference"},{"text":" instead. It runs the async work with no","type":"text"},{"text":" ","type":"text"},{"text":"access to state, then packs a ","type":"text"},{"inlineContent":[{"type":"text","text":"fresh"}],"type":"emphasis"},{"text":" snapshot, merges, and unpacks in a single","type":"text"},{"type":"text","text":" "},{"type":"text","text":"step with no suspension point in between — so no dispatch can interleave:"}]},{"type":"codeListing","syntax":"swift","code":["await store.mutate {","    try await api.fetchItems()          \/\/ no state in scope; nothing to stale","} merging: { items, state in","    state.items.merge(from: EntityStore(items)) { _, _ in false }","}"]},{"inlineContent":[{"text":"The persistence stack’s own async entry points already work this way — use","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"persistence.rehydrate(into: store)"},{"type":"text","text":" and "},{"code":"sync.setSyncEnabled(_:into: store)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"not a snapshot you manage yourself. (","type":"text"},{"code":"hydrate(into: &state)","type":"codeVoice"},{"text":" is the exception,","type":"text"},{"text":" ","type":"text"},{"text":"and safe: it runs at launch, before the store exists.)","type":"text"}],"type":"paragraph"},{"anchor":"Contributors-the-lint-plugin-doesnt-run--dev-tooling-is-missing","level":2,"text":"Contributors: the lint plugin doesn’t run \/ dev tooling is missing","type":"heading"},{"inlineContent":[{"text":"Dev tooling (the Persnoop linter, the DocC plugin) is gated behind a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"gitignored "},{"code":".dev-tooling","type":"codeVoice"},{"type":"text","text":" sentinel file so it never leaks into consumers’"},{"type":"text","text":" "},{"type":"text","text":"dependency graphs. Create it at the package root — and if the package was"},{"type":"text","text":" "},{"type":"text","text":"already built without it, run "},{"type":"codeVoice","code":"swift package purge-cache"},{"type":"text","text":" so SwiftPM re-reads"},{"type":"text","text":" "},{"type":"text","text":"the manifest. See the repository’s "},{"type":"codeVoice","code":"CONTRIBUTING.md"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"A `@Persisted` app crashes only in Release","type":"heading","level":2,"anchor":"A-Persisted-app-crashes-only-in-Release"},{"type":"paragraph","inlineContent":[{"text":"If the crash is in fetching, make sure you’re on ≥ 1.3.0: generic","type":"text"},{"text":" ","type":"text"},{"code":"#Predicate","type":"codeVoice"},{"text":" over a protocol-required keypath traps under ","type":"text"},{"code":"-O","type":"codeVoice"},{"text":", which is why","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the macro generates a per-model "},{"type":"codeVoice","code":"swiduxBatchFetchDescriptor"},{"type":"text","text":". Run"},{"type":"text","text":" "},{"type":"codeVoice","code":"swift test -c release"},{"type":"text","text":" in CI to catch this class of issue — Debug builds and"},{"type":"text","text":" "},{"text":"default ","type":"text"},{"code":"swift test","type":"codeVoice"},{"type":"text","text":" pass."}]}]}],"references":{"doc://Swidux/documentation/Swidux/UndoRedo":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","role":"article","kind":"article","url":"\/documentation\/swidux\/undoredo","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":"."}],"type":"topic","title":"Undo \/ Redo"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","url":"\/documentation\/swidux\/pluginfeatureflagsreference","type":"topic","role":"article","title":"SwiduxFeatureFlags Reference","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"kind":"article"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"type":"topic","kind":"article","title":"SwiduxKill