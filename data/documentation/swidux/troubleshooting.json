{"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/troubleshooting"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"title":"Troubleshooting","modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"},"abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"anchor":"Reference","title":"Reference"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Xcode asks to “Trust & Enable” a macro","type":"heading","level":2,"anchor":"Xcode-asks-to-Trust--Enable-a-macro"},{"inlineContent":[{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" are compiler plugins, so the first build in Xcode","type":"text"},{"text":" ","type":"text"},{"text":"prompts once per machine to trust the ","type":"text"},{"type":"codeVoice","code":"SwiduxMacros"},{"text":" target. Approve it in the","type":"text"},{"text":" ","type":"text"},{"text":"build error’s fix-it or under ","type":"text"},{"inlineContent":[{"type":"text","text":"Settings → Packages"}],"type":"strong"},{"text":". On CI, pass","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"-skipMacroValidation"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"xcodebuild"},{"text":" instead — there’s no one to click the","type":"text"},{"text":" ","type":"text"},{"text":"dialog.","type":"text"}],"type":"paragraph"},{"text":"The first build is slow","type":"heading","level":2,"anchor":"The-first-build-is-slow"},{"inlineContent":[{"text":"Swidux depends on ","type":"text"},{"type":"codeVoice","code":"swift-syntax"},{"text":", which the macro system compiles from source","type":"text"},{"text":" ","type":"text"},{"text":"on first build (a few minutes on CI-class hardware). It’s cached afterwards;","type":"text"},{"text":" ","type":"text"},{"text":"nothing is wrong. CI pipelines benefit from caching ","type":"text"},{"type":"codeVoice","code":".build\/"},{"text":" or DerivedData.","type":"text"}],"type":"paragraph"},{"text":"Console shows “Re-entrant Store.send(…) — deferring”","type":"heading","level":2,"anchor":"Console-shows-Re-entrant-Storesend-deferring"},{"inlineContent":[{"text":"Something called ","type":"text"},{"type":"codeVoice","code":"store.send"},{"text":" synchronously from inside a reducer or plugin","type":"text"},{"text":" ","type":"text"},{"text":"hook — usually a plugin observing state and dispatching in ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":", or a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Binding"},{"text":" setter fired during view updates. The store defers the inner action","type":"text"},{"text":" ","type":"text"},{"text":"and runs it as a full cycle right after the current one, so state stays","type":"text"},{"text":" ","type":"text"},{"text":"consistent — but the fault log is telling you the design wants that follow-up","type":"text"},{"text":" ","type":"text"},{"text":"dispatched from an ","type":"text"},{"type":"codeVoice","code":"Effect"},{"text":" instead.","type":"text"}],"type":"paragraph"},{"text":"`call to main actor-isolated initializer … in a synchronous nonisolated context`","type":"heading","level":2,"anchor":"call-to-main-actor-isolated-initializer--in-a-synchronous-nonisolated-context"},{"inlineContent":[{"text":"The module is compiling in Swift 5 language mode with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor"},{"text":". A ","type":"text"},{"type":"codeVoice","code":"@Swidux nonisolated struct"},{"text":" ","type":"text"},{"text":"only gets a nonisolated synthesized memberwise initializer under ","type":"text"},{"inlineContent":[{"type":"text","text":"Swift 6"},{"type":"text","text":" "},{"type":"text","text":"mode"}],"type":"strong"},{"text":" (","type":"text"},{"type":"codeVoice","code":"SWIFT_VERSION = 6.0"},{"text":"); under Swift 5 mode the macro’s state","type":"text"},{"text":" ","type":"text"},{"text":"reconstruction can’t call it, and adding an explicit ","type":"text"},{"type":"codeVoice","code":"nonisolated init"},{"text":" does","type":"text"},{"text":" ","type":"text"},{"text":"not rescue it. Switch the target to Swift 6 mode.","type":"text"}],"type":"paragraph"},{"text":"Error: “stored properties need an explicit type annotation”","type":"heading","level":2,"anchor":"Error-stored-properties-need-an-explicit-type-annotation"},{"inlineContent":[{"type":"codeVoice","code":"var flag = false"},{"text":" gives the compiler an inferred type, but macros can’t see","type":"text"},{"text":" ","type":"text"},{"text":"it — before this diagnostic existed, such a property was silently skipped and","type":"text"},{"text":" ","type":"text"},{"text":"its value reset on every dispatch. Write ","type":"text"},{"type":"codeVoice","code":"var flag: Bool = false"},{"text":". The same","type":"text"},{"text":" ","type":"text"},{"text":"applies to combined declarations: split ","type":"text"},{"type":"codeVoice","code":"var a, b: Int"},{"text":" into separate","type":"text"},{"text":" ","type":"text"},{"text":"declarations.","type":"text"}],"type":"paragraph"},{"text":"Keychain writes fail with OSStatus −34018 (`errSecMissingEntitlement`)","type":"heading","level":2,"anchor":"Keychain-writes-fail-with-OSStatus-%E2%88%9234018-errSecMissingEntitlement"},{"inlineContent":[{"text":"An unsigned local or CI build is using ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"},{"text":" without a","type":"text"},{"text":" ","type":"text"},{"text":"provisioning profile. This is a signing condition, not a prompt or a bug — the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"data-protection keychain never prompts."}],"type":"paragraph"},{"inlineContent":[{"text":"Nothing is persisted, but nothing crashes either: the write logs, returns","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", and the app continues. Ship provisioning-profile-signed builds with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"accessGroup: nil"},{"text":" to get real persistence.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Adding a team-prefixed ","type":"text"},{"type":"codeVoice","code":"keychain-access-groups"},{"text":" entitlement also works, and is","type":"text"},{"text":" ","type":"text"},{"text":"the right call when you want the access group — but weigh it first, because it","type":"text"},{"text":" ","type":"text"},{"text":"makes the app require a provisioning profile for every signed build. It is","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" a fix for a test host: ","type":"text"},{"type":"codeVoice","code":"CODE_SIGNING_ALLOWED=NO"},{"text":" embeds no entitlements","type":"text"},{"text":" ","type":"text"},{"text":"at all, so there is nothing for the entitlement to attach to. Let the write","type":"text"},{"text":" ","type":"text"},{"text":"degrade there. Details in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"`Test crashed with signal trap before establishing connection`","type":"heading","level":2,"anchor":"Test-crashed-with-signal-trap-before-establishing-connection"},{"inlineContent":[{"type":"codeVoice","code":"xcodebuild test"},{"text":" dies before any test runs, naming nothing useful. If the app","type":"text"},{"text":" ","type":"text"},{"text":"mints a device identity or writes a token at launch, suspect the Keychain: the","type":"text"},{"text":" ","type":"text"},{"text":"test host is unsigned, the write fails, and a trap takes the process down before","type":"text"},{"text":" ","type":"text"},{"text":"the test bundle can attach.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Current versions degrade instead of trapping here, so upgrading Swidux is the","type":"text"},{"text":" ","type":"text"},{"text":"fix. To confirm the diagnosis on an older one, run the same scheme with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"CODE_SIGNING_ALLOWED=YES"},{"text":" — if it gets past launch, the Keychain was the cause.","type":"text"}],"type":"paragraph"},{"text":"Edits disappear after a sync tick or an async load","type":"heading","level":2,"anchor":"Edits-disappear-after-a-sync-tick-or-an-async-load"},{"inlineContent":[{"type":"text","text":"Symptom: a keystroke, a toggle, or a whole entity vanishes — intermittently,"},{"type":"text","text":" "},{"type":"text","text":"usually while something is loading or syncing, and never reproducibly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The cause is almost always a hand-rolled bridge from "},{"code":"async","type":"codeVoice"},{"type":"text","text":" work into the"},{"type":"text","text":" "},{"type":"text","text":"store. "},{"code":"Store","type":"codeVoice"},{"type":"text","text":" keeps state in an "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" observer tree and converts to a"},{"type":"text","text":" "},{"type":"text","text":"value-type snapshot on the way in and out (“pack” and “unpack”). If you pack a"},{"type":"text","text":" "},{"type":"text","text":"snapshot, "},{"code":"await","type":"codeVoice"},{"type":"text","text":" something, and then unpack it, everything dispatched during"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"await","type":"codeVoice"},{"type":"text","text":" is silently overwritten:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["var snapshot = AppState(observer: store.observer)   \/\/ ← packed BEFORE the await","await loadEverything(into: &snapshot)               \/\/ ← dispatches land here…","AppState.apply(snapshot, to: store.observer)        \/\/ ← …and are discarded here"]},{"inlineContent":[{"type":"codeVoice","code":"inout State"},{"type":"text","text":" across a suspension point is the tell. The window is only as wide"},{"type":"text","text":" "},{"type":"text","text":"as the "},{"type":"codeVoice","code":"await"},{"type":"text","text":", which is why it presents as a rare glitch rather than a"},{"type":"text","text":" "},{"type":"text","text":"reproducible bug."}],"type":"paragraph"},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","isActive":true,"type":"reference"},{"text":" instead. It runs the async work with no","type":"text"},{"text":" ","type":"text"},{"text":"access to state, then packs a ","type":"text"},{"inlineContent":[{"type":"text","text":"fresh"}],"type":"emphasis"},{"text":" snapshot, merges, and unpacks in a single","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"step with no suspension point in between — so no dispatch can interleave:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["await store.mutate {","    try await api.fetchItems()          \/\/ no state in scope; nothing to stale","} merging: { items, state in","    state.items.merge(from: EntityStore(items)) { _, _ in false }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The persistence stack’s own async entry points already work this way — use"},{"type":"text","text":" "},{"code":"persistence.rehydrate(into: store)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sync.setSyncEnabled(_:into: store)","type":"codeVoice"},{"text":",","type":"text"},{"type":"text","text":" "},{"text":"not a snapshot you manage yourself. (","type":"text"},{"code":"hydrate(into: &state)","type":"codeVoice"},{"text":" is the exception,","type":"text"},{"type":"text","text":" "},{"text":"and safe: it runs at launch, before the store exists.)","type":"text"}]},{"text":"Contributors: the lint plugin doesn’t run \/ dev tooling is missing","type":"heading","level":2,"anchor":"Contributors-the-lint-plugin-doesnt-run--dev-tooling-is-missing"},{"type":"paragraph","inlineContent":[{"text":"Dev tooling (the Persnoop linter, the DocC plugin) is gated behind a","type":"text"},{"text":" ","type":"text"},{"text":"gitignored ","type":"text"},{"type":"codeVoice","code":".dev-tooling"},{"type":"text","text":" sentinel file so it never leaks into consumers’"},{"text":" ","type":"text"},{"type":"text","text":"dependency graphs. Create it at the package root — and if the package was"},{"text":" ","type":"text"},{"type":"text","text":"already built without it, run "},{"type":"codeVoice","code":"swift package purge-cache"},{"type":"text","text":" so SwiftPM re-reads"},{"text":" ","type":"text"},{"type":"text","text":"the manifest. See the repository’s "},{"code":"CONTRIBUTING.md","type":"codeVoice"},{"text":".","type":"text"}]},{"anchor":"A-Persisted-app-crashes-only-in-Release","type":"heading","text":"A `@Persisted` app crashes only in Release","level":2},{"inlineContent":[{"type":"text","text":"If the crash is in fetching, make sure you’re on ≥ 1.3.0: generic"},{"type":"text","text":" "},{"type":"codeVoice","code":"#Predicate"},{"text":" over a protocol-required keypath traps under ","type":"text"},{"type":"codeVoice","code":"-O"},{"text":", which is why","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the macro generates a per-model "},{"type":"codeVoice","code":"swiduxBatchFetchDescriptor"},{"type":"text","text":" — one for "},{"type":"codeVoice","code":"id"},{"type":"text","text":","},{"text":" ","type":"text"},{"type":"text","text":"one for "},{"code":"persistentModelID","type":"codeVoice"},{"type":"text","text":" — and why every by-identifier read goes through"},{"type":"text","text":" "},{"type":"text","text":"one instead of building a predicate inline. Run "},{"code":"swift test -c release","type":"codeVoice"},{"type":"text","text":" in CI"},{"type":"text","text":" "},{"type":"text","text":"to catch this class of issue — Debug builds and default "},{"type":"codeVoice","code":"swift test"},{"text":" pass.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://Swidux/documentation/Swidux/GettingStarted":{"url":"\/documentation\/swidux\/gettingstarted","kind":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","title":"Getting Started with Swidux","role":"article"},"doc://Swidux/documentation/Swidux/UndoRedo":{"url":"\/documentation\/swidux\/undoredo","kind":"article","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":".","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"topic","title":"Undo \/ Redo","role":"article"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"url":"\/documentation\/swidux\/pluginfeatureflagsreference","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","type":"topic","title":"SwiduxFeatureFlags Reference","role":"article"},"doc://Swidux/documentation/Swidux":{"role":"collection","url":"\/documentation\/swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","type":"topic","title":"Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}]},"doc://Swidux/documentation/Swidux/KeychainKeyValueStore":{"url":"\/documentation\/swidux\/keychainkeyvaluestore","kind":"symbol","abstract":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"KeyValueStore"},{"text":" backed by the system Keychain.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"topic","title":"KeychainKeyValueStore","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyValueStore","kind":"identifier"}],"navigatorTitle":[{"text":"KeychainKeyValueStore","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"url":"\/documentation\/swidux\/pluginpaywallreference","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic","title":"SwiduxPaywall Reference","role":"article"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"url":"\/documentation\/swidux\/keyvaluestoreguide","kind":"article","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"title":"KeyValueStore","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","role":"collectionGroup"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"url":"\/documentation\/swidux\/undoplugin","kind":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"topic","title":"UndoPlugin","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"url":"\/documentation\/swidux\/pluginanalyticsreference","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","type":"topic","title":"SwiduxAnalytics Reference","role":"article"},"doc://Swidux/documentation/Swidux/MacrosReference":{"kind":"article","url":"\/documentation\/swidux\/macrosreference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","abstract":[{"text":"Reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":").","type":"text"}],"title":"Macros","role":"article"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"url":"\/documentation\/swidux\/pluginkillswitchreference","kind":"article","abstract":[{"text":"Public API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","type":"topic","title":"SwiduxKillswitch Reference","role":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"url":"\/documentation\/swidux\/pluginparentalgatereference","kind":"article","abstract":[{"text":"API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","type":"topic","title":"SwiduxParentalGate Reference","role":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"url":"\/documentation\/swidux\/entitystoreguide","kind":"article","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"topic","title":"EntityStore","role":"article"},"doc://Swidux/documentation/Swidux/Store/mutate(awaiting:merging:)":{"url":"\/documentation\/swidux\/store\/mutate(awaiting:merging:)","kind":"symbol","abstract":[{"text":"Runs async work that must not hold state across its suspensions, then","type":"text"},{"text":" ","type":"text"},{"text":"folds the result into a ","type":"text"},{"inlineContent":[{"type":"text","text":"freshly packed"}],"type":"strong"},{"text":" snapshot in one","type":"text"},{"text":" ","type":"text"},{"text":"suspension-free step.","type":"text"}],"title":"mutate(awaiting:merging:)","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"mutate","kind":"identifier"},{"kind":"text","text":"<"},{"text":"Value","kind":"genericParameter"},{"kind":"text","text":">("},{"text":"awaiting","kind":"externalParam"},{"kind":"text","text":": () "},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"merging","kind":"externalParam"},{"kind":"text","text":": ("},{"text":"Value","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"keyword","text":"inout"},{"text":" ","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"Void","preciseIdentifier":"s:s4Voida","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rethrows","kind":"keyword"}]},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"url":"\/documentation\/swidux\/persistencemiddlewareguide","kind":"article","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"topic","title":"Persistence Middleware","role":"article"}}}