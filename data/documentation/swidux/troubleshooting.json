/PluginParentalGateReference"},"doc://Swidux/documentation/Swidux/MacrosReference":{"url":"\/documentation\/swidux\/macrosreference","abstract":[{"text":"Reference for ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" and its property markers (the SwiftData persistence bridge, shipped in ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":").","type":"text"}],"role":"article","title":"Macros","type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"},"doc://Swidux/documentation/Swidux/UndoRedo":{"url":"\/documentation\/swidux\/undoredo","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":"."}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","title":"Undo \/ Redo","role":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"url":"\/documentation\/swidux\/entitystoreguide","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","title":"EntityStore","role":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"url":"\/documentation\/swidux\/gettingstarted","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","title":"Getting Started with Swidux","role":"article"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"url":"\/documentation\/s