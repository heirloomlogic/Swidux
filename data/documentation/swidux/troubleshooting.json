"kind":"article","role":"article","title":"Getting Started with Swidux"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"type":"topic","url":"\/documentation\/swidux\/pluginfeatureflagsreference","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","kind":"article","role":"article","title":"SwiduxFeatureFlags Reference"},"doc://Swidux/documentation/Swidux/KeychainKeyValueStore":{"type":"topic","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","title":"KeychainKeyValueStore","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"KeychainKeyValueStore"}],"url":"\/documentation\/swidux\/keychainkeyvaluestore","abstract":[{"text":"A ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":" backed by the system Keychain.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"KeychainKeyValueStore","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/MacrosReference":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","title":"Macros","role":"article","url":"\/documentation\/swidux\/macrosreference","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":")."}]},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"type":"topic","url":"\/documentation\/swidux\/pluginparentalgatereference","abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","kind":"article","role":"article","title":"SwiduxParentalGate Reference"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"type":"topic","url":"\/documentation\/swidux\/keyvaluestoreguide","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","kind":"article","role":"collectionGroup","title":"KeyValueStore"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"type":"topic","url":"\/documentation\/swidux\/pluginkillswitchreference","abstract":[{"text":"Public API surface for the ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","kind":"article","role":"article","title":"SwiduxKillswitch Reference"}}}