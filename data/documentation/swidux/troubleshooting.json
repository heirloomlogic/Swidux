{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"Troubleshooting","role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"title":"Reference","anchor":"Reference"}],"abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Xcode-asks-to-Trust--Enable-a-macro","text":"Xcode asks to “Trust & Enable” a macro","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" are compiler plugins, so the first build in Xcode"},{"type":"text","text":" "},{"type":"text","text":"prompts once per machine to trust the "},{"type":"codeVoice","code":"SwiduxMacros"},{"type":"text","text":" target. Approve it in the"},{"type":"text","text":" "},{"type":"text","text":"build error’s fix-it or under "},{"type":"strong","inlineContent":[{"type":"text","text":"Settings → Packages"}]},{"type":"text","text":". On CI, pass"},{"type":"text","text":" "},{"type":"codeVoice","code":"-skipMacroValidation"},{"type":"text","text":" to "},{"type":"codeVoice","code":"xcodebuild"},{"type":"text","text":" instead — there’s no one to click the"},{"type":"text","text":" "},{"type":"text","text":"dialog."}]},{"anchor":"The-first-build-is-slow","text":"The first build is slow","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Swidux depends on ","type":"text"},{"type":"codeVoice","code":"swift-syntax"},{"text":", which the macro system compiles from source","type":"text"},{"text":" ","type":"text"},{"text":"on first build (a few minutes on CI-class hardware). It’s cached afterwards;","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"nothing is wrong. CI pipelines benefit from caching "},{"code":".build\/","type":"codeVoice"},{"type":"text","text":" or DerivedData."}]},{"anchor":"Console-shows-Re-entrant-Storesend-deferring","level":2,"text":"Console shows “Re-entrant Store.send(…) — deferring”","type":"heading"},{"inlineContent":[{"type":"text","text":"Something called "},{"type":"codeVoice","code":"store.send"},{"type":"text","text":" synchronously from inside a reducer or plugin"},{"type":"text","text":" "},{"type":"text","text":"hook — usually a plugin observing state and dispatching in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":", or a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Binding"},{"type":"text","text":" setter fired during view updates. The store defers the inner action"},{"type":"text","text":" "},{"type":"text","text":"and runs it as a full cycle right after the current one, so state stays"},{"type":"text","text":" "},{"type":"text","text":"consistent — but the fault log is telling you the design wants that follow-up"},{"type":"text","text":" "},{"type":"text","text":"dispatched from an "},{"type":"codeVoice","code":"Effect"},{"type":"text","text":" instead."}],"type":"paragraph"},{"type":"heading","text":"`call to main actor-isolated initializer … in a synchronous nonisolated context`","level":2,"anchor":"call-to-main-actor-isolated-initializer--in-a-synchronous-nonisolated-context"},{"type":"paragraph","inlineContent":[{"text":"The module is compiling in Swift 5 language mode with","type":"text"},{"text":" ","type":"text"},{"code":"SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"@Swidux nonisolated struct","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"only gets a nonisolated synthesized memberwise initializer under "},{"inlineContent":[{"text":"Swift 6","type":"text"},{"text":" ","type":"text"},{"text":"mode","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"code":"SWIFT_VERSION = 6.0","type":"codeVoice"},{"text":"); under Swift 5 mode the macro’s state","type":"text"},{"text":" ","type":"text"},{"text":"reconstruction can’t call it, and adding an explicit ","type":"text"},{"type":"codeVoice","code":"nonisolated init"},{"type":"text","text":" does"},{"type":"text","text":" "},{"type":"text","text":"not rescue it. Switch the target to Swift 6 mode."}]},{"type":"heading","text":"Error: “stored properties need an explicit type annotation”","level":2,"anchor":"Error-stored-properties-need-an-explicit-type-annotation"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"var flag = false"},{"type":"text","text":" gives the compiler an inferred type, but macros can’t see"},{"type":"text","text":" "},{"type":"text","text":"it — before this diagnostic existed, such a property was silently skipped and"},{"type":"text","text":" "},{"type":"text","text":"its value reset on every dispatch. Write "},{"type":"codeVoice","code":"var flag: Bool = false"},{"type":"text","text":". The same"},{"type":"text","text":" "},{"type":"text","text":"applies to combined declarations: split "},{"type":"codeVoice","code":"var a, b: Int"},{"type":"text","text":" into separate"},{"type":"text","text":" "},{"type":"text","text":"declarations."}]},{"type":"heading","text":"Keychain writes fail with OSStatus −34018 (`errSecMissingEntitlement`)","level":2,"anchor":"Keychain-writes-fail-with-OSStatus-%E2%88%9234018-errSecMissingEntitlement"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An unsigned local or CI build is using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"},{"type":"text","text":" without a"},{"type":"text","text":" "},{"type":"text","text":"provisioning profile. This is a signing condition, not a prompt or a bug — the"},{"type":"text","text":" "},{"type":"text","text":"data-protection keychain never prompts. Ship provisioning-profile-signed builds"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"codeVoice","code":"accessGroup: nil"},{"type":"text","text":"; for unsigned local\/CI builds add a single"},{"type":"text","text":" "},{"type":"text","text":"team-prefixed "},{"type":"codeVoice","code":"keychain-access-groups"},{"type":"text","text":" entitlement. Details in"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","isActive":true},{"text":".","type":"text"}]},{"anchor":"Contributors-the-lint-plugin-doesnt-run--dev-tooling-is-missing","level":2,"text":"Contributors: the lint plugin doesn’t run \/ dev tooling is missing","type":"heading"},{"inlineContent":[{"text":"Dev tooling (the Persnoop linter, the DocC plugin) is gated behind a","type":"text"},{"type":"text","text":" "},{"text":"gitignored ","type":"text"},{"type":"codeVoice","code":".dev-tooling"},{"type":"text","text":" sentinel file so it never leaks into consumers’"},{"type":"text","text":" "},{"type":"text","text":"dependency graphs. Create it at the package root — and if the package was"},{"text":" ","type":"text"},{"type":"text","text":"already built without it, run "},{"type":"codeVoice","code":"swift package purge-cache"},{"type":"text","text":" so SwiftPM re-reads"},{"type":"text","text":" "},{"type":"text","text":"the manifest. See the repository’s "},{"type":"codeVoice","code":"CONTRIBUTING.md"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"A-Persisted-app-crashes-only-in-Release","level":2,"text":"A `@Persisted` app crashes only in Release","type":"heading"},{"inlineContent":[{"type":"text","text":"If the crash is in fetching, make sure you’re on ≥ 1.3.0: generic"},{"type":"text","text":" "},{"type":"codeVoice","code":"#Predicate"},{"type":"text","text":" over a protocol-required keypath traps under "},{"type":"codeVoice","code":"-O"},{"type":"text","text":", which is why"},{"text":" ","type":"text"},{"text":"the macro generates a per-model ","type":"text"},{"type":"codeVoice","code":"swiduxFetchDescriptor"},{"text":". Run","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"swift test -c release"},{"type":"text","text":" in CI to catch this class of issue — Debug builds and"},{"text":" ","type":"text"},{"type":"text","text":"default "},{"type":"codeVoice","code":"swift test"},{"type":"text","text":" pass."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/swidux\/troubleshooting"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","references":{"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","url":"\/documentation\/swidux\/undoplugin","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"title":"UndoPlugin","role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","url":"\/documentation\/swidux\/p