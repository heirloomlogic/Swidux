{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"},"seeAlsoSections":[{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"anchor":"Reference","generated":true}],"abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"kind":"article","metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}],"title":"Troubleshooting"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Xcode asks to “Trust & Enable” a macro","anchor":"Xcode-asks-to-Trust--Enable-a-macro"},{"inlineContent":[{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" and "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" are compiler plugins, so the first build in Xcode"},{"type":"text","text":" "},{"type":"text","text":"prompts once per machine to trust the "},{"code":"SwiduxMacros","type":"codeVoice"},{"type":"text","text":" target. Approve it in the"},{"type":"text","text":" "},{"type":"text","text":"build error’s fix-it or under "},{"type":"strong","inlineContent":[{"text":"Settings → Packages","type":"text"}]},{"text":". On CI, pass","type":"text"},{"type":"text","text":" "},{"code":"