ind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"rethrows"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","role":"symbol","abstract":[{"type":"text","text":"Runs async work that must not hold state across its suspensions, then"},{"type":"text","text":" "},{"type":"text","text":"folds the result into a "},{"type":"strong","inlineContent":[{"type":"text","text":"freshly packed"}]},{"type":"text","text":" snapshot in one"},{"type":"text","text":" "},{"type":"text","text":"suspension-free step."}],"title":"mutate(awaiting:merging:)","kind":"symbol"},"doc://Swidux/documentation/Swidux/KeychainKeyValueStore":{"url":"\/documentation\/swidux\/keychainkeyvaluestore","kind":"symbol","abstract":[{"type":"text","text":"A "},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":" backed by the system Keychain."}],"title":"KeychainKeyValueStore","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyValueStore","kind":"identifier"}],"navigatorTitle":[{"text":"KeychainKeyValueStore","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"topic"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"url":"\/documentation\/swidux\/undoplugin","kind":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"title":"UndoPlugin","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"topic"},"doc://Swidux/documentation/Swidux/UndoRedo":{"role":"article","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":"."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","kind":"article","title":"Undo \/ Redo","url":"\/documentation\/swidux\/undoredo","type":"topic"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"role":"article","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","kind":"article","title":"SwiduxPaywall Reference","url":"\/documentation\/swidux\/pluginpaywallreference","type":"topic"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"role":"article","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","kind":"article","title":"SwiduxFeatureFlags Reference","url":"\/documentation\/swidux\/pluginfeatureflagsreference","type":"topic"},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","kind":"article","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","type":"topic"}}}