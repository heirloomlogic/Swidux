your project and wire up unidirectional data flow with automatic persistence."}],"title":"Getting Started with Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","url":"\/documentation\/swidux\/gettingstarted","role":"article"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"kind":"article","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"title":"KeyValueStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","type":"topic","url":"\/documentation\/swidux\/keyvaluestoreguide","role":"collectionGroup"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"title":"SwiduxAnalytics Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","type":"topic","url":"\/documentation\/swidux\/pluginanalyticsreference","role":"article"},"doc://Swidux/documentation/Swidux/Store/mutate(awaiting:merging:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mutate"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">("},{"kind":"externalParam","text":"awaiting"},{"kind":"text","text":": () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":", "},{"kind":"externalParam","text":"merging"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":", "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:s4Voida","text":"Void"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"rethrows"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","abstract":[{"text":"Runs async work that must not hold state across its suspensions, then","type":"text"},{"text":" ","type":"text"},{"text":"folds the result into a ","type":"text"},{"inlineContent":[{"type":"text","text":"freshly packed"}],"type":"strong"},{"text":" snapshot in one","type":"text"},{"text":" ","type":"text"},{"text":"suspension-free step.","type":"text"}],"type":"topic","kind":"symbol","title":"mutate(awaiting:merging:)","url":"\/documentation\/swidux\/store\/mutate(awaiting:merging:)"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"type":"topic","kind":"article","title":"SwiduxFeatureFlags Reference","url":"\/documentation\/swidux\/pluginfeatureflagsreference"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"kind":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"title":"EntityStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"topic","url":"\/documentation\/swidux\/entitystoreguide","role":"article"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"kind":"article","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"title":"Persistence Plugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"topic","url":"\/documentation\/swidux\/persistencemiddlewareguide","role":"article"},"doc://Swidux/documentation/Swidux/KeychainKeyValueStore":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeychainKeyValueStore"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","title":"KeychainKeyValueStore","kind":"symbol","abstract":[{"text":"A ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":" backed by the system Keychain.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/swidux\/keychainkeyvaluestore","navigatorTitle":[{"kind":"identifier","text":"KeychainKeyValueStore"}]},"doc://Swidux/documentation/Swidux/EntityEditingGuide":{"kind":"article","abstract":[{"type":"text","text":"Keep editor drafts separate from current application state, then apply their changes as one local group."}],"title":"Editing canonical entities","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityEditingGuide","type":"topic","url":"\/documentation\/swidux\/entityeditingguide","role":"article"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"kind":"article","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"title":"SwiduxKillswitch Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","type":"topic","url":"\/documentation\/swidux\/pluginkillswitchreference","role":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"kind":"article","abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"title":"SwiduxParentalGate Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","type":"topic","url":"\/documentation\/swidux\/pluginparentalgatereference","role":"article"},"doc://Swidux/documentation/Swidux/UndoRedo":{"kind":"article","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":"."}],"title":"Undo \/ Redo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"topic","url":"\/documentation\/swidux\/undoredo","role":"article"}}}