{"metadata":{"title":"Troubleshooting","role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"title":"Reference","anchor":"Reference","generated":true}],"sections":[],"primaryContentSections":[{"content":[{"anchor":"Xcode-asks-to-Trust--Enable-a-macro","text":"Xcode asks to “Trust & Enable” a macro","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" are compiler plugins, so the first build in Xcode"},{"type":"text","text":" "},{"type":"text","text":"prompts once per machine to trust the "},{"type":"codeVoice","code":"SwiduxMacros"},{"type":"text","text":" target. Approve it in the"},{"type":"text","text":" "},{"type":"text","text":"build error’s fix-it or under "},{"type":"strong","inlineContent":[{"type":"text","text":"Settings → Packages"}]},{"type":"text","text":". On CI, pass"},{"type":"text","text":" "},{"type":"codeVoice","code":"-skipMacroValidation"},{"type":"text","text":" to "},{"type":"codeVoice","code":"xcodebuild"},{"type":"text","text":" instead — there’s no one to click the"},{"type":"text","text":" "},{"type":"text","text":"dialog."}]},{"anchor":"The-first-build-is-slow","text":"The first build is slow","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Swidux depends on ","type":"text"},{"code":"swift-syntax","type":"codeVoice"},{"text":", which the macro system compiles from source","type":"text"},{"text":" ","type":"text"},{"text":"on first build (a few minutes on CI-class hardware). It’s cached afterwards;","type":"text"},{"text":" ","type":"text"},{"text":"nothing is wrong. CI pipelines benefit from caching ","type":"text"},{"code":".build\/","type":"codeVoice"},{"text":" or DerivedData.","type":"text"}]},{"text":"Console shows “Re-entrant Store.send(…) — deferring”","type":"heading","level":2,"anchor":"Console-shows-Re-entrant-Storesend-deferring"},{"inlineContent":[{"text":"Something called ","type":"text"},{"code":"store.send","type":"codeVoice"},{"text":" synchronously from inside a reducer or plugin","type":"text"},{"text":" ","type":"text"},{"text":"hook — usually a plugin observing state and dispatching in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":", or a","type":"text"},{"text":" ","type":"text"},{"code":"Binding","type":"codeVoice"},{"text":" setter fired during view updates. The store defers the inner action","type":"text"},{"text":" ","type":"text"},{"text":"and runs it as a full cycle right after the current one, so state stays","type":"text"},{"text":" ","type":"text"},{"text":"consistent — but the fault log is telling you the design wants that follow-up","type":"text"},{"text":" ","type":"text"},{"text":"dispatched from an ","type":"text"},{"type":"codeVoice","code":"Effect"},{"text":" instead.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"`call to main actor-isolated initializer … in a synchronous nonisolated context`","level":2,"anchor":"call-to-main-actor-isolated-initializer--in-a-synchronous-nonisolated-context"},{"type":"paragraph","inlineContent":[{"text":"The module is compiling in Swift 5 language mode with","type":"text"},{"text":" ","type":"text"},{"code":"SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor","type":"codeVoice"},{"text":". A ","type":"text"},{"code":"@Swidux nonisolated struct","type":"codeVoice"},{"text":" ","type":"text"},{"text":"only gets a nonisolated synthesized memberwise initializer under ","type":"text"},{"inlineContent":[{"text":"Swift 6","type":"text"},{"text":" ","type":"text"},{"text":"mode","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"code":"SWIFT_VERSION = 6.0","type":"codeVoice"},{"text":"); under Swift 5 mode the macro’s state","type":"text"},{"text":" ","type":"text"},{"text":"reconstruction can’t call it, and adding an explicit ","type":"text"},{"code":"nonisolated init","type":"codeVoice"},{"text":" does","type":"text"},{"text":" ","type":"text"},{"text":"not rescue it. Switch the target to Swift 6 mode.","type":"text"}]},{"type":"heading","text":"Error: “stored properties need an explicit type annotation”","level":2,"anchor":"Error-stored-properties-need-an-explicit-type-annotation"},{"type":"paragraph","inlineContent":[{"code":"var flag = false","type":"codeVoice"},{"text":" gives the compiler an inferred type, but macros can’t see","type":"text"},{"text":" ","type":"text"},{"text":"it — before this diagnostic existed, such a property was silently skipped and","type":"text"},{"text":" ","type":"text"},{"text":"its value reset on every dispatch. Write ","type":"text"},{"code":"var flag: Bool = false","type":"codeVoice"},{"type":"text","text":". The same"},{"type":"text","text":" "},{"type":"text","text":"applies to combined declarations: split "},{"type":"codeVoice","code":"var a, b: Int"},{"type":"text","text":" into separate"},{"type":"text","text":" "},{"type":"text","text":"declarations."}]},{"type":"heading","level":2,"text":"Keychain writes fail with OSStatus −34018 (`errSecMissingEntitlement`)","anchor":"Keychain-writes-fail-with-OSStatus-%E2%88%9234018-errSecMissingEntitlement"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An unsigned local or CI build is using "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true,"type":"reference"},{"type":"text","text":" without a"},{"type":"text","text":" "},{"type":"text","text":"provisioning profile. This is a signing condition, not a prompt or a bug — the"},{"type":"text","text":" "},{"type":"text","text":"data-protection keychain never prompts."}]},{"type":"paragraph","inlineContent":[{"text":"Nothing is persisted, but nothing crashes either: the write logs, returns","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", and the app continues. Ship provisioning-profile-signed builds with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"accessGroup: nil"},{"text":" to get real persistence.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Adding a team-prefixed "},{"code":"keychain-access-groups","type":"codeVoice"},{"type":"text","text":" entitlement also works, and is"},{"type":"text","text":" "},{"type":"text","text":"the right call when you want the access group — but weigh it first, because it"},{"type":"text","text":" "},{"type":"text","text":"makes the app require a provisioning profile for every signed build. It is"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" a fix for a test host: "},{"type":"codeVoice","code":"CODE_SIGNING_ALLOWED=NO"},{"text":" embeds no entitlements","type":"text"},{"text":" ","type":"text"},{"text":"at all, so there is nothing for the entitlement to attach to. Let the write","type":"text"},{"text":" ","type":"text"},{"text":"degrade there. Details in ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"},{"text":".","type":"text"}]},{"anchor":"Test-crashed-with-signal-trap-before-establishing-connection","type":"heading","level":2,"text":"`Test crashed with signal trap before establishing connection`"},{"type":"paragraph","inlineContent":[{"code":"xcodebuild test","type":"codeVoice"},{"text":" dies before any test runs, naming nothing useful. If the app","type":"text"},{"text":" ","type":"text"},{"text":"mints a device identity or writes a token at launch, suspect the Keychain: the","type":"text"},{"text":" ","type":"text"},{"text":"test host is unsigned, the write fails, and a trap takes the process down before","type":"text"},{"text":" ","type":"text"},{"text":"the test bundle can attach.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Current versions degrade instead of trapping here, so upgrading Swidux is the"},{"type":"text","text":" "},{"type":"text","text":"fix. To confirm the diagnosis on an older one, run the same scheme with"},{"type":"text","text":" "},{"type":"codeVoice","code":"CODE_SIGNING_ALLOWED=YES"},{"type":"text","text":" — if it gets past launch, the Keychain was the cause."}]},{"anchor":"Edits-disappear-after-a-sync-tick-or-an-async-load","type":"heading","level":2,"text":"Edits disappear after a sync tick or an async load"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Symptom: a keystroke, a toggle, or a whole entity vanishes — intermittently,"},{"type":"text","text":" "},{"type":"text","text":"usually while something is loading or syncing, and never reproducibly."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cause is almost always a hand-rolled bridge from "},{"code":"async","type":"codeVoice"},{"type":"text","text":" work into the"},{"type":"text","text":" "},{"type":"text","text":"store. "},{"type":"codeVoice","code":"Store"},{"type":"text","text":" keeps state in an "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" observer tree and converts to a"},{"type":"text","text":" "},{"type":"text","text":"value-type snapshot on the way in and out (“pack” and “unpack”). If you pack a"},{"type":"text","text":" "},{"type":"text","text":"snapshot, "},{"type":"codeVoice","code":"await"},{"type":"text","text":" something, and then unpack it, everything dispatched during"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"await"},{"type":"text","text":" is silently overwritten:"}]},{"type":"codeListing","code":["var snapshot = AppState(observer: store.observer)   \/\/ ← packed BEFORE the await","await loadEverything(into: &snapshot)               \/\/ ← dispatches land here…","AppState.apply(snapshot, to: store.observer)        \/\/ ← …and are discarded here"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"inout State","type":"codeVoice"},{"type":"text","text":" across a suspension point is the tell. The window is only as wide"},{"type":"text","text":" "},{"type":"text","text":"as the "},{"code":"await","type":"codeVoice"},{"type":"text","text":", which is why it presents as a rare glitch rather than a"},{"type":"text","text":" "},{"type":"text","text":"reproducible bug."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)"},{"type":"text","text":" instead. It runs the async work with no"},{"type":"text","text":" "},{"type":"text","text":"access to state, then packs a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"fresh"}]},{"type":"text","text":" snapshot, merges, and unpacks in a single"},{"type":"text","text":" "},{"type":"text","text":"step with no suspension point in between — so no dispatch can interleave:"}]},{"type":"codeListing","code":["await store.mutate {","    try await api.fetchItems()          \/\/ no state in scope; nothing to stale","} merging: { items, state in","    state.items.merge(from: EntityStore(items)) { _, _ in false }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The persistence stack’s own async entry points already work this way — use"},{"type":"text","text":" "},{"type":"codeVoice","code":"persistence.rehydrate(into: store)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"sync.setSyncEnabled(_:into: store)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"not a snapshot you manage yourself. ("},{"type":"codeVoice","code":"hydrate(into: &state)"},{"type":"text","text":" is the exception,"},{"type":"text","text":" "},{"type":"text","text":"and safe: it runs at launch, before the store exists.)"}]},{"type":"heading","anchor":"Contributors-the-lint-plugin-doesnt-run--dev-tooling-is-missing","level":2,"text":"Contributors: the lint plugin doesn’t run \/ dev tooling is missing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dev tooling (the Persnoop linter, the DocC plugin) is gated behind a"},{"type":"text","text":" "},{"type":"text","text":"gitignored "},{"code":".dev-tooling","type":"codeVoice"},{"type":"text","text":" sentinel file so it never leaks into consumers’"},{"type":"text","text":" "},{"type":"text","text":"dependency graphs. Create it at the package root — and if the package was"},{"type":"text","text":" "},{"type":"text","text":"already built without it, run "},{"code":"swift package purge-cache","type":"codeVoice"},{"type":"text","text":" so SwiftPM re-reads"},{"type":"text","text":" "},{"type":"text","text":"the manifest. See the repository’s "},{"code":"CONTRIBUTING.md","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","anchor":"A-Persisted-app-crashes-only-in-Release","level":2,"text":"A `@Persisted` app crashes only in Release"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the crash is in fetching, make sure you’re on ≥ 1.3.0: generic"},{"type":"text","text":" "},{"type":"codeVoice","code":"#Predicate"},{"type":"text","text":" over a protocol-required keypath traps under "},{"type":"codeVoice","code":"-O"},{"type":"text","text":", which is why"},{"type":"text","text":" "},{"type":"text","text":"the macro generates a per-model "},{"type":"codeVoice","code":"swiduxBatchFetchDescriptor"},{"type":"text","text":". Run"},{"type":"text","text":" "},{"type":"codeVoice","code":"swift test -c release"},{"type":"text","text":" in CI to catch this class of issue — Debug builds and"},{"type":"text","text":" "},{"type":"text","text":"default "},{"type":"codeVoice","code":"swift test"},{"type":"text","text":" pass."}]}],"kind":"content"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/troubleshooting"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"},"references":{"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"type":"topic","url":"\/documentation\/swidux\/entitystoreguide","kind":"article","role":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"title":"EntityStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},"doc://Swidux/documentation/Swidux/UndoRedo":{"type":"topic","url":"\/documentation\/swidux\/undoredo","kind":"article","role":"article","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":".","type":"text"}],"title":"Undo \/ Redo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"role":"article","type":"topic","kind":"article","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","url":"\/documentation\/swidux\/persistencemiddlewareguide","title":"Persistence Middleware"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"type":"topic","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"role":"collectionGroup","title":"KeyValueStore","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","url":"\/documentation\/swidux\/keyvaluestoreguide"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"role":"article","type":"topic","kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","url":"\/documentation\/swidux\/pluginpaywallreference","title":"SwiduxPaywall Reference"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","url":"\/documentation\/swidux\/pluginkillswitchreference","kind":"article","role":"article","type":"topic","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"title":"SwiduxKillswitch Reference"},"doc://Swidux/documentation/Swidux/MacrosReference":{"role":"article","type":"topic","kind":"article","abstract":[{"text":"Reference for ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" and its property markers (the SwiftData persistence bridge, shipped in ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":").","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","url":"\/documentation\/swidux\/macrosreference","title":"Macros"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"role":"article","type":"topic","kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","url":"\/documentation\/swidux\/pluginfeatureflagsreference","title":"SwiduxFeatureFlags Reference"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"type":"topic","abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"role":"symbol","kind":"symbol","title":"UndoPlugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","url":"\/documentation\/swidux\/undoplugin","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}]},"doc://Swidux/documentation/Swidux/Store/mutate(awaiting:merging:)":{"title":"mutate(awaiting:merging:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mutate","kind":"identifier"},{"kind":"text","text":"<"},{"text":"Value","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"awaiting","kind":"externalParam"},{"text":": () ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":", "},{"kind":"externalParam","text":"merging"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":", "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"rethrows"}],"url":"\/documentation\/swidux\/store\/mutate(awaiting:merging:)","kind":"symbol","role":"symbol","type":"topic","abstract":[{"type":"text","text":"Runs async work that must not hold state across its suspensions, then"},{"type":"text","text":" "},{"type":"text","text":"folds the result into a "},{"type":"strong","inlineContent":[{"type":"text","text":"freshly packed"}]},{"type":"text","text":" snapshot in one"},{"type":"text","text":" "},{"type":"text","text":"suspension-free step."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)"},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","url":"\/documentation\/swidux\/gettingstarted","kind":"article","role":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"title":"Getting Started with Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"url":"\/documentation\/swidux\/pluginparentalgatereference","kind":"article","role":"article","type":"topic","title":"SwiduxParentalGate Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},"doc://Swidux/documentation/Swidux/KeychainKeyValueStore":{"navigatorTitle":[{"kind":"identifier","text":"KeychainKeyValueStore"}],"identifier":"doc:\/\/Swidux\/documentation\/