{"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true,"anchor":"Reference"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Xcode asks to “Trust & Enable” a macro","anchor":"Xcode-asks-to-Trust--Enable-a-macro","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" are compiler plugins, so the first build in Xcode","type":"text"},{"text":" ","type":"text"},{"text":"prompts once per machine to trust the ","type":"text"},{"type":"codeVoice","code":"SwiduxMacros"},{"text":" target. Approve it in the","type":"text"},{"text":" ","type":"text"},{"text":"build error’s fix-it or under ","type":"text"},{"type":"strong","inlineContent":[{"text":"Settings → Packages","type":"text"}]},{"text":". On CI, pass","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"-skipMacroValidation"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"xcodebuild"},{"text":" instead — there’s no one to click the","type":"text"},{"text":" ","type":"text"},{"text":"dialog.","type":"text"}],"type":"paragraph"},{"level":2,"text":"The first build is slow","anchor":"The-first-build-is-slow","type":"heading"},{"inlineContent":[{"text":"Swidux depends on ","type":"text"},{"type":"codeVoice","code":"swift-syntax"},{"text":", which the macro system compiles from source","type":"text"},{"text":" ","type":"text"},{"text":"on first build (a few minutes on CI-class hardware). It’s cached afterwards;","type":"text"},{"text":" ","type":"text"},{"text":"nothing is wrong. CI pipelines benefit from caching ","type":"text"},{"type":"codeVoice","code":".build\/"},{"text":" or DerivedData.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Console shows “Re-entrant Store.send(…) — deferring”","anchor":"Console-shows-Re-entrant-Storesend-deferring","type":"heading"},{"inlineContent":[{"text":"Something called ","type":"text"},{"type":"codeVoice","code":"store.send"},{"text":" synchronously from inside a reducer or plugin","type":"text"},{"text":" ","type":"text"},{"text":"hook — usually a plugin observing state and dispatching in ","type":"text"},{"type":"codeVoice","code":"afterReduce"},{"text":", or a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Binding"},{"text":" setter fired during view updates. The store defers the inner action","type":"text"},{"text":" ","type":"text"},{"text":"and runs it as a full cycle right after the current one, so state stays","type":"text"},{"text":" ","type":"text"},{"text":"consistent — but the fault log is telling you the design wants that follow-up","type":"text"},{"text":" ","type":"text"},{"text":"dispatched from an ","type":"text"},{"type":"codeVoice","code":"Effect"},{"text":" instead.","type":"text"}],"type":"paragraph"},{"level":2,"text":"`call to main actor-isolated initializer … in a synchronous nonisolated context`","anchor":"call-to-main-actor-isolated-initializer--in-a-synchronous-nonisolated-context","type":"heading"},{"inlineContent":[{"text":"The module is compiling in Swift 5 language mode with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor"},{"text":". A ","type":"text"},{"type":"codeVoice","code":"@Swidux nonisolated struct"},{"text":" ","type":"text"},{"text":"only gets a nonisolated synthesized memberwise initializer under ","type":"text"},{"type":"strong","inlineContent":[{"text":"Swift 6","type":"text"},{"text":" ","type":"text"},{"text":"mode","type":"text"}]},{"text":" (","type":"text"},{"type":"codeVoice","code":"SWIFT_VERSION = 6.0"},{"text":"); under Swift 5 mode the macro’s state","type":"text"},{"text":" ","type":"text"},{"text":"reconstruction can’t call it, and adding an explicit ","type":"text"},{"type":"codeVoice","code":"nonisolated init"},{"text":" does","type":"text"},{"text":" ","type":"text"},{"text":"not rescue it. Switch the target to Swift 6 mode.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Error: “stored properties need an explicit type annotation”","anchor":"Error-stored-properties-need-an-explicit-type-annotation","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"var flag = false"},{"text":" gives the compiler an inferred type, but macros can’t see","type":"text"},{"text":" ","type":"text"},{"text":"it — before this diagnostic existed, such a property was silently skipped and","type":"text"},{"text":" ","type":"text"},{"text":"its value reset on every dispatch. Write ","type":"text"},{"type":"codeVoice","code":"var flag: Bool = false"},{"text":". The same","type":"text"},{"text":" ","type":"text"},{"text":"applies to combined declarations: split ","type":"text"},{"type":"codeVoice","code":"var a, b: Int"},{"text":" into separate","type":"text"},{"text":" ","type":"text"},{"text":"declarations.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Keychain writes fail with OSStatus −34018 (`errSecMissingEntitlement`)","anchor":"Keychain-writes-fail-with-OSStatus-%E2%88%9234018-errSecMissingEntitlement","type":"heading"},{"inlineContent":[{"text":"An unsigned local or CI build is using ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference"},{"text":" without a","type":"text"},{"text":" ","type":"text"},{"text":"provisioning profile. This is a signing condition, not a prompt or a bug — the","type":"text"},{"text":" ","type":"text"},{"text":"data-protection keychain never prompts.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Nothing is persisted, but nothing crashes either: the write logs, returns","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", and the app continues. Ship provisioning-profile-signed builds with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"accessGroup: nil"},{"text":" to get real persistence.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Adding a team-prefixed ","type":"text"},{"type":"codeVoice","code":"keychain-access-groups"},{"text":" entitlement also works, and is","type":"text"},{"text":" ","type":"text"},{"text":"the right call when you want the access group — but weigh it first, because it","type":"text"},{"text":" ","type":"text"},{"text":"makes the app require a provisioning profile for every signed build. It is","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" a fix for a test host: ","type":"text"},{"type":"codeVoice","code":"CODE_SIGNING_ALLOWED=NO"},{"text":" embeds no entitlements","type":"text"},{"text":" ","type":"text"},{"text":"at all, so there is nothing for the entitlement to attach to. Let the write","type":"text"},{"text":" ","type":"text"},{"text":"degrade there. Details in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"`Test crashed with signal trap before establishing connection`","anchor":"Test-crashed-with-signal-trap-before-establishing-connection","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"xcodebuild test"},{"text":" dies before any test runs, naming nothing useful. If the app","type":"text"},{"text":" ","type":"text"},{"text":"mints a device identity or writes a token at launch, suspect the Keychain: the","type":"text"},{"text":" ","type":"text"},{"text":"test host is unsigned, the write fails, and a trap takes the process down before","type":"text"},{"text":" ","type":"text"},{"text":"the test bundle can attach.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Current versions degrade instead of trapping here, so upgrading Swidux is the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"fix. To confirm the diagnosis on an older one, run the same scheme with"},{"type":"text","text":" "},{"code":"CODE_SIGNING_ALLOWED=YES","type":"codeVoice"},{"type":"text","text":" — if it gets past launch, the Keychain was the cause."}],"type":"paragraph"},{"level":2,"text":"Edits disappear after a sync tick or an async load","anchor":"Edits-disappear-after-a-sync-tick-or-an-async-load","type":"heading"},{"inlineContent":[{"type":"text","text":"Symptom: a keystroke, a toggle, or a whole entity vanishes — intermittently,"},{"type":"text","text":" "},{"type":"text","text":"usually while something is loading or syncing, and never reproducibly."}],"type":"paragraph"},{"inlineContent":[{"text":"The cause is almost always a hand-rolled bridge from ","type":"text"},{"code":"async","type":"codeVoice"},{"text":" work into the","type":"text"},{"text":" ","type":"text"},{"text":"store. ","type":"text"},{"code":"Store","type":"codeVoice"},{"text":" keeps state in an ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" observer tree and converts to a","type":"text"},{"text":" ","type":"text"},{"text":"value-type snapshot on the way in and out (“pack” and “unpack”). If you pack a","type":"text"},{"text":" ","type":"text"},{"text":"snapshot, ","type":"text"},{"code":"await","type":"codeVoice"},{"text":" something, and then unpack it, everything dispatched during","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"await","type":"codeVoice"},{"text":" is silently overwritten:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["var snapshot = AppState(observer: store.observer)   \/\/ ← packed BEFORE the await","await loadEverything(into: &snapshot)               \/\/ ← dispatches land here…","AppState.apply(snapshot, to: store.observer)        \/\/ ← …and are discarded here"],"type":"codeListing"},{"inlineContent":[{"code":"inout State","type":"codeVoice"},{"text":" across a suspension point is the tell. The window is only as wide","type":"text"},{"text":" ","type":"text"},{"text":"as the ","type":"text"},{"code":"await","type":"codeVoice"},{"text":", which is why it presents as a rare glitch rather than a","type":"text"},{"text":" ","type":"text"},{"text":"reproducible bug.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","type":"reference"},{"text":" instead. It runs the async work with no","type":"text"},{"text":" ","type":"text"},{"text":"access to state, then packs a ","type":"text"},{"inlineContent":[{"type":"text","text":"fresh"}],"type":"emphasis"},{"text":" snapshot, merges, and unpacks in a single","type":"text"},{"text":" ","type":"text"},{"text":"step with no suspension point in between — so no dispatch can interleave:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["await store.mutate {","    try await api.fetchItems()          \/\/ no state in scope; nothing to stale","} merging: { items, state in","    state.items.merge(from: EntityStore(items)) { _, _ in false }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The persistence stack’s own async entry points already work this way — use","type":"text"},{"text":" ","type":"text"},{"code":"persistence.rehydrate(into: store)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"sync.setSyncEnabled(_:into: store)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"not a snapshot you manage yourself. (","type":"text"},{"code":"hydrate(into: &state)","type":"codeVoice"},{"text":" is the exception,","type":"text"},{"text":" ","type":"text"},{"text":"and safe: it runs at launch, before the store exists.)","type":"text"}],"type":"paragraph"},{"level":2,"text":"Contributors: the lint plugin doesn’t run \/ dev tooling is missing","anchor":"Contributors-the-lint-plugin-doesnt-run--dev-tooling-is-missing","type":"heading"},{"inlineContent":[{"text":"Dev tooling (the Persnoop linter, the DocC plugin) is gated behind a","type":"text"},{"text":" ","type":"text"},{"text":"gitignored ","type":"text"},{"code":".dev-tooling","type":"codeVoice"},{"text":" sentinel file so it never leaks into consumers’","type":"text"},{"text":" ","type":"text"},{"text":"dependency graphs. Create it at the package root — and if the package was","type":"text"},{"text":" ","type":"text"},{"text":"already built without it, run ","type":"text"},{"code":"swift package purge-cache","type":"codeVoice"},{"text":" so SwiftPM re-reads","type":"text"},{"text":" ","type":"text"},{"text":"the manifest. See the repository’s ","type":"text"},{"code":"CONTRIBUTING.md","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"A `@Persisted` app crashes only in Release","anchor":"A-Persisted-app-crashes-only-in-Release","type":"heading"},{"inlineContent":[{"text":"If the crash is in fetching, make sure you’re on ≥ 1.3.0: generic","type":"text"},{"text":" ","type":"text"},{"code":"#Predicate","type":"codeVoice"},{"text":" over a protocol-required keypath traps under ","type":"text"},{"code":"-O","type":"codeVoice"},{"text":", which is why","type":"text"},{"text":" ","type":"text"},{"text":"the macro generates a per-model ","type":"text"},{"code":"swiduxBatchFetchDescriptor","type":"codeVoice"},{"text":" — one for ","type":"text"},{"code":"id","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"one for ","type":"text"},{"code":"persistentModelID","type":"codeVoice"},{"text":" — and why every by-identifier read goes through","type":"text"},{"text":" ","type":"text"},{"text":"one instead of building a predicate inline. Run ","type":"text"},{"code":"swift test -c release","type":"codeVoice"},{"text":" in CI","type":"text"},{"text":" ","type":"text"},{"text":"to catch this class of issue — Debug builds and default ","type":"text"},{"code":"swift test","type":"codeVoice"},{"text":" pass.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/swidux\/troubleshooting"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"metadata":{"role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"Troubleshooting"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"},"kind":"article","references":{"doc://Swidux/documentation/Swidux/KeychainKeyValueStore":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"topic","title":"KeychainKeyValueStore","kind":"symbol","abstract":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"KeyValueStore"},{"text":" backed by the system Keychain.","type":"text"}],"url":"\/documentation\/swidux\/keychainkeyvaluestore","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyValueStore","kind":"identifier"}],"navigatorTitle":[{"text":"KeychainKeyValueStore","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/MacrosReference":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReferenc