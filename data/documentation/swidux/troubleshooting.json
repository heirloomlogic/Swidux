{"abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"variants":[{"paths":["\/documentation\/swidux\/troubleshooting"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article","title":"Troubleshooting"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"},"seeAlsoSections":[{"generated":true,"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"anchor":"Reference"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Xcode-asks-to-Trust--Enable-a-macro","text":"Xcode asks to “Trust & Enable” a macro"},{"type":"paragraph","inlineContent":[{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" are compiler plugins, so the first build in Xcode","type":"text"},{"text":" ","type":"text"},{"text":"prompts once per machine to trust the ","type":"text"},{"code":"SwiduxMacros","type":"codeVoice"},{"text":" target. Approve it in the","type":"text"},{"text":" ","type":"text"},{"text":"build error’s fix-it or under ","type":"text"},{"inlineContent":[{"type":"text","text":"Settings → Packages"}],"type":"strong"},{"text":". On CI, pass","type":"text"},{"text":" ","type":"text"},{"code":"-skipMacroValidation","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"xcodebuild","type":"codeVoice"},{"text":" instead — there’s no one to click the","type":"text"},{"text":" ","type":"text"},{"text":"dialog.","type":"text"}]},{"type":"heading","level":2,"anchor":"The-first-build-is-slow","text":"The first build is slow"},{"type":"paragraph","inlineContent":[{"text":"Swidux depends on ","type":"text"},{"code":"swift-syntax","type":"codeVoice"},{"text":", which the macro system compiles from source","type":"text"},{"text":" ","type":"text"},{"text":"on first build (a few minutes on CI-class hardware). It’s cached afterwards;","type":"text"},{"text":" ","type":"text"},{"text":"nothing is wrong. CI pipelines benefit from caching ","type":"text"},{"code":".build\/","type":"codeVoice"},{"text":" or DerivedData.","type":"text"}]},{"type":"heading","level":2,"anchor":"Console-shows-Re-entrant-Storesend-deferring","text":"Console shows “Re-entrant Store.send(…) — deferring”"},{"type":"paragraph","inlineContent":[{"text":"Something called ","type":"text"},{"code":"store.send","type":"codeVoice"},{"text":" synchronously from inside a reducer or plugin","type":"text"},{"text":" ","type":"text"},{"text":"hook — usually a plugin observing state and dispatching in ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":", or a","type":"text"},{"text":" ","type":"text"},{"code":"Binding","type":"codeVoice"},{"text":" setter fired during view updates. The store defers the inner action","type":"text"},{"text":" ","type":"text"},{"text":"and runs it as a full cycle right after the current one, so state stays","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"consistent — but the fault log is telling you the design wants that follow-up"},{"type":"text","text":" "},{"type":"text","text":"dispatched from an "},{"code":"Effect","type":"codeVoice"},{"type":"text","text":" instead."}]},{"type":"heading","level":2,"anchor":"call-to-main-actor-isolated-initializer--in-a-synchronous-nonisolated-context","text":"`call to main actor-isolated initializer … in a synchronous nonisolated context`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The module is compiling in Swift 5 language mode with"},{"type":"text","text":" "},{"code":"SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor","type":"codeVoice"},{"type":"text","text":". A "},{"code":"@Swidux nonisolated struct","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"only gets a nonisolated synthesized memberwise initializer under "},{"inlineContent":[{"type":"text","text":"Swift 6"},{"type":"text","text":" "},{"type":"text","text":"mode"}],"type":"strong"},{"type":"text","text":" ("},{"code":"SWIFT_VERSION = 6.0","type":"codeVoice"},{"type":"text","text":"); under Swift 5 mode the macro’s state"},{"type":"text","text":" "},{"type":"text","text":"reconstruction can’t call it, and adding an explicit "},{"code":"nonisolated init","type":"codeVoice"},{"type":"text","text":" does"},{"type":"text","text":" "},{"type":"text","text":"not rescue it. Switch the target to Swift 6 mode."}]},{"type":"heading","level":2,"anchor":"Error-stored-properties-need-an-explicit-type-annotation","text":"Error: “stored properties need an explicit type annotation”"},{"type":"paragraph","inlineContent":[{"code":"var flag = false","type":"codeVoice"},{"type":"text","text":" gives the compiler an inferred type, but macros can’t see"},{"type":"text","text":" "},{"type":"text","text":"it — before this diagnostic existed, such a property was silently skipped and"},{"type":"text","text":" "},{"type":"text","text":"its value reset on every dispatch. Write "},{"code":"var flag: Bool = false","type":"codeVoice"},{"type":"text","text":". The same"},{"type":"text","text":" "},{"type":"text","text":"applies to combined declarations: split "},{"code":"var a, b: Int","type":"codeVoice"},{"type":"text","text":" into separate"},{"type":"text","text":" "},{"type":"text","text":"declarations."}]},{"type":"heading","level":2,"anchor":"Keychain-writes-fail-with-OSStatus-%E2%88%9234018-errSecMissingEntitlement","text":"Keychain writes fail with OSStatus −34018 (`errSecMissingEntitlement`)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An unsigned local or CI build is using "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"reference","isActive":true},{"type":"text","text":" without a"},{"type":"text","text":" "},{"type":"text","text":"provisioning profile. This is a signing condition, not a prompt or a bug — the"},{"type":"text","text":" "},{"type":"text","text":"data-protection keychain never prompts."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nothing is persisted, but nothing crashes either: the write logs, returns"},{"type":"text","text":" "},{"code":"false","type":"codeVoice"},{"type":"text","text":", and the app continues. Ship provisioning-profile-signed builds with"},{"type":"text","text":" "},{"code":"accessGroup: nil","type":"codeVoice"},{"type":"text","text":" to get real persistence."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Adding a team-prefixed "},{"code":"keychain-access-groups","type":"codeVoice"},{"type":"text","text":" entitlement also works, and is"},{"type":"text","text":" "},{"type":"text","text":"the right call when you want the access group — but weigh it first, because it"},{"type":"text","text":" "},{"type":"text","text":"makes the app require a provisioning profile for every signed build. It is"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" a fix for a test host: "},{"code":"CODE_SIGNING_ALLOWED=NO","type":"codeVoice"},{"type":"text","text":" embeds no entitlements"},{"type":"text","text":" "},{"type":"text","text":"at all, so there is nothing for the entitlement to attach to. Let the write"},{"type":"text","text":" "},{"type":"text","text":"degrade there. Details in "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Test-crashed-with-signal-trap-before-establishing-connection","text":"`Test crashed with signal trap before establishing connection`"},{"type":"paragraph","inlineContent":[{"code":"xcodebuild test","type":"codeVoice"},{"type":"text","text":" dies before any test runs, naming nothing useful. If the app"},{"type":"text","text":" "},{"type":"text","text":"mints a device identity or writes a token at launch, suspect the Keychain: the"},{"type":"text","text":" "},{"type":"text","text":"test host is unsigned, the write fails, and a trap takes the process down before"},{"type":"text","text":" "},{"type":"text","text":"the test bundle can attach."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Current versions degrade instead of trapping here, so upgrading Swidux is the"},{"type":"text","text":" "},{"type":"text","text":"fix. To confirm the diagnosis on an older one, run the same scheme with"},{"type":"text","text":" "},{"code":"CODE_SIGNING_ALLOWED=YES","type":"codeVoice"},{"type":"text","text":" — if it gets past launch, the Keychain was the cause."}]},{"type":"heading","level":2,"anchor":"Edits-disappear-after-a-sync-tick-or-an-async-load","text":"Edits disappear after a sync tick or an async load"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Symptom: a keystroke, a toggle, or a whole entity vanishes — intermittently,"},{"type":"text","text":" "},{"type":"text","text":"usually while something is loading or syncing, and never reproducibly."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cause is almost always a hand-rolled bridge from "},{"code":"async","type":"codeVoice"},{"type":"text","text":" work into the"},{"type":"text","text":" "},{"type":"text","text":"store. "},{"code":"Store","type":"codeVoice"},{"type":"text","text":" keeps state in an "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" observer tree and converts to a"},{"type":"text","text":" "},{"type":"text","text":"value-type snapshot on the way in and out (“pack” and “unpack”). If you pack a"},{"type":"text","text":" "},{"type":"text","text":"snapshot, "},{"code":"await","type":"codeVoice"},{"type":"text","text":" something, and then unpack it, everything dispatched during"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"await","type":"codeVoice"},{"type":"text","text":" is silently overwritten:"}]},{"type":"codeListing","code":["var snapshot = AppState(observer: store.observer)   \/\/ ← packed BEFORE the await","await loadEverything(into: &snapshot)               \/\/ ← dispatches land here…","AppState.apply(snapshot, to: store.observer)        \/\/ ← …and are discarded here"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"inout State"},{"type":"text","text":" across a suspension point is the tell. The window is only as wide"},{"type":"text","text":" "},{"type":"text","text":"as the "},{"type":"codeVoice","code":"await"},{"type":"text","text":", which is why it presents as a rare glitch rather than a"},{"type":"text","text":" "},{"type":"text","text":"reproducible bug."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","isActive":true},{"type":"text","text":" instead. It runs the async work with no"},{"type":"text","text":" "},{"type":"text","text":"access to state, then packs a "},{"inlineContent":[{"type":"text","text":"fresh"}],"type":"emphasis"},{"type":"text","text":" snapshot, merges, and unpacks in a single"},{"type":"text","text":" "},{"type":"text","text":"step with no suspension point in between — so no dispatch can interleave:"}]},{"type":"codeListing","code":["await store.mutate {","    try await api.fetchItems()          \/\/ no state in scope; nothing to stale","} merging: { items, state in","    state.items.merge(from: EntityStore(items)) { _, _ in false }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The persistence stack’s own async entry points already work this way — use"},{"type":"text","text":" "},{"type":"codeVoice","code":"persistence.rehydrate(into: store)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"sync.setSyncEnabled(_:into: store)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"not a snapshot you manage yourself. ("},{"type":"codeVoice","code":"hydrate(into: &state)"},{"type":"text","text":" is the exception,"},{"type":"text","text":" "},{"type":"text","text":"and safe: it runs at launch, before the store exists.)"}]},{"type":"heading","anchor":"Contributors-the-lint-plugin-doesnt-run--dev-tooling-is-missing","text":"Contributors: the lint plugin doesn’t run \/ dev tooling is missing","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dev tooling (the Persnoop linter, the DocC plugin) is gated behind a"},{"type":"text","text":" "},{"type":"text","text":"gitignored "},{"code":".dev-tooling","type":"codeVoice"},{"type":"text","text":" sentinel file so it never leaks into consumers’"},{"type":"text","text":" "},{"type":"text","text":"dependency graphs. Create it at the package root — and if the package was"},{"type":"text","text":" "},{"type":"text","text":"already built without it, run "},{"code":"swift package purge-cache","type":"codeVoice"},{"type":"text","text":" so SwiftPM re-reads"},{"type":"text","text":" "},{"type":"text","text":"the manifest. See the repository’s "},{"code":"CONTRIBUTING.md","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","anchor":"A-Persisted-app-crashes-only-in-Release","text":"A `@Persisted` app crashes only in Release","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the crash is in fetching, make sure you’re on ≥ 1.3.0: generic"},{"type":"text","text":" "},{"code":"#Predicate","type":"codeVoice"},{"type":"text","text":" over a protocol-required keypath traps under "},{"code":"-O","type":"codeVoice"},{"type":"text","text":", which is why"},{"type":"text","text":" "},{"type":"text","text":"the macro generates a per-model "},{"type":"codeVoice","code":"swiduxBatchFetchDescriptor"},{"type":"text","text":" — one for "},{"code":"id","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"one for "},{"code":"persistentModelID","type":"codeVoice"},{"type":"text","text":" — and why every by-identifier read goes through"},{"type":"text","text":" "},{"type":"text","text":"one instead of building a predicate inline. Run "},{"code":"swift test -c release","type":"codeVoice"},{"type":"text","text":" in CI"},{"type":"text","text":" "},{"type":"text","text":"to catch this class of issue — Debug builds and default "},{"code":"swift test","type":"codeVoice"},{"type":"text","text":" pass."}]}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","kind":"article","role":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"url":"\/documentation\/swidux\/pluginpaywallreference","title":"SwiduxPaywall Reference","type":"topic"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","role":"article","url":"\/documentation\/swidux\/pluginfeatureflagsreference","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"title":"SwiduxFeatureFlags Reference","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"kind":"article","url":"\/documentation\/swidux\/keyvaluestoreguide","title":"KeyValueStore","role":"collectionGroup","type":"topic","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"url":"\/documentation\/swidux\/entitystoreguide","title":"EntityStore","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","kind":"article","role":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"url":"\/documentation\/swidux\/pluginanalyticsreference","title":"SwiduxAnalytics Reference","type":"topic"},"doc://Swidux/documentation/Swidux/Store/mutate(awaiting:merging:)":{"abstract":[{"type":"text","text":"Runs async work that must not hold state across its suspensions, then"},{"type":"text","text":" "},{"type":"text","text":"folds the result into a "},{"inlineContent":[{"text":"freshly packed","type":"text"}],"type":"strong"},{"text":" snapshot in one","type":"text"},{"text":" ","type":"text"},{"text":"suspension-free step.","type":"text"}],"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mutate"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">("},{"kind":"externalParam","text":"awaiting"},{"text":": () ","kind":"text"},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":", "},{"kind":"externalParam","text":"merging"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":", "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"text":"rethrows","kind":"keyword"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","url":"\/documentation\/swidux\/store\/mutate(awaiting:merging:)","title":"mutate(awaiting:merging:)"},"doc://Swidux/documentation/Swidux/UndoRedo":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","kind":"article","role":"article","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/swidux\/undoredo","title":"Undo \/ Redo","type":"topic"},"doc://Swidux/documentation/Swidux/GettingStarted":{"kind":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"role":"article","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"url":"\/documentation\/swidux\/persistencemiddlewareguide","title":"Persistence Middleware","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},"doc://Swidux/documentation/Swidux/MacrosReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","type":"topic","url":"\/documentation\/swidux\/macrosreference","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":")."}],"title":"Macros","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","kind":"article","role":"article","abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"url":"\/documentation\/swidux\/pluginparentalgatereference","title":"SwiduxParentalGate Reference","type":"topic"},"doc://Swidux/documentation/Swidux/KeychainKeyValueStore":{"fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeychainKeyValueStore"}],"type":"topic","kind":"symbol","navigatorTitle":[{"text":"KeychainKeyValueStore","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swidux\/keychainkeyvaluestore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","abstract":[{"type":"text","text":"A "},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":" backed by the system Keychain."}],"title":"KeychainKeyValueStore"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","kind":"article","role":"article","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"url":"\/documentation\/swidux\/pluginkillswitchreference","title":"SwiduxKillswitch Reference","type":"topic"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"type":"topic","url":"\/documentation\/swidux\/undoplugin","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"title":"UndoPlugin","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"url":"\/documentation\/swidux","title":"Swidux","type":"topic"}}}