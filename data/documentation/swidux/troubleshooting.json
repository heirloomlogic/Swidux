ticle","url":"\/documentation\/swidux\/pluginparentalgatereference","type":"topic"},"doc://Swidux/documentation/Swidux/UndoRedo":{"type":"topic","role":"article","title":"Undo \/ Redo","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":".","type":"text"}],"kind":"article","url":"\/documentation\/swidux\/undoredo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},"doc://Swidux/documentation/Swidux":{"title":"Swidux","kind":"symbol","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"role":"collection","url":"\/documentation\/swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","type":"topic"},"doc://Swidux/documentation/Swidux/Store/mutate(awaiting:merging:)":{"title":"mutate(awaiting:merging:)","kind":"symbol","abstract":[{"type":"text","text":"Runs async work that must not hold state across its suspensions, then"},{"type":"text","text":" "},{"type":"text","text":"folds the result into a "},{"type":"strong","inlineContent":[{"type":"text","text":"freshly packed"}]},{"type":"text","text":" snapshot in one"},{"type":"text","text":" "},{"type":"text","text":"suspension-free step."}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mutate"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">("},{"kind":"externalParam","text":"awaiting"},{"kind":"text","text":": () "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":", "},{"kind":"externalParam","text":"merging"},{"kind":"text","text":": ("},{"kind":"typeIdent