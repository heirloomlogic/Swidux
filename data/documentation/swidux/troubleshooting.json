{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"title":"Troubleshooting","modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article"},"variants":[{"paths":["\/documentation\/swidux\/troubleshooting"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"kind":"article","primaryContentSections":[{"content":[{"level":2,"anchor":"Xcode-asks-to-Trust--Enable-a-macro","type":"heading","text":"Xcode asks to “Trust & Enable” a macro"},{"inlineContent":[{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" are compiler plugins, so the first build in Xcode"},{"type":"text","text":" "},{"type":"text","text":"prompts once per machine to trust the "},{"type":"codeVoice","code":"SwiduxMacros"},{"type":"text","text":" target. Approve it in the"},{"type":"text","text":" "},{"type":"text","text":"build error’s fix-it or under "},{"type":"strong","inlineContent":[{"type":"text","text":"Settings → Packages"}]},{"type":"text","text":". On CI, pass"},{"type":"text","text":" "},{"type":"codeVoice","code":"-skipMacroValidation"},{"type":"text","text":" to "},{"type":"codeVoice","code":"xcodebuild"},{"type":"text","text":" instead — there’s no one to click the"},{"type":"text","text":" "},{"type":"text","text":"dialog."}],"type":"paragraph"},{"level":2,"anchor":"The-first-build-is-slow","type":"heading","text":"The first build is slow"},{"inlineContent":[{"type":"text","text":"Swidux depends on "},{"type":"codeVoice","code":"swift-syntax"},{"type":"text","text":", which the macro system compiles from source"},{"type":"text","text":" "},{"type":"text","text":"on first build (a few minutes on CI-class hardware). It’s cached afterwards;"},{"type":"text","text":" "},{"type":"text","text":"nothing is wrong. CI pipelines benefit from caching "},{"type":"codeVoice","code":".build\/"},{"type":"text","text":" or DerivedData."}],"type":"paragraph"},{"level":2,"anchor":"Console-shows-Re-entrant-Storesend-deferring","type":"heading","text":"Console shows “Re-entrant Store.send(…) — deferring”"},{"inlineContent":[{"type":"text","text":"Something called "},{"type":"codeVoice","code":"store.send"},{"type":"text","text":" synchronously from inside a reducer or plugin"},{"type":"text","text":" "},{"type":"text","text":"hook — usually a plugin observing state and dispatching in "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":", or a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Binding"},{"type":"text","text":" setter fired during view updates. The store defers the inner action"},{"type":"text","text":" "},{"type":"text","text":"and runs it as a full cycle right after the current one, so state stays"},{"type":"text","text":" "},{"type":"text","text":"consistent — but the fault log is telling you the design wants that follow-up"},{"type":"text","text":" "},{"type":"text","text":"dispatched from an "},{"type":"codeVoice","code":"Effect"},{"type":"text","text":" instead."}],"type":"paragraph"},{"level":2,"anchor":"call-to-main-actor-isolated-initializer--in-a-synchronous-nonisolated-context","type":"heading","text":"`call to main actor-isolated initializer … in a synchronous nonisolated context`"},{"inlineContent":[{"type":"text","text":"The module is compiling in Swift 5 language mode with"},{"type":"text","text":" "},{"type":"codeVoice","code":"SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor"},{"type":"text","text":". A "},{"type":"codeVoice","code":"@Swidux nonisolated struct"},{"type":"text","text":" "},{"type":"text","text":"only gets a nonisolated synthesized memberwise initializer under "},{"type":"strong","inlineContent":[{"type":"text","text":"Swift 6"},{"type":"text","text":" "},{"type":"text","text":"mode"}]},{"type":"text","text":" ("},{"code":"SWIFT_VERSION = 6.0","type":"codeVoice"},{"type":"text","text":"); under Swift 5 mode the macro’s state"},{"type":"text","text":" "},{"type":"text","text":"reconstruction can’t call it, and adding an explicit "},{"type":"codeVoice","code":"nonisolated init"},{"type":"text","text":" does"},{"type":"text","text":" "},{"type":"text","text":"not rescue it. Switch the target to Swift 6 mode."}],"type":"paragraph"},{"level":2,"anchor":"Error-stored-properties-need-an-explicit-type-annotation","type":"heading","text":"Error: “stored properties need an explicit type annotation”"},{"inlineContent":[{"type":"codeVoice","code":"var flag = false"},{"type":"text","text":" gives the compiler an inferred type, but macros can’t see"},{"type":"text","text":" "},{"type":"text","text":"it — before this diagnostic existed, such a property was silently skipped and"},{"type":"text","text":" "},{"type":"text","text":"its value reset on every dispatch. Write "},{"type":"codeVoice","code":"var flag: Bool = false"},{"type":"text","text":". The same"},{"type":"text","text":" "},{"type":"text","text":"applies to combined declarations: split "},{"type":"codeVoice","code":"var a, b: Int"},{"type":"text","text":" into separate"},{"type":"text","text":" "},{"type":"text","text":"declarations."}],"type":"paragraph"},{"level":2,"anchor":"Keychain-writes-fail-with-OSStatus-%E2%88%9234018-errSecMissingEntitlement","type":"heading","text":"Keychain writes fail with OSStatus −34018 (`errSecMissingEntitlement`)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An unsigned local or CI build is using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"},{"type":"text","text":" without a"},{"type":"text","text":" "},{"type":"text","text":"provisioning profile. This is a signing condition, not a prompt or a bug — the"},{"type":"text","text":" "},{"type":"text","text":"data-protection keychain never prompts."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nothing is persisted, but nothing crashes either: the write logs, returns"},{"type":"text","text":" "},{"type":"codeVoice","code":"false"},{"type":"text","text":", and the app continues. Ship provisioning-profile-signed builds with"},{"type":"text","text":" "},{"type":"codeVoice","code":"accessGroup: nil"},{"type":"text","text":" to get real persistence."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Adding a team-prefixed "},{"code":"keychain-access-groups","type":"codeVoice"},{"type":"text","text":" entitlement also works, and is"},{"type":"text","text":" "},{"type":"text","text":"the right call when you want the access group — but weigh it first, because it"},{"type":"text","text":" "},{"type":"text","text":"makes the app require a provisioning profile for every signed build. It is"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" a fix for a test host: "},{"code":"CODE_SIGNING_ALLOWED=NO","type":"codeVoice"},{"type":"text","text":" embeds no entitlements"},{"type":"text","text":" "},{"type":"text","text":"at all, so there is nothing for the entitlement to attach to. Let the write"},{"type":"text","text":" "},{"type":"text","text":"degrade there. Details in "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"`Test crashed with signal trap before establishing connection`","anchor":"Test-crashed-with-signal-trap-before-establishing-connection"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"xcodebuild test"},{"type":"text","text":" dies before any test runs, naming nothing useful. If the app"},{"type":"text","text":" "},{"type":"text","text":"mints a device identity or writes a token at launch, suspect the Keychain: the"},{"type":"text","text":" "},{"type":"text","text":"test host is unsigned, the write fails, and a trap takes the process down before"},{"type":"text","text":" "},{"type":"text","text":"the test bundle can attach."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Current versions degrade instead of trapping here, so upgrading Swidux is the"},{"type":"text","text":" "},{"type":"text","text":"fix. To confirm the diagnosis on an older one, run the same scheme with"},{"type":"text","text":" "},{"code":"CODE_SIGNING_ALLOWED=YES","type":"codeVoice"},{"type":"text","text":" — if it gets past launch, the Keychain was the cause."}]},{"type":"heading","level":2,"text":"Edits disappear after a sync tick or an async load","anchor":"Edits-disappear-after-a-sync-tick-or-an-async-load"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Symptom: a keystroke, a toggle, or a whole entity vanishes — intermittently,"},{"type":"text","text":" "},{"type":"text","text":"usually while something is loading or syncing, and never reproducibly."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cause is almost always a hand-rolled bridge from "},{"type":"codeVoice","code":"async"},{"type":"text","text":" work into the"},{"type":"text","text":" "},{"type":"text","text":"store. "},{"type":"codeVoice","code":"Store"},{"type":"text","text":" keeps state in an "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" observer tree and converts to a"},{"type":"text","text":" "},{"type":"text","text":"value-type snapshot on the way in and out (“pack” and “unpack”). If you pack a"},{"type":"text","text":" "},{"type":"text","text":"snapshot, "},{"type":"codeVoice","code":"await"},{"type":"text","text":" something, and then unpack it, everything dispatched during"},{"type":"text","text":" "},{"type":"text","text":"the "},{"type":"codeVoice","code":"await"},{"type":"text","text":" is silently overwritten:"}]},{"type":"codeListing","code":["var snapshot = AppState(observer: store.observer)   \/\/ ← packed BEFORE the await","await loadEverything(into: &snapshot)               \/\/ ← dispatches land here…","AppState.apply(snapshot, to: store.observer)        \/\/ ← …and are discarded here"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"inout State"},{"type":"text","text":" across a suspension point is the tell. The window is only as wide"},{"type":"text","text":" "},{"type":"text","text":"as the "},{"type":"codeVoice","code":"await"},{"type":"text","text":", which is why it presents as a rare glitch rather than a"},{"type":"text","text":" "},{"type":"text","text":"reproducible bug."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","type":"reference"},{"type":"text","text":" instead. It runs the async work with no"},{"type":"text","text":" "},{"type":"text","text":"access to state, then packs a "},{"inlineContent":[{"type":"text","text":"fresh"}],"type":"emphasis"},{"type":"text","text":" snapshot, merges, and unpacks in a single"},{"text":" ","type":"text"},{"type":"text","text":"step with no suspension point in between — so no dispatch can interleave:"}]},{"type":"codeListing","code":["await store.mutate {","    try await api.fetchItems()          \/\/ no state in scope; nothing to stale","} merging: { items, state in","    state.items.merge(from: EntityStore(items)) { _, _ in false }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The persistence stack’s own async entry points already work this way — use"},{"type":"text","text":" "},{"code":"persistence.rehydrate(into: store)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"sync.setSyncEnabled(_:into: store)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"not a snapshot you manage yourself. ("},{"type":"codeVoice","code":"hydrate(into: &state)"},{"type":"text","text":" is the exception,"},{"type":"text","text":" "},{"type":"text","text":"and safe: it runs at launch, before the store exists.)"}]},{"type":"heading","level":2,"text":"Contributors: the lint plugin doesn’t run \/ dev tooling is missing","anchor":"Contributors-the-lint-plugin-doesnt-run--dev-tooling-is-missing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Dev tooling (the Persnoop linter, the DocC plugin) is gated behind a"},{"type":"text","text":" "},{"type":"text","text":"gitignored "},{"code":".dev-tooling","type":"codeVoice"},{"type":"text","text":" sentinel file so it never leaks into consumers’"},{"type":"text","text":" "},{"type":"text","text":"dependency graphs. Create it at the package root — and if the package was"},{"type":"text","text":" "},{"type":"text","text":"already built without it, run "},{"code":"swift package purge-cache","type":"codeVoice"},{"type":"text","text":" so SwiftPM re-reads"},{"type":"text","text":" "},{"type":"text","text":"the manifest. See the repository’s "},{"type":"codeVoice","code":"CONTRIBUTING.md"},{"type":"text","text":"."}]},{"anchor":"A-Persisted-app-crashes-only-in-Release","type":"heading","level":2,"text":"A `@Persisted` app crashes only in Release"},{"inlineContent":[{"type":"text","text":"If the crash is in fetching, make sure you’re on ≥ 1.3.0: generic"},{"type":"text","text":" "},{"type":"codeVoice","code":"#Predicate"},{"type":"text","text":" over a protocol-required keypath traps under "},{"type":"codeVoice","code":"-O"},{"type":"text","text":", which is why"},{"text":" ","type":"text"},{"type":"text","text":"the macro generates a per-model "},{"type":"codeVoice","code":"swiduxBatchFetchDescriptor"},{"type":"text","text":". Run"},{"type":"text","text":" "},{"type":"codeVoice","code":"swift test -c release"},{"text":" in CI to catch this class of issue — Debug builds and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"default "},{"type":"codeVoice","code":"swift test"},{"type":"text","text":" pass."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/UndoRedo":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"topic","url":"\/documentation\/swidux\/undoredo","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"type":"text","text":"."}],"kind":"article","title":"Undo \/ Redo"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"topic","url":"\/documentation\/swidux\/persistencemiddlewareguide","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"kind":"article","title":"Persistence Middleware"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"topic","url":"\/documentation\/swidux\/entitystoreguide","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"kind":"article","title":"EntityStore"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"role":"collectionGroup","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","type":"topic","url":"\/documentation\/swidux\/keyvaluestoreguide","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"kind":"article","title":"KeyValueStore"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","type":"topic","url":"\/documentation\/swidux\/pluginparentalgatereference","abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"kind":"article","title":"SwiduxParentalGate Reference"},"doc://Swidux/documentation/Swidux/Store/mutate(awaiting:merging:)":{"title":"mutate(awaiting:merging:)","role":"symbol","type":"topic","abstract":[{"text":"Runs async work that must not hold state across its suspensions, then","type":"text"},{"text":" ","type":"text"},{"text":"folds the result into a ","type":"text"},{"inlineContent":[{"type":"text","text":"freshly packed"}],"type":"strong"},{"text":" snapshot in one","type":"text"},{"text":" ","type":"text"},{"text":"suspension-free step.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mutate"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">("},{"kind":"externalParam","text":"awaiting"},{"kind":"text","text":": () "},{"kind":"keyword","text":"async"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"kind":"text","text":" -> "},{"text":"Value","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"merging"},{"text":": (","kind":"text"},{"text":"Value","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"typeIdentifier","text":"State"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:s4Voida","text":"Void","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"rethrows"}],"url":"\/documentation\/swidux\/store\/mutate(awaiting:merging:)","kind":"symbol"},"doc://Swidux/documentation/Swidux/MacrosReference":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","type":"topic","url":"\/documentation\/swidux\/macrosreference","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":")."}],"kind":"article","title":"Macros"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","type":"topic","url":"\/documentation\/swidux\/pluginfeatureflagsreference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"kind":"article","title":"SwiduxFeatureFlags Reference"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","type":"topic","url":"\/documentation\/swidux\/pluginanalyticsreference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"kind":"article","title":"SwiduxAnalytics Reference"},"doc://Swidux/documentation/Swidux/KeychainKeyValueStore":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeychainKeyValueStore"}],"title":"KeychainKeyValueStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","type":"topic","navigatorTitle":[{"kind":"identifier","text":"KeychainKeyValueStore"}],"abstract":[{"type":"text","text":"A "},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":" backed by the system Keychain."}],"kind":"symbol","url":"\/documentation\/swidux\/keychainkeyvaluestore","role":"symbol"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic","url":"\/documentation\/swidux\/pluginpaywallreference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"kind":"article","title":"SwiduxPaywall Reference"},"doc://Swidux/documentation/Swidux":{"title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","type":"topic","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"kind":"symbol","url":"\/documentation\/swidux","role":"collection"},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","url":"\/documentation\/swidux\/gettingstarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"kind":"article","title":"Getting Started with Swidux"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","type":"topic","url":"\/documentation\/swidux\/pluginkillswitchreference","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"kind":"article","title":"SwiduxKillswitch Reference"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"type":"topic","url":"\/documentation\/swidux\/undoplugin","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"kind":"symbol","title":"UndoPlugin"}}}