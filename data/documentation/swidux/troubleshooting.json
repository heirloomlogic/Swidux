":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},"doc://Swidux/documentation/Swidux/KeychainKeyValueStore":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","kind":"symbol","title":"KeychainKeyValueStore","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyValueStore","kind":"identifier"}],"navigatorTitle":[{"text":"KeychainKeyValueStore","kind":"identifier"}],"abstract":[{"type":"text","text":"A "},{"type":"codeVoice","code":"KeyValueStore"},{"type":"text","text":" backed by the system Keychain."}],"type":"topic","url":"\/documentation\/swidux\/keychainkeyvaluestore"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","type":"topic","role":"article","title":"SwiduxKillswitch Reference","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"url":"\/documentation\/swidux\/pluginkillswitchreference","kind":"article"},"doc://Swidux/documentation/Swidux/EntityEditingGuide":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityEditingGuide","role":"article","abstract":[{"text":"Keep editor drafts separate from current application state, then apply their changes as one local group.","type":"text"}],"title":"Editing canonical entities","url":"\/documentation\/swidux\/entityeditingguide","kind":"article"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"url":"\/documentation\/swidux\/pluginfeatureflagsreference","type":"topic","role":"article","title":"SwiduxFeatureFlags Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","role":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"title":"SwiduxPaywall Reference","url":"\/documentation\/swidux\/pluginpaywallreference","kind":"article"}}}