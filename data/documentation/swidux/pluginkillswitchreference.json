one does, so it is scoped and checked rather than trusted. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","type":"reference","isActive":true},{"text":" §6a. ","type":"text"},{"code":"mock(result:cached:)","type":"codeVoice"},{"text":" keeps an in-memory cache and lets a test inject a closure that returns or throws.","type":"text"}]},{"inlineContent":[{"text":"The endpoint must be ","type":"text"},{"type":"strong","inlineContent":[{"text":"HTTPS","type":"text"}]},{"text":" (","type":"text"},{"type":"codeVoice","code":"http"},{"text":" is allowed only for ","type":"text"},{"type":"codeVoice","code":"localhost"},{"text":" development servers; anything else is a precondition failure) — the killswitch is a remote control channel and must not be tamperable in transit. Non-2xx responses and payloads over 1 MB are treated as fetch failures, which fall back to the cache (and ultimately fail open).","type":"text"}],"type":"paragraph"},{"anchor":"KillswitchConfig","level":3,"text":"KillswitchConfig","type":"heading"},{"inlineContent":[{"text":"The decoded shape of the remote JSON. All fields are optional — a config with every field ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" evaluates to ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["public struct KillswitchConfig: Codable, Sendable, Equatable {","    public var minimumSupportedVersion: String?","    public var blockedVersions: [String]?","    public var blockedRanges: [String]?","    public var blockedTitle: String?","    public var blockedMessage: String?","    public var updateURL: String?","","    public init(","        minimumSupportedVersion: String? = nil,","        blockedVersions: [String]? = nil,","        blockedRanges: [String]? = nil,","        blockedTitle: String? = nil,","        blockedMessage: String? = nil,","        updateURL: String? = nil","    )","}"],"syntax":"swift","type":"codeListing"},{"anchor":"KillswitchVerdict","level":3,"text":"KillswitchVerdict","type":"heading"},{"inlineContent":[{"text":"The result of evaluating a config against the running version.","type":"text"}],"type":"paragraph"},{"code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":".unknown","type":"codeVoice"},{"text":" is the initial state before any fetch has been attempted. ","type":"text"},{"code":"evaluate(_:against:)","type":"codeVoice"},{"text":" always returns ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":" — never ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":". ","type":"text"},{"code":"isBlocked","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" only for the ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" case.","type":"text"}],"type":"paragraph"},{"anchor":"SemanticVersion","level":3,"text":"SemanticVersion","type":"heading"},{"inlineContent":[{"type":"text","text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests."}],"type":"paragraph"},{"code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The string initializer accepts "},{"code":"\"1.2.3\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"1.2.3-beta.1\"","type":"codeVoice"},{"type":"text","text":", and "},{"code":"\"1.2.3-beta.1+build42\"","type":"codeVoice"},{"type":"text","text":". Build metadata after "},{"code":"+","type":"codeVoice"},{"type":"text","text":" is parsed and discarded. Malformed input returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric."}],"type":"paragraph"},{"anchor":"VersionRange","level":3,"text":"VersionRange","type":"heading"},{"inlineContent":[{"type":"text","text":"A half-open range "},{"code":"[lowerBound, upperBound)","type":"codeVoice"},{"type":"text","text":" of semantic versions, used to express "},{"code":"blockedRanges","type":"codeVoice"},{"type":"text","text":" entries."}],"type":"paragraph"},{"code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Both initializers fail and return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed."}],"type":"paragraph"},{"anchor":"Action-semantics","level":2,"text":"Action semantics","type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Effect on state"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned effect"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"if the cache is fresh ("},{"type":"codeVoice","code":"Date() - lastFetch < cacheLifetime"},{"type":"text","text":" AND "},{"type":"codeVoice","code":"loadCached()"},{"type":"text","text":" is non-nil), evaluates the cached config and dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" without hitting the network; otherwise behaves like "},{"type":"codeVoice","code":".forceFetch"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".forceFetch"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"calls "},{"type":"codeVoice","code":"service.fetch()"},{"type":"text","text":", persists the result via "},{"type":"codeVoice","code":"service.saveCached(_:)"},{"type":"text","text":", dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":". On thrown error, falls back to "},{"type":"codeVoice","code":"service.loadCached()"},{"type":"text","text":" if available — dispatching "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from the cache "},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed(message)"},{"type":"text","text":" so the UI can surface the error while keeping a usable verdict"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".verdictReceived(verdict, fromNetwork:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"sets "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":", clears "},{"code":"fetchError","type":"codeVoice"},{"type":"text","text":"; sets "},{"code":"lastFetch = Date()","type":"codeVoice"},{"type":"text","text":" "},{"inlineContent":[{"text":"only when ","type":"text"},{"code":"fromNetwork","type":"codeVoice"},{"text":" is true","type":"text"}],"type":"strong"},{"type":"text","text":" — a cache-served verdict must not slide the freshness window, or a session polling "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":" inside "},{"code":"cacheLifetime","type":"codeVoice"},{"type":"text","text":" would never consult the network again"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".fetchFailed(message)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"sets "},{"code":"fetchError = message","type":"codeVoice"},{"type":"text","text":" (does not clear "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":" or "},{"code":"lastFetch","type":"codeVoice"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".openUpdateURL","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"if "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":" is "},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" with a non-nil "},{"code":"updateURL","type":"codeVoice"},{"type":"text","text":" whose scheme is "},{"code":"https","type":"codeVoice"},{"type":"text","text":", "},{"code":"itms-apps","type":"codeVoice"},{"type":"text","text":", or "},{"code":"macappstore","type":"codeVoice"},{"type":"text","text":", calls the plugin’s "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" closure; otherwise no effect (the URL comes from remote config, so arbitrary schemes are never opened)"}]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"The plugin only handles its own actions. Any action that "},{"code":"extractAction","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for is ignored — the plugin’s "},{"code":"reduce(...)","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" immediately."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The combination of "},{"code":".forceFetch","type":"codeVoice"},{"type":"text","text":"’s cached-fallback behavior and "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator ("},{"code":"fetchError","type":"codeVoice"},{"type":"text","text":"), without leaving the UI stuck on "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":".verdictReceived","type":"codeVoice"},{"text":" is dispatched on every ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":"\/","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing ","type":"text"},{"code":"KillswitchState","type":"codeVoice"},{"text":" or a value derived from it — not by mapping this action. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"style":"note","name":"Note","type":"aside"},{"anchor":"Verdict-evaluation-rules","level":2,"text":"Verdict evaluation rules","type":"heading"},{"inlineContent":[{"code":"KillswitchVerdict.evaluate(_:against:)","type":"codeVoice"},{"type":"text","text":" is fail-open: any unparseable input yields "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":". Checks run in this fixed order, returning "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":" on the first match:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Current version parse.","type":"text"}],"type":"strong"},{"type":"text","text":" If "},{"type":"codeVoice","code":"currentVersionString"},{"type":"text","text":" cannot be parsed as a "},{"type":"codeVoice","code":"SemanticVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" immediately."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Minimum supported version.","type":"text"}],"type":"strong"},{"type":"text","text":" If "},{"type":"codeVoice","code":"config.minimumSupportedVersion"},{"type":"text","text":" parses and "},{"type":"codeVoice","code":"currentVersion < minVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Explicit blocked versions.","type":"text"}],"type":"strong"},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedVersions"},{"type":"text","text":". If any entry parses and equals "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Blocked ranges.","type":"text"}],"type":"strong"},{"type":"text","text":" Iterate "},{"type":"cod