{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference"},"kind":"article","seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginkillswitchreference"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Public API surface for the ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","title":"SwiduxKillswitch Reference","roleHeading":"Article"},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Library target","anchor":"Library-target"},{"inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" ships as its own product in the ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":" package. Add it to a target’s dependencies in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" and import it where you wire the plugin:","type":"text"}],"type":"paragraph"},{"code":["import SwiduxKillswitch"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The target depends on ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":" and links against ","type":"text"},{"type":"codeVoice","code":"UIKit"},{"text":" on iOS \/ ","type":"text"},{"type":"codeVoice","code":"AppKit"},{"text":" on macOS for the default URL-opening behavior.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Types","type":"heading","anchor":"Types"},{"level":3,"text":"KillswitchPlugin","type":"heading","anchor":"KillswitchPlugin"},{"inlineContent":[{"text":"The domain plugin. Conforms to ","type":"text"},{"code":"SwiduxPlugin","type":"codeVoice"},{"text":" and is generic over the host app’s root state and action types.","type":"text"}],"type":"paragraph"},{"code":["@MainActor","public struct KillswitchPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, KillswitchState>,","        action toRootAction: @escaping @Sendable (KillswitchAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> KillswitchAction?,","        service: KillswitchService,","        appVersion: @escaping @Sendable () -> String,","        openURL: @escaping @Sendable (URL) async -> Void = { \/* UIApplication \/ NSWorkspace *\/ }","    )","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The default ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" calls ","type":"text"},{"type":"codeVoice","code":"UIApplication.shared.open(_:)"},{"text":" on iOS and ","type":"text"},{"type":"codeVoice","code":"NSWorkspace.shared.open(_:)"},{"text":" on macOS, both hopped to ","type":"text"},{"type":"codeVoice","code":"MainActor"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"KillswitchState","type":"heading","anchor":"KillswitchState"},{"inlineContent":[{"text":"The state slice the plugin owns. Default-constructed values match a fresh, never-fetched session.","type":"text"}],"type":"paragraph"},{"code":["public struct KillswitchState: Sendable, Equatable {","    public var verdict: KillswitchVerdict   \/\/ defaults to .unknown","    public var lastFetch: Date?             \/\/ nil until first successful fetch","    public var fetchError: String?          \/\/ localized description of last failure","","    public var isBlocked: Bool              \/\/ delegates to verdict.isBlocked","    public var canOpenUpdateURL: Bool       \/\/ .blocked AND updateURL is non-nil","","    public init(","        verdict: KillswitchVerdict = .unknown,","        lastFetch: Date? = nil,","        fetchError: String? = nil","    )","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"isBlocked"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":" are convenience computed properties. Bind UI off them rather than pattern-matching ","type":"text"},{"type":"codeVoice","code":"verdict"},{"text":" everywhere.","type":"text"}],"type":"paragraph"},{"level":3,"text":"KillswitchAction","type":"heading","anchor":"KillswitchAction"},{"inlineContent":[{"text":"The plugin’s local action enum. Wrap these in your root action through the case you provide at registration.","type":"text"}],"type":"paragraph"},{"code":["public enum KillswitchAction: Sendable {","    case fetch","    case forceFetch","    case verdictReceived(KillswitchVerdict, fromNetwork: Bool)","    case fetchFailed(String)","    case openUpdateURL","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":".fetch"},{"text":" is the launch-time entry point — it consults the cache and skips the network when the cached config is fresh. ","type":"text"},{"type":"codeVoice","code":".forceFetch"},{"text":" always hits the network, suitable for pull-to-refresh or post-update health checks.","type":"text"}],"type":"paragraph"},{"level":3,"text":"KillswitchService","type":"heading","anchor":"KillswitchService"},{"inlineContent":[{"text":"A closure-based service that fetches and caches the remote config. Substitute the live factory in production and the mock factory in tests.","type":"text"}],"type":"paragraph"},{"code":["public struct KillswitchService: Sendable {","    public var fetch: @Sendable () async throws -> KillswitchConfig","    public var loadCached: @Sendable () -> KillswitchConfig?","    public var saveCached: @Sendable (KillswitchConfig) -> Void","    public let cacheLifetime: TimeInterval","","    public init(","        fetch: @escaping @Sendable () async throws -> KillswitchConfig,","        loadCached: @escaping @Sendable () -> KillswitchConfig?,","        saveCached: @escaping @Sendable (KillswitchConfig) -> Void,","        cacheLifetime: TimeInterval","    )","","    public static func live(","        endpoint: URL,","        fetchTimeout: TimeInterval = 10,","        cacheLifetime: TimeInterval = 3600,","        session: URLSession = .shared","    ) -> KillswitchService","","    public static func mock(","        result: @escaping @Sendable () async throws -> KillswitchConfig = { KillswitchConfig() },","        cached: KillswitchConfig? = nil,","        cacheLifetime: TimeInterval = 3600","    ) -> KillswitchService","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"live(endpoint:)"},{"text":" decodes JSON from ","type":"text"},{"type":"codeVoice","code":"endpoint"},{"text":" with a ","type":"text"},{"type":"codeVoice","code":"reloadIgnoringLocalCacheData"},{"text":" policy and persists the result to a ","type":"text"},{"type":"codeVoice","code":"swidux-killswitch.json"},{"text":" file in the user’s caches directory. ","type":"text"},{"type":"codeVoice","code":"mock(result:cached:)"},{"text":" keeps an in-memory cache and lets a test inject a closure that returns or throws.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The endpoint must be ","type":"text"},{"inlineContent":[{"text":"HTTPS","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"type":"codeVoice","code":"http"},{"text":" is allowed only for ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":" development servers; anything else is a precondition failure) — the killswitch is a remote control channel and must not be tamperable in transit. Non-2xx responses and payloads over 1 MB are treated as fetch failures, which fall back to the cache (and ultimately fail open).","type":"text"}],"type":"paragraph"},{"text":"KillswitchConfig","level":3,"type":"heading","anchor":"KillswitchConfig"},{"inlineContent":[{"text":"The decoded shape of the remote JSON. All fields are optional — a config with every field ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" evaluates to ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["public struct KillswitchConfig: Codable, Sendable, Equatable {","    public var minimumSupportedVersion: String?","    public var blockedVersions: [String]?","    public var blockedRanges: [String]?","    public var blockedTitle: String?","    public var blockedMessage: String?","    public var updateURL: String?","","    public init(","        minimumSupportedVersion: String? = nil,","        blockedVersions: [String]? = nil,","        blockedRanges: [String]? = nil,","        blockedTitle: String? = nil,","        blockedMessage: String? = nil,","        updateURL: String? = nil","    )","}"],"syntax":"swift","type":"codeListing"},{"text":"KillswitchVerdict","level":3,"type":"heading","anchor":"KillswitchVerdict"},{"inlineContent":[{"text":"The result of evaluating a config against the running version.","type":"text"}],"type":"paragraph"},{"code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":".unknown"},{"text":" is the initial state before any fetch has been attempted. ","type":"text"},{"type":"codeVoice","code":"evaluate(_:against:)"},{"text":" always returns ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"text":" — never ","type":"text"},{"type":"codeVoice","code":".unknown"},{"text":". ","type":"text"},{"type":"codeVoice","code":"isBlocked"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" only for the ","type":"text"},{"type":"codeVoice","code":".blocked"},{"text":" case.","type":"text"}],"type":"paragraph"},{"text":"SemanticVersion","level":3,"type":"heading","anchor":"SemanticVersion"},{"inlineContent":[{"text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests.","type":"text"}],"type":"paragraph"},{"code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The string initializer accepts ","type":"text"},{"code":"\"1.2.3\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"1.2.3-beta.1\"","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"\"1.2.3-beta.1+build42\"","type":"codeVoice"},{"text":". Build metadata after ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" is parsed and discarded. Malformed input returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric.","type":"text"}],"type":"paragraph"},{"level":3,"text":"VersionRange","anchor":"VersionRange","type":"heading"},{"inlineContent":[{"text":"A half-open range ","type":"text"},{"code":"[lowerBound, upperBound)","type":"codeVoice"},{"text":" of semantic versions, used to express ","type":"text"},{"code":"blockedRanges","type":"codeVoice"},{"text":" entries.","type":"text"}],"type":"paragraph"},{"code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Both initializers fail and return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Action semantics","anchor":"Action-semantics","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Effect on state","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Returned effect","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".fetch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"if the cache is fresh (","type":"text"},{"code":"Date() - lastFetch < cacheLifetime","type":"codeVoice"},{"text":" AND ","type":"text"},{"code":"loadCached()","type":"codeVoice"},{"text":" is non-nil), evaluates the cached config and dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" without hitting the network; otherwise behaves like ","type":"text"},{"code":".forceFetch","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".forceFetch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"calls ","type":"text"},{"code":"service.fetch()","type":"codeVoice"},{"text":", persists the result via ","type":"text"},{"code":"service.saveCached(_:)","type":"codeVoice"},{"text":", dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":". On thrown error, falls back to ","type":"text"},{"code":"service.loadCached()","type":"codeVoice"},{"text":" if available — dispatching ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from the cache ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":".fetchFailed(message)","type":"codeVoice"},{"text":" so the UI can surface the error while keeping a usable verdict","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".verdictReceived(verdict, fromNetwork:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"sets ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":", clears ","type":"text"},{"code":"fetchError","type":"codeVoice"},{"text":"; sets ","type":"text"},{"code":"lastFetch = Date()","type":"codeVoice"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"only when "},{"code":"fromNetwork","type":"codeVoice"},{"type":"text","text":" is true"}],"type":"strong"},{"text":" — a cache-served verdict must not slide the freshness window, or a session polling ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":" inside ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":" would never consult the network again","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".fetchFailed(message)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"sets ","type":"text"},{"code":"fetchError = message","type":"codeVoice"},{"text":" (does not clear ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"lastFetch","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".openUpdateURL","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"if ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" with a non-nil ","type":"text"},{"code":"updateURL","type":"codeVoice"},{"text":" whose scheme is ","type":"text"},{"code":"https","type":"codeVoice"},{"text":", ","type":"text"},{"code":"itms-apps","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"macappstore","type":"codeVoice"},{"text":", calls the plugin’s ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" closure; otherwise no effect (the URL comes from remote config, so arbitrary schemes are never opened)","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"The plugin only handles its own actions. Any action that ","type":"text"},{"code":"extractAction","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for is ignored — the plugin’s ","type":"text"},{"code":"reduce(...)","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" immediately.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The combination of ","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":"’s cached-fallback behavior and ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator (","type":"text"},{"code":"fetchError","type":"codeVoice"},{"text":"), without leaving the UI stuck on ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":""},{"code":".verdictReceived","type":"codeVoice"},{"type":"text","text":" is dispatched on every "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":"\/"},{"code":".forceFetch","type":"codeVoice"},{"type":"text","text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing "},{"code":"KillswitchState","type":"codeVoice"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"style":"note","type":"aside"},{"level":2,"text":"Verdict evaluation rules","anchor":"Verdict-evaluation-rules","type":"heading"},{"inlineContent":[{"code":"KillswitchVerdict.evaluate(_:against:)","type":"codeVoice"},{"text":" is fail-open: any unparseable input yields ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":". Checks run in this fixed order, returning ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":" on the first match:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Current version parse."}]},{"type":"text","text":" If "},{"type":"codeVoice","code":"currentVersionString"},{"type":"text","text":" cannot be parsed as a "},{"type":"codeVoice","code":"SemanticVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" immediately."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Minimum supported version."}]},{"type":"text","text":" If "},{"type":"codeVoice","code":"config.minimumSupportedVersion"},{"type":"text","text":" parses and "},{"type":"codeVoice","code":"currentVersion < minVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Explicit blocked versions.","type":"text"}]},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedVersions"},{"type":"text","text":". If any entry parses and equals "},{"type":"codeVoice","code":"currentVersion"},{"text":", return ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Blocked ranges."}]},{"text":" Iterate ","type":"text"},{"code":"config.blockedRanges","type":"codeVoice"},{"text":". If any entry parses as a ","type":"text"},{"code":"VersionRange","type":"codeVoice"},{"text":" and contains ","type":"text"},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":", return "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Otherwise"}]},{"text":" return ","type":"text"},{"type":"codeVoice","code":".allowed"},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"A blocked verdict carries the config’s ","type":"text"},{"code":"blockedTitle","type":"codeVoice"},{"text":", ","type":"text"},{"code":"blockedMessage","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"updateURL","type":"codeVoice"},{"text":" (parsed via ","type":"text"},{"code":"URL(string:)","type":"codeVoice"},{"text":") regardless of which check matched.","type":"text"}]},{"text":"Remote config JSON shape","level":2,"type":"heading","anchor":"Remote-config-JSON-shape"},{"inlineContent":[{"code":"KillswitchConfig","type":"codeVoice"},{"type":"text","text":" derives its "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance from synthesized keys, so the JSON keys match the property names. A representative file:"}],"type":"paragraph"},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.3.0\", \"1.3.1\"],","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update Required\",","    \"blockedMessage\": \"Please update to continue using the app.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every field is optional. An empty object "},{"code":"{}","type":"codeVoice"},{"type":"text","text":" is valid and evaluates to "},{"code":".allowed","type":"codeVoice"},{"text":" for any version.","type":"text"}]},{"level":2,"text":"View modifier: `killswitchBlocker`","anchor":"View-modifier-killswitchBlocker","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" ships a SwiftUI view modifier that overlays a non-dismissible blocker whenever the verdict is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" and disables the underlying content while it is. Two overloads:","type":"text"}]},{"code":["extension View {","    \/\/\/ Default blocker — full-screen ultraThinMaterial with title, message,","    \/\/\/ and an optional Update button.","    public func killswitchBlocker(","        verdict: KillswitchVerdict,","        onUpdate: (() -> Void)? = nil","    ) -> some View","","    \/\/\/ Custom blocker — receives the title, message, and `hasUpdateURL`","    \/\/\/ flag and renders whatever you return.","    public func killswitchBlocker<Blocker: View>(","        verdict: KillswitchVerdict,","        @ViewBuilder blocker: @escaping (","            _ title: String?,","            _ message: String?,","            _ hasUpdateURL: Bool","        ) -> Blocker","    ) -> some View","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Both overloads apply ","type":"text"},{"code":".disabled(verdict.isBlocked)","type":"codeVoice"},{"text":" to the modified content, so the underlying view tree stops responding to touches while blocked. The blocker layer is rendered as an overlay; supply your own to match the host app’s design system.","type":"text"}]}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","kind":"symbol","role":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"title":"UndoPlugin","url":"\/documentation\/swidux\/undoplugin","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}]},