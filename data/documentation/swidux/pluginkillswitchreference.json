t":" package. Add it to a target’s dependencies in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":" and import it where you wire the plugin:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxKillswitch"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The target depends on "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" and links against "},{"type":"codeVoice","code":"UIKit"},{"type":"text","text":" on iOS \/ "},{"type":"codeVoice","code":"AppKit"},{"type":"text","text":" on macOS for the default URL-opening behavior."}],"type":"paragraph"},{"level":2,"text":"Types","type":"heading","anchor":"Types"},{"level":3,"text":"KillswitchPlugin","type":"heading","anchor":"KillswitchPlugin"},{"inlineContent":[{"type":"text","text":"The domain plugin. Conforms to "},{"code":"SwiduxPlugin","type":"codeVoice"},{"type":"text","text":" and is generic over the host app’s root state and action types."}],"type":"paragraph"},{"syntax":"swift","code":["@MainActor","public struct KillswitchPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, KillswitchState>,","        action toRootAction: @escaping @Sendable (KillswitchAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> KillswitchAction?,","        service: KillswitchService,","        appVersion: @escaping @Sendable () -> String,","        openURL: @escaping @Sendable (URL) async -> Void = { \/* UIApplication \/ NSWorkspace *\/ }","    )","}"],"type":"codeListing"},{"inlineContent":[{"text":"The default ","type":"text"},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"UIApplication.shared.open(_:)"},{"type":"text","text":" on iOS and "},{"type":"codeVoice","code":"NSWorkspace.shared.open(_:)"},{"type":"text","text":" on macOS, both hopped to "},{"type":"codeVoice","code":"MainActor"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"KillswitchState","text":"KillswitchState"},{"type":"paragraph","inlineContent":[{"text":"The state slice the plugin owns. Default-constructed values match a fresh, never-fetched session.","type":"text"}]},{"code":["public struct KillswitchState: Sendable, Equatable {","    public var verdict: KillswitchVerdict   \/\/ defaults to .unknown","    public var lastFetch: Date?             \/\/ nil until first successful fetch","    public var fetchError: String?          \/\/ localized description of last failure","","    public var isBlocked: Bool              \/\/ delegates to verdict.isBlocked","    public var canOpenUpdateURL: Bool       \/\/ .blocked AND updateURL is non-nil","","    public init(","        verdict: KillswitchVerdict = .unknown,","        lastFetch: Date? = nil,","        fetchError: String? = nil","    )","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"isBlocked","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"canOpenUpdateURL","type":"codeVoice"},{"text":" are convenience computed properties. Bind UI off them rather than pattern-matching ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" everywhere.","type":"text"}]},{"level":3,"type":"heading","anchor":"KillswitchAction","text":"KillswitchAction"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin’s local action enum. Wrap these in your root action through the case you provide at registration."}]},{"code":["public enum KillswitchAction: Sendable {","    case fetch","    case forceFetch","    case verdictReceived(KillswitchVerdict, fromNetwork: Bool)","    case fetchFailed(String)","    case openUpdateURL","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":".fetch","type":"codeVoice"},{"text":" is the launch-time entry point — it consults the cache and skips the network when the cached config is fresh. ","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":" always hits the network, suitable for pull-to-refresh or post-update health checks.","type":"text"}]},{"level":3,"type":"heading","anchor":"KillswitchService","text":"KillswitchService"},{"type":"paragraph","inlineContent":[{"text":"A closure-based service that fetches and caches the remote config. Substitute the live factory in production and the mock factory in tests.","type":"text"}]},{"code":["public struct KillswitchService: Sendable {","    public var fetch: @Sendable () async throws -> KillswitchConfig","    public var loadCached: @Sendable () -> KillswitchConfig?","    public var saveCached: @Sendable (KillswitchConfig) -> Void","    public let cacheLifetime: TimeInterval","","    public init(","        fetch: @escaping @Sendable () async throws -> KillswitchConfig,","        loadCached: @escaping @Sendable () -> KillswitchConfig?,","        saveCached: @escaping @Sendable (KillswitchConfig) -> Void,","        cacheLifetime: TimeInterval","    )","","    public static func live(","        endpoint: URL,","        fetchTimeout: TimeInterval = 10,","        cacheLifetime: TimeInterval = 3600,","        session: URLSession = .shared","    ) -> KillswitchService","","    public static func mock(","        result: @escaping @Sendable () async throws -> KillswitchConfig = { KillswitchConfig() },","        cached: KillswitchConfig? = nil,","        cacheLifetime: TimeInterval = 3600","    ) -> KillswitchService","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"live(endpoint:)","type":"codeVoice"},{"type":"text","text":" decodes JSON from "},{"code":"endpoint","type":"codeVoice"},{"type":"text","text":" with a "},{"code":"reloadIgnoringLocalCacheData","type":"codeVoice"},{"type":"text","text":" policy and persists the result to a "},{"code":"swidux-killswitch.json","type":"codeVoice"},{"text":" file in the user’s caches directory. ","type":"text"},{"code":"mock(result:cached:)","type":"codeVoice"},{"text":" keeps an in-memory cache and lets a test inject a closure that returns or throws.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The endpoint must be "},{"type":"strong","inlineContent":[{"text":"HTTPS","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"http"},{"type":"text","text":" is allowed only for "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":" development servers; anything else is a precondition failure) — the killswitch is a remote control channel and must not be tamperable in transit. Non-2xx responses and payloads over 1 MB are treated as fetch failures, which fall back to the cache (and ultimately fail open)."}]},{"text":"KillswitchConfig","anchor":"KillswitchConfig","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The decoded shape of the remote JSON. All fields are optional — a config with every field "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" evaluates to "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["public struct KillswitchConfig: Codable, Sendable, Equatable {","    public var minimumSupportedVersion: String?","    public var blockedVersions: [String]?","    public var blockedRanges: [String]?","    public var blockedTitle: String?","    public var blockedMessage: String?","    public var updateURL: String?","","    public init(","        minimumSupportedVersion: String? = nil,","        blockedVersions: [String]? = nil,","        blockedRanges: [String]? = nil,","        blockedTitle: String? = nil,","        blockedMessage: String? = nil,","        updateURL: String? = nil","    )","}"]},{"text":"KillswitchVerdict","anchor":"KillswitchVerdict","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The result of evaluating a config against the running version."}]},{"type":"codeListing","syntax":"swift","code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unknown"},{"type":"text","text":" is the initial state before any fetch has been attempted. "},{"type":"codeVoice","code":"evaluate(_:against:)"},{"type":"text","text":" always returns "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" or "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":" — never "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":". "},{"code":"isBlocked","type":"codeVoice"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" only for the "},{"type":"codeVoice","code":".blocked"},{"type":"text","text":" case."}]},{"type":"heading","level":3,"anchor":"SemanticVersion","text":"SemanticVersion"},{"type":"paragraph","inlineContent":[{"text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The string initializer accepts "},{"type":"codeVoice","code":"\"1.2.3\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"1.2.3-beta.1\""},{"type":"text","text":", and "},{"type":"codeVoice","code":"\"1.2.3-beta.1+build42\""},{"type":"text","text":". Build metadata after "},{"type":"codeVoice","code":"+"},{"type":"text","text":" is parsed and discarded. Malformed input returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric."}]},{"type":"heading","level":3,"anchor":"VersionRange","text":"VersionRange"},{"type":"paragraph","inlineContent":[{"text":"A half-open range ","type":"text"},{"code":"[lowerBound, upperBound)","type":"codeVoice"},{"text":" of semantic versions, used to express ","type":"text"},{"code":"blockedRanges","type":"codeVoice"},{"text":" entries.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both initializers fail and return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed."}]},{"type":"heading","level":2,"anchor":"Action-semantics","text":"Action semantics"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Effect on state"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Returned effect","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".fetch"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"if the cache is fresh (","type":"text"},{"type":"codeVoice","code":"Date() - lastFetch < cacheLifetime"},{"text":" AND ","type":"text"},{"type":"codeVoice","code":"loadCached()"},{"text":" is non-nil), evaluates the cached config and dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" without hitting the network; otherwise behaves like ","type":"text"},{"type":"codeVoice","code":".forceFetch"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".forceFetch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"calls "},{"type":"codeVoice","code":"service.fetch()"},{"type":"text","text":", persists the result via "},{"type":"codeVoice","code":"service.saveCached(_:)"},{"type":"text","text":", dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":". On thrown error, falls back to "},{"type":"codeVoice","code":"service.loadCached()"},{"type":"text","text":" if available — dispatching "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from the cache "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed(message)"},{"type":"text","text":" so the UI can surface the error while keeping a usable verdict"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".verdictReceived(verdict, fromNetwork:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"sets "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":", clears "},{"code":"fetchError","type":"codeVoice"},{"type":"text","text":"; sets "},{"code":"lastFetch = Date()","type":"codeVoice"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"only when "},{"code":"fromNetwork","type":"codeVoice"},{"type":"text","text":" is true"}]},{"type":"text","text":" — a cache-served verdict must not slide the freshness window, or a session polling "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":" inside "},{"code":"cacheLifetime","type":"codeVoice"},{"type":"text","text":" would never consult the network again"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".fetchFailed(message)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"sets "},{"code":"fetchError = message","type":"codeVoice"},{"type":"text","text":" (does not clear "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":" or "},{"type":"codeVoice","code":"lastFetch"},{"type":"text","text":")"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".openUpdateURL","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"if "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":" is "},{"type":"codeVoice","code":".blocked"},{"type":"text","text":" with a non-nil "},{"type":"codeVoice","code":"updateURL"},{"type":"text","text":" whose scheme is "},{"type":"codeVoice","code":"https"},{"type":"text","text":", "},{"type":"codeVoice","code":"itms-apps"},{"type":"text","text":", or "},{"type":"codeVoice","code":"macappstore"},{"type":"text","text":", calls the plugin’s "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" closure; otherwise no effect (the URL comes from remote config, so arbitrary schemes are never opened)"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The plugin only handles its own actions. Any action that ","type":"text"},{"code":"extractAction","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for is ignored — the plugin’s ","type":"text"},{"code":"reduce(...)","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" immediately.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The combination of ","type":"text"},{"type":"codeVoice","code":".forceFetch"},{"type":"text","text":"’s cached-fallback behavior and "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator ("},{"type":"codeVoice","code":"fetchError"},{"type":"text","text":"), without leaving the UI stuck on "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"."}]},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":".verdictReceived"},{"type":"text","text":" is dispatched on every "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":"\/"},{"type":"codeVoice","code":".forceFetch"},{"type":"text","text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing "},{"type":"codeVoice","code":"KillswitchState"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation"},{"type":"text","text":"."}]}],"style":"note","type":"aside"},{"anchor":"Verdict-evaluation-rules","text":"Verdict evaluation rules","level":2,"type":"heading"},{"inlineContent":[{"code":"KillswitchVerdict.evaluate(_:against:)","type":"codeVoice"},{"text":" is fail-open: any unparseable input yields ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":". Checks run in this fixed order, returning ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":" on the first match:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Current version parse."}]},{"type":"text","text":" If "},{"type":"codeVoice","code":"currentVersionString"},{"type":"text","text":" cannot be parsed as a "},{"type":"codeVoice","code":"SemanticVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" immediately."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Minimum supported version."}]},{"type":"text","text":" If "},{"code":"config.minimumSupportedVersion","type":"codeVoice"},{"type":"text","text":" parses and "},{"code":"currentVersion < minVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Explicit blocked versions."}]},{"text":" Iterate ","type":"text"},{"code":"config.blockedVersions","type":"codeVoice"},{"text":". If any entry parses and equals ","type":"text"},{"code":"currentVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Blocked ranges."}],"type":"strong"},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedRanges"},{"type":"text","text":". If any entry parses as a "},{"type":"codeVoice","code":"VersionRange"},{"text":" and contains ","type":"text"},{"code":"currentVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Otherwise","type":"text"}]},{"text":" return ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"A blocked verdict carries the config’s ","type":"text"},{"type":"codeVoice","code":"blockedTitle"},{"text":", ","type":"text"},{"type":"codeVoice","code":"blockedMessage"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"updateURL"},{"text":" (parsed via ","type":"text"},{"type":"codeVoice","code":"URL(string:)"},{"text":") regardless of which check matched.","type":"text"}],"type":"paragraph"},{"anchor":"Remote-config-JSON-shape","level":2,"text":"Remote config JSON shape","type":"heading"},{"inlineContent":[{"code":"KillswitchConfig","type":"codeVoice"},{"type":"text","text":" derives its "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance from synthesized keys, so the JSON keys match the property names. A representative file:"}],"type":"paragraph"},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.3.0\", \"1.3.1\"],","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update Required\",","    \"blockedMessage\": \"Please update to continue using the app.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every field is optional. An empty object "},{"code":"{}","type":"codeVoice"},{"type":"text","text":" is valid and evaluates to "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" for any version."}],"type":"paragraph"},{"anchor":"View-modifier-killswitchBlocker","level":2,"text":"View modifier: `killswitchBlocker`","type":"heading"},{"inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" ships a SwiftUI view modifier that overlays a non-dismissible blocker whenever the verdict is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" and disables the underlying content while it is. Two overloads:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["extension View {","    \/\/\/ Default blocker — full-screen ultraThinMaterial with title, message,","    \/\/\/ and an optional Update button.","    public func killswitchBlocker(","        verdict: KillswitchVerdict,","        onUpdate: (() -> Void)? = nil","    ) -> some View","","    \/\/\/ Custom blocker — receives the title, message, and `hasUpdateURL`","    \/\/\/ flag and renders whatever you return.","    public func killswitchBlocker<Blocker: View>(","        verdict: KillswitchVerdict,","        @ViewBuilder blocker: @escaping (","            _ title: String?,","            _ message: String?,","            _ hasUpdateURL: Bool","        ) -> Blocker","    ) -> some View","}"]},{"type":"paragraph","inlineContent":[{"text":"Both overloads apply ","type":"text"},{"type":"codeVoice","code":".disabled(verdict.isBlocked)"},{"text":" to the modified content, so the underlying view tree stops responding to touches while blocked. The blocker layer is rendered as an overlay; supply your own to match the host app’s design system.","type":"text"}]}],"kind":"content"}],"sections":[],"references":{"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"title":"SwiduxParentalGate Reference","url":"\/documentation\/swidux\/pluginparentalgatereference","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"