when "},{"type":"codeVoice","code":"fromNetwork"},{"type":"text","text":" is true"}],"type":"strong"},{"text":" — a cache-served verdict must not slide the freshness window, or a session polling ","type":"text"},{"code":".fetch","type":"codeVoice"},{"type":"text","text":" inside "},{"code":"cacheLifetime","type":"codeVoice"},{"type":"text","text":" would never consult the network again"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".fetchFailed(message)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"sets ","type":"text"},{"code":"fetchError = message","type":"codeVoice"},{"text":" (does not clear ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"lastFetch","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".openUpdateURL","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"inlineContent":[{"text":"if ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" is ","type":"text"},{"type":"codeVoice","code":".blocked"},{"text":" with a non-nil ","type":"text"},{"type":"codeVoice","code":"updateURL"},{"type":"text","text":" whose scheme is "},{"type":"codeVoice","code":"https"},{"type":"text","text":", "},{"type":"codeVoice","code":"itms-apps"},{"text":", or ","type":"text"},{"code":"macappstore","type":"codeVoice"},{"text":", calls the plugin’s ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" closure; otherwise no effect (the URL comes from remote config, so arbitrary schemes are never opened)","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"inlineContent":[{"type":"text","text":"The plugin only handles its own actions. Any action that "},{"type":"codeVoice","code":"extractAction"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for is ignored — the plugin’s "},{"code":"reduce(...)","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"text":" immediately.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The combination of ","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":"’s cached-fallback behavior and ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator (","type":"text"},{"code":"fetchError","type":"codeVoice"},{"text":"), without leaving the UI stuck on ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":".verdictReceived","type":"codeVoice"},{"text":" is dispatched on every ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":"\/","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing ","type":"text"},{"code":"KillswitchState","type":"codeVoice"},{"text":" or a value derived from it — not by mapping this action. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note","type":"aside"},{"level":2,"text":"Verdict evaluation rules","anchor":"Verdict-evaluation-rules","type":"heading"},{"inlineContent":[{"code":"KillswitchVerdict.evaluate(_:against:)","type":"codeVoice"},{"text":" is fail-open: any unparseable input yields ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":". Checks run in this fixed order, returning ","type":"text"},{"code":".blocked(...)","