y cache and lets a test inject a closure that returns or throws.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"KillswitchConfig","text":"KillswitchConfig","type":"heading"},{"inlineContent":[{"text":"The decoded shape of the remote JSON. All fields are optional — a config with every field ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" evaluates to ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["public struct KillswitchConfig: Codable, Sendable, Equatable {","    public var minimumSupportedVersion: String?","    public var blockedVersions: [String]?","    public var blockedRanges: [String]?","    public var blockedTitle: String?","    public var blockedMessage: String?","    public var updateURL: String?","","    public init(","        minimumSupportedVersion: String? = nil,","        blockedVersions: [String]? = nil,","        blockedRanges: [String]? = nil,","        blockedTitle: String? = nil,","        blockedMessage: String? = nil,","        updateURL: String? = nil","    )","}"],"type":"codeListing","syntax":"swift"},{"level":3,"anchor":"KillswitchVerdict","text":"KillswitchVerdict","type":"heading"},{"inlineContent":[{"text":"The result of evaluating a config against the running version.","type":"text"}],"type":"paragraph"},{"code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":".unknown"},{"text":" is the initial state before any fetch has been attempted. ","type":"text"},{"type":"codeVoice","code":"evaluate(_:against:)"},{"text":" always returns ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"text":" — never ","type":"text"},{"type":"codeVoice","code":".unknown"},{"text":". ","type":"text"},{"type":"codeVoice","code":"isBlocked"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" only for the ","type":"text"},{"type":"codeVoice","code":".blocked"},{"text":" case.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"SemanticVersion","text":"SemanticVersion","type":"heading"},{"inlineContent":[{"text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests.","type":"text"}],"type":"paragraph"},{"code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The string initializer accepts ","type":"text"},{"type":"codeVoice","code":"\"1.2.3\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"1.2.3-beta.1\""},{"text":", and ","type":"text"},{"type":"codeVoice","code":"\"1.2.3-beta.1+build42\""},{"text":". Build metadata after ","type":"text"},{"type":"codeVoice","code":"+"},{"text":" is parsed and discarded. Malformed input returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"VersionRange","text":"VersionRange","type":"heading"},{"inlineContent":[{"text":"A half-open range ","type":"text"},{"type":"codeVoice","code":"[lowerBound, upperBound)"},{"text":" of semantic versions, used to express ","type":"text"},{"type":"codeVoice","code":"blockedRanges"},{"text":" entries.","type":"text"}],"type":"paragraph"},{"code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Both initializers fail and return ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Action-semantics","text":"Action semantics","type":"heading"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Effect on state","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Returned effect","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".fetch"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"if the cache is fresh ("},{"type":"codeVoice","code":"Date() - lastFetch < cacheLifetime"},{"type":"text","text":" AND "},{"type":"codeVoice","code":"loadCached()"},{"type":"text","text":" is non-nil), evaluates the cached config and dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" without hitting the network; otherwise behaves like "},{"type":"codeVoice","code":".forceFetch"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".forceFetch"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"calls "},{"type":"codeVoice","code":"service.fetch()"},{"type":"text","text":", persists the result via "},{"type":"codeVoice","code":"service.saveCached(_:)"},{"type":"text","text":", dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":". On thrown error, falls back to "},{"type":"codeVoice","code":"service.loadCached()"},{"type":"text","text":" if available — dispatching "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from the cache "},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed(message)"},{"type":"text","text":" so the UI can surface the error while keeping a usable verdict"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".verdictReceived(verdict)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"sets "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":", sets "},{"type":"codeVoice","code":"lastFetch = Date()"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"fetchError"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".fetchFailed(message)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"sets "},{"type":"codeVoice","code":"fetchError = message"},{"type":"text","text":" (does not clear "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":" or "},{"type":"codeVoice","code":"lastFetch"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".openUpdateURL"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"if "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":" is "},{"type":"codeVoice","code":".blocked"},{"type":"text","text":" with a non-nil "},{"type":"codeVoice","code":"updateURL"},{"type":"text","text":", calls the plugin’s "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" closure; otherwise no effect"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"The plugin only handles its own actions. Any action that ","type":"text"},{"type":"codeVoice","code":"extractAction"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" for is ignored — the plugin’s ","type":"text"},{"type":"codeVoice","code":"reduce(...)"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" immediately.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The combination of ","type":"text"},{"type":"codeVoice","code":".forceFetch"},{"text":"’s cached-fallback behavior and ","type":"text"},{"type":"codeVoice","code":".fetch"},{"text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator (","type":"text"},{"type":"codeVoice","code":"fetchError"},{"text":"), without leaving the UI stuck on ","type":"text"},{"type":"codeVoice","code":".unknown"},{"text":".","type":"text"}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":".verdictReceived"},{"type":"text","text":" is dispatched on every "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":"\/"},{"type":"codeVoice","code":".forceFetch"},{"type":"text","text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing "},{"type":"codeVoice","code":"KillswitchState"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"level":2,"anchor":"Verdict-evaluation-rules","text":"Verdict evaluation rules","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"KillswitchVerdict.evaluate(_:against:)"},{"text":" is fail-open: any unparseable input yields ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":". Checks run in this fixed order, returning ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"text":" on the first match:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Current version parse."}]},{"type":"text","text":" If "},{"type":"codeVoice","code":"currentVersionString"},{"type":"text","text":" cannot be parsed as a "},{"type":"codeVoice","code":"SemanticVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" immediately."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Minimum supported version."}]},{"type":"text","text":" If "},{"type":"codeVoice","code":"config.minimumSupportedVersion"},{"type":"text","text":" parses and "},{"type":"codeVoice","code":"currentVersion < minVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Explicit blocked versions."}]},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedVersions"},{"type":"text","text