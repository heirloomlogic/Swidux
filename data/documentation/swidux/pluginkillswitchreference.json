"text":", ","type":"text"},{"code":"\"1.2.3-beta.1\"","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"\"1.2.3-beta.1+build42\"","type":"codeVoice"},{"text":". Build metadata after ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" is parsed and discarded. Malformed input returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric."}]},{"type":"heading","text":"VersionRange","level":3,"anchor":"VersionRange"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A half-open range "},{"code":"[lowerBound, upperBound)","type":"codeVoice"},{"type":"text","text":" of semantic versions, used to express "},{"code":"blockedRanges","type":"codeVoice"},{"type":"text","text":" entries."}]},{"type":"codeListing","code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"Both initializers fail and return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed."}],"type":"paragraph"},{"text":"Action semantics","anchor":"Action-semantics","level":2,"type":"heading"},{"rows":[[[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Effect on state","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned effect"}]}]],[[{"inlineContent":[{"code":".fetch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}],[{"inlineContent":[{"text":"if the cache is fresh (","type":"text"},{"code":"Date() - lastFetch < cacheLifetime","type":"codeVoice"},{"text":" AND ","type":"text"},{"type":"codeVoice","code":"loadCached()"},{"text":" is non-nil), evaluates the cached config and dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"type":"text","text":" without hitting the network; otherwise behaves like "},{"code":".forceFetch","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":".forceFetch","type":"codeVoice"}]}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"calls "},{"type":"codeVoice","code":"service.fetch()"},{"type":"text","text":", persists the result via "},{"type":"codeVoice","code":"service.saveCached(_:)"},{"type":"text","text":", dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":". On thrown error, falls back to "},{"type":"codeVoice","code":"service.loadCached()"},{"type":"text","text":" if available — dispatching "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from the cache "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed(message)"},{"text":" so the UI can surface the error while keeping a usable verdict","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":".verdictReceived(verdict)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"sets ","type":"text"},{"code":"verdict","type":"codeVoice"},{"type":"text","text":", sets "},{"type":"codeVoice","code":"lastFetch = Date()"},{"text":", clears ","type":"text"},{"type":"codeVoice","code":"fetchError"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":".fetchFailed(message)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"sets ","type":"text"},{"code":"fetchError = message","type":"codeVoice"},{"text":" (does not clear ","type":"text"},{"code":"verdict","type":"codeVoice"},{"type":"text","text":" or "},{"code":"lastFetch","type":"codeVoice"},{"type":"text","text":")"}]}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".openUpdateURL"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"if ","type":"text"},{"type":"codeVoice","code":"verdict"},{"text":" is ","type":"text"},{"type":"codeVoice","code":".blocked"},{"text":" with a non-nil ","type":"text"},{"type":"codeVoice","code":"updateURL"},{"text":", calls the plugin’s ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" closure; otherwise no effect","type":"text"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"The plugin only handles its own actions. Any action that ","type":"text"},{"code":"extractAction","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for is ignored — the plugin’s ","type":"text"},{"code":"reduce(...)","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" immediately.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The combination of "},{"type":"codeVoice","code":".forceFetch"},{"text":"’s cached-fallback behavior and ","type":"text"},{"type":"codeVoice","code":".fetch"},{"type":"text","text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator ("},{"code":"fetchError","type":"codeVoice"},{"type":"text","text":"), without leaving the UI stuck on "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":"."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":".verdictReceived","type":"codeVoice"},{"text":" is dispatched on every ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":"\/","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing ","type":"text"},{"code":"KillswitchState","type":"codeVoice"},{"text":" or a value derived from it — not by mapping this action. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation"},{"text":".","type":"text"}]}],"style":"note","type":"aside","name":"Note"},{"type":"heading","text":"Verdict evaluation rules","level":2,"anchor":"Verdict-evaluation-rules"},{"inlineContent":[{"type":"codeVoice","code":"KillswitchVerdict.evaluate(_:against:)"},{"text":" is fail-open: any unparseable input yields ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":". Checks run in this fixed order, returning ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"text":" on the first match:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Current version parse.","type":"text"}]},{"text":" If ","type":"text"},{"type":"codeVoice","code":"currentVersionString"},{"text":" cannot be parsed as a ","type":"text"},{"type":"codeVoice","code":"SemanticVersion"},{"text":", return ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":" immediately.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Minimum supported version."}]},{"type":"text","text":" If "},{"code":"config.minimumSupportedVersion","type":"codeVoice"},{"text":" parses and ","type":"text"},{"code":"currentVersion < minVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Explicit blocked versions.","type":"text"}],"type":"strong"},{"text":" Iterate ","type":"text"},{"type":"codeVoice","code":"config.blockedVersions"},{"text":". If any entry parses and equals ","type":"text"},{"type":"codeVoice","code":"currentVersion"},{"text":", return ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Blocked ranges."}]},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedRanges"},{"type":"text","text":". If any entry parses as a "},{"type":"codeVoice","code":"VersionRange"},{"type":"text","text":" and contains "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Otherwise","type":"text"}],"type":"strong"},{"type":"text","text":" return "},{"type":"codeVoice","code":".allowed"},{"text":".","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"A blocked verdict carries the config’s "},{"code":"blockedTitle","type":"codeVoice"},{"type":"text","text":", "},{"code":"blockedMessage","type":"codeVoice"},{"type":"text","text":", and "},{"code":"updateURL","type":"codeVoice"},{"type":"text","text":" (parsed via "},{"code":"URL(string:)","type":"codeVoice"},{"type":"text","text":") regardless of which check matched."}],"type":"paragraph"},{"level":2,"text":"Remote config JSON shape","ancho