he target depends on "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":" and links against "},{"code":"UIKit","type":"codeVoice"},{"type":"text","text":" on iOS \/ "},{"code":"AppKit","type":"codeVoice"},{"type":"text","text":" on macOS for the default URL-opening behavior."}]},{"level":2,"text":"Types","type":"heading","anchor":"Types"},{"level":3,"text":"KillswitchPlugin","type":"heading","anchor":"KillswitchPlugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The domain plugin. Conforms to "},{"code":"SwiduxPlugin","type":"codeVoice"},{"type":"text","text":" and is generic over the host app’s root state and action types."}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","public struct KillswitchPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, KillswitchState>,","        action toRootAction: @escaping @Sendable (KillswitchAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> KillswitchAction?,","        service: KillswitchService,","        appVersion: @escaping @Sendable () -> String,","        openURL: @escaping @Sendable (URL) async -> Void = { \/* UIApplication \/ NSWorkspace *\/ }","    )","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" calls "},{"code":"UIApplication.shared.open(_:)","type":"codeVoice"},{"type":"text","text":" on iOS and "},{"code":"NSWorkspace.shared.open(_:)","type":"codeVoice"},{"type":"text","text":" on macOS, both hopped to "},{"code":"MainActor","type":"codeVoice"},{"type":"text","text":"."}]},{"level":3,"text":"KillswitchState","type":"heading","anchor":"KillswitchState"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The state slice the plugin owns. Default-constructed values match a fresh, never-fetched session."}]},{"type":"codeListing","syntax":"swift","code":["public struct KillswitchState: Sendable, Equatable {","    public var verdict: KillswitchVerdict   \/\/ defaults to .unknown","    public var lastFetch: Date?             \/\/ nil until first successful fetch","    public var fetchError: String?          \/\/ localized description of last failure","","    public var isBlocked: Bool              \/\/ delegates to verdict.isBlocked","    public var canOpenUpdateURL: Bool       \/\/ .blocked AND updateURL is non-nil","","    public init(","        verdict: KillswitchVerdict = .unknown,","        lastFetch: Date? = nil,","        fetchError: String? = nil","    )","}"]},{"type":"paragraph","inlineContent":[{"code":"isBlocked","type":"codeVoice"},{"type":"text","text":" and "},{"code":"canOpenUpdateURL","type":"codeVoice"},{"type":"text","text":" are convenience computed properties. Bind UI off them rather than pattern-matching "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":" everywhere."}]},{"level":3,"text":"KillswitchAction","type":"heading","anchor":"KillswitchAction"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin’s local action enum. Wrap these in your root action through the case you provide at registration."}]},{"type":"codeListing","syntax":"swift","code":["public enum KillswitchAction: Sendable {","    case fetch","    case forceFetch","    case verdictReceived(KillswitchVerdict, fromNetwork: Bool)","    case fetchFailed(String)","    case openUpdateURL","}"]},{"type":"paragraph","inlineContent":[{"code":".fetch","type":"codeVoice"},{"type":"text","text":" is the launch-time entry point — it consults the cache and skips the network when the cached config is fresh. "},{"code":".forceFetch","type":"codeVoice"},{"type":"text","text":" always hits the network, suitable for pull-to-refresh or post-update health checks."}]},{"level":3,"text":"KillswitchService","type":"heading","anchor":"KillswitchService"},{"type":"paragraph