-based undo\/redo to your app with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":"."}],"kind":"article","role":"article","title":"Undo \/ Redo"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","url":"\/documentation\/swidux\/persistencemiddlewareguide","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"kind":"article","role":"article","title":"Persistence Middleware"},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","url":"\/documentation\/swidux\/gettingstarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"kind":"article","role":"article","title":"Getting Started with Swidux"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","url":"\/documentation\/swidux\/pluginfeatureflagsreference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"kind":"article","role":"article","title":"SwiduxFeatureFlags Reference"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"UndoPlugin"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","role":"symbol","url":"\/documentation\/swidux\/undoplugin","title":"UndoPlugin","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"kind":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","role":"article","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","title":"Add a Version Killswitch","type":"topic"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","url":"\/documentation\/swidux\/pluginparentalgatereference","abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"kind":"article","role":"article","title":"SwiduxParentalGate Reference"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","url":"\/documentation\/swidux\/keyvaluestoreguide","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"kind":"article","role":"collectionGroup","title":"KeyValueStore"},"doc://Swidux/documentation/Swidux/MacrosReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","role":"article","url":"\/documentation\/swidux\/macrosreference","title":"Macros","type":"topic","abstract":[{"type":"text","text":"Reference for "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" and "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":" — the two macros that generate the observation bridge between value-type state and SwiftUI."}],"kind":"article"},"doc://Swidux/documentation/Swidux":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"kind":"symbol","role":"collection","title":"Swidux"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"kind":"article","role":"article","title":"Plugin Architecture"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","url":"\/documentation\/swidux\/entitystoreguide","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"kind":"article","role":"article","title":"EntityStore"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","url":"\/documentation\/swidux\/pluginanalyticsreference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"kind":"article","role":"article","title":"SwiduxAnalytics Reference"}}}