: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The string initializer accepts "},{"type":"codeVoice","code":"\"1.2.3\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"1.2.3-beta.1\""},{"type":"text","text":", and "},{"code":"\"1.2.3-beta.1+build42\"","type":"codeVoice"},{"type":"text","text":". Build metadata after "},{"code":"+","type":"codeVoice"},{"type":"text","text":" is parsed and discarded. Malformed input returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric.","type":"text"}]},{"anchor":"VersionRange","type":"heading","level":3,"text":"VersionRange"},{"type":"paragraph","inlineContent":[{"text":"A half-open range ","type":"text"},{"code":"[lowerBound, upperBound)","type":"codeVoice"},{"type":"text","text":" of semantic versions, used to express "},{"type":"codeVoice","code":"blockedRanges"},{"type":"text","text":" entries."}]},{"type":"codeListing","syntax":"swift","code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"]},{"type":"paragraph","inlineContent":[{"text":"Both initializers fail and return ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed.","type":"text"}]},{"type":"heading","text":"Action semantics","level":2,"anchor":"Action-semantics"},{"type":"table","rows":[[[{"inlineContent":[{"text":"Action","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Effect on state"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Returned effect"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".fetch"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"if the cache is fresh ("},{"type":"codeVoice","code":"Date() - lastFetch < cacheLifetime"},{"type":"text","text":" AND "},{"type":"codeVoice","code":"loadCached()"},{"type":"text","text":" is non-nil), evaluates the cached config and dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" without hitting the network; otherwise behaves like "},{"type":"codeVoice","code":".forceFetch"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".forceFetch"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"calls "},{"type":"codeVoice","code":"service.fetch()"},{"type":"text","text":", persists the result via "},{"type":"codeVoice","code":"service.saveCached(_:)"},{"type":"text","text":", dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":". On thrown error, falls back to "},{"type":"codeVoice","code":"service.loadCached()"},{"type":"text","text":" if available — dispatching "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from the cache "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed(message)"},{"type":"text","text":" so the UI can surface the error while keeping a usable verdict"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".verdictReceived(verdict, fromNetwork:)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"sets "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"fetchError"},{"type":"text","text":"; sets "},{"type":"codeVoice","code":"lastFetch = Date()"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"only when "},{"type":"codeVoice","code":"fromNetwork"},{"type":"text","text":" is true"}]},{"type":"text","text":" — a cache-served verdict must not slide the freshness window, or a session polling "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":" inside "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":" would never consult the network again"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetchFailed(message)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"sets "},{"type":"codeVoice","code":"fetchError = message"},{"type":"text","text":" (does not clear "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":" or "},{"type":"codeVoice","code":"lastFetch"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".openUpdateURL"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}],[{"type":"paragraph","inlineContent":[{"text":"if ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" with a non-nil ","type":"text"},{"code":"updateURL","type":"codeVoice"},{"text":" whose scheme is ","type":"text"},{"code":"https","type":"codeVoice"},{"text":", ","type":"text"},{"code":"itms-apps","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"macappstore","type":"codeVoice"},{"text":", calls the plugin’s ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" closure; otherwise no effect (the URL comes from remote config, so arbitrary schemes are never opened)","type":"text"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"The plugin only handles its own actions. Any action that ","type":"text"},{"type":"codeVoice","code":"extractAction"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" for is ignored — the plugin’s ","type":"text"},{"type":"codeVoice","code":"reduce(...)"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" immediately.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The combination of "},{"code":".forceFetch","type":"codeVoice"},{"type":"text","text":"’s cached-fallback behavior and "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator ("},{"code":"fetchError","type":"codeVoice"},{"type":"text","text":"), without leaving the UI stuck on "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":".verdictReceived"},{"text":" is dispatched on every ","type":"text"},{"type":"codeVoice","code":".fetch"},{"text":"\/","type":"text"},{"type":"codeVoice","code":".forceFetch"},{"text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing ","type":