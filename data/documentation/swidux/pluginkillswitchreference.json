a launch on a flaky network still yields a verdict (cached) and an error indicator ("},{"code":"fetchError","type":"codeVoice"},{"type":"text","text":"), without leaving the UI stuck on "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":"."}]},{"anchor":"Verdict-evaluation-rules","type":"heading","level":2,"text":"Verdict evaluation rules"},{"type":"paragraph","inlineContent":[{"code":"KillswitchVerdict.evaluate(_:against:)","type":"codeVoice"},{"type":"text","text":" is fail-open: any unparseable input yields "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":". Checks run in this fixed order, returning "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":" on the first match:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Current version parse.","type":"text"}],"type":"strong"},{"type":"text","text":" If "},{"code":"currentVersionString","type":"codeVoice"},{"text":" cannot be parsed as a ","type":"text"},{"code":"SemanticVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" immediately."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Minimum supported version.","type":"text"}],"type":"strong"},{"text":" If ","type":"text"},{"code":"config.minimumSupportedVersion","type":"codeVoice"},{"text":" parses and ","type":"text"},{"code":"currentVersion < minVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Explicit blocked versions."}],"type":"strong"},{"type":"text","text":" Iterate "},{"code":"config.blockedVersions","type":"codeVoice"},{"type":"text","text":". If any entry parses and equals "},{"code":"currentVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".blocked(...)","type":