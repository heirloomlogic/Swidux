{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"kind":"article","primaryContentSections":[{"content":[{"anchor":"Library-target","type":"heading","text":"Library target","level":2},{"inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" ships as its own product in the ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":" package. Add it to a target’s dependencies in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":" and import it where you wire the plugin:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiduxKillswitch"]},{"inlineContent":[{"type":"text","text":"The target depends on "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" and links against "},{"type":"codeVoice","code":"UIKit"},{"type":"text","text":" on iOS \/ "},{"type":"codeVoice","code":"AppKit"},{"type":"text","text":" on macOS for the default URL-opening behavior."}],"type":"paragraph"},{"anchor":"Types","type":"heading","text":"Types","level":2},{"anchor":"KillswitchPlugin","type":"heading","text":"KillswitchPlugin","level":3},{"inlineContent":[{"type":"text","text":"The domain plugin. Conforms to "},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" and is generic over the host app’s root state and action types."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@MainActor","public struct KillswitchPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, KillswitchState>,","        action toRootAction: @escaping @Sendable (KillswitchAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> KillswitchAction?,","        service: KillswitchService,","        appVersion: @escaping @Sendable () -> String,","        openURL: @escaping @Sendable (URL) async -> Void = { \/* UIApplication \/ NSWorkspace *\/ }","    )","}"]},{"inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"UIApplication.shared.open(_:)"},{"text":" on iOS and ","type":"text"},{"type":"codeVoice","code":"NSWorkspace.shared.open(_:)"},{"type":"text","text":" on macOS, both hopped to "},{"code":"MainActor","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"KillswitchState","type":"heading","anchor":"KillswitchState"},{"inlineContent":[{"type":"text","text":"The state slice the plugin owns. Default-constructed values match a fresh, never-fetched session."}],"type":"paragraph"},{"type":"codeListing","code":["public struct KillswitchState: Sendable, Equatable {","    public var verdict: KillswitchVerdict   \/\/ defaults to .unknown","    public var lastFetch: Date?             \/\/ nil until first successful fetch","    public var fetchError: String?          \/\/ localized description of last failure","","    public var isBlocked: Bool              \/\/ delegates to verdict.isBlocked","    public var canOpenUpdateURL: Bool       \/\/ .blocked AND updateURL is non-nil","","    public init(","        verdict: KillswitchVerdict = .unknown,","        lastFetch: Date? = nil,","        fetchError: String? = nil","    )","}"],"syntax":"swift"},{"inlineContent":[{"code":"isBlocked","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":" are convenience computed properties. Bind UI off them rather than pattern-matching ","type":"text"},{"type":"codeVoice","code":"verdict"},{"text":" everywhere.","type":"text"}],"type":"paragraph"},{"level":3,"text":"KillswitchAction","type":"heading","anchor":"KillswitchAction"},{"inlineContent":[{"type":"text","text":"The plugin’s local action enum. Wrap these in your root action through the case you provide at registration."}],"type":"paragraph"},{"syntax":"swift","code":["public enum KillswitchAction: Sendable {","    case fetch","    case forceFetch","    case verdictReceived(KillswitchVerdict)","    case fetchFailed(String)","    case openUpdateURL","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":".fetch"},{"type":"text","text":" is the launch-time entry point — it consults the cache and skips the network when the cached config is fresh. "},{"type":"codeVoice","code":".forceFetch"},{"type":"text","text":" always hits the network, suitable for pull-to-refresh or post-update health checks."}],"type":"paragraph"},{"level":3,"text":"KillswitchService","type":"heading","anchor":"KillswitchService"},{"inlineContent":[{"type":"text","text":"A closure-based service that fetches and caches the remote config. Substitute the live factory in production and the mock factory in tests."}],"type":"paragraph"},{"syntax":"swift","code":["public struct KillswitchService: Sendable {","    public var fetch: @Sendable () async throws -> KillswitchConfig","    public var loadCached: @Sendable () -> KillswitchConfig?","    public var saveCached: @Sendable (KillswitchConfig) -> Void","    public let cacheLifetime: TimeInterval","","    public init(","        fetch: @escaping @Sendable () async throws -> KillswitchConfig,","        loadCached: @escaping @Sendable () -> KillswitchConfig?,","        saveCached: @escaping @Sendable (KillswitchConfig) -> Void,","        cacheLifetime: TimeInterval","    )","","    public static func live(","        endpoint: URL,","        fetchTimeout: TimeInterval = 10,","        cacheLifetime: TimeInterval = 3600,","        session: URLSession = .shared","    ) -> KillswitchService","","    public static func mock(","        result: @escaping @Sendable () async throws -> KillswitchConfig = { KillswitchConfig() },","        cached: KillswitchConfig? = nil,","        cacheLifetime: TimeInterval = 3600","    ) -> KillswitchService","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"live(endpoint:)"},{"type":"text","text":" decodes JSON from "},{"type":"codeVoice","code":"endpoint"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"reloadIgnoringLocalCacheData"},{"type":"text","text":" policy and persists the result to a "},{"type":"codeVoice","code":"swidux-killswitch.json"},{"type":"text","text":" file in the user’s caches directory. "},{"type":"codeVoice","code":"mock(result:cached:)"},{"type":"text","text":" keeps an in-memory cache and lets a test inject a closure that returns or throws."}],"type":"paragraph"},{"level":3,"text":"KillswitchConfig","type":"heading","anchor":"KillswitchConfig"},{"inlineContent":[{"type":"text","text":"The decoded shape of the remote JSON. All fields are optional — a config with every field "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" evaluates to "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["public struct KillswitchConfig: Codable, Sendable, Equatable {","    public var minimumSupportedVersion: String?","    public var blockedVersions: [String]?","    public var blockedRanges: [String]?","    public var blockedTitle: String?","    public var blockedMessage: String?","    public var updateURL: String?","","    public init(","        minimumSupportedVersion: String? = nil,","        blockedVersions: [String]? = nil,","        blockedRanges: [String]? = nil,","        blockedTitle: String? = nil,","        blockedMessage: String? = nil,","        updateURL: String? = nil","    )","}"],"type":"codeListing"},{"level":3,"text":"KillswitchVerdict","type":"heading","anchor":"KillswitchVerdict"},{"inlineContent":[{"type":"text","text":"The result of evaluating a config against the running version."}],"type":"paragraph"},{"syntax":"swift","code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":".unknown"},{"type":"text","text":" is the initial state before any fetch has been attempted. "},{"type":"codeVoice","code":"evaluate(_:against:)"},{"type":"text","text":" always returns "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" or "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":" — never "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":". "},{"type":"codeVoice","code":"isBlocked"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" only for the "},{"type":"codeVoice","code":".blocked"},{"type":"text","text":" case."}],"type":"paragraph"},{"level":3,"text":"SemanticVersion","type":"heading","anchor":"SemanticVersion"},{"inlineContent":[{"type":"text","text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests."}],"type":"paragraph"},{"syntax":"swift","code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The string initializer accepts "},{"type":"codeVoice","code":"\"1.2.3\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"1.2.3-beta.1\""},{"type":"text","text":", and "},{"type":"codeVoice","code":"\"1.2.3-beta.1+build42\""},{"type":"text","text":". Build metadata after "},{"type":"codeVoice","code":"+"},{"type":"text","text":" is parsed and discarded. Malformed input returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric."}],"type":"paragraph"},{"level":3,"text":"VersionRange","type":"heading","anchor":"VersionRange"},{"inlineContent":[{"type":"text","text":"A half-open range "},{"type":"codeVoice","code":"[lowerBound, upperBound)"},{"type":"text","text":" of semantic versions, used to express "},{"type":"codeVoice","code":"blockedRanges"},{"type":"text","text":" entries."}],"type":"paragraph"},{"syntax":"swift","code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Both initializers fail and return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed."}],"type":"paragraph"},{"level":2,"text":"Action semantics","type":"heading","anchor":"Action-semantics"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Effect on state"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Returned effect"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".fetch"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"if the cache is fresh ("},{"type":"codeVoice","code":"Date() - lastFetch < cacheLifetime"},{"type":"text","text":" AND "},{"type":"codeVoice","code":"loadCached()"},{"type":"text","text":" is non-nil), evaluates the cached config and dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" without hitting the network; otherwise behaves like "},{"type":"codeVoice","code":".forceFetch"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".forceFetch"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"calls "},{"type":"codeVoice","code":"service.fetch()"},{"type":"text","text":", persists the result via "},{"type":"codeVoice","code":"service.saveCached(_:)"},{"type":"text","text":", dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":". On thrown error, falls back to "},{"type":"codeVoice","code":"service.loadCached()"},{"type":"text","text":" if available — dispatching "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from the cache "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed(message)"},{"type":"text","text":" so the UI can surface the error while keeping a usable verdict"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".verdictReceived(verdict)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"sets "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":", sets "},{"code":"lastFetch = Date()","type":"codeVoice"},{"type":"text","text":", clears "},{"code":"fetchError","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".fetchFailed(message)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"sets "},{"code":"fetchError = message","type":"codeVoice"},{"type":"text","text":" (does not clear "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":" or "},{"code":"lastFetch","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".openUpdateURL","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"if "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":" is "},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" with a non-nil "},{"code":"updateURL","type":"codeVoice"},{"type":"text","text":", calls the plugin’s "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" closure; otherwise no effect"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"The plugin only handles its own actions. Any action that "},{"type":"codeVoice","code":"extractAction"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for is ignored — the plugin’s "},{"type":"codeVoice","code":"reduce(...)"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" immediately."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The combination of "},{"type":"codeVoice","code":".forceFetch"},{"type":"text","text":"’s cached-fallback behavior and "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator ("},{"type":"codeVoice","code":"fetchError"},{"type":"text","text":"), without leaving the UI stuck on "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Verdict evaluation rules","type":"heading","anchor":"Verdict-evaluation-rules"},{"inlineContent":[{"type":"codeVoice","code":"KillswitchVerdict.evaluate(_:against:)"},{"type":"text","text":" is fail-open: any unparseable input yields "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":". Checks run in this fixed order, returning "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":" on the first match:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Current version parse.","type":"text"}],"type":"strong"},{"text":" If ","type":"text"},{"code":"currentVersionString","type":"codeVoice"},{"text":" cannot be parsed as a ","type":"text"},{"code":"SemanticVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" immediately.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Minimum supported version.","type":"text"}],"type":"strong"},{"text":" If ","type":"text"},{"code":"config.minimumSupportedVersion","type":"codeVoice"},{"text":" parses and ","type":"text"},{"code":"currentVersion < minVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Explicit blocked versions.","type":"text"}],"type":"strong"},{"text":" Iterate ","type":"text"},{"code":"config.blockedVersions","type":"codeVoice"},{"text":". If any entry parses and equals ","type":"text"},{"code":"currentVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Blocked ranges.","type":"text"}],"type":"strong"},{"text":" Iterate ","type":"text"},{"code":"config.blockedRanges","type":"codeVoice"},{"text":". If any entry parses as a ","type":"text"},{"code":"VersionRange","type":"codeVoice"},{"text":" and contains ","type":"text"},{"code":"currentVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Otherwise","type":"text"}],"type":"strong"},{"text":" return ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"A blocked verdict carries the config’s "},{"type":"codeVoice","code":"blockedTitle"},{"type":"text","text":", "},{"type":"codeVoice","code":"blockedMessage"},{"type":"text","text":", and "},{"type":"codeVoice","code":"updateURL"},{"type":"text","text":" (parsed via "},{"type":"codeVoice","code":"URL(string:)"},{"type":"text","text":") regardless of which check matched."}],"type":"paragraph"},{"level":2,"text":"Remote config JSON shape","type":"heading","anchor":"Remote-config-JSON-shape"},{"inlineContent":[{"type":"codeVoice","code":"KillswitchConfig"},{"type":"text","text":" derives its "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance from synthesized keys, so the JSON keys match the property names. A representative file:"}],"type":"paragraph"},{"syntax":"json","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.3.0\", \"1.3.1\"],","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update Required\",","    \"blockedMessage\": \"Please update to continue using the app.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every field is optional. An empty object "},{"type":"codeVoice","code":"{}"},{"type":"text","text":" is valid and evaluates to "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" for any version."}],"type":"paragraph"},{"level":2,"text":"View modifier: `killswitchBlocker`","type":"heading","anchor":"View-modifier-killswitchBlocker"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" ships a SwiftUI view modifier that overlays a non-dismissible blocker whenever the verdict is "},{"type":"codeVoice","code":".blocked"},{"type":"text","text":" and disables the underlying content while it is. Two overloads:"}],"type":"paragraph"},{"syntax":"swift","code":["extension View {","    \/\/\/ Default blocker — full-screen ultraThinMaterial with title, message,","    \/\/\/ and an optional Update button.","    public func killswitchBlocker(","        verdict: KillswitchVerdict,","        onUpdate: (() -> Void)? = nil","    ) -> some View","","    \/\/\/ Custom blocker — receives the title, message, and `hasUpdateURL`","    \/\/\/ flag and renders whatever you return.","    public func killswitchBlocker<Blocker: View>(","        verdict: KillswitchVerdict,","        @ViewBuilder blocker: @escaping (","            _ title: String?,","            _ message: String?,","            _ hasUpdateURL: Bool","        ) -> Blocker","    ) -> some View","}"],"type":"codeListing"},{"inlineContent":[{"text":"Both overloads apply ","type":"text"},{"code":".disabled(verdict.isBlocked)","type":"codeVoice"},{"text":" to the modified content, so the underlying view tree stops responding to touches while blocked. The blocker layer is rendered as an overlay; supply your own to match the host app’s design system.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"seeAlsoSections":[{"title":"Related Documentation","identi