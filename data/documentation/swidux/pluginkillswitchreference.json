{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Library target","anchor":"Library-target","level":2},{"type":"paragraph","inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" ships as its own product in the "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":" package. Add it to a target’s dependencies in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":" and import it where you wire the plugin:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxKillswitch"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The target depends on "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":" and links against "},{"code":"UIKit","type":"codeVoice"},{"type":"text","text":" on iOS \/ "},{"code":"AppKit","type":"codeVoice"},{"type":"text","text":" on macOS for the default URL-opening behavior."}]},{"anchor":"Types","type":"heading","text":"Types","level":2},{"anchor":"KillswitchPlugin","type":"heading","text":"KillswitchPlugin","level":3},{"inlineContent":[{"type":"text","text":"The domain plugin. Conforms to "},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" and is generic over the host app’s root state and action types."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@MainActor","public struct KillswitchPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, KillswitchState>,","        action toRootAction: @escaping @Sendable (KillswitchAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> KillswitchAction?,","        service: KillswitchService,","        appVersion: @escaping @Sendable () -> String,","        openURL: @escaping @Sendable (URL) async -> Void = { \/* UIApplication \/ NSWorkspace *\/ }","    )","}"]},{"type":"paragraph","inlineContent":[{"text":"The default ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" calls ","type":"text"},{"type":"codeVoice","code":"UIApplication.shared.open(_:)"},{"text":" on iOS and ","type":"text"},{"type":"codeVoice","code":"NSWorkspace.shared.open(_:)"},{"text":" on macOS, both hopped to ","type":"text"},{"type":"codeVoice","code":"MainActor"},{"text":".","type":"text"}]},{"type":"heading","text":"KillswitchState","anchor":"KillswitchState","level":3},{"type":"paragraph","inlineContent":[{"text":"The state slice the plugin owns. Default-constructed values match a fresh, never-fetched session.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct KillswitchState: Sendable, Equatable {","    public var verdict: KillswitchVerdict   \/\/ defaults to .unknown","    public var lastFetch: Date?             \/\/ nil until first successful fetch","    public var fetchError: String?          \/\/ localized description of last failure","","    public var isBlocked: Bool              \/\/ delegates to verdict.isBlocked","    public var canOpenUpdateURL: Bool       \/\/ .blocked AND updateURL is non-nil","","    public init(","        verdict: KillswitchVerdict = .unknown,","        lastFetch: Date? = nil,","        fetchError: String? = nil","    )","}"]},{"type":"paragraph","inlineContent":[{"code":"isBlocked","type":"codeVoice"},{"type":"text","text":" and "},{"code":"canOpenUpdateURL","type":"codeVoice"},{"text":" are convenience computed properties. Bind UI off them rather than pattern-matching ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" everywhere.","type":"text"}]},{"type":"heading","text":"KillswitchAction","anchor":"KillswitchAction","level":3},{"type":"paragraph","inlineContent":[{"text":"The plugin’s local action enum. Wrap these in your root action through the case you provide at registration.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public enum KillswitchAction: Sendable {","    case fetch","    case forceFetch","    case verdictReceived(KillswitchVerdict, fromNetwork: Bool)","    case fetchFailed(String)","    case openUpdateURL","}"]},{"inlineContent":[{"type":"codeVoice","code":".fetch"},{"type":"text","text":" is the launch-time entry point — it consults the cache and skips the network when the cached config is fresh. "},{"code":".forceFetch","type":"codeVoice"},{"type":"text","text":" always hits the network, suitable for pull-to-refresh or post-update health checks."}],"type":"paragraph"},{"text":"KillswitchService","anchor":"KillswitchService","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"A closure-based service that fetches and caches the remote config. Substitute the live factory in production and the mock factory in tests."}],"type":"paragraph"},{"code":["public struct KillswitchService: Sendable {","    public var fetch: @Sendable () async throws -> KillswitchConfig","    public var loadCached: @Sendable () -> KillswitchConfig?","    public var saveCached: @Sendable (KillswitchConfig) -> Void","    public let cacheLifetime: TimeInterval","","    public init(","        fetch: @escaping @Sendable () async throws -> KillswitchConfig,","        loadCached: @escaping @Sendable () -> KillswitchConfig?,","        saveCached: @escaping @Sendable (KillswitchConfig) -> Void,","        cacheLifetime: TimeInterval","    )","","    public static func live(","        endpoint: URL,","        fetchTimeout: TimeInterval = 10,","        cacheLifetime: TimeInterval = 3600,","        session: URLSession = .shared","    ) -> KillswitchService","","    public static func mock(","        result: @escaping @Sendable () async throws -> KillswitchConfig = { KillswitchConfig() },","        cached: KillswitchConfig? = nil,","        cacheLifetime: TimeInterval = 3600","    ) -> KillswitchService","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"live(endpoint:)","type":"codeVoice"},{"text":" decodes JSON from ","type":"text"},{"type":"codeVoice","code":"endpoint"},{"type":"text","text":" with a "},{"code":"reloadIgnoringLocalCacheData","type":"codeVoice"},{"type":"text","text":" policy and persists the result to a "},{"code":"swidux-killswitch.json","type":"codeVoice"},{"type":"text","text":" file in the user’s caches directory. "},{"code":"mock(result:cached:)","type":"codeVoice"},{"type":"text","text":" keeps an in-memory cache and lets a test inject a closure that returns or throws."}],"type":"paragraph"},{"inlineContent":[{"text":"The endpoint must be ","type":"text"},{"inlineContent":[{"type":"text","text":"HTTPS"}],"type":"strong"},{"type":"text","text":" ("},{"code":"http","type":"codeVoice"},{"type":"text","text":" is allowed only for "},{"code":"localhost","type":"codeVoice"},{"type":"text","text":" development servers; anything else is a precondition failure) — the killswitch is a remote control channel and must not be tamperable in transit. Non-2xx responses and payloads over 1 MB are treated as fetch failures, which fall back to the cache (and ultimately fail open)."}],"type":"paragraph"},{"text":"KillswitchConfig","anchor":"KillswitchConfig","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The decoded shape of the remote JSON. All fields are optional — a config with every field "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" evaluates to "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["public struct KillswitchConfig: Codable, Sendable, Equatable {","    public var minimumSupportedVersion: String?","    public var blockedVersions: [String]?","    public var blockedRanges: [String]?","    public var blockedTitle: String?","    public var blockedMessage: String?","    public var updateURL: String?","","    public init(","        minimumSupportedVersion: String? = nil,","        blockedVersions: [String]? = nil,","        blockedRanges: [String]? = nil,","        blockedTitle: String? = nil,","        blockedMessage: String? = nil,","        updateURL: String? = nil","    )","}"],"syntax":"swift","type":"codeListing"},{"text":"KillswitchVerdict","anchor":"KillswitchVerdict","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The result of evaluating a config against the running version."}],"type":"paragraph"},{"code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":".unknown","type":"codeVoice"},{"type":"text","text":" is the initial state before any fetch has been attempted. "},{"code":"evaluate(_:against:)","type":"codeVoice"},{"type":"text","text":" always returns "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" or "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":" — never "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":". "},{"code":"isBlocked","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" only for the "},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" case."}],"type":"paragraph"},{"text":"SemanticVersion","anchor":"SemanticVersion","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests."}],"type":"paragraph"},{"code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The string initializer accepts "},{"code":"\"1.2.3\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"1.2.3-beta.1\"","type":"codeVoice"},{"type":"text","text":", and "},{"code":"\"1.2.3-beta.1+build42\"","type":"codeVoice"},{"type":"text","text":". Build metadata after "},{"code":"+","type":"codeVoice"},{"type":"text","text":" is parsed and discarded. Malformed input returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric."}],"type":"paragraph"},{"text":"VersionRange","anchor":"VersionRange","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"A half-open range "},{"code":"[lowerBound, upperBound)","type":"codeVoice"},{"type":"text","text":" of semantic versions, used to express "},{"code":"blockedRanges","type":"codeVoice"},{"type":"text","text":" entries."}],"type":"paragraph"},{"code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Both initializers fail and return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed."}],"type":"paragraph"},{"level":2,"anchor":"Action-semantics","type":"heading","text":"Action semantics"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Effect on state"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Returned effect"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".fetch"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"if the cache is fresh (","type":"text"},{"code":"Date() - lastFetch < cacheLifetime","type":"codeVoice"},{"text":" AND ","type":"text"},{"code":"loadCached()","type":"codeVoice"},{"text":" is non-nil), evaluates the cached config and dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" without hitting the network; otherwise behaves like ","type":"text"},{"code":".forceFetch","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".forceFetch"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"calls "},{"code":"service.fetch()","type":"codeVoice"},{"text":", persists the result via ","type":"text"},{"code":"service.saveCached(_:)","type":"codeVoice"},{"text":", dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":". On thrown error, falls back to ","type":"text"},{"code":"service.loadCached()","type":"codeVoice"},{"text":" if available — dispatching ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from the cache ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":".fetchFailed(message)","type":"codeVoice"},{"text":" so the UI can surface the error while keeping a usable verdict","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".verdictReceived(verdict, fromNetwork:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"sets ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":", clears ","type":"text"},{"code":"fetchError","type":"codeVoice"},{"text":"; sets ","type":"text"},{"code":"lastFetch = Date()","type":"codeVoice"},{"text":" ","type":"text"},{"inlineContent":[{"text":"only when ","type":"text"},{"type":"codeVoice","code":"fromNetwork"},{"text":" is true","type":"text"}],"type":"strong"},{"text":" — a cache-served verdict must not slide the freshness window, or a session polling ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":" inside ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":" would never consult the network again","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}]],[[{"inlineContent":[{"code":".fetchFailed(message)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"sets "},{"code":"fetchError = message","type":"codeVoice"},{"type":"text","text":" (does not clear "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":" or "},{"code":"lastFetch","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".openUpdateURL","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"if ","type":"text"},{"type":"codeVoice","code":"verdict"},{"text":" is ","type":"text"},{"type":"codeVoice","code":".blocked"},{"text":" with a non-nil ","type":"text"},{"type":"codeVoice","code":"updateURL"},{"text":" whose scheme is ","type":"text"},{"type":"codeVoice","code":"https"},{"text":", ","type":"text"},{"type":"codeVoice","code":"itms-apps"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"macappstore"},{"text":", calls the plugin’s ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" closure; otherwise no effect (the URL comes from remote config, so arbitrary schemes are never opened)","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"The plugin only handles its own actions. Any action that ","type":"text"},{"code":"extractAction","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for is ignored — the plugin’s ","type":"text"},{"code":"reduce(...)","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" immediately.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The combination of ","type":"text"},{"type":"codeVoice","code":".forceFetch"},{"text":"’s cached-fallback behavior and ","type":"text"},{"type":"codeVoice","code":".fetch"},{"text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator (","type":"text"},{"code":"fetchError","type":"codeVoice"},{"text":"), without leaving the UI stuck on ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":""},{"code":".verdictReceived","type":"codeVoice"},{"type":"text","text":" is dispatched on every "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":"\/"},{"code":".forceFetch","type":"codeVoice"},{"type":"text","text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing "},{"code":"KillswitchState","type":"codeVoice"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside"},{"level":2,"anchor":"Verdict-evaluation-rules","type":"heading","text":"Verdict evaluation rules"},{"inlineContent":[{"type":"codeVoice","code":"KillswitchVerdict.evaluate(_:against:)"},{"text":" is fail-open: any unparseable input yields ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":". Checks run in this fixed order, returning ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"text":" on the first match:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Current version parse."}],"type":"strong"},{"text":" If ","type":"text"},{"code":"currentVersionString","type":"codeVoice"},{"text":" cannot be parsed as a ","type":"text"},{"code":"SemanticVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" immediately.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Minimum supported version."}],"type":"strong"},{"text":" If ","type":"text"},{"code":"config.minimumSupportedVersion","type":"codeVoice"},{"text":" parses and ","type":"text"},{"code":"currentVersion < minVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Explicit blocked versions."}],"type":"strong"},{"text":" Iterate ","type":"text"},{"code":"config.blockedVersions","type":"codeVoice"},{"text":". If any entry parses and equals ","type":"text"},{"code":"currentVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Blocked ranges."}],"type":"strong"},{"text":" Iterate ","type":"text"},{"code":"config.blockedRanges","type":"codeVoice"},{"text":". If any entry parses as a ","type":"text"},{"code":"VersionRange","type":"codeVoice"},{"text":" and contains ","type":"text"},{"code":"currentVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Otherwise"}],"type":"strong"},{"text":" return ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"A blocked verdict carries the config’s "},{"code":"blockedTitle","type":"codeVoice"},{"type":"text","text":", "},{"code":"blockedMessage","type":"codeVoice"},{"type":"text","text":", and "},{"code":"updateURL","type":"codeVoice"},{"type":"text","text":" (parsed via "},{"code":"URL(string:)","type":"codeVoice"},{"type":"text","text":") regardless of which check matched."}],"type":"paragraph"},{"level":2,"anchor":"Remote-config-JSON-shape","type":"heading","text":"Remote config JSON shape"},{"inlineContent":[{"code":"KillswitchConfig","type":"codeVoice"},{"type":"text","text":" derives its "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance from synthesized keys, so the JSON keys match the property names. A representative file:"}],"type":"paragraph"},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.3.0\", \"1.3.1\"],","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update Required\",","    \"blockedMessage\": \"Please update to continue using the app.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"type":"text","text":"Every field is optional. An empty object "},{"code":"{}","type":"codeVoice"},{"type":"text","text":" is valid and evaluates to "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" for any version."}],"type":"paragraph"},{"level":2,"anchor":"View-modifier-killswitchBlocker","type":"heading","text":"View modifier: `killswitchBlocker`"},{"inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" ships a SwiftUI view modifier that overlays a non-dismissible blocker whenever the verdict is "},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" and disables the underlying content while it is. Two overloads:"}],"type":"paragraph"},{"code":["extension View {","    \/\/\/ Default blocker — full-screen ultraThinMaterial with title, message,","    \/\/\/ and an optional Update button.","    public func killswitchBlocker(","        verdict: KillswitchVerdict,","        onUpdate: (() -> Void)? = nil","    ) -> some View","","    \/\/\/ Custom blocker — receives the title, message, and `hasUpdateURL`","    \/\/\/ flag and renders whatever you return.","    public func killswitchBlocker<Blocker: View>(","        verdict: KillswitchVerdict,","        @ViewBuilder blocker: @escaping (","            _ title: String?,","            _ message: String?,","            _ hasUpdateURL: Bool","        ) -> Blocker","    ) -> some View","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Both overloads apply "},{"code":".disabled(verdict.isBlocked)","type":"codeVoice"},{"type":"text","text":" to the modified content, so the underlying view tree stops responding to touches while blocked. The blocker layer is rendered as an overlay; supply your own to match the host app’s design system."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/p