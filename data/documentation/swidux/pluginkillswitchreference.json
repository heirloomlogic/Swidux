"codeVoice","code":"http"},{"type":"text","text":" is allowed only for "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":" development servers; anything else is a precondition failure) — the killswitch is a remote control channel and must not be tamperable in transit. Non-2xx responses and payloads over 1 MB are treated as fetch failures, which fall back to the cache (and ultimately fail open)."}],"type":"paragraph"},{"text":"KillswitchConfig","anchor":"KillswitchConfig","level":3,"type":"heading"},{"inlineContent":[{"text":"The decoded shape of the remote JSON. All fields are optional — a config with every field ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" evaluates to ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["public struct KillswitchConfig: Codable, Sendable, Equatable {","    public var minimumSupportedVersion: String?","    public var blockedVersions: [String]?","    public var blockedRanges: [String]?","    public var blockedTitle: String?","    public var blockedMessage: String?","    public var updateURL: String?","","    public init(","        minimumSupportedVersion: String? = nil,","        blockedVersions: [String]? = nil,","        blockedRanges: [String]? = nil,","        blockedTitle: String? = nil,","        blockedMessage: String? = nil,","        updateURL: String? = nil","    )","}"],"syntax":"swift","type":"codeListing"},{"text":"KillswitchVerdict","anchor":"KillswitchVerdict","level":3,"type":"heading"},{"inlineContent":[{"text":"The result of evaluating a config against the running version.","type":"text"}],"type":"paragraph"},{"code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":".unknown"},{"type":"text","text":" is the initial state before any fetch has been attempted. "},{"type":"codeVoice","code":"evaluate(_:against:)"},{"type":"text","text":" always returns "},{"type":"codeVoice","code":".allowed"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":" — never "},{"type":"codeVoice","code":".unknown"},{"text":". ","type":"text"},{"type":"codeVoice","code":"isBlocked"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" only for the ","type":"text"},{"type":"codeVoice","code":".blocked"},{"text":" case.","type":"text"}],"type":"paragraph"},{"text":"SemanticVersion","type":"heading","anchor":"SemanticVersion","level":3},{"type":"paragraph","inlineContent":[{"text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The string initializer accepts ","type":"text"},{"code":"\"1.2.3\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"1.2.3-beta.1\"","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"\"1.2.3-beta.1+build42\"","type":"codeVoice"},{"text":". Build metadata after ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" is parsed and discarded. Malformed input returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric."}]},{"text":"VersionRange","type":"heading","anchor":"VersionRange","level":3},{"type":"paragraph","inlineContent":[{"text":"A half-open range ","type":"text"},{"code":"[lowerBound, upperBound)","type":"codeVoice"},{"type":"text","text":" of semantic versions, used to express "},{"type":"codeVoice","code":"blockedRanges"},{"type":"text","text":" entries."}]},{"syntax":"swift","type":"codeListing","code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"]},{"type":"paragraph","inlineContent":[{"text":"Both initializers fail and return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed.","type":"text"}]},{"type":"heading","level":2,"text":"Action semantics","anchor":"Action-semantics"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Effect on state","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned effect"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}],[{"type":"paragraph","inlineContent":[{"text":"if the cache is fresh (","type":"text"},{"code":"Date() - lastFetch < cacheLifetime","type":"codeVoice"},{"text":" AND ","type":"text"},{"code":"loadCached()","type":"codeVoice"},{"text":" is non-nil), evaluates the cached config and dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" without hitting the network; otherwise behaves like ","type":"text"},{"code":".forceFetch","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".forceFetch"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"calls ","type":"text"},{"type":"codeVoice","code":"service.fetch()"},{"text":", persists the result via ","type":"text"},{"type":"codeVoice","code":"service.saveCached(_:)"},{"text":", dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":". On thrown error, falls back to ","type":"text"},{"type":"codeVoice","code":"service.loadCached()"},{"text":" if available — dispatching ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" from the cache ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":".fetchFailed(message)"},{"text":" so the UI can surface the error while keeping a usable verdict","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".verdictReceived(verdict, fromNetwork:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"sets "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"fetchError"},{"type":"text","text":"; sets "},{"type":"codeVoice","code":"lastFetch = Date()"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"only when "},{"type":"codeVoice","code":"fromNetwork"},{"type":"text","text":" is true"}]},{"type":"text","text":" — a cache-served verdict must not slide the freshness window, or a session polling "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":" inside "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":" would never consult the network again"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".fetchFailed(message)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"sets ","type":"text"},{"code":"fetchError = message","type":"codeVoice"},{"text":" (does not clear ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"lastFetch","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".openUpdateURL"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}],[{"type":"paragraph","inlineContent":[{"text":"if ","type":"text"},{"type":"codeVoice","code":"verdict"},{"text":" is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" with a non-nil ","type":"text"},{"code":"updateURL","type":"codeVoice"},{"text":" whose scheme is ","type":"text"},{"code":"https","type":"codeVoice"},{"text":", ","type":"text"},{"code":"itms-apps","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"macappstore","type":"codeVoice"},{"text":", calls the plugin’s ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" closure; otherwise no effect (the URL comes from remote config, so arbitrary schemes are never opened)","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The plugin only handles its own actions. Any action that ","type":"text"},{"code":"extractAction","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for is ignored — the plugin’s ","type":"text"},{"code":"reduce(...)","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" immediately.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The combination of ","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":"’s cached-fallback behavior and ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator (","type":"text"},{"code":"fetchError","type":"codeVoice"},{"text":"), without leaving the UI stuck on ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":".","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":""},{"code":".verdictReceived","type":"codeVoice"},{"type":"text","text":" is dispatched on every "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":"\/"},{"type":"codeVoice","code":".forceFetch"},{"type":"text","text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing "},{"type":"codeVoice","code":"KillswitchState"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"},{"type":"heading","text":"Verdict evaluation rules","anchor":"Verdict-evaluation-rules","level":2},{"inlineContent":[{"type":"codeVoice","code":"KillswitchVerdict.evaluate(_:against:)"},{"type":"text","text":" is fail-open: any unparseable input yields "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":". Checks run in this fixed order, returning "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":" on the first match:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Current version parse.","type":"text"}],"type":"strong"},{"type":"text","text":" If "},{"code":"currentVersionString","type":"codeVoice"},{"type":"text","text":" cannot be parsed as a "},{"code":"SemanticVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" immediately."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Minimum supported version."}]},{"text":" If ","type":"text"},{"code":"config.minimumSupportedVersion","type":"codeVoice"},{"text":" parses and ","type":"text"},{"type":"codeVoice","code":"currentVersion < minVersion"},{"text":", return ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Explicit blocked versions.","type":"text"}],"type":"strong"},{"text":" Iterate ","type":"text"},{"code":"config.blockedVersions","type":"codeVoice"},{"text":". If any entry parses and equals ","type":"text"},{"code":"currentVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Blocked ranges.","type":"text"}],"type":"strong"},{"text":" Iterate ","type":"text"},{"code":"config.blockedRanges","type":"codeVoice"},{"text":". If any entry parses as a ","type":"text"},{"code":"VersionRange","type":"codeVoice"},{"text":" and contains ","type":"text"},{"code":"currentVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Otherwise","type":"text"}]},{"type":"text","text":" return "},{"code":".allowed","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"A blocked verdict carries the config’s ","type":"text"},{"code":"blockedTitle","type":"codeVoice"},{"text":", ","type":"text"},{"code":"blockedMessage","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"updateURL","type":"codeVoice"},{"text":" (parsed via ","type":"text"},{"code":"URL(string:)","type":"codeVoice"},{"text":") regardless of which check matched.","type":"text"}],"type":"paragraph"},{"anchor":"Remote-config-JSON-shape","type":"heading","level":2,"text":"Remote config JSON shape"},{"type":"paragraph","inlineContent":[{"code":"KillswitchConfig","type":"codeVoice"},{"text":" derives its ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformance from synthesized keys, so the JSON keys match the property names. A representative file:","type":"text"}]},{"type":"codeListing","syntax":"json","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.3.0\", \"1.3.1\"],","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update Required\",","    \"blockedMessage\": \"Please update to continue using the app.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"type":"paragraph","inlineContent":[{"text":"Every field is optional. An empty object ","type":"text"},{"type":"codeVoice","code":"{}"},{"text":" is valid and evaluates to ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":" for any version.","type":"text"}]},{"anchor":"View-modifier-killswitchBlocker","type":"heading","level":2,"text":"View modifier: `killswitchBlocker`"},{"type":"paragraph","inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" ships a SwiftUI view modifier that overlays a non-dismissible blocker whenever the verdict is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" and disables the underlying content while it is. Two overloads:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["extension View {","    \/\/\/ Default blocker — full-screen ultraThinMaterial with title, message,","    \/\/\/ and an optional Update button.","    public func killswitchBlocker(","        verdict: KillswitchVerdict,","        onUpdate: (() -> Void)? = nil","    ) -> some View","","    \/\/\/ Custom blocker — receives the title, message, and `hasUpdateURL`","    \/\/\/ flag and renders whatever you return.","    public func killswitchBlocker<Blocker: View>(","        verdict: KillswitchVerdict,","        @ViewBuilder blocker: @escaping (","            _ title: String?,","            _ message: String?,","            _ hasUpdateURL: Bool","        ) -> Blocker","    ) -> some View","}"]},{"type":"paragraph","inlineContent":[{"text":"Both overloads apply ","type":"text"},{"code":".disabled(verdict.isBlocked)","type":"codeVoice"},{"text":" to the modified content, so the underlying view tree stops responding to touches while blocked. The blocker layer is rendered as an overlay; supply your own to match the host app’s design system.","type":"text"}]}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Public API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference"},"references":{"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","type":"topic","kind":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","title":"Add a Version Killswitch"},"doc://Swidux/doc