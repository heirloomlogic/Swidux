{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Library target","anchor":"Library-target"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" ships as its own product in the "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" package. Add it to a target’s dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" and import it where you wire the plugin:"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxKillswitch"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The target depends on "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" and links against "},{"type":"codeVoice","code":"UIKit"},{"type":"text","text":" on iOS \/ "},{"type":"codeVoice","code":"AppKit"},{"type":"text","text":" on macOS for the default URL-opening behavior."}]},{"level":2,"type":"heading","text":"Types","anchor":"Types"},{"level":3,"type":"heading","text":"KillswitchPlugin","anchor":"KillswitchPlugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The domain plugin. Conforms to "},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" and is generic over the host app’s root state and action types."}]},{"syntax":"swift","type":"codeListing","code":["@MainActor","public struct KillswitchPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, KillswitchState>,","        action toRootAction: @escaping @Sendable (KillswitchAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> KillswitchAction?,","        service: KillswitchService,","        appVersion: @escaping @Sendable () -> String,","        openURL: @escaping @Sendable (URL) async -> Void = { \/* UIApplication \/ NSWorkspace *\/ }","    )","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"UIApplication.shared.open(_:)"},{"type":"text","text":" on iOS and "},{"type":"codeVoice","code":"NSWorkspace.shared.open(_:)"},{"type":"text","text":" on macOS, both hopped to "},{"type":"codeVoice","code":"MainActor"},{"type":"text","text":"."}]},{"level":3,"type":"heading","text":"KillswitchState","anchor":"KillswitchState"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The state slice the plugin owns. Default-constructed values match a fresh, never-fetched session."}]},{"syntax":"swift","type":"codeListing","code":["public struct KillswitchState: Sendable, Equatable {","    public var verdict: KillswitchVerdict   \/\/ defaults to .unknown","    public var lastFetch: Date?             \/\/ nil until first successful fetch","    public var fetchError: String?          \/\/ localized description of last failure","","    public var isBlocked: Bool              \/\/ delegates to verdict.isBlocked","    public var canOpenUpdateURL: Bool       \/\/ .blocked AND updateURL is non-nil","","    public init(","        verdict: KillswitchVerdict = .unknown,","        lastFetch: Date? = nil,","        fetchError: String? = nil","    )","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isBlocked"},{"type":"text","text":" and "},{"type":"codeVoice","code":"canOpenUpdateURL"},{"type":"text","text":" are convenience computed properties. Bind UI off them rather than pattern-matching "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":" everywhere."}]},{"level":3,"type":"heading","text":"KillswitchAction","anchor":"KillswitchAction"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin’s local action enum. Wrap these in your root action through the case you provide at registration."}]},{"syntax":"swift","type":"codeListing","code":["public enum KillswitchAction: Sendable {","    case fetch","    case forceFetch","    case verdictReceived(KillswitchVerdict, fromNetwork: Bool)","    case fetchFailed(String)","    case openUpdateURL","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"},{"type":"text","text":" is the launch-time entry point — it consults the cache and skips the network when the cached config is fresh. "},{"type":"codeVoice","code":".forceFetch"},{"type":"text","text":" always hits the network, suitable for pull-to-refresh or post-update health checks."}]},{"level":3,"type":"heading","text":"KillswitchService","anchor":"KillswitchService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure-based service that fetches and caches the remote config. Substitute the live factory in production and the mock factory in tests."}]},{"syntax":"swift","type":"codeListing","code":["public struct KillswitchService: Sendable {","    public var fetch: @Sendable () async throws -> KillswitchConfig","    public var loadCached: @Sendable () -> KillswitchConfig?","    public var saveCached: @Sendable (KillswitchConfig) -> Void","    public let cacheLifetime: TimeInterval","","    public init(","        fetch: @escaping @Sendable () async throws -> KillswitchConfig,","        loadCached: @escaping @Sendable () -> KillswitchConfig?,","        saveCached: @escaping @Sendable (KillswitchConfig) -> Void,","        cacheLifetime: TimeInterval","    )","","    public static func live(","        endpoint: URL,","        fetchTimeout: TimeInterval = 10,","        cacheLifetime: TimeInterval = 3600,","        session: URLSession = .shared","    ) -> KillswitchService","","    public static func mock(","        result: @escaping @Sendable () async throws -> KillswitchConfig = { KillswitchConfig() },","        cached: KillswitchConfig? = nil,","        cacheLifetime: TimeInterval = 3600","    ) -> KillswitchService","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"live(endpoint:)"},{"type":"text","text":" decodes JSON from "},{"type":"codeVoice","code":"endpoint"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"reloadIgnoringLocalCacheData"},{"type":"text","text":" policy and persists the result to a "},{"type":"codeVoice","code":"swidux-killswitch.json"},{"type":"text","text":" file in the user’s caches directory. "},{"type":"codeVoice","code":"mock(result:cached:)"},{"type":"text","text":" keeps an in-memory cache and lets a test inject a closure that returns or throws."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The endpoint must be "},{"type":"strong","inlineContent":[{"text":"HTTPS","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"http"},{"type":"text","text":" is allowed only for "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":" development servers; anything else is a precondition failure) — the killswitch is a remote control channel and must not be tamperable in transit. Non-2xx responses and payloads over 1 MB are treated as fetch failures, which fall back to the cache (and ultimately fail open)."}]},{"level":3,"type":"heading","text":"KillswitchConfig","anchor":"KillswitchConfig"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The decoded shape of the remote JSON. All fields are optional — a config with every field "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" evaluates to "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["public struct KillswitchConfig: Codable, Sendable, Equatable {","    public var minimumSupportedVersion: String?","    public var blockedVersions: [String]?","    public var blockedRanges: [String]?","    public var blockedTitle: String?","    public var blockedMessage: String?","    public var updateURL: String?","","    public init(","        minimumSupportedVersion: String? = nil,","        blockedVersions: [String]? = nil,","        blockedRanges: [String]? = nil,","        blockedTitle: String? = nil,","        blockedMessage: String? = nil,","        updateURL: String? = nil","    )","}"]},{"level":3,"type":"heading","text":"KillswitchVerdict","anchor":"KillswitchVerdict"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The result of evaluating a config against the running version."}]},{"syntax":"swift","type":"codeListing","code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unknown"},{"type":"text","text":" is the initial state before any fetch has been attempted. "},{"type":"codeVoice","code":"evaluate(_:against:)"},{"type":"text","text":" always returns "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" or "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":" — never "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":". "},{"type":"codeVoice","code":"isBlocked"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" only for the "},{"type":"codeVoice","code":".blocked"},{"type":"text","text":" case."}]},{"level":3,"type":"heading","text":"SemanticVersion","anchor":"SemanticVersion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests."}]},{"syntax":"swift","type":"codeListing","code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The string initializer accepts "},{"type":"codeVoice","code":"\"1.2.3\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"1.2.3-beta.1\""},{"type":"text","text":", and "},{"type":"codeVoice","code":"\"1.2.3-beta.1+build42\""},{"type":"text","text":". Build metadata after "},{"type":"codeVoice","code":"+"},{"type":"text","text":" is parsed and discarded. Malformed input returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric."}]},{"level":3,"type":"heading","text":"VersionRange","anchor":"VersionRange"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A half-open range "},{"type":"codeVoice","code":"[lowerBound, upperBound)"},{"type":"text","text":" of semantic versions, used to express "},{"type":"codeVoice","code":"blockedRanges"},{"type":"text","text":" entries."}]},{"syntax":"swift","type":"codeListing","code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both initializers fail and return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed."}]},{"level":2,"type":"heading","text":"Action semantics","anchor":"Action-semantics"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Effect on state","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Returned effect","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"if the cache is fresh (","type":"text"},{"type":"codeVoice","code":"Date() - lastFetch < cacheLifetime"},{"text":" AND ","type":"text"},{"type":"codeVoice","code":"loadCached()"},{"text":" is non-nil), evaluates the cached config and dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" without hitting the network; otherwise behaves like ","type":"text"},{"type":"codeVoice","code":".forceFetch"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".forceFetch"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"calls ","type":"text"},{"type":"codeVoice","code":"service.fetch()"},{"text":", persists the result via ","type":"text"},{"type":"codeVoice","code":"service.saveCached(_:)"},{"text":", dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":". On thrown error, falls back to ","type":"text"},{"type":"codeVoice","code":"service.loadCached()"},{"text":" if available — dispatching ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" from the cache ","type":"text"},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":".fetchFailed(message)"},{"text":" so the UI can surface the error while keeping a usable verdict","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".verdictReceived(verdict, fromNetwork:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"sets ","type":"text"},{"type":"codeVoice","code":"verdict"},{"text":", clears ","type":"text"},{"type":"codeVoice","code":"fetchError"},{"text":"; sets ","type":"text"},{"type":"codeVoice","code":"lastFetch = Date()"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"text":"only when ","type":"text"},{"code":"fromNetwork","type":"codeVoice"},{"text":" is true","type":"text"}]},{"text":" — a cache-served verdict must not slide the freshness window, or a session polling ","type":"text"},{"type":"codeVoice","code":".fetch"},{"text":" inside ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"text":" would never consult the network again","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetchFailed(message)"}]}],[{"type":"paragraph","inlineContent":[{"text":"sets ","type":"text"},{"type":"codeVoice","code":"fetchError = message"},{"text":" (does not clear ","type":"text"},{"type":"codeVoice","code":"verdict"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"lastFetch"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".openUpdateURL"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"if ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" with a non-nil ","type":"text"},{"code":"updateURL","type":"codeVoice"},{"text":" whose scheme is ","type":"text"},{"code":"https","type":"codeVoice"},{"text":", ","type":"text"},{"code":"itms-apps","type":"codeVoice"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"macappstore"},{"text":", calls the plugin’s ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" closure; otherwise no effect (the URL comes from remote config, so arbitrary schemes are never opened)","type":"text"}]}]]]},{"inlineContent":[{"type":"text","text":"The plugin only handles its own actions. Any action that "},{"type":"codeVoice","code":"extractAction"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for is ignored — the plugin’s "},{"type":"codeVoice","code":"reduce(...)"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" immediately."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The combination of ","type":"text"},{"type":"codeVoice","code":".forceFetch"},{"type":"text","text":"’s cached-fallback behavior and "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator ("},{"type":"codeVoice","code":"fetchError"},{"type":"text","text":"), without leaving the UI stuck on "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"."}]},{"type":"aside","name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":".verdictReceived","type":"codeVoice"},{"text":" is dispatched on every ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":"\/","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing ","type":"text"},{"code":"KillswitchState","type":"codeVoice"},{"text":" or a value derived from it — not by mapping this action. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"type":"heading","level":2,"text":"Verdict evaluation rules","anchor":"Verdict-evaluation-rules"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"KillswitchVerdict.evaluate(_:against:)"},{"type":"text","text":" is fail-open: any unparseable input yields "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":". Checks run in this fixed order, returning "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":" on the first match:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Current version parse.","type":"text"}]},{"text":" If ","type":"text"},{"code":"currentVersionString","type":"codeVoice"},{"text":" cannot be parsed as a ","type":"text"},{"code":"SemanticVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" immediately.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Minimum supported version.","type":"text"}]},{"text":" If ","type":"text"},{"code":"config.minimumSupportedVersion","type":"codeVoice"},{"text":" parses and ","type":"text"},{"code":"currentVersion < minVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Explicit blocked versions.","type":"text"}]},{"text":" Iterate ","type":"text"},{"code":"config.blockedVersions","type":"codeVoice"},{"text":". If any entry parses and equals ","type":"text"},{"code":"currentVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Blocked ranges.","type":"text"}]},{"text":" Iterate ","type":"text"},{"code":"config.blockedRanges","type":"codeVoice"},{"text":". If any entry parses as a ","type":"text"},{"code":"VersionRange","type":"codeVoice"},{"text":" and contains ","type":"text"},{"code":"currentVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Otherwise","type":"text"}]},{"text":" return ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A blocked verdict carries the config’s "},{"type":"codeVoice","code":"blockedTitle"},{"type":"text","text":", "},{"type":"codeVoice","code":"blockedMessage"},{"type":"text","text":", and "},{"type":"codeVoice","code":"updateURL"},{"type":"text","text":" (parsed via "},{"type":"codeVoice","code":"URL(string:)"},{"type":"text","text":") regardless of which check matched."}]},{"type":"heading","level":2,"text":"Remote config JSON shape","anchor":"Remote-config-JSON-shape"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"KillswitchConfig"},{"type":"text","text":" derives its "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance from synthesized keys, so the JSON keys match the property names. A representative file:"}]},{"syntax":"json","type":"codeListing","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.3.0\", \"1.3.1\"],","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update Required\",","    \"blockedMessage\": \"Please update to continue using the app.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"type":"paragraph","inlineContent":[{"text":"Every field is optional. An empty object ","type":"text"},{"code":"{}","type":"codeVoice"},{"text":" is valid and evaluates to ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" for any version.","type":"text"}]},{"anchor":"View-modifier-killswitchBlocker","text":"View modifier: `killswitchBlocker`","level":2,"type":"heading"},{"inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" ships a SwiftUI view modifier that overlays a non-dismissible blocker whenever the verdict is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" and disables the underlying content while it is. Two overloads:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["extension View {","    \/\/\/ Default blocker — full-screen ultraThinMaterial with title, message,","    \/\/\/ and an optional Update button.","    public func killswitchBlocker(","        verdict: KillswitchVerdict,","        onUpdate: (() -> Void)? = nil","    ) -> some View","","    \/\/\/ Custom blocker — receives the title, message, and `hasUpdateURL`","    \/\/\/ flag and renders whatever you return.","    public func killswitchBlocker<Blocker: View>(","        verdict: KillswitchVerdict,","        @ViewBuilder blocker: @escaping (","            _ title: String?,","            _ message: String?,","            _ hasUpdateURL: Bool","        ) -> Blocker","    ) -> some View","}"],"type":"codeListing"},{"inlineContent":[{"text":"Both overloads apply ","type":"text"},{"code":".disabled(verdict.isBlocked)","type":"codeVoice"},{"text":" to the modified content, so the underlying view tree stops responding to touches while blocked. The blocker layer is rendered as an overlay; supply your own to match the host app’s design system.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginkillswitc