{"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Library-target","text":"Library target"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" ships as its own product in the ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":" package. Add it to a target’s dependencies in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":" and import it where you wire the plugin:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxKillswitch"]},{"type":"paragraph","inlineContent":[{"text":"The target depends on ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":" and links against ","type":"text"},{"type":"codeVoice","code":"UIKit"},{"text":" on iOS \/ ","type":"text"},{"type":"codeVoice","code":"AppKit"},{"text":" on macOS for the default URL-opening behavior.","type":"text"}]},{"level":2,"type":"heading","anchor":"Types","text":"Types"},{"level":3,"type":"heading","anchor":"KillswitchPlugin","text":"KillswitchPlugin"},{"type":"paragraph","inlineContent":[{"text":"The domain plugin. Conforms to ","type":"text"},{"type":"codeVoice","code":"SwiduxPlugin"},{"text":" and is generic over the host app’s root state and action types.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","public struct KillswitchPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, KillswitchState>,","        action toRootAction: @escaping @Sendable (KillswitchAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> KillswitchAction?,","        service: KillswitchService,","        appVersion: @escaping @Sendable () -> String,","        openURL: @escaping @Sendable (URL) async -> Void = { \/* UIApplication \/ NSWorkspace *\/ }","    )","}"]},{"type":"paragraph","inl