{"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/EntityEditingGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistedAssociations","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference","anchor":"Reference","generated":true}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","title":"SwiduxKillswitch Reference","roleHeading":"Article"},"abstract":[{"type":"text","text":"Public API surface for the "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Library target","anchor":"Library-target","type":"heading"},{"inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" ships as its own product in the "},{"code":"Swidux","type":"codeVoice"},{"text":" package. Add it to a target’s dependencies in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" and import it where you wire the plugin:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxKillswitch"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The target depends on "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":" and links against "},{"code":"UIKit","type":"codeVoice"},{"type":"text","text":" on iOS \/ "},{"code":"AppKit","type":"codeVoice"},{"type":"text","text":" on macOS for the default URL-opening behavior."}],"type":"paragraph"},{"level":2,"text":"Types","anchor":"Types","type":"heading"},{"level":3,"text":"KillswitchPlugin","anchor":"KillswitchPlugin","type":"heading"},{"inlineContent":[{"type":"text","text":"The domain plugin. Conforms to "},{"code":"SwiduxPlugin","type":"codeVoice"},{"type":"text","text":" and is generic over the host app’s root state and action types."}],"type":"paragraph"},{"syntax":"swift","code":["@MainActor","public struct KillswitchPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, KillswitchState>,","        action toRootAction: @escaping @Sendable (KillswitchAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> KillswitchAction?,","        service: KillswitchService,","        appVersion: @escaping @Sendable () -> String,","        openURL: @escaping @Sendable (URL) async -> Void = { \/* UIApplication \/ NSWorkspace *\/ }","    )","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The default "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" calls "},{"code":"UIApplication.shared.open(_:)","type":"codeVoice"},{"type":"text","text":" on iOS and "},{"code":"NSWorkspace.shared.open(_:)","type":"codeVoice"},{"type":"text","text":" on macOS, both hopped to "},{"code":"MainActor","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"text":"KillswitchState","anchor":"KillswitchState","type":"heading"},{"inlineContent":[{"type":"text","text":"The state slice the plugin owns. Default-constructed values match a fresh, never-fetched session."}],"type":"paragraph"},{"syntax":"swift","code":["public struct KillswitchState: Sendable, Equatable {","    public var verdict: KillswitchVerdict   \/\/ defaults to .unknown","    public var lastFetch: Date?             \/\/ nil until first successful fetch","    public var fetchError: String?          \/\/ localized description of last failure","    public var isFetching: Bool             \/\/ true while a network fetch is in flight","","    public var isBlocked: Bool              \/\/ delegates to verdict.isBlocked","    public var canOpenUpdateURL: Bool       \/\/ .blocked AND updateURL is https, itms-apps, or macappstore","","    public init(","        verdict: KillswitchVerdict = .unknown,","        lastFetch: Date? = nil,","        fetchError: String? = nil,","        isFetching: Bool = false","    )","}"],"type":"codeListing"},{"inlineContent":[{"code":"isBlocked","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"canOpenUpdateURL","type":"codeVoice"},{"text":" are convenience computed properties. Bind UI off them rather than pattern-matching ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" everywhere. ","type":"text"},{"code":"canOpenUpdateURL","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"verdict.openableUpdateURL != nil","type":"codeVoice"},{"text":", so a blocked verdict whose ","type":"text"},{"code":"updateURL","type":"codeVoice"},{"text":" uses any other scheme (","type":"text"},{"code":"http","type":"codeVoice"},{"text":", say) shows the default blocker without an Update button.","type":"text"}],"type":"paragraph"},{"level":3,"text":"KillswitchAction","anchor":"KillswitchAction","type":"heading"},{"inlineContent":[{"text":"The plugin’s local action enum. Wrap these in your root action through the case you provide at registration.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public enum KillswitchAction: Sendable {","    case fetch","    case forceFetch","    case verdictReceived(KillswitchVerdict, fromNetwork: Bool)","    case fetchFailed(String)","    case openUpdateURL","}"],"type":"codeListing"},{"inlineContent":[{"code":".fetch","type":"codeVoice"},{"text":" is the launch-time entry point — it consults the cache and skips the network when the cached config is fresh. ","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":" always hits the network, suitable for pull-to-refresh or post-update health checks. Neither starts a second request while one is in flight.","type":"text"}],"type":"paragraph"},{"level":3,"text":"KillswitchService","anchor":"KillswitchService","type":"heading"},{"inlineContent":[{"text":"A closure-based service that fetches and caches the remote config. Substitute the live factory in production and the mock factory in tests.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct KillswitchService: Sendable {","    public var fetch: @Sendable () async throws -> KillswitchConfig","    public var loadCached: @Sendable () -> KillswitchConfig?","    public var saveCached: @Sendable (KillswitchConfig) -> Void","    public let cacheLifetime: TimeInterval","    public let fetchTimeout: TimeInterval","","    public init(","        fetch: @escaping @Sendable () async throws -> KillswitchConfig,","        loadCached: @escaping @Sendable () -> KillswitchConfig?,","        saveCached: @escaping @Sendable (KillswitchConfig) -> Void,","        cacheLifetime: TimeInterval,","        fetchTimeout: TimeInterval = 30","    )","","    public static func live(","        endpoint: URL,","        fetchTimeout: TimeInterval = 10,","        cacheLifetime: TimeInterval = 3600,","        session: URLSession = .shared","    ) -> KillswitchService","","    public static func mock(","        result: @escaping @Sendable () async throws -> KillswitchConfig = { KillswitchConfig() },","        cached: KillswitchConfig? = nil,","        cacheLifetime: TimeInterval = 3600","    ) -> KillswitchService","}"],"type":"codeListing"},{"inlineContent":[{"code":"live(endpoint:)","type":"codeVoice"},{"text":" decodes JSON from ","type":"text"},{"code":"endpoint","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"reloadIgnoringLocalCacheData","type":"codeVoice"},{"text":" policy and persists the result to ","type":"text"},{"code":"swidux-killswitch.json","type":"codeVoice"},{"text":" in a ","type":"text"},{"inlineContent":[{"text":"bundle-scoped subdirectory","type":"text"}],"type":"strong"},{"text":" of the user’s caches directory. The stored payload records the endpoint it came from, and a cache written for a different endpoint reads as absent — the cached config produces a verdict with the same authority a fetched one does, so it is scoped and checked rather than trusted. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","type":"reference","isActive":true},{"text":" §6a. ","type":"text"},{"code":"mock(result:cached:)","type":"codeVoice"},{"text":" keeps an in-memory cache and lets a test inject a closure that returns or throws.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"fetchTimeout","type":"codeVoice"},{"text":" is the plugin’s own bound on ","type":"text"},{"code":"fetch","type":"codeVoice"},{"text":", whatever the service does inside it. Only one network fetch runs at a time, so a custom ","type":"text"},{"code":"fetch","type":"codeVoice"},{"text":" that never returned would otherwise hold ","type":"text"},{"code":"isFetching","type":"codeVoice"},{"text":", and every later ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":", for the session. Past the bound the plugin abandons the call, even one that ignores cancellation, and handles it as a failure (","type":"text"},{"code":"URLError.timedOut","type":"codeVoice"},{"text":"): cache fallback plus ","type":"text"},{"code":".fetchFailed","type":"codeVoice"},{"text":". It defaults to 30 seconds for a custom service; ","type":"text"},{"code":"live","type":"codeVoice"},{"text":" uses its own ","type":"text"},{"code":"fetchTimeout","type":"codeVoice"},{"text":". A value that isn’t finite and positive means no bound.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The endpoint must be ","type":"text"},{"inlineContent":[{"text":"HTTPS","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"code":"http","type":"codeVoice"},{"text":" is allowed only for ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":" development servers; anything else is a precondition failure) — the killswitch is a remote control channel and must not be tamperable in transit. Non-2xx responses, payloads over 1 MB, and fetches that run past ","type":"text"},{"code":"fetchTimeout","type":"codeVoice"},{"text":" are treated as fetch failures, which fall back to the cache (and ultimately fail open). ","type":"text"},{"code":"fetchTimeout","type":"codeVoice"},{"text":" bounds the whole fetch, headers and body together; it is not just an idle timeout, so a response trickled in a byte at a time still fails on schedule.","type":"text"}],"type":"paragraph"},{"level":3,"text":"KillswitchConfig","anchor":"KillswitchConfig","type":"heading"},{"inlineContent":[{"text":"The decoded shape of the remote JSON. All fields are optional — a config with every field ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" evaluates to ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct KillswitchConfig: Codable, Sendable, Equatable {","    public var minimumSupportedVersion: String?","    public var blockedVersions: [String]?","    public var blockedRanges: [String]?","    public var blockedTitle: String?","    public var blockedMessage: String?","    public var updateURL: String?","","    public init(","        minimumSupportedVersion: String? = nil,","        blockedVersions: [String]? = nil,","        blockedRanges: [String]? = nil,","        blockedTitle: String? = nil,","        blockedMessage: String? = nil,","        updateURL: String? = nil","    )","}"],"type":"codeListing"},{"level":3,"text":"KillswitchVerdict","anchor":"KillswitchVerdict","type":"heading"},{"inlineContent":[{"text":"The result of evaluating a config against the running version.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"],"type":"codeListing"},{"inlineContent":[{"code":".unknown","type":"codeVoice"},{"text":" is the initial state before any fetch has been attempted. ","type":"text"},{"code":"evaluate(_:against:)","type":"codeVoice"},{"text":" always returns ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":" — never ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":". ","type":"text"},{"code":"isBlocked","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" only for the ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" case.","type":"text"}],"type":"paragraph"},{"level":3,"text":"SemanticVersion","anchor":"SemanticVersion","type":"heading"},{"inlineContent":[{"text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The string initializer accepts ","type":"text"},{"code":"\"1.2.3\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"1.2.3-beta.1\"","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"\"1.2.3-beta.1+build42\"","type":"codeVoice"},{"text":". Build metadata after ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" is parsed and discarded. Malformed input returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric.","type":"text"}],"type":"paragraph"},{"level":3,"text":"VersionRange","anchor":"VersionRange","type":"heading"},{"inlineContent":[{"text":"A half-open range ","type":"text"},{"code":"[lowerBound, upperBound)","type":"codeVoice"},{"text":" of semantic versions, used to express ","type":"text"},{"code":"blockedRanges","type":"codeVoice"},{"text":" entries.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"],"type":"codeListing"},{"inlineContent":[{"text":"Both initializers fail and return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Action semantics","anchor":"Action-semantics","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Effect on state"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Returned effect"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".fetch"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"ignored while "},{"type":"codeVoice","code":"isFetching"},{"type":"text","text":". If the window is fresh ("},{"type":"codeVoice","code":"0 <= Date() - lastFetch < cacheLifetime"},{"type":"text","text":") and "},{"type":"codeVoice","code":"loadCached()"},{"type":"text","text":" returns a config, sets "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":" from it and clears "},{"type":"codeVoice","code":"fetchError"},{"type":"text","text":" right there in the reducer, leaving "},{"type":"codeVoice","code":"lastFetch"},{"type":"text","text":" alone; otherwise sets "},{"type":"codeVoice","code":"isFetching"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none for a fresh-window cache hit — the verdict is already applied, so no later action can land after, and overwrite, a newer network verdict. Otherwise behaves like "},{"type":"codeVoice","code":".forceFetch"},{"type":"text","text":". "},{"type":"codeVoice","code":"lastFetch"},{"type":"text","text":" is session state, so every cold launch goes to the network"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".forceFetch"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"ignored while "},{"type":"codeVoice","code":"isFetching"},{"type":"text","text":"; otherwise sets "},{"type":"codeVoice","code":"isFetching"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"if "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":" is still "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":" (a cold launch) and a cached config exists, first dispatches its verdict with "},{"type":"codeVoice","code":"fromNetwork: false"},{"type":"text","text":", so a build the device already knows is blocked is blocked before the network answers. Then calls "},{"type":"codeVoice","code":"service.fetch()"},{"type":"text","text":", persists the result via "},{"type":"codeVoice","code":"service.saveCached(_:)"},{"type":"text","text":", and dispatches "},{"type":"codeVoice","code":".verdictReceived(..., fromNetwork: true)"},{"type":"text","text":". On thrown error, falls back to "},{"type":"codeVoice","code":"service.loadCached()"},{"type":"text","text":" if it wasn’t already shown — dispatching "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from the cache "},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed(message)"},{"type":"text","text":" so the UI can surface the error while keeping a usable verdict"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".verdictReceived(verdict, fromNetwork:)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"sets "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"fetchError"},{"type":"text","text":"; sets "},{"type":"codeVoice","code":"lastFetch = Date()"},{"type":"text","text":" and clears "},{"type":"codeVoice","code":"isFetching"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"only when ","type":"text"},{"type":"codeVoice","code":"fromNetwork"},{"text":" is true","type":"text"}]},{"type":"text","text":" — a cache-served verdict must not slide the freshness window, or a session polling "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":" inside "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":" would never consult the network again, and the cold-launch preview arrives while the request is still in flight"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".fetchFailed(message)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"sets ","type":"text"},{"type":"codeVoice","code":"fetchError = message"},{"text":", clears ","type":"text"},{"type":"codeVoice","code":"isFetching"},{"text":" (does not clear ","type":"text"},{"type":"codeVoice","code":"verdict"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"lastFetch"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".openUpdateURL"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"if ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" with a non-nil ","type":"text"},{"code":"updateURL","type":"codeVoice"},{"text":" whose scheme is ","type":"text"},{"code":"https","type":"codeVoice"},{"text":", ","type":"text"},{"code":"itms-apps","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"macappstore","type":"codeVoice"},{"text":", calls the plugin’s ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" closure; otherwise no effect (the URL comes from remote config, so arbitrary schemes are never opened)","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"The plugin only handles its own actions. Any action that ","type":"text"},{"code":"extractAction","type":"codeVoice"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" for is ignored — the plugin’s ","type":"text"},{"type":"codeVoice","code":"reduce(...)"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" immediately.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The combination of ","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":"’s cached-fallback behavior and ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator (","type":"text"},{"code":"fetchError","type":"codeVoice"},{"text":"), without leaving the UI stuck on ","type":"text"},{"type":"codeVoice","code":".unknown"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"code":".verdictReceived","type":"codeVoice"},{"text":" is dispatched on every network fetch (and its cold-launch preview or cache fallback), usually with an unchanged verdict; a fresh-window ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":" applies its cached verdict without one. Consume verdict transitions by observing ","type":"text"},{"code":"KillswitchState","type":"codeVoice"},{"text":" or a value derived from it — not by mapping this action. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"level":2,"text":"Verdict evaluation rules","anchor":"Verdict-evaluation-rules","type":"heading"},{"inlineContent":[{"code":"KillswitchVerdict.evaluate(_:against:)","type":"codeVoice"},{"text":" is fail-open: any unparseable input yields ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":". Checks run in this fixed order, returning ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":" on the first match:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Current version parse.","type":"text"}]},{"type":"text","text":" If "},{"type":"codeVoice","code":"currentVersionString"},{"type":"text","text":" cannot be parsed as a "},{"type":"codeVoice","code":"SemanticVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" immediately."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Minimum supported version.","type":"text"}]},{"type":"text","text":" If "},{"type":"codeVoice","code":"config.minimumSupportedVersion"},{"type":"text","text":" parses and "},{"type":"codeVoice","code":"currentVersion < minVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Explicit blocked versions.","type":"text"}]},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedVersions"},{"type":"text","text":". If any entry parses and equals "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Blocked ranges.","type":"text"}]},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedRanges"},{"type":"text","text":". If any entry parses as a "},{"type":"codeVoice","code":"VersionRange"},{"type":"text","text":" and contains "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Otherwise","type":"text"}]},{"type":"text","text":" return "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"A blocked verdict carries the config’s ","type":"text"},{"code":"blockedTitle","type":"codeVoice"},{"text":", ","type":"text"},{"code":"blockedMessage","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"updateURL","type":"codeVoice"},{"text":" (parsed via ","type":"text"},{"code":"URL(string:)","type":"codeVoice"},{"text":") regardless of which check matched.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Config-side versions parse strictly: ","type":"text"},{"type":"codeVoice","code":"\"2.0\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"v2.0.0\""},{"text":", and ","type":"text"},{"type":"codeVoice","code":"\" 2.0.0\""},{"text":" (stray whitespace from a dashboard paste) are all rejected, as are ranges with spaces around ","type":"text"},{"code":"..<","type":"codeVoice"},{"text":" or a lower bound that isn’t below the upper. A rejected rule never matches, so it fails open. Every evaluation logs each rejected rule at error level to the ","type":"text"},{"code":"swidux","type":"codeVoice"},{"text":" subsystem, ","type":"text"},{"code":"killswitch","type":"codeVoice"},{"text":" category, with the offending string public — check Console after publishing an incident config, because the endpoint will happily serve a rule no client can apply.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Diagnostics","anchor":"Diagnostics","type":"heading"},{"inlineContent":[{"text":"The killswitch fails open, so a broken config channel leaves the app usable and shows nothing on screen. These log lines, all under the ","type":"text"},{"code":"swidux","type":"codeVoice"},{"text":" subsystem, are where it shows up instead. None of them changes the verdict.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"A failed network fetch","type":"text"}]},{"text":" logs at error level, ","type":"text"},{"type":"codeVoice","code":"killswitch"},{"text":" category, with a summary of the error. With ","type":"text"},{"type":"codeVoice","code":"KillswitchService.live"},{"text":" the line also names the endpoint, without its query, fragment, or credentials. A non-2xx response names its status, so a wrong URL reads as ","type":"text"},{"type":"codeVoice","code":"HTTP 404"},{"text":". The plugin remembers only the last failure it logged, in memory: a failure identical to it is skipped until a fetch succeeds, so a device that stays offline logs the outage once per launch, as long as the error stays the same. A different error, or the same one after a successful fetch, is logged again. A cancelled fetch isn’t logged. ","type":"text"},{"code":"fetchError","type":"codeVoice"},{"text":" records every failure either way.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"A version rule that fails strict parsing"}],"type":"strong"},{"text":" logs at error level on every evaluation. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference#Verdict-evaluation-rules","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"In debug builds, a top-level key ","type":"text"},{"type":"codeVoice","code":"KillswitchConfig"},{"text":" doesn’t declare","type":"text"}],"type":"strong"},{"text":" logs at warning level, ","type":"text"},{"code":"killswitch","type":"codeVoice"},{"text":" category, on each fetch through ","type":"text"},{"code":"live","type":"codeVoice"},{"text":". A misspelled ","type":"text"},{"code":"minimumSupportedVerison","type":"codeVoice"},{"text":" decodes as a config with no minimum, and this line is how you find it. Release builds don’t log it, because a field added for newer builds is unknown to older ones by design.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"In debug builds, a 2xx response carrying ","type":"text"},{"type":"codeVoice","code":"X-Config-Source: default"}],"type":"strong"},{"text":" logs at warning level, ","type":"text"},{"code":"remoteconfig","type":"codeVoice"},{"text":" category. A config worker can send that header when nothing is stored under the requested key and it serves its fallback instead, which usually means the app ID in the URL is wrong. ","type":"text"},{"code":"Examples\/ConfigWorker","type":"codeVoice"},{"text":" doesn’t send this header.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Remote config JSON shape","anchor":"Remote-config-JSON-shape","type":"heading"},{"inlineContent":[{"text":"The JSON keys are ","type":"text"},{"type":"codeVoice","code":"KillswitchConfig"},{"text":"’s property names. A representative file:","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.3.0\", \"1.3.1\"],","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update Required\",","    \"blockedMessage\": \"Please update to continue using the app.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing"},{"inlineContent":[{"text":"Every field is optional. An empty object ","type":"text"},{"type":"codeVoice","code":"{}"},{"text":" is valid and evaluates to ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":" for any version.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Schema evolution","anchor":"Schema-evolution","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"KillswitchConfig"},{"text":" has no ","type":"text"},{"type":"codeVoice","code":"version"},{"text":" field and no ","type":"text"},{"type":"codeVoice","code":"type"},{"text":" discriminator, and its decoding ignores keys it doesn’t declare. Debug builds log them on a fetch through ","type":"text"},{"type":"codeVoice","code":"live"},{"text":" (see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference#Diagnostics","type":"reference"},{"text":"); release builds don’t. A field added for newer builds therefore never makes an older build reject the document, so feature flags’ unknown-type problem (see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference#Schema-evolution","type":"reference"},{"text":") has no killswitch counterpart.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The risk runs the other way: an older build ignores a field it predates without any error, and older builds are usually the ones an incident needs to block. ","type":"text"},{"inlineContent":[{"text":"Never express a block for old builds with a field those builds don’t decode.","type":"text"}],"type":"strong"},{"text":" Use ","type":"text"},{"type":"codeVoice","code":"minimumSupportedVersion"},{"text":", ","type":"text"},{"type":"codeVoice","code":"blockedVersions"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"blockedRanges"},{"text":", which every release of ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" has decoded.","type":"text"}],"type":"paragraph"},{"level":2,"text":"View modifier: `killswitchBlocker`","anchor":"View-modifier-killswitchBlocker","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" ships a SwiftUI view modifier that overlays a non-dismissible blocker whenever the verdict is ","type":"text"},{"type":"codeVoice","code":".blocked"},{"text":" and disables the underlying content while it is. Two overloads:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["extension View {","    \/\/\/ Default blocker — full-screen ultraThinMaterial with title, message,","    \/\/\/ and an optional Update button.","    public func killswitchBlocker(","        verdict: KillswitchVerdict,","        onUpdate: (() -> Void)? = nil","    ) -> some View","","    \/\/\/ Custom blocker — receives the title, message, and `hasUpdateURL`","    \/\/\/ flag and renders whatever you return.","    public func killswitchBlocker<Blocker: View>(","        verdict: KillswitchVerdict,","        @ViewBuilder blocker: @escaping (","            _ title: String?,","            _ message: String?,","            _ hasUpdateURL: Bool","        ) -> Blocker","    ) -> some View","}"],"type":"codeListing"},{"inlineContent":[{"text":"Both overloads apply ","type":"text"},{"type":"codeVoice","code":".disabled(verdict.isBlocked)"},{"text":" to the modified content, so the underlying view tree stops responding to touches while blocked. The blocker layer is rendered as an overlay; supply your own to match the host app’s design system.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The modifier is view-local. It covers only the view it is applied to, and the plugin does not gate dispatch while blocked: other scenes, presentations already on screen (drawn above the overlay), menu commands, keyboard shortcuts, App Intents, and URL handlers all keep working unless you gate them. Apply the modifier to every scene’s root, dismiss presentations when ","type":"text"},{"type":"codeVoice","code":"isBlocked"},{"text":" becomes true, and disable commands on ","type":"text"},{"type":"codeVoice","code":"isBlocked"},{"text":". See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch#What-the-blocker-covers","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/swidux\/pluginkillswitchreference"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","interfaceLanguage":"swift"},"references":{"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","type":"topic","title":"SwiduxFeatureFlags Reference","kind":"article","role":"article","url":"\/documentation\/swidux\/pluginfeatureflagsreference"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","type":"topic","title":"Troubleshooting","kind":"article","role":"article","url":"\/documentation\/swidux\/troubleshooting"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","kind":"article","title":"Add a Version Killswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","abstract":[{"text":"Wire a remote-controlled blocker that covers the UI of unsupported app versions, with an “Update” path back to the App Store.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddaversionkillswitch","type":"topic"},"doc://Swidux/documentation/Swidux/PersistedAssociations":{"abstract":[{"type":"text","text":"Declare parent and child identities separately, then save an editing session through one local transaction."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistedAssociations","type":"topic","title":"Persisting canonical associations","kind":"article","role":"article","url":"\/documentation\/swidux\/persistedassociations"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"role":"article","kind":"article","title":"SwiduxAnalytics Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"url":"\/documentation\/swidux\/pluginanalyticsreference","type":"topic"},"doc://Swidux/documentation/Swidux/SecurityPosture":{"role":"collectionGroup","kind":"article","title":"Security Posture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","abstract":[{"text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one.","type":"text"}],"url":"\/documentation\/swidux\/securityposture","type":"topic"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"abstract":[{"type":"text","text":"API surface for the "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","type":"topic","title":"SwiduxParentalGate Reference","kind":"article","role":"article","url":"\/documentation\/swidux\/pluginparentalgatereference"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","title":"Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"url":"\/documentation\/swidux","type":"topic","role":"collection"},"doc://Swidux/documentation/Swidux/EntityEditingGuide":{"role":"article","kind":"article","title":"Editing canonical entities","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityEditingGuide","abstract":[{"type":"text","text":"Keep editor drafts separate from current application state, then apply their changes as one local group."}],"url":"\/documentation\/swidux\/entityeditingguide","type":"topic"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic","title":"SwiduxPaywall Reference","kind":"article","role":"article","url":"\/documentation\/swidux\/pluginpaywallreference"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","type":"topic","title":"KeyValueStore","kind":"article","role":"collectionGroup","url":"\/documentation\/swidux\/keyvaluestoreguide"},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","title":"Getting Started with Swidux","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"url":"\/documentation\/swidux\/gettingstarted","type":"topic"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference#Verdict-evaluation-rules":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference#Verdict-evaluation-rules","url":"\/documentation\/swidux\/pluginkillswitchreference#Verdict-evaluation-rules","abstract":[],"kind":"section","title":"Verdict evaluation rules","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch#What-the-blocker-covers":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch#What-the-blocker-covers","url":"\/documentation\/swidux\/howtoaddaversionkillswitch#What-the-blocker-covers","abstract":[],"kind":"section","title":"What the blocker covers","type":"topic"},"doc://Swidux/documentation/Swidux/MacrosReference":{"abstract":[{"type":"text","text":"Reference for "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" and "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":").","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","type":"topic","title":"Macros","kind":"article","role":"article","url":"\/documentation\/swidux\/macrosreference"},"doc://Swidux/documentation/Swidux/UndoRedo":{"abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":".","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"topic","title":"Undo \/ Redo","kind":"article","role":"article","url":"\/documentation\/swidux\/undoredo"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"role":"symbol","kind":"symbol","title":"UndoPlugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"url":"\/documentation\/swidux\/undoplugin","type":"topic"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","kind":"article","title":"Plugin Architecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"url":"\/documentation\/swidux\/pluginarchitecture","type":"topic"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference#Schema-evolution":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference#Schema-evolution","url":"\/documentation\/swidux\/pluginfeatureflagsreference#Schema-evolution","abstract":[],"kind":"section","title":"Schema evolution","type":"topic"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference#Diagnostics":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference#Diagnostics","url":"\/documentation\/swidux\/pluginkillswitchreference#Diagnostics","abstract":[],"kind":"section","title":"Diagnostics","type":"topic"},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","type":"topic","kind":"section","title":"Service-Result Actions and Transition Observation","url":"\/documentation\/swidux\/pluginarchitecture#Service-Result-Actions-and-Transition-Observation","abstract":[]},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","title":"EntityStore","kind":"article","url":"\/documentation\/swidux\/entitystoreguide","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"identifier":"doc:\/\/S