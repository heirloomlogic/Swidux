{"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"text":"Public API surface for the ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginkillswitchreference"]}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"Reference","anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"generated":true}],"metadata":{"roleHeading":"Article","title":"SwiduxKillswitch Reference","role":"article","modules":[{"name":"Swidux"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"level":2,"anchor":"Library-target","text":"Library target","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" ships as its own product in the "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" package. Add it to a target’s dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" and import it where you wire the plugin:"}],"type":"paragraph"},{"code":["import SwiduxKillswitch"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The target depends on "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":" and links against "},{"type":"codeVoice","code":"UIKit"},{"type":"text","text":" on iOS \/ "},{"type":"codeVoice","code":"AppKit"},{"type":"text","text":" on macOS for the default URL-opening behavior."}],"type":"paragraph"},{"level":2,"anchor":"Types","text":"Types","type":"heading"},{"level":3,"anchor":"KillswitchPlugin","text":"KillswitchPlugin","type":"heading"},{"inlineContent":[{"type":"text","text":"The domain plugin. Conforms to "},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" and is generic over the host app’s root state and action types."}],"type":"paragraph"},{"code":["@MainActor","public struct KillswitchPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, KillswitchState>,","        action toRootAction: @escaping @Sendable (KillswitchAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> KillswitchAction?,","        service: KillswitchService,","        appVersion: @escaping @Sendable () -> String,","        openURL: @escaping @Sendable (URL) async -> Void = { \/* UIApplication \/ NSWorkspace *\/ }","    )","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"UIApplication.shared.open(_:)"},{"type":"text","text":" on iOS and "},{"type":"codeVoice","code":"NSWorkspace.shared.open(_:)"},{"type":"text","text":" on macOS, both hopped to "},{"type":"codeVoice","code":"MainActor"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"anchor":"KillswitchState","text":"KillswitchState","type":"heading"},{"inlineContent":[{"type":"text","text":"The state slice the plugin owns. Default-constructed values match a fresh, never-fetched session."}],"type":"paragraph"},{"code":["public struct KillswitchState: Sendable, Equatable {","    public var verdict: KillswitchVerdict   \/\/ defaults to .unknown","    public var lastFetch: Date?             \/\/ nil until first successful fetch","    public var fetchError: String?          \/\/ localized description of last failure","","    public var isBlocked: Bool              \/\/ delegates to verdict.isBlocked","    public var canOpenUpdateURL: Bool       \/\/ .blocked AND updateURL is non-nil","","    public init(","        verdict: KillswitchVerdict = .unknown,","        lastFetch: Date? = nil,","        fetchError: String? = nil","    )","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"isBlocked"},{"type":"text","text":" and "},{"type":"codeVoice","code":"canOpenUpdateURL"},{"type":"text","text":" are convenience computed properties. Bind UI off them rather than pattern-matching "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":" everywhere."}],"type":"paragraph"},{"level":3,"anchor":"KillswitchAction","text":"KillswitchAction","type":"heading"},{"inlineContent":[{"type":"text","text":"The plugin’s local action enum. Wrap these in your root action through the case you provide at registration."}],"type":"paragraph"},{"code":["public enum KillswitchAction: Sendable {","    case fetch","    case forceFetch","    case verdictReceived(KillswitchVerdict, fromNetwork: Bool)","    case fetchFailed(String)","    case openUpdateURL","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":".fetch"},{"type":"text","text":" is the launch-time entry point — it consults the cache and skips the network when the cached config is fresh. "},{"type":"codeVoice","code":".forceFetch"},{"type":"text","text":" always hits the network, suitable for pull-to-refresh or post-update health checks."}],"type":"paragraph"},{"level":3,"anchor":"KillswitchService","text":"KillswitchService","type":"heading"},{"inlineContent":[{"type":"text","text":"A closure-based service that fetches and caches the remote config. Substitute the live factory in production and the mock factory in tests."}],"type":"paragraph"},{"code":["public struct KillswitchService: Sendable {","    public var fetch: @Sendable () async throws -> KillswitchConfig","    public var loadCached: @Sendable () -> KillswitchConfig?","    public var saveCached: @Sendable (KillswitchConfig) -> Void","    public let cacheLifetime: TimeInterval","","    public init(","        fetch: @escaping @Sendable () async throws -> KillswitchConfig,","        loadCached: @escaping @Sendable () -> KillswitchConfig?,","        saveCached: @escaping @Sendable (KillswitchConfig) -> Void,","        cacheLifetime: TimeInterval","    )","","    public static func live(","        endpoint: URL,","        fetchTimeout: TimeInterval = 10,","        cacheLifetime: TimeInterval = 3600,","        session: URLSession = .shared","    ) -> KillswitchService","","    public static func mock(","        result: @escaping @Sendable () async throws -> KillswitchConfig = { KillswitchConfig() },","        cached: KillswitchConfig? = nil,","        cacheLifetime: TimeInterval = 3600","    ) -> KillswitchService","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"live(endpoint:)"},{"type":"text","text":" decodes JSON from "},{"type":"codeVoice","code":"endpoint"},{"type":"text","text":" with a "},{"type":"codeVoice","code":"reloadIgnoringLocalCacheData"},{"type":"text","text":" policy and persists the result to a "},{"type":"codeVoice","code":"swidux-killswitch.json"},{"type":"text","text":" file in the user’s caches directory. "},{"type":"codeVoice","code":"mock(result:cached:)"},{"type":"text","text":" keeps an in-memory cache and lets a test inject a closure that returns or throws."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The endpoint must be "},{"inlineContent":[{"type":"text","text":"HTTPS"}],"type":"strong"},{"type":"text","text":" ("},{"type":"codeVoice","code":"http"},{"type":"text","text":" is allowed only for "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":" development servers; anything else is a precondition failure) — the killswitch is a remote control channel and must not be tamperable in transit. Non-2xx responses and payloads over 1 MB are treated as fetch failures, which fall back to the cache (and ultimately fail open)."}],"type":"paragraph"},{"level":3,"anchor":"KillswitchConfig","text":"KillswitchConfig","type":"heading"},{"inlineContent":[{"type":"text","text":"The decoded shape of the remote JSON. All fields are optional — a config with every field "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" evaluates to "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["public struct KillswitchConfig: Codable, Sendable, Equatable {","    public var minimumSupportedVersion: String?","    public var blockedVersions: [String]?","    public var blockedRanges: [String]?","    public var blockedTitle: String?","    public var blockedMessage: String?","    public var updateURL: String?","","    public init(","        minimumSupportedVersion: String? = nil,","        blockedVersions: [String]? = nil,","        blockedRanges: [String]? = nil,","        blockedTitle: String? = nil,","        blockedMessage: String? = nil,","        updateURL: String? = nil","    )","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"KillswitchVerdict","text":"KillswitchVerdict","type":"heading"},{"inlineContent":[{"type":"text","text":"The result of evaluating a config against the running version."}],"type":"paragraph"},{"code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":".unknown"},{"type":"text","text":" is the initial state before any fetch has been attempted. "},{"type":"codeVoice","code":"evaluate(_:against:)"},{"type":"text","text":" always returns "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" or "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":" — never "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":". "},{"type":"codeVoice","code":"isBlocked"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" only for the "},{"type":"codeVoice","code":".blocked"},{"type":"text","text":" case."}],"type":"paragraph"},{"level":3,"anchor":"SemanticVersion","text":"SemanticVersion","type":"heading"},{"inlineContent":[{"type":"text","text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests."}],"type":"paragraph"},{"code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The string initializer accepts "},{"code":"\"1.2.3\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"1.2.3-beta.1\"","type":"codeVoice"},{"type":"text","text":", and "},{"code":"\"1.2.3-beta.1+build42\"","type":"codeVoice"},{"type":"text","text":". Build metadata after "},{"code":"+","type":"codeVoice"},{"type":"text","text":" is parsed and discarded. Malformed input returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric."}],"type":"paragraph"},{"level":3,"anchor":"VersionRange","text":"VersionRange","type":"heading"},{"inlineContent":[{"type":"text","text":"A half-open range "},{"code":"[lowerBound, upperBound)","type":"codeVoice"},{"type":"text","text":" of semantic versions, used to express "},{"code":"blockedRanges","type":"codeVoice"},{"type":"text","text":" entries."}],"type":"paragraph"},{"code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Both initializers fail and return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed."}],"type":"paragraph"},{"level":2,"anchor":"Action-semantics","text":"Action semantics","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Effect on state","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Returned effect","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".fetch","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"if the cache is fresh (","type":"text"},{"code":"Date() - lastFetch < cacheLifetime","type":"codeVoice"},{"text":" AND ","type":"text"},{"code":"loadCached()","type":"codeVoice"},{"text":" is non-nil), evaluates the cached config and dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" without hitting the network; otherwise behaves like ","type":"text"},{"code":".forceFetch","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".forceFetch","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"calls ","type":"text"},{"code":"service.fetch()","type":"codeVoice"},{"text":", persists the result via ","type":"text"},{"code":"service.saveCached(_:)","type":"codeVoice"},{"text":", dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":". On thrown error, falls back to ","type":"text"},{"code":"service.loadCached()","type":"codeVoice"},{"text":" if available — dispatching ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from the cache ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":".fetchFailed(message)","type":"codeVoice"},{"text":" so the UI can surface the error while keeping a usable verdict","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".verdictReceived(verdict, fromNetwork:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"sets ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":", clears ","type":"text"},{"code":"fetchError","type":"codeVoice"},{"text":"; sets ","type":"text"},{"code":"lastFetch = Date()","type":"codeVoice"},{"text":" ","type":"text"},{"inlineContent":[{"text":"only when ","type":"text"},{"type":"codeVoice","code":"fromNetwork"},{"text":" is true","type":"text"}],"type":"strong"},{"text":" — a cache-served verdict must not slide the freshness window, or a session polling ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":" inside ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":" would never consult the network again","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".fetchFailed(message)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"sets ","type":"text"},{"code":"fetchError = message","type":"codeVoice"},{"text":" (does not clear ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"lastFetch","type":"codeVoice"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".openUpdateURL","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"if ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" with a non-nil ","type":"text"},{"code":"updateURL","type":"codeVoice"},{"text":" whose scheme is ","type":"text"},{"code":"https","type":"codeVoice"},{"text":", ","type":"text"},{"code":"itms-apps","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"macappstore","type":"codeVoice"},{"text":", calls the plugin’s ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" closure; otherwise no effect (the URL comes from remote config, so arbitrary schemes are never opened)","type":"text"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"The plugin only handles its own actions. Any action that "},{"code":"extractAction","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for is ignored — the plugin’s "},{"code":"reduce(...)","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" immediately."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The combination of "},{"code":".forceFetch","type":"codeVoice"},{"type":"text","text":"’s cached-fallback behavior and "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator ("},{"code":"fetchError","type":"codeVoice"},{"type":"text","text":"), without leaving the UI stuck on "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":".verdictReceived"},{"text":" is dispatched on every ","type":"text"},{"type":"codeVoice","code":".fetch"},{"text":"\/","type":"text"},{"type":"codeVoice","code":".forceFetch"},{"text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing ","type":"text"},{"type":"codeVoice","code":"KillswitchState"},{"text":" or a value derived from it — not by mapping this action. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true},{"text":".","type":"text"}]}],"name":"Note","type":"aside"},{"level":2,"anchor":"Verdict-evaluation-rules","text":"Verdict evaluation rules","type":"heading"},{"inlineContent":[{"code":"KillswitchVerdict.evaluate(_:against:)","type":"codeVoice"},{"type":"text","text":" is fail-open: any unparseable input yields "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":". Checks run in this fixed order, returning "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":" on the first match:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Current version parse."}]},{"type":"text","text":" If "},{"type":"codeVoice","code":"currentVersionString"},{"type":"text","text":" cannot be parsed as a "},{"type":"codeVoice","code":"SemanticVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" immediately."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Minimum supported version."}]},{"type":"text","text":" If "},{"type":"codeVoice","code":"config.minimumSupportedVersion"},{"type":"text","text":" parses and "},{"type":"codeVoice","code":"currentVersion < minVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Explicit blocked versions."}]},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedVersions"},{"type":"text","text":". If any entry parses and equals "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Blocked ranges."}]},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedRanges"},{"type":"text","text":". If any entry parses as a "},{"type":"codeVoice","code":"VersionRange"},{"type":"text","text":" and contains "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Otherwise"}]},{"type":"text","text":" return "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"A blocked verdict carries the config’s "},{"code":"blockedTitle","type":"codeVoice"},{"type":"text","text":", "},{"code":"blockedMessage","type":"codeVoice"},{"type":"text","text":", and "},{"code":"updateURL","type":"codeVoice"},{"type":"text","text":" (parsed via "},{"code":"URL(string:)","type":"codeVoice"},{"type":"text","text":") regardless of which check matched."}],"type":"paragraph"},{"level":2,"anchor":"Remote-config-JSON-shape","text":"Remote config JSON shape","type":"heading"},{"inlineContent":[{"code":"KillswitchConfig","type":"codeVoice"},{"type":"text","text":" derives its "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance from synthesized keys, so the JSON keys match the property names. A representative file:"}],"type":"paragraph"},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.3.0\", \"1.3.1\"],","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update Required\",","    \"blockedMessage\": \"Please update to continue using the app.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every field is optional. An empty object "},{"code":"{}","type":"codeVoice"},{"type":"text","text":" is valid and evaluates to "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" for any version."}],"type":"paragraph"},{"level":2,"anchor":"View-modifier-killswitchBlocker","text":"View modifier: `killswitchBlocker`","type":"heading"},{"inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" ships a SwiftUI view modifier that overlays a non-dismissible blocker whenever the verdict is "},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" and disables the underlying content while it is. Two overloads:"}],"type":"paragraph"},{"code":["extension View {","    \/\/\/ Default blocker — full-screen ultraThinMaterial with title, message,","    \/\/\/ and an optional Update button.","    public func killswitchBlocker(","        verdict: KillswitchVerdict,","        onUpdate: (() -> Void)? = nil","    ) -> some View","","    \/\/\/ Custom blocker — receives the title, message, and `hasUpdateURL`","    \/\/\/ flag and renders whatever you return.","    public func killswitchBlocker<Blocker: View>(","        verdict: KillswitchVerdict,","        @ViewBuilder blocker: @escaping (","            _ title: String?,","            _ message: String?,","            _ hasUpdateURL: Bool","        ) -> Blocker","    ) -> some View","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Both overloads apply "},{"code":".disabled(verdict.isBlocked)","type":"codeVoice"},{"type":"text","text":" to the modified content, so the underlying view tree stops responding to touches while blocked. The blocker layer is rendered as an overlay; supply your own to match the host app’s design system."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","title":"SwiduxPaywall Reference","url":"\/documentation\/swidux\/pluginpaywallreference","role":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"