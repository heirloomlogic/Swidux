de":"\"1.2.3\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"1.2.3-beta.1\"","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"\"1.2.3-beta.1+build42\"","type":"codeVoice"},{"text":". Build metadata after ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" is parsed and discarded. Malformed input returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric.","type":"text"}],"type":"paragraph"},{"text":"VersionRange","level":3,"anchor":"VersionRange","type":"heading"},{"inlineContent":[{"text":"A half-open range ","type":"text"},{"code":"[lowerBound, upperBound)","type":"codeVoice"},{"text":" of semantic versions, used to express ","type":"text"},{"code":"blockedRanges","type":"codeVoice"},{"text":" entries.","type":"text"}],"type":"paragraph"},{"code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Both initializers fail and return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed.","type":"text"}],"type":"paragraph"},{"text":"Action semantics","level":2,"anchor":"Action-semantics","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Effect on state"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned effect"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"if the cache is fresh ("},{"type":"codeVoice","code":"Date() - lastFetch < cacheLifetime"},{"text":" AND ","type":"text"},{"code":"loadCached()","type":"codeVoice"},{"text":" is non-nil), evaluates the cached config and dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" without hitting the network; otherwise behaves like "},{"code":".forceFetch","type":"codeVoice"}]}]],[[{"inlineContent":[{"code":".forceFetch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"calls ","type":"text"},{"code":"service.fetch()","type":"codeVoice"},{"type":"text","text":", persists the result via "},{"code":"service.saveCached(_:)","type":"codeVoice"},{"type":"text","text":", dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":". On thrown error, falls back to "},{"type":"codeVoice","code":"service.loadCached()"},{"type":"text","text":" if available — dispatching "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from the cache "},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed(message)"},{"type":"text","text":" so the UI can surface the error while keeping a usable verdict"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".verdictReceived(verdict, fromNetwork:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"sets ","type":"text"},{"type":"codeVoice","code":"verdict"},{"text":", clears ","type":"text"},{"type":"codeVoice","code":"fetchError"},{"text":"; sets ","type":"text"},{"type":"codeVoice","code":"lastFetch = Date()"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"only when "},{"type":"codeVoice","code":"fromNetwork"},{"type":"text","text":" is true"}]},{"text":" — a cache-served verdict must not slide the freshness window, or a session polling ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":" inside ","type":"text"},{"code":"cacheLifetime","type":"codeVoice"},{"text":" would never consult the network again","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".fetchFailed(message)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"sets ","type":"text"},{"code":"fetchError = message","type":"codeVoice"},{"text":" (does not clear ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"lastFetch","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".openUpdateURL","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"if ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" with a non-nil ","type":"text"},{"code":"updateURL","type":"codeVoice"},{"text":" whose scheme is ","type":"text"},{"code":"https","type":"codeVoice"},{"text":", ","type":"text"},{"code":"itms-apps","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"macappstore","type":"codeVoice"},{"text":", calls the plugin’s ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" closure; otherwise no effect (the URL comes from remote config, so arbitrary schemes are never opened)","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"The plugin only handles its own actions. Any action that "},{"type":"codeVoice","code":"extractAction"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for is ignored — the plugin’s "},{"type":"codeVoice","code":"reduce(...)"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" immediately."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The combination of "},{"type":"codeVoice","code":".forceFetch"},{"type":"text","text":"’s cached-fallback behavior and "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator ("},{"type":"codeVoice","code":"fetchError"},{"type":"text","text":"), without leaving the UI stuck on "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"."}],"type":"paragraph"},{"name":"Note","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":".verdictReceived","type":"codeVoice"},{"text":" is dispatched on every ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":"\/","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing ","type":"text"},{"code":"KillswitchState","type":"codeVoice"},{"text":" or a value derived from it — not by mapping this action. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside"},{"text":"Verdict evaluation rules","level":2,"anchor":"Verdict-evaluation-rules","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"KillswitchVerdict.evaluate(_:against:)"},{"type":"text","text":" is fail-open: any unparseable input yields "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":". Checks run in this fixed order, returning "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":" on the first match:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Current version parse.","type":"text"}]},{"type":"text","text":" If "},{"type":"codeVoice","code":"currentVersionString"},{"type":"text","text":" cannot be parsed as a "},{"type":"codeVoice","code":"SemanticVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" immediately."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Minimum supported version.","type":"text"}]},{"type":"text","text":" If "},{"type":"codeVoice","code":"config.minimumSupportedVersion"},{"type":"text","text":" parses and "},{"type":"codeVoice","code":"currentVersion < minVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Explicit blocked versions.","type":"text"}]},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedVersions"},{"type":"text","text":". If any entry parses and equals "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Blocked ranges.","type":"text"}]},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedRanges"},{"type":"text","text":". If any entry parses as a "},{"type":"codeVoice","code":"VersionRange"},{"type":"text","text":" and contains "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":", return "},