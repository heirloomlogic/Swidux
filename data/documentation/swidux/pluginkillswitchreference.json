},{"code":["public struct KillswitchState: Sendable, Equatable {","    public var verdict: KillswitchVerdict   \/\/ defaults to .unknown","    public var lastFetch: Date?             \/\/ nil until first successful fetch","    public var fetchError: String?          \/\/ localized description of last failure","","    public var isBlocked: Bool              \/\/ delegates to verdict.isBlocked","    public var canOpenUpdateURL: Bool       \/\/ .blocked AND updateURL is non-nil","","    public init(","        verdict: KillswitchVerdict = .unknown,","        lastFetch: Date? = nil,","        fetchError: String? = nil","    )","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"isBlocked"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":" are convenience computed properties. Bind UI off them rather than pattern-matching ","type":"text"},{"type":"codeVoice","code":"verdict"},{"text":" everywhere.","type":"text"}],"type":"paragraph"},{"text":"KillswitchAction","anchor":"KillswitchAction","level":3,"type":"heading"},{"inlineContent":[{"text":"The plugin’s local action enum. Wrap these in your root action through the case you provide at registration.","type":"text"}],"type":"paragraph"},{"code":["public enum KillswitchAction: Sendable {","    case fetch","    case forceFetch","    case verdictReceived(KillswitchVerdict)","    case fetchFailed(String)","    case openUpdateURL","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":".fetch"},{"text":" is the launch-time entry point — it consults the cache and skips the network when the cached config is fresh. ","type":"text"},{"type":"codeVoice","code":".forceFetch"},{"text":" always hits the network, suitable for pull-to-refresh or post-update health checks.","type":"text"}],"type":"paragraph"},{"text":"KillswitchService","anchor":"KillswitchService","level":3,"type":"heading"},{"inlineContent":[{"text":"A closure-based service that fetches and caches the remote config. Substitute the live factory in production and the mock factory in tests.","type":"text"}],"type":"paragraph"},{"code":["public struct KillswitchService: Sendable {","    public var fetch: @Sendable () async throws -> KillswitchConfig","    public var loadCached: @Sendable () -> KillswitchConfig?","    public var saveCached: @Sendable (KillswitchConfig) -> Void","    public let cacheLifetime: TimeInterval","","    public init(","        fetch: @escaping @Sendable () async throws -> KillswitchConfig,","        loadCached: @escaping @Sendable () -> KillswitchConfig?,","        saveCached: @escaping @Sendable (KillswitchConfig) -> Void,","        cacheLifetime: TimeInterval","    )","","    public static func live(","        endpoint: URL,","        fetchTimeout: TimeInterval = 10,","        cacheLifetime: TimeInterval = 3600,","        session: URLSession = .shared","    ) -> KillswitchService","","    public static func mock(","        result: @escaping @Sendable () async throws -> KillswitchConfig = { KillswitchConfig() },","        cached: KillswitchConfig? = nil,","        cacheLifetime: TimeInterval = 3600","    ) -> KillswitchService","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"live(endpoint:)"},{"text":" decodes JSON from ","type":"text"},{"type":"codeVoice","code":"endpoint"},{"text":" with a ","type":"text"},{"type":"codeVoice","code":"reloadIgnoringLocalCacheData"},{"text":" policy and persists the result to a ","type":"text"},{"type":"codeVoice","code":"swidux-killswitch.json"},{"text":" file in the user’s caches directory. ","type":"text"},{"type":"codeVoice","code":"mock(result:cached:)"},{"text":" keeps an in-memory cache and lets a test inject a closure that returns or throws.","type":"text"}],"type":"paragraph"},{"text":"KillswitchConfig","anchor":"KillswitchConfig","level":3,"type":"heading"},{"inlineContent":[{"text":"The decoded shape of the remote JSON. All fields are optional — a config with every field ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" evaluates to ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["public struct KillswitchConfig: Codable, Sendable, Equatable {","    public var minimumSupportedVersion: String?","    public var blockedVersions: [String]?","    public var blockedRanges: [String]?","    public var blockedTitle: String?","    public var blockedMessage: String?","    public var updateURL: String?","","    public init(","        minimumSupportedVersion: String? = nil,","        blockedVersions: [String]? = nil,","        blockedRanges: [String]? = nil,","        blockedTitle: String? = nil,","        blockedMessage: String? = nil,","        updateURL: String? = nil","    )","}"],"syntax":"swift","type":"codeListing"},{"text":"KillswitchVerdict","anchor":"KillswitchVerdict","level":3,"type":"heading"},{"inlineContent":[{"text":"The result of evaluating a config against the running version.","type":"text"}],"type":"paragraph"},{"code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":".unknown"},{"text":" is the initial state before any fetch has been attempted. ","type":"text"},{"type":"codeVoice","code":"evaluate(_:against:)"},{"text":" always returns ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"text":" — never ","type":"text"},{"type":"codeVoice","code":".unknown"},{"text":". ","type":"text"},{"type":"codeVoice","code":"isBlocked"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" only for the ","type":"text"},{"type":"codeVoice","code":".blocked"},{"text":" case.","type":"text"}],"type":"paragraph"},{"text":"SemanticVersion","anchor":"SemanticVersion","level":3,"type":"heading"},{"inlineContent":[{"text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests.","type":"text"}],"type":"paragraph"},{"code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The string initializer accepts ","type":"text"},{"type":"codeVoice","code":"\"1.2.3\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"1.2.3-beta.1\""},{"text":", and ","type":"text"},{"type":"codeVoice","code":"\"1.2.3-beta.1+build42\""},{"text":". Build metadata after ","type":"text"},{"type":"codeVoice","code":"+"},{"text":" is parsed and discarded. Malformed input returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric.","type":"text"}],"type":"paragraph"},{"text":"VersionRange","anchor":"VersionRange","level":3,"type":"heading"},{"inlineContent":[{"text":"A half-open range ","type":"text"},{"type":"codeVoice","code":"[lowerBound, upperBound)"},{"text":" of semantic versions, used to express ","type":"text"},{"type":"codeVoice","code":"blockedRanges"},{"text":" entries.","type":"text"}],"type":"paragraph"},{"code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Both initializers fail and return ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed.","type":"text"}],"type":"paragraph"},{"text":"Action semantics","anchor":"Action-semantics","level":2,"type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Effect on state"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned effect"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}],[{"inlineContent":[{"text":"if the cache is fresh (","type":"text"},{"type":"codeVoice","code":"Date() - lastFetch < cacheLifetime"},{"text":" AND ","type":"text"},{"type":"codeVoice","code":"loadCached()"},{"text":" is non-nil), evaluates the cached config and dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" without hitting the network; otherwise behaves like "},{"type":"codeVoice","code":".forceFetch"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".forceFetch"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"calls ","type":"text"},{"type":"codeVoice","code":"service.fetch()"},{"type":"text","text":", persists the result via "},{"type":"codeVoice","code":"service.saveCached(_:)"},{"text":", dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":". On thrown error, falls back to ","type":"text"},{"type":"codeVoice","code":"service.loadCached()"},{"text":" if available — dispatching ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" from the cache ","type":"text"},{"type":"strong","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" "},{"code":".fetchFailed(message)","type":"codeVoice"},{"type":"text","text":" so the UI can surface the error while keeping a usable verdict"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".verdictReceived(verdict)"}]}],[{"type":"paragraph","inlineContent":[{"text":"sets ","type":"text"},{"type":"codeVoice","code":"verdict"},{"text":", sets ","type":"text"},{"type":"codeVoice","code":"lastFetch = Date()"},{"text":", clears ","type":"text"},{"type":"codeVoice","code":"fetchError"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetchFailed(message)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"sets "},{"type":"codeVoice","code":"fetchError = message"},{"type":"text","text":" (does not clear "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":" or "},{"type":"codeVoice","code":"lastFetch"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".openUpdateURL"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"if "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":" is "},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" with a non-nil "},{"code":"updateURL","type":"codeVoice"},{"type":"text","text":", calls the plugin’s "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" closure; otherwise no effect"}]}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin only handles its own actions. Any action that "},{"code":"extractAction","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for is ignored — the plugin’s "},{"code":"reduce(...)","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" immediately."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The combination of "},{"code":".forceFetch","type":"codeVoice"},{"type":"text","text":"’s cached-fallback behavior and "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator ("},{"code":"fetchError","type":"codeVoice"},{"type":"text","text":"), without leaving the UI stuck on "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":"."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":".verdictReceived","type":"codeVoice"},{"text":" is dispatched on every ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":"\/","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing ","type":"text"},{"code":"KillswitchState","type":"codeVoice"},{"text":" or a value derived from it — not by mapping this action. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"style":"note","type":"aside","name":"Note"},{"anchor":"Verdict-evaluation-rules","level":2,"text":"Verdict evaluation rules","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"KillswitchVerdict.evaluate(_:against:)","type":"codeVoice"},{"type":"text","text":" is fail-open: any unparseable input yields "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":". Checks run in this fixed order, returning "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":" on the first match:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Current version parse."}]},{"type":"text","text":" If "},{"type":"codeVoice","code":"currentVersionString"},{"type":"text","text":" cannot be parsed as a "},{"type":"codeVoice","code":"SemanticVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" immediately."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Minimum supported version."}]},{"type":"text","text":" If "},{"type":"codeVoice","code":"config.minimumSupportedVersion"},{"type":"text","text":" parses and "},{"type":"codeVoice","code":"currentVersion < minVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Explicit blocked versions."}]},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedVersions"},{"type":"text","text":". If any entry parses and equals "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Blocked ranges."}]},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedRanges"},{"type":"text","text":". If any entry parses as a "},{"type":"codeVoice","code":"VersionRange"},{"type":"text","text":" and contains "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Otherwise"}]},{"type":"text","text":" return "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A blocked verdict carries the config’s "},{"code":"blockedTitle","type":"codeVoice"},{"type":"text","text":", "},{"code":"blockedMessage","type":"codeVoice"},{"type":"text","text":", and "},{"code":"updateURL","type":"codeVoice"},{"type":"text","text":" (parsed via "},{"code":"URL(string:)","type":"codeVoice"},{"type":"text","text":") regardless of which check matched."}]},{"anchor":"Remote-config-JSON-shape","level":2,"text":"Remote config JSON shape","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"KillswitchConfig","type":"codeVoice"},{"type":"text","text":" derives its "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance from synthesized keys, so the JSON keys match the property names. A representative file:"}]},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.3.0\", \"1.3.1\"],","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update Required\",","    \"blockedMessage\": \"Please update to continue using the app.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every field is optional. An empty object "},{"code":"{}","type":"codeVoice"},{"type":"text","text":" is valid and evaluates to "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" for any version."}]},{"anchor":"View-modifier-killswitchBlocker","level":2,"text":"View modifier: `killswitchBlocker`","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" ships a SwiftUI view modifier that overlays a non-dismissible blocker whenever the verdict is "},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" and disables the underlying content while it is. Two overloads:"}]},{"code":["extension View {","    \/\/\/ Default blocker — full-screen ultraThinMaterial with title, message,","    \/\/\/ and an optional Update button.","    public func killswitchBlocker(","        verdict: KillswitchVerdict,","        onUpdate: (() -> Void)? = nil","    ) -> some View","","    \/\/\/ Custom blocker — receives the title, message, and `hasUpdateURL`","    \/\/\/ flag and renders whatever you return.","    public func killswitchBlocker<Blocker: View>(","        verdict: KillswitchVerdict,","        @ViewBuilder blocker: @escaping (","            _ title: String?,","            _ message: String?,","            _ hasUpdateURL: Bool","        ) -> Blocker","    ) -> some View","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both overloads apply "},{"code":".disabled(verdict.isBlocked)","type":"codeVoice"},{"type":"text","text":" to the modified content, so the underlying view tree stops responding to touches while blocked. The blocker layer is rendered as an overlay; supply your own to match the host app’s design system."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Public API surface for the "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the servi