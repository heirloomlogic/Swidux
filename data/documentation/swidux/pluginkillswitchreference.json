:"config.blockedVersions"},{"text":". If any entry parses and equals ","type":"text"},{"type":"codeVoice","code":"currentVersion"},{"text":", return ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Blocked ranges.","type":"text"}]},{"text":" Iterate ","type":"text"},{"code":"config.blockedRanges","type":"codeVoice"},{"type":"text","text":". If any entry parses as a "},{"code":"VersionRange","type":"codeVoice"},{"type":"text","text":" and contains "},{"code":"currentVersion","type":"codeVoice"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Otherwise","type":"text"}],"type":"strong"},{"type":"text","text":" return "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"A blocked verdict carries the config’s "},{"type":"codeVoice","code":"blockedTitle"},{"type":"text","text":", "},{"code":"blockedMessage","type":"codeVoice"},{"type":"text","text":", and "},{"code":"updateURL","type":"codeVoice"},{"type":"text","text":" (parsed via "},{"type":"codeVoice","code":"URL(string:)"},{"type":"text","text":") regardless of which check matched."}],"type":"paragraph"},{"text":"Remote config JSON shape","anchor":"Remote-config-JSON-shape","level":2,"type":"heading"},{"inlineContent":[{"code":"KillswitchConfig","type":"codeVoice"},{"type":"text","text":" derives its "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance from synthesized keys, so the JSON keys match the property names. A representative file:"}],"type":"paragraph"},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.3.0\", \"1.3.1\"],","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update Required\",","    \"blockedMessage\": \"Please update to continue using the app.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"text":"Every field is optional. An empty object ","type":"text"},{"type":"codeVoice","code":"{}"},{"text":" is valid and evaluates to ","type":"text"},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" for any version."}],"type":"paragraph"},{"level":2,"type":"heading","text":"View modifier: `killswitchBlocker`","anchor":"View-modifier-killswitchBlocker"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" ships a SwiftUI view modifier that overlays a non-dismissible blocker whenever the verdict is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" and disables the underlying content while it is. Two overloads:","type":"text"}],"type":"paragraph"},{"code":["extension View {","    \/\/\/ Default blocker — full-screen ultraThinMaterial with title, message,","    \/\/\/ and an optional Update button.","    public func killswitchBlocker(","        verdict: KillswitchVerdict,","        onUpdate: (() -> Void)? = nil","    ) -> some View","","    \/\/\/ Custom blocker — receives the title, message, and `hasUpdateURL`","    \/\/\/ flag and renders whatever you return.","    public func killswitchBlocker<Blocker: View>(","        verdict: KillswitchVerdict,","        @ViewBuilder blocker: @escaping (","            _ title: String?,","            _ message: String?,","            _ hasUpdateURL: Bool","        ) -> Blocker","    ) -> some View","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Both overloads apply "},{"code":".disabled(verdict.isBlocked)","type":"codeVoice"},{"type":"text","text":" to the modified content, so the underlying view tree stops responding to touches while blocked. The blocker layer is rendered as an overlay; supply your own to match the host app’s 