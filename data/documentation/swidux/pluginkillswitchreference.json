pe":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Effect on state","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned effect"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"if the cache is fresh ("},{"code":"Date() - lastFetch < cacheLifetime","type":"codeVoice"},{"type":"text","text":" AND "},{"code":"loadCached()","type":"codeVoice"},{"type":"text","text":" is non-nil), evaluates the cached config and dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" without hitting the network; otherwise behaves like "},{"type":"codeVoice","code":".forceFetch"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".forceFetch","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"calls "},{"type":"codeVoice","code":"service.fetch()"},{"type":"text","text":", persists the result via "},{"type":"codeVoice","code":"service.saveCached(_:)"},{"text":", dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":". On thrown error, falls back to ","type":"text"},{"code":"service.loadCached()","type":"codeVoice"},{"text":" if available — dispatching ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from the cache ","type":"text"},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"text":" ","type":"text"},{"code":".fetchFailed(message)","type":"codeVoice"},{"text":" so the UI can surface the error while keeping a usable verdict","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".verdictReceived(verdict)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"sets ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":", sets "