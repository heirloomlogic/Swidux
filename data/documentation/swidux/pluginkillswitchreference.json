r: String? = nil","    )","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isBlocked"},{"type":"text","text":" and "},{"type":"codeVoice","code":"canOpenUpdateURL"},{"type":"text","text":" are convenience computed properties. Bind UI off them rather than pattern-matching "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":" everywhere."}]},{"text":"KillswitchAction","level":3,"type":"heading","anchor":"KillswitchAction"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin’s local action enum. Wrap these in your root action through the case you provide at registration."}]},{"syntax":"swift","type":"codeListing","code":["public enum KillswitchAction: Sendable {","    case fetch","    case forceFetch","    case verdictReceived(KillswitchVerdict)","    case fetchFailed(String)","    case openUpdateURL","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"},{"type":"text","text":" is the launch-time entry point — it consults the cache and skips the network when the cached config is fresh. "},{"type":"codeVoice","code":".forceFetch"},{"type":"text","text":" always hits the network, suitable for pull-to-refresh or post-update health checks."}]},{"text":"KillswitchService","level":3,"type":"heading","anchor":"KillswitchService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure-based service that fetches and caches the remote config. Substitute the live factory in production and the mock factory in tests."}]},{"syntax":"swift","type":"codeListing","code":["public struct KillswitchService: Sendable {","    public var fetch: @Sendable () async throws -> KillswitchConfig","    public var loadCached: @Sendable () -> KillswitchConfig?","    public var saveCached: @Sendable (KillswitchConfig) -> Void","    public let cacheLifetime: TimeInterval","","    public init(","        fetch: @escaping @Sendable () async throws -> KillswitchConfig,","        loadCached: @escaping @Sendable () -