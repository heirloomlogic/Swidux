calized description of last failure","","    public var isBlocked: Bool              \/\/ delegates to verdict.isBlocked","    public var canOpenUpdateURL: Bool       \/\/ .blocked AND updateURL is non-nil","","    public init(","        verdict: KillswitchVerdict = .unknown,","        lastFetch: Date? = nil,","        fetchError: String? = nil","    )","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"isBlocked","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"canOpenUpdateURL","type":"codeVoice"},{"text":" are convenience computed properties. Bind UI off them rather than pattern-matching ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" everywhere.","type":"text"}]},{"level":3,"anchor":"KillswitchAction","type":"heading","text":"KillswitchAction"},{"type":"paragraph","inlineContent":[{"text":"The plugin’s local action enum. Wrap these in your root action through the case you provide at registration.","type":"text"}]},{"code":["public enum KillswitchAction: Sendable {","    case fetch","    case forceFetch","    case verdictReceived(KillswitchVerdict)","    case fetchFailed(String)","    case openUpdateURL","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":".fetch","type":"codeVoice"},{"text":" is the launch-time entry point — it consults the cache and skips the network when the cached config is fresh. ","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":" always hits the network, suitable for pull-to-refresh or post-update health checks.","type":"text"}]},{"level":3,"anchor":"KillswitchService","type":"heading","text":"KillswitchService"},{"type":"paragraph","inlineContent":[{"text":"A closure-based service that fetches and caches the remote config. Substitute the live factory in production and the mock factory in tests.","type":"text"}]},{"code":["public struct KillswitchService: Sendable {","    public var fetch: @Sendable () async throws -> KillswitchConfig","    public var loadCached: @Sendable () -> KillswitchConfig?","    public var saveCached: @Sendable (KillswitchConfig) -> Void","    public let cacheLifetime: TimeInterval","","    public init(","        fetch: @escaping @Sendable () async throws -> KillswitchConfig,","        loadCached: @escaping @Sendable () -> KillswitchConfig?,","        saveCached: @escaping @Sendable (KillswitchConfig) -> Void,","        cacheLifetime: TimeInterval","    )","","    public static func live(","        endpoint: URL,","        fetchTimeout: TimeInterval = 10,","        cacheLifetime: TimeInterval = 3600,","        session: URLSession = .shared","    ) -> KillswitchService","","    public static func mock(","        result: @escaping @Sendable () async throws -> KillswitchConfig = { KillswitchConfig() },","        cached: KillswitchConfig? = nil,","        cacheLifetime: TimeInterval = 3600","    ) -> KillswitchService","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"live(endpoint:)","type":"codeVoice"},{"text":" decodes JSON from ","type":"text"},{"code":"endpoint","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"reloadIgnoringLocalCacheData","type":"codeVoice"},{"text":" policy and persists the result to a ","type":"text"},{"code":"swidux-killswitch.json","type":"codeVoice"},{"text":" file in the user’s caches directory. ","type":"text"},{"code":"mock(result:cached:)","type":"codeVoice"},{"text":" keeps an in-memory cache and lets a test inject a closure that returns or throws.","type":"text"}]},{"level":3,"anchor":"KillswitchConfig","type":"heading","text":"KillswitchConfig"},{"type":"paragraph","inlineContent":[{"text":"The decoded shape of the remote JSON. All fields are optional — a config with every field ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" evaluates to ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["public struct KillswitchConfig: Codable, Sendable, Equatable {","    public var minimumSupportedVersion: String?","    public var blockedVersions: [String]?","    public var blockedRanges: [String]?","    public var blockedTitle: String?","    public var blockedMessage: String?","    public var updateURL: String?","","    public init(","        minimumSupportedVersion: String? = nil,","        blockedVersions: [String]? = nil,","        blockedRanges: [String]? = nil,","        blockedTitle: String? = nil,","        blockedMessage: String? = nil,","        updateURL: String? = nil","    )","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"KillswitchVerdict","type":"heading","text":"KillswitchVerdict"},{"type":"paragraph","inlineContent":[{"text":"The result of evaluating a config against the running version.","type":"text"}]},{"code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":".unknown","type":"codeVoice"},{"text":" is the initial state before any fetch has been attempted. ","type":"text"},{"code":"evaluate(_:against:)","type":"codeVoice"},{"text":" always returns ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":" — never ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":". ","type":"text"},{"code":"isBlocked","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" only for the ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" case.","type":"text"}]},{"level":3,"anchor":"SemanticVersion","type":"heading","text":"SemanticVersion"},{"type":"paragraph","inlineContent":[{"text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests.","type":"text"}]},{"code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The string initializer accepts ","type":"text"},{"code":"\"1.2.3\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"1.2.3-beta.1\"","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"\"1.2.3-beta.1+build42\"","type":"codeVoice"},{"text":". Build metadata after ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" is parsed and discarded. Malformed input returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric.","type":"text"}]},{"level":3,"anchor":"VersionRange","type":"heading","text":"VersionRange"},{"type":"paragraph","inlineContent":[{"text":"A half-open range ","type":"text"},{"code":"[lowerBound, upperBound)","type":"codeVoice"},{"text":" of semantic versions, used to express ","type":"text"},{"code":"blockedRanges","type":"codeVoice"},{"text":" entries.","type":"text"}]},{"code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Both initializers fail and return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed.","type":"text"}]},{"level":2,"anchor":"Action-semantics","type":"heading","text":"Action semantics"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Effect on state","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Returned effect","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":".fetch"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}],[{"type":"paragraph","inlineContent":[{"text":"if the cache is fresh (","type":"text"},{"code":"Date() - lastFetch < cacheLifetime","type":"codeVoice"},{"text":" AND ","type":"text"},{"code":"loadCached()","type":"codeVoice"},{"text":" is non-nil), evaluates the cached config and dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" without hitting the network; otherwise behaves like ","type":"text"},{"code":".forceFetch","type":"codeVoice"}]}]],[[{"inlineContent":[{"code":".forceFetch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"calls ","type":"text"},{"code":"service.fetch()","type":"codeVoice"},{"text":", persists the result via ","type":"text"},{"code":"service.saveCached(_:)","type":"codeVoice"},{"text":", dispatches ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"type":"text","text":". On thrown error, falls back to "},{"type":"codeVoice","code":"service.loadCached()"},{"type":"text","text":" if available — dispatching "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from the cache "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed(message)"},{"text":" so the UI can surface the error while keeping a usable verdict","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".verdictReceived(verdict)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"sets "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":", sets "},{"code":"lastFetch = Date()","type":"codeVoice"},{"type":"text","text":", clears "},{"code":"fetchError","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".fetchFailed(message)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"sets "},{"type":"codeVoice","code":"fetchError = message"},{"type":"text","text":" (does not clear "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":" or "},{"type":"codeVoice","code":"lastFetch"},{"type":"text","text":")"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":".openUpdateURL"}],"type":"paragraph"}],[{"inlineContent":[{"text":"none","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"if ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" with a non-nil "},{"type":"codeVoice","code":"updateURL"},{"type":"text","text":", calls the plugin’s "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" closure; otherwise no effect"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"The plugin only handles its own actions. Any action that "},{"type":"codeVoice","code":"extractAction"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for is ignored — the plugin’s "},{"type":"codeVoice","code":"reduce(...)"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" immediately."}],"type":"paragraph"},{"inlineContent":[{"text":"The combination of ","type":"text"},{"type":"codeVoice","code":".forceFetch"},{"type":"text","text":"’s cached-fallback behavior and "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator ("},{"type":"codeVoice","code":"fetchError"},{"type":"text","text":"), without leaving the UI stuck on "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Verdict-evaluation-rules","type":"heading","text":"Verdict evaluation rules"},{"inlineContent":[{"type":"codeVoice","code":"KillswitchVerdict.evaluate(_:against:)"},{"type":"text","text":" is fail-open: any unparseable input yields "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":". Checks run in this fixed order, returning "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":" on the first match:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Current version parse.","type":"text"}]},{"type":"text","text":" If "},{"type":"codeVoice","code":"currentVersionString"},{"type":"text","text":" cannot be parsed as a "},{"type":"codeVoice","code":"SemanticVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" immediately."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Minimum supported version."}]},{"type":"text","text":" If "},{"type":"codeVoice","code":"config.minimumSupportedVersion"},{"type":"text","text":" parses and "},{"type":"codeVoice","code":"currentVersion < minVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Explicit blocked versions.","type":"text"}]},{"text":" Iterate ","type":"text"},{"type":"codeVoice","code":"config.blockedVersions"},{"type":"text","text":". If any entry parses and equals "},{"type":"codeVoice","code":"currentVersion"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Blocked ranges."}]},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedRanges"},{"type":"text","text":". If any entry parses as a "},{"type":"codeVoice","code":"VersionRange"},{"type":"text","text":" and contains "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Otherwise"}]},{"type":"text","text":" return "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"A blocked verdict carries the config’s "},{"type":"codeVoice","code":"blockedTitle"},{"text":", ","type":"text"},{"type":"codeVoice","code":"blockedMessage"},{"type":"text","text":", and "},{"type":"codeVoice","code":"updateURL"},{"type":"text","text":" (parsed via "},{"type":"codeVoice","code":"URL(string:)"},{"type":"text","text":") regardless of which check matched."}],"type":"paragraph"},{"type":"heading","text":"Remote config JSON shape","level":2,"anchor":"Remote-config-JSON-shape"},{"inlineContent":[{"type":"codeVoice","code":"KillswitchConfig"},{"type":"text","text":" derives its "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance from synthesized keys, so the JSON keys match the property names. A representative file:"}],"type":"paragraph"},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.3.0\", \"1.3.1\"],","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update Required\",","    \"blockedMessage\": \"Please update to continue using the app.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing","syntax":"json"},{"inlineContent":[{"type":"text","text":"Every field is optional. An empty object "},{"type":"codeVoice","code":"{}"},{"type":"text","text":" is valid and evaluates to "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":" for any version."}],"type":"paragraph"},{"text":"View modifier: `killswitchBlocker`","anchor":"View-modifier-killswitchBlocker","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" ships a SwiftUI view modifier that overlays a non-dismissible blocker whenever the verdict is "},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" and disables the underlying content while it is. Two overloads:"}],"type":"paragraph"},{"type":"codeListing","code":["extension View {","    \/\/\/ Default blocker — full-screen ultraThinMaterial with title, message,","    \/\/\/ and an optional Update button.","    public func killswitchBlocker(","        verdict: KillswitchVerdict,","        onUpdate: (() -> Void)? = nil","    ) -> some View","","    \/\/\/ Custom blocker — receives the title, message, and `hasUpdateURL`","    \/\/\/ flag and renders whatever you return.","    public func killswitchBlocker<Blocker: View>(","        verdict: KillswitchVerdict,","        @ViewBuilder blocker: @escaping (","            _ title: String?,","            _ message: String?,","            _ hasUpdateURL: Bool","        ) -> Blocker","    ) -> some View","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Both overloads apply ","type":"text"},{"code":".disabled(verdict.isBlocked)","type":"codeVoice"},{"type":"text","text":" to the modified content, so the underlying view tree stops responding to touches while blocked. The blocker layer is rendered as an overlay; supply your own to match the host app’s design system."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article","title":"SwiduxKillswitch Reference"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"references":{"doc://Swidux/documentation/Swidux/UndoPlugin":{"title":"UndoPlugin","url":"\/documentation\/swidux\/undoplugin","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}]},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"title":"Persistence Middleware","url":"\/documentation\/swidux\/persistencemiddlewareguide","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","role":"article","kind":"article","abstract":[{"text":"Configure automatic persistence that drains entity cha