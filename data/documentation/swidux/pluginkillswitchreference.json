 nil","    )","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","anchor":"KillswitchVerdict","level":3,"text":"KillswitchVerdict"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The result of evaluating a config against the running version."}]},{"code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":".unknown","type":"codeVoice"},{"type":"text","text":" is the initial state before any fetch has been attempted. "},{"code":"evaluate(_:against:)","type":"codeVoice"},{"type":"text","text":" always returns "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" or "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":" — never "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":". "},{"code":"isBlocked","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" only for the "},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" case."}]},{"type":"heading","anchor":"SemanticVersion","level":3,"text":"SemanticVersion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests."}]},{"code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The string initializer accepts "},{"code":"\"1.2.3\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"1.2.3-beta.1\"","type":"codeVoice"},{"type":"text","text":", and "},{"code":"\"1.2.3-beta.1+build42\"","type":"codeVoice"},{"type":"text","text":". Build metadata after "},{"code":"+","type":"codeVoice"},{"type":"text","text":" is parsed and discarded. Malformed input returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric."}]},{"type":"heading","anchor":"VersionRange","level":3,"text":"VersionRange"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A half-open range "},{"code":"[lowerBound, upperBound)","type":"codeVoice"},{"type":"text","text":" of semantic versions, used to express "},{"code":"blockedRanges","type":"codeVoice"},{"type":"text","text":" entries."}]},{"code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both initializers fail and return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed."}]},{"type":"heading","anchor":"Action-semantics","level":2,"text":"Action semantics"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Effect on state"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Returned effect"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".fetch"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"if the cache is fresh ("},{"type":"codeVoice","code":"Date() - lastFetch < cacheLifetime"},{"type":"text","text":" AND "},{"type":"codeVoice","code":"loadCached()"},{"type":"text","text":" is non-nil), evaluates the cached config and dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" without hitting the network; otherwise behaves like "},{"type":"codeVoice","code":".forceFetch"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".forceFetch"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"calls "},{"type":"codeVoice","code":"service.fetch()"},{"type":"text","text":", persists the result via "},{"type":"codeVoice","code":"service.saveCached(_:)"},{"type":"text","text":", dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":". On thrown error, falls back to "},{"code":"service.loadCached()","type":"codeVoice"},{"text":" if available — dispatching ","type":"text"},{"code":".verdictReceived(...)","type":"codeVoice"},{"text":" from the cache ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":".fetchFailed(message)","type":"codeVoice"},{"text":" so the UI can surface the error while keeping a usable verdict","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".verdictReceived(verdict)","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"sets ","type":"text"},{"code":"verdict","type":"codeVoice"},{"type":"text","text":", sets "},{"type":"codeVoice","code":"lastFetch = Date()"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"fetchError"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".fetchFailed(message)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"sets "},{"code":"fetchError = message","type":"codeVoice"},{"type":"text","text":" (does not clear "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":" or "},{"code":"lastFetch","type":"codeVoice"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".openUpdateURL"}]}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"if "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":" is "},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" with a non-nil "},{"code":"updateURL","type":"codeVoice"},{"type":"text","text":", calls the plugin’s "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" closure; otherwise no effect"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin only handles its own actions. Any action that "},{"type":"codeVoice","code":"extractAction"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for is ignored — the plugin’s "},{"type":"codeVoice","code":"reduce(...)"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" immediately."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The combination of "},{"type":"codeVoice","code":".forceFetch"},{"type":"text","text":"’s cached-fallback behavior and "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator ("},{"type":"codeVoice","code":"fetchError"},{"type":"text","text":"), without leaving the UI stuck on "},{"type":"codeVoice","code":".unknown"},{"type":"text","text":"."}]},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"code":".verdictReceived","type":"codeVoice"},{"type":"text","text":" is dispatched on every "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":"\/"},{"code":".forceFetch","type":"codeVoice"},{"type":"text","text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing "},{"type":"codeVoice","code":"KillswitchState"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","name":"Note"},{"type":"heading","anchor":"Verdict-evaluation-rules","level":2,"text":"Verdict evaluation rules"},{"type":"paragraph","inlineContent":[{"code":"KillswitchVerdict.evaluate(_:against:)","type":"codeVoice"},{"type":"text","text":" is fail-open: any unparseable input yields "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":". Checks run in this fixed order, returning "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":" on the first match:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Current version parse.","type":"text"}]},{"text":" If ","type":"text"},{"code":"currentVersionString","type":"codeVoice"},{"text":" cannot be parsed as a ","type":"text"},{"code":"SemanticVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" immediately.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Minimum supported version."}],"type":"strong"},{"type":"text","text":" If "},{"code":"config.minimumSupportedVersion","type":"codeVoice"},{"text":" parses and ","type":"text"},{"code":"currentVersion < minVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Explicit blocked versions."}],"type":"strong"},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedVersions"},{"type":"text","text":". If any entry parses and equals "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Blocked ranges."}]},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedRanges"},{"type":"text","text":". If any entry parses as a "},{"type":"codeVoice","code":"VersionRange"},{"type":"text","text":" and contains "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":", return "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Otherwise"}]},{"type":"text","text":" return "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A blocked verdict carries the config’s "},{"code":"blockedTitle","type"