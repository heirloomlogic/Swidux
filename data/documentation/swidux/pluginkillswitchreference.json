{"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference"},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Swidux"}],"title":"SwiduxKillswitch Reference"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"text":"Public API surface for the ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"generated":true,"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference"}],"primaryContentSections":[{"content":[{"level":2,"text":"Library target","anchor":"Library-target","type":"heading"},{"inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" ships as its own product in the ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":" package. Add it to a target’s dependencies in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" and import it where you wire the plugin:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxKillswitch"],"type":"codeListing"},{"inlineContent":[{"text":"The target depends on ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":" and links against ","type":"text"},{"code":"UIKit","type":"codeVoice"},{"text":" on iOS \/ ","type":"text"},{"code":"AppKit","type":"codeVoice"},{"text":" on macOS for the default URL-opening behavior.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Types","anchor":"Types","type":"heading"},{"level":3,"text":"KillswitchPlugin","anchor":"KillswitchPlugin","type":"heading"},{"inlineContent":[{"text":"The domain plugin. Conforms to ","type":"text"},{"code":"SwiduxPlugin","type":"codeVoice"},{"text":" and is generic over the host app’s root state and action types.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@MainActor","public struct KillswitchPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, KillswitchState>,","        action toRootAction: @escaping @Sendable (KillswitchAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> KillswitchAction?,","        service: KillswitchService,","        appVersion: @escaping @Sendable () -> String,","        openURL: @escaping @Sendable (URL) async -> Void = { \/* UIApplication \/ NSWorkspace *\/ }","    )","}"],"type":"codeListing"},{"inlineContent":[{"text":"The default ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" calls ","type":"text"},{"code":"UIApplication.shared.open(_:)","type":"codeVoice"},{"text":" on iOS and ","type":"text"},{"code":"NSWorkspace.shared.open(_:)","type":"codeVoice"},{"text":" on macOS, both hopped to ","type":"text"},{"code":"MainActor","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":3,"text":"KillswitchState","anchor":"KillswitchState","type":"heading"},{"inlineContent":[{"text":"The state slice the plugin owns. Default-constructed values match a fresh, never-fetched session.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct KillswitchState: Sendable, Equatable {","    public var verdict: KillswitchVerdict   \/\/ defaults to .unknown","    public var lastFetch: Date?             \/\/ nil until first successful fetch","    public var fetchError: String?          \/\/ localized description of last failure","","    public var isBlocked: Bool              \/\/ delegates to verdict.isBlocked","    public var canOpenUpdateURL: Bool       \/\/ .blocked AND updateURL is non-nil","","    public init(","        verdict: KillswitchVerdict = .unknown,","        lastFetch: Date? = nil,","        fetchError: String? = nil","    )","}"],"type":"codeListing"},{"inlineContent":[{"code":"isBlocked","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"canOpenUpdateURL","type":"codeVoice"},{"text":" are convenience computed properties. Bind UI off them rather than pattern-matching ","type":"text"},{"code":"verdict","type":"codeVoice"},{"text":" everywhere.","type":"text"}],"type":"paragraph"},{"level":3,"text":"KillswitchAction","anchor":"KillswitchAction","type":"heading"},{"inlineContent":[{"text":"The plugin’s local action enum. Wrap these in your root action through the case you provide at registration.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public enum KillswitchAction: Sendable {","    case fetch","    case forceFetch","    case verdictReceived(KillswitchVerdict, fromNetwork: Bool)","    case fetchFailed(String)","    case openUpdateURL","}"],"type":"codeListing"},{"inlineContent":[{"code":".fetch","type":"codeVoice"},{"text":" is the launch-time entry point — it consults the cache and skips the network when the cached config is fresh. ","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":" always hits the network, suitable for pull-to-refresh or post-update health checks.","type":"text"}],"type":"paragraph"},{"level":3,"text":"KillswitchService","anchor":"KillswitchService","type":"heading"},{"inlineContent":[{"text":"A closure-based service that fetches and caches the remote config. Substitute the live factory in production and the mock factory in tests.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct KillswitchService: Sendable {","    public var fetch: @Sendable () async throws -> KillswitchConfig","    public var loadCached: @Sendable () -> KillswitchConfig?","    public var saveCached: @Sendable (KillswitchConfig) -> Void","    public let cacheLifetime: TimeInterval","","    public init(","        fetch: @escaping @Sendable () async throws -> KillswitchConfig,","        loadCached: @escaping @Sendable () -> KillswitchConfig?,","        saveCached: @escaping @Sendable (KillswitchConfig) -> Void,","        cacheLifetime: TimeInterval","    )","","    public static func live(","        endpoint: URL,","        fetchTimeout: TimeInterval = 10,","        cacheLifetime: TimeInterval = 3600,","        session: URLSession = .shared","    ) -> KillswitchService","","    public static func mock(","        result: @escaping @Sendable () async throws -> KillswitchConfig = { KillswitchConfig() },","        cached: KillswitchConfig? = nil,","        cacheLifetime: TimeInterval = 3600","    ) -> KillswitchService","}"],"type":"codeListing"},{"inlineContent":[{"code":"live(endpoint:)","type":"codeVoice"},{"text":" decodes JSON from ","type":"text"},{"code":"endpoint","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"reloadIgnoringLocalCacheData","type":"codeVoice"},{"text":" policy and persists the result to a ","type":"text"},{"code":"swidux-killswitch.json","type":"codeVoice"},{"text":" file in the user’s caches directory. ","type":"text"},{"code":"mock(result:cached:)","type":"codeVoice"},{"text":" keeps an in-memory cache and lets a test inject a closure that returns or throws.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The endpoint must be ","type":"text"},{"type":"strong","inlineContent":[{"text":"HTTPS","type":"text"}]},{"text":" (","type":"text"},{"code":"http","type":"codeVoice"},{"text":" is allowed only for ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":" development servers; anything else is a precondition failure) — the killswitch is a remote control channel and must not be tamperable in transit. Non-2xx responses and payloads over 1 MB are treated as fetch failures, which fall back to the cache (and ultimately fail open).","type":"text"}],"type":"paragraph"},{"level":3,"text":"KillswitchConfig","anchor":"KillswitchConfig","type":"heading"},{"inlineContent":[{"text":"The decoded shape of the remote JSON. All fields are optional — a config with every field ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" evaluates to ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct KillswitchConfig: Codable, Sendable, Equatable {","    public var minimumSupportedVersion: String?","    public var blockedVersions: [String]?","    public var blockedRanges: [String]?","    public var blockedTitle: String?","    public var blockedMessage: String?","    public var updateURL: String?","","    public init(","        minimumSupportedVersion: String? = nil,","        blockedVersions: [String]? = nil,","        blockedRanges: [String]? = nil,","        blockedTitle: String? = nil,","        blockedMessage: String? = nil,","        updateURL: String? = nil","    )","}"],"type":"codeListing"},{"level":3,"text":"KillswitchVerdict","anchor":"KillswitchVerdict","type":"heading"},{"inlineContent":[{"text":"The result of evaluating a config against the running version.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"],"type":"codeListing"},{"inlineContent":[{"code":".unknown","type":"codeVoice"},{"text":" is the initial state before any fetch has been attempted. ","type":"text"},{"code":"evaluate(_:against:)","type":"codeVoice"},{"text":" always returns ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":" — never ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":". ","type":"text"},{"code":"isBlocked","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" only for the ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" case.","type":"text"}],"type":"paragraph"},{"level":3,"text":"SemanticVersion","anchor":"SemanticVersion","type":"heading"},{"inlineContent":[{"text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The string initializer accepts ","type":"text"},{"code":"\"1.2.3\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"1.2.3-beta.1\"","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"\"1.2.3-beta.1+build42\"","type":"codeVoice"},{"text":". Build metadata after ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" is parsed and discarded. Malformed input returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric.","type":"text"}],"type":"paragraph"},{"level":3,"text":"VersionRange","anchor":"VersionRange","type":"heading"},{"inlineContent":[{"text":"A half-open range ","type":"text"},{"code":"[lowerBound, upperBound)","type":"codeVoice"},{"text":" of semantic versions, used to express ","type":"text"},{"code":"blockedRanges","type":"codeVoice"},{"text":" entries.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"],"type":"codeListing"},{"inlineContent":[{"text":"Both initializers fail and return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Action semantics","anchor":"Action-semantics","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Effect on state","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Returned effect","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"if the cache is fresh (","type":"text"},{"type":"codeVoice","code":"Date() - lastFetch < cacheLifetime"},{"text":" AND ","type":"text"},{"type":"codeVoice","code":"loadCached()"},{"text":" is non-nil), evaluates the cached config and dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" without hitting the network; otherwise behaves like ","type":"text"},{"type":"codeVoice","code":".forceFetch"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".forceFetch"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"calls ","type":"text"},{"type":"codeVoice","code":"service.fetch()"},{"text":", persists the result via ","type":"text"},{"type":"codeVoice","code":"service.saveCached(_:)"},{"text":", dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":". On thrown error, falls back to ","type":"text"},{"type":"codeVoice","code":"service.loadCached()"},{"text":" if available — dispatching ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" from the cache ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":".fetchFailed(message)"},{"text":" so the UI can surface the error while keeping a usable verdict","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".verdictReceived(verdict, fromNetwork:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"sets ","type":"text"},{"type":"codeVoice","code":"verdict"},{"text":", clears ","type":"text"},{"type":"codeVoice","code":"fetchError"},{"text":"; sets ","type":"text"},{"type":"codeVoice","code":"lastFetch = Date()"},{"text":" ","type":"text"},{"inlineContent":[{"text":"only when ","type":"text"},{"code":"fromNetwork","type":"codeVoice"},{"text":" is true","type":"text"}],"type":"strong"},{"text":" — a cache-served verdict must not slide the freshness window, or a session polling ","type":"text"},{"type":"codeVoice","code":".fetch"},{"type":"text","text":" inside "},{"type":"codeVoice","code":"cacheLifetime"},{"type":"text","text":" would never consult the network again"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetchFailed(message)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"sets "},{"type":"codeVoice","code":"fetchError = message"},{"type":"text","text":" (does not clear "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":" or "},{"type":"codeVoice","code":"lastFetch"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".openUpdateURL"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"if "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":" is "},{"type":"codeVoice","code":".blocked"},{"type":"text","text":" with a non-nil "},{"type":"codeVoice","code":"updateURL"},{"type":"text","text":" whose scheme is "},{"type":"codeVoice","code":"https"},{"type":"text","text":", "},{"type":"codeVoice","code":"itms-apps"},{"type":"text","text":", or "},{"type":"codeVoice","code":"macappstore"},{"type":"text","text":", calls the plugin’s "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" closure; otherwise no effect (the URL comes from remote config, so arbitrary schemes are never opened)"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"The plugin only handles its own actions. Any action that ","type":"text"},{"code":"extractAction","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for is ignored — the plugin’s ","type":"text"},{"code":"reduce(...)","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" immediately.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The combination of ","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":"’s cached-fallback behavior and ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator (","type":"text"},{"code":"fetchError","type":"codeVoice"},{"text":"), without leaving the UI stuck on ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":".verdictReceived"},{"type":"text","text":" is dispatched on every "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":"\/"},{"type":"codeVoice","code":".forceFetch"},{"type":"text","text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing "},{"type":"codeVoice","code":"KillswitchState"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation"},{"type":"text","text":"."}]}],"type":"aside"},{"level":2,"text":"Verdict evaluation rules","anchor":"Verdict-evaluation-rules","type":"heading"},{"inlineContent":[{"code":"KillswitchVerdict.evaluate(_:against:)","type":"codeVoice"},{"text":" is fail-open: any unparseable input yields ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":". Checks run in this fixed order, returning ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":" on the first match:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Current version parse.","type":"text"}]},{"type":"text","text":" If "},{"code":"currentVersionString","type":"codeVoice"},{"type":"text","text":" cannot be parsed as a "},{"code":"SemanticVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" immediately."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Minimum supported version.","type":"text"}]},{"type":"text","text":" If "},{"code":"config.minimumSupportedVersion","type":"codeVoice"},{"type":"text","text":" parses and "},{"code":"currentVersion < minVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Explicit blocked versions.","type":"text"}]},{"type":"text","text":" Iterate "},{"code":"config.blockedVersions","type":"codeVoice"},{"type":"text","text":". If any entry parses and equals "},{"code":"currentVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Blocked ranges.","type":"text"}]},{"type":"text","text":" Iterate "},{"code":"config.blockedRanges","type":"codeVoice"},{"type":"text","text":". If any entry parses as a "},{"code":"VersionRange","type":"codeVoice"},{"type":"text","text":" and contains "},{"code":"currentVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Otherwise","type":"text"}]},{"type":"text","text":" return "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"inlineContent":[{"text":"A blocked verdict carries the config’s ","type":"text"},{"code":"blockedTitle","type":"codeVoice"},{"text":", ","type":"text"},{"code":"blockedMessage","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"updateURL","type":"codeVoice"},{"text":" (parsed via ","type":"text"},{"code":"URL(string:)","type":"codeVoice"},{"text":") regardless of which check matched.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Remote config JSON shape","anchor":"Remote-config-JSON-shape","type":"heading"},{"inlineContent":[{"code":"KillswitchConfig","type":"codeVoice"},{"text":" derives its ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":" conformance from synthesized keys, so the JSON keys match the property names. A representative file:","type":"text"}],"type":"paragraph"},{"syntax":"json","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.3.0\", \"1.3.1\"],","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update Required\",","    \"blockedMessage\": \"Please update to continue using the app.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"type":"codeListing"},{"inlineContent":[{"text":"Every field is optional. An empty object ","type":"text"},{"code":"{}","type":"codeVoice"},{"text":" is valid and evaluates to ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" for any version.","type":"text"}],"type":"paragraph"},{"level":2,"text":"View modifier: `killswitchBlocker`","anchor":"View-modifier-killswitchBlocker","type":"heading"},{"inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" ships a SwiftUI view modifier that overlays a non-dismissible blocker whenever the verdict is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" and disables the underlying content while it is. Two overloads:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["extension View {","    \/\/\/ Default blocker — full-screen ultraThinMaterial with title, message,","    \/\/\/ and an optional Update button.","    public func killswitchBlocker(","        verdict: KillswitchVerdict,","        onUpdate: (() -> Void)? = nil","    ) -> some View","","    \/\/\/ Custom blocker — receives the title, message, and `hasUpdateURL`","    \/\/\/ flag and renders whatever you return.","    public func killswitchBlocker<Blocker: View>(","        verdict: KillswitchVerdict,","        @ViewBuilder blocker: @escaping (","            _ title: String?,","            _ message: String?,","            _ hasUpdateURL: Bool","        ) -> Blocker","    ) -> some View","}"],"type":"codeListing"},{"inlineContent":[{"text":"Both overloads apply ","type":"text"},{"code":".disabled(verdict.isBlocked)","type":"codeVoice"},{"text":" to the modified content, so the underlying view tree stops responding to touches while blocked. The blocker layer is rendered as an overlay; supply your own to match the host app’s design system.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swidux\/pluginkillswitchreference"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","title":"Persistence Middleware","url":"\/documentation\/swidux\/persistencemiddlewareguide","type":"topic","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"navigatorTitl