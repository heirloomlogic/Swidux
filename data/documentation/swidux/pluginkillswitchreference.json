{"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true,"title":"Reference"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"kind":"article","abstract":[{"text":"Public API surface for the ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginkillswitchreference"]}],"metadata":{"title":"SwiduxKillswitch Reference","roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"content":[{"text":"Library target","anchor":"Library-target","level":2,"type":"heading"},{"inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" ships as its own product in the "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":" package. Add it to a target’s dependencies in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":" and import it where you wire the plugin:"}],"type":"paragraph"},{"code":["import SwiduxKillswitch"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The target depends on "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":" and links against "},{"code":"UIKit","type":"codeVoice"},{"type":"text","text":" on iOS \/ "},{"code":"AppKit","type":"codeVoice"},{"type":"text","text":" on macOS for the default URL-opening behavior."}],"type":"paragraph"},{"text":"Types","anchor":"Types","level":2,"type":"heading"},{"text":"KillswitchPlugin","anchor":"KillswitchPlugin","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The domain plugin. Conforms to "},{"code":"SwiduxPlugin","type":"codeVoice"},{"type":"text","text":" and is generic over the host app’s root state and action types."}],"type":"paragraph"},{"code":["@MainActor","public struct KillswitchPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, KillswitchState>,","        action toRootAction: @escaping @Sendable (KillswitchAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> KillswitchAction?,","        service: KillswitchService,","        appVersion: @escaping @Sendable () -> String,","        openURL: @escaping @Sendable (URL) async -> Void = { \/* UIApplication \/ NSWorkspace *\/ }","    )","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The default "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" calls "},{"code":"UIApplication.shared.open(_:)","type":"codeVoice"},{"type":"text","text":" on iOS and "},{"code":"NSWorkspace.shared.open(_:)","type":"codeVoice"},{"type":"text","text":" on macOS, both hopped to "},{"code":"MainActor","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"KillswitchState","anchor":"KillswitchState","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The state slice the plugin owns. Default-constructed values match a fresh, never-fetched session."}],"type":"paragraph"},{"code":["public struct KillswitchState: Sendable, Equatable {","    public var verdict: KillswitchVerdict   \/\/ defaults to .unknown","    public var lastFetch: Date?             \/\/ nil until first successful fetch","    public var fetchError: String?          \/\/ localized description of last failure","","    public var isBlocked: Bool              \/\/ delegates to verdict.isBlocked","    public var canOpenUpdateURL: Bool       \/\/ .blocked AND updateURL is non-nil","","    public init(","        verdict: KillswitchVerdict = .unknown,","        lastFetch: Date? = nil,","        fetchError: String? = nil","    )","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"isBlocked","type":"codeVoice"},{"type":"text","text":" and "},{"code":"canOpenUpdateURL","type":"codeVoice"},{"type":"text","text":" are convenience computed properties. Bind UI off them rather than pattern-matching "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":" everywhere."}],"type":"paragraph"},{"text":"KillswitchAction","anchor":"KillswitchAction","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The plugin’s local action enum. Wrap these in your root action through the case you provide at registration."}],"type":"paragraph"},{"code":["public enum KillswitchAction: Sendable {","    case fetch","    case forceFetch","    case verdictReceived(KillswitchVerdict)","    case fetchFailed(String)","    case openUpdateURL","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":".fetch","type":"codeVoice"},{"type":"text","text":" is the launch-time entry point — it consults the cache and skips the network when the cached config is fresh. "},{"code":".forceFetch","type":"codeVoice"},{"type":"text","text":" always hits the network, suitable for pull-to-refresh or post-update health checks."}],"type":"paragraph"},{"text":"KillswitchService","anchor":"KillswitchService","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"A closure-based service that fetches and caches the remote config. Substitute the live factory in production and the mock factory in tests."}],"type":"paragraph"},{"code":["public struct KillswitchService: Sendable {","    public var fetch: @Sendable () async throws -> KillswitchConfig","    public var loadCached: @Sendable () -> KillswitchConfig?","    public var saveCached: @Sendable (KillswitchConfig) -> Void","    public let cacheLifetime: TimeInterval","","    public init(","        fetch: @escaping @Sendable () async throws -> KillswitchConfig,","        loadCached: @escaping @Sendable () -> KillswitchConfig?,","        saveCached: @escaping @Sendable (KillswitchConfig) -> Void,","        cacheLifetime: TimeInterval","    )","","    public static func live(","        endpoint: URL,","        fetchTimeout: TimeInterval = 10,","        cacheLifetime: TimeInterval = 3600,","        session: URLSession = .shared","    ) -> KillswitchService","","    public static func mock(","        result: @escaping @Sendable () async throws -> KillswitchConfig = { KillswitchConfig() },","        cached: KillswitchConfig? = nil,","        cacheLifetime: TimeInterval = 3600","    ) -> KillswitchService","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"live(endpoint:)","type":"codeVoice"},{"type":"text","text":" decodes JSON from "},{"code":"endpoint","type":"codeVoice"},{"type":"text","text":" with a "},{"code":"reloadIgnoringLocalCacheData","type":"codeVoice"},{"type":"text","text":" policy and persists the result to a "},{"code":"swidux-killswitch.json","type":"codeVoice"},{"type":"text","text":" file in the user’s caches directory. "},{"code":"mock(result:cached:)","type":"codeVoice"},{"type":"text","text":" keeps an in-memory cache and lets a test inject a closure that returns or throws."}],"type":"paragraph"},{"text":"KillswitchConfig","anchor":"KillswitchConfig","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The decoded shape of the remote JSON. All fields are optional — a config with every field "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" evaluates to "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["public struct KillswitchConfig: Codable, Sendable, Equatable {","    public var minimumSupportedVersion: String?","    public var blockedVersions: [String]?","    public var blockedRanges: [String]?","    public var blockedTitle: String?","    public var blockedMessage: String?","    public var updateURL: String?","","    public init(","        minimumSupportedVersion: String? = nil,","        blockedVersions: [String]? = nil,","        blockedRanges: [String]? = nil,","        blockedTitle: String? = nil,","        blockedMessage: String? = nil,","        updateURL: String? = nil","    )","}"],"syntax":"swift","type":"codeListing"},{"text":"KillswitchVerdict","anchor":"KillswitchVerdict","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The result of evaluating a config against the running version."}],"type":"paragraph"},{"code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":".unknown","type":"codeVoice"},{"type":"text","text":" is the initial state before any fetch has been attempted. "},{"code":"evaluate(_:against:)","type":"codeVoice"},{"type":"text","text":" always returns "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" or "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":" — never "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":". "},{"code":"isBlocked","type":"codeVoice"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" only for the "},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" case."}],"type":"paragraph"},{"text":"SemanticVersion","anchor":"SemanticVersion","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests."}],"type":"paragraph"},{"code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The string initializer accepts "},{"code":"\"1.2.3\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"1.2.3-beta.1\"","type":"codeVoice"},{"type":"text","text":", and "},{"code":"\"1.2.3-beta.1+build42\"","type":"codeVoice"},{"type":"text","text":". Build metadata after "},{"code":"+","type":"codeVoice"},{"type":"text","text":" is parsed and discarded. Malformed input returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric."}],"type":"paragraph"},{"text":"VersionRange","anchor":"VersionRange","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"A half-open range "},{"code":"[lowerBound, upperBound)","type":"codeVoice"},{"type":"text","text":" of semantic versions, used to express "},{"code":"blockedRanges","type":"codeVoice"},{"type":"text","text":" entries."}],"type":"paragraph"},{"code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Both initializers fail and return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed."}],"type":"paragraph"},{"text":"Action semantics","anchor":"Action-semantics","level":2,"type":"heading"},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Action"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Effect on state"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Returned effect"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"if the cache is fresh ("},{"type":"codeVoice","code":"Date() - lastFetch < cacheLifetime"},{"type":"text","text":" AND "},{"type":"codeVoice","code":"loadCached()"},{"type":"text","text":" is non-nil), evaluates the cached config and dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" without hitting the network; otherwise behaves like "},{"type":"codeVoice","code":".forceFetch"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".forceFetch"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"calls "},{"type":"codeVoice","code":"service.fetch()"},{"type":"text","text":", persists the result via "},{"type":"codeVoice","code":"service.saveCached(_:)"},{"type":"text","text":", dispatches "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":". On thrown error, falls back to "},{"type":"codeVoice","code":"service.loadCached()"},{"type":"text","text":" if available — dispatching "},{"type":"codeVoice","code":".verdictReceived(...)"},{"type":"text","text":" from the cache "},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"type":"text","text":" "},{"type":"codeVoice","code":".fetchFailed(message)"},{"type":"text","text":" so the UI can surface the error while keeping a usable verdict"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".verdictReceived(verdict)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"sets "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":", sets "},{"type":"codeVoice","code":"lastFetch = Date()"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"fetchError"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetchFailed(message)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"sets "},{"type":"codeVoice","code":"fetchError = message"},{"type":"text","text":" (does not clear "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":" or "},{"type":"codeVoice","code":"lastFetch"},{"type":"text","text":")"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".openUpdateURL"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"if "},{"type":"codeVoice","code":"verdict"},{"type":"text","text":" is "},{"type":"codeVoice","code":".blocked"},{"type":"text","text":" with a non-nil "},{"type":"codeVoice","code":"updateURL"},{"type":"text","text":", calls the plugin’s "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" closure; otherwise no effect"}]}]]],"type":"table"},{"inlineContent":[{"type":"text","text":"The plugin only handles its own actions. Any action that "},{"code":"extractAction","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for is ignored — the plugin’s "},{"code":"reduce(...)","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" immediately."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The combination of "},{"code":".forceFetch","type":"codeVoice"},{"type":"text","text":"’s cached-fallback behavior and "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator ("},{"code":"fetchError","type":"codeVoice"},{"type":"text","text":"), without leaving the UI stuck on "},{"code":".unknown","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":".verdictReceived"},{"type":"text","text":" is dispatched on every "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":"\/"},{"type":"codeVoice","code":".forceFetch"},{"type":"text","text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing "},{"type":"codeVoice","code":"KillswitchState"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation"},{"type":"text","text":"."}]}],"name":"Note","style":"note","type":"aside"},{"text":"Verdict evaluation rules","anchor":"Verdict-evaluation-rules","level":2,"type":"heading"},{"inlineContent":[{"code":"KillswitchVerdict.evaluate(_:against:)","type":"codeVoice"},{"type":"text","text":" is fail-open: any unparseable input yields "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":". Checks run in this fixed order, returning "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":" on the first match:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Current version parse.","type":"text"}],"type":"strong"},{"type":"text","text":" If "},{"code":"currentVersionString","type":"codeVoice"},{"type":"text","text":" cannot be parsed as a "},{"code":"SemanticVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" immediately."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Minimum supported version.","type":"text"}],"type":"strong"},{"type":"text","text":" If "},{"code":"config.minimumSupportedVersion","type":"codeVoice"},{"type":"text","text":" parses and "},{"code":"currentVersion < minVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Explicit blocked versions.","type":"text"}],"type":"strong"},{"type":"text","text":" Iterate "},{"code":"config.blockedVersions","type":"codeVoice"},{"type":"text","text":". If any entry parses and equals "},{"code":"currentVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Blocked ranges.","type":"text"}],"type":"strong"},{"type":"text","text":" Iterate "},{"code":"config.blockedRanges","type":"codeVoice"},{"type":"text","text":". If any entry parses as a "},{"code":"VersionRange","type":"codeVoice"},{"type":"text","text":" and contains "},{"code":"currentVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Otherwise","type":"text"}],"type":"strong"},{"type":"text","text":" return "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"A blocked verdict carries the config’s "},{"code":"blockedTitle","type":"codeVoice"},{"type":"text","text":", "},{"code":"blockedMessage","type":"codeVoice"},{"type":"text","text":", and "},{"code":"updateURL","type":"codeVoice"},{"type":"text","text":" (parsed via "},{"code":"URL(string:)","type":"codeVoice"},{"type":"text","text":") regardless of which check matched."}],"type":"paragraph"},{"text":"Remote config JSON shape","anchor":"Remote-config-JSON-shape","level":2,"type":"heading"},{"inlineContent":[{"code":"KillswitchConfig","type":"codeVoice"},{"type":"text","text":" derives its "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance from synthesized keys, so the JSON keys match the property names. A representative file:"}],"type":"paragraph"},{"code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.3.0\", \"1.3.1\"],","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update Required\",","    \"blockedMessage\": \"Please update to continue using the app.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every field is optional. An empty object "},{"code":"{}","type":"codeVoice"},{"type":"text","text":" is valid and evaluates to "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" for any version."}],"type":"paragraph"},{"text":"View modifier: `killswitchBlocker`","anchor":"View-modifier-killswitchBlocker","level":2,"type":"heading"},{"inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" ships a SwiftUI view modifier that overlays a non-dismissible blocker whenever the verdict is "},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" and disables the underlying content while it is. Two overloads:"}],"type":"paragraph"},{"code":["extension View {","    \/\/\/ Default blocker — full-screen ultraThinMaterial with title, message,","    \/\/\/ and an optional Update button.","    public func killswitchBlocker(","        verdict: KillswitchVerdict,","        onUpdate: (() -> Void)? = nil","    ) -> some View","","    \/\/\/ Custom blocker — receives the title, message, and `hasUpdateURL`","    \/\/\/ flag and renders whatever you return.","    public func killswitchBlocker<Blocker: View>(","        verdict: KillswitchVerdict,","        @ViewBuilder blocker: @escaping (","            _ title: String?,","            _ message: String?,","            _ hasUpdateURL: Bool","        ) -> Blocker","    ) -> some View","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Both overloads apply "},{"code":".disabled(verdict.isBlocked)","type":"codeVoice"},{"type":"text","text":" to the modified content, so the underlying view tree stops responding to touches while blocked. The blocker layer is rendered as an overlay; supply your own to match the host app’s design system."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference"},"references":{"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","title":"Persistence Middleware","url":"\/documentation\/swidux\/persistencemiddlewareguide","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}]},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","title":"SwiduxFeatureFlags Reference","url":"\/documentation\/swidux\/pluginfeatureflagsreference","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}]},"doc://Swidux/documentation/Swidux/UndoRedo":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","title":"Undo \/ Redo","url":"\/documentation\/swidux\/undoredo","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"type":"text","text":"."}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","title":"Plugin Architecture","url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"title":