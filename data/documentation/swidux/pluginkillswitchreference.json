oice"},{"text":" and import it where you wire the plugin:","type":"text"}],"type":"paragraph"},{"code":["import SwiduxKillswitch"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The target depends on ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":" and links against ","type":"text"},{"type":"codeVoice","code":"UIKit"},{"text":" on iOS \/ ","type":"text"},{"type":"codeVoice","code":"AppKit"},{"text":" on macOS for the default URL-opening behavior.","type":"text"}]},{"text":"Types","type":"heading","level":2,"anchor":"Types"},{"level":3,"type":"heading","anchor":"KillswitchPlugin","text":"KillswitchPlugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The domain plugin. Conforms to "},{"code":"SwiduxPlugin","type":"codeVoice"},{"text":" and is generic over the host app’s root state and action types.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@MainActor","public struct KillswitchPlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, KillswitchState>,","        action toRootAction: @escaping @Sendable (KillswitchAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> KillswitchAction?,","        service: KillswitchService,","        appVersion: @escaping @Sendable () -> String,","        openURL: @escaping @Sendable (URL) async -> Void = { \/* UIApplication \/ NSWorkspace *\/ }","    )","}"]},{"type":"paragraph","inlineContent":[{"text":"The default ","type":"text"},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" calls "},{"type":"codeVoice","code":"UIApplication.shared.open(_:)"},{"text":" on iOS and ","type":"text"},{"type":"codeVoice","code":"NSWorkspace.shared.open(_:)"},{"text":" on macOS, both hopped to ","type":"text"},{"type":"codeVoice","code":"MainActor"},{"text":".","type":"text"}]},{"level":3,"type":"heading","anchor":"KillswitchState","text":"KillswitchState"},{"type":"paragraph","inlineContent":[{"text":"The state slice the plugin owns. Default-constructed values match a fresh, never-fetched session.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["public struct KillswitchState: Sendable, Equatable {","    public var verdict: KillswitchVerdict   \/\/ defaults to .unknown","    public var lastFetch: Date?             \/\/ nil until first successful fetch","    public var fetchError: String?          \/\/ localized description of last failure","","    public var isBlocked: Bool              \/\/ delegates to verdict.isBlocked","    public var canOpenUpdateURL: Bool       \/\/ .blocked AND updateURL is non-nil","","    public init(","        verdict: KillswitchVerdict = .unknown,","        lastFetch: Date? = nil,","        fetchError: String? = nil","    )","}"]},{"type":"paragraph","inlineContent":[{"code":"isBlocked","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"canOpenUpdateURL"},{"text":" are convenience computed properties. Bind UI off them rather than pattern-matching ","type":"text"},{"type":"codeVoice","code":"verdict"},{"text":" everywhere.","type":"text"}]},{"level":3,"type":"heading","anchor":"KillswitchAction","text":"KillswitchAction"},{"type":"paragraph","inlineContent":[{"text":"The plugin’s local action enum. Wrap these in your root action through the case you provide at registration.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["public enum KillswitchAction: Sendable {","    case fetch","    case forceFetch","    case verdictReceived(KillswitchVerdict, fromNetwork: Bool)","    case fetchFailed(String)","    case openUpdateURL","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"},{"text":" is the launch-time entry point — it consults the cache and skips the network when the cached config is fresh. ","type":"text"},{"type":"codeVoice","code":".forceFetch"},{"text":" always hits the network, suitable for pull-to-refresh or post-update health checks.","type":"text"}]},{"level":3,"type":"heading","anchor":"KillswitchService","text":"KillswitchService"},{"type":"paragraph","inlineContent":[{"text":"A closure-based service that fetches and caches the remote config. Substitute the live factory in production and the mock factory in tests.","type":"text"}]},{"code":["public struct KillswitchService: Sendable {","    public var fetch: @Sendable () async throws -> KillswitchConfig","    public var loadCached: @Sendable () -> KillswitchConfig?","    public var saveCached: @Sendable (KillswitchConfig) -> Void","    public let cacheLifetime: TimeInterval","","    public init(","        fetch: @escaping @Sendable () async throws -> KillswitchConfig,","        loadCached: @escaping @Sendable () -> KillswitchConfig?,","        saveCached: @escaping @Sendable (KillswitchConfig) -> Void,","        cacheLifetime: TimeInterval","    )","","    public static func live(","        endpoint: URL,","        fetchTimeout: TimeInterval = 10,","        cacheLifetime: TimeInterval = 3600,","        session: URLSession = .shared","    ) -> KillswitchService","","    public static func mock(","        result: @escaping @Sendable () async throws -> KillswitchConfig = { KillswitchConfig() },","        cached: KillswitchConfig? = nil,","        cacheLifetime: TimeInterval = 3600","    ) -> KillswitchService","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"live(endpoint:)"},{"text":" decodes JSON from ","type":"text"},{"code":"endpoint","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"reloadIgnoringLocalCacheData","type":"codeVoice"},{"text":" policy and persists the result to a ","type":"text"},{"code":"swidux-killswitch.json","type":"codeVoice"},{"type":"text","text":" file in the user’s caches directory. "},{"code":"mock(result:cached:)","type":"codeVoice"},{"text":" keeps an in-memory cache and lets a test inject a closure that returns or throws.","type":"text"}]},{"inlineContent":[{"text":"The endpoint must be ","type":"text"},{"type":"strong","inlineContent":[{"text":"HTTPS","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"http"},{"type":"text","text":" is allowed only for "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":" development servers; anything else is a precondition failure) — the killswitch is a remote control channel and must not be tamperable in transit. Non-2xx responses and payloads over 1 MB are treated as fetch failures, which fall back to the cache (and ultimately fail open)."}],"type":"paragraph"},{"anchor":"KillswitchConfig","type":"heading","text":"KillswitchConfig","level":3},{"inlineContent":[{"text":"The decoded shape of the remote JSON. All fields are optional — a config with every field ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" evaluates to "},{"type":"codeVoice","code":".allowed"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["public struct KillswitchConfig: Codable, Sendable, Equatable {","    public var minimumSupportedVersion: String?","    public var blockedVersions: [String]?","    public var blockedRanges: [String]?","    public var blockedTitle: String?","    public var blockedMessage: String?","    public var updateURL: String?","","    public init(","        minimumSupportedVersion: String? = nil,","        blockedVersions: [String]? = nil,","        blockedRanges: [String]? = nil,","        blockedTitle: String? = nil,","        blockedMessage: String? = nil,","        updateURL: String? = nil","    )","}"],"type":"codeListing","syntax":"swift"},{"anchor":"KillswitchVerdict","type":"heading","text":"KillswitchVerdict","level":3},{"inlineContent":[{"text":"The result of evaluating a config against the running version.","type":"text"}],"type":"paragraph"},{"code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":".unknown","type":"codeVoice"},{"text":" is the initial state before any fetch has been attempted. ","type":"text"},{"code":"evaluate(_:against:)","type":"codeVoice"},{"text":" always returns ","type":"text"},{"type":"codeVoice","code":".allowed"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".blocked(...)"},{"text":" — never ","type":"text"},{"code":".unknown","type":"codeVoice"},{"type":"text","text":". "},{"type":"codeVoice","code":"isBlocked"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" only for the "},{"type":"codeVoice","code":".blocked"},{"type":"text","text":" case."}],"type":"paragraph"},{"level":3,"text":"SemanticVersion","anchor":"SemanticVersion","type":"heading"},{"inlineContent":[{"text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests.","type":"text"}],"type":"paragraph"},{"code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The string initializer accepts ","type":"text"},{"type":"codeVoice","code":"\"1.2.3\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"1.2.3-beta.1\""},{"text":", and ","type":"text"},{"type":"codeVoice","code":"\"1.2.3-beta.1+build42\""},{"text":". Build metadata after ","type":"text"},{"type":"codeVoice","code":"+"},{"text":" is parsed and discarded. Malformed input returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric.","type":"text"}],"type":"paragraph"},{"anchor":"VersionRange","type":"heading","text":"VersionRange","level":3},{"type":"paragraph","inlineContent":[{"text":"A half-open range ","type":"text"},{"type":"codeVoice","code":"[lowerBound, upperBound)"},{"text":" of semantic versions, used to express ","type":"text"},{"code":"blockedRanges","type":"codeVoice"},{"text":" entries.","type":"text"}]},{"code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both initializers fail and return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed."}]},{"anchor":"Action-semantics","level":2,"text":"Action semantics","type":"heading"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Action","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Effect on state"}]}],[{"type":"paragraph","inlineContent":[{"text":"Returned effect","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetch"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"if the cache is fresh (","type":"text"},{"type":"codeVoice","code":"Date() - lastFetch < cacheLifetime"},{"text":" AND ","type":"text"},{"type":"codeVoice","code":"loadCached()"},{"text":" is non-nil), evaluates the cached config and dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" without hitting the network; otherwise behaves like ","type":"text"},{"type":"codeVoice","code":".forceFetch"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".forceFetch"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"calls ","type":"text"},{"type":"codeVoice","code":"service.fetch()"},{"text":", persists the result via ","type":"text"},{"type":"codeVoice","code":"service.saveCached(_:)"},{"text":", dispatches ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":". On thrown error, falls back to ","type":"text"},{"type":"codeVoice","code":"service.loadCached()"},{"text":" if available — dispatching ","type":"text"},{"type":"codeVoice","code":".verdictReceived(...)"},{"text":" from the cache ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"and"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":".fetchFailed(message)"},{"text":" so the UI can surface the error while keeping a usable verdict","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".verdictReceived(verdict, fromNetwork:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"sets ","type":"text"},{"type":"codeVoice","code":"verdict"},{"text":", clears ","type":"text"},{"type":"codeVoice","code":"fetchError"},{"text":"; sets ","type":"text"},{"type":"codeVoice","code":"lastFetch = Date()"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"only when "},{"type":"codeVoice","code":"fromNetwork"},{"type":"text","text":" is true"}]},{"text":" — a cache-served verdict must not slide the freshness window, or a session polling ","type":"text"},{"type":"codeVoice","code":".fetch"},{"text":" inside ","type":"text"},{"type":"codeVoice","code":"cacheLifetime"},{"text":" would never consult the network again","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"none","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".fetchFailed(message)"}]}],[{"type":"paragraph","inlineContent":[{"text":"sets ","type":"text"},{"type":"codeVoice","code":"fetchError = message"},{"text":" (does not clear ","type":"text"},{"type":"codeVoice","code":"verdict"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"lastFetch"},{"text":")","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"none"}]}]],[[{"inlineContent":[{"type":"codeVoice","code":".openUpdateURL"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"if "},{"code":"verdict","type":"codeVoice"},{"text":" is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" with a non-nil ","type":"text"},{"code":"updateURL","type":"codeVoice"},{"text":" whose scheme is ","type":"text"},{"code":"https","type":"codeVoice"},{"text":", ","type":"text"},{"code":"itms-apps","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"macappstore","type":"codeVoice"},{"text":", calls the plugin’s ","type":"text"},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" closure; otherwise no effect (the URL comes from remote config, so arbitrary schemes are never opened)"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"The plugin only handles its own actions. Any action that ","type":"text"},{"code":"extractAction","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for is ignored — the plugin’s ","type":"text"},{"code":"reduce(...)","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" immediately.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The combination of ","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":"’s cached-fallback behavior and ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator (","type":"text"},{"code":"fetchError","type":"codeVoice"},{"text":"), without leaving the UI stuck on ","type":"text"},{"code":".unknown","type":"codeVoice"},{"type":"text","text":"."}]},{"style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":".verdictReceived"},{"type":"text","text":" is dispatched on every "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":"\/"},{"code":".forceFetch","type":"codeVoice"},{"type":"text","text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing "},{"code":"KillswitchState","type":"codeVoice"},{"text":" or a value derived from it — not by mapping this action. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside"},{"anchor":"Verdict-evaluation-rules","type":"heading","text":"Verdict evaluation rules","level":2},{"inlineContent":[{"type":"codeVoice","code":"KillswitchVerdict.evaluate(_:against:)"},{"type":"text","text":" is fail-open: any unparseable input yields "},{"type":"codeVoice","code":".allowed"},{"type":"text","text":". Checks run in this fixed order, returning "},{"type":"codeVoice","code":".blocked(...)"},{"type":"text","text":" on the first match:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Current version parse."}]},{"type":"text","text":" If "},{"code":"currentVersionString","type":"codeVoice"},{"type":"text","text":" cannot be parsed as a "},{"code":"SemanticVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" immediately."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Minimum supported version."}]},{"type":"text","text":" If "},{"type":"codeVoice","code":"config.minimumSupportedVersion"},{"type":"text","text":" parses and "},{"code":"currentVersion < minVersion","type":"codeVoice"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Explicit blocked versions."}]},{"text":" Iterate ","type":"text"},{"type":"codeVoice","code":"config.blockedVersions"},{"text":". If any entry parses and equals ","type":"text"},{"type":"codeVoice","code":"currentVersion"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Blocked ranges."}]},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedRanges"},{"type":"text","text":". If any entry parses as a "},{"type":"codeVoice","code":"VersionRange"},{"type":"text","text":" and contains "},{"type":"codeVoice","code":"currentVersion"},{"text":", return ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Otherwise"}],"type":"strong"},{"text":" return ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A blocked verdict carries the config’s "},{"code":"blockedTitle","type":"codeVoice"},{"type":"text","text":", "},{"code":"blockedMessage","type":"codeVoice"},{"type":"text","text":", and "},{"code":"updateURL","type":"codeVoice"},{"type":"text","text":" (parsed via "},{"code":"URL(string:)","type":"codeVoice"},{"type":"text","text":") regardless of which check matched."}]},{"type":"heading","anchor":"Remote-config-JSON-shape","level":2,"text":"Remote config JSON shape"},{"type":"paragraph","inlineContent":[{"code":"KillswitchConfig","type":"codeVoice"},{"type":"text","text":" derives its "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":" conformance from synthesized keys, so the JSON keys match the property names. A representative file:"}]},{"type":"codeListing","syntax":"json","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.3.0\", \"1.3.1\"],","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update Required\",","    \"blockedMessage\": \"Please update to continue using the app.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every field is optional. An empty object "},{"code":"{}","type":"codeVoice"},{"type":"text","text":" is valid and evaluates to "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" for any version."}]},{"type":"heading","anchor":"View-modifier-killswitchBlocker","level":2,"text":"View modifier: `killswitchBlocker`"},{"type":"paragraph","inlineContent":[{"code":"SwiduxKillswitch","type":"codeV