where.","type":"text"}]},{"level":3,"anchor":"KillswitchAction","text":"KillswitchAction","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The plugin’s local action enum. Wrap these in your root action through the case you provide at registration.","type":"text"}]},{"syntax":"swift","code":["public enum KillswitchAction: Sendable {","    case fetch","    case forceFetch","    case verdictReceived(KillswitchVerdict)","    case fetchFailed(String)","    case openUpdateURL","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":".fetch","type":"codeVoice"},{"text":" is the launch-time entry point — it consults the cache and skips the network when the cached config is fresh. ","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":" always hits the network, suitable for pull-to-refresh or post-update health checks.","type":"text"}]},{"level":3,"anchor":"KillswitchService","text":"KillswitchService","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A closure-based service that fetches and caches the remote config. Substitute the live factory in production and the mock factory in tests.","type":"text"}]},{"syntax":"swift","code":["public struct KillswitchService: Sendable {","    public var fetch: @Sendable () async throws -> KillswitchConfig","    public var loadCached: @Sendable () -> KillswitchConfig?","    public var saveCached: @Sendable (KillswitchConfig) -> Void","    public let cacheLifetime: TimeInterval","","    public init(","        fetch: @escaping @Sendable () async throws -> KillswitchConfig,","        loadCached: @escaping @Sendable () -> KillswitchConfig?,","        saveCached: @escaping @Sendable (KillswitchConfig) -> Void,","        cacheLifetime: TimeInterval","    )","","    public static func live(","        endpoint: URL,","        fetchTimeout: TimeInterval = 10,","        cacheLifetime: TimeInterval = 3600,","        session: URLSession = .shared","    ) -> KillswitchService","","    public static func mock(","        result: @escaping @Sendable () async throws -> KillswitchConfig = { KillswitchConfig() },","        cached: KillswitchConfig? = nil,","        cacheLifetime: TimeInterval = 3600","    ) -> KillswitchService","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"live(endpoint:)","type":"codeVoice"},{"text":" decodes JSON from ","type":"text"},{"code":"endpoint","type":"codeVoice"},{"text":" with a ","type":"text"},{"code":"reloadIgnoringLocalCacheData","type":"codeVoice"},{"text":" policy and persists the result to a ","type":"text"},{"code":"swidux-killswitch.json","type":"codeVoice"},{"text":" file in the user’s caches directory. ","type":"text"},{"code":"mock(result:cached:)","type":"codeVoice"},{"text":" keeps an in-memory cache and lets a test inject a closure that returns or throws.","type":"text"}]},{"level":3,"anchor":"KillswitchConfig","text":"KillswitchConfig","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The decoded shape of the remote JSON. All fields are optional — a config with every field ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" evaluates to ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":".","type":"text"}]},{"syntax":"swift","code":["public struct KillswitchConfig: Codable, Sendable, Equatable {","    public var minimumSupportedVersion: String?","    public var blockedVersions: [String]?","    public var blockedRanges: [String]?","    public var blockedTitle: String?","    public var blockedMessage: String?","    public var updateURL: String?","","    public init(","        minimumSupportedVersion: String? = nil,","        blockedVersions: [String]? = nil,","        blockedRanges: [String]? = nil,","        blockedTitle: String? = nil,","        blockedMessage: String? = nil,","        updateURL: String? = nil","    )","}"],"type":"codeListing"},{"level":3,"anchor":"KillswitchVerdict","text":"KillswitchVerdict","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The result of evaluating a config against the running version.","type":"text"}]},{"syntax":"swift","code":["public enum KillswitchVerdict: Sendable, Equatable {","    case unknown","    case allowed","    case blocked(title: String?, message: String?, updateURL: URL?)","","    public var isBlocked: Bool","","    public static func evaluate(","        _ config: KillswitchConfig,","        against currentVersionString: String","    ) -> KillswitchVerdict","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":".unknown","type":"codeVoice"},{"text":" is the initial state before any fetch has been attempted. ","type":"text"},{"code":"evaluate(_:against:)","type":"codeVoice"},{"text":" always returns ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":" — never ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":". ","type":"text"},{"code":"isBlocked","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" only for the ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" case.","type":"text"}]},{"level":3,"anchor":"SemanticVersion","text":"SemanticVersion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A SemVer 2.0.0 parser used internally to compare versions. Public so you can construct or compare versions directly in tests.","type":"text"}]},{"syntax":"swift","code":["public struct SemanticVersion: Sendable, Hashable, Comparable {","    public let major: Int","    public let minor: Int","    public let patch: Int","    public let prerelease: [PrereleaseIdentifier]","","    public init(","        major: Int,","        minor: Int,","        patch: Int,","        prerelease: [PrereleaseIdentifier] = []","    )","","    public init?(_ string: String)","","    public enum PrereleaseIdentifier: Sendable, Hashable, Comparable {","        case numeric(Int)","        case alphanumeric(String)","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The string initializer accepts ","type":"text"},{"code":"\"1.2.3\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"1.2.3-beta.1\"","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"\"1.2.3-beta.1+build42\"","type":"codeVoice"},{"text":". Build metadata after ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" is parsed and discarded. Malformed input returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Comparison follows the SemVer 2.0.0 precedence rules: numeric major\/minor\/patch first, then prerelease (a version with a prerelease tag has lower precedence than the same version without), then prerelease identifiers compared left-to-right with numeric identifiers ordering before alphanumeric.","type":"text"}]},{"level":3,"anchor":"VersionRange","text":"VersionRange","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A half-open range ","type":"text"},{"code":"[lowerBound, upperBound)","type":"codeVoice"},{"text":" of semantic versions, used to express ","type":"text"},{"code":"blockedRanges","type":"codeVoice"},{"text":" entries.","type":"text"}]},{"syntax":"swift","code":["public struct VersionRange: Sendable, Hashable {","    public let lowerBound: SemanticVersion","    public let upperBound: SemanticVersion","","    public init?(lowerBound: SemanticVersion, upperBound: SemanticVersion)","    public init?(_ string: String)   \/\/ parses \"a.b.c..<x.y.z\"","","    public func contains(_ version: SemanticVersion) -> Bool","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Both initializers fail and return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if the lower bound is not strictly less than the upper bound, or if either side cannot be parsed.","type":"text"}]},{"level":2,"anchor":"Action-semantics","text":"Action semantics","type":"heading"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Action"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Effect on state"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Returned effect"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".fetch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"if the cache is fresh ("},{"code":"Date() - lastFetch < cacheLifetime","type":"codeVoice"},{"type":"text","text":" AND "},{"code":"loadCached()","type":"codeVoice"},{"type":"text","text":" is non-nil), evaluates the cached config and dispatches "},{"code":".verdictReceived(...)","type":"codeVoice"},{"type":"text","text":" without hitting the network; otherwise behaves like "},{"code":".forceFetch","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".forceFetch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"calls "},{"code":"service.fetch()","type":"codeVoice"},{"type":"text","text":", persists the result via "},{"code":"service.saveCached(_:)","type":"codeVoice"},{"type":"text","text":", dispatches "},{"code":".verdictReceived(...)","type":"codeVoice"},{"type":"text","text":". On thrown error, falls back to "},{"code":"service.loadCached()","type":"codeVoice"},{"type":"text","text":" if available — dispatching "},{"code":".verdictReceived(...)","type":"codeVoice"},{"type":"text","text":" from the cache "},{"inlineContent":[{"type":"text","text":"and"}],"type":"strong"},{"type":"text","text":" "},{"code":".fetchFailed(message)","type":"codeVoice"},{"type":"text","text":" so the UI can surface the error while keeping a usable verdict"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".verdictReceived(verdict)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"sets "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":", sets "},{"code":"lastFetch = Date()","type":"codeVoice"},{"type":"text","text":", clears "},{"code":"fetchError","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".fetchFailed(message)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"sets "},{"code":"fetchError = message","type":"codeVoice"},{"type":"text","text":" (does not clear "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":" or "},{"code":"lastFetch","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".openUpdateURL","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"none"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"if "},{"code":"verdict","type":"codeVoice"},{"type":"text","text":" is "},{"code":".blocked","type":"codeVoice"},{"type":"text","text":" with a non-nil "},{"code":"updateURL","type":"codeVoice"},{"type":"text","text":", calls the plugin’s "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" closure; otherwise no effect"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"text":"The plugin only handles its own actions. Any action that ","type":"text"},{"code":"extractAction","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for is ignored — the plugin’s ","type":"text"},{"code":"reduce(...)","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" immediately.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The combination of ","type":"text"},{"code":".forceFetch","type":"codeVoice"},{"text":"’s cached-fallback behavior and ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":"‘s cache-freshness gate is the basis for the plugin’s offline tolerance: a launch on a flaky network still yields a verdict (cached) and an error indicator (","type":"text"},{"code":"fetchError","type":"codeVoice"},{"text":"), without leaving the UI stuck on ","type":"text"},{"code":".unknown","type":"codeVoice"},{"text":".","type":"text"}]},{"style":"note","content":[{"inlineContent":[{"type":"text","text":""},{"code":".verdictReceived","type":"codeVoice"},{"type":"text","text":" is dispatched on every "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":"\/"},{"code":".forceFetch","type":"codeVoice"},{"type":"text","text":" (cache hit or network), usually with an unchanged verdict. Consume verdict transitions by observing "},{"code":"KillswitchState","type":"codeVoice"},{"type":"text","text":" or a value derived from it — not by mapping this action. See "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Note","type":"aside"},{"level":2,"anchor":"Verdict-evaluation-rules","text":"Verdict evaluation rules","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"KillswitchVerdict.evaluate(_:against:)","type":"codeVoice"},{"text":" is fail-open: any unparseable input yields ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":". Checks run in this fixed order, returning ","type":"text"},{"code":".blocked(...)","type":"codeVoice"},{"text":" on the first match:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Current version parse."}]},{"type":"text","text":" If "},{"code":"currentVersionString","type":"codeVoice"},{"type":"text","text":" cannot be parsed as a "},{"code":"SemanticVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".allowed","type":"codeVoice"},{"type":"text","text":" immediately."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Minimum supported version."}]},{"type":"text","text":" If "},{"code":"config.minimumSupportedVersion","type":"codeVoice"},{"type":"text","text":" parses and "},{"code":"currentVersion < minVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Explicit blocked versions."}],"type":"strong"},{"type":"text","text":" Iterate "},{"type":"codeVoice","code":"config.blockedVersions"},{"type":"text","text":". If any entry parses and equals "},{"code":"currentVersion","type":"codeVoice"},{"type":"text","text":", return "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Blocked ranges."}]},{"type":"text","text":" Iterate "},{"code":"config.blockedRanges","type":"codeVoice"},{"type":"text","text":". If any entry parses as a "},{"code":"VersionRange","type":"codeVoice"},{"type":"text","text":" and contains "},{"type":"codeVoice","code":"currentVersion"},{"type":"text","text":", return "},{"code":".blocked(...)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Otherwise"}]},{"text":" return ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A blocked verdict carries the config’s "},{"code":"blockedTitle","type":"codeVoice"},{"type":"text","text":", "},{"code":"blockedMessage","type":"codeVoice"},{"type":"text","text":", and "},{"code":"updateURL","type":"codeVoice"},{"type":"text","text":" (parsed via "},{"code":"URL(string:)","type":"codeVoice"},{"type":"text","text":") regardless of which check matched."}]},{"level":2,"anchor":"Remote-config-JSON-shape","text":"Remote config JSON shape","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"KillswitchConfig"},{"text":" derives its ","type":"text"},{"type":"codeVoice","code":"Codable"},{"type":"text","text":" conformance from synthesized keys, so the JSON keys match the property names. A representative file:"}]},{"type":"codeListing","code":["{","    \"minimumSupportedVersion\": \"1.2.0\",","    \"blockedVersions\": [\"1.3.0\", \"1.3.1\"],","    \"blockedRanges\": [\"1.4.0..<1.4.5\"],","    \"blockedTitle\": \"Update Required\",","    \"blockedMessage\": \"Please update to continue using the app.\",","    \"updateURL\": \"https:\/\/apps.apple.com\/app\/id000000000\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every field is optional. An empty object "},{"code":"{}","type":"codeVoice"},{"text":" is valid and evaluates to ","type":"text"},{"code":".allowed","type":"codeVoice"},{"text":" for any version.","type":"text"}]},{"text":"View modifier: `killswitchBlocker`","type":"heading","level":2,"anchor":"View-modifier-killswitchBlocker"},{"type":"paragraph","inlineContent":[{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" ships a SwiftUI view modifier that overlays a non-dismissible blocker whenever the verdict is ","type":"text"},{"code":".blocked","type":"codeVoice"},{"text":" and disables the underlying content while it is. Two overloads:","type":"text"}]},{"type":"codeListing","code":["extension View {","    \/\/\/ Default blocker — full-screen ultraThinMaterial with title, message,","    \/\/\/ and an optional Update button.","    public func killswitchBlocker(","        verdict: KillswitchVerdict,","        onUpdate: (() -> Void)? = nil","    ) -> some View","","    \/\/\/ Custom blocker — receives the title,