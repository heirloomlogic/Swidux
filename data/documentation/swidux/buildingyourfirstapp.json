{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingYourFirstApp"},"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article","title":"Build Your First Swidux App"},"variants":[{"paths":["\/documentation\/swidux\/buildingyourfirstapp"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"By the end of this tutorial you’ll have a working SwiftUI app that manages a list of named counters. You can add and remove counters, increment and decrement, rename via "},{"type":"codeVoice","code":"TextField"},{"type":"text","text":", kick off an async increment that fires after a one-second delay, and undo or redo any change with the standard menubar shortcuts. The end-state mirrors the app under "},{"type":"codeVoice","code":"Examples\/Counter\/"},{"type":"text","text":" in the Swidux repo, so you can diff your work against it."}]},{"type":"heading","anchor":"What-youll-build","text":"What you’ll build","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A small macOS\/iOS app with:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"A list of counters, each with a name and an integer value.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A toolbar ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" button that adds a new counter.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Per-row buttons for increment, decrement, and async-increment.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"TextField"},{"type":"text","text":" per row that renames the counter."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Tap to select a counter — the row highlights.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Undo and redo (cmd-Z \/ shift-cmd-Z on macOS)."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"What-youll-learn","text":"What you’ll learn","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Defining state with ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Designing actions as nested enums.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Writing reducers that mutate state via ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Returning effects for async work.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Wiring a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference"},{"text":" with plugins for undo and persistence logging.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Reading state from views via ","type":"text"},{"code":"@dynamicMemberLookup","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"heading","anchor":"Step-1-Create-the-project-and-add-Swidux","text":"Step 1: Create the project and add Swidux","level":2},{"type":"paragraph","inlineContent":[{"text":"In Xcode, create a new SwiftUI app project. Then add Swidux as a package dependency: ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"File > Add Package Dependencies"}]},{"text":", paste ","type":"text"},{"type":"codeVoice","code":"https:\/\/github.com\/heirloomlogic\/Swidux"},{"text":", choose ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Up to Next Major"}]},{"text":" from ","type":"text"},{"type":"codeVoice","code":"1.0.0"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You’ll re-export Swidux from one file so the rest of the app doesn’t need to import it.","type":"text"}]},{"type":"heading","anchor":"Step-2-Define-the-model","text":"Step 2: Define the model","level":2},{"type":"paragraph","inlineContent":[{"text":"A counter has an ID, a name, and an integer count. Make it ","type":"text"},{"type":"codeVoice","code":"Identifiable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" — ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"text":" requires all three.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Models\/Counter.swift","import Foundation","","nonisolated struct Counter: Identifiable, Equatable, Sendable {","    var id: UUID","    var name: String","    var count: Int","","    init(id: UUID = UUID(), name: String = \"Counter\", count: Int = 0) {","        self.id = id","        self.name = name","        self.count = count","    }","}"]},{"type":"heading","anchor":"Step-3-Define-the-state","text":"Step 3: Define the state","level":2},{"type":"paragraph","inlineContent":[{"text":"There are two state slices: a collection of counters, and a UI slice that tracks which counter is selected. Both get ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":". The parent uses "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" on the UI slice so the macro wires it as a separate observer instead of an opaque leaf — see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"},{"type":"text","text":" for the why."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This file is the one place you import Swidux. Re-export it so no other file has to."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var counters: EntityStore<Counter> = .init()","    @Slice var ui: UIState = .init()","","    init(counters: EntityStore<Counter> = EntityStore(), ui: UIState = UIState()) {","        self.counters = counters","        self.ui = ui","    }","}","","@Swidux","nonisolated struct UIState: Equatable, Sendable {","    var selectedCounterID: UUID? = nil","}"]},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" is Swidux’s keyed collection — like an ordered dictionary, with built-in change tracking for persistence and undo."}]},{"type":"heading","anchor":"Step-4-Define-the-actions","text":"Step 4: Define the actions","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every user interaction and every effect callback is expressed as a value of "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":". Splitting into nested enums ("},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":" -> "},{"type":"codeVoice","code":"CounterAction"},{"type":"text","text":") keeps each feature’s actions colocated and makes the root reducer’s "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" shallow."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppAction.swift","import Foundation","","enum AppAction: Sendable {","    case counter(CounterAction)","    case selectCounter(UUID?)","}","","enum CounterAction: Sendable {","    case add","    case remove(UUID)","    case increment(UUID)","    case decrement(UUID)","    case incrementAsync(UUID)","    case setName(UUID, String)","}"]},{"type":"heading","anchor":"Step-5-Specialize-the-effect-typealiases","text":"Step 5: Specialize the effect typealiases","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swidux’s effect system is generic over your action type. Pin it to "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":" once so you don’t repeat the generic parameters everywhere."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/Effect.swift","import Foundation","","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Send"},{"type":"text","text":" is "},{"type":"codeVoice","code":"@MainActor @Sendable (AppAction) -> Void"},{"type":"text","text":". "},{"type":"codeVoice","code":"Effect"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"@Sendable"},{"type":"text","text":" async closure that takes a "},{"type":"codeVoice","code":"Send"},{"type":"text","text":". Effects are returned from the reducer when an action needs to do async work."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You’ll also want an environment type to hold injected dependencies. The Counter demo has none, so it’s a placeholder:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppEnvironment.swift","import Foundation","","struct AppEnvironment: Sendable {","    static func live() -> AppEnvironment { .init() }","    static func mock() -> AppEnvironment { .init() }","}"]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"This demo builds its store from a ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" context, so the default argument ","type":"text"},{"code":"= .live()","type":"codeVoice"},{"text":" is evaluated on the main actor and a plain ","type":"text"},{"code":"struct AppEnvironment: Sendable","type":"codeVoice"},{"text":" works. If your app constructs the store from a ","type":"text"},{"inlineContent":[{"text":"nonisolated","type":"text"}],"type":"strong"},{"text":" context instead — e.g. a ","type":"text"},{"type":"codeVoice","code":"nonisolated static func configured(...)"},{"text":" factory, or building the environment in a detached task — that default-argument expression is evaluated nonisolated, and ","type":"text"},{"type":"codeVoice","code":".live()"},{"text":" must be callable there. Mark the environment ","type":"text"},{"code":"nonisolated struct AppEnvironment: Sendable","type":"codeVoice"},{"text":" in that case (which makes ","type":"text"},{"code":"live()","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"mock()","type":"codeVoice"},{"text":" nonisolated too).","type":"text"}]}]},{"type":"heading","anchor":"Step-6-Write-the-reducer","text":"Step 6: Write the reducer","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The reducer is a pure function from "},{"code":"(state, action, environment)","type":"codeVoice"},{"text":" to an optional ","type":"text"},{"code":"Effect","type":"codeVoice"},{"text":". State mutates via ","type":"text"},{"code":"inout","type":"codeVoice"},{"type":"text","text":". Any case that doesn’t need async work returns "},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start with the per-feature reducer. The interesting case is "},{"type":"codeVoice","code":"incrementAsync"},{"type":"text","text":": it returns an effect that sleeps for a second, then dispatches a synchronous "},{"type":"codeVoice","code":"increment"},{"type":"text","text":"."}]},{"type":"codeListing","code":["\/\/ Features\/CounterReducer.swift","import Foundation","","struct CounterReducer: SwiduxReducer {","    func reduce(","        state: inout AppState,","        action: CounterAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .add:","            let counter = Counter(name: \"Counter \\(state.counters.count + 1)\")","            state.counters[counter.id] = counter","","        case .remove(let id):","            state.counters[id] = nil","","        case .increment(let id):","            state.counters.modify(id) { $0.count += 1 }","","        case .decrement(let id):","            state.counters.modify(id) { $0.count = max(0, $0.count - 1) }","","        case .incrementAsync(let id):","            return { send in","                try? await Task.sleep(for: .seconds(1))","                await send(.counter(.increment(id)))","            }","","        case .setName(let id, let name):","            state.counters.modify(id) { $0.name = name }","        }","","        return nil","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Then the root reducer, which routes "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":" cases to feature reducers and handles top-level cases inline."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppReducer.swift","import Foundation","","struct AppReducer: SwiduxReducer {","    let counter = CounterReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .counter(let action):","            return counter.reduce(state: &state, action: action, environment: environment)","","        case .selectCounter(let id):","            state.ui.selectedCounterID = id","        }","","        return nil","    }","}"]},{"type":"heading","anchor":"Step-7-Wire-the-store","text":"Step 7: Wire the store","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"type":"text","text":" owns the dispatch loop, plugin lifecycle, and observer tree. Build it from a factory method so views and previews get the same wiring. Register two plugins:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"type":"text","text":" records snapshots before each undoable action. The "},{"code":"isUndoable","type":"codeVoice"},{"type":"text","text":" predicate decides which actions count; "},{"code":"coalescing","type":"codeVoice"},{"text":" collapses runs of the same action (so typing into the rename field doesn’t create one undo entry per keystroke).","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"type":"text","text":" is registered with a "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" over "},{"type":"codeVoice","code":"\\.counters"},{"type":"text","text":". The Counter demo just logs the writes — in a real app you’d persist to a database."}],"type":"paragraph"}]}]},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppStore.swift","import SwiftUI","import os","","typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        let reducer = AppReducer()","        let logger = Logger(","            subsystem: Bundle.main.bundleIdentifier ?? \"counter\",","            category: \"persistence\"","        )","","        let isUndoable: @Sendable (AppAction) -> Bool = { action in","            switch action {","            case .counter(.add), .counter(.remove),","                 .counter(.increment), .counter(.decrement),","                 .counter(.setName):","                true","            case .counter(.incrementAsync), .selectCounter:","                false","            }","        }","","        let undoPlugin = UndoPlugin<AppState, AppAction>(","            isUndoable: isUndoable,","            coalescing: { action in","                if case .counter(.setName) = action { return true }","                return false","            }","        )","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.counters) { writes, deletes in","                    for counter in writes {","                        logger.info(\"Persist upsert: \\(counter.name) = \\(counter.count)\")","                    }","                    for id in deletes {","                        logger.info(\"Persist delete: \\(id)\")","                    }","                }","            ],","            logger: logger","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"]},{"type":"heading","anchor":"Step-8-Build-the-views","text":"Step 8: Build the views","level":2},{"type":"paragraph","inlineContent":[{"text":"Views read from the store via ","type":"text"},{"type":"codeVoice","code":"@Environment"},{"text":" and dispatch actions with ","type":"text"},{"type":"codeVoice","code":"store.send(...)"},{"text":". They never import Swidux directly (the re-export from ","type":"text"},{"type":"codeVoice","code":"AppState.swift"},{"text":" handles that).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The list view binds to ","type":"text"},{"type":"codeVoice","code":"store.counters.values"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"@dynamicMemberLookup"},{"text":" forwards through to the generated observer class, so SwiftUI observation picks up changes per slice.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Views\/ContentView.swift","import SwiftUI","","struct ContentView: View {","    @Environment(AppStore.self) private var store","    @Environment(\\.undoManager) private var undoManager","","    var body: some View {","        NavigationStack {","            List(store.counters.values) { counter in","                CounterRow(counterID: counter.id)","                    .listRowBackground(","                        store.ui.selectedCounterID == counter.id","                            ? Color.accentColor.opacity(0.15)","                            : Color.clear","                    )","                    .contentShape(Rectangle())","                    .onTapGesture {","                        store.send(.selectCounter(counter.id))","                    }","            }","            .navigationTitle(\"Counters\")","            .toolbar {","                Button(\"Add Counter\", systemImage: \"plus\") {","                    store.send(.counter(.add))","                }","            }","            .overlay {","                if store.counters.isEmpty {","                    ContentUnavailableView(","                        \"No Counters\",","                        systemImage: \"number.square\",","                        description: Text(\"Tap + to add a counter.\")","                    )","                }","            }","            .onAppear { store.undoManager = undoManager }","            .onChange(of: undoManager) { _, new in store.undoManager = new }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The row takes a ","type":"text"},{"type":"codeVoice","code":"counterID"},{"text":" rather than the full ","type":"text"},{"type":"codeVoice","code":"Counter"},{"text":". That lets SwiftUI skip re-evaluation of unchanged rows when the parent’s body runs. The ","type":"text"},{"type":"codeVoice","code":"TextField"},{"text":" is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"controlled"}]},{"text":": the binding goes straight through the store. There’s no local ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" — the store is the single source of truth.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Views\/CounterRow.swift","import SwiftUI","","struct CounterRow: View {","    @Environment(AppStore.self) private var store","    let counterID: UUID","","    var body: some View {","        if let counter = store.counters[counterID] {","            HStack {","                TextField(","                    \"Name\",","                    text: Binding(","                        get: { counter.name },","                        set: { store.send(.counter(.setName(counterID, $0))) }","                    )","                )","                .textFieldStyle(.plain)","                .frame(maxWidth: .infinity, alignment: .leading)","","                Spacer()","","                Text(\"\\(counter.count)\")","                    .font(.title2.monospacedDigit())","                    .frame(minWidth: 40)","","                Button {","                    store.send(.counter(.decrement(counterID)))","                } label: {","                    Image(systemName: \"minus.circle\")","                }","","                Button {","                    store.send(.counter(.increment(counterID)))","                } label: {","                    Image(systemName: \"plus.circle\")","                }","","                Button {","                    store.send(.counter(.incrementAsync(counterID)))","                } label: {","                    Image(systemName: \"clock.arrow.circlepath\")","                }","                .help(\"Increment after 1 second delay\")","            }","            .buttonStyle(.borderless)","        }","    }","}"]},{"type":"heading","anchor":"A-shorter-binding-helper","text":"A shorter binding helper","level":3},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"TextField"},{"text":" above reads ","type":"text"},{"type":"codeVoice","code":"counter.name"},{"text":" after an optional unwrap and dispatches ","type":"text"},{"type":"codeVoice","code":"setName(counterID, ...)"},{"text":". That’s a ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"transformed read"}]},{"text":" — the keypath doesn’t fit cleanly — so the explicit ","type":"text"},{"type":"codeVoice","code":"Binding(get:set:)"},{"text":" is the right tool.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When the read is a plain keypath into the store, prefer ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/binding(_:sending:)","isActive":true},{"text":". The Counter example demonstrates this with a toolbar slider that tunes the delay used by ","type":"text"},{"type":"codeVoice","code":"incrementAsync"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ In ContentView's toolbar","Slider(","    value: store.binding(\\.ui.asyncDelay) { .setAsyncDelay($0) },","    in: 0.1...3.0,","    step: 0.1",")"]},{"type":"paragraph","inlineContent":[{"text":"The keypath is resolved against the generated observer tree, so SwiftUI registers a fine-grained dependency on ","type":"text"},{"type":"codeVoice","code":"ui.asyncDelay"},{"text":" only — mutations to other slices don’t invalidate this view. The trailing closure keeps the action constructor visible at the call site.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This closes the unidirectional loop in one tour: slider → ","type":"text"},{"type":"codeVoice","code":"setAsyncDelay"},{"text":" action → reducer mutates ","type":"text"},{"type":"codeVoice","code":"state.ui.asyncDelay"},{"text":" → next tap on the async button reads the new value when constructing its ","type":"text"},{"type":"codeVoice","code":"Effect"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Two cases that still want raw ","type":"text"},{"type":"codeVoice","code":"Binding(get:set:)"},{"text":":","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Transformed reads:","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"counter?.name ?? \"\""},{"type":"text","text":", "},{"type":"codeVoice","code":"!store.analytics.isOptedOut"},{"type":"text","text":", EntityStore subscript lookups."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Setter side effects:","type":"text"}]},{"type":"text","text":" wrapping the dispatch in "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":", branching, or guard logic."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Step-9-Wire-the-app-entry","text":"Step 9: Wire the app entry","level":2},{"type":"paragraph","inlineContent":[{"text":"Own the store with ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" so it survives ","type":"text"},{"type":"codeVoice","code":"Scene"},{"text":" body re-evaluations. Inject it via ","type":"text"},{"type":"codeVoice","code":".environment()"},{"text":". On macOS, replace the standard undo command group so cmd-Z talks to ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/undo()","isActive":true},{"text":" instead of the system undo manager.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ CounterApp.swift","import SwiftUI","","@main","struct CounterApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        #if os(macOS)","        .commands {","            CommandGroup(replacing: .undoRedo) {","                Button(\"Undo\") { store.undo() }","                    .keyboardShortcut(\"z\", modifiers: .command)","                    .disabled(!store.canUndo)","                Button(\"Redo\") { store.redo() }","                    .keyboardShortcut(\"z\", modifiers: [.command, .shift])","                    .disabled(!store.canRedo)","            }","        }","        #endif","    }","}"]},{"type":"heading","anchor":"Run-it","text":"Run it","level":2},{"type":"paragraph","inlineContent":[{"text":"Build and run. You should see an empty list with “No Counters” placeholder text. Click ","type":"text"},{"type":"codeVoice","code":"+"},{"text":" in the toolbar — a row appears. Click ","type":"text"},{"type":"codeVoice","code":"+"},{"text":" again — a second row. Click on a row — its background tints with the accent color. Click ","type":"text"},{"type":"codeVoice","code":"+"},{"text":" (per-row) to increment the count, ","type":"text"},{"type":"codeVoice","code":"-"},{"text":" to decrement, the clock icon to increment after one second. Edit the name field — the rename persists immediately (and the persistence plugin logs each upsert to the console).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"On macOS, hit cmd-Z to undo. Each add, remove, increment, decrement, and rename should reverse one step at a time. Renames coalesce — a single undo restores the whole previous name, not one keystroke. Hit shift-cmd-Z to redo.","type":"text"}]},{"type":"heading","anchor":"What-just-happened","text":"What just happened","level":2},{"type":"paragraph","inlineContent":[{"text":"Four parts wired together. ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Views"}]},{"text":" render from ","type":"text"},{"type":"codeVoice","code":"store.counters"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"store.ui"},{"text":" and dispatch actions through ","type":"text"},{"type":"codeVoice","code":"store.send(...)"},{"text":". ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Actions"}]},{"text":" (","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":", ","type":"text"},{"type":"codeVoice","code":"CounterAction"},{"text":") describe what happened. The ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"reducer"}]},{"text":" translates actions into state mutations, optionally returning an ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"effect"}]},{"text":" for async work. The ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"store"}]},{"text":" runs the dispatch loop: it packs the observer tree into a struct snapshot, hands it to your reducer, then unpacks the result back onto the observer — firing per-property observation only for fields that actually changed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The async increment shows the round trip. A button click dispatches ","type":"text"},{"type":"codeVoice","code":".counter(.incrementAsync(id))"},{"text":". The reducer returns an effect that sleeps off the MainActor, then calls ","type":"text"},{"type":"codeVoice","code":"send(.counter(.increment(id)))"},{"text":". That second dispatch goes through the same loop, hits the synchronous ","type":"text"},{"type":"codeVoice","code":".increment"},{"text":" case, and updates the counter — which fires observation and re-renders just that row’s count label.","type":"text"}]},{"type":"heading","anchor":"Next-steps","text":"Next steps","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"type":"text","text":" — gate features behind a subscription."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch"},{"type":"text","text":" — force-update unsupported app versions."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},{"type":"text","text":" — block underage purchases."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"},{"type":"text","text":" — full reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide"},{"type":"text","text":" — the snapshot\/observer pattern and its performance characteristics."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":" — write your own plugin."}],"type":"paragraph"}]}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Build a counter app from scratch and meet the four moving parts of a Swidux project: state, action, reducer, and store."}],"kind":"article","sections":[],"references":{"doc://Swidux/documentation/Swidux/EntityStore":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}],"type":"topic","url":"\/documentation\/swidux\/entitystore","abstract":[{"type":"text","text":"An ordered, keyed collection of identifiable entities that silently records"},{"type":"text","text":" "},{"type":"text","text":"every mutation for downstream persistence."}],"title":"EntityStore","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"EntityStore","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/Store/binding(_:s