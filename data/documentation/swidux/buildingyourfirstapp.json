{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"By the end of this tutorial you’ll have a working SwiftUI app that manages a list of named counters. You can add and remove counters, increment and decrement, rename via ","type":"text"},{"code":"TextField","type":"codeVoice"},{"text":", kick off an async increment that fires after a one-second delay, and undo or redo any change with the standard menubar shortcuts. The end-state mirrors the app under ","type":"text"},{"code":"Examples\/Counter\/","type":"codeVoice"},{"text":" in the Swidux repo, so you can diff your work against it.","type":"text"}]},{"text":"What you’ll build","type":"heading","level":2,"anchor":"What-youll-build"},{"type":"paragraph","inlineContent":[{"text":"A small macOS\/iOS app with:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"A list of counters, each with a name and an integer value.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A toolbar ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" button that adds a new counter.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Per-row buttons for increment, decrement, and async-increment.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"code":"TextField","type":"codeVoice"},{"text":" per row that renames the counter.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Tap to select a counter — the row highlights.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Undo and redo (cmd-Z \/ shift-cmd-Z on macOS).","type":"text"}],"type":"paragraph"}]}]},{"text":"What you’ll learn","type":"heading","level":2,"anchor":"What-youll-learn"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Defining state with ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Designing actions as nested enums.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Writing reducers that mutate state via ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Returning effects for async work.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Wiring a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference"},{"text":" with plugins for undo and persistence logging.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Reading state from views via ","type":"text"},{"code":"@dynamicMemberLookup","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"text":"Step 1: Create the project and add Swidux","type":"heading","level":2,"anchor":"Step-1-Create-the-project-and-add-Swidux"},{"type":"paragraph","inlineContent":[{"text":"In Xcode, create a new SwiftUI app project. Then add Swidux as a package dependency: ","type":"text"},{"inlineContent":[{"type":"text","text":"File > Add Package Dependencies"}],"type":"strong"},{"text":", paste ","type":"text"},{"code":"https:\/\/github.com\/heirloomlogic\/Swidux","type":"codeVoice"},{"text":", choose ","type":"text"},{"inlineContent":[{"type":"text","text":"Up to Next Major"}],"type":"strong"},{"text":" from ","type":"text"},{"code":"1.0.0","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You’ll re-export Swidux from one file so the rest of the app doesn’t need to import it.","type":"text"}]},{"text":"Step 2: Define the model","type":"heading","level":2,"anchor":"Step-2-Define-the-model"},{"type":"paragraph","inlineContent":[{"text":"A counter has an ID, a name, and an integer count. Make it ","type":"text"},{"code":"Identifiable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" — ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" requires all three.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Models\/Counter.swift","import Foundation","","nonisolated struct Counter: Identifiable, Equatable, Sendable {","    var id: UUID","    var name: String","    var count: Int","","    init(id: UUID = UUID(), name: String = \"Counter\", count: Int = 0) {","        self.id = id","        self.name = name","        self.count = count","    }","}"]},{"text":"Step 3: Define the state","type":"heading","level":2,"anchor":"Step-3-Define-the-state"},{"type":"paragraph","inlineContent":[{"text":"There are two state slices: a collection of counters, and a UI slice that tracks which counter is selected. Both get ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":". The parent uses ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" on the UI slice so the macro wires it as a separate observer instead of an opaque leaf — see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","isActive":true,"type":"reference"},{"text":" for the why.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This file is the one place you import Swidux. Re-export it so no other file has to.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var counters: EntityStore<Counter> = .init()","    @Slice var ui: UIState = .init()","","    init(counters: EntityStore<Counter> = EntityStore(), ui: UIState = UIState()) {","        self.counters = counters","        self.ui = ui","    }","}","","@Swidux","nonisolated struct UIState: Equatable, Sendable {","    var selectedCounterID: UUID? = nil","}"]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" is Swidux’s keyed collection — like an ordered dictionary, with built-in change tracking for persistence and undo.","type":"text"}]},{"text":"Step 4: Define the actions","type":"heading","level":2,"anchor":"Step-4-Define-the-actions"},{"type":"paragraph","inlineContent":[{"text":"Every user interaction and every effect callback is expressed as a value of ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":". Splitting into nested enums (","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":" -> ","type":"text"},{"code":"CounterAction","type":"codeVoice"},{"text":") keeps each feature’s actions colocated and makes the root reducer’s ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" shallow.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppAction.swift","import Foundation","","enum AppAction: Sendable {","    case counter(CounterAction)","    case selectCounter(UUID?)","}","","enum CounterAction: Sendable {","    case add","    case remove(UUID)","    case increment(UUID)","    case decrement(UUID)","    case incrementAsync(UUID)","    case setName(UUID, String)","}"]},{"text":"Step 5: Specialize the effect typealiases","type":"heading","level":2,"anchor":"Step-5-Specialize-the-effect-typealiases"},{"type":"paragraph","inlineContent":[{"text":"Swidux’s effect system is generic over your action type. Pin it to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":" once so you don’t repeat the generic parameters everywhere.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/Effect.swift","import Foundation","","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"]},{"type":"paragraph","inlineContent":[{"code":"Send","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"@MainActor @Sendable (AppAction) -> Void","type":"codeVoice"},{"text":". ","type":"text"},{"code":"Effect","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"@Sendable","type":"codeVoice"},{"text":" async closure that takes a ","type":"text"},{"code":"Send","type":"codeVoice"},{"text":". Effects are returned from the reducer when an action needs to do async work.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"You’ll also want an environment type to hold injected dependencies. The Counter demo has none, so it’s a placeholder:","type":"text"}]},{"code":["\/\/ App\/AppEnvironment.swift","import Foundation","","struct AppEnvironment: Sendable {","    static func live() -> AppEnvironment { .init() }","    static func mock() -> AppEnvironment { .init() }","}"],"type":"codeListing","syntax":"swift"},{"name":"Note","content":[{"inlineContent":[{"text":"This demo builds its store from a ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" context, so the default argument ","type":"text"},{"code":"= .live()","type":"codeVoice"},{"text":" is evaluated on the main actor and a plain ","type":"text"},{"code":"struct AppEnvironment: Sendable","type":"codeVoice"},{"text":" works. If your app constructs the store from a ","type":"text"},{"inlineContent":[{"type":"text","text":"nonisolated"}],"type":"strong"},{"text":" context instead — e.g. a ","type":"text"},{"code":"nonisolated static func configured(...)","type":"codeVoice"},{"text":" factory, or building the environment in a detached task — that default-argument expression is evaluated nonisolated, and ","type":"text"},{"code":".live()","type":"codeVoice"},{"text":" must be callable there. Mark the environment ","type":"text"},{"code":"nonisolated struct AppEnvironment: Sendable","type":"codeVoice"},{"text":" in that case (which makes ","type":"text"},{"code":"live()","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"mock()","type":"codeVoice"},{"text":" nonisolated too).","type":"text"}],"type":"paragraph"}],"type":"aside","style":"note"},{"anchor":"Step-6-Write-the-reducer","text":"Step 6: Write the reducer","type":"heading","level":2},{"inlineContent":[{"text":"The reducer is a pure function from ","type":"text"},{"code":"(state, action, environment)","type":"codeVoice"},{"text":" to an optional ","type":"text"},{"code":"Effect","type":"codeVoice"},{"text":". State mutates via ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":". Any case that doesn’t need async work returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Start with the per-feature reducer. The interesting case is "},{"code":"incrementAsync","type":"codeVoice"},{"type":"text","text":": it returns an effect that sleeps for a second, then dispatches a synchronous "},{"code":"increment","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["\/\/ Features\/CounterReducer.swift","import Foundation","","struct CounterReducer: SwiduxReducer {","    func reduce(","        state: inout AppState,","        action: CounterAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .add:","            let counter = Counter(name: \"Counter \\(state.counters.count + 1)\")","            state.counters[counter.id] = counter","","        case .remove(let id):","            state.counters[id] = nil","","        case .increment(let id):","            state.counters.modify(id) { $0.count += 1 }","","        case .decrement(let id):","            state.counters.modify(id) { $0.count = max(0, $0.count - 1) }","","        case .incrementAsync(let id):","            return { send in","                try? await Task.sleep(for: .seconds(1))","                await send(.counter(.increment(id)))","            }","","        case .setName(let id, let name):","            state.counters.modify(id) { $0.name = name }","        }","","        return nil","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Then the root reducer, which routes "},{"code":"AppAction","type":"codeVoice"},{"text":" cases to feature reducers and handles top-level cases inline.","type":"text"}],"type":"paragraph"},{"code":["\/\/ App\/AppReducer.swift","import Foundation","","struct AppReducer: SwiduxReducer {","    let counter = CounterReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .counter(let action):","            return counter.reduce(state: &state, action: action, environment: environment)","","        case .selectCounter(let id):","            state.ui.selectedCounterID = id","        }","","        return nil","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-7-Wire-the-store","text":"Step 7: Wire the store","type":"heading","level":2},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference","isActive":true},{"text":" owns the dispatch loop, plugin lifecycle, and observer tree. Build it from a factory method so views and previews get the same wiring. Register two plugins:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":" records snapshots before each undoable action. The ","type":"text"},{"code":"isUndoable","type":"codeVoice"},{"text":" predicate decides which actions count; ","type":"text"},{"code":"coalescing","type":"codeVoice"},{"text":" collapses runs of the same action (so typing into the rename field doesn’t create one undo entry per keystroke).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true,"type":"reference"},{"text":" is registered with a ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" over ","type":"text"},{"code":"\\.counters","type":"codeVoice"},{"text":". The Counter demo just logs the writes — in a real app you’d persist to a database.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppStore.swift","import SwiftUI","import os","","typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        let reducer = AppReducer()","        let logger = Logger(","            subsystem: Bundle.main.bundleIdentifier ?? \"counter\",","            category: \"persistence\"","        )","","        let isUndoable: @Sendable (AppAction) -> Bool = { action in","            switch action {","            case .counter(.add), .counter(.remove),","                 .counter(.increment), .counter(.decrement),","                 .counter(.setName):","                true","            case .counter(.incrementAsync), .selectCounter:","                false","            }","        }","","        let undoPlugin = UndoPlugin<AppState, AppAction>(","            isUndoable: isUndoable,","            coalescing: { action in","                if case .counter(.setName) = action { return true }","                return false","            }","        )","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.counters) { writes, deletes in","                    for counter in writes {","                        logger.info(\"Persist upsert: \\(counter.name) = \\(counter.count)\")","                    }","                    for id in deletes {","                        logger.info(\"Persist delete: \\(id)\")","                    }","                }","            ],","            logger: logger","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"]},{"text":"Step 8: Build the views","type":"heading","level":2,"anchor":"Step-8-Build-the-views"},{"type":"paragraph","inlineContent":[{"text":"Views read from the store via ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" and dispatch actions with ","type":"text"},{"code":"store.send(...)","type":"codeVoice"},{"text":". They never import Swidux directly (the re-export from ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"text":" handles that).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The list view binds to ","type":"text"},{"code":"store.counters.values","type":"codeVoice"},{"text":" — ","type":"text"},{"code":"@dynamicMemberLookup","type":"codeVoice"},{"text":" forwards through to the generated observer class, so SwiftUI observation picks up changes per slice.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Views\/ContentView.swift","import SwiftUI","","struct ContentView: View {","    @Environment(AppStore.self) private var store","    @Environment(\\.undoManager) private var undoManager","","    var body: some View {","        NavigationStack {","            List(store.counters.values) { counter in","                CounterRow(counterID: counter.id)","                    .listRowBackground(","                        store.ui.selectedCounterID == counter.id","                            ? Color.accentColor.opacity(0.15)","                            : Color.clear","                    )","                    .contentShape(Rectangle())","                    .onTapGesture {","                        store.send(.selectCounter(counter.id))","                    }","            }","            .navigationTitle(\"Counters\")","            .toolbar {","                Button(\"Add Counter\", systemImage: \"plus\") {","                    store.send(.counter(.add))","                }","            }","            .overlay {","                if store.counters.isEmpty {","                    ContentUnavailableView(","                        \"No Counters\",","                        systemImage: \"number.square\",","                        description: Text(\"Tap + to add a counter.\")","                    )","                }","            }","            .onAppear { store.undoManager = undoManager }","            .onChange(of: undoManager) { _, new in store.undoManager = new }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The row takes a ","type":"text"},{"code":"counterID","type":"codeVoice"},{"text":" rather than the full ","type":"text"},{"code":"Counter","type":"codeVoice"},{"text":". That lets SwiftUI skip re-evaluation of unchanged rows when the parent’s body runs. The ","type":"text"},{"code":"TextField","type":"codeVoice"},{"text":" is ","type":"text"},{"inlineContent":[{"type":"text","text":"controlled"}],"type":"strong"},{"text":": the binding goes straight through the store. There’s no local ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" — the store is the single source of truth.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Views\/CounterRow.swift","import SwiftUI","","struct CounterRow: View {","    @Environment(AppStore.self) private var store","    let counterID: UUID","","    var body: some View {","        if let counter = store.counters[counterID] {","            HStack {","                TextField(","                    \"Name\",","                    text: Binding(","                        get: { counter.name },","                        set: { store.send(.counter(.setName(counterID, $0))) }","                    )","                )","                .textFieldStyle(.plain)","                .frame(maxWidth: .infinity, alignment: .leading)","","                Spacer()","","                Text(\"\\(counter.count)\")","                    .font(.title2.monospacedDigit())","                    .frame(minWidth: 40)","","                Button {","                    store.send(.counter(.decrement(counterID)))","                } label: {","                    Image(systemName: \"minus.circle\")","                }","","                Button {","                    store.send(.counter(.increment(counterID)))","                } label: {","                    Image(systemName: \"plus.circle\")","                }","","                Button {","                    store.send(.counter(.incrementAsync(counterID)))","                } label: {","                    Image(systemName: \"clock.arrow.circlepath\")","                }","                .help(\"Increment after 1 second delay\")","            }","            .buttonStyle(.borderless)","        }","    }","}"]},{"text":"A shorter binding helper","type":"heading","level":3,"anchor":"A-shorter-binding-helper"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"code":"TextField","type":"codeVoice"},{"type":"text","text":" above reads "},{"code":"counter.name","type":"codeVoice"},{"type":"text","text":" after an optional unwrap and dispatches "},{"code":"setName(counterID, ...)","type":"codeVoice"},{"type":"text","text":". That’s a "},{"inlineContent":[{"text":"transformed read","type":"text"}],"type":"emphasis"},{"type":"text","text":" — the keypath doesn’t fit cleanly — so the explicit "},{"code":"Binding(get:set:)","type":"codeVoice"},{"type":"text","text":" is the right tool."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the read is a plain keypath into the store, prefer "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/binding(_:sending:)","type":"reference"},{"type":"text","text":". The Counter example demonstrates this with a toolbar slider that tunes the delay used by "},{"code":"incrementAsync","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ In ContentView's toolbar","Slider(","    value: store.binding(\\.ui.asyncDelay) { .setAsyncDelay($0) },","    in: 0.1...3.0,","    step: 0.1",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The keypath is resolved against the generated observer tree, so SwiftUI registers a fine-grained dependency on "},{"code":"ui.asyncDelay","type":"codeVoice"},{"type":"text","text":" only — mutations to other slices don’t invalidate this view. The trailing closure keeps the action constructor visible at the call site."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This closes the unidirectional loop in one tour: slider → "},{"code":"setAsyncDelay","type":"codeVoice"},{"type":"text","text":" action → reducer mutates "},{"code":"state.ui.asyncDelay","type":"codeVoice"},{"type":"text","text":" → next tap on the async button reads the new value when constructing its "},{"code":"Effect","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two cases that still want raw "},{"code":"Binding(get:set:)","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Transformed reads:","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"counter?.name ?? \"\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"!store.analytics.isOptedOut","type":"codeVoice"},{"text":", EntityStore subscript lookups.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Setter side effects:","type":"text"}],"type":"strong"},{"text":" wrapping the dispatch in ","type":"text"},{"code":"withAnimation","type":"codeVoice"},{"text":", branching, or guard logic.","type":"text"}],"type":"paragraph"}]}]},{"text":"Step 9: Wire the app entry","type":"heading","level":2,"anchor":"Step-9-Wire-the-app-entry"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Own the store with "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" so it survives "},{"code":"Scene","type":"codeVoice"},{"type":"text","text":" body re-evaluations. Inject it via "},{"code":".environment()","type":"codeVoice"},{"type":"text","text":". On macOS, replace the standard undo command group so cmd-Z talks to "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/undo()","type":"reference"},{"type":"text","text":" instead of the system undo manager."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ CounterApp.swift","import SwiftUI","","@main","struct CounterApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        #if os(macOS)","        .commands {","            CommandGroup(replacing: .undoRedo) {","                Button(\"Undo\") { store.undo() }","                    .keyboardShortcut(\"z\", modifiers: .command)","                    .disabled(!store.canUndo)","                Button(\"Redo\") { store.redo() }","                    .keyboardShortcut(\"z\", modifiers: [.command, .shift])","                    .disabled(!store.canRedo)","            }","        }","        #endif","    }","}"]},{"text":"Run it","type":"heading","level":2,"anchor":"Run-it"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Build and run. You should see an empty list with “No Counters” placeholder text. Click "},{"code":"+","type":"codeVoice"},{"type":"text","text":" in the toolbar — a row appears. Click "},{"code":"+","type":"codeVoice"},{"type":"text","text":" again — a second row. Click on a row — its background tints with the accent color. Click "},{"code":"+","type":"codeVoice"},{"type":"text","text":" (per-row) to increment the count, "},{"code":"-","type":"codeVoice"},{"type":"text","text":" to decrement, the clock icon to increment after one second. Edit the name field — the rename persists immediately (and the persistence plugin logs each upsert to the console)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On macOS, hit cmd-Z to undo. Each add, remove, increment, decrement, and rename should reverse one step at a time. Renames coalesce — a single undo restores the whole previous name, not one keystroke. Hit shift-cmd-Z to redo."}]},{"text":"What just happened","type":"heading","level":2,"anchor":"What-just-happened"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Four parts wired together. "},{"inlineContent":[{"text":"Views","type":"text"}],"type":"strong"},{"type":"text","text":" render from "},{"code":"store.counters","type":"codeVoice"},{"type":"text","text":" and "},{"code":"store.ui","type":"codeVoice"},{"type":"text","text":" and dispatch actions through "},{"code":"store.send(...)","type":"codeVoice"},{"type":"text","text":". "},{"inlineContent":[{"text":"Actions","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"CounterAction","type":"codeVoice"},{"text":") describe what happened. The ","type":"text"},{"inlineContent":[{"text":"reducer","type":"text"}],"type":"strong"},{"text":" translates actions into state mutations, optionally returning an ","type":"text"},{"inlineContent":[{"text":"effect","type":"text"}],"type":"strong"},{"text":" for async work. The ","type":"text"},{"inlineContent":[{"text":"store","type":"text"}],"type":"strong"},{"text":" runs the dispatch loop: it packs the observer tree into a struct snapshot, hands it to your reducer, then unpacks the result back onto the observer — firing per-property observation only for fields that actually changed.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The async increment shows the round trip. A button click dispatches ","type":"text"},{"code":".counter(.incrementAsync(id))","type":"codeVoice"},{"text":". The reducer returns an effect that sleeps off the MainActor, then calls ","type":"text"},{"code":"send(.counter(.increment(id)))","type":"codeVoice"},{"text":". That second dispatch goes through the same loop, hits the synchronous ","type":"text"},{"code":".increment","type":"codeVoice"},{"text":" case, and updates the counter — which fires observation and re-renders just that row’s count label.","type":"text"}]},{"text":"Next steps","type":"heading","level":2,"anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","isActive":true},{"text":" — gate features behind a subscription.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","isActive":true},{"text":" — force-update unsupported app versions.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","isActive":true},{"text":" — block underage purchases.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","isActive":true},{"text":" — full reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","isActive":true},{"text":" — the snapshot\/observer pattern and its performance characteristics.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"text":" — write your own plugin.","type":"text"}],"type":"paragraph"}]}]}]}],"sections":[],"kind":"article","variants":[{"paths":["\/documentation\/swidux\/buildingyourfirstapp"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingYourFirstApp","interfaceLanguage":"swift"},"abstract":[{"text":"Build a counter app from scratch and meet the four moving parts of a Swidux project: state, action, reducer, and store.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"title":"Build Your First Swidux App","roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}]},"references":{"doc://Swidux/documentation/Swidux/EntityStore":{"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","url":"\/documentation\/swidux\/entitystore","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityStore"}],"abstract":[{"type":"text","text":"An ordered, keyed collection of identifiable entities that silently records"},{"text":" ","type":"text"},{"type":"text","text":"every mutation for downstream persistence."}],"navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"title":"EntityStore"},"doc://Swidux/documentation/Swidux/PluginArchitectur