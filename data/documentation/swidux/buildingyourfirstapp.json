and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":")."}],"title":"Macros","role":"article","url":"\/documentation\/swidux\/macrosreference"},"doc://Swidux/documentation/Swidux/EntityStore":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityStore","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"EntityStore","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","abstract":[{"type":"text","text":"An ordered, keyed collection of identifiable entities that silently records"},{"type":"text","text":" "},{"type":"text","text":"every mutation for downstream persistence."}],"title":"EntityStore","role":"symbol","url":"\/documentation\/swidux\/entitystore"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"title":"Add a Parental Gate","type":"topic","role":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"url":"\/documentation\/swidux\/howtoaddaparentalgate","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"kind":"article","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall"},"doc://Swidux/documentation/Swidux/PersistencePlugin":{"kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistencePlugin","kind":"identifi