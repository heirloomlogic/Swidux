{"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"By the end of this tutorial you’ll have a working SwiftUI app that manages a list of named counters. You can add and remove counters, increment and decrement, rename via ","type":"text"},{"code":"TextField","type":"codeVoice"},{"text":", kick off an async increment that fires after a one-second delay, and undo or redo any change with the standard menubar shortcuts. The end-state mirrors the app under ","type":"text"},{"code":"Examples\/Counter\/","type":"codeVoice"},{"text":" in the Swidux repo, so you can diff your work against it.","type":"text"}]},{"type":"heading","anchor":"What-youll-build","level":2,"text":"What you’ll build"},{"type":"paragraph","inlineContent":[{"text":"A small macOS\/iOS app with:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A list of counters, each with a name and an integer value.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A toolbar ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" button that adds a new counter.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Per-row buttons for increment, decrement, and async-increment.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"code":"TextField","type":"codeVoice"},{"text":" per row that renames the counter.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Tap to select a counter — the row highlights.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Undo and redo (cmd-Z \/ shift-cmd-Z on macOS).","type":"text"}]}]}]},{"type":"heading","anchor":"What-youll-learn","level":2,"text":"What you’ll learn"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Defining state with "},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Designing actions as nested enums.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Writing reducers that mutate state via ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Returning effects for async work.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Wiring a ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference","isActive":true},{"text":" with plugins for undo and persistence logging.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Reading state from views via ","type":"text"},{"type":"codeVoice","code":"@dynamicMemberLookup"},{"text":".","type":"text"}]}]}]},{"text":"Step 1: Create the project and add Swidux","type":"heading","level":2,"anchor":"Step-1-Create-the-project-and-add-Swidux"},{"type":"paragraph","inlineContent":[{"text":"In Xcode, create a new SwiftUI app project. Then add Swidux as a package dependency: ","type":"text"},{"inlineContent":[{"text":"File > Add Package Dependencies","type":"text"}],"type":"strong"},{"text":", paste ","type":"text"},{"code":"https:\/\/github.com\/heirloomlogic\/Swidux","type":"codeVoice"},{"text":", choose ","type":"text"},{"inlineContent":[{"text":"Up to Next Major","type":"text"}],"type":"strong"},{"text":" from ","type":"text"},{"code":"1.0.0","type":"codeVoice"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"You’ll re-export Swidux from one file so the rest of the app doesn’t need to import it.","type":"text"}],"type":"paragraph"},{"text":"Step 2: Define the model","level":2,"anchor":"Step-2-Define-the-model","type":"heading"},{"inlineContent":[{"text":"A counter has an ID, a name, and an integer count. Make it ","type":"text"},{"code":"Identifiable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" — ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"text":" requires all three.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Models\/Counter.swift","import Foundation","","nonisolated struct Counter: Identifiable, Equatable, Sendable {","    var id: UUID","    var name: String","    var count: Int","","    init(id: UUID = UUID(), name: String = \"Counter\", count: Int = 0) {","        self.id = id","        self.name = name","        self.count = count","    }","}"],"type":"codeListing"},{"text":"Step 3: Define the state","level":2,"anchor":"Step-3-Define-the-state","type":"heading"},{"inlineContent":[{"text":"There are two state slices: a collection of counters, and a UI slice that tracks which counter is selected. Both get ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":". The parent uses ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" on the UI slice so the macro wires it as a separate observer instead of an opaque leaf — see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","isActive":true,"type":"reference"},{"text":" for the why.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This file is the one place you import Swidux. Re-export it so no other file has to.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var counters: EntityStore<Counter> = .init()","    @Slice var ui: UIState = .init()","","    init(counters: EntityStore<Counter> = EntityStore(), ui: UIState = UIState()) {","        self.counters = counters","        self.ui = ui","    }","}","","@Swidux","nonisolated struct UIState: Equatable, Sendable {","    var selectedCounterID: UUID? = nil","}"]},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" is Swidux’s keyed collection — like an ordered dictionary, with built-in change tracking for persistence and undo.","type":"text"}],"type":"paragraph"},{"text":"Step 4: Define the actions","level":2,"anchor":"Step-4-Define-the-actions","type":"heading"},{"inlineContent":[{"text":"Every user interaction and every effect callback is expressed as a value of ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":". Splitting into nested enums ("},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":" -> "},{"type":"codeVoice","code":"CounterAction"},{"text":") keeps each feature’s actions colocated and makes the root reducer’s ","type":"text"},{"type":"codeVoice","code":"switch"},{"type":"text","text":" shallow."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppAction.swift","import Foundation","","enum AppAction: Sendable {","    case counter(CounterAction)","    case selectCounter(UUID?)","}","","enum CounterAction: Sendable {","    case add","    case remove(UUID)","    case increment(UUID)","    case decrement(UUID)","    case incrementAsync(UUID)","    case setName(UUID, String)","}"]},{"text":"Step 5: Specialize the effect typealiases","level":2,"anchor":"Step-5-Specialize-the-effect-typealiases","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Swidux’s effect system is generic over your action type. Pin it to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":" once so you don’t repeat the generic parameters everywhere.","type":"text"}]},{"syntax":"swift","code":["\/\/ App\/Effect.swift","import Foundation","","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"Send"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"@MainActor @Sendable (AppAction) -> Void"},{"text":". ","type":"text"},{"type":"codeVoice","code":"Effect"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"@Sendable"},{"type":"text","text":" async closure that takes a "},{"type":"codeVoice","code":"Send"},{"type":"text","text":". Effects are returned from the reducer when an action needs to do async work."}],"type":"paragraph"},{"inlineContent":[{"text":"You’ll also want an environment type to hold injected dependencies. The Counter demo has none, so it’s a placeholder:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppEnvironment.swift","import Foundation","","struct AppEnvironment: Sendable {","    static func live() -> AppEnvironment { .init() }","    static func mock() -> AppEnvironment { .init() }","}"]},{"name":"Note","style":"note","type":"aside","content":[{"inlineContent":[{"text":"This demo builds its store from a ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" context, so the default argument ","type":"text"},{"code":"= .live()","type":"codeVoice"},{"text":" is evaluated on the main actor and a plain ","type":"text"},{"code":"struct AppEnvironment: Sendable","type":"codeVoice"},{"text":" works. If your app constructs the store from a ","type":"text"},{"inlineContent":[{"type":"text","text":"nonisolated"}],"type":"strong"},{"text":" context instead — e.g. a ","type":"text"},{"code":"nonisolated static func configured(...)","type":"codeVoice"},{"text":" factory, or building the environment in a detached task — that default-argument expression is evaluated nonisolated, and ","type":"text"},{"code":".live()","type":"codeVoice"},{"text":" must be callable there. Mark the environment ","type":"text"},{"code":"nonisolated struct AppEnvironment: Sendable","type":"codeVoice"},{"text":" in that case (which makes ","type":"text"},{"code":"live()","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"mock()","type":"codeVoice"},{"text":" nonisolated too).","type":"text"}],"type":"paragraph"}]},{"text":"Step 6: Write the reducer","anchor":"Step-6-Write-the-reducer","type":"heading","level":2},{"inlineContent":[{"text":"The reducer is a pure function from ","type":"text"},{"code":"(state, action, environment)","type":"codeVoice"},{"text":" to an optional ","type":"text"},{"type":"codeVoice","code":"Effect"},{"text":". State mutates via ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":". Any case that doesn’t need async work returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Start with the per-feature reducer. The interesting case is ","type":"text"},{"type":"codeVoice","code":"incrementAsync"},{"text":": it returns an effect that sleeps for a second, then dispatches a synchronous ","type":"text"},{"code":"increment","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["\/\/ Features\/CounterReducer.swift","import Foundation","","struct CounterReducer: SwiduxReducer {","    func reduce(","        state: inout AppState,","        action: CounterAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .add:","            let counter = Counter(name: \"Counter \\(state.counters.count + 1)\")","            state.counters[counter.id] = counter","","        case .remove(let id):","            state.counters[id] = nil","","        case .increment(let id):","            state.counters.modify(id) { $0.count += 1 }","","        case .decrement(let id):","            state.counters.modify(id) { $0.count = max(0, $0.count - 1) }","","        case .incrementAsync(let id):","            return { send in","                try? await Task.sleep(for: .seconds(1))","                await send(.counter(.increment(id)))","            }","","        case .setName(let id, let name):","            state.counters.modify(id) { $0.name = name }","        }","","        return nil","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Then the root reducer, which routes ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":" cases to feature reducers and handles top-level cases inline.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/AppReducer.swift","import Foundation","","struct AppReducer: SwiduxReducer {","    let counter = CounterReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .counter(let action):","            return counter.reduce(state: &state, action: action, environment: environment)","","        case .selectCounter(let id):","            state.ui.selectedCounterID = id","        }","","        return nil","    }","}"],"type":"codeListing"},{"text":"Step 7: Wire the store","level":2,"anchor":"Step-7-Wire-the-store","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"text":" owns the dispatch loop, plugin lifecycle, and observer tree. Build it from a factory method so views and previews get the same wiring. Register two plugins:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":" records snapshots before each undoable action. The ","type":"text"},{"type":"codeVoice","code":"isUndoable"},{"type":"text","text":" predicate decides which actions count; "},{"type":"codeVoice","code":"coalescing"},{"type":"text","text":" collapses runs of the same action (so typing into the rename field doesn’t create one undo entry per keystroke)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"text":" is registered with a ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" over ","type":"text"},{"code":"\\.counters","type":"codeVoice"},{"text":". The Counter demo just logs the writes — in a real app you’d persist to a database.","type":"text"}],"type":"paragraph"}]}]},{"code":["\/\/ App\/AppStore.swift","import SwiftUI","import os","","typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        let reducer = AppReducer()","        let logger = Logger(","            subsystem: Bundle.main.bundleIdentifier ?? \"counter\",","            category: \"persistence\"","        )","","        let isUndoable: @Sendable (AppAction) -> Bool = { action in","            switch action {","            case .counter(.add), .counter(.remove),","                 .counter(.increment), .counter(.decrement),","                 .counter(.setName):","                true","            case .counter(.incrementAsync), .selectCounter:","                false","            }","        }","","        let undoPlugin = UndoPlugin<AppState, AppAction>(","            isUndoable: isUndoable,","            coalescing: { action in","                if case .counter(.setName) = action { return true }","                return false","            }","        )","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.counters) { writes, deletes in","                    for counter in writes {","                        logger.info(\"Persist upsert: \\(counter.name) = \\(counter.count)\")","                    }","                    for id in deletes {","                        logger.info(\"Persist delete: \\(id)\")","                    }","                }","            ],","            logger: logger","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Step 8: Build the views","anchor":"Step-8-Build-the-views","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Views read from the store via ","type":"text"},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" and dispatch actions with "},{"type":"codeVoice","code":"store.send(...)"},{"type":"text","text":". They never import Swidux directly (the re-export from "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" handles that)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The list view binds to "},{"type":"codeVoice","code":"store.counters.values"},{"type":"text","text":" — "},{"type":"codeVoice","code":"@dynamicMemberLookup"},{"text":" forwards through to the generated observer class, so SwiftUI observation picks up changes per slice.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Views\/ContentView.swift","import SwiftUI","","struct ContentView: View {","    @Environment(AppStore.self) private var store","    @Environment(\\.undoManager) private var undoManager","","    var body: some View {","        NavigationStack {","            List(store.counters.values) { counter in","                CounterRow(counterID: counter.id)","                    .listRowBackground(","                        store.ui.selectedCounterID == counter.id","                            ? Color.accentColor.opacity(0.15)","                            : Color.clear","                    )","                    .contentShape(Rectangle())","                    .onTapGesture {","                        store.send(.selectCounter(counter.id))","                    }","            }","            .navigationTitle(\"Counters\")","            .toolbar {","                Button(\"Add Counter\", systemImage: \"plus\") {","                    store.send(.counter(.add))","                }","            }","            .overlay {","                if store.counters.isEmpty {","                    ContentUnavailableView(","                        \"No Counters\",","                        systemImage: \"number.square\",","                        description: Text(\"Tap + to add a counter.\")","                    )","                }","            }","            .onAppear { store.undoManager = undoManager }","            .onChange(of: undoManager) { _, new in store.undoManager = new }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The row takes a ","type":"text"},{"type":"codeVoice","code":"counterID"},{"text":" rather than the full ","type":"text"},{"type":"codeVoice","code":"Counter"},{"text":". That lets SwiftUI skip re-evaluation of unchanged rows when the parent’s body runs. The ","type":"text"},{"type":"codeVoice","code":"TextField"},{"text":" is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"controlled"}]},{"type":"text","text":": the binding goes straight through the store. There’s no local "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" — the store is the single source of truth."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Views\/CounterRow.swift","import SwiftUI","","struct CounterRow: View {","    @Environment(AppStore.self) private var store","    let counterID: UUID","","    var body: some View {","        if let counter = store.counters[counterID] {","            HStack {","                TextField(","                    \"Name\",","                    text: Binding(","                        get: { counter.name },","                        set: { store.send(.counter(.setName(counterID, $0))) }","                    )","                )","                .textFieldStyle(.plain)","                .frame(maxWidth: .infinity, alignment: .leading)","","                Spacer()","","                Text(\"\\(counter.count)\")","                    .font(.title2.monospacedDigit())","                    .frame(minWidth: 40)","","                Button {","                    store.send(.counter(.decrement(counterID)))","                } label: {","                    Image(systemName: \"minus.circle\")","                }","","                Button {","                    store.send(.counter(.increment(counterID)))","                } label: {","                    Image(systemName: \"plus.circle\")","                }","","                Button {","                    store.send(.counter(.incrementAsync(counterID)))","                } label: {","                    Image(systemName: \"clock.arrow.circlepath\")","                }","                .help(\"Increment after 1 second delay\")","            }","            .buttonStyle(.borderless)","        }","    }","}"]},{"text":"A shorter binding helper","anchor":"A-shorter-binding-helper","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"TextField"},{"type":"text","text":" above reads "},{"type":"codeVoice","code":"counter.name"},{"type":"text","text":" after an optional unwrap and dispatches "},{"type":"codeVoice","code":"setName(counterID, ...)"},{"type":"text","text":". That’s a "},{"type":"emphasis","inlineContent":[{"text":"transformed read","type":"text"}]},{"type":"text","text":" — the keypath doesn’t fit cleanly — so the explicit "},{"type":"codeVoice","code":"Binding(get:set:)"},{"type":"text","text":" is the right tool."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the read is a plain keypath into the store, prefer "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/binding(_:sending:)","type":"reference","isActive":true},{"type":"text","text":". The Counter example demonstrates this with a toolbar slider that tunes the delay used by "},{"type":"codeVoice","code":"incrementAsync"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ In ContentView's toolbar","Slider(","    value: store.binding(\\.ui.asyncDelay) { .setAsyncDelay($0) },","    in: 0.1...3.0,","    step: 0.1",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The keypath is resolved against the generated observer tree, so SwiftUI registers a fine-grained dependency on "},{"type":"codeVoice","code":"ui.asyncDelay"},{"type":"text","text":" only — mutations to other slices don’t invalidate this view. The trailing closure keeps the action constructor visible at the call site."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This closes the unidirectional loop in one tour: slider → "},{"type":"codeVoice","code":"setAsyncDelay"},{"type":"text","text":" action → reducer mutates "},{"type":"codeVoice","code":"state.ui.asyncDelay"},{"type":"text","text":" → next tap on the async button reads the new value when constructing its "},{"type":"codeVoice","code":"Effect"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two cases that still want raw "},{"type":"codeVoice","code":"Binding(get:set:)"},{"type":"text","text":":"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Transformed reads:"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"counter?.name ?? \"\""},{"type":"text","text":", "},{"type":"codeVoice","code":"!store.analytics.isOptedOut"},{"type":"text","text":", EntityStore subscript lookups."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Setter side effects:"}]},{"type":"text","text":" wrapping the dispatch in "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":", branching, or guard logic."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Step 9: Wire the app entry","anchor":"Step-9-Wire-the-app-entry","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Own the store with "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" so it survives "},{"type":"codeVoice","code":"Scene"},{"type":"text","text":" body re-evaluations. Inject it via "},{"type":"codeVoice","code":".environment()"},{"type":"text","text":". On macOS, replace the standard undo command group so cmd-Z talks to "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/undo()","type":"reference","isActive":true},{"type":"text","text":" instead of the system undo manager."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ CounterApp.swift","import SwiftUI","","@main","struct CounterApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        #if os(macOS)","        .commands {","            CommandGroup(replacing: .undoRedo) {","                Button(\"Undo\") { store.undo() }","                    .keyboardShortcut(\"z\", modifiers: .command)","                    .disabled(!store.canUndo)","                Button(\"Redo\") { store.redo() }","                    .keyboardShortcut(\"z\", modifiers: [.command, .shift])","                    .disabled(!store.canRedo)","            }","        }","        #endif","    }","}"]},{"text":"Run it","anchor":"Run-it","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Build and run. You should see an empty list with “No Counters” placeholder text. Click "},{"type":"codeVoice","code":"+"},{"type":"text","text":" in the toolbar — a row appears. Click "},{"type":"codeVoice","code":"+"},{"type":"text","text":" again — a second row. Click on a row — its background tints with the accent color. Click "},{"type":"codeVoice","code":"+"},{"type":"text","text":" (per-row) to increment the count, "},{"type":"codeVoice","code":"-"},{"text":" to decrement, the clock icon to increment after one second. Edit the name field — the rename persists immediately (and the persistence plugin logs each upsert to the console).","type":"text"}]},{"inlineContent":[{"text":"On macOS, hit cmd-Z to undo. Each add, remove, increment, decrement, and rename should reverse one step at a time. Renames coalesce — a single undo restores the whole previous name, not one keystroke. Hit shift-cmd-Z to redo.","type":"text"}],"type":"paragraph"},{"text":"What just happened","level":2,"anchor":"What-just-happened","type":"heading"},{"inlineContent":[{"text":"Four parts wired together. ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Views"}]},{"type":"text","text":" render from "},{"type":"codeVoice","code":"store.counters"},{"type":"text","text":" and "},{"type":"codeVoice","code":"store.ui"},{"type":"text","text":" and dispatch actions through "},{"type":"codeVoice","code":"store.send(...)"},{"type":"text","text":". "},{"type":"strong","inlineContent":[{"text":"Actions","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"CounterAction"},{"type":"text","text":") describe what happened. The "},{"type":"strong","inlineContent":[{"text":"reducer","type":"text"}]},{"text":" translates actions into state mutations, optionally returning an ","type":"text"},{"type":"strong","inlineContent":[{"text":"effect","type":"text"}]},{"type":"text","text":" for async work. The "},{"type":"strong","inlineContent":[{"text":"store","type":"text"}]},{"text":" runs the dispatch loop: it packs the observer tree into a struct snapshot, hands it to your reducer, then unpacks the result back onto the observer — firing per-property observation only for fields that actually changed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The async increment shows the round trip. A button click dispatches ","type":"text"},{"code":".counter(.incrementAsync(id))","type":"codeVoice"},{"type":"text","text":". The reducer returns an effect that sleeps off the MainActor, then calls "},{"type":"codeVoice","code":"send(.counter(.increment(id)))"},{"type":"text","text":". That second dispatch goes through the same loop, hits the synchronous "},{"code":".increment","type":"codeVoice"},{"text":" case, and updates the counter — which fires observation and re-renders just that row’s count label.","type":"text"}],"type":"paragraph"},{"text":"Next steps","anchor":"Next-steps","level":2,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","isActive":true},{"type":"text","text":" — gate features behind a subscription."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","isActive":true},{"text":" — force-update unsupported app versions.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","isActive":true,"type":"reference"},{"text":" — block underage purchases.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","isActive":true,"type":"reference"},{"text":" — full reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","isActive":true,"type":"reference"},{"type":"text","text":" — the snapshot\/observer pattern and its performance characteristics."}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"text":" — write your own plugin.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"title":"Build Your First Swidux App","modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article"},"abstract":[{"type":"text","text":"Build a counter app from scratch and meet the four moving parts of a Swidux project: state, action, reducer, and store."}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingYourFirstApp"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/buildingyourfirstapp"]}],"sections":[],"references":{"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","role":"article","kind":"article","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"title":"Add a Paywall"},"doc://Swidux/documentation/Swidux":{"abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitche