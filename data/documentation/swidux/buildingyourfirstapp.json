<"},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">"}],"title":"binding(_:sending:)","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/binding(_:sending:)","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"State","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"SwiduxObservable","type":"codeVoice"},{"type":"text","text":"."}]}},"doc://Swidux/documentation/Swidux/MacrosReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":")."}],"role":"article","kind":"article","type":"topic","url":"\/documentation\/swidux\/macrosreference","title":"Macros"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"role":"article","kind":"article","type":"topic","url":"\/documentation\/swidux\/pluginarchitecture","title":"Plugin Architecture"},"doc://Swidux/documentation/Swidux/Store":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"type":"text","text":"observation layer."}],"role":"symbol","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text