{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingYourFirstApp","interfaceLanguage":"swift"},"abstract":[{"text":"Build a counter app from scratch and meet the four moving parts of a Swidux project: state, action, reducer, and store.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"text":"By the end of this tutorial you’ll have a working SwiftUI app that manages a list of named counters. You can add and remove counters, increment and decrement, rename via ","type":"text"},{"code":"TextField","type":"codeVoice"},{"text":", kick off an async increment that fires after a one-second delay, and undo or redo any change with the standard menubar shortcuts. The end-state mirrors the app under ","type":"text"},{"code":"Examples\/Counter\/","type":"codeVoice"},{"text":" in the Swidux repo, so you can diff your work against it.","type":"text"}],"type":"paragraph"},{"text":"What you’ll build","anchor":"What-youll-build","level":2,"type":"heading"},{"inlineContent":[{"text":"A small macOS\/iOS app with:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"A list of counters, each with a name and an integer value.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A toolbar ","type":"text"},{"type":"codeVoice","code":"+"},{"text":" button that adds a new counter.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Per-row buttons for increment, decrement, and async-increment.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"TextField"},{"text":" per row that renames the counter.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Tap to select a counter — the row highlights.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Undo and redo (cmd-Z \/ shift-cmd-Z on macOS).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"What you’ll learn","anchor":"What-youll-learn","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Defining state with ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Designing actions as nested enums.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Writing reducers that mutate state via ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Returning effects for async work.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Wiring a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"text":" with plugins for undo and persistence logging.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Reading state from views via ","type":"text"},{"type":"codeVoice","code":"@dynamicMemberLookup"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Step 1: Create the project and add Swidux","anchor":"Step-1-Create-the-project-and-add-Swidux","level":2,"type":"heading"},{"inlineContent":[{"text":"In Xcode, create a new SwiftUI app project. Then add Swidux as a package dependency: ","type":"text"},{"inlineContent":[{"text":"File > Add Package Dependencies","type":"text"}],"type":"strong"},{"text":", paste ","type":"text"},{"code":"https:\/\/github.com\/heirloomlogic\/Swidux","type":"codeVoice"},{"text":", choose ","type":"text"},{"inlineContent":[{"text":"Up to Next Major","type":"text"}],"type":"strong"},{"text":" from ","type":"text"},{"code":"1.0.0","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You’ll re-export Swidux from one file so the rest of the app doesn’t need to import it.","type":"text"}],"type":"paragraph"},{"text":"Step 2: Define the model","anchor":"Step-2-Define-the-model","level":2,"type":"heading"},{"inlineContent":[{"text":"A counter has an ID, a name, and an integer count. Make it ","type":"text"},{"code":"Identifiable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" — ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" requires all three.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Models\/Counter.swift","import Foundation","","nonisolated struct Counter: Identifiable, Equatable, Sendable {","    var id: UUID","    var name: String","    var count: Int","","    init(id: UUID = UUID(), name: String = \"Counter\", count: Int = 0) {","        self.id = id","        self.name = name","        self.count = count","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Step 3: Define the state","anchor":"Step-3-Define-the-state","level":2,"type":"heading"},{"inlineContent":[{"text":"There are two state slices: a collection of counters, and a UI slice that tracks which counter is selected. Both get ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":". The parent uses ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" on the UI slice so the macro wires it as a separate observer instead of an opaque leaf — see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","isActive":true,"type":"reference"},{"text":" for the why.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This file is the one place you import Swidux. Re-export it so no other file has to.","type":"text"}],"type":"paragraph"},{"code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var counters: EntityStore<Counter> = .init()","    @Slice var ui: UIState = .init()","","    init(counters: EntityStore<Counter> = EntityStore(), ui: UIState = UIState()) {","        self.counters = counters","        self.ui = ui","    }","}","","@Swidux","nonisolated struct UIState: Equatable, Sendable {","    var selectedCounterID: UUID? = nil","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" is Swidux’s keyed collection — like an ordered dictionary, with built-in change tracking for persistence and undo.","type":"text"}],"type":"paragraph"},{"text":"Step 4: Define the actions","anchor":"Step-4-Define-the-actions","level":2,"type":"heading"},{"inlineContent":[{"text":"Every user interaction and every effect callback is expressed as a value of ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":". Splitting into nested enums (","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":" -> ","type":"text"},{"code":"CounterAction","type":"codeVoice"},{"text":") keeps each feature’s actions colocated and makes the root reducer’s ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" shallow.","type":"text"}],"type":"paragraph"},{"code":["\/\/ App\/AppAction.swift","import Foundation","","enum AppAction: Sendable {","    case counter(CounterAction)","    case selectCounter(UUID?)","}","","enum CounterAction: Sendable {","    case add","    case remove(UUID)","    case increment(UUID)","    case decrement(UUID)","    case incrementAsync(UUID)","    case setName(UUID, String)","}"],"syntax":"swift","type":"codeListing"},{"text":"Step 5: Specialize the effect typealiases","anchor":"Step-5-Specialize-the-effect-typealiases","level":2,"type":"heading"},{"inlineContent":[{"text":"Swidux’s effect system is generic over your action type. Pin it to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":" once so you don’t repeat the generic parameters everywhere.","type":"text"}],"type":"paragraph"},{"code":["\/\/ App\/Effect.swift","import Foundation","","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"Send","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"@MainActor @Sendable (AppAction) -> Void","type":"codeVoice"},{"text":". ","type":"text"},{"code":"Effect","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"@Sendable","type":"codeVoice"},{"text":" async closure that takes a ","type":"text"},{"code":"Send","type":"codeVoice"},{"text":". Effects are returned from the reducer when an action needs to do async work.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You’ll also want an environment type to hold injected dependencies. The Counter demo has none, so it’s a placeholder:","type":"text"}],"type":"paragraph"},{"code":["\/\/ App\/AppEnvironment.swift","import Foundation","","struct AppEnvironment: Sendable {","    static func live() -> AppEnvironment { .init() }","    static func mock() -> AppEnvironment { .init() }","}"],"syntax":"swift","type":"codeListing"},{"content":[{"inlineContent":[{"text":"This demo builds its store from a ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" context, so the default argument ","type":"text"},{"code":"= .live()","type":"codeVoice"},{"text":" is evaluated on the main actor and a plain ","type":"text"},{"code":"struct AppEnvironment: Sendable","type":"codeVoice"},{"text":" works. If your app constructs the store from a ","type":"text"},{"inlineContent":[{"text":"nonisolated","type":"text"}],"type":"strong"},{"text":" context instead — e.g. a ","type":"text"},{"code":"nonisolated static func configured(...)","type":"codeVoice"},{"text":" factory, or building the environment in a detached task — that default-argument expression is evaluated nonisolated, and ","type":"text"},{"code":".live()","type":"codeVoice"},{"text":" must be callable there. Mark the environment ","type":"text"},{"code":"nonisolated struct AppEnvironment: Sendable","type":"codeVoice"},{"text":" in that case (which makes ","type":"text"},{"code":"live()","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"mock()","type":"codeVoice"},{"text":" nonisolated too).","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"text":"Step 6: Write the reducer","anchor":"Step-6-Write-the-reducer","level":2,"type":"heading"},{"inlineContent":[{"text":"The reducer is a pure function from ","type":"text"},{"code":"(state, action, environment)","type":"codeVoice"},{"text":" to an optional ","type":"text"},{"code":"Effect","type":"codeVoice"},{"text":". State mutates via ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":". Any case that doesn’t need async work returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Start with the per-feature reducer. The interesting case is ","type":"text"},{"code":"incrementAsync","type":"codeVoice"},{"text":": it returns an effect that sleeps for a second, then dispatches a synchronous ","type":"text"},{"code":"increment","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["\/\/ Features\/CounterReducer.swift","import Foundation","","struct CounterReducer: SwiduxReducer {","    func reduce(","        state: inout AppState,","        action: CounterAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .add:","            let counter = Counter(name: \"Counter \\(state.counters.count + 1)\")","            state.counters[counter.id] = counter","","        case .remove(let id):","            state.counters[id] = nil","","        case .increment(let id):","            state.counters.modify(id) { $0.count += 1 }","","        case .decrement(let id):","            state.counters.modify(id) { $0.count = max(0, $0.count - 1) }","","        case .incrementAsync(let id):","            return { send in","                try? await Task.sleep(for: .seconds(1))","                await send(.counter(.increment(id)))","            }","","        case .setName(let id, let name):","            state.counters.modify(id) { $0.name = name }","        }","","        return nil","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Then the root reducer, which routes ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":" cases to feature reducers and handles top-level cases inline.","type":"text"}],"type":"paragraph"},{"code":["\/\/ App\/AppReducer.swift","import Foundation","","struct AppReducer: SwiduxReducer {","    let counter = CounterReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .counter(let action):","            return counter.reduce(state: &state, action: action, environment: environment)","","        case .selectCounter(let id):","            state.ui.selectedCounterID = id","        }","","        return nil","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Step 7: Wire the store","anchor":"Step-7-Wire-the-store","level":2,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","isActive":true,"type":"reference"},{"text":" owns the dispatch loop, plugin lifecycle, and observer tree. Build it from a factory method so views and previews get the same wiring. Register two plugins:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":" records snapshots before each undoable action. The ","type":"text"},{"type":"codeVoice","code":"isUndoable"},{"text":" predicate decides which actions count; ","type":"text"},{"type":"codeVoice","code":"coalescing"},{"text":" collapses runs of the same action (so typing into the rename field doesn’t create one undo entry per keystroke).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"text":" is registered with a ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"text":" over ","type":"text"},{"type":"codeVoice","code":"\\.counters"},{"text":". The Counter demo just logs the writes — in a real app you’d persist to a database.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["\/\/ App\/AppStore.swift","import SwiftUI","import os","","typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        let reducer = AppReducer()","        let logger = Logger(","            subsystem: Bundle.main.bundleIdentifier ?? \"counter\",","            category: \"persistence\"","        )","","        let isUndoable: @Sendable (AppAction) -> Bool = { action in","            switch action {","            case .counter(.add), .counter(.remove),","                 .counter(.increment), .counter(.decrement),","                 .counter(.setName):","                true","            case .counter(.incrementAsync), .selectCounter:","                false","            }","        }","","        let undoPlugin = UndoPlugin<AppState, AppAction>(","            isUndoable: isUndoable,","            coalescing: { action in","                if case .counter(.setName) = action { return true }","                return false","            }","        )","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.counters) { writes, deletes in","                    for counter in writes {","                        logger.info(\"Persist upsert: \\(counter.name) = \\(counter.count)\")","                    }","                    for id in deletes {","                        logger.info(\"Persist delete: \\(id)\")","                    }","                }","            ],","            logger: logger","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"Step 8: Build the views","anchor":"Step-8-Build-the-views","level":2,"type":"heading"},{"inlineContent":[{"text":"Views read from the store via ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" and dispatch actions with ","type":"text"},{"code":"store.send(...)","type":"codeVoice"},{"text":". They never import Swidux directly (the re-export from ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"text":" handles that).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The list view binds to ","type":"text"},{"code":"store.counters.values","type":"codeVoice"},{"text":" — ","type":"text"},{"code":"@dynamicMemberLookup","type":"codeVoice"},{"text":" forwards through to the generated observer class, so SwiftUI observation picks up changes per slice.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Views\/ContentView.swift","import SwiftUI","","struct ContentView: View {","    @Environment(AppStore.self) private var store","    @Environment(\\.undoManager) private var undoManager","","    var body: some View {","        NavigationStack {","            List(store.counters.values) { counter in","                CounterRow(counterID: counter.id)","                    .listRowBackground(","                        store.ui.selectedCounterID == counter.id","                            ? Color.accentColor.opacity(0.15)","                            : Color.clear","                    )","                    .contentShape(Rectangle())","                    .onTapGesture {","                        store.send(.selectCounter(counter.id))","                    }","            }","            .navigationTitle(\"Counters\")","            .toolbar {","                Button(\"Add Counter\", systemImage: \"plus\") {","                    store.send(.counter(.add))","                }","            }","            .overlay {","                if store.counters.isEmpty {","                    ContentUnavailableView(","                        \"No Counters\",","                        systemImage: \"number.square\",","                        description: Text(\"Tap + to add a counter.\")","                    )","                }","            }","            .onAppear { store.undoManager = undoManager }","            .onChange(of: undoManager) { _, new in store.undoManager = new }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The row takes a ","type":"text"},{"code":"counterID","type":"codeVoice"},{"text":" rather than the full ","type":"text"},{"code":"Counter","type":"codeVoice"},{"text":". That lets SwiftUI skip re-evaluation of unchanged rows when the parent’s body runs. The ","type":"text"},{"code":"TextField","type":"codeVoice"},{"text":" is ","type":"text"},{"inlineContent":[{"text":"controlled","type":"text"}],"type":"strong"},{"text":": the binding goes straight through the store. There’s no local ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" — the store is the single source of truth.","type":"text"}],"type":"paragraph"},{"code":["\/\/ Views\/CounterRow.swift","import SwiftUI","","struct CounterRow: View {","    @Environment(AppStore.self) private var store","    let counterID: UUID","","    var body: some View {","        if let counter = store.counters[counterID] {","            HStack {","                TextField(","                    \"Name\",","                    text: Binding(","                        get: { counter.name },","                        set: { store.send(.counter(.setName(counterID, $0))) }","                    )","                )","                .textFieldStyle(.plain)","                .frame(maxWidth: .infinity, alignment: .leading)","","                Spacer()","","                Text(\"\\(counter.count)\")","                    .font(.title2.monospacedDigit())","                    .frame(minWidth: 40)","","                Button {","                    store.send(.counter(.decrement(counterID)))","                } label: {","                    Image(systemName: \"minus.circle\")","                }","","                Button {","                    store.send(.counter(.increment(counterID)))","                } label: {","                    Image(systemName: \"plus.circle\")","                }","","                Button {","                    store.send(.counter(.incrementAsync(counterID)))","                } label: {","                    Image(systemName: \"clock.arrow.circlepath\")","                }","                .help(\"Increment after 1 second delay\")","            }","            .buttonStyle(.borderless)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"A shorter binding helper","anchor":"A-shorter-binding-helper","level":3,"type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"TextField","type":"codeVoice"},{"text":" above reads ","type":"text"},{"code":"counter.name","type":"codeVoice"},{"text":" after an optional unwrap and dispatches ","type":"text"},{"code":"setName(counterID, ...)","type":"codeVoice"},{"text":". That’s a ","type":"text"},{"inlineContent":[{"text":"transformed read","type":"text"}],"type":"emphasis"},{"text":" — the keypath doesn’t fit cleanly — so the explicit ","type":"text"},{"code":"Binding(get:set:)","type":"codeVoice"},{"text":" is the right tool.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When the read is a plain keypath into the store, prefer ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/binding(_:sending:)","isActive":true,"type":"reference"},{"text":". The Counter example demonstrates this with a toolbar slider that tunes the delay used by ","type":"text"},{"code":"incrementAsync","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["\/\/ In ContentView's toolbar","Slider(","    value: store.binding(\\.ui.asyncDelay) { .setAsyncDelay($0) },","    in: 0.1...3.0,","    step: 0.1",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The keypath is resolved against the generated observer tree, so SwiftUI registers a fine-grained dependency on ","type":"text"},{"code":"ui.asyncDelay","type":"codeVoice"},{"text":" only — mutations to other slices don’t invalidate this view. The trailing closure keeps the action constructor visible at the call site.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This closes the unidirectional loop in one tour: slider → ","type":"text"},{"code":"setAsyncDelay","type":"codeVoice"},{"text":" action → reducer mutates ","type":"text"},{"code":"state.ui.asyncDelay","type":"codeVoice"},{"text":" → next tap on the async button reads the new value when constructing its ","type":"text"},{"code":"Effect","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Two cases that still want raw ","type":"text"},{"type":"codeVoice","code":"Binding(get:set:)"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Transformed reads:"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"counter?.name ?? \"\""},{"type":"text","text":", "},{"type":"codeVoice","code":"!store.analytics.isOptedOut"},{"text":", EntityStore subscript lookups.","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Setter side effects:"}],"type":"strong"},{"text":" wrapping the dispatch in ","type":"text"},{"code":"withAnimation","type":"codeVoice"},{"text":", branching, or guard logic.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Step 9: Wire the app entry","type":"heading","anchor":"Step-9-Wire-the-app-entry"},{"inlineContent":[{"type":"text","text":"Own the store with "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" so it survives "},{"type":"codeVoice","code":"Scene"},{"type":"text","text":" body re-evaluations. Inject it via "},{"code":".environment()","type":"codeVoice"},{"text":". On macOS, replace the standard undo command group so cmd-Z talks to ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/undo()","isActive":true,"type":"reference"},{"type":"text","text":" instead of the system undo manager."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ CounterApp.swift","import SwiftUI","","@main","struct CounterApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        #if os(macOS)","        .commands {","            CommandGroup(replacing: .undoRedo) {","                Button(\"Undo\") { store.undo() }","                    .keyboardShortcut(\"z\", modifiers: .command)","                    .disabled(!store.canUndo)","                Button(\"Redo\") { store.redo() }","                    .keyboardShortcut(\"z\", modifiers: [.command, .shift])","                    .disabled(!store.canRedo)","            }","        }","        #endif","    }","}"],"type":"codeListing"},{"anchor":"Run-it","level":2,"text":"Run it","type":"heading"},{"inlineContent":[{"text":"Build and run. You should see an empty list with “No Counters” placeholder text. Click ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" in the toolbar — a row appears. Click ","type":"text"},{"type":"codeVoice","code":"+"},{"type":"text","text":" again — a second row. Click on a row — its background tints with the accent color. Click "},{"type":"codeVoice","code":"+"},{"type":"text","text":" (per-row) to increment the count, "},{"type":"codeVoice","code":"-"},{"type":"text","text":" to decrement, the clock icon to increment after one second. Edit the name field — the rename persists immediately (and the persistence plugin logs each upsert to the console)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On macOS, hit cmd-Z to undo. Each add, remove, increment, decrement, and rename should reverse one step at a time. Renames coalesce — a single undo restores the whole previous name, not one keystroke. Hit shift-cmd-Z to redo."}],"type":"paragraph"},{"anchor":"What-just-happened","level":2,"text":"What just happened","type":"heading"},{"inlineContent":[{"type":"text","text":"Four parts wired together. "},{"inlineContent":[{"text":"Views","type":"text"}],"type":"strong"},{"type":"text","text":" render from "},{"type":"codeVoice","code":"store.counters"},{"type":"text","text":" and "},{"type":"codeVoice","code":"store.ui"},{"type":"text","text":" and dispatch actions through "},{"type":"codeVoice","code":"store.send(...)"},{"type":"text","text":". "},{"inlineContent":[{"text":"Actions","type":"text"}],"type":"strong"},{"type":"text","text":" ("},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"code":"CounterAction","type":"codeVoice"},{"text":") describe what happened. The ","type":"text"},{"inlineContent":[{"text":"reducer","type":"text"}],"type":"strong"},{"text":" translates actions into state mutations, optionally returning an ","type":"text"},{"inlineContent":[{"text":"effect","type":"text"}],"type":"strong"},{"text":" for async work. The ","type":"text"},{"inlineContent":[{"type":"text","text":"store"}],"type":"strong"},{"text":" runs the dispatch loop: it packs the observer tree into a struct snapshot, hands it to your reducer, then unpacks the result back onto the observer — firing per-property observation only for fields that actually changed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The async increment shows the round trip. A button click dispatches ","type":"text"},{"code":".counter(.incrementAsync(id))","type":"codeVoice"},{"text":". The reducer returns an effect that sleeps off the MainActor, then calls ","type":"text"},{"code":"send(.counter(.increment(id)))","type":"codeVoice"},{"text":". That second dispatch goes through the same loop, hits the synchronous ","type":"text"},{"code":".increment","type":"codeVoice"},{"text":" case, and updates the counter — which fires observation and re-renders just that row’s count label.","type":"text"}],"type":"paragraph"},{"anchor":"Next-steps","text":"Next steps","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"type":"text","text":" — gate features behind a subscription."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch"},{"type":"text","text":" — force-update unsupported app versions."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},{"type":"text","text":" — block underage purchases."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"},{"type":"text","text":" — full reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide"},{"type":"text","text":" — the snapshot\/observer pattern and its performance characteristics."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":" — write your own plugin."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swidux\/buildingyourfirstapp"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"title":"Build Your First Swidux App","role":"article"},"references":{"doc://Swidux/documentation/Swidux/MacrosReference":{"abstract":[{"text":"Reference for ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" — the two macros that generate the observation bridge between value-type state and SwiftUI.","type":"text"}],"title":"Macros","kind":"article","url":"\/documentation\/swidux\/macrosreference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"url":"\/documentation\/swidux\/howtoaddaparentalgate","identifier":"doc:\/\/Swidux\/documentatio