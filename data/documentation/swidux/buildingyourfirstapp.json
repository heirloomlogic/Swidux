{"sections":[],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingYourFirstApp","interfaceLanguage":"swift"},"abstract":[{"text":"Build a counter app from scratch and meet the four moving parts of a Swidux project: state, action, reducer, and store.","type":"text"}],"kind":"article","metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"Build Your First Swidux App"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"By the end of this tutorial you’ll have a working SwiftUI app that manages a list of named counters. You can add and remove counters, increment and decrement, rename via "},{"type":"codeVoice","code":"TextField"},{"type":"text","text":", kick off an async increment that fires after a one-second delay, and undo or redo any change with the standard menubar shortcuts. The end-state mirrors the app under "},{"type":"codeVoice","code":"Examples\/Counter\/"},{"type":"text","text":" in the Swidux repo, so you can diff your work against it."}],"type":"paragraph"},{"level":2,"text":"What you’ll build","anchor":"What-youll-build","type":"heading"},{"inlineContent":[{"type":"text","text":"A small macOS\/iOS app with:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"A list of counters, each with a name and an integer value.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A toolbar ","type":"text"},{"code":"+","type":"codeVoice"},{"text":" button that adds a new counter.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Per-row buttons for increment, decrement, and async-increment.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"TextField"},{"text":" per row that renames the counter.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Tap to select a counter — the row highlights."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Undo and redo (cmd-Z \/ shift-cmd-Z on macOS)."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"What-youll-learn","text":"What you’ll learn","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Defining state with ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Designing actions as nested enums.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Writing reducers that mutate state via "},{"type":"codeVoice","code":"inout"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Returning effects for async work."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Wiring a ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference","isActive":true},{"text":" with plugins for undo and persistence logging.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Reading state from views via ","type":"text"},{"code":"@dynamicMemberLookup","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Step-1-Create-the-project-and-add-Swidux","text":"Step 1: Create the project and add Swidux","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"In Xcode, create a new SwiftUI app project. Then add Swidux as a package dependency: ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"File > Add Package Dependencies"}]},{"text":", paste ","type":"text"},{"type":"codeVoice","code":"https:\/\/github.com\/heirloomlogic\/Swidux"},{"text":", choose ","type":"text"},{"type":"strong","inlineContent":[{"text":"Up to Next Major","type":"text"}]},{"text":" from ","type":"text"},{"type":"codeVoice","code":"1.0.0"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"You’ll re-export Swidux from one file so the rest of the app doesn’t need to import it."}]},{"level":2,"anchor":"Step-2-Define-the-model","text":"Step 2: Define the model","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A counter has an ID, a name, and an integer count. Make it "},{"code":"Identifiable","type":"codeVoice"},{"type":"text","text":", "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":", and "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":" — "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":" requires all three."}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Models\/Counter.swift","import Foundation","","nonisolated struct Counter: Identifiable, Equatable, Sendable {","    var id: UUID","    var name: String","    var count: Int","","    init(id: UUID = UUID(), name: String = \"Counter\", count: Int = 0) {","        self.id = id","        self.name = name","        self.count = count","    }","}"]},{"level":2,"anchor":"Step-3-Define-the-state","text":"Step 3: Define the state","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"There are two state slices: a collection of counters, and a UI slice that tracks which counter is selected. Both get ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":". The parent uses ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" on the UI slice so the macro wires it as a separate observer instead of an opaque leaf — see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","type":"reference","isActive":true},{"text":" for the why.","type":"text"}]},{"inlineContent":[{"type":"text","text":"This file is the one place you import Swidux. Re-export it so no other file has to."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var counters: EntityStore<Counter> = .init()","    @Slice var ui: UIState = .init()","","    init(counters: EntityStore<Counter> = EntityStore(), ui: UIState = UIState()) {","        self.counters = counters","        self.ui = ui","    }","}","","@Swidux","nonisolated struct UIState: Equatable, Sendable {","    var selectedCounterID: UUID? = nil","}"]},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true,"type":"reference"},{"text":" is Swidux’s keyed collection — like an ordered dictionary, with built-in change tracking for persistence and undo.","type":"text"}],"type":"paragraph"},{"anchor":"Step-4-Define-the-actions","level":2,"type":"heading","text":"Step 4: Define the actions"},{"inlineContent":[{"type":"text","text":"Every user interaction and every effect callback is expressed as a value of "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":". Splitting into nested enums ("},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":" -> "},{"type":"codeVoice","code":"CounterAction"},{"type":"text","text":") keeps each feature’s actions colocated and makes the root reducer’s "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" shallow."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppAction.swift","import Foundation","","enum AppAction: Sendable {","    case counter(CounterAction)","    case selectCounter(UUID?)","}","","enum CounterAction: Sendable {","    case add","    case remove(UUID)","    case increment(UUID)","    case decrement(UUID)","    case incrementAsync(UUID)","    case setName(UUID, String)","}"]},{"anchor":"Step-5-Specialize-the-effect-typealiases","level":2,"type":"heading","text":"Step 5: Specialize the effect typealiases"},{"inlineContent":[{"text":"Swidux’s effect system is generic over your action type. Pin it to ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":" once so you don’t repeat the generic parameters everywhere.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/Effect.swift","import Foundation","","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"]},{"inlineContent":[{"code":"Send","type":"codeVoice"},{"type":"text","text":" is "},{"code":"@MainActor @Sendable (AppAction) -> Void","type":"codeVoice"},{"type":"text","text":". "},{"code":"Effect","type":"codeVoice"},{"type":"text","text":" is a "},{"code":"@Sendable","type":"codeVoice"},{"type":"text","text":" async closure that takes a "},{"code":"Send","type":"codeVoice"},{"type":"text","text":". Effects are returned from the reducer when an action needs to do async work."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"You’ll also want an environment type to hold injected dependencies. The Counter demo has none, so it’s a placeholder:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/AppEnvironment.swift","import Foundation","","struct AppEnvironment: Sendable {","    static func live() -> AppEnvironment { .init() }","    static func mock() -> AppEnvironment { .init() }","}"],"type":"codeListing"},{"level":2,"anchor":"Step-6-Write-the-reducer","type":"heading","text":"Step 6: Write the reducer"},{"inlineContent":[{"type":"text","text":"The reducer is a pure function from "},{"type":"codeVoice","code":"(state, action, environment)"},{"type":"text","text":" to an optional "},{"type":"codeVoice","code":"Effect"},{"type":"text","text":". State mutates via "},{"type":"codeVoice","code":"inout"},{"type":"text","text":". Any case that doesn’t need async work returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Start with the per-feature reducer. The interesting case is "},{"type":"codeVoice","code":"incrementAsync"},{"type":"text","text":": it returns an effect that sleeps for a second, then dispatches a synchronous "},{"type":"codeVoice","code":"increment"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Features\/CounterReducer.swift","import Foundation","","struct CounterReducer: SwiduxReducer {","    func reduce(","        state: inout AppState,","        action: CounterAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .add:","            let counter = Counter(name: \"Counter \\(state.counters.count + 1)\")","            state.counters[counter.id] = counter","","        case .remove(let id):","            state.counters[id] = nil","","        case .increment(let id):","            state.counters.modify(id) { $0.count += 1 }","","        case .decrement(let id):","            state.counters.modify(id) { $0.count = max(0, $0.count - 1) }","","        case .incrementAsync(let id):","            return { send in","                try? await Task.sleep(for: .seconds(1))","                await send(.counter(.increment(id)))","            }","","        case .setName(let id, let name):","            state.counters.modify(id) { $0.name = name }","        }","","        return nil","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Then the root reducer, which routes "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":" cases to feature reducers and handles top-level cases inline."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ App\/AppReducer.swift","import Foundation","","struct AppReducer: SwiduxReducer {","    let counter = CounterReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .counter(let action):","            return counter.reduce(state: &state, action: action, environment: environment)","","        case .selectCounter(let id):","            state.ui.selectedCounterID = id","        }","","        return nil","    }","}"],"type":"codeListing"},{"level":2,"anchor":"Step-7-Wire-the-store","type":"heading","text":"Step 7: Wire the store"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"text":" owns the dispatch loop, plugin lifecycle, and observer tree. Build it from a factory method so views and previews get the same wiring. Register two plugins:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":" records snapshots before each undoable action. The ","type":"text"},{"code":"isUndoable","type":"codeVoice"},{"text":" predicate decides which actions count; ","type":"text"},{"code":"coalescing","type":"codeVoice"},{"text":" collapses runs of the same action (so typing into the rename field doesn’t create one undo entry per keystroke).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"type":"text","text":" is registered with a "},{"code":"StateWriter","type":"codeVoice"},{"type":"text","text":" over "},{"code":"\\.counters","type":"codeVoice"},{"type":"text","text":". The Counter demo just logs the writes — in a real app you’d persist to a database."}]}]}],"type":"unorderedList"},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppStore.swift","import SwiftUI","import os","","typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        let reducer = AppReducer()","        let logger = Logger(","            subsystem: Bundle.main.bundleIdentifier ?? \"counter\",","            category: \"persistence\"","        )","","        let isUndoable: @Sendable (AppAction) -> Bool = { action in","            switch action {","            case .counter(.add), .counter(.remove),","                 .counter(.increment), .counter(.decrement),","                 .counter(.setName):","                true","            case .counter(.incrementAsync), .selectCounter:","                false","            }","        }","","        let undoPlugin = UndoPlugin<AppState, AppAction>(","            isUndoable: isUndoable,","            coalescing: { action in","                if case .counter(.setName) = action { return true }","                return false","            }","        )","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.counters) { writes, deletes in","                    for counter in writes {","                        logger.info(\"Persist upsert: \\(counter.name) = \\(counter.count)\")","                    }","                    for id in deletes {","                        logger.info(\"Persist delete: \\(id)\")","                    }","                }","            ],","            logger: logger","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"]},{"level":2,"type":"heading","anchor":"Step-8-Build-the-views","text":"Step 8: Build the views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views read from the store via "},{"type":"codeVoice","code":"@Environment"},{"type":"text","text":" and dispatch actions with "},{"type":"codeVoice","code":"store.send(...)"},{"type":"text","text":". They never import Swidux directly (the re-export from "},{"type":"codeVoice","code":"AppState.swift"},{"type":"text","text":" handles that)."}]},{"type":"paragraph","inlineContent":[{"text":"The list view binds to ","type":"text"},{"code":"store.counters.values","type":"codeVoice"},{"text":" — ","type":"text"},{"code":"@dynamicMemberLookup","type":"codeVoice"},{"text":" forwards through to the generated observer class, so SwiftUI observation picks up changes per slice.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Views\/ContentView.swift","import SwiftUI","","struct ContentView: View {","    @Environment(AppStore.self) private var store","    @Environment(\\.undoManager) private var undoManager","","    var body: some View {","        NavigationStack {","            List(store.counters.values) { counter in","                CounterRow(counterID: counter.id)","                    .listRowBackground(","                        store.ui.selectedCounterID == counter.id","                            ? Color.accentColor.opacity(0.15)","                            : Color.clear","                    )","                    .contentShape(Rectangle())","                    .onTapGesture {","                        store.send(.selectCounter(counter.id))","                    }","            }","            .navigationTitle(\"Counters\")","            .toolbar {","                Button(\"Add Counter\", systemImage: \"plus\") {","                    store.send(.counter(.add))","                }","            }","            .overlay {","                if store.counters.isEmpty {","                    ContentUnavailableView(","                        \"No Counters\",","                        systemImage: \"number.square\",","                        description: Text(\"Tap + to add a counter.\")","                    )","                }","            }","            .onAppear { store.undoManager = undoManager }","            .onChange(of: undoManager) { _, new in store.undoManager = new }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The row takes a ","type":"text"},{"type":"codeVoice","code":"counterID"},{"text":" rather than the full ","type":"text"},{"type":"codeVoice","code":"Counter"},{"type":"text","text":". That lets SwiftUI skip re-evaluation of unchanged rows when the parent’s body runs. The "},{"type":"codeVoice","code":"TextField"},{"type":"text","text":" is "},{"type":"strong","inlineContent":[{"text":"controlled","type":"text"}]},{"text":": the binding goes straight through the store. There’s no local ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" — the store is the single source of truth.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Views\/CounterRow.swift","import SwiftUI","","struct CounterRow: View {","    @Environment(AppStore.self) private var store","    let counterID: UUID","","    var body: some View {","        if let counter = store.counters[counterID] {","            HStack {","                TextField(","                    \"Name\",","                    text: Binding(","                        get: { counter.name },","                        set: { store.send(.counter(.setName(counterID, $0))) }","                    )","                )","                .textFieldStyle(.plain)","                .frame(maxWidth: .infinity, alignment: .leading)","","                Spacer()","","                Text(\"\\(counter.count)\")","                    .font(.title2.monospacedDigit())","                    .frame(minWidth: 40)","","                Button {","                    store.send(.counter(.decrement(counterID)))","                } label: {","                    Image(systemName: \"minus.circle\")","                }","","                Button {","                    store.send(.counter(.increment(counterID)))","                } label: {","                    Image(systemName: \"plus.circle\")","                }","","                Button {","                    store.send(.counter(.incrementAsync(counterID)))","                } label: {","                    Image(systemName: \"clock.arrow.circlepath\")","                }","                .help(\"Increment after 1 second delay\")","            }","            .buttonStyle(.borderless)","        }","    }","}"]},{"text":"Step 9: Wire the app entry","type":"heading","level":2,"anchor":"Step-9-Wire-the-app-entry"},{"type":"paragraph","inlineContent":[{"text":"Own the store with ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" so it survives ","type":"text"},{"code":"Scene","type":"codeVoice"},{"text":" body re-evaluations. Inject it via ","type":"text"},{"code":".environment()","type":"codeVoice"},{"text":". On macOS, replace the standard undo command group so cmd-Z talks to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/undo()","type":"reference"},{"text":" instead of the system undo manager.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ CounterApp.swift","import SwiftUI","","@main","struct CounterApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        #if os(macOS)","        .commands {","            CommandGroup(replacing: .undoRedo) {","                Button(\"Undo\") { store.undo() }","                    .keyboardShortcut(\"z\", modifiers: .command)","                    .disabled(!store.canUndo)","                Button(\"Redo\") { store.redo() }","                    .keyboardShortcut(\"z\", modifiers: [.command, .shift])","                    .disabled(!store.canRedo)","            }","        }","        #endif","    }","}"]},{"text":"Run it","type":"heading","level":2,"anchor":"Run-it"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Build and run. You should see an empty list with “No Counters” placeholder text. Click "},{"type":"codeVoice","code":"+"},{"type":"text","text":" in the toolbar — a row appears. Click "},{"type":"codeVoice","code":"+"},{"type":"text","text":" again — a second row. Click on a row — its background tints with the accent color. Click "},{"type":"codeVoice","code":"+"},{"type":"text","text":" (per-row) to increment the count, "},{"type":"codeVoice","code":"-"},{"type":"text","text":" to decrement, the clock icon to increment after one second. Edit the name field — the rename persists immediately (and the persistence plugin logs each upsert to the console)."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On macOS, hit cmd-Z to undo. Each add, remove, increment, decrement, and rename should reverse one step at a time. Renames coalesce — a single undo restores the whole previous name, not one keystroke. Hit shift-cmd-Z to redo."}]},{"text":"What just happened","type":"heading","level":2,"anchor":"What-just-happened"},{"type":"paragraph","inlineContent":[{"text":"Four parts wired together. ","type":"text"},{"inlineContent":[{"type":"text","text":"Views"}],"type":"strong"},{"text":" render from ","type":"text"},{"type":"codeVoice","code":"store.counters"},{"type":"text","text":" and "},{"type":"codeVoice","code":"store.ui"},{"type":"text","text":" and dispatch actions through "},{"type":"codeVoice","code":"store.send(...)"},{"type":"text","text":". "},{"type":"strong","inlineContent":[{"text":"Actions","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"CounterAction"},{"type":"text","text":") describe what happened. The "},{"type":"strong","inlineContent":[{"type":"text","text":"reducer"}]},{"type":"text","text":" translates actions into state mutations, optionally returning an "},{"type":"strong","inlineContent":[{"text":"effect","type":"text"}]},{"type":"text","text":" for async work. The "},{"type":"strong","inlineContent":[{"text":"store","type":"text"}]},{"type":"text","text":" runs the dispatch loop: it packs the observer tree into a struct snapshot, hands it to your reducer, then unpacks the result back onto the observer — firing per-property observation only for fields that actually changed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The async increment shows the round trip. A button click dispatches "},{"type":"codeVoice","code":".counter(.incrementAsync(id))"},{"type":"text","text":". The reducer returns an effect that sleeps off the MainActor, then calls "},{"type":"codeVoice","code":"send(.counter(.increment(id)))"},{"type":"text","text":". That second dispatch goes through the same loop, hits the synchronous "},{"type":"codeVoice","code":".increment"},{"type":"text","text":" case, and updates the counter — which fires observation and re-renders just that row’s count label."}]},{"anchor":"Next-steps","type":"heading","level":2,"text":"Next steps"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"type":"text","text":" — gate features behind a subscription."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch"},{"text":" — force-update unsupported app versions.","type":"text"}]}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},{"type":"text","text":" — block underage purchases."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"},{"text":" — full reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","isActive":true},{"type":"text","text":" — the snapshot\/observer pattern and its performance characteristics."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":" — write your own plugin.","type":"text"}]}]}],"type":"unorderedList"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/buildingyourfirstapp"]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"role":"article","kind":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","title":"Add a Parental Gate","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","type":"topic"},"doc://Swidux/documentation/Swidux/Store/undo()":{"url":"\/documentation\/swidux\/store\/undo()","role":"symbol","kind":"symbol","title":"undo()","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/undo()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"undo","kind":"identifier"},{"kind":"text","text":"()"}],"type":"topic","abstract":[{"text":"Restores the previous state from the undo stack.","type":"text"}]},"doc://Swidux/documentati