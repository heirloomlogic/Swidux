between value-type state and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":")."}],"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","type":"topic"},"doc://Swidux/documentation/Swidux/Store/binding(_:sending:)":{"url":"\/documentation\/swidux\/store\/binding(_:sending:)","title":"binding(_:sending:)","abstract":[{"type":"text","text":"Creates a SwiftUI "},{"type":"codeVoice","code":"Binding"},{"type":"text","text":" that reads a property through the"},{"type":"text","text":" "},{"type":"text","text":"observer tree and dispatches an action when written."}],"kind":"symbol","role":"symbol","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"State"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/binding(_:sending:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"binding"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"Value"},{"kind":"text","text":">("},{"kind":"typeIdentifier","text":"KeyPath","preciseIdentifier":"s:s7KeyPathC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":"."},{"kind":"typeIdentifier","text":"Observer","preciseIdentifier":"s:6Swidux0A10ObservableP8ObserverQa"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"sending"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"Value"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"Action"},