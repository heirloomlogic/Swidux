{"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/swidux\/buildingyourfirstapp"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","sections":[],"abstract":[{"text":"Build a counter app from scratch and meet the four moving parts of a Swidux project: state, action, reducer, and store.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"By the end of this tutorial you’ll have a working SwiftUI app that manages a list of named counters. You can add and remove counters, increment and decrement, rename via ","type":"text"},{"code":"TextField","type":"codeVoice"},{"text":", kick off an async increment that fires after a one-second delay, and undo or redo any change with the standard menubar shortcuts. The end-state mirrors the app under ","type":"text"},{"code":"Examples\/Counter\/","type":"codeVoice"},{"text":" in the Swidux repo, so you can diff your work against it.","type":"text"}]},{"text":"What you’ll build","type":"heading","level":2,"anchor":"What-youll-build"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A small macOS\/iOS app with:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A list of counters, each with a name and an integer value."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A toolbar "},{"type":"codeVoice","code":"+"},{"type":"text","text":" button that adds a new counter."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Per-row buttons for increment, decrement, and async-increment."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A "},{"code":"TextField","type":"codeVoice"},{"text":" per row that renames the counter.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Tap to select a counter — the row highlights."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Undo and redo (cmd-Z \/ shift-cmd-Z on macOS)."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"What-youll-learn","level":2,"text":"What you’ll learn","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Defining state with "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" and "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Designing actions as nested enums.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Writing reducers that mutate state via "},{"type":"codeVoice","code":"inout"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Returning effects for async work.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Wiring a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"text":" with plugins for undo and persistence logging.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reading state from views via "},{"type":"codeVoice","code":"@dynamicMemberLookup"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Step-1-Create-the-project-and-add-Swidux","type":"heading","text":"Step 1: Create the project and add Swidux","level":2},{"inlineContent":[{"text":"In Xcode, create a new SwiftUI app project. Then add Swidux as a package dependency: ","type":"text"},{"inlineContent":[{"text":"File > Add Package Dependencies","type":"text"}],"type":"strong"},{"text":", paste ","type":"text"},{"code":"https:\/\/github.com\/heirloomlogic\/Swidux","type":"codeVoice"},{"text":", choose ","type":"text"},{"inlineContent":[{"type":"text","text":"Up to Next Major"}],"type":"strong"},{"text":" from ","type":"text"},{"code":"1.0.0","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"You’ll re-export Swidux from one file so the rest of the app doesn’t need to import it.","type":"text"}],"type":"paragraph"},{"anchor":"Step-2-Define-the-model","type":"heading","text":"Step 2: Define the model","level":2},{"inlineContent":[{"text":"A counter has an ID, a name, and an integer count. Make it ","type":"text"},{"code":"Identifiable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"Sendable","type":"codeVoice"},{"text":" — ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" requires all three.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Models\/Counter.swift","import Foundation","","nonisolated struct Counter: Identifiable, Equatable, Sendable {","    var id: UUID","    var name: String","    var count: Int","","    init(id: UUID = UUID(), name: String = \"Counter\", count: Int = 0) {","        self.id = id","        self.name = name","        self.count = count","    }","}"],"syntax":"swift"},{"anchor":"Step-3-Define-the-state","type":"heading","text":"Step 3: Define the state","level":2},{"inlineContent":[{"text":"There are two state slices: a collection of counters, and a UI slice that tracks which counter is selected. Both get ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":". The parent uses "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" on the UI slice so the macro wires it as a separate observer instead of an opaque leaf — see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","type":"reference","isActive":true},{"type":"text","text":" for the why."}],"type":"paragraph"},{"inlineContent":[{"text":"This file is the one place you import Swidux. Re-export it so no other file has to.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppState.swift","import Foundation","@_exported import Swidux","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var counters: EntityStore<Counter> = .init()","    @Slice var ui: UIState = .init()","","    init(counters: EntityStore<Counter> = EntityStore(), ui: UIState = UIState()) {","        self.counters = counters","        self.ui = ui","    }","}","","@Swidux","nonisolated struct UIState: Equatable, Sendable {","    var selectedCounterID: UUID? = nil","}"]},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":" is Swidux’s keyed collection — like an ordered dictionary, with built-in change tracking for persistence and undo.","type":"text"}],"type":"paragraph"},{"text":"Step 4: Define the actions","type":"heading","anchor":"Step-4-Define-the-actions","level":2},{"inlineContent":[{"text":"Every user interaction and every effect callback is expressed as a value of ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":". Splitting into nested enums (","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":" -> ","type":"text"},{"code":"CounterAction","type":"codeVoice"},{"text":") keeps each feature’s actions colocated and makes the root reducer’s ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" shallow.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppAction.swift","import Foundation","","enum AppAction: Sendable {","    case counter(CounterAction)","    case selectCounter(UUID?)","}","","enum CounterAction: Sendable {","    case add","    case remove(UUID)","    case increment(UUID)","    case decrement(UUID)","    case incrementAsync(UUID)","    case setName(UUID, String)","}"]},{"text":"Step 5: Specialize the effect typealiases","type":"heading","anchor":"Step-5-Specialize-the-effect-typealiases","level":2},{"inlineContent":[{"text":"Swidux’s effect system is generic over your action type. Pin it to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":" once so you don’t repeat the generic parameters everywhere.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/Effect.swift","import Foundation","","typealias Send = Swidux.Send<AppAction>","typealias Effect = Swidux.Effect<AppAction>"]},{"inlineContent":[{"type":"codeVoice","code":"Send"},{"type":"text","text":" is "},{"type":"codeVoice","code":"@MainActor @Sendable (AppAction) -> Void"},{"type":"text","text":". "},{"type":"codeVoice","code":"Effect"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"@Sendable"},{"type":"text","text":" async closure that takes a "},{"code":"Send","type":"codeVoice"},{"type":"text","text":". Effects are returned from the reducer when an action needs to do async work."}],"type":"paragraph"},{"inlineContent":[{"text":"You’ll also want an environment type to hold injected dependencies. The Counter demo has none, so it’s a placeholder:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ App\/AppEnvironment.swift","import Foundation","","struct AppEnvironment: Sendable {","    static func live() -> AppEnvironment { .init() }","    static func mock() -> AppEnvironment { .init() }","}"]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This demo builds its store from a "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" context, so the default argument "},{"code":"= .live()","type":"codeVoice"},{"type":"text","text":" is evaluated on the main actor and a plain "},{"code":"struct AppEnvironment: Sendable","type":"codeVoice"},{"type":"text","text":" works. If your app constructs the store from a "},{"inlineContent":[{"type":"text","text":"nonisolated"}],"type":"strong"},{"type":"text","text":" context instead — e.g. a "},{"code":"nonisolated static func configured(...)","type":"codeVoice"},{"type":"text","text":" factory, or building the environment in a detached task — that default-argument expression is evaluated nonisolated, and "},{"code":".live()","type":"codeVoice"},{"type":"text","text":" must be callable there. Mark the environment "},{"code":"nonisolated struct AppEnvironment: Sendable","type":"codeVoice"},{"type":"text","text":" in that case (which makes "},{"code":"live()","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"mock()","type":"codeVoice"},{"type":"text","text":" nonisolated too)."}]}]},{"type":"heading","anchor":"Step-6-Write-the-reducer","level":2,"text":"Step 6: Write the reducer"},{"inlineContent":[{"type":"text","text":"The reducer is a pure function from "},{"type":"codeVoice","code":"(state, action, environment)"},{"type":"text","text":" to an optional "},{"type":"codeVoice","code":"Effect"},{"type":"text","text":". State mutates via "},{"type":"codeVoice","code":"inout"},{"type":"text","text":". Any case that doesn’t need async work returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Start with the per-feature reducer. The interesting case is "},{"code":"incrementAsync","type":"codeVoice"},{"type":"text","text":": it returns an effect that sleeps for a second, then dispatches a synchronous "},{"code":"increment","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Features\/CounterReducer.swift","import Foundation","","struct CounterReducer: SwiduxReducer {","    func reduce(","        state: inout AppState,","        action: CounterAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .add:","            let counter = Counter(name: \"Counter \\(state.counters.count + 1)\")","            state.counters[counter.id] = counter","","        case .remove(let id):","            state.counters[id] = nil","","        case .increment(let id):","            state.counters.modify(id) { $0.count += 1 }","","        case .decrement(let id):","            state.counters.modify(id) { $0.count = max(0, $0.count - 1) }","","        case .incrementAsync(let id):","            return { send in","                try? await Task.sleep(for: .seconds(1))","                await send(.counter(.increment(id)))","            }","","        case .setName(let id, let name):","            state.counters.modify(id) { $0.name = name }","        }","","        return nil","    }","}"]},{"inlineContent":[{"type":"text","text":"Then the root reducer, which routes "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":" cases to feature reducers and handles top-level cases inline."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ App\/AppReducer.swift","import Foundation","","struct AppReducer: SwiduxReducer {","    let counter = CounterReducer()","","    func reduce(","        state: inout AppState,","        action: AppAction,","        environment: AppEnvironment","    ) -> Effect? {","        switch action {","        case .counter(let action):","            return counter.reduce(state: &state, action: action, environment: environment)","","        case .selectCounter(let id):","            state.ui.selectedCounterID = id","        }","","        return nil","    }","}"]},{"text":"Step 7: Wire the store","anchor":"Step-7-Wire-the-store","type":"heading","level":2},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","isActive":true,"type":"reference"},{"text":" owns the dispatch loop, plugin lifecycle, and observer tree. Build it from a factory method so views and previews get the same wiring. Register two plugins:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":" records snapshots before each undoable action. The ","type":"text"},{"code":"isUndoable","type":"codeVoice"},{"text":" predicate decides which actions count; ","type":"text"},{"code":"coalescing","type":"codeVoice"},{"text":" collapses runs of the same action (so typing into the rename field doesn’t create one undo entry per keystroke).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"type":"text","text":" is registered with a "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" over "},{"type":"codeVoice","code":"\\.counters"},{"type":"text","text":". The Counter demo just logs the writes — in a real app you’d persist to a database."}]}]}]},{"syntax":"swift","code":["\/\/ App\/AppStore.swift","import SwiftUI","import os","","typealias AppStore = Store<AppState, AppAction>","","extension Store where State == AppState, Action == AppAction {","    static func configured(environment: AppEnvironment = .live()) -> AppStore {","        let reducer = AppReducer()","        let logger = Logger(","            subsystem: Bundle.main.bundleIdentifier ?? \"counter\",","            category: \"persistence\"","        )","","        let isUndoable: @Sendable (AppAction) -> Bool = { action in","            switch action {","            case .counter(.add), .counter(.remove),","                 .counter(.increment), .counter(.decrement),","                 .counter(.setName):","                true","            case .counter(.incrementAsync), .selectCounter:","                false","            }","        }","","        let undoPlugin = UndoPlugin<AppState, AppAction>(","            isUndoable: isUndoable,","            coalescing: { action in","                if case .counter(.setName) = action { return true }","                return false","            }","        )","","        let persistencePlugin = PersistencePlugin<AppState, AppAction>(","            writers: [","                StateWriter(keyPath: \\.counters) { writes, deletes in","                    for counter in writes {","                        logger.info(\"Persist upsert: \\(counter.name) = \\(counter.count)\")","                    }","                    for id in deletes {","                        logger.info(\"Persist delete: \\(id)\")","                    }","                }","            ],","            logger: logger","        )","","        let plugins = PluginHost<AppState, AppAction>()","        plugins.register(undoPlugin)","        plugins.register(persistencePlugin)","","        return Store(","            initialState: AppState(),","            reducer: { state, action in","                reducer.reduce(state: &state, action: action, environment: environment)","            },","            plugins: plugins,","            undoPlugin: undoPlugin,","            persistencePlugin: persistencePlugin,","            isUndoable: isUndoable","        )","    }","}"],"type":"codeListing"},{"anchor":"Step-8-Build-the-views","level":2,"type":"heading","text":"Step 8: Build the views"},{"inlineContent":[{"text":"Views read from the store via ","type":"text"},{"code":"@Environment","type":"codeVoice"},{"text":" and dispatch actions with ","type":"text"},{"code":"store.send(...)","type":"codeVoice"},{"text":". They never import Swidux directly (the re-export from ","type":"text"},{"code":"AppState.swift","type":"codeVoice"},{"text":" handles that).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The list view binds to ","type":"text"},{"code":"store.counters.values","type":"codeVoice"},{"text":" — ","type":"text"},{"code":"@dynamicMemberLookup","type":"codeVoice"},{"text":" forwards through to the generated observer class, so SwiftUI observation picks up changes per slice.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Views\/ContentView.swift","import SwiftUI","","struct ContentView: View {","    @Environment(AppStore.self) private var store","    @Environment(\\.undoManager) private var undoManager","","    var body: some View {","        NavigationStack {","            List(store.counters.values) { counter in","                CounterRow(counterID: counter.id)","                    .listRowBackground(","                        store.ui.selectedCounterID == counter.id","                            ? Color.accentColor.opacity(0.15)","                            : Color.clear","                    )","                    .contentShape(Rectangle())","                    .onTapGesture {","                        store.send(.selectCounter(counter.id))","                    }","            }","            .navigationTitle(\"Counters\")","            .toolbar {","                Button(\"Add Counter\", systemImage: \"plus\") {","                    store.send(.counter(.add))","                }","            }","            .overlay {","                if store.counters.isEmpty {","                    ContentUnavailableView(","                        \"No Counters\",","                        systemImage: \"number.square\",","                        description: Text(\"Tap + to add a counter.\")","                    )","                }","            }","            .onAppear { store.undoManager = undoManager }","            .onChange(of: undoManager) { _, new in store.undoManager = new }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The row takes a "},{"type":"codeVoice","code":"counterID"},{"type":"text","text":" rather than the full "},{"type":"codeVoice","code":"Counter"},{"type":"text","text":". That lets SwiftUI skip re-evaluation of unchanged rows when the parent’s body runs. The "},{"type":"codeVoice","code":"TextField"},{"type":"text","text":" is "},{"inlineContent":[{"type":"text","text":"controlled"}],"type":"strong"},{"text":": the binding goes straight through the store. There’s no local ","type":"text"},{"type":"codeVoice","code":"@State"},{"type":"text","text":" — the store is the single source of truth."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Views\/CounterRow.swift","import SwiftUI","","struct CounterRow: View {","    @Environment(AppStore.self) private var store","    let counterID: UUID","","    var body: some View {","        if let counter = store.counters[counterID] {","            HStack {","                TextField(","                    \"Name\",","                    text: Binding(","                        get: { counter.name },","                        set: { store.send(.counter(.setName(counterID, $0))) }","                    )","                )","                .textFieldStyle(.plain)","                .frame(maxWidth: .infinity, alignment: .leading)","","                Spacer()","","                Text(\"\\(counter.count)\")","                    .font(.title2.monospacedDigit())","                    .frame(minWidth: 40)","","                Button {","                    store.send(.counter(.decrement(counterID)))","                } label: {","                    Image(systemName: \"minus.circle\")","                }","","                Button {","                    store.send(.counter(.increment(counterID)))","                } label: {","                    Image(systemName: \"plus.circle\")","                }","","                Button {","                    store.send(.counter(.incrementAsync(counterID)))","                } label: {","                    Image(systemName: \"clock.arrow.circlepath\")","                }","                .help(\"Increment after 1 second delay\")","            }","            .buttonStyle(.borderless)","        }","    }","}"]},{"type":"heading","text":"A shorter binding helper","level":3,"anchor":"A-shorter-binding-helper"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"TextField"},{"type":"text","text":" above reads "},{"type":"codeVoice","code":"counter.name"},{"type":"text","text":" after an optional unwrap and dispatches "},{"type":"codeVoice","code":"setName(counterID, ...)"},{"type":"text","text":". That’s a "},{"type":"emphasis","inlineContent":[{"type":"text","text":"transformed read"}]},{"type":"text","text":" — the keypath doesn’t fit cleanly — so the explicit "},{"type":"codeVoice","code":"Binding(get:set:)"},{"type":"text","text":" is the right tool."}]},{"type":"paragraph","inlineContent":[{"text":"When the read is a plain keypath into the store, prefer ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/binding(_:sending:)","isActive":true,"type":"reference"},{"text":". The Counter example demonstrates this with a toolbar slider that tunes the delay used by ","type":"text"},{"code":"incrementAsync","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ In ContentView's toolbar","Slider(","    value: store.binding(\\.ui.asyncDelay) { .setAsyncDelay($0) },","    in: 0.1...3.0,","    step: 0.1",")"]},{"type":"paragraph","inlineContent":[{"text":"The keypath is resolved against the generated observer tree, so SwiftUI registers a fine-grained dependency on ","type":"text"},{"code":"ui.asyncDelay","type":"codeVoice"},{"text":" only — mutations to other slices don’t invalidate this view. The trailing closure keeps the action constructor visible at the call site.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This closes the unidirectional loop in one tour: slider → "},{"code":"setAsyncDelay","type":"codeVoice"},{"text":" action → reducer mutates ","type":"text"},{"code":"state.ui.asyncDelay","type":"codeVoice"},{"text":" → next tap on the async button reads the new value when constructing its ","type":"text"},{"code":"Effect","type":"codeVoice"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"Two cases that still want raw ","type":"text"},{"code":"Binding(get:set:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Transformed reads:"}]},{"text":" ","type":"text"},{"type":"codeVoice","code":"counter?.name ?? \"\""},{"text":", ","type":"text"},{"code":"!store.analytics.isOptedOut","type":"codeVoice"},{"text":", EntityStore subscript lookups.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Setter side effects:","type":"text"}]},{"type":"text","text":" wrapping the dispatch in "},{"type":"codeVoice","code":"withAnimation"},{"type":"text","text":", branching, or guard logic."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Step 9: Wire the app entry","type":"heading","anchor":"Step-9-Wire-the-app-entry","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Own the store with "},{"code":"@State","type":"codeVoice"},{"text":" so it survives ","type":"text"},{"code":"Scene","type":"codeVoice"},{"text":" body re-evaluations. Inject it via ","type":"text"},{"code":".environment()","type":"codeVoice"},{"text":". On macOS, replace the standard undo command group so cmd-Z talks to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/undo()","type":"reference"},{"text":" instead of the system undo manager.","type":"text"}]},{"type":"codeListing","code":["\/\/ CounterApp.swift","import SwiftUI","","@main","struct CounterApp: App {","    @State private var store = AppStore.configured()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(store)","        }","        #if os(macOS)","        .commands {","            CommandGroup(replacing: .undoRedo) {","                Button(\"Undo\") { store.undo() }","                    .keyboardShortcut(\"z\", modifiers: .command)","                    .disabled(!store.canUndo)","                Button(\"Redo\") { store.redo() }","                    .keyboardShortcut(\"z\", modifiers: [.command, .shift])","                    .disabled(!store.canRedo)","            }","        }","        #endif","    }","}"],"syntax":"swift"},{"anchor":"Run-it","type":"heading","level":2,"text":"Run it"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Build and run. You should see an empty list with “No Counters” placeholder text. Click "},{"type":"codeVoice","code":"+"},{"type":"text","text":" in the toolbar — a row appears. Click "},{"type":"codeVoice","code":"+"},{"type":"text","text":" again — a second row. Click on a row — its background tints with the accent color. Click "},{"type":"codeVoice","code":"+"},{"type":"text","text":" (per-row) to increment the count, "},{"type":"codeVoice","code":"-"},{"type":"text","text":" to decrement, the clock icon to increment after one second. Edit the name field — the rename persists immediately (and the persistence plugin logs each upsert to the console)."}]},{"type":"paragraph","inlineContent":[{"text":"On macOS, hit cmd-Z to undo. Each add, remove, increment, decrement, and rename should reverse one step at a time. Renames coalesce — a single undo restores the whole previous name, not one keystroke. Hit shift-cmd-Z to redo.","type":"text"}]},{"level":2,"type":"heading","text":"What just happened","anchor":"What-just-happened"},{"type":"paragraph","inlineContent":[{"text":"Four parts wired together. ","type":"text"},{"inlineContent":[{"text":"Views","type":"text"}],"type":"strong"},{"text":" render from ","type":"text"},{"code":"store.counters","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"store.ui","type":"codeVoice"},{"text":" and dispatch actions through ","type":"text"},{"type":"codeVoice","code":"store.send(...)"},{"type":"text","text":". "},{"type":"strong","inlineContent":[{"type":"text","text":"Actions"}]},{"type":"text","text":" ("},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", "},{"code":"CounterAction","type":"codeVoice"},{"type":"text","text":") describe what happened. The "},{"inlineContent":[{"type":"text","text":"reducer"}],"type":"strong"},{"type":"text","text":" translates actions into state mutations, optionally returning an "},{"inlineContent":[{"type":"text","text":"effect"}],"type":"strong"},{"type":"text","text":" for async work. The "},{"inlineContent":[{"type":"text","text":"store"}],"type":"strong"},{"type":"text","text":" runs the dispatch loop: it packs the observer tree into a struct snapshot, hands it to your reducer, then unpacks the result back onto the observer — firing per-property observation only for fields that actually changed."}]},{"inlineContent":[{"type":"text","text":"The async increment shows the round trip. A button click dispatches "},{"code":".counter(.incrementAsync(id))","type":"codeVoice"},{"type":"text","text":". The reducer returns an effect that sleeps off the MainActor, then calls "},{"code":"send(.counter(.increment(id)))","type":"codeVoice"},{"type":"text","text":". That second dispatch goes through the same loop, hits the synchronous "},{"code":".increment","type":"codeVoice"},{"type":"text","text":" case, and updates the counter — which fires observation and re-renders just that row’s count label."}],"type":"paragraph"},{"text":"Next steps","level":2,"type":"heading","anchor":"Next-steps"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","isActive":true},{"text":" — gate features behind a subscription.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch"},{"type":"text","text":" — force-update unsupported app versions."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","type":"reference","isActive":true},{"text":" — block underage purchases.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","isActive":true},{"type":"text","text":" — full reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","isActive":true},{"type":"text","text":" — the snapshot\/observer pattern and its performance characteristics."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":" — write your own plugin."}]}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"roleHeading":"Article","title":"Build Your First Swidux App","role":"article","modules":[{"name":"Swidux"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingYourFirstApp"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"references":{"doc://Swidux/documentation/Swidux/ArchitectureGuide":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","title":"Architecture & Performance","abstract":[{"text":"Understand the architectural patterns that make Swidux work correctly with SwiftUI’s observation system.","type":"text"}],"url":"\/documentation\/swidux\/architectureguide","role":"article","type":"topic"},"doc://Swidux/documentation/Swidux/EntityStore":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"topic","title":"EntityStore","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"EntityStore","kind":"identif