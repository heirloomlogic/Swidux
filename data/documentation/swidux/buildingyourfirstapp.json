ode":"Binding"},{"type":"text","text":" that reads a property through the"},{"type":"text","text":" "},{"type":"text","text":"observer tree and dispatches an action when written."}]},"doc://Swidux/documentation/Swidux/PersistencePlugin":{"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","title":"PersistencePlugin","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistencePlugin"}],"abstract":[{"type":"text","text":"Coalescing persistence plugin."}],"url":"\/documentation\/swidux\/persistenceplugin","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PersistencePlugin"}],"type":"topic"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","type":"topic","title":"Plugin Architecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","kind":"article","url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}]},"doc://Swidux/documentation/Swidux/Store":{"title":"Store","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"navigatorTitle":[{"text":"Store","kind":"identifier"}],"url":"\/documentation\/swidux\/store","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"text":"observation layer.","type":"text"}],"role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","kind":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","title":"Add a Parental Gate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"role":"article","identifie