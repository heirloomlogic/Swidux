logic\/SwiduxRevenueCatPaywall","url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},"doc://Swidux/documentation/Swidux":{"title":"Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"kind":"article","role":"article","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"title":"Add Feature Flags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"title":"SwiduxPaywall Reference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"url":"\/documentation\/swidux\/pluginpaywallreference","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"title":"Add iCloud Sync","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddicloudsync","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"title":"Plugin Architecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","kind":"article","url":"\/documentation\/swidux\/pluginarchitecture","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"kind":"article","role":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"title":"Add a Version Killswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","type":"topic"},"doc://Swidux/documentation/Swidux/SecurityPosture":{"title":"Security Posture","abstract":[{"text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","kind":"article","url":"\/documentation\/swidux\/securityposture","type":"topic","role":"collectionGroup"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"title":"Add Persistence","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":" classes, database actors, or ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","kind":"article","url":"\/documentation\/swidux\/howtoaddpersistence","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/AgentSkill":{"title":"Using the Swidux Agent Skill","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","abstract":[{"text":"Install the bundled ","type":"text"},{"code":"swidux-ref","type":"codeVoice"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"url":"\/documentation\/swidux\/agentskill","kind":"article","role":"article"}}}