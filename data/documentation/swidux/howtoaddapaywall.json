{"sections":[],"kind":"article","metadata":{"modules":[{"name":"Swidux"}],"role":"article","title":"Add a Paywall","roleHeading":"Article"},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":", presenting the sheet, gating a feature, and previewing in pro state.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},{"type":"text","text":". For where domain plugins fit in the dispatch cycle, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}]},{"type":"heading","anchor":"Before-you-start","level":2,"text":"Before you start"},{"inlineContent":[{"type":"text","text":"This guide assumes:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"You have a Swidux app already wired up — ","type":"text"},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference","isActive":true},{"type":"text","text":" first."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Step-1-Add-the-dependency","level":2,"text":"Step 1: Add the dependency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"],"syntax":"swift"},{"text":"Step 2: Add state and actions","type":"heading","level":2,"anchor":"Step-2-Add-state-and-actions"},{"type":"paragraph","inlineContent":[{"text":"Add a paywall slice to ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":", and a paywall case to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":":"}]},{"code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"],"syntax":"swift","type":"codeListing"},{"syntax":"swift","type":"codeListing","code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"]},{"name":"Tip","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxPaywall"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.paywall.*"},{"type":"text","text":" or "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":" — including views that read the slice for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}]}],"type":"aside"},{"inlineContent":[{"text":"The plugin owns reducing for ","type":"text"},{"type":"codeVoice","code":".paywall"},{"text":" actions, so the root reducer should fall through:","type":"text"}],"type":"paragraph"},{"code":["\/\/ AppReducer.swift","case .paywall:","    return nil"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Step 3: Provide a `PaywallService`","anchor":"Step-3-Provide-a-PaywallService","type":"heading"},{"inlineContent":[{"text":"The plugin needs a ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" conformer that talks to your purchase backend. Pick the path that matches your backend.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Path A: RevenueCat (recommended)","anchor":"Path-A-RevenueCat-recommended","type":"heading"},{"inlineContent":[{"text":"Add the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},{"text":" companion package and use the supplied ","type":"text"},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"text":". No bridging code on your side.","type":"text"}],"type":"paragraph"},{"code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"],"syntax":"swift","type":"codeListing"},{"code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The companion package also ships ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":", a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin. See its ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/"},{"text":" for configuration (API key, entitlement identifiers).","type":"text"}],"type":"paragraph"},{"level":3,"text":"Path B: StoreKit or custom backend","anchor":"Path-B-StoreKit-or-custom-backend","type":"heading"},{"inlineContent":[{"text":"For any non-RevenueCat backend, implement ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" directly. The protocol is small:","type":"text"}],"type":"paragraph"},{"code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"A vanilla StoreKit conformer iterates ","type":"text"},{"type":"codeVoice","code":"Transaction.currentEntitlements"},{"text":" and listens to ","type":"text"},{"type":"codeVoice","code":"Transaction.updates"},{"text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Previews and tests","anchor":"Previews-and-tests","type":"heading"},{"inlineContent":[{"text":"Use the built-in ","type":"text"},{"type":"codeVoice","code":"MockPaywallService"},{"text":" for backend-agnostic previews:","type":"text"}],"type":"paragraph"},{"code":["let service = MockPaywallService(isPro: true)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"If you’re on Path A, ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"text":" also ships ","type":"text"},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"text":" for RevenueCat-flavored previews.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Step 4: Wire the plugin","anchor":"Step-4-Wire-the-plugin","type":"heading"},{"inlineContent":[{"text":"Construct and register ","type":"text"},{"type":"codeVoice","code":"PaywallPlugin"},{"text":" inside your ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory:","type":"text"}],"type":"paragraph"},{"code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService()",")","plugins.register(paywallPlugin)"],"syntax":"swift","type":"codeListing"},{"name":"Tip","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In production, wrap the service in "},{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" so a"},{"type":"text","text":" "},{"type":"text","text":"transient entitlement-read failure at cold launch never gates a paid user as"},{"type":"text","text":" "},{"type":"text","text":"free. Back its cache with "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" (not "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":", whose"},{"type":"text","text":" "},{"type":"text","text":"plist a user can edit to spoof entitlements):"}]},{"type":"codeListing","code":["service: ResilientPaywallService(","    base: RevenueCatPaywallService(),","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" reference ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},{"type":"text","text":") for the"},{"type":"text","text":" "},{"type":"text","text":"staleness policy and threat model."}]}],"type":"aside"},{"type":"heading","anchor":"Step-5-Observe-customer-info-on-launch","level":2,"text":"Step 5: Observe customer info on launch"},{"inlineContent":[{"text":"Start the long-lived entitlement stream once, on the root view:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"observeCustomerInfo"},{"type":"text","text":" returns an effect that lives for the duration of "},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"text":". Every snapshot the service yields flows through ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" and updates ","type":"text"},{"code":"store.paywall.isPro","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"type":"text","text":"."}]},{"level":2,"text":"Step 6: Present the paywall","anchor":"Step-6-Present-the-paywall","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Bind a sheet to ","type":"text"},{"code":"store.paywall.isPresented","type":"codeVoice"},{"text":" and dispatch ","type":"text"},{"code":".paywall(.dismiss)","type":"codeVoice"},{"text":" when it closes:","type":"text"}]},{"type":"codeListing","code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"],"syntax":"swift"},{"inlineContent":[{"text":"Trigger presentation by dispatching ","type":"text"},{"type":"codeVoice","code":".paywall(.request(reason:))"},{"text":" with a short identifier describing why you’re asking. The reason is stored in ","type":"text"},{"type":"codeVoice","code":"store.paywall.requestedReason"},{"text":" so the sheet can tailor its copy.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["store.send(.paywall(.request(reason: \"export-pdf\")))"]},{"text":"Step 7: Gate a feature","anchor":"Step-7-Gate-a-feature","level":2,"type":"heading"},{"inlineContent":[{"text":"Read ","type":"text"},{"type":"codeVoice","code":"PaywallState.isGateSatisfied"},{"text":" before running gated work. If it’s ","type":"text"},{"type":"codeVoice","code":"false"},{"type":"text","text":", dispatch "},{"type":"codeVoice","code":".request"},{"type":"text","text":" instead:"}],"type":"paragraph"},{"syntax":"swift","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"type":"codeListing"},{"text":"Step 8: Restore purchases","anchor":"Step-8-Restore-purchases","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Add a restore button to your paywall sheet. Reflect "},{"type":"codeVoice","code":"store.paywall.isLoading"},{"type":"text","text":" to disable it while the call is in flight:"}],"type":"paragraph"},{"syntax":"swift","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"On success, the resulting snapshot flows through "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" and updates the gate. On failure, "},{"type":"codeVoice","code":"store.paywall.error"},{"type":"text","text":" is set."}],"type":"paragraph"},{"text":"Step 9: Manage subscriptions","anchor":"Step-9-Manage-subscriptions","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:"}],"type":"paragraph"},{"syntax":"swift","code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" via the plugin’s "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler, which routes to the App Store on iOS and Settings on macOS."}],"type":"paragraph"},{"text":"Testing","anchor":"Testing","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" to drive previews and tests into a known entitlement state:"}]},{"syntax":"swift","code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Plumb the service through a parameter on your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory so previews can override it without touching the live RevenueCat SDK."}],"type":"paragraph"}]}],"abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/swidux\/howtoaddapaywall"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","role":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article","type":"topic","title":"Add Feature Flags"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","role":"article","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"type":"topic","url":"\/documentation\/swidux\/pluginarchitecture","kind":"article","title":"Plugin Architecture"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","role":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","type":"topic","title":"Add a Parental Gate"},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","title":"SwiduxRevenueCatPaywall","type":"link","url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","titleInlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"}]},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","role":"article","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"url":"\/documentation\/swidux\/howtoaddicloudsync","kind":"article","type":"topic","title":"Add iCloud Sync"},"https://heirloomlogic.github.io/SwiduxRevenueCatPaywall/documentation/swiduxrevenuecatpaywall/":{"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","title":"DocC reference","type":"link","url":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","titleInlineContent":[{"type":"text","text":"DocC reference"}]},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","title":"SwiduxPaywall Reference","role":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"url":"\/documentation\/swidux\/pluginpaywallreference"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","role":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"url":"\/documentation\/swidux\/buildingadomainplugin","kind":"article","type":"topic","title":"Building a Domain Plugin"},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","role":"article","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"url":"\/documentation\/swidux\/agentskill","kind":"article","type":"topic","title":"Using the Swidux Agent Skill"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","role":"article","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" macro — no hand-written "},{"code":"@Model","type":"codeVoice"},{"type":"text","text":" classes, database actors, or "},{"code":"StateWriter","type":"codeVoice"},{"type":"text","text":" closures."}],"type":"topic","url":"\/documentation\/swidux\/howtoaddpersistence","k