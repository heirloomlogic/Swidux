uto-identify."}],"title":"Add Analytics","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/AgentSkill":{"abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"title":"Using the Swidux Agent Skill","url":"\/documentation\/swidux\/agentskill","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","type":"topic","kind":"article","role":"article"},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"title":"SwiduxRevenueCatPaywall","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","titleInlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}],"type":"link","url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"}}}