","titleInlineContent":[{"type":"text","text":"DocC reference"}],"title":"DocC reference","type":"link"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"title":"Add Feature Flags","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"url":"\/documentation\/swidux\/howtoaddpersistence","kind":"article","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"title":"Add Persistence","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","type":"topic"},"doc://Swidux/documentation/Swidux/AgentSkill":{"url":"\/documentation\/swidux\/agentskill","kind":"article","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"title":"Using the Swidux Agent Skill","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","type":"topic"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","kind":"symbol","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"title":"Swidux","role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux","type":"topic"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"url":"\/documentation\/swidux\/howtocanceleffects","kind":"article","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"title":"Cancel Effects","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"role":"article","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","kind":"article","title":"Add Analytics","url":"\/documentation\/swidux\/howtoaddanalytics","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","kind":"article","title":"Add a Version Killswitch","type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch"},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"type":"link","titleInlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}],"url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","title":"SwiduxRevenueCatPaywall"},"doc://Swidux/documentation/Swidux/SecurityPosture":{"url":"\/documentation\/swidux\/securityposture","kind":"article","abstract":[{"text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one.","type":"text"}],"title":"Security Posture","role":"collectionGroup","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","type":"topic"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"role":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","kind":"article","title":"Building a Domain Plugin","url":"\/documentation\/swidux\/buildingadomainplugin","type":"topic"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"role":"article","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","kind":"article","title":"SwiduxPaywall Reference","url":"\/documentation\/swidux\/pluginpaywallreference","type":"topic"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","kind":"article","title":"Plugin Architecture","url":"\/documentation\/swidux\/pluginarchitecture","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"kind":"article","url":"\/documentation\/swidux\/howtoaddicloudsync","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"title":"Add iCloud Sync","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"topic"},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","kind":"article","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","type":"topic"}}}