":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","kind":"article","role":"article","title":"Add Persistence"},"doc://Swidux/documentation/Swidux/SecurityPosture":{"abstract":[{"text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one.","type":"text"}],"kind":"article","type":"topic","title":"Security Posture","url":"\/documentation\/swidux\/securityposture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","role":"collectionGroup"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","title":"Add a Parental Gate","role":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}]},"doc://Swidux/documentation/Swidux":{"type":"topic","url":"\/documentation\/swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","role":"collection","title":"Swidux"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"type":"topic","url":"\/documentation\/swidux\/howtoaddicloudsync","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","kind":"article","role":"article","title":"Add iCloud Sync"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","title":"Add Analytics","role":"article","url":"\/documentation\/swidux\/howtoaddanalytics","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}]},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"kind":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","title":"Add a Version Killswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"kind":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"title":"Add Feature Flags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","role":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","title":"Plugin Architecture","role":"article","url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}]},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","title":"Building a Domain Plugin","role":"article","url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"type":"topic","url":"\/documentation\/swidux\/pluginpaywallreference","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","kind":"article","role":"article","title":"SwiduxPaywall Reference"},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"type":"link","title":"SwiduxRevenueCatPaywall","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","titleInlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"}],"url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"abstract":[{"text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code.","type":"text"}],"kind":"article","type":"topic","title":"Cancel Effects","url":"\/documentation\/swidux\/howtocanceleffects","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","role":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","url":"\/documentation\/swidux\/gettingstarted","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","kind":"article","role":"article","title":"Getting Started with Swidux"},"https://heirloomlogic.github.io/SwiduxRevenueCatPaywall/documentation/swiduxrevenuecatpaywall/":{"type":"link","title":"DocC reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","titleInlineContent":[{"text":"DocC reference","type":"text"}],"url":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/"}}}