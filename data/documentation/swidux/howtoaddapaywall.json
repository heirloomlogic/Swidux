{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"kind":"article","seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"title":"How-to Guides","generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides"}],"variants":[{"paths":["\/documentation\/swidux\/howtoaddapaywall"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":", presenting the sheet, gating a feature, and previewing in pro state.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","isActive":true,"type":"reference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Before you start","anchor":"Before-you-start","level":2},{"inlineContent":[{"text":"This guide assumes:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"You have a Swidux app already wired up — ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"text":" first.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" product to your app target in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"]},{"type":"heading","text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a paywall slice to "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":" with "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":", and a paywall case to "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"]},{"type":"codeListing","syntax":"swift","code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"]},{"style":"tip","name":"Tip","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"import SwiduxPaywall"},{"text":" is needed in ","type":"text"},{"inlineContent":[{"text":"every","type":"text"}],"type":"emphasis"},{"text":" file that touches ","type":"text"},{"type":"codeVoice","code":"store.paywall.*"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"PaywallAction"},{"text":" — including views that read the slice for display. ","type":"text"},{"type":"codeVoice","code":"@_exported import Swidux"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"code":".paywall","type":"codeVoice"},{"type":"text","text":" actions, so the root reducer should fall through:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ AppReducer.swift","case .paywall:","    return nil"]},{"type":"heading","text":"Step 3: Provide a `PaywallService`","anchor":"Step-3-Provide-a-PaywallService","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin needs a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that talks to your purchase backend. Pick the path that matches your backend."}]},{"type":"heading","text":"Path A: RevenueCat (recommended)","anchor":"Path-A-RevenueCat-recommended","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","isActive":true},{"type":"text","text":" companion package and use the supplied "},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":". No bridging code on your side."}]},{"type":"codeListing","syntax":"swift","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"]},{"type":"codeListing","syntax":"swift","code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The companion package also ships "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":", a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin. See its "},{"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","isActive":true},{"type":"text","text":" for configuration (API key, entitlement identifiers)."}]},{"type":"heading","text":"Path B: StoreKit or custom backend","anchor":"Path-B-StoreKit-or-custom-backend","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For any non-RevenueCat backend, implement "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" directly. The protocol is small:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vanilla StoreKit conformer iterates "},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"type":"text","text":" and listens to "},{"code":"Transaction.updates","type":"codeVoice"},{"type":"text","text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement."}]},{"type":"heading","text":"Previews and tests","anchor":"Previews-and-tests","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the built-in "},{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" for backend-agnostic previews:"}]},{"type":"codeListing","syntax":"swift","code":["let service = MockPaywallService(isPro: true)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" also ships "},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" for RevenueCat-flavored previews."}]},{"type":"heading","text":"Step 4: Wire the plugin","anchor":"Step-4-Wire-the-plugin","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct and register "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":" inside your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService()",")","plugins.register(paywallPlugin)"]},{"style":"tip","name":"Tip","type":"aside","content":[{"inlineContent":[{"text":"In production, wrap the service in ","type":"text"},{"type":"codeVoice","code":"ResilientPaywallService"},{"text":" so a","type":"text"},{"text":" ","type":"text"},{"text":"transient entitlement-read failure at cold launch never gates a paid user as","type":"text"},{"text":" ","type":"text"},{"text":"free. Back its cache with ","type":"text"},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"text":" (not ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"text":", whose","type":"text"},{"text":" ","type":"text"},{"text":"plist a user can edit to spoof entitlements):","type":"text"}],"type":"paragraph"},{"code":["service: ResilientPaywallService(","    base: RevenueCatPaywallService(),","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"See the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" reference (","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},{"text":") for the","type":"text"},{"text":" ","type":"text"},{"text":"staleness policy and threat model.","type":"text"}],"type":"paragraph"}]},{"type":"heading","text":"Step 5: Observe customer info on launch","anchor":"Step-5-Observe-customer-info-on-launch","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start the long-lived entitlement stream once, on the root view:"}]},{"type":"codeListing","syntax":"swift","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"observeCustomerInfo"},{"text":" returns an effect that lives for the duration of ","type":"text"},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"text":". Every snapshot the service yields flows through ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" and updates ","type":"text"},{"type":"codeVoice","code":"store.paywall.isPro"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":".","type":"text"}]},{"type":"heading","text":"Step 6: Present the paywall","anchor":"Step-6-Present-the-paywall","level":2},{"type":"paragraph","inlineContent":[{"text":"Bind a sheet to ","type":"text"},{"type":"codeVoice","code":"store.paywall.isPresented"},{"text":" and dispatch ","type":"text"},{"type":"codeVoice","code":".paywall(.dismiss)"},{"text":" when it closes:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"]},{"type":"paragraph","inlineContent":[{"text":"Trigger presentation by dispatching ","type":"text"},{"type":"codeVoice","code":".paywall(.request(reason:))"},{"text":" with a short identifier describing why you’re asking. The reason is stored in ","type":"text"},{"type":"codeVoice","code":"store.paywall.requestedReason"},{"text":" so the sheet can tailor its copy.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["store.send(.paywall(.request(reason: \"export-pdf\")))"]},{"type":"heading","text":"Step 7: Gate a feature","anchor":"Step-7-Gate-a-feature","level":2},{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"type":"codeVoice","code":"PaywallState.isGateSatisfied"},{"text":" before running gated work. If it’s ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", dispatch ","type":"text"},{"type":"codeVoice","code":".request"},{"text":" instead:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"]},{"type":"heading","text":"Step 8: Restore purchases","anchor":"Step-8-Restore-purchases","level":2},{"type":"paragraph","inlineContent":[{"text":"Add a restore button to your paywall sheet. Reflect ","type":"text"},{"type":"codeVoice","code":"store.paywall.isLoading"},{"text":" to disable it while the call is in flight:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"]},{"type":"paragraph","inlineContent":[{"text":"On success, the resulting snapshot flows through ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" and updates the gate. On failure, ","type":"text"},{"type":"codeVoice","code":"store.paywall.error"},{"text":" is set.","type":"text"}]},{"type":"heading","text":"Step 9: Manage subscriptions","anchor":"Step-9-Manage-subscriptions","level":2},{"type":"paragraph","inlineContent":[{"text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"]},{"type":"paragraph","inlineContent":[{"text":"This opens ","type":"text"},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"text":" via the plugin’s ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" handler, which routes to the App Store on iOS and Settings on macOS.","type":"text"}]},{"type":"heading","text":"Testing","anchor":"Testing","level":2},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"MockPaywallService"},{"text":" to drive previews and tests into a known entitlement state:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"]},{"type":"paragraph","inlineContent":[{"text":"Plumb the service through a parameter on your ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory so previews can override it without touching the live RevenueCat SDK.","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},"metadata":{"role":"article","title":"Add a Paywall","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://Swidux/documentation/Swidux/GettingStarted":{"url":"\/documentation\/swidux\/gettingstarted","kind":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","title":"Getting Started with Swidux","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"title":"Add Persistence","url":"\/documentation\/swidux\/howtoaddpersistence","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"code":"SwiduxPersistence","ty