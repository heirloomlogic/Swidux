{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddapaywall"]}],"sections":[],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"inlineContent":[{"text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":", presenting the sheet, gating a feature, and previewing in pro state.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","isActive":true,"type":"reference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Before-you-start","type":"heading","text":"Before you start"},{"inlineContent":[{"text":"This guide assumes:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and "},{"code":"AppStore","type":"codeVoice"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true,"type":"reference"},{"type":"text","text":" first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care."}]}]}]},{"level":2,"anchor":"Step-1-Add-the-dependency","type":"heading","text":"Step 1: Add the dependency"},{"inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Step-2-Add-state-and-actions","type":"heading","text":"Step 2: Add state and actions"},{"inlineContent":[{"type":"text","text":"Add a paywall slice to "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" with "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":", and a paywall case to "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"],"syntax":"swift","type":"codeListing"},{"code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"],"syntax":"swift","type":"codeListing"},{"style":"tip","name":"Tip","type":"aside","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxPaywall"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"text":"every","type":"text"}]},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.paywall.*"},{"type":"text","text":" or "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":" — including views that read the slice for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"code":".paywall","type":"codeVoice"},{"type":"text","text":" actions, so the root reducer should fall through:"}],"type":"paragraph"},{"code":["\/\/ AppReducer.swift","case .paywall:","    return nil"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Step-3-Provide-a-PaywallService","text":"Step 3: Provide a `PaywallService`","type":"heading"},{"inlineContent":[{"type":"text","text":"The plugin needs a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that talks to your purchase backend. Pick the path that matches your backend."}],"type":"paragraph"},{"level":3,"anchor":"Path-A-RevenueCat-recommended","type":"heading","text":"Path A: RevenueCat (recommended)"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","isActive":true,"type":"reference"},{"text":" companion package and use the supplied ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":". No bridging code on your side."}]},{"syntax":"swift","type":"codeListing","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"]},{"syntax":"swift","code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The companion package also ships "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":", a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin. See its README for configuration (API key, entitlement identifiers)."}]},{"level":3,"anchor":"Path-B-StoreKit-or-custom-backend","text":"Path B: StoreKit or custom backend","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For any non-RevenueCat backend, implement "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" directly. The protocol is small:"}]},{"syntax":"swift","code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vanilla StoreKit conformer iterates "},{"type":"codeVoice","code":"Transaction.currentEntitlements"},{"type":"text","text":" and listens to "},{"type":"codeVoice","code":"Transaction.updates"},{"type":"text","text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement."}]},{"level":3,"anchor":"Previews-and-tests","text":"Previews and tests","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the built-in "},{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" for backend-agnostic previews:"}]},{"syntax":"swift","code":["let service = MockPaywallService(isPro: true)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"type":"text","text":" also ships "},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" for RevenueCat-flavored previews."}]},{"level":2,"anchor":"Step-4-Wire-the-plugin","text":"Step 4: Wire the plugin","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct and register "},{"type":"codeVoice","code":"PaywallPlugin"},{"type":"text","text":" inside your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory:"}]},{"syntax":"swift","code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService()",")","plugins.register(paywallPlugin)"],"type":"codeListing"},{"level":2,"anchor":"Step-5-Observe-customer-info-on-launch","text":"Step 5: Observe customer info on launch","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start the long-lived entitlement stream once, on the root view:"}]},{"syntax":"swift","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"observeCustomerInfo"},{"type":"text","text":" returns an effect that lives for the duration of "},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"type":"text","text":". Every snapshot the service yields flows through "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" and updates "},{"type":"codeVoice","code":"store.paywall.isPro"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":"."}]},{"level":2,"anchor":"Step-6-Present-the-paywall","text":"Step 6: Present the paywall","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bind a sheet to "},{"type":"codeVoice","code":"store.paywall.isPresented"},{"type":"text","text":" and dispatch "},{"type":"codeVoice","code":".paywall(.dismiss)"},{"type":"text","text":" when it closes:"}]},{"syntax":"swift","code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Trigger presentation by dispatching "},{"type":"codeVoice","code":".paywall(.request(reason:))"},{"type":"text","text":" with a short identifier describing why you’re asking. The reason is stored in "},{"type":"codeVoice","code":"store.paywall.requestedReason"},{"type":"text","text":" so the sheet can tailor its copy."}]},{"syntax":"swift","code":["store.send(.paywall(.request(reason: \"export-pdf\")))"],"type":"codeListing"},{"level":2,"anchor":"Step-7-Gate-a-feature","text":"Step 7: Gate a feature","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"type":"codeVoice","code":"PaywallState.isGateSatisfied"},{"type":"text","text":" before running gated work. If it’s "},{"type":"codeVoice","code":"false"},{"type":"text","text":", dispatch "},{"type":"codeVoice","code":".request"},{"type":"text","text":" instead:"}]},{"syntax":"swift","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"type":"codeListing"},{"level":2,"anchor":"Step-8-Restore-purchases","text":"Step 8: Restore purchases","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a restore button to your paywall sheet. Reflect "},{"type":"codeVoice","code":"store.paywall.isLoading"},{"type":"text","text":" to disable it while the call is in flight:"}]},{"syntax":"swift","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On success, the resulting snapshot flows through "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" and updates the gate. On failure, "},{"type":"codeVoice","code":"store.paywall.error"},{"type":"text","text":" is set."}]},{"level":2,"anchor":"Step-9-Manage-subscriptions","text":"Step 9: Manage subscriptions","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:"}]},{"syntax":"swift","code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" via the plugin’s "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler, which routes to the App Store on iOS and Settings on macOS."}]},{"level":2,"anchor":"Testing","text":"Testing","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" to drive previews and tests into a known entitlement state:"}]},{"syntax":"swift","code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plumb the service through a parameter on your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory so previews can override it without touching the live RevenueCat SDK."}]}],"kind":"content"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"generated":true,"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"title":"Add a Paywall","role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"kind":"article","references":{"doc://Swidux/documentation/Swidux/AgentSkill":{"role":"article","url":"\/documentation\/swidux\/agentskill","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","abstract":[{"text":"Install the bundled ","type":"text"},{"type":"codeVoice","code":"swidux-ref"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"title":"Using the Swidux Agent Skill","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"title":"Add a Version Killswitch","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux":{"type":"topic","title":"Swidux","role":"collection","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","url":"\/documentation\/swidux"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"title":"Add Feature Flags","role":"article","kind":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","title":"Building a Domain Plugin","role":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","url":"\/documentation\/swidux\/buildingadomainplugin","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"role":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"title":"Add a Parental Gate","type":"topic","kind":"article"},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"title":"SwiduxRevenueCatPaywall","type":"link","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","titleInlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}],"url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","title":"Plugin Architecture","role":"article","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"kind":"article","url":"\/documentation\/swidux\/pluginarchitecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"title":"SwiduxPaywall Reference","role":"article","kind":"article","url":"\/documentation\/swidux\/pluginpaywallreference","type":"topic","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"doc://Swidux/documentation/Swidux/GettingStarted":{"title":"Getting Started with Swidux","role":"article","kind":"article","url":"\/documentation\/swidux\/gettingstarted","type":"topic","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"role":"article","url":"\/documentation\/swidux\/howtoaddanalytics","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"title":"Add Analytics","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"role":"article","url":"\/documentation\/swidux\/howtoaddpersistence","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"title":"Add Persistence","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"role":"article","url":"\/documentation\/swidux\/howtoaddicloudsync","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"title":"Add iCloud Sync","type":"topic","kind":"article"}}}