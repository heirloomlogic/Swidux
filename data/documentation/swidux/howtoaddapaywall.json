{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides","title":"How-to Guides","generated":true}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a "},{"code":"PaywallService","type":"codeVoice"},{"text":", presenting the sheet, gating a feature, and previewing in pro state.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"reference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"text":".","type":"text"}]},{"level":2,"text":"Before you start","anchor":"Before-you-start","type":"heading"},{"inlineContent":[{"text":"This guide assumes:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"AppStore"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"text":" first.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care.","type":"text"}]}]}]},{"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency","level":2,"type":"heading"},{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" product to your app target in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}],"type":"paragraph"},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"],"syntax":"swift","type":"codeListing"},{"text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Add a paywall slice to ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":", and a paywall case to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"],"type":"codeListing"},{"code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The plugin owns reducing for ","type":"text"},{"code":".paywall","type":"codeVoice"},{"text":" actions, so the root reducer should fall through:","type":"text"}]},{"code":["\/\/ AppReducer.swift","case .paywall:","    return nil"],"syntax":"swift","type":"codeListing"},{"text":"Step 3: Provide a `PaywallService`","level":2,"type":"heading","anchor":"Step-3-Provide-a-PaywallService"},{"inlineContent":[{"text":"The plugin needs a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that talks to your purchase backend. Pick the path that matches your backend.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Path A: RevenueCat (recommended)","anchor":"Path-A-RevenueCat-recommended","type":"heading"},{"inlineContent":[{"text":"Add the ","type":"text"},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","isActive":true,"type":"reference"},{"text":" companion package and use the supplied ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":". No bridging code on your side.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"],"type":"codeListing"},{"syntax":"swift","code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService()"],"type":"codeListing"},{"inlineContent":[{"text":"The companion package also ships ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":", a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin. See its README for configuration (API key, entitlement identifiers).","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Path-B-StoreKit-or-custom-backend","text":"Path B: StoreKit or custom backend","type":"heading"},{"inlineContent":[{"text":"For any non-RevenueCat backend, implement ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" directly. The protocol is small:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"A vanilla StoreKit conformer iterates ","type":"text"},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"text":" and listens to ","type":"text"},{"code":"Transaction.updates","type":"codeVoice"},{"text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Previews-and-tests","text":"Previews and tests","type":"heading"},{"inlineContent":[{"text":"Use the built-in ","type":"text"},{"code":"MockPaywallService","type":"codeVoice"},{"text":" for backend-agnostic previews:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let service = MockPaywallService(isPro: true)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"type":"text","text":" also ships "},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" for RevenueCat-flavored previews."}],"type":"paragraph"},{"level":2,"anchor":"Step-4-Wire-the-plugin","text":"Step 4: Wire the plugin","type":"heading"},{"inlineContent":[{"text":"Construct and register ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":" inside your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService()",")","plugins.register(paywallPlugin)"],"type":"codeListing"},{"level":2,"anchor":"Step-5-Observe-customer-info-on-launch","text":"Step 5: Observe customer info on launch","type":"heading"},{"inlineContent":[{"text":"Start the long-lived entitlement stream once, on the root view:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"observeCustomerInfo","type":"codeVoice"},{"text":" returns an effect that lives for the duration of ","type":"text"},{"code":"PaywallService.customerInfoStream()","type":"codeVoice"},{"text":". Every snapshot the service yields flows through ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" and updates ","type":"text"},{"code":"store.paywall.isPro","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Step-6-Present-the-paywall","text":"Step 6: Present the paywall","type":"heading"},{"inlineContent":[{"text":"Bind a sheet to ","type":"text"},{"code":"store.paywall.isPresented","type":"codeVoice"},{"text":" and dispatch ","type":"text"},{"code":".paywall(.dismiss)","type":"codeVoice"},{"text":" when it closes:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"],"type":"codeListing"},{"inlineContent":[{"text":"Trigger presentation by dispatching ","type":"text"},{"code":".paywall(.request(reason:))","type":"codeVoice"},{"text":" with a short identifier describing why you’re asking. The reason is stored in ","type":"text"},{"code":"store.paywall.requestedReason","type":"codeVoice"},{"text":" so the sheet can tailor its copy.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["store.send(.paywall(.request(reason: \"export-pdf\")))"],"type":"codeListing"},{"level":2,"anchor":"Step-7-Gate-a-feature","text":"Step 7: Gate a feature","type":"heading"},{"inlineContent":[{"text":"Read ","type":"text"},{"code":"PaywallState.isGateSatisfied","type":"codeVoice"},{"text":" before running gated work. If it’s ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", dispatch ","type":"text"},{"code":".request","type":"codeVoice"},{"text":" instead:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"type":"codeListing"},{"level":2,"anchor":"Step-8-Restore-purchases","text":"Step 8: Restore purchases","type":"heading"},{"inlineContent":[{"type":"text","text":"Add a restore button to your paywall sheet. Reflect "},{"code":"store.paywall.isLoading","type":"codeVoice"},{"type":"text","text":" to disable it while the call is in flight:"}],"type":"paragraph"},{"syntax":"swift","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"On success, the resulting snapshot flows through "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" and updates the gate. On failure, "},{"type":"codeVoice","code":"store.paywall.error"},{"type":"text","text":" is set."}],"type":"paragraph"},{"level":2,"anchor":"Step-9-Manage-subscriptions","text":"Step 9: Manage subscriptions","type":"heading"},{"inlineContent":[{"type":"text","text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:"}],"type":"paragraph"},{"syntax":"swift","code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" via the plugin’s "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler, which routes to the App Store on iOS and Settings on macOS."}],"type":"paragraph"},{"level":2,"anchor":"Testing","text":"Testing","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" to drive previews and tests into a known entitlement state:"}],"type":"paragraph"},{"syntax":"swift","code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Plumb the service through a parameter on your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory so previews can override it without touching the live RevenueCat SDK."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddapaywall"]}],"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article","title":"Add a Paywall"},"references":{"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","title":"SwiduxRevenueCatPaywall","titleInlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"}],"url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"link"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","title":"Plugin Architecture","url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}]},"doc://Swidux/documentation/Swidux":{"kind":"symbol","type":"topic","role":"collection","url":"\/documentation\/swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"type":"topic","url":"\/documentation\/swidux\/howtoaddanalytics","title":"Add Analytics","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"type":"topic","url":"\/documentation\/swidux\/howtoaddfeatureflags","title":"Add Feature Flags","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","url":"\/documentation\/swidux\/howtoaddaparentalgate","title":"Add a Parental Gate","kind":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","title":"Add a Version Killswitch","kind":"article","abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"role":"article","type":"topic"},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","title":"Using the Swidux Agent Skill","kind":"article","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"role":"article","type":"topic"},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}]},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","url":"\/documentation\/swidux\/buildingadomainplugin","title":"Building a Domain Plugin","kind":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","title":"SwiduxPaywall Reference","url":"\/documentation\/swidux\/pluginpaywallreference","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}]}}}