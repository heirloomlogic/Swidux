{"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":", presenting the sheet, gating a feature, and previewing in pro state."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For an API-level reference of every type and action, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","isActive":true},{"type":"text","text":". For where domain plugins fit in the dispatch cycle, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Before-you-start","type":"heading","text":"Before you start","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"You have a Swidux app already wired up — ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference","isActive":true},{"text":" first.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care."}]}]}]},{"text":"Step 1: Add the dependency","type":"heading","anchor":"Step-1-Add-the-dependency","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"]},{"text":"Step 2: Add state and actions","type":"heading","anchor":"Step-2-Add-state-and-actions","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a paywall slice to "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" with "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":", and a paywall case to "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"]},{"content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"import SwiduxPaywall"},{"text":" is needed in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"text":" file that touches ","type":"text"},{"type":"codeVoice","code":"store.paywall.*"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"PaywallAction"},{"text":" — including views that read the slice for display. ","type":"text"},{"type":"codeVoice","code":"@_exported import Swidux"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"text":".","type":"text"}]}],"type":"aside","style":"tip","name":"Tip"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"type":"codeVoice","code":".paywall"},{"type":"text","text":" actions, so the root reducer should fall through:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppReducer.swift","case .paywall:","    return nil"]},{"text":"Step 3: Provide a `PaywallService`","type":"heading","anchor":"Step-3-Provide-a-PaywallService","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin needs a "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that talks to your purchase backend. Pick the path that matches your backend."}]},{"text":"Path A: RevenueCat (recommended)","type":"heading","anchor":"Path-A-RevenueCat-recommended","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},{"type":"text","text":" companion package and use the supplied "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":". No bridging code on your side."}]},{"syntax":"swift","type":"codeListing","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"]},{"syntax":"swift","type":"codeListing","code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService(entitlementID: \"pro\")"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entitlementID"},{"type":"text","text":" is the RevenueCat entitlement identifier that grants pro; pass "},{"type":"codeVoice","code":"permanentLicenseEntitlementID:"},{"type":"text","text":" too if you sell a lifetime unlock. The companion package also ships "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":", a SwiftUI sheet built on RevenueCatUI. The sheet only dispatches presentation actions ("},{"type":"codeVoice","code":".dismiss"},{"type":"text","text":", "},{"type":"codeVoice","code":".dismissCustomerCenter"},{"type":"text","text":"); a completed purchase reaches the plugin through "},{"type":"codeVoice","code":"customerInfoStream()"},{"type":"text","text":", which is why you start "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":" in Step 5. See its "},{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/"},{"type":"text","text":" for configuration (API key, entitlement identifiers)."}]},{"text":"Path B: StoreKit or custom backend","type":"heading","anchor":"Path-B-StoreKit-or-custom-backend","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For any non-RevenueCat backend, implement "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" directly. The protocol is small:"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vanilla StoreKit conformer iterates "},{"type":"codeVoice","code":"Transaction.currentEntitlements"},{"type":"text","text":" and listens to "},{"type":"codeVoice","code":"Transaction.updates"},{"type":"text","text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement."}]},{"text":"Previews and tests","type":"heading","anchor":"Previews-and-tests","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the built-in "},{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" for backend-agnostic previews:"}]},{"syntax":"swift","type":"codeListing","code":["let service = MockPaywallService(isPro: true)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"type":"text","text":" also ships "},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" for RevenueCat-flavored previews."}]},{"text":"Step 4: Wire the plugin","type":"heading","anchor":"Step-4-Wire-the-plugin","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct and register "},{"type":"codeVoice","code":"PaywallPlugin"},{"type":"text","text":" inside your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory:"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService(entitlementID: \"pro\")",")","plugins.register(paywallPlugin)"]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In production, wrap the service in ","type":"text"},{"type":"codeVoice","code":"ResilientPaywallService"},{"text":" so a transient entitlement-read failure at cold launch never gates a paid user as free. Back its cache with ","type":"text"},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"text":" (not ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"text":", whose plist a user can edit to spoof entitlements):","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["service: ResilientPaywallService(","    base: RevenueCatPaywallService(entitlementID: \"pro\"),","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")"]},{"type":"paragraph","inlineContent":[{"text":"The cache is not scoped to an account: if your app signs users in and out, call ","type":"text"},{"type":"codeVoice","code":"clearCache()"},{"text":" on the resilient service at sign-out and account switch. See the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" reference (","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"reference","isActive":true},{"text":") for the staleness policy, threat model, and sign-out sequence.","type":"text"}]}],"type":"aside","style":"tip","name":"Tip"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app can launch in the background before the first unlock after a restart, the keychain can’t be read yet, and "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for the cached entitlement just as it does when nothing is cached. "},{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" then treats the cache as empty. The entitlement stream yields no cached seed, so "},{"type":"codeVoice","code":"store.paywall"},{"type":"text","text":" stays free until some snapshot arrives, and a refresh whose live reads all fail sets "},{"type":"codeVoice","code":"store.paywall.error"},{"type":"text","text":" instead of returning the cached entitlement. The miss doesn’t erase anything, because the service writes the cache only when a live snapshot arrives or "},{"type":"codeVoice","code":"clearCache()"},{"type":"text","text":" runs. The service also doesn’t watch for the keychain becoming readable, so dispatch "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":" when a scene becomes active. Step 5 below builds the root view; add the scene-phase property and modifier to it:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ A property on the root view:","@Environment(\\.scenePhase) private var scenePhase","","\/\/ A modifier on the view its body returns:",".onChange(of: scenePhase) { _, phase in","    if phase == .active { store.send(.paywall(.refreshCustomerInfo)) }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once the keychain is readable, a refresh whose live reads all fail returns the cached entitlement if it is within "},{"type":"codeVoice","code":"maxCacheAge"},{"type":"text","text":" (a permanent license is kept past it). On success, the refresh’s snapshot sets "},{"type":"codeVoice","code":"store.paywall.isPro"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" from its own values, so "},{"code":"isGateSatisfied","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"type":"text","text":" for a user with no entitlement. If the refresh gets neither a live snapshot nor a usable cache, "},{"type":"codeVoice","code":"store.paywall.error"},{"type":"text","text":" is set, and "},{"code":"isPro","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" stay as they were. See “Failure Modes” in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"},{"type":"text","text":" for how "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" reports a locked keychain on writes and on "},{"type":"codeVoice","code":"deviceIdentity(key:)"},{"type":"text","text":"."}]},{"text":"Step 5: Observe customer info on launch","type":"heading","anchor":"Step-5-Observe-customer-info-on-launch","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start the long-lived entitlement stream once, on the root view:"}]},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"observeCustomerInfo"},{"type":"text","text":" returns an effect that lives for the duration of "},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"type":"text","text":". Every snapshot the service yields flows through "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" and updates "},{"type":"codeVoice","code":"store.paywall.isPro"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Step 6: Present the paywall","anchor":"Step-6-Present-the-paywall"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bind a sheet to "},{"type":"codeVoice","code":"store.paywall.isPresented"},{"type":"text","text":" and dispatch "},{"type":"codeVoice","code":".paywall(.dismiss)"},{"type":"text","text":" when it closes:"}]},{"syntax":"swift","type":"codeListing","code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you are still on "},{"type":"codeVoice","code":"SimulatedPaywallService"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxDevPaywallUI"},{"type":"text","text":" sheet, the "},{"type":"codeVoice","code":".devPaywall(state:service:onAction:)"},{"type":"text","text":" call is replaced, not kept, when you adopt RevenueCat. See “Moving to a real provider” in "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","isActive":true},{"text":" for the exact change.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Trigger presentation by dispatching ","type":"text"},{"code":".paywall(.request(reason:))","type":"codeVoice"},{"text":" with a short identifier describing why you’re asking. The reason is stored in ","type":"text"},{"type":"codeVoice","code":"store.paywall.requestedReason"},{"type":"text","text":" so the sheet can tailor its copy."}]},{"syntax":"swift","type":"codeListing","code":["store.send(.paywall(.request(reason: \"export-pdf\")))"]},{"type":"heading","level":2,"text":"Step 7: Gate a feature","anchor":"Step-7-Gate-a-feature"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"code":"PaywallState.isGateSatisfied","type":"codeVoice"},{"type":"text","text":" before running gated work. If it’s "},{"type":"codeVoice","code":"false"},{"type":"text","text":", dispatch "},{"code":".request","type":"codeVoice"},{"type":"text","text":" instead:"}]},{"syntax":"swift","type":"codeListing","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"]},{"type":"heading","level":2,"text":"Step 8: Restore purchases","anchor":"Step-8-Restore-purchases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a restore button to your paywall sheet. Reflect "},{"code":"store.paywall.isLoading","type":"codeVoice"},{"type":"text","text":" to disable it while the call is in flight:"}]},{"syntax":"swift","type":"codeListing","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"]},{"type":"paragraph","inlineContent":[{"text":"On success, the resulting snapshot flows through ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" and updates the gate. On failure, ","type":"text"},{"code":"store.paywall.error","type":"codeVoice"},{"text":" is set. Either outcome lands even if the user closes the sheet while the restore is still running: the refresh that ","type":"text"},{"code":".dismiss","type":"codeVoice"},{"text":" dispatches cannot supersede a restore. Only a live stream update that arrives mid-restore outranks the restore’s snapshot, because the provider’s feed is at least as new. ","type":"text"},{"code":"isLoading","type":"codeVoice"},{"text":" stays ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" until the restore finishes or a newer snapshot lands, so a restore the provider never completes cannot hold the spinner once a refresh succeeds.","type":"text"}]},{"anchor":"Step-9-Manage-subscriptions","level":2,"type":"heading","text":"Step 9: Manage subscriptions"},{"inlineContent":[{"type":"text","text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:"}],"type":"paragraph"},{"type":"codeListing","code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"This opens "},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"type":"text","text":" via the plugin’s "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler, which routes to the App Store on iOS and Settings on macOS."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Testing","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"MockPaywallService","type":"codeVoice"},{"text":" to drive previews and tests into a known entitlement state:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"]},{"inlineContent":[{"type":"text","text":"Plumb the service through a parameter on your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory so previews can override it without touching the live RevenueCat SDK."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/swidux\/howtoaddapaywall"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article","title":"Add a Paywall"},"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"generated":true,"title":"How-to Guides","anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HostingRemoteConfig","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"kind":"article","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"title":"Add iCloud Sync","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"topic","url":"\/documentation\/swidux\/howtoaddicloudsync","role":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"title":"Plugin Architecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","kind":"article","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"type":"topic","role":"article","url":"\/documentation\/swidux\/pluginarchitecture"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"kind":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"title":"Add Feature Flags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"topic","url":"\/documentation\/swidux\/howtoaddfeatureflags","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"kind":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"title":"