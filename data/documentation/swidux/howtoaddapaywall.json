{"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"anchor":"How-to-Guides","generated":true,"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"]}],"sections":[],"metadata":{"role":"article","title":"Add a Paywall","roleHeading":"Article","modules":[{"name":"Swidux"}]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":", presenting the sheet, gating a feature, and previewing in pro state.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"reference","isActive":true},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Before you start","type":"heading","anchor":"Before-you-start","level":2},{"inlineContent":[{"text":"This guide assumes:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"You have a Swidux app already wired up — ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"AppStore"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"text":" first.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care.","type":"text"}]}]}]},{"text":"Step 1: Add the dependency","type":"heading","anchor":"Step-1-Add-the-dependency","level":2},{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" product to your app target in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"]},{"text":"Step 2: Add state and actions","type":"heading","anchor":"Step-2-Add-state-and-actions","level":2},{"inlineContent":[{"text":"Add a paywall slice to ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":", and a paywall case to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"]},{"name":"Tip","type":"aside","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"import SwiduxPaywall"},{"text":" is needed in ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"every","type":"text"}]},{"text":" file that touches ","type":"text"},{"type":"codeVoice","code":"store.paywall.*"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"PaywallAction"},{"text":" — including views that read the slice for display. ","type":"text"},{"type":"codeVoice","code":"@_exported import Swidux"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}],"style":"tip"},{"inlineContent":[{"text":"The plugin owns reducing for ","type":"text"},{"code":".paywall","type":"codeVoice"},{"text":" actions, so the root reducer should fall through:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ AppReducer.swift","case .paywall:","    return nil"]},{"text":"Step 3: Provide a `PaywallService`","type":"heading","anchor":"Step-3-Provide-a-PaywallService","level":2},{"inlineContent":[{"text":"The plugin needs a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that talks to your purchase backend. Pick the path that matches your backend.","type":"text"}],"type":"paragraph"},{"text":"Path A: RevenueCat (recommended)","type":"heading","anchor":"Path-A-RevenueCat-recommended","level":3},{"inlineContent":[{"text":"Add the ","type":"text"},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"reference","isActive":true},{"text":" companion package and use the supplied ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":". No bridging code on your side.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"]},{"syntax":"swift","type":"codeListing","code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService()"]},{"inlineContent":[{"text":"The companion package also ships ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":", a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin. See its ","type":"text"},{"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","type":"reference","isActive":true},{"text":" for configuration (API key, entitlement identifiers).","type":"text"}],"type":"paragraph"},{"text":"Path B: StoreKit or custom backend","type":"heading","anchor":"Path-B-StoreKit-or-custom-backend","level":3},{"inlineContent":[{"text":"For any non-RevenueCat backend, implement ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" directly. The protocol is small:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"]},{"inlineContent":[{"text":"A vanilla StoreKit conformer iterates ","type":"text"},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"text":" and listens to ","type":"text"},{"code":"Transaction.updates","type":"codeVoice"},{"text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement.","type":"text"}],"type":"paragraph"},{"text":"Previews and tests","type":"heading","anchor":"Previews-and-tests","level":3},{"type":"paragraph","inlineContent":[{"text":"Use the built-in ","type":"text"},{"type":"codeVoice","code":"MockPaywallService"},{"text":" for backend-agnostic previews:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let service = MockPaywallService(isPro: true)"]},{"inlineContent":[{"text":"If you’re on Path A, ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"text":" also ships ","type":"text"},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"text":" for RevenueCat-flavored previews.","type":"text"}],"type":"paragraph"},{"text":"Step 4: Wire the plugin","type":"heading","anchor":"Step-4-Wire-the-plugin","level":2},{"inlineContent":[{"text":"Construct and register ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":" inside your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService()",")","plugins.register(paywallPlugin)"]},{"name":"Tip","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"In production, wrap the service in ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" so a","type":"text"},{"text":" ","type":"text"},{"text":"transient entitlement-read failure at cold launch never gates a paid user as","type":"text"},{"text":" ","type":"text"},{"text":"free. Back its cache with ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" (not ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":", whose","type":"text"},{"text":" ","type":"text"},{"text":"plist a user can edit to spoof entitlements):","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["service: ResilientPaywallService(","    base: RevenueCatPaywallService(),","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")"]},{"type":"paragraph","inlineContent":[{"text":"See the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" reference (","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","isActive":true,"type":"reference"},{"text":") for the","type":"text"},{"text":" ","type":"text"},{"text":"staleness policy and threat model.","type":"text"}]}],"style":"tip"},{"text":"Step 5: Observe customer info on launch","type":"heading","anchor":"Step-5-Observe-customer-info-on-launch","level":2},{"inlineContent":[{"text":"Start the long-lived entitlement stream once, on the root view:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"]},{"inlineContent":[{"type":"codeVoice","code":"observeCustomerInfo"},{"text":" returns an effect that lives for the duration of ","type":"text"},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"text":". Every snapshot the service yields flows through ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" and updates ","type":"text"},{"type":"codeVoice","code":"store.paywall.isPro"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Step 6: Present the paywall","type":"heading","anchor":"Step-6-Present-the-paywall","level":2},{"inlineContent":[{"text":"Bind a sheet to ","type":"text"},{"code":"store.paywall.isPresented","type":"codeVoice"},{"text":" and dispatch ","type":"text"},{"code":".paywall(.dismiss)","type":"codeVoice"},{"text":" when it closes:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"]},{"inlineContent":[{"text":"Trigger presentation by dispatching ","type":"text"},{"type":"codeVoice","code":".paywall(.request(reason:))"},{"text":" with a short identifier describing why you’re asking. The reason is stored in ","type":"text"},{"type":"codeVoice","code":"store.paywall.requestedReason"},{"text":" so the sheet can tailor its copy.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["store.send(.paywall(.request(reason: \"export-pdf\")))"]},{"text":"Step 7: Gate a feature","type":"heading","anchor":"Step-7-Gate-a-feature","level":2},{"inlineContent":[{"text":"Read ","type":"text"},{"type":"codeVoice","code":"PaywallState.isGateSatisfied"},{"text":" before running gated work. If it’s ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", dispatch ","type":"text"},{"type":"codeVoice","code":".request"},{"text":" instead:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"]},{"text":"Step 8: Restore purchases","type":"heading","level":2,"anchor":"Step-8-Restore-purchases"},{"inlineContent":[{"text":"Add a restore button to your paywall sheet. Reflect ","type":"text"},{"type":"codeVoice","code":"store.paywall.isLoading"},{"text":" to disable it while the call is in flight:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"]},{"inlineContent":[{"text":"On success, the resulting snapshot flows through ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" and updates the gate. On failure, ","type":"text"},{"type":"codeVoice","code":"store.paywall.error"},{"text":" is set.","type":"text"}],"type":"paragraph"},{"text":"Step 9: Manage subscriptions","type":"heading","level":2,"anchor":"Step-9-Manage-subscriptions"},{"inlineContent":[{"text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"]},{"inlineContent":[{"text":"This opens ","type":"text"},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"text":" via the plugin’s ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" handler, which routes to the App Store on iOS and Settings on macOS.","type":"text"}],"type":"paragraph"},{"text":"Testing","type":"heading","level":2,"anchor":"Testing"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"MockPaywallService"},{"text":" to drive previews and tests into a known entitlement state:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"]},{"inlineContent":[{"text":"Plumb the service through a parameter on your ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory so previews can override it without touching the live RevenueCat SDK.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"variants":[{"paths":["\/documentation\/swidux\/howtoaddapaywall"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Swidux/documentation/Swidux":{"kind":"symbol","type":"topic","url":"\/documentation\/swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux"},"https://heirloomlogic.github.io/SwiduxRevenueCatPaywall/documentation/swiduxrevenuecatpaywall/":{"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","title":"DocC reference","type":"link","url":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/