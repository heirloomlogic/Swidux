{"abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"kind":"article","seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"anchor":"How-to-Guides"}],"metadata":{"roleHeading":"Article","title":"Add a Paywall","role":"article","modules":[{"name":"Swidux"}]},"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":", presenting the sheet, gating a feature, and previewing in pro state.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","isActive":true},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"text":".","type":"text"}]},{"type":"heading","level":2,"anchor":"Before-you-start","text":"Before you start"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true,"type":"reference"},{"text":" first.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care."}]}]}]},{"level":2,"anchor":"Step-1-Add-the-dependency","type":"heading","text":"Step 1: Add the dependency"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" product to your app target in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Step-2-Add-state-and-actions","type":"heading","text":"Step 2: Add state and actions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a paywall slice to "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" with "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":", and a paywall case to "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":":"}]},{"code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"],"syntax":"swift","type":"codeListing"},{"code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"],"syntax":"swift","type":"codeListing"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxPaywall"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"text":"every","type":"text"}]},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.paywall.*"},{"text":" or ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"text":" — including views that read the slice for display. ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"style":"tip","name":"Tip","type":"aside"},{"type":"paragraph","inlineContent":[{"text":"The plugin owns reducing for ","type":"text"},{"type":"codeVoice","code":".paywall"},{"text":" actions, so the root reducer should fall through:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ AppReducer.swift","case .paywall:","    return nil"]},{"type":"heading","text":"Step 3: Provide a `PaywallService`","anchor":"Step-3-Provide-a-PaywallService","level":2},{"type":"paragraph","inlineContent":[{"text":"The plugin needs a ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" conformer that talks to your purchase backend. Pick the path that matches your backend.","type":"text"}]},{"type":"heading","text":"Path A: RevenueCat (recommended)","anchor":"Path-A-RevenueCat-recommended","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","isActive":true},{"type":"text","text":" companion package and use the supplied "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":". No bridging code on your side."}]},{"type":"codeListing","syntax":"swift","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"]},{"type":"codeListing","syntax":"swift","code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService()"]},{"type":"paragraph","inlineContent":[{"text":"The companion package also ships ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":", a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin. See its ","type":"text"},{"isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","type":"reference"},{"text":" for configuration (API key, entitlement identifiers).","type":"text"}]},{"type":"heading","text":"Path B: StoreKit or custom backend","anchor":"Path-B-StoreKit-or-custom-backend","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For any non-RevenueCat backend, implement "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" directly. The protocol is small:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"A vanilla StoreKit conformer iterates ","type":"text"},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"text":" and listens to ","type":"text"},{"code":"Transaction.updates","type":"codeVoice"},{"text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement.","type":"text"}]},{"type":"heading","anchor":"Previews-and-tests","level":3,"text":"Previews and tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the built-in "},{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" for backend-agnostic previews:"}]},{"type":"codeListing","syntax":"swift","code":["let service = MockPaywallService(isPro: true)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"type":"text","text":" also ships "},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" for RevenueCat-flavored previews."}]},{"type":"heading","anchor":"Step-4-Wire-the-plugin","level":2,"text":"Step 4: Wire the plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct and register "},{"code":"PaywallPlugin","type":"codeVoice"},{"text":" inside your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService()",")","plugins.register(paywallPlugin)"]},{"type":"heading","anchor":"Step-5-Observe-customer-info-on-launch","level":2,"text":"Step 5: Observe customer info on launch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start the long-lived entitlement stream once, on the root view:"}]},{"type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"observeCustomerInfo","type":"codeVoice"},{"text":" returns an effect that lives for the duration of ","type":"text"},{"code":"PaywallService.customerInfoStream()","type":"codeVoice"},{"text":". Every snapshot the service yields flows through ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" and updates ","type":"text"},{"code":"store.paywall.isPro","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","text":"Step 6: Present the paywall","anchor":"Step-6-Present-the-paywall","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bind a sheet to "},{"type":"codeVoice","code":"store.paywall.isPresented"},{"type":"text","text":" and dispatch "},{"type":"codeVoice","code":".paywall(.dismiss)"},{"type":"text","text":" when it closes:"}]},{"type":"codeListing","code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Trigger presentation by dispatching "},{"type":"codeVoice","code":".paywall(.request(reason:))"},{"type":"text","text":" with a short identifier describing why you’re asking. The reason is stored in "},{"type":"codeVoice","code":"store.paywall.requestedReason"},{"type":"text","text":" so the sheet can tailor its copy."}]},{"type":"codeListing","code":["store.send(.paywall(.request(reason: \"export-pdf\")))"],"syntax":"swift"},{"type":"heading","text":"Step 7: Gate a feature","anchor":"Step-7-Gate-a-feature","level":2},{"inlineContent":[{"text":"Read ","type":"text"},{"type":"codeVoice","code":"PaywallState.isGateSatisfied"},{"type":"text","text":" before running gated work. If it’s "},{"type":"codeVoice","code":"false"},{"type":"text","text":", dispatch "},{"type":"codeVoice","code":".request"},{"type":"text","text":" instead:"}],"type":"paragraph"},{"code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Step-8-Restore-purchases","text":"Step 8: Restore purchases","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a restore button to your paywall sheet. Reflect "},{"type":"codeVoice","code":"store.paywall.isLoading"},{"type":"text","text":" to disable it while the call is in flight:"}]},{"code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"On success, the resulting snapshot flows through ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" and updates the gate. On failure, ","type":"text"},{"code":"store.paywall.error","type":"codeVoice"},{"text":" is set.","type":"text"}]},{"anchor":"Step-9-Manage-subscriptions","text":"Step 9: Manage subscriptions","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:","type":"text"}]},{"code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" via the plugin’s "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler, which routes to the App Store on iOS and Settings on macOS."}]},{"anchor":"Testing","text":"Testing","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"MockPaywallService"},{"text":" to drive previews and tests into a known entitlement state:","type":"text"}]},{"code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plumb the service through a parameter on your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory so previews can override it without touching the live RevenueCat SDK."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddapaywall"]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","role":"article","kind":"article","abstract":[{"type":