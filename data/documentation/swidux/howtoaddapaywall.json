{"variants":[{"paths":["\/documentation\/swidux\/howtoaddapaywall"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"metadata":{"role":"article","title":"Add a Paywall","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation","title":"Related Documentation"},{"title":"How-to Guides","anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":", presenting the sheet, gating a feature, and previewing in pro state.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For an API-level reference of every type and action, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},{"type":"text","text":". For where domain plugins fit in the dispatch cycle, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Before-you-start","text":"Before you start","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This guide assumes:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care."}]}]}],"type":"unorderedList"},{"text":"Step 1: Add the dependency","level":2,"anchor":"Step-1-Add-the-dependency","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" product to your app target in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"]},{"type":"heading","level":2,"anchor":"Step-2-Add-state-and-actions","text":"Step 2: Add state and actions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a paywall slice to "},{"type":"codeVoice","code":"AppState"},{"text":" with ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":", and a paywall case to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"]},{"content":[{"inlineContent":[{"text":"","type":"text"},{"code":"import SwiduxPaywall","type":"codeVoice"},{"text":" is needed in ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"every","type":"text"}]},{"text":" file that touches ","type":"text"},{"code":"store.paywall.*","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"text":" — including views that read the slice for display. ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","style":"tip","name":"Tip"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"code":".paywall","type":"codeVoice"},{"text":" actions, so the root reducer should fall through:","type":"text"}]},{"syntax":"swift","code":["\/\/ AppReducer.swift","case .paywall:","    return nil"],"type":"codeListing"},{"level":2,"text":"Step 3: Provide a `PaywallService`","anchor":"Step-3-Provide-a-PaywallService","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The plugin needs a ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that talks to your purchase backend. Pick the path that matches your backend."}]},{"type":"heading","level":3,"anchor":"Path-A-RevenueCat-recommended","text":"Path A: RevenueCat (recommended)"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","isActive":true,"type":"reference"},{"text":" companion package and use the supplied ","type":"text"},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"text":". No bridging code on your side.","type":"text"}]},{"code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"],"syntax":"swift","type":"codeListing"},{"code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService(entitlementID: \"pro\")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"entitlementID"},{"type":"text","text":" is the RevenueCat entitlement identifier that grants pro; pass "},{"type":"codeVoice","code":"permanentLicenseEntitlementID:"},{"type":"text","text":" too if you sell a lifetime unlock. The companion package also ships "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":", a SwiftUI sheet built on RevenueCatUI. The sheet only dispatches presentation actions ("},{"type":"codeVoice","code":".dismiss"},{"type":"text","text":", "},{"type":"codeVoice","code":".dismissCustomerCenter"},{"text":"); a completed purchase reaches the plugin through ","type":"text"},{"code":"customerInfoStream()","type":"codeVoice"},{"text":", which is why you start ","type":"text"},{"type":"codeVoice","code":".observeCustomerInfo"},{"text":" in Step 5. See its ","type":"text"},{"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","isActive":true,"type":"reference"},{"text":" for configuration (API key, entitlement identifiers).","type":"text"}]},{"type":"heading","level":3,"anchor":"Path-B-StoreKit-or-custom-backend","text":"Path B: StoreKit or custom backend"},{"type":"paragraph","inlineContent":[{"text":"For any non-RevenueCat backend, implement ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" directly. The protocol is small:"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vanilla StoreKit conformer iterates "},{"type":"codeVoice","code":"Transaction.currentEntitlements"},{"type":"text","text":" and listens to "},{"type":"codeVoice","code":"Transaction.updates"},{"text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement.","type":"text"}]},{"level":3,"text":"Previews and tests","anchor":"Previews-and-tests","type":"heading"},{"inlineContent":[{"text":"Use the built-in ","type":"text"},{"code":"MockPaywallService","type":"codeVoice"},{"text":" for backend-agnostic previews:","type":"text"}],"type":"paragraph"},{"code":["let service = MockPaywallService(isPro: true)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" also ships "},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" for RevenueCat-flavored previews."}],"type":"paragraph"},{"level":2,"text":"Step 4: Wire the plugin","anchor":"Step-4-Wire-the-plugin","type":"heading"},{"inlineContent":[{"text":"Construct and register ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":" inside your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory:","type":"text"}],"type":"paragraph"},{"code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService(entitlementID: \"pro\")",")","plugins.register(paywallPlugin)"],"syntax":"swift","type":"codeListing"},{"style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In production, wrap the service in "},{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" so a transient entitlement-read failure at cold launch never gates a paid user as free. Back its cache with "},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" (not "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":", whose plist a user can edit to spoof entitlements):"}]},{"syntax":"swift","code":["service: ResilientPaywallService(","    base: RevenueCatPaywallService(entitlementID: \"pro\"),","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The cache is not scoped to an account: if your app signs users in and out, call "},{"code":"clearCache()","type":"codeVoice"},{"type":"text","text":" on the resilient service at sign-out and account switch. See the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" reference ("},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","isActive":true},{"type":"text","text":") for the staleness policy, threat model, and sign-out sequence."}],"type":"paragraph"}],"type":"aside"},{"inlineContent":[{"text":"If your app can launch in the background before the first unlock after a restart, the keychain can’t be read yet, and ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" for the cached entitlement just as it does when nothing is cached. ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":" then treats the cache as empty. The entitlement stream yields no cached seed, so "},{"type":"codeVoice","code":"store.paywall"},{"type":"text","text":" stays free until some snapshot arrives, and a refresh whose live reads all fail sets "},{"type":"codeVoice","code":"store.paywall.error"},{"type":"text","text":" instead of returning the cached entitlement. The miss doesn’t erase anything, because the service writes the cache only when a live snapshot arrives or "},{"type":"codeVoice","code":"clearCache()"},{"type":"text","text":" runs. The service also doesn’t watch for the keychain becoming readable, so dispatch "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":" when a scene becomes active. Step 5 below builds the root view; add the scene-phase property and modifier to it:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ A property on the root view:","@Environment(\\.scenePhase) private var scenePhase","","\/\/ A modifier on the view its body returns:",".onChange(of: scenePhase) { _, phase in","    if phase == .active { store.send(.paywall(.refreshCustomerInfo)) }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once the keychain is readable, a refresh whose live reads all fail returns the cached entitlement if it is within "},{"type":"codeVoice","code":"maxCacheAge"},{"type":"text","text":" (a permanent license is kept past it). On success, the refresh’s snapshot sets "},{"type":"codeVoice","code":"store.paywall.isPro"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" from its own values, so "},{"type":"codeVoice","code":"isGateSatisfied"},{"type":"text","text":" is "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for a user with no entitlement. If the refresh gets neither a live snapshot nor a usable cache, "},{"type":"codeVoice","code":"store.paywall.error"},{"type":"text","text":" is set, and "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" stay as they were. See “Failure Modes” in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"},{"type":"text","text":" for how "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" reports a locked keychain on writes and on "},{"type":"codeVoice","code":"deviceIdentity(key:)"},{"type":"text","text":"."}]},{"anchor":"Step-5-Observe-customer-info-on-launch","type":"heading","text":"Step 5: Observe customer info on launch","level":2},{"type":"paragraph","inlineContent":[{"text":"Start the long-lived entitlement stream once, on the root view:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"observeCustomerInfo"},{"type":"text","text":" returns an effect that lives for the duration of "},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"type":"text","text":". Every snapshot the service yields flows through "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" and updates "},{"type":"codeVoice","code":"store.paywall.isPro"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":"."}]},{"level":2,"text":"Step 6: Present the paywall","anchor":"Step-6-Present-the-paywall","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bind a sheet to "},{"code":"store.paywall.isPresented","type":"codeVoice"},{"type":"text","text":" and dispatch "},{"code":".paywall(.dismiss)","type":"codeVoice"},{"type":"text","text":" when it closes:"}]},{"code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"If you are still on ","type":"text"},{"code":"SimulatedPaywallService","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxDevPaywallUI","type":"codeVoice"},{"text":" sheet, the ","type":"text"},{"code":".devPaywall(state:service:onAction:)","type":"codeVoice"},{"text":" call is replaced, not kept, when you adopt RevenueCat. See “Moving to a real provider” in ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","isActive":true,"type":"reference"},{"text":" for the exact change.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Trigger presentation by dispatching "},{"type":"codeVoice","code":".paywall(.request(reason:))"},{"type":"text","text":" with a short identifier describing why you’re asking. The reason is stored in "},{"type":"codeVoice","code":"store.paywall.requestedReason"},{"type":"text","text":" so the sheet can tailor its copy."}]},{"code":["store.send(.paywall(.request(reason: \"export-pdf\")))"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Step 7: Gate a feature","type":"heading","anchor":"Step-7-Gate-a-feature"},{"inlineContent":[{"text":"Read ","type":"text"},{"code":"PaywallState.isGateSatisfied","type":"codeVoice"},{"text":" before running gated work. If it’s ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", dispatch ","type":"text"},{"code":".request","type":"codeVoice"},{"text":" instead:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"type":"codeListing"},{"level":2,"text":"Step 8: Restore purchases","type":"heading","anchor":"Step-8-Restore-purchases"},{"inlineContent":[{"text":"Add a restore button to your paywall sheet. Reflect ","type":"text"},{"code":"store.paywall.isLoading","type":"codeVoice"},{"text":" to disable it while the call is in flight:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"type":"codeListing"},{"inlineContent":[{"text":"On success, the resulting snapshot flows through ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" and updates the gate. On failure, ","type":"text"},{"type":"codeVoice","code":"store.paywall.error"},{"text":" is set. Either outcome lands even if the user closes the sheet while the restore is still running: the refresh that ","type":"text"},{"type":"codeVoice","code":".dismiss"},{"text":" dispatches cannot supersede a restore. Only a live stream update that arrives mid-restore outranks the restore’s snapshot, because the provider’s feed is at least as new. ","type":"text"},{"type":"codeVoice","code":"isLoading"},{"text":" stays ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" until the restore finishes or a newer snapshot lands, so a restore the provider never completes cannot hold the spinner once a refresh succeeds.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Step 9: Manage subscriptions","type":"heading","anchor":"Step-9-Manage-subscriptions"},{"inlineContent":[{"text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"],"type":"codeListing"},{"inlineContent":[{"text":"This opens ","type":"text"},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"text":" via the plugin’s ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" handler, which routes to the App Store on iOS and Settings on macOS.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Testing","text":"Testing","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" to drive previews and tests into a known entitlement state:"}]},{"code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Plumb the service through a parameter on your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory so previews can override it without touching the live RevenueCat SDK.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"references":{"doc://Swidux/documentation/Swidux":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"title":"Swidux","kind":"symbol","url":"\/documentation\/swidux"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","kind":"article","title":"Add a Version Killswitch","role":"article","abstract":[{"text":"Wire a remote-controlled blocker that covers the UI of unsupported app versions, with an “Update” path back to the App Store.","type":"text"}],"type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","kind":"article","title":"Add a Parental Gate","role":"article","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"type":"topic","url":"\/documentation\/swidux\/howtoaddaparentalgate"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"kind":"article","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddicloudsync","type":"topic","role":"article","title":"Add iCloud Sync","identifier":"doc