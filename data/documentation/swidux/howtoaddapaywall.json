of every type and action, see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}]},{"anchor":"Before-you-start","text":"Before you start","type":"heading","level":2},{"inlineContent":[{"text":"This guide assumes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference"},{"text":" first.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care."}]}]}],"type":"unorderedList"},{"text":"Step 1: Add the dependency","level":2,"anchor":"Step-1-Add-the-dependency","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" product to your app target in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"],"syntax":"swift","type":"codeListing"},{"text":"Step 2: Add state and actions","level":2,"anchor":"Step-2-Add-state-and-actions","type":"heading"},{"inlineContent":[{"text":"Add a paywall slice to ","type":"text"},{"code":"AppState","type":"codeVoice"},{"type":"text","text":" with "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":", and a paywall case to "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"],"syntax":"swift","type":"codeListing"},{"code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"],"syntax":"swift","type":"codeListing"},{"name":"Tip","style":"tip","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"import SwiduxPaywall"},{"text":" is needed in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"text":" file that touches ","type":"text"},{"type":"codeVoice","code":"store.paywall.*"},{"text":" or ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"text":" — including views that read the slice for display. ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"text":".","type":"text"}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"code":".paywall","type":"codeVoice"},{"type":"text","text":" actions, so the root reducer should fall through:"}],"type":"paragraph"},{"code":["\/\/ AppReducer.swift","case .paywall:","    return nil"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"Step 3: Provide a `PaywallService`","level":2,"anchor":"Step-3-Provide-a-PaywallService"},{"type":"paragraph","inlineContent":[{"text":"The plugin needs a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that talks to your purchase backend. Pick the path that matches your backend.","type":"text"}]},{"type":"heading","text":"Path A: RevenueCat (recommended)","level":3,"anchor":"Path-A-RevenueCat-recommended"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"reference"},{"text":" companion package and use the supplied ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":". No bridging code on your side.","type":"text"}]},{"code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"],"type":"codeListing","syntax":"swift"},{"code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The companion package also ships ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":", a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin. See its ","type":"text"},{"isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","type":"reference"},{"text":" for configuration (API key, entitlement identifiers).","type":"text"}]},{"type":"heading","text":"Path B: StoreKit or custom backend","level":3,"anchor":"Path-B-StoreKit-or-custom-backend"},{"type":"paragraph","inlineContent":[{"text":"For any non-RevenueCat backend, implement ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" directly. The protocol is small:","type":"text"}]},{"code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A vanilla StoreKit conformer iterates ","type":"text"},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"text":" and listens to ","type":"text"},{"code":"Transaction.updates","type":"codeVoice"},{"text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement.","type":"text"}]},{"type":"heading","text":"Previews and tests","level":3,"anchor":"Previews-and-tests"},{"type":"paragraph","inlineContent":[{"text":"Use the built-in ","type":"text"},{"code":"MockPaywallService","type":"codeVoice"},{"text":" for backend-agnostic previews:","type":"text"}]},{"code":["let service = MockPaywallService(isPro: true)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If you’re on Path A, ","type":"text"},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":" also ships ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" for RevenueCat-flavored previews.","type":"text"}]},{"type":"heading","text":"Step 4: Wire the plugin","level":2,"anchor":"Step-4-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"text":"Construct and register ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":" inside your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory:","type":"text"}]},{"code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService()",")","plugins.register(paywallPlugin)"],"type":"codeListing","syntax":"swift"},{"style":"tip","type":"aside","name":"Tip","content":[{"inlineContent":[{"text":"In production, wrap the service in ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" so a","type":"text"},{"text":" ","type":"text"},{"text":"transient entitlement-read failure at cold launch never gates a paid user as","type":"text"},{"text":" ","type":"text"},{"text":"free. Back its cache with ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" (not ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":", whose","type":"text"},{"type":"text","text":" "},{"type":"text","text":"plist a user can edit to spoof entitlements):"}],"type":"paragraph"},{"code":["service: ResilientPaywallService(","    base: RevenueCatPaywallService(),","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"See the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" reference ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},{"type":"text","text":") for the"},{"text":" ","type":"text"},{"type":"text","text":"staleness policy and threat model."}],"type":"paragraph"}]},{"text":"Step 5: Observe customer info on launch","level":2,"anchor":"Step-5-Observe-customer-info-on-launch","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Start the long-lived entitlement stream once, on the root view:","type":"text"}]},{"code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"observeCustomerInfo"},{"text":" returns an effect that lives for the duration of ","type":"text"},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"text":". Every snapshot the service yields flows through ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" and updates ","type":"text"},{"code":"store.paywall.isPro","type":"codeVoice"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Step-6-Present-the-paywall","text":"Step 6: Present the paywall","type":"heading","level":2},{"inlineContent":[{"text":"Bind a sheet to ","type":"text"},{"code":"store.paywall.isPresented","type":"codeVoice"},{"text":" and dispatch ","type":"text"},{"code":".paywall(.dismiss)","type":"codeVoice"},{"text":" when it closes:","type":"text"}],"type":"paragraph"},{"code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Trigger presentation by dispatching ","type":"text"},{"code":".paywall(.request(reason:))","type":"codeVoice"},{"text":" with a short identifier describing why you’re asking. The reason is stored in ","type":"text"},{"code":"store.paywall.requestedReason","type":"codeVoice"},{"text":" so the sheet can tailor its copy.","type":"text"}]},{"syntax":"swift","code":["store.send(.paywall(.request(reason: \"export-pdf\")))"],"type":"codeListing"},{"anchor":"Step-7-Gate-a-feature","text":"Step 7: Gate a feature","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"type":"codeVoice","code":"PaywallState.isGateSatisfied"},{"text":" before running gated work. If it’s ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", dispatch ","type":"text"},{"type":"codeVoice","code":".request"},{"text":" instead:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"]},{"text":"Step 8: Restore purchases","level":2,"anchor":"Step-8-Restore-purchases","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Add a restore button to your paywall sheet. Reflect ","type":"text"},{"code":"store.paywall.isLoading","type":"codeVoice"},{"text":" to disable it while the call is in flight:","type":"text"}]},{"code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"On success, the resulting snapshot flows through ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" and updates the gate. On failure, ","type":"text"},{"code":"store.paywall.error","type":"codeVoice"},{"text":" is set.","type":"text"}]},{"type":"heading","text":"Step 9: Manage subscriptions","level":2,"anchor":"Step-9-Manage-subscriptions"},{"type":"paragraph","inlineContent":[{"text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:","type":"text"}]},{"code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This opens ","type":"text"},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"text":" via the plugin’s ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" handler, which routes to the App Store on iOS and Settings on macOS.","type":"text"}]},{"type":"heading","text":"Testing","level":2,"anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"MockPaywallService","type":"codeVoice"},{"text":" to drive previews and tests into a known entitlement state:","type":"text"}]},{"code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Plumb the service through a parameter on your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory so previews can override it without touching the live RevenueCat SDK.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddapaywall"]}],"sections":[],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},"references":{"doc://Swidux/documentation/Swidux/SecurityPosture":{"type":"topic","title":"Security Posture","abstract":[{"type":"text","text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one."}],"kind":"article","role":"collectionGroup","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","url":"\/documentation\/swidux\/securityposture"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"type":"topic","title":"Swidux","role":"collection",