{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddapaywall"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"anchor":"How-to-Guides","title":"How-to Guides","generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"]}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":", presenting the sheet, gating a feature, and previewing in pro state."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For an API-level reference of every type and action, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","isActive":true},{"type":"text","text":". For where domain plugins fit in the dispatch cycle, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Before you start","anchor":"Before-you-start"},{"inlineContent":[{"type":"text","text":"This guide assumes:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care."}]}]}]},{"type":"heading","level":2,"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" product to your app target in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"]},{"type":"heading","level":2,"text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions"},{"inlineContent":[{"type":"text","text":"Add a paywall slice to "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":" with "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":", and a paywall case to "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"]},{"inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"code":".paywall","type":"codeVoice"},{"type":"text","text":" actions, so the root reducer should fall through:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ AppReducer.swift","case .paywall:","    return nil"]},{"type":"heading","level":2,"text":"Step 3: Provide a `PaywallService`","anchor":"Step-3-Provide-a-PaywallService"},{"inlineContent":[{"type":"text","text":"The plugin needs a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that talks to your purchase backend. Pick the path that matches your backend."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Path A: RevenueCat (recommended)","anchor":"Path-A-RevenueCat-recommended"},{"inlineContent":[{"type":"text","text":"Add the "},{"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","isActive":true},{"type":"text","text":" companion package and use the supplied "},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":". No bridging code on your side."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"]},{"syntax":"swift","type":"codeListing","code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService()"]},{"inlineContent":[{"type":"text","text":"The companion package also ships "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":", a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin. See its README for configuration (API key, entitlement identifiers)."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Path B: StoreKit or custom backend","anchor":"Path-B-StoreKit-or-custom-backend"},{"inlineContent":[{"type":"text","text":"For any non-RevenueCat backend, implement "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" directly. The protocol is small:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"]},{"inlineContent":[{"type":"text","text":"A vanilla StoreKit conformer iterates "},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"type":"text","text":" and listens to "},{"code":"Transaction.updates","type":"codeVoice"},{"type":"text","text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement."}],"type":"paragraph"},{"type":"heading","level":3,"text":"Previews and tests","anchor":"Previews-and-tests"},{"inlineContent":[{"type":"text","text":"Use the built-in "},{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" for backend-agnostic previews:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let service = MockPaywallService(isPro: true)"]},{"inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" also ships "},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" for RevenueCat-flavored previews."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Step 4: Wire the plugin","anchor":"Step-4-Wire-the-plugin"},{"inlineContent":[{"type":"text","text":"Construct and register "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":" inside your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService()",")","plugins.register(paywallPlugin)"]},{"type":"heading","level":2,"text":"Step 5: Observe customer info on launch","anchor":"Step-5-Observe-customer-info-on-launch"},{"inlineContent":[{"type":"text","text":"Start the long-lived entitlement stream once, on the root view:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"]},{"inlineContent":[{"code":"observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" returns an effect that lives for the duration of "},{"code":"PaywallService.customerInfoStream()","type":"codeVoice"},{"type":"text","text":". Every snapshot the service yields flows through "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" and updates "},{"code":"store.paywall.isPro","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"hasPermanentLicense","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Step 6: Present the paywall","anchor":"Step-6-Present-the-paywall"},{"inlineContent":[{"type":"text","text":"Bind a sheet to "},{"code":"store.paywall.isPresented","type":"codeVoice"},{"type":"text","text":" and dispatch "},{"code":".paywall(.dismiss)","type":"codeVoice"},{"type":"text","text":" when it closes:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"]},{"inlineContent":[{"type":"text","text":"Trigger presentation by dispatching "},{"code":".paywall(.request(reason:))","type":"codeVoice"},{"type":"text","text":" with a short identifier describing why you’re asking. The reason is stored in "},{"code":"store.paywall.requestedReason","type":"codeVoice"},{"type":"text","text":" so the sheet can tailor its copy."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["store.send(.paywall(.request(reason: \"export-pdf\")))"]},{"type":"heading","level":2,"text":"Step 7: Gate a feature","anchor":"Step-7-Gate-a-feature"},{"inlineContent":[{"type":"text","text":"Read "},{"code":"PaywallState.isGateSatisfied","type":"codeVoice"},{"type":"text","text":" before running gated work. If it’s "},{"code":"false","type":"codeVoice"},{"type":"text","text":", dispatch "},{"code":".request","type":"codeVoice"},{"type":"text","text":" instead:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"]},{"type":"heading","level":2,"text":"Step 8: Restore purchases","anchor":"Step-8-Restore-purchases"},{"inlineContent":[{"type":"text","text":"Add a restore button to your paywall sheet. Reflect "},{"code":"store.paywall.isLoading","type":"codeVoice"},{"type":"text","text":" to disable it while the call is in flight:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"]},{"inlineContent":[{"type":"text","text":"On success, the resulting snapshot flows through "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" and updates the gate. On failure, "},{"code":"store.paywall.error","type":"codeVoice"},{"type":"text","text":" is set."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Step 9: Manage subscriptions","anchor":"Step-9-Manage-subscriptions"},{"inlineContent":[{"type":"text","text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"]},{"inlineContent":[{"type":"text","text":"This opens "},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"type":"text","text":" via the plugin’s "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" handler, which routes to the App Store on iOS and Settings on macOS."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Testing","anchor":"Testing"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" to drive previews and tests into a known entitlement state:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"]},{"inlineContent":[{"type":"text","text":"Plumb the service through a parameter on your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory so previews can override it without touching the live RevenueCat SDK."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article","title":"Add a Paywall"},"references":{"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"title":"SwiduxRevenueCatPaywall","titleInlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"}],"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"link"},"doc://Swidux/documentation/Swidux":{"role":"collection","title":"Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","type":"topic"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","title":"Plugin Architecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","url":"\/documentation\/swidux\/pluginarchitecture","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"title":"Add a Parental Gate","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"url":"\/documentation\/swidux\/howtoaddfeatureflags","title":"Add Feature Flags","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"title":"Building a Domain Plugin","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","title":"Getting Started with Swidux","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","url":"\/documentation\/swidux\/gettingstarted","type":"topic"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"url":"\/documentation\/swidux\/pluginpaywallreference","title":"SwiduxPaywall Reference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"url":"\/documentation\/swidux\/howtoaddaversionkillswitch","title":"Add a Version Killswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"role":"article","title":"Add Analytics","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","url":"\/documentation\/swidux\/howtoaddanalytics","type":"topic"},"doc://Swidux/documentation/Swidux/AgentSkill":{"url":"\/documentation\/swidux\/agentskill","title":"Using the Swidux Agent Skill","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","type":"topic","role":"article"}}}