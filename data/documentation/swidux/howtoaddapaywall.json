{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},"sections":[],"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"Add a Paywall"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"kind":"article","primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":", presenting the sheet, gating a feature, and previewing in pro state."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For an API-level reference of every type and action, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","isActive":true,"type":"reference"},{"type":"text","text":". For where domain plugins fit in the dispatch cycle, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Before-you-start","level":2,"type":"heading","text":"Before you start"},{"inlineContent":[{"type":"text","text":"This guide assumes:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care."}],"type":"paragraph"}]}]},{"anchor":"Step-1-Add-the-dependency","level":2,"type":"heading","text":"Step 1: Add the dependency"},{"inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" product to your app target in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-2-Add-state-and-actions","level":2,"type":"heading","text":"Step 2: Add state and actions"},{"inlineContent":[{"type":"text","text":"Add a paywall slice to "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":" with "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":", and a paywall case to "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"],"type":"codeListing","syntax":"swift"},{"code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"],"type":"codeListing","syntax":"swift"},{"style":"tip","name":"Tip","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxPaywall"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.paywall.*"},{"type":"text","text":" or "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":" — including views that read the slice for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]}]},{"inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"type":"codeVoice","code":".paywall"},{"type":"text","text":" actions, so the root reducer should fall through:"}],"type":"paragraph"},{"code":["\/\/ AppReducer.swift","case .paywall:","    return nil"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Step-3-Provide-a-PaywallService","type":"heading","text":"Step 3: Provide a `PaywallService`"},{"inlineContent":[{"type":"text","text":"The plugin needs a "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that talks to your purchase backend. Pick the path that matches your backend."}],"type":"paragraph"},{"level":3,"anchor":"Path-A-RevenueCat-recommended","type":"heading","text":"Path A: RevenueCat (recommended)"},{"inlineContent":[{"type":"text","text":"Add the "},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","isActive":true,"type":"reference"},{"type":"text","text":" companion package and use the supplied "},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":". No bridging code on your side."}],"type":"paragraph"},{"code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"],"type":"codeListing","syntax":"swift"},{"code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService()"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The companion package also ships "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":", a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin. See its "},{"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","isActive":true},{"type":"text","text":" for configuration (API key, entitlement identifiers)."}],"type":"paragraph"},{"level":3,"anchor":"Path-B-StoreKit-or-custom-backend","type":"heading","text":"Path B: StoreKit or custom backend"},{"inlineContent":[{"type":"text","text":"For any non-RevenueCat backend, implement "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" directly. The protocol is small:"}],"type":"paragraph"},{"code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"A vanilla StoreKit conformer iterates "},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"type":"text","text":" and listens to "},{"code":"Transaction.updates","type":"codeVoice"},{"type":"text","text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement."}],"type":"paragraph"},{"level":3,"anchor":"Previews-and-tests","type":"heading","text":"Previews and tests"},{"inlineContent":[{"type":"text","text":"Use the built-in "},{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" for backend-agnostic previews:"}],"type":"paragraph"},{"code":["let service = MockPaywallService(isPro: true)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" also ships "},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" for RevenueCat-flavored previews."}],"type":"paragraph"},{"level":2,"anchor":"Step-4-Wire-the-plugin","type":"heading","text":"Step 4: Wire the plugin"},{"inlineContent":[{"type":"text","text":"Construct and register "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":" inside your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory:"}],"type":"paragraph"},{"code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService()",")","plugins.register(paywallPlugin)"],"type":"codeListing","syntax":"swift"},{"style":"tip","name":"Tip","type":"aside","content":[{"inlineContent":[{"type":"text","text":"In production, wrap the service in "},{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":" so a"},{"type":"text","text":" "},{"type":"text","text":"transient entitlement-read failure at cold launch never gates a paid user as"},{"type":"text","text":" "},{"type":"text","text":"free. Back its cache with "},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" (not "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":", whose"},{"type":"text","text":" "},{"type":"text","text":"plist a user can edit to spoof entitlements):"}],"type":"paragraph"},{"code":["service: ResilientPaywallService(","    base: RevenueCatPaywallService(),","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"See the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" reference ("},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","isActive":true,"type":"reference"},{"type":"text","text":") for the"},{"type":"text","text":" "},{"type":"text","text":"staleness policy and threat model."}],"type":"paragraph"}]},{"level":2,"anchor":"Step-5-Observe-customer-info-on-launch","type":"heading","text":"Step 5: Observe customer info on launch"},{"inlineContent":[{"type":"text","text":"Start the long-lived entitlement stream once, on the root view:"}],"type":"paragraph"},{"code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" returns an effect that lives for the duration of "},{"code":"PaywallService.customerInfoStream()","type":"codeVoice"},{"type":"text","text":". Every snapshot the service yields flows through "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" and updates "},{"code":"store.paywall.isPro","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"hasPermanentLicense","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Step-6-Present-the-paywall","type":"heading","text":"Step 6: Present the paywall"},{"inlineContent":[{"type":"text","text":"Bind a sheet to "},{"code":"store.paywall.isPresented","type":"codeVoice"},{"type":"text","text":" and dispatch "},{"code":".paywall(.dismiss)","type":"codeVoice"},{"type":"text","text":" when it closes:"}],"type":"paragraph"},{"code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Trigger presentation by dispatching "},{"code":".paywall(.request(reason:))","type":"codeVoice"},{"type":"text","text":" with a short identifier describing why you’re asking. The reason is stored in "},{"code":"store.paywall.requestedReason","type":"codeVoice"},{"type":"text","text":" so the sheet can tailor its copy."}],"type":"paragraph"},{"code":["store.send(.paywall(.request(reason: \"export-pdf\")))"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Step-7-Gate-a-feature","type":"heading","text":"Step 7: Gate a feature"},{"inlineContent":[{"type":"text","text":"Read "},{"code":"PaywallState.isGateSatisfied","type":"codeVoice"},{"type":"text","text":" before running gated work. If it’s "},{"code":"false","type":"codeVoice"},{"type":"text","text":", dispatch "},{"code":".request","type":"codeVoice"},{"type":"text","text":" instead:"}],"type":"paragraph"},{"code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"type":"codeListing","syntax":"swift"},{"level":2,"anchor":"Step-8-Restore-purchases","type":"heading","text":"Step 8: Restore purchases"},{"inlineContent":[{"type":"text","text":"Add a restore button to your paywall sheet. Reflect "},{"code":"store.paywall.isLoading","type":"codeVoice"},{"type":"text","text":" to disable it while the call is in flight:"}],"type":"paragraph"},{"code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"On success, the resulting snapshot flows through "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" and updates the gate. On failure, "},{"code":"store.paywall.error","type":"codeVoice"},{"type":"text","text":" is set."}],"type":"paragraph"},{"level":2,"anchor":"Step-9-Manage-subscriptions","type":"heading","text":"Step 9: Manage subscriptions"},{"inlineContent":[{"type":"text","text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:"}],"type":"paragraph"},{"code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"This opens "},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"type":"text","text":" via the plugin’s "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" handler, which routes to the App Store on iOS and Settings on macOS."}],"type":"paragraph"},{"level":2,"anchor":"Testing","type":"heading","text":"Testing"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" to drive previews and tests into a known entitlement state:"}],"type":"paragraph"},{"code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"Plumb the service through a parameter on your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory so previews can override it without touching the live RevenueCat SDK."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides","anchor":"How-to-Guides","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddapaywall"]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"role":"article","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","kind":"article","type":"topic","title":"Add a Version Killswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":" with the "},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"role":"article","url":"\/documentation\/swidux\/howtoaddicloudsync","kind":"article","type":"topic","title":"Add iCloud Sync","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},"doc://Swidux/documentation/Swidux":{"role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","kind":"symbol","type":"topic","title":"Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}]},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"type":"topic","url":"\/documentation\/swidux\/pluginpaywallreference","title":"SwiduxPaywall Reference","role":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"role":"article","kind":"article","type":"topic","url":"\/documentation\/swidux\/pluginarchitecture","title":"Plugin Architecture"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"role":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article","type":"topic","title":"Add Feature Flags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux/GettingStarted":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"role":"article","kind":"article","type":"topic","url":"\/documentation\/swidux\/gettingstarted","title":"Getting Started with Swidux"},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"type":"link","title":"SwiduxRevenueCatPaywall","titleInlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}],"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"role":"article","kind":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddpersistence","title":"Add Persistence"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"role":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","type":"topic","title":"Add a Parental Gate","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"https://heirloomlogic.github.io/SwiduxRevenueCatPaywall/documentation/swiduxrevenuecatpaywall/":{"type":"link","title":"DocC reference","titleInlineContent":[{"type":"text","text":"DocC reference"}],"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","url":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"role":"article","url":"\/documentation\/swidux\/howtoaddanalytics","kind":"article","type":"topic","title":"Add Analytics","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"role":"article","kind":"article","type":"topic","url":"\/documentation\/swidux\/howtocanceleffects","title":"Cancel Effects"},"doc://Swidux/documentation/Swidux/AgentSkill":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"role":"article","kind":"article","type":"topic","url":"\/documentation\/swidux\/agentskill","title":"Using the Swidux Agent Skill"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"role":"article","url":"\/documentation\/swidux\/buildingadomainplugin","kind":"article","type":"topic","title":"Building a Domain Plugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},"doc://Swidux/documentation/Swidux/SecurityPosture":{"abstract":[{"type":"text","text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one."}],"kind":"article","role":"collectionGroup","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","url":"\/documentation\/swidux\/securityposture","title":"Security Posture"}}}