{"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddapaywall"]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article","title":"Add a Paywall"},"abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"anchor":"How-to-Guides"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":", presenting the sheet, gating a feature, and previewing in pro state."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an API-level reference of every type and action, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}]},{"anchor":"Before-you-start","text":"Before you start","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This guide assumes:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and "},{"code":"AppStore","type":"codeVoice"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference","isActive":true},{"type":"text","text":" first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care."}]}]}]},{"anchor":"Step-1-Add-the-dependency","text":"Step 1: Add the dependency","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" product to your app target in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":":"}],"type":"paragraph"},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Step-2-Add-state-and-actions","text":"Step 2: Add state and actions","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Add a paywall slice to "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" with "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":", and a paywall case to "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"],"syntax":"swift","type":"codeListing"},{"code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"type":"codeVoice","code":".paywall"},{"type":"text","text":" actions, so the root reducer should fall through:"}],"type":"paragraph"},{"code":["\/\/ AppReducer.swift","case .paywall:","    return nil"],"syntax":"swift","type":"codeListing"},{"anchor":"Step-3-Provide-a-PaywallService","text":"Step 3: Provide a `PaywallService`","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The plugin needs a "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that talks to your purchase backend. Pick the path that matches your backend."}],"type":"paragraph"},{"anchor":"Path-A-RevenueCat-recommended","text":"Path A: RevenueCat (recommended)","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Add the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},{"type":"text","text":" companion package and use the supplied "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":". No bridging code on your side."}],"type":"paragraph"},{"code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"],"syntax":"swift","type":"codeListing"},{"code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The companion package also ships "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":", a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin. See its README for configuration (API key, entitlement identifiers)."}],"type":"paragraph"},{"anchor":"Path-B-StoreKit-or-custom-backend","text":"Path B: StoreKit or custom backend","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"For any non-RevenueCat backend, implement "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" directly. The protocol is small:"}],"type":"paragraph"},{"code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"A vanilla StoreKit conformer iterates "},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"type":"text","text":" and listens to "},{"code":"Transaction.updates","type":"codeVoice"},{"type":"text","text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement."}],"type":"paragraph"},{"anchor":"Previews-and-tests","text":"Previews and tests","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use the built-in "},{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" for backend-agnostic previews:"}],"type":"paragraph"},{"code":["let service = MockPaywallService(isPro: true)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" also ships "},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" for RevenueCat-flavored previews."}],"type":"paragraph"},{"anchor":"Step-4-Wire-the-plugin","text":"Step 4: Wire the plugin","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Construct and register "},{"code":"PaywallPlugin","type":"codeVoice"},{"text":" inside your ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService()",")","plugins.register(paywallPlugin)"]},{"anchor":"Step-5-Observe-customer-info-on-launch","level":2,"type":"heading","text":"Step 5: Observe customer info on launch"},{"type":"paragraph","inlineContent":[{"text":"Start the long-lived entitlement stream once, on the root view:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"observeCustomerInfo"},{"type":"text","text":" returns an effect that lives for the duration of "},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"text":". Every snapshot the service yields flows through ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" and updates "},{"type":"codeVoice","code":"store.paywall.isPro"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":".","type":"text"}]},{"anchor":"Step-6-Present-the-paywall","level":2,"type":"heading","text":"Step 6: Present the paywall"},{"inlineContent":[{"type":"text","text":"Bind a sheet to "},{"code":"store.paywall.isPresented","type":"codeVoice"},{"type":"text","text":" and dispatch "},{"type":"codeVoice","code":".paywall(.dismiss)"},{"text":" when it closes:","type":"text"}],"type":"paragraph"},{"code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Trigger presentation by dispatching ","type":"text"},{"code":".paywall(.request(reason:))","type":"codeVoice"},{"type":"text","text":" with a short identifier describing why you’re asking. The reason is stored in "},{"code":"store.paywall.requestedReason","type":"codeVoice"},{"type":"text","text":" so the sheet can tailor its copy."}]},{"code":["store.send(.paywall(.request(reason: \"export-pdf\")))"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Step-7-Gate-a-feature","type":"heading","text":"Step 7: Gate a feature"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"code":"PaywallState.isGateSatisfied","type":"codeVoice"},{"type":"text","text":" before running gated work. If it’s "},{"code":"false","type":"codeVoice"},{"type":"text","text":", dispatch "},{"code":".request","type":"codeVoice"},{"type":"text","text":" instead:"}]},{"code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Step-8-Restore-purchases","type":"heading","text":"Step 8: Restore purchases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a restore button to your paywall sheet. Reflect "},{"type":"codeVoice","code":"store.paywall.isLoading"},{"type":"text","text":" to disable it while the call is in flight:"}]},{"code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On success, the resulting snapshot flows through "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" and updates the gate. On failure, "},{"type":"codeVoice","code":"store.paywall.error"},{"type":"text","text":" is set."}]},{"level":2,"anchor":"Step-9-Manage-subscriptions","type":"heading","text":"Step 9: Manage subscriptions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:"}]},{"code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" via the plugin’s "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler, which routes to the App Store on iOS and Settings on macOS."}]},{"level":2,"anchor":"Testing","type":"heading","text":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" to drive previews and tests into a known entitlement state:"}]},{"code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plumb the service through a parameter on your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory so previews can override it without touching the live RevenueCat SDK."}]}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","interfaceLanguage":"swift"},"sections":[],"references":{"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","url":"\/documentation\/swidux\/pluginarchitecture","title":"Plugin Architecture","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"url":"\/documentation\/swidux\/howtoaddaversionkillswitch","kind":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"title":"Add a Version Killswitch","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"url":"\/documentation\/swidux\/howtoaddanalytics","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"title":"Add Analytics","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","role":"article"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","kind":"article","title":"SwiduxPaywall Reference","url":"\/documentation\/swidux\/pluginpaywallreference","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","kind":"article","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","title":"Add Feature Flags","url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}]},"doc://Swidux/documentation/Swidux/AgentSkill":{"url":"\/documentation\/swidux\/agentskill","kind":"article","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"title":"Using the Swidux Agent Skill","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","role":"article"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","title":"Building a Domain Plugin","url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}]},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","title":"Add a Parental Gate","url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}]},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"titleInlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}],"title":"SwiduxRevenueCatPaywall","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"link"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","kind":"symbol","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection"}}}