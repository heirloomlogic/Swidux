le":"article","title":"SwiduxPaywall Reference"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"type":"topic","url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article","title":"Add Feature Flags"},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"type":"topic","url":"\/documentation\/swidux\/gettingstarted","kind":"article","title":"Getting Started with Swidux"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"type":"topic","url":"\/documentation\/swidux\/howtoaddpersistence","kind":"article","title":"Add Persistence"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify.","type":"text"}],"type":"topic","url":"\/documentation\/swidux\/howtoaddanalytics","kind":"article","title":"Add Analytics"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"type":"topic","url":"\/documentation\/swidux\/buildingadomainplugin","kind":"article","title":"Building a Domain Plugin"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","kind":"article","title":"Add a Version Killswitch"},"doc://Swidux/documentation/Swidux":{"role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"type":"topic","url":"\/documentation\/swidux","kind":"symbol","title":"Swidux"},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","titleInlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"}],"type":"link","title":"SwiduxRevenueCatPaywall","url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"}}}