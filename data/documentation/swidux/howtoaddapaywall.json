{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"article","title":"Add a Paywall","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":", presenting the sheet, gating a feature, and previewing in pro state.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"reference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":".","type":"text"}]},{"type":"heading","level":2,"text":"Before you start","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"You have a Swidux app already wired up — ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"reference","isActive":true},{"text":" first.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care.","type":"text"}]}]}]},{"type":"heading","level":2,"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" product to your app target in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"],"syntax":"swift"},{"type":"heading","level":2,"text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions"},{"type":"paragraph","inlineContent":[{"text":"Add a paywall slice to ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":", and a paywall case to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"],"syntax":"swift"},{"type":"codeListing","code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"],"syntax":"swift"},{"type":"aside","style":"tip","name":"Tip","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"import SwiduxPaywall"},{"text":" is needed in ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"every","type":"text"}]},{"text":" file that touches ","type":"text"},{"type":"codeVoice","code":"store.paywall.*"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"PaywallAction"},{"text":" — including views that read the slice for display. ","type":"text"},{"type":"codeVoice","code":"@_exported import Swidux"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"The plugin owns reducing for ","type":"text"},{"code":".paywall","type":"codeVoice"},{"text":" actions, so the root reducer should fall through:","type":"text"}]},{"type":"codeListing","code":["\/\/ AppReducer.swift","case .paywall:","    return nil"],"syntax":"swift"},{"type":"heading","level":2,"text":"Step 3: Provide a `PaywallService`","anchor":"Step-3-Provide-a-PaywallService"},{"type":"paragraph","inlineContent":[{"text":"The plugin needs a ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" conformer that talks to your purchase backend. Pick the path that matches your backend.","type":"text"}]},{"type":"heading","level":3,"text":"Path A: RevenueCat (recommended)","anchor":"Path-A-RevenueCat-recommended"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},{"type":"text","text":" companion package and use the supplied "},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":". No bridging code on your side."}]},{"type":"codeListing","syntax":"swift","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"]},{"type":"codeListing","syntax":"swift","code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The companion package also ships "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":", a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin. See its "},{"type":"reference","isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/"},{"type":"text","text":" for configuration (API key, entitlement identifiers)."}]},{"text":"Path B: StoreKit or custom backend","type":"heading","level":3,"anchor":"Path-B-StoreKit-or-custom-backend"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For any non-RevenueCat backend, implement "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" directly. The protocol is small:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vanilla StoreKit conformer iterates "},{"type":"codeVoice","code":"Transaction.currentEntitlements"},{"type":"text","text":" and listens to "},{"type":"codeVoice","code":"Transaction.updates"},{"type":"text","text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement."}]},{"text":"Previews and tests","type":"heading","level":3,"anchor":"Previews-and-tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the built-in "},{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" for backend-agnostic previews:"}]},{"type":"codeListing","syntax":"swift","code":["let service = MockPaywallService(isPro: true)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"type":"text","text":" also ships "},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" for RevenueCat-flavored previews."}]},{"text":"Step 4: Wire the plugin","type":"heading","level":2,"anchor":"Step-4-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct and register "},{"type":"codeVoice","code":"PaywallPlugin"},{"type":"text","text":" inside your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService()",")","plugins.register(paywallPlugin)"]},{"name":"Tip","type":"aside","style":"tip","content":[{"type":"paragraph","inlineContent":[{"text":"In production, wrap the service in ","type":"text"},{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" so a","type":"text"},{"text":" ","type":"text"},{"text":"transient entitlement-read failure at cold launch never gates a paid user as","type":"text"},{"text":" ","type":"text"},{"text":"free. Back its cache with ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" (not ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":", whose","type":"text"},{"text":" ","type":"text"},{"text":"plist a user can edit to spoof entitlements):","type":"text"}]},{"type":"codeListing","code":["service: ResilientPaywallService(","    base: RevenueCatPaywallService(),","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"See the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" reference (","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"reference"},{"text":") for the","type":"text"},{"text":" ","type":"text"},{"text":"staleness policy and threat model.","type":"text"}]}]},{"text":"Step 5: Observe customer info on launch","type":"heading","level":2,"anchor":"Step-5-Observe-customer-info-on-launch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start the long-lived entitlement stream once, on the root view:"}]},{"type":"codeListing","syntax":"swift","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"observeCustomerInfo"},{"type":"text","text":" returns an effect that lives for the duration of "},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"type":"text","text":". Every snapshot the service yields flows through "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" and updates "},{"type":"codeVoice","code":"store.paywall.isPro"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":"."}]},{"text":"Step 6: Present the paywall","type":"heading","level":2,"anchor":"Step-6-Present-the-paywall"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bind a sheet to "},{"type":"codeVoice","code":"store.paywall.isPresented"},{"type":"text","text":" and dispatch "},{"type":"codeVoice","code":".paywall(.dismiss)"},{"type":"text","text":" when it closes:"}]},{"type":"codeListing","syntax":"swift","code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Trigger presentation by dispatching "},{"type":"codeVoice","code":".paywall(.request(reason:))"},{"type":"text","text":" with a short identifier describing why you’re asking. The reason is stored in "},{"type":"codeVoice","code":"store.paywall.requestedReason"},{"type":"text","text":" so the sheet can tailor its copy."}]},{"type":"codeListing","syntax":"swift","code":["store.send(.paywall(.request(reason: \"export-pdf\")))"]},{"text":"Step 7: Gate a feature","type":"heading","level":2,"anchor":"Step-7-Gate-a-feature"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"type":"codeVoice","code":"PaywallState.isGateSatisfied"},{"type":"text","text":" before running gated work. If it’s "},{"type":"codeVoice","code":"false"},{"type":"text","text":", dispatch "},{"type":"codeVoice","code":".request"},{"type":"text","text":" instead:"}]},{"type":"codeListing","syntax":"swift","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"]},{"text":"Step 8: Restore purchases","type":"heading","level":2,"anchor":"Step-8-Restore-purchases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a restore button to your paywall sheet. Reflect "},{"type":"codeVoice","code":"store.paywall.isLoading"},{"type":"text","text":" to disable it while the call is in flight:"}]},{"type":"codeListing","syntax":"swift","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On success, the resulting snapshot flows through "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" and updates the gate. On failure, "},{"type":"codeVoice","code":"store.paywall.error"},{"type":"text","text":" is set."}]},{"text":"Step 9: Manage subscriptions","type":"heading","level":2,"anchor":"Step-9-Manage-subscriptions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:"}]},{"type":"codeListing","syntax":"swift","code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" via the plugin’s "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler, which routes to the App Store on iOS and Settings on macOS."}]},{"text":"Testing","type":"heading","level":2,"anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" to drive previews and tests into a known entitlement state:"}]},{"type":"codeListing","syntax":"swift","code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plumb the service through a parameter on your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory so previews can override it without touching the live RevenueCat SDK."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"sections":[],"hiera