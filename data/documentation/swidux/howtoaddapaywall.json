{"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article","title":"Add a Paywall"},"sections":[],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":", presenting the sheet, gating a feature, and previewing in pro state."}],"type":"paragraph"},{"inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"reference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Before you start","type":"heading","anchor":"Before-you-start","level":2},{"inlineContent":[{"type":"text","text":"This guide assumes:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and "},{"code":"AppStore","type":"codeVoice"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"type":"text","text":" first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care."}]}]}],"type":"unorderedList"},{"text":"Step 1: Add the dependency","type":"heading","anchor":"Step-1-Add-the-dependency","level":2},{"inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" product to your app target in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"],"type":"codeListing"},{"text":"Step 2: Add state and actions","type":"heading","anchor":"Step-2-Add-state-and-actions","level":2},{"inlineContent":[{"type":"text","text":"Add a paywall slice to "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":" with "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":", and a paywall case to "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"],"type":"codeListing"},{"syntax":"swift","code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"],"type":"codeListing"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"import SwiduxPaywall"},{"text":" is needed in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"text":" file that touches ","type":"text"},{"type":"codeVoice","code":"store.paywall.*"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"PaywallAction"},{"text":" — including views that read the slice for display. ","type":"text"},{"type":"codeVoice","code":"@_exported import Swidux"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","style":"tip","name":"Tip"},{"inlineContent":[{"text":"The plugin owns reducing for ","type":"text"},{"type":"codeVoice","code":".paywall"},{"text":" actions, so the root reducer should fall through:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ AppReducer.swift","case .paywall:","    return nil"],"type":"codeListing"},{"text":"Step 3: Provide a `PaywallService`","type":"heading","anchor":"Step-3-Provide-a-PaywallService","level":2},{"inlineContent":[{"type":"text","text":"The plugin needs a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that talks to your purchase backend. Pick the path that matches your backend."}],"type":"paragraph"},{"level":3,"anchor":"Path-A-RevenueCat-recommended","type":"heading","text":"Path A: RevenueCat (recommended)"},{"inlineContent":[{"type":"text","text":"Add the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},{"type":"text","text":" companion package and use the supplied "},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":". No bridging code on your side."}],"type":"paragraph"},{"syntax":"swift","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"],"type":"codeListing"},{"syntax":"swift","code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService(entitlementID: \"pro\")"],"type":"codeListing"},{"inlineContent":[{"code":"entitlementID","type":"codeVoice"},{"type":"text","text":" is the RevenueCat entitlement identifier that grants pro; pass "},{"code":"permanentLicenseEntitlementID:","type":"codeVoice"},{"type":"text","text":" too if you sell a lifetime unlock. The companion package also ships "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":", a SwiftUI sheet built on RevenueCatUI. The sheet only dispatches presentation actions ("},{"code":".dismiss","type":"codeVoice"},{"type":"text","text":", "},{"code":".dismissCustomerCenter","type":"codeVoice"},{"type":"text","text":"); a completed purchase reaches the plugin through "},{"code":"customerInfoStream()","type":"codeVoice"},{"type":"text","text":", which is why you start "},{"code":".observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" in Step 5. See its "},{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/"},{"type":"text","text":" for configuration (API key, entitlement identifiers)."}],"type":"paragraph"},{"text":"Path B: StoreKit or custom backend","type":"heading","level":3,"anchor":"Path-B-StoreKit-or-custom-backend"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For any non-RevenueCat backend, implement "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" directly. The protocol is small:"}]},{"type":"codeListing","code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vanilla StoreKit conformer iterates "},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"type":"text","text":" and listens to "},{"code":"Transaction.updates","type":"codeVoice"},{"type":"text","text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement."}]},{"text":"Previews and tests","type":"heading","level":3,"anchor":"Previews-and-tests"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the built-in "},{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" for backend-agnostic previews:"}]},{"type":"codeListing","code":["let service = MockPaywallService(isPro: true)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" also ships "},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" for RevenueCat-flavored previews."}]},{"text":"Step 4: Wire the plugin","type":"heading","level":2,"anchor":"Step-4-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct and register "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":" inside your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory:"}]},{"type":"codeListing","code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService(entitlementID: \"pro\")",")","plugins.register(paywallPlugin)"],"syntax":"swift"},{"style":"tip","type":"aside","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In production, wrap the service in "},{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":" so a transient entitlement-read failure at cold launch never gates a paid user as free. Back its cache with "},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" (not "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":", whose plist a user can edit to spoof entitlements):"}]},{"code":["service: ResilientPaywallService(","    base: RevenueCatPaywallService(entitlementID: \"pro\"),","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cache is not scoped to an account: if your app signs users in and out, call "},{"code":"clearCache()","type":"codeVoice"},{"type":"text","text":" on the resilient service at sign-out and account switch. See the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" reference ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},{"type":"text","text":") for the staleness policy, threat model, and sign-out sequence."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your app can launch in the background before the first unlock after a restart, the keychain can’t be read yet, and "},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for the cached entitlement just as it does when nothing is cached. "},{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":" then treats the cache as empty. The entitlement stream yields no cached seed, so "},{"code":"store.paywall","type":"codeVoice"},{"type":"text","text":" stays free until some snapshot arrives, and a refresh whose live reads all fail sets "},{"code":"store.paywall.error","type":"codeVoice"},{"type":"text","text":" instead of returning the cached entitlement. The miss doesn’t erase anything, because the service writes the cache only when a live snapshot arrives or "},{"code":"clearCache()","type":"codeVoice"},{"type":"text","text":" runs. The service also doesn’t watch for the keychain becoming readable, so dispatch "},{"code":".refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":" when a scene becomes active. Step 5 below builds the root view; add the scene-phase property and modifier to it:"}]},{"type":"codeListing","code":["\/\/ A property on the root view:","@Environment(\\.scenePhase) private var scenePhase","","\/\/ A modifier on the view its body returns:",".onChange(of: scenePhase) { _, phase in","    if phase == .active { store.send(.paywall(.refreshCustomerInfo)) }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once the keychain is readable, a refresh whose live reads all fail returns the cached entitlement if it is within "},{"code":"maxCacheAge","type":"codeVoice"},{"type":"text","text":" (a permanent license is kept past it). On success, the refresh’s snapshot sets "},{"code":"store.paywall.isPro","type":"codeVoice"},{"type":"text","text":" and "},{"code":"hasPermanentLicense","type":"codeVoice"},{"type":"text","text":" from its own values, so "},{"code":"isGateSatisfied","type":"codeVoice"},{"type":"text","text":" is "},{"code":"false","type":"codeVoice"},{"type":"text","text":" for a user with no entitlement. If the refresh gets neither a live snapshot nor a usable cache, "},{"code":"store.paywall.error","type":"codeVoice"},{"type":"text","text":" is set, and "},{"code":"isPro","type":"codeVoice"},{"type":"text","text":" and "},{"code":"hasPermanentLicense","type":"codeVoice"},{"type":"text","text":" stay as they were. See “Failure Modes” in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"},{"type":"text","text":" for how "},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" reports a locked keychain on writes and on "},{"code":"deviceIdentity(key:)","type":"codeVoice"},{"type":"text","text":"."}]},{"text":"Step 5: Observe customer info on launch","type":"heading","level":2,"anchor":"Step-5-Observe-customer-info-on-launch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start the long-lived entitlement stream once, on the root view:"}]},{"type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" returns an effect that lives for the duration of "},{"code":"PaywallService.customerInfoStream()","type":"codeVoice"},{"type":"text","text":". Every snapshot the service yields flows through "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" and updates "},{"code":"store.paywall.isPro","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"hasPermanentLicense","type":"codeVoice"},{"type":"text","text":"."}]},{"text":"Step 6: Present the paywall","type":"heading","level":2,"anchor":"Step-6-Present-the-paywall"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bind a sheet to "},{"code":"store.paywall.isPresented","type":"codeVoice"},{"type":"text","text":" and dispatch "},{"code":".paywall(.dismiss)","type":"codeVoice"},{"type":"text","text":" when it closes:"}]},{"type":"codeListing","code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you are still on "},{"code":"SimulatedPaywallService","type":"codeVoice"},{"type":"text","text":" with the "},{"code":"SwiduxDevPaywallUI","type":"codeVoice"},{"type":"text","text":" sheet, the "},{"code":".devPaywall(state:service:onAction:)","type":"codeVoice"},{"type":"text","text":" call is replaced, not kept, when you adopt RevenueCat. See “Moving to a real provider” in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},{"type":"text","text":" for the exact change."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Trigger presentation by dispatching "},{"code":".paywall(.request(reason:))","type":"codeVoice"},{"type":"text","text":" with a short identifier describing why you’re asking. The reason is stored in "},{"code":"store.paywall.requestedReason","type":"codeVoice"},{"type":"text","text":" so the sheet can tailor its copy."}]},{"type":"codeListing","code":["store.send(.paywall(.request(reason: \"export-pdf\")))"],"syntax":"swift"},{"text":"Step 7: Gate a feature","type":"heading","level":2,"anchor":"Step-7-Gate-a-feature"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"code":"PaywallState.isGateSatisfied","type":"codeVoice"},{"type":"text","text":" before running gated work. If it’s "},{"code":"false","type":"codeVoice"},{"type":"text","text":", dispatch "},{"code":".request","type":"codeVoice"},{"type":"text","text":" instead:"}]},{"type":"codeListing","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"syntax":"swift"},{"text":"Step 8: Restore purchases","type":"heading","level":2,"anchor":"Step-8-Restore-purchases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a restore button to your paywall sheet. Reflect "},{"code":"store.paywall.isLoading","type":"codeVoice"},{"type":"text","text":" to disable it while the call is in flight:"}]},{"type":"codeListing","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On success, the resulting snapshot flows through "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" and updates the gate. On failure, "},{"code":"store.paywall.error","type":"codeVoice"},{"type":"text","text":" is set. Either outcome lands even if the user closes the sheet while the restore is still running: the refresh that "},{"code":".dismiss","type":"codeVoice"},{"type":"text","text":" dispatches cannot supersede a restore. Only a live stream update that arrives mid-restore outranks the restore’s snapshot, because the provider’s feed is at least as new. "},{"code":"isLoading","type":"codeVoice"},{"type":"text","text":" stays "},{"code":"true","type":"codeVoice"},{"type":"text","text":" until the restore finishes or a newer snapshot lands, so a restore the provider never completes cannot hold the spinner once a refresh succeeds."}]},{"text":"Step 9: Manage subscriptions","type":"heading","level":2,"anchor":"Step-9-Manage-subscriptions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:"}]},{"type":"codeListing","code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This opens "},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"type":"text","text":" via the plugin’s "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" handler, which routes to the App Store on iOS and Settings on macOS."}]},{"text":"Testing","type":"heading","level":2,"anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" to drive previews and tests into a known entitlement state:"}]},{"type":"codeListing","code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plumb the service through a parameter on your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory so previews can override it without touching the live RevenueCat SDK."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swidux\/howtoaddapaywall"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"title":"How-to Guides","generated":true,"anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HostingRemoteConfig","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},"kind":"article","references":{"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"type":"topic","role":"article","title":"SwiduxPaywall Reference","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"kind":"article","url":"\/documentation\/swidux\/pluginpaywallreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"title":"Add a Version Killswitch","kind":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that covers the UI of unsupported app versions, with an “Update” path back to the App Store."}],"role":"article","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","type":"topic"},"doc://Swidux/documentation/Swidux/SecurityPosture":{"type":"topic","url":"\/documentation\/swidux\/securityposture","abstract":[{"text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one.","type":"text"}],"title":"Security Posture","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","role":"collectionGroup"},"doc://Swidux/documentation/Swidux/GettingStarted":{"title":"Getting Started with Swidux","kind":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"role":"article","url":"\/documentation\/swidux\/gettingstarted","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"title":"Add Persistence","kind":"article","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"role":"article","url":"\/documentation\/swidux\/howtoaddpersistence","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"title":"Add iCloud Sync","kind":"article","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"role":"article","url":"\/documentation\/swidux\/howtoaddicloudsync","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"topic"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"title":"Plugin Architecture","kind":"article","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"role":"article","url":"\/documentation\/swidux\/pluginarchitecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic"},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","title":"SwiduxRevenueCatPaywall","url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","titleInlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"}],"type":"link"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"title":"Cancel Effects","kind":"article","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"role":"article","url":"\/documentation\/swidux\/howtocanceleffects","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","type":"topic"},"doc://Swidux/documentation/Swidux/HostingRemoteConfig":{"title":"Host Remote Config","kind":"article","abstract":[{"type":"text","text":"Build the endpoint that serves killswitch and feature-flag config, so that it fails safe, can’t be cheaply exhausted, and passes a conformance checklist."}],"role":"article","url":"\/documentation\/swidux\/hostingremoteconfig","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HostingRemoteConfig","type":"topic"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"type":"topic","role":"collectionGroup","title":"KeyValueStore","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"kind":"article","url":"\/documentation\/swidux\/keyvaluestoreguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"},"doc://Swidux/documentation/Swidux":{"title":"Swidux","kind":"symbol","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"role":"collection","url":"\/documentation\/swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","type":"topic"},"https://heirloomlogic.github.io/SwiduxRevenueCatPaywall/documentation/swiduxrevenuecatpaywall/":{"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","title":"DocC reference","url":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","titleInlineContent":[{"te