{"variants":[{"paths":["\/documentation\/swidux\/howtoaddapaywall"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":", presenting the sheet, gating a feature, and previewing in pro state."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For an API-level reference of every type and action, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","isActive":true},{"type":"text","text":". For where domain plugins fit in the dispatch cycle, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Before you start","anchor":"Before-you-start","type":"heading"},{"inlineContent":[{"type":"text","text":"This guide assumes:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"You have a Swidux app already wired up — ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"text":" first.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care."}]}]}],"type":"unorderedList"},{"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency","level":2,"type":"heading"},{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" product to your app target in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"],"type":"codeListing"},{"text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions","level":2,"type":"heading"},{"inlineContent":[{"text":"Add a paywall slice to ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":", and a paywall case to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"],"type":"codeListing"},{"syntax":"swift","type":"codeListing","code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"]},{"style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxPaywall"},{"type":"text","text":" is needed in "},{"inlineContent":[{"type":"text","text":"every"}],"type":"emphasis"},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.paywall.*"},{"type":"text","text":" or "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":" — including views that read the slice for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"type":"text","text":"."}]}],"type":"aside","name":"Tip"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"type":"codeVoice","code":".paywall"},{"type":"text","text":" actions, so the root reducer should fall through:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppReducer.swift","case .paywall:","    return nil"]},{"anchor":"Step-3-Provide-a-PaywallService","text":"Step 3: Provide a `PaywallService`","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin needs a "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that talks to your purchase backend. Pick the path that matches your backend."}]},{"anchor":"Path-A-RevenueCat-recommended","text":"Path A: RevenueCat (recommended)","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"reference","isActive":true},{"type":"text","text":" companion package and use the supplied "},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":". No bridging code on your side."}]},{"syntax":"swift","type":"codeListing","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"]},{"syntax":"swift","type":"codeListing","code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService()"]},{"inlineContent":[{"type":"text","text":"The companion package also ships "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":", a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin. See its README for configuration (API key, entitlement identifiers)."}],"type":"paragraph"},{"level":3,"anchor":"Path-B-StoreKit-or-custom-backend","text":"Path B: StoreKit or custom backend","type":"heading"},{"inlineContent":[{"type":"text","text":"For any non-RevenueCat backend, implement "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" directly. The protocol is small:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"A vanilla StoreKit conformer iterates ","type":"text"},{"type":"codeVoice","code":"Transaction.currentEntitlements"},{"type":"text","text":" and listens to "},{"type":"codeVoice","code":"Transaction.updates"},{"type":"text","text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement."}],"type":"paragraph"},{"anchor":"Previews-and-tests","type":"heading","level":3,"text":"Previews and tests"},{"inlineContent":[{"text":"Use the built-in ","type":"text"},{"code":"MockPaywallService","type":"codeVoice"},{"text":" for backend-agnostic previews:","type":"text"}],"type":"paragraph"},{"code":["let service = MockPaywallService(isPro: true)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"text":" also ships ","type":"text"},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" for RevenueCat-flavored previews."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Step 4: Wire the plugin","anchor":"Step-4-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct and register "},{"type":"codeVoice","code":"PaywallPlugin"},{"type":"text","text":" inside your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory:"}]},{"syntax":"swift","type":"codeListing","code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService()",")","plugins.register(paywallPlugin)"]},{"type":"heading","level":2,"text":"Step 5: Observe customer info on launch","anchor":"Step-5-Observe-customer-info-on-launch"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start the long-lived entitlement stream once, on the root view:"}]},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"observeCustomerInfo","type":"codeVoice"},{"type":"text","text":" returns an effect that lives for the duration of "},{"code":"PaywallService.customerInfoStream()","type":"codeVoice"},{"type":"text","text":". Every snapshot the service yields flows through "},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" and updates ","type":"text"},{"type":"codeVoice","code":"store.paywall.isPro"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":"."}]},{"type":"heading","text":"Step 6: Present the paywall","level":2,"anchor":"Step-6-Present-the-paywall"},{"type":"paragraph","inlineContent":[{"text":"Bind a sheet to ","type":"text"},{"code":"store.paywall.isPresented","type":"codeVoice"},{"text":" and dispatch ","type":"text"},{"code":".paywall(.dismiss)","type":"codeVoice"},{"text":" when it closes:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"]},{"type":"paragraph","inlineContent":[{"text":"Trigger presentation by dispatching ","type":"text"},{"type":"codeVoice","code":".paywall(.request(reason:))"},{"text":" with a short identifier describing why you’re asking. The reason is stored in ","type":"text"},{"type":"codeVoice","code":"store.paywall.requestedReason"},{"text":" so the sheet can tailor its copy.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["store.send(.paywall(.request(reason: \"export-pdf\")))"]},{"anchor":"Step-7-Gate-a-feature","text":"Step 7: Gate a feature","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"type":"codeVoice","code":"PaywallState.isGateSatisfied"},{"text":" before running gated work. If it’s ","type":"text"},{"type":"codeVoice","code":"false"},{"text":", dispatch ","type":"text"},{"type":"codeVoice","code":".request"},{"text":" instead:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"]},{"anchor":"Step-8-Restore-purchases","text":"Step 8: Restore purchases","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Add a restore button to your paywall sheet. Reflect ","type":"text"},{"code":"store.paywall.isLoading","type":"codeVoice"},{"text":" to disable it while the call is in flight:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On success, the resulting snapshot flows through "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" and updates the gate. On failure, "},{"type":"codeVoice","code":"store.paywall.error"},{"type":"text","text":" is set."}]},{"anchor":"Step-9-Manage-subscriptions","text":"Step 9: Manage subscriptions","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:"}]},{"type":"codeListing","code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This opens ","type":"text"},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"type":"text","text":" via the plugin’s "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" handler, which routes to the App Store on iOS and Settings on macOS."}]},{"anchor":"Testing","type":"heading","text":"Testing","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" to drive previews and tests into a known entitlement state:"}]},{"type":"codeListing","syntax":"swift","code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plumb the service through a parameter on your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory so previews can override it without touching the live RevenueCat SDK."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides","title":"How-to Guides","generated":true}],"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"kind":"article","metadata":{"role":"article","title":"Add a Paywall","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"references":{"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","title":"Add a Parental Gate","url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","url":"\/documentation\/swidux","role":"collection","type":"topic","title":"Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","title":"Plugin Architecture","role":"article","url":"\/documentation\/swidux\/pluginarchitecture","type":"topic"},"doc://Swidux/documentation/Swidux/GettingStarted":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","kind":"article","url":"\/documentation\/swidux\/gettingstarted","role":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"title":"Getting Started with Swidux","type":"topic"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","title":"Building a Domain Plugin","role":"article","url":"\/documentation\/swidux\/buildingadomainplugin","type":"topic"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"type":"topic","kind":"article","title":"SwiduxPaywall Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","url":"\/documentation\/swidux\/pluginpaywallreference","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","title":"Using the Swidux Agent Skill","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"role":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"title":"Add Feature Flags","type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","title":"Add a Version Killswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"role":"article","type":"topic","kind":"article"},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","title":"SwiduxRevenueCatPaywall","titleInlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"}],"url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"link"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","kind":"article","url":"\/documentation\/swidux\/howtoaddanalytics","role":"article","type":"topic","title":"Add Analytics","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify.","type":"text"}]}}}