{"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"Add a Paywall"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":", presenting the sheet, gating a feature, and previewing in pro state.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","isActive":true,"type":"reference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"anchor":"Before-you-start","type":"heading","level":2,"text":"Before you start"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and "},{"type":"codeVoice","code":"AppStore"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"type":"text","text":" first."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Step-1-Add-the-dependency","type":"heading","level":2,"text":"Step 1: Add the dependency"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" product to your app target in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":":","type":"text"}]},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-2-Add-state-and-actions","type":"heading","level":2,"text":"Step 2: Add state and actions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a paywall slice to "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" with "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":", and a paywall case to "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"]},{"syntax":"swift","code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"code":".paywall","type":"codeVoice"},{"type":"text","text":" actions, so the root reducer should fall through:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ AppReducer.swift","case .paywall:","    return nil"],"type":"codeListing"},{"text":"Step 3: Provide a `PaywallService`","level":2,"anchor":"Step-3-Provide-a-PaywallService","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The plugin needs a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that talks to your purchase backend. Pick the path that matches your backend.","type":"text"}]},{"anchor":"Path-A-RevenueCat-recommended","type":"heading","level":3,"text":"Path A: RevenueCat (recommended)"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","isActive":true,"type":"reference"},{"text":" companion package and use the supplied ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":". No bridging code on your side.","type":"text"}]},{"code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"],"type":"codeListing","syntax":"swift"},{"code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The companion package also ships ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":", a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin. See its README for configuration (API key, entitlement identifiers).","type":"text"}]},{"anchor":"Path-B-StoreKit-or-custom-backend","type":"heading","level":3,"text":"Path B: StoreKit or custom backend"},{"type":"paragraph","inlineContent":[{"text":"For any non-RevenueCat backend, implement ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" directly. The protocol is small:","type":"text"}]},{"code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"A vanilla StoreKit conformer iterates ","type":"text"},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"text":" and listens to ","type":"text"},{"code":"Transaction.updates","type":"codeVoice"},{"text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement.","type":"text"}]},{"anchor":"Previews-and-tests","type":"heading","level":3,"text":"Previews and tests"},{"type":"paragraph","inlineContent":[{"text":"Use the built-in ","type":"text"},{"code":"MockPaywallService","type":"codeVoice"},{"text":" for backend-agnostic previews:","type":"text"}]},{"code":["let service = MockPaywallService(isPro: true)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"If you’re on Path A, ","type":"text"},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"text":" also ships ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" for RevenueCat-flavored previews.","type":"text"}]},{"anchor":"Step-4-Wire-the-plugin","type":"heading","level":2,"text":"Step 4: Wire the plugin"},{"type":"paragraph","inlineContent":[{"text":"Construct and register ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":" inside your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory:","type":"text"}]},{"code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService()",")","plugins.register(paywallPlugin)"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-5-Observe-customer-info-on-launch","type":"heading","level":2,"text":"Step 5: Observe customer info on launch"},{"type":"paragraph","inlineContent":[{"text":"Start the long-lived entitlement stream once, on the root view:","type":"text"}]},{"code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"observeCustomerInfo","type":"codeVoice"},{"text":" returns an effect that lives for the duration of ","type":"text"},{"code":"PaywallService.customerInfoStream()","type":"codeVoice"},{"text":". Every snapshot the service yields flows through ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" and updates ","type":"text"},{"code":"store.paywall.isPro","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":".","type":"text"}]},{"anchor":"Step-6-Present-the-paywall","type":"heading","level":2,"text":"Step 6: Present the paywall"},{"type":"paragraph","inlineContent":[{"text":"Bind a sheet to ","type":"text"},{"code":"store.paywall.isPresented","type":"codeVoice"},{"text":" and dispatch ","type":"text"},{"code":".paywall(.dismiss)","type":"codeVoice"},{"text":" when it closes:","type":"text"}]},{"code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Trigger presentation by dispatching ","type":"text"},{"code":".paywall(.request(reason:))","type":"codeVoice"},{"text":" with a short identifier describing why you’re asking. The reason is stored in ","type":"text"},{"code":"store.paywall.requestedReason","type":"codeVoice"},{"text":" so the sheet can tailor its copy.","type":"text"}]},{"code":["store.send(.paywall(.request(reason: \"export-pdf\")))"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-7-Gate-a-feature","type":"heading","level":2,"text":"Step 7: Gate a feature"},{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"code":"PaywallState.isGateSatisfied","type":"codeVoice"},{"text":" before running gated work. If it’s ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", dispatch ","type":"text"},{"code":".request","type":"codeVoice"},{"text":" instead:","type":"text"}]},{"code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-8-Restore-purchases","type":"heading","level":2,"text":"Step 8: Restore purchases"},{"type":"paragraph","inlineContent":[{"text":"Add a restore button to your paywall sheet. Reflect ","type":"text"},{"code":"store.paywall.isLoading","type":"codeVoice"},{"text":" to disable it while the call is in flight:","type":"text"}]},{"code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"On success, the resulting snapshot flows through ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" and updates the gate. On failure, ","type":"text"},{"code":"store.paywall.error","type":"codeVoice"},{"text":" is set.","type":"text"}]},{"anchor":"Step-9-Manage-subscriptions","type":"heading","level":2,"text":"Step 9: Manage subscriptions"},{"type":"paragraph","inlineContent":[{"text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:","type":"text"}]},{"code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This opens ","type":"text"},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"text":" via the plugin’s ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" handler, which routes to the App Store on iOS and Settings on macOS.","type":"text"}]},{"anchor":"Testing","type":"heading","level":2,"text":"Testing"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"MockPaywallService","type":"codeVoice"},{"text":" to drive previews and tests into a known entitlement state:","type":"text"}]},{"code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Plumb the service through a parameter on your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory so previews can override it without touching the live RevenueCat SDK.","type":"text"}]}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/B