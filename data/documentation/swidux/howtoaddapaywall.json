ticle","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","role":"article","kind":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"title":"Add a Parental Gate"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","role":"article","kind":"article","url":"\/documentation\/swidux\/howtocanceleffects","abstract":[{"text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code.","type":"text"}],"title":"Cancel Effects"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","role":"article","kind":"article","url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"title":"Building a Domain Plugin"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","role":"article","kind":"article","url":"\/documentation\/swidux\/howtoaddicloudsync","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" with the ","type":"text"},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"title":"Add iCloud Sync"},"https://heirloomlogic.github.io/SwiduxRevenueCatPaywall/documentation/swiduxrevenuecatpaywall/":{"url":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","title":"DocC reference","type":"link","titleInlineContent":[{"text":"DocC reference","type":"text"}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"url":"\/documentation\/swidux\/gettingstarted","role":"article","title":"Getting Started with Swidux","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","role":"article","kind":"article","url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"title":"Plugin Architecture"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","title":"Add a Version Killswitch","role":"article","url":"\/documentation\/swidux\/howtoaddaversionkillswitch"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","role":"article","kind":"article","url":"\/documentation\/swidux\/pluginpaywallreference","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"title":"SwiduxPaywall Reference"}}}