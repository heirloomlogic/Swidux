{"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":", presenting the sheet, gating a feature, and previewing in pro state.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"reference","isActive":true},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Before you start","anchor":"Before-you-start"},{"inlineContent":[{"text":"This guide assumes:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"You have a Swidux app already wired up — ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"AppStore","type":"codeVoice"},{"text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true},{"text":" first.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care.","type":"text"}],"type":"paragraph"}]}]},{"level":2,"type":"heading","text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" product to your app target in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"]},{"level":2,"type":"heading","text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions"},{"inlineContent":[{"text":"Add a paywall slice to ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" with ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":", and a paywall case to ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"]},{"inlineContent":[{"text":"The plugin owns reducing for ","type":"text"},{"type":"codeVoice","code":".paywall"},{"text":" actions, so the root reducer should fall through:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ AppReducer.swift","case .paywall:","    return nil"]},{"level":2,"type":"heading","text":"Step 3: Provide a `PaywallService`","anchor":"Step-3-Provide-a-PaywallService"},{"inlineContent":[{"text":"The plugin needs a ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" conformer that talks to your purchase backend. Pick the path that matches your backend.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Path A: RevenueCat (recommended)","anchor":"Path-A-RevenueCat-recommended"},{"inlineContent":[{"text":"Add the ","type":"text"},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"reference","isActive":true},{"text":" companion package and use the supplied ","type":"text"},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"text":". No bridging code on your side.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"]},{"syntax":"swift","type":"codeListing","code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService()"]},{"inlineContent":[{"text":"The companion package also ships ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":", a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin. See its README for configuration (API key, entitlement identifiers).","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Path B: StoreKit or custom backend","anchor":"Path-B-StoreKit-or-custom-backend"},{"inlineContent":[{"text":"For any non-RevenueCat backend, implement ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" directly. The protocol is small:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"]},{"inlineContent":[{"text":"A vanilla StoreKit conformer iterates ","type":"text"},{"type":"codeVoice","code":"Transaction.currentEntitlements"},{"text":" and listens to ","type":"text"},{"type":"codeVoice","code":"Transaction.updates"},{"text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"Previews and tests","anchor":"Previews-and-tests"},{"inlineContent":[{"text":"Use the built-in ","type":"text"},{"type":"codeVoice","code":"MockPaywallService"},{"text":" for backend-agnostic previews:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let service = MockPaywallService(isPro: true)"]},{"inlineContent":[{"text":"If you’re on Path A, ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"},{"text":" also ships ","type":"text"},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"text":" for RevenueCat-flavored previews.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 4: Wire the plugin","anchor":"Step-4-Wire-the-plugin"},{"inlineContent":[{"text":"Construct and register ","type":"text"},{"type":"codeVoice","code":"PaywallPlugin"},{"text":" inside your ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService()",")","plugins.register(paywallPlugin)"]},{"level":2,"type":"heading","text":"Step 5: Observe customer info on launch","anchor":"Step-5-Observe-customer-info-on-launch"},{"inlineContent":[{"text":"Start the long-lived entitlement stream once, on the root view:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"]},{"inlineContent":[{"code":"observeCustomerInfo","type":"codeVoice"},{"text":" returns an effect that lives for the duration of ","type":"text"},{"code":"PaywallService.customerInfoStream()","type":"codeVoice"},{"text":". Every snapshot the service yields flows through ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" and updates ","type":"text"},{"code":"store.paywall.isPro","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 6: Present the paywall","anchor":"Step-6-Present-the-paywall"},{"inlineContent":[{"text":"Bind a sheet to ","type":"text"},{"code":"store.paywall.isPresented","type":"codeVoice"},{"text":" and dispatch ","type":"text"},{"code":".paywall(.dismiss)","type":"codeVoice"},{"text":" when it closes:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"]},{"inlineContent":[{"text":"Trigger presentation by dispatching ","type":"text"},{"code":".paywall(.request(reason:))","type":"codeVoice"},{"text":" with a short identifier describing why you’re asking. The reason is stored in ","type":"text"},{"code":"store.paywall.requestedReason","type":"codeVoice"},{"text":" so the sheet can tailor its copy.","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["store.send(.paywall(.request(reason: \"export-pdf\")))"]},{"level":2,"type":"heading","text":"Step 7: Gate a feature","anchor":"Step-7-Gate-a-feature"},{"inlineContent":[{"text":"Read ","type":"text"},{"code":"PaywallState.isGateSatisfied","type":"codeVoice"},{"text":" before running gated work. If it’s ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", dispatch ","type":"text"},{"code":".request","type":"codeVoice"},{"text":" instead:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"]},{"level":2,"type":"heading","text":"Step 8: Restore purchases","anchor":"Step-8-Restore-purchases"},{"inlineContent":[{"text":"Add a restore button to your paywall sheet. Reflect ","type":"text"},{"code":"store.paywall.isLoading","type":"codeVoice"},{"text":" to disable it while the call is in flight:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"]},{"inlineContent":[{"text":"On success, the resulting snapshot flows through ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" and updates the gate. On failure, ","type":"text"},{"code":"store.paywall.error","type":"codeVoice"},{"text":" is set.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 9: Manage subscriptions","anchor":"Step-9-Manage-subscriptions"},{"inlineContent":[{"text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"]},{"inlineContent":[{"text":"This opens ","type":"text"},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"text":" via the plugin’s ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" handler, which routes to the App Store on iOS and Settings on macOS.","type":"text"}],"type":"paragraph"},{"text":"Testing","level":2,"anchor":"Testing","type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"MockPaywallService","type":"codeVoice"},{"text":" to drive previews and tests into a known entitlement state:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"],"type":"codeListing"},{"inlineContent":[{"text":"Plumb the service through a parameter on your ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory so previews can override it without touching the live RevenueCat SDK.","type":"text"}],"type":"paragraph"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides","generated":true,"anchor":"How-to-Guides"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"title":"Add a Paywall","roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}]},"kind":"article","variants":[{"paths":["\/documentation\/swidux\/howtoaddapaywall"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"references":{"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","url":"\/documentation\/swidux\/pluginarchitecture","title":"Plugin Architecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic","kind":"article","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","url":"\/documentation\/swidux\/gettingstarted","title":"Getting Started with Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","kind":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}]},"doc://Swidux/documentation/Swidux":{"role":"collection","url":"\/documentation\/swidux","title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","type":"topic","kind":"symbol","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","role":"article","title":"Add a Parental Gate","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}]},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"role":"article","url":"\/documentation\/swidux\/buildingadomainplugin","title":"Building a Domain Plugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","type":"topic","kind":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}]},"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","kind":"article","role":"article","title":"Using the Swidux Agent Skill","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}]},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"titleInlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}],"type":"link","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","title":"SwiduxRevenueCatPaywall","url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","url":"\/documentation\/swidux\/pluginpaywallreference","role":"article","kind":"article","title":"SwiduxPaywall Reference","type":"topic","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}]},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","kind":"article","role":"article","title":"Add a Version Killswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}]},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"url":"\/documentation\/swidux\/howtoaddfeatureflags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","role":"article","kind":"article","title":"Add Feature Flags","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}]},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","url":"\/documentation\/swidux\/howtoaddanalytics","kind":"article","role":"article","title":"Add Analytics","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}]}}}