{"kind":"article","metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"Add a Paywall","role":"article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"generated":true,"title":"How-to Guides","anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":", presenting the sheet, gating a feature, and previewing in pro state.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For an API-level reference of every type and action, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"reference"},{"text":". For where domain plugins fit in the dispatch cycle, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Before-you-start","level":2,"text":"Before you start","type":"heading"},{"inlineContent":[{"type":"text","text":"This guide assumes:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and "},{"code":"AppStore","type":"codeVoice"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","isActive":true,"type":"reference"},{"type":"text","text":" first."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Step-1-Add-the-dependency","level":2,"text":"Step 1: Add the dependency","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" product to your app target in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Step-2-Add-state-and-actions","level":2,"text":"Step 2: Add state and actions","type":"heading"},{"inlineContent":[{"text":"Add a paywall slice to ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":", and a paywall case to ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"],"type":"codeListing"},{"syntax":"swift","code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"],"type":"codeListing"},{"style":"tip","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"import SwiduxPaywall","type":"codeVoice"},{"text":" is needed in ","type":"text"},{"inlineContent":[{"type":"text","text":"every"}],"type":"emphasis"},{"text":" file that touches ","type":"text"},{"code":"store.paywall.*","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"text":" — including views that read the slice for display. ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Tip"},{"inlineContent":[{"text":"The plugin owns reducing for ","type":"text"},{"code":".paywall","type":"codeVoice"},{"text":" actions, so the root reducer should fall through:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ AppReducer.swift","case .paywall:","    return nil"],"type":"codeListing"},{"anchor":"Step-3-Provide-a-PaywallService","level":2,"type":"heading","text":"Step 3: Provide a `PaywallService`"},{"inlineContent":[{"text":"The plugin needs a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that talks to your purchase backend. Pick the path that matches your backend.","type":"text"}],"type":"paragraph"},{"anchor":"Path-A-RevenueCat-recommended","level":3,"type":"heading","text":"Path A: RevenueCat (recommended)"},{"inlineContent":[{"text":"Add the ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"reference"},{"text":" companion package and use the supplied ","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":". No bridging code on your side.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"],"type":"codeListing"},{"syntax":"swift","code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService(entitlementID: \"pro\")"],"type":"codeListing"},{"inlineContent":[{"code":"entitlementID","type":"codeVoice"},{"text":" is the RevenueCat entitlement identifier that grants pro; pass ","type":"text"},{"code":"permanentLicenseEntitlementID:","type":"codeVoice"},{"text":" too if you sell a lifetime unlock. The companion package also ships ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":", a SwiftUI sheet built on RevenueCatUI. The sheet only dispatches presentation actions (","type":"text"},{"code":".dismiss","type":"codeVoice"},{"text":", ","type":"text"},{"code":".dismissCustomerCenter","type":"codeVoice"},{"text":"); a completed purchase reaches the plugin through ","type":"text"},{"code":"customerInfoStream()","type":"codeVoice"},{"text":", which is why you start ","type":"text"},{"code":".observeCustomerInfo","type":"codeVoice"},{"text":" in Step 5. See its ","type":"text"},{"isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","type":"reference"},{"text":" for configuration (API key, entitlement identifiers).","type":"text"}],"type":"paragraph"},{"anchor":"Path-B-StoreKit-or-custom-backend","level":3,"type":"heading","text":"Path B: StoreKit or custom backend"},{"inlineContent":[{"text":"For any non-RevenueCat backend, implement ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" directly. The protocol is small:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"A vanilla StoreKit conformer iterates ","type":"text"},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"text":" and listens to ","type":"text"},{"code":"Transaction.updates","type":"codeVoice"},{"text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement.","type":"text"}],"type":"paragraph"},{"anchor":"Previews-and-tests","level":3,"type":"heading","text":"Previews and tests"},{"inlineContent":[{"type":"text","text":"Use the built-in "},{"code":"MockPaywallService","type":"codeVoice"},{"text":" for backend-agnostic previews:","type":"text"}],"type":"paragraph"},{"code":["let service = MockPaywallService(isPro: true)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" also ships "},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" for RevenueCat-flavored previews."}],"type":"paragraph"},{"level":2,"text":"Step 4: Wire the plugin","anchor":"Step-4-Wire-the-plugin","type":"heading"},{"inlineContent":[{"text":"Construct and register ","type":"text"},{"code":"PaywallPlugin","type":"codeVoice"},{"text":" inside your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService(entitlementID: \"pro\")",")","plugins.register(paywallPlugin)"],"type":"codeListing"},{"style":"tip","name":"Tip","content":[{"inlineContent":[{"type":"text","text":"In production, wrap the service in "},{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":" so a transient entitlement-read failure at cold launch never gates a paid user as free. Back its cache with "},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" (not "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":", whose plist a user can edit to spoof entitlements):"}],"type":"paragraph"},{"code":["service: ResilientPaywallService(","    base: RevenueCatPaywallService(entitlementID: \"pro\"),","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The cache is not scoped to an account: if your app signs users in and out, call "},{"code":"clearCache()","type":"codeVoice"},{"type":"text","text":" on the resilient service at sign-out and account switch. See the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" reference ("},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"reference"},{"type":"text","text":") for the staleness policy, threat model, and sign-out sequence."}],"type":"paragraph"}],"type":"aside"},{"inlineContent":[{"type":"text","text":"If your app can launch in the background before the first unlock after a restart, the keychain can’t be read yet, and "},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" returns "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" for the cached entitlement just as it does when nothing is cached. "},{"code":"ResilientPaywallService","type":"codeVoice"},{"type":"text","text":" then treats the cache as empty. The entitlement stream yields no cached seed, so "},{"code":"store.paywall","type":"codeVoice"},{"type":"text","text":" stays free until some snapshot arrives, and a refresh whose live reads all fail sets "},{"code":"store.paywall.error","type":"codeVoice"},{"type":"text","text":" instead of returning the cached entitlement. The miss doesn’t erase anything, because the service writes the cache only when a live snapshot arrives or "},{"code":"clearCache()","type":"codeVoice"},{"type":"text","text":" runs. The service also doesn’t watch for the keychain becoming readable, so dispatch "},{"code":".refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":" when a scene becomes active. Step 5 below builds the root view; add the scene-phase property and modifier to it:"}],"type":"paragraph"},{"code":["\/\/ A property on the root view:","@Environment(\\.scenePhase) private var scenePhase","","\/\/ A modifier on the view its body returns:",".onChange(of: scenePhase) { _, phase in","    if phase == .active { store.send(.paywall(.refreshCustomerInfo)) }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Once the keychain is readable, a refresh whose live reads all fail returns the cached entitlement if it is within ","type":"text"},{"type":"codeVoice","code":"maxCacheAge"},{"text":" (a permanent license is kept past it). On success, the refresh’s snapshot sets ","type":"text"},{"code":"store.paywall.isPro","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":" from its own values, so ","type":"text"},{"code":"isGateSatisfied","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for a user with no entitlement. If the refresh gets neither a live snapshot nor a usable cache, ","type":"text"},{"code":"store.paywall.error","type":"codeVoice"},{"text":" is set, and ","type":"text"},{"type":"codeVoice","code":"isPro"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" stay as they were. See “Failure Modes” in "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","type":"reference","isActive":true},{"type":"text","text":" for how "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" reports a locked keychain on writes and on "},{"type":"codeVoice","code":"deviceIdentity(key:)"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Step 5: Observe customer info on launch","anchor":"Step-5-Observe-customer-info-on-launch","type":"heading"},{"inlineContent":[{"type":"text","text":"Start the long-lived entitlement stream once, on the root view:"}],"type":"paragraph"},{"syntax":"swift","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"observeCustomerInfo","type":"codeVoice"},{"text":" returns an effect that lives for the duration of ","type":"text"},{"code":"PaywallService.customerInfoStream()","type":"codeVoice"},{"text":". Every snapshot the service yields flows through ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" and updates ","type":"text"},{"code":"store.paywall.isPro","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Step-6-Present-the-paywall","level":2,"text":"Step 6: Present the paywall","type":"heading"},{"inlineContent":[{"text":"Bind a sheet to ","type":"text"},{"code":"store.paywall.isPresented","type":"codeVoice"},{"text":" and dispatch ","type":"text"},{"code":".paywall(.dismiss)","type":"codeVoice"},{"text":" when it closes:","type":"text"}],"type":"paragraph"},{"code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"If you are still on ","type":"text"},{"code":"SimulatedPaywallService","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxDevPaywallUI","type":"codeVoice"},{"text":" sheet, the ","type":"text"},{"code":".devPaywall(state:service:onAction:)","type":"codeVoice"},{"text":" call is replaced, not kept, when you adopt RevenueCat. See “Moving to a real provider” in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"reference"},{"text":" for the exact change.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Trigger presentation by dispatching ","type":"text"},{"code":".paywall(.request(reason:))","type":"codeVoice"},{"text":" with a short identifier describing why you’re asking. The reason is stored in ","type":"text"},{"code":"store.paywall.requestedReason","type":"codeVoice"},{"text":" so the sheet can tailor its copy.","type":"text"}],"type":"paragraph"},{"code":["store.send(.paywall(.request(reason: \"export-pdf\")))"],"syntax":"swift","type":"codeListing"},{"anchor":"Step-7-Gate-a-feature","level":2,"text":"Step 7: Gate a feature","type":"heading"},{"inlineContent":[{"text":"Read ","type":"text"},{"code":"PaywallState.isGateSatisfied","type":"codeVoice"},{"text":" before running gated work. If it’s ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", dispatch ","type":"text"},{"code":".request","type":"codeVoice"},{"text":" instead:","type":"text"}],"type":"paragraph"},{"code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Step-8-Restore-purchases","level":2,"text":"Step 8: Restore purchases","type":"heading"},{"inlineContent":[{"text":"Add a restore button to your paywall sheet. Reflect ","type":"text"},{"code":"store.paywall.isLoading","type":"codeVoice"},{"text":" to disable it while the call is in flight:","type":"text"}],"type":"paragraph"},{"code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"On success, the resulting snapshot flows through ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" and updates the gate. On failure, ","type":"text"},{"code":"store.paywall.error","type":"codeVoice"},{"text":" is set. Either outcome lands even if the user closes the sheet while the restore is still running: the refresh that ","type":"text"},{"code":".dismiss","type":"codeVoice"},{"text":" dispatches cannot supersede a restore. Only a live stream update that arrives mid-restore outranks the restore’s snapshot, because the provider’s feed is at least as new. ","type":"text"},{"code":"isLoading","type":"codeVoice"},{"text":" stays ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" until the restore finishes or a newer snapshot lands, so a restore the provider never completes cannot hold the spinner once a refresh succeeds.","type":"text"}],"type":"paragraph"},{"anchor":"Step-9-Manage-subscriptions","level":2,"text":"Step 9: Manage subscriptions","type":"heading"},{"inlineContent":[{"text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:","type":"text"}],"type":"paragraph"},{"code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This opens ","type":"text"},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"text":" via the plugin’s ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" handler, which routes to the App Store on iOS and Settings on macOS.","type":"text"}],"type":"paragraph"},{"anchor":"Testing","level":2,"text":"Testing","type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"MockPaywallService","type":"codeVoice"},{"text":" to drive previews and tests into a known entitlement state:","type":"text"}],"type":"paragraph"},{"code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Plumb the service through a parameter on your ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory so previews can override it without touching the live RevenueCat SDK.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","interfaceLanguage":"swift"},"abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddapaywall"]}],"sections":[],"references":{"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"role":"article","kind":"article","title":"Add Analytics","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddanalytics","type":"topic"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"role":"article","title":"Cancel Effects","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"url":"\/documentation\/swidux\/howtocanceleffects","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"role":"article","kind":"article","title":"Add Persistence","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddpersistence","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","kind":"article","title":"Add a Version Killswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","abstract":[{"text":"Wire a remote-controlled blocker that covers the UI of unsupported app versions, with an “Update” path back to the App Store.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddaversionkillswitch","type":"topic"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","kind":"article","title":"Plugin Architecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"url":"\/documentation\/swidux\/pluginarchitecture","type":"topic"},"doc://Swidux/documentation/Swidux/AgentSkill":{"role":"article","title":"Using the Swidux Agent Skill","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"url":"\/documentation\/swidux\/agentskill","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"role":"article","kind":"article","title":"Add Feature Flags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"role":"article","kind":"article","title":"Add iCloud Sync","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddicloudsync","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"role":"article","kind":"article","title":"Add a Parental Gate","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddaparentalgate","type":"topic"},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"titleInlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}],"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"link","title":"SwiduxRevenueCatPaywall"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","type":"topic","title":"KeyValueStore","kind":"article","role":"collectionGroup","url":"\/documentation\/swidux\/keyvaluestoreguide"},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","title":"Getting Started with Swidux","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"url":"\/documentation\/swidux\/gettingstarted","type":"topic"},"https://heirloomlogic.github.io/SwiduxRevenueCatPaywall/documentation/swiduxrevenuecatpaywall/":{"titleInlineContent":[{"text":"DocC reference","type":"text"}],"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","url":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","type":"link","title":"DocC reference"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"role":"article","kind":"article","title":"Building a Domain Plugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"url":"\/documentation\/swidux\/buildingadomainplugin","type":"topic"},"doc://Swidux/documentation/Swidux/SecurityPosture":{"role":"collectionGroup","kind":"article","title":"Security Posture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","abstract":[{"text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one.","type":"text"}],"url":"\/documentation\/swidux\/securityposture","type":"topic"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","title":"Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"url":"\/documentation\/swidux","type":"topic","role":"collection"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic","title":"SwiduxPaywall Reference","kind":"article","role":"article","url":"\/documentation\/swidux\/pluginpaywallreference"}}}