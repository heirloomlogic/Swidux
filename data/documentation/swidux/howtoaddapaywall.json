{"metadata":{"title":"Add a Paywall","modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article"},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides","anchor":"How-to-Guides","generated":true}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddapaywall"]}],"sections":[],"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide takes you from a wired Swidux app to a fully gated feature with paywall presentation, entitlement observation, restore, and manage-subscription support. It covers state and action wiring, implementing a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":", presenting the sheet, gating a feature, and previewing in pro state."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an API-level reference of every type and action, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},{"type":"text","text":". For where domain plugins fit in the dispatch cycle, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Before-you-start","text":"Before you start","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a Swidux app already wired up — "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and "},{"code":"AppStore","type":"codeVoice"},{"type":"text","text":" exist and the store is in the SwiftUI environment. If you’re not there yet, follow "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},{"type":"text","text":" first."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"You have a purchase backend in mind. RevenueCat is the path of least resistance, but vanilla StoreKit or a custom server work just as well — the plugin doesn’t care."}]}]}]},{"type":"heading","anchor":"Step-1-Add-the-dependency","text":"Step 1: Add the dependency","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" product to your app target in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":[".target(","    name: \"MyApp\",","    dependencies: [","        \"Swidux\",","        \"SwiduxPaywall\",","    ]",")"],"syntax":"swift"},{"type":"heading","anchor":"Step-2-Add-state-and-actions","text":"Step 2: Add state and actions","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a paywall slice to "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":" with "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":", and a paywall case to "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["\/\/ AppState.swift","import SwiduxPaywall","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var paywall: PaywallState = .init()","    \/\/ … other slices","}"],"syntax":"swift"},{"type":"codeListing","code":["\/\/ AppAction.swift","import SwiduxPaywall","","enum AppAction: Sendable {","    case paywall(PaywallAction)","    \/\/ … other cases","}"],"syntax":"swift"},{"type":"aside","style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxPaywall"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.paywall.*"},{"type":"text","text":" or "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":" — including views that read the slice for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin owns reducing for "},{"code":".paywall","type":"codeVoice"},{"type":"text","text":" actions, so the root reducer should fall through:"}]},{"type":"codeListing","code":["\/\/ AppReducer.swift","case .paywall:","    return nil"],"syntax":"swift"},{"type":"heading","anchor":"Step-3-Provide-a-PaywallService","text":"Step 3: Provide a `PaywallService`","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin needs a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that talks to your purchase backend. Pick the path that matches your backend."}]},{"type":"heading","anchor":"Path-A-RevenueCat-recommended","text":"Path A: RevenueCat (recommended)","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},{"type":"text","text":" companion package and use the supplied "},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":". No bridging code on your side."}]},{"type":"codeListing","code":[".package(url: \"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall\", from: \"1.0.0\"),"],"syntax":"swift"},{"type":"codeListing","code":["import SwiduxRevenueCatPaywall","","let service = RevenueCatPaywallService()"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The companion package also ships "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":", a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin. See its "},{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/"},{"type":"text","text":" for configuration (API key, entitlement identifiers)."}]},{"type":"heading","anchor":"Path-B-StoreKit-or-custom-backend","text":"Path B: StoreKit or custom backend","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For any non-RevenueCat backend, implement "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" directly. The protocol is small:"}]},{"type":"codeListing","code":["import SwiduxPaywall","","struct MyPaywallService: PaywallService {","    func customerInfo() async throws -> EntitlementSnapshot {","        \/\/ Fetch the current entitlement once.","        return EntitlementSnapshot()","    }","","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot> {","        AsyncStream { continuation in","            \/\/ Yield a new snapshot each time the entitlement changes.","            \/\/ Call continuation.finish() when the source ends.","        }","    }","","    func restorePurchases() async throws -> EntitlementSnapshot {","        \/\/ Run a restore against the user's account and return the result.","        return EntitlementSnapshot()","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A vanilla StoreKit conformer iterates "},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"type":"text","text":" and listens to "},{"code":"Transaction.updates","type":"codeVoice"},{"type":"text","text":"; a custom server conformer hits whatever endpoint reports the user’s entitlement."}]},{"type":"heading","anchor":"Previews-and-tests","text":"Previews and tests","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the built-in "},{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" for backend-agnostic previews:"}]},{"type":"codeListing","code":["let service = MockPaywallService(isPro: true)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you’re on Path A, "},{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"},{"type":"text","text":" also ships "},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" for RevenueCat-flavored previews."}]},{"type":"heading","anchor":"Step-4-Wire-the-plugin","text":"Step 4: Wire the plugin","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct and register "},{"code":"PaywallPlugin","type":"codeVoice"},{"type":"text","text":" inside your "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory:"}]},{"type":"codeListing","code":["import SwiduxPaywall","","let paywallPlugin = PaywallPlugin<AppState, AppAction>(","    state: \\.paywall,","    action: AppAction.paywall,","    extractAction: { if case .paywall(let a) = $0 { return a }; return nil },","    service: RevenueCatPaywallService()",")","plugins.register(paywallPlugin)"],"syntax":"swift"},{"type":"aside","style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In production, wrap the service in "},{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" so a"},{"type":"text","text":" "},{"type":"text","text":"transient entitlement-read failure at cold launch never gates a paid user as"},{"type":"text","text":" "},{"type":"text","text":"free. Back its cache with "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" (not "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":", whose"},{"type":"text","text":" "},{"type":"text","text":"plist a user can edit to spoof entitlements):"}]},{"syntax":"swift","code":["service: ResilientPaywallService(","    base: RevenueCatPaywallService(),","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"See the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" reference ("},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},{"type":"text","text":") for the"},{"type":"text","text":" "},{"type":"text","text":"staleness policy and threat model."}]}]},{"anchor":"Step-5-Observe-customer-info-on-launch","type":"heading","text":"Step 5: Observe customer info on launch","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Start the long-lived entitlement stream once, on the root view:"}]},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        RootContent()","            .task { store.send(.paywall(.observeCustomerInfo)) }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"observeCustomerInfo"},{"type":"text","text":" returns an effect that lives for the duration of "},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"type":"text","text":". Every snapshot the service yields flows through "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" and updates "},{"type":"codeVoice","code":"store.paywall.isPro"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":"."}]},{"anchor":"Step-6-Present-the-paywall","type":"heading","text":"Step 6: Present the paywall","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Bind a sheet to "},{"type":"codeVoice","code":"store.paywall.isPresented"},{"type":"text","text":" and dispatch "},{"type":"codeVoice","code":".paywall(.dismiss)"},{"type":"text","text":" when it closes:"}]},{"syntax":"swift","type":"codeListing","code":[".sheet(isPresented: Binding(","    get: { store.paywall.isPresented },","    set: { if !$0 { store.send(.paywall(.dismiss)) } }",")) {","    PaywallSheet()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Trigger presentation by dispatching "},{"type":"codeVoice","code":".paywall(.request(reason:))"},{"type":"text","text":" with a short identifier describing why you’re asking. The reason is stored in "},{"type":"codeVoice","code":"store.paywall.requestedReason"},{"type":"text","text":" so the sheet can tailor its copy."}]},{"syntax":"swift","type":"codeListing","code":["store.send(.paywall(.request(reason: \"export-pdf\")))"]},{"anchor":"Step-7-Gate-a-feature","type":"heading","text":"Step 7: Gate a feature","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"type":"codeVoice","code":"PaywallState.isGateSatisfied"},{"type":"text","text":" before running gated work. If it’s "},{"type":"codeVoice","code":"false"},{"type":"text","text":", dispatch "},{"type":"codeVoice","code":".request"},{"type":"text","text":" instead:"}]},{"syntax":"swift","type":"codeListing","code":["Button(\"Export PDF\") {","    if store.paywall.isGateSatisfied {","        store.send(.export(.exportPDF))","    } else {","        store.send(.paywall(.request(reason: \"export-pdf\")))","    }","}"]},{"anchor":"Step-8-Restore-purchases","type":"heading","text":"Step 8: Restore purchases","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add a restore button to your paywall sheet. Reflect "},{"type":"codeVoice","code":"store.paywall.isLoading"},{"type":"text","text":" to disable it while the call is in flight:"}]},{"syntax":"swift","type":"codeListing","code":["Button(\"Restore Purchases\") {","    store.send(.paywall(.restorePurchases))","}",".disabled(store.paywall.isLoading)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On success, the resulting snapshot flows through "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" and updates the gate. On failure, "},{"type":"codeVoice","code":"store.paywall.error"},{"type":"text","text":" is set."}]},{"anchor":"Step-9-Manage-subscriptions","type":"heading","text":"Step 9: Manage subscriptions","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an existing subscriber, surface a button that deep-links into the system subscription management page:"}]},{"syntax":"swift","type":"codeListing","code":["Button(\"Manage Subscription\") {","    store.send(.paywall(.openManageSubscriptions))","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" via the plugin’s "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler, which routes to the App Store on iOS and Settings on macOS."}]},{"anchor":"Testing","type":"heading","text":"Testing","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" to drive previews and tests into a known entitlement state:"}]},{"syntax":"swift","type":"codeListing","code":["#Preview(\"Pro\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService(isPro: true)","    )","    return ContentView().environment(store)","}","","#Preview(\"Free\") {","    let store = AppStore.configured(","        paywallService: MockPaywallService()","    )","    return ContentView().environment(store)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Plumb the service through a parameter on your "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory so previews can override it without touching the live RevenueCat SDK."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"references":{"doc://Swidux/documentation/Swidux/GettingStarted":{"abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"role":"article","kind":"article","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","role":"article","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","kind":"article","title":"Add a Version Killswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that 