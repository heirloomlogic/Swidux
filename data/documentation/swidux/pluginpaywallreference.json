{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"title":"SwiduxPaywall Reference","role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"generated":true,"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","isActive":true},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Library-target","text":"Library target"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product: "},{"code":"SwiduxPaywall","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import: "},{"code":"import SwiduxPaywall","type":"codeVoice"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Provided-implementations","text":"Provided implementations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" — fixed snapshot, stream finishes immediately; for previews and tests."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"SimulatedPaywallService","type":"codeVoice"},{"type":"text","text":" — a stateful, fully driveable service. Paired with the "},{"code":"SwiduxDevPaywallUI","type":"codeVoice"},{"type":"text","text":" debug sheet, it lets a developer or QA tester grant Pro\/Trial\/Permanent, restore, and simulate failure\/latency — all flowing through the real plugin pipeline, with no SDK and no vendor commitment. Use it as the "},{"code":"service:","type":"codeVoice"},{"type":"text","text":" while the paywall vendor decision is still open."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For production RevenueCat integrations, the "},{"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","isActive":true},{"type":"text","text":" companion package provides:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" — a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that bridges RevenueCat’s "},{"code":"CustomerInfo","type":"codeVoice"},{"type":"text","text":" stream and "},{"code":"restorePurchases()","type":"codeVoice"},{"type":"text","text":" API."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" — a RevenueCat-flavored mock for previews."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Full API documentation lives in the package’s own "},{"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For other backends (StoreKit, custom server), implement "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" directly — see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","isActive":true},{"type":"text","text":" Step 3, Path B."}]},{"type":"heading","level":3,"anchor":"Resilient-last-known-good-decorator","text":"Resilient last-known-good decorator"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" wraps any "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" so a transient failure to read entitlements at cold launch never presents a previously-seen paid user as free. It retries with backoff, then falls back to a last-known-good snapshot persisted through an injected "},{"type":"codeVoice","code":"KeyValueStore"},{"type":"text","text":". Because that cache vouches for a paid entitlement while offline, back it with "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" — not "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":", whose plist a user can edit or restore from a doctored backup:"}]},{"type":"codeListing","syntax":"swift","code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feed the wrapped instance to both "},{"type":"codeVoice","code":"PaywallPlugin(..., service:)"},{"type":"text","text":" and any app-side entitlement reader. The live provider stays authoritative: any successful snapshot overwrites the cache. See the type’s own documentation for the staleness policy and threat model."}]},{"type":"heading","level":2,"anchor":"Types","text":"Types"},{"type":"heading","level":3,"anchor":"PaywallPlugin%3CRootState-RootAction%3E","text":"`PaywallPlugin<RootState, RootAction>`"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":" and an action enum typed as "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":"."}]},{"type":"codeListing","syntax":"swift","code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler calls "},{"type":"codeVoice","code":"UIApplication.shared.open"},{"type":"text","text":" on UIKit and "},{"type":"codeVoice","code":"NSWorkspace.shared.open"},{"type":"text","text":" on AppKit. Override it for testing or for non-standard environments."}]},{"type":"heading","level":3,"anchor":"PaywallState","text":"`PaywallState`"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" struct. The slice the plugin owns."}]},{"type":"codeListing","syntax":"swift","code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","    public var isObservingCustomerInfo: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false,","        isObservingCustomerInfo: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isGateSatisfied"},{"type":"text","text":" is the single read your feature code should consult before running gated work. It is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when the user holds an active pro subscription or a permanent license."}]},{"type":"heading","level":3,"anchor":"PaywallAction","text":"`PaywallAction`"},{"type":"codeListing","syntax":"swift","code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"]},{"type":"heading","level":3,"anchor":"EntitlementSnapshot","text":"`EntitlementSnapshot`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provider-agnostic value the service emits to describe the user’s current entitlement."}]},{"type":"codeListing","syntax":"swift","code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"]},{"type":"heading","level":3,"anchor":"PaywallService-protocol","text":"`PaywallService` (protocol)"},{"type":"codeListing","syntax":"swift","code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"type":"heading","level":3,"anchor":"MockPaywallService","text":"`MockPaywallService`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately."}]},{"type":"codeListing","syntax":"swift","code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"type":"heading","level":3,"anchor":"SimulatedPaywallService","text":"`SimulatedPaywallService`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Stateful "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" conformer for development and QA. Holds the current entitlement and multicasts changes through "},{"type":"codeVoice","code":"customerInfoStream()"},{"type":"text","text":", so simulated grants survive a later "},{"type":"codeVoice","code":"refreshCustomerInfo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"restorePurchases"},{"type":"text","text":" exactly as a real service would."}]},{"type":"codeListing","syntax":"swift","code":["public actor SimulatedPaywallService: PaywallService {","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        subsystem: String = \"Swidux\",","        category: String = \"Paywall\"","    )","","    \/\/ PaywallService: customerInfo \/ customerInfoStream \/ restorePurchases","","    \/\/ Simulation surface (not part of PaywallService — driven by the dev UI):","    public func grantPro()","    public func grantTrial()","    public func grantPermanentLicense()","    public func setFree()","    public func setRestoreShouldFail(_ shouldFail: Bool)","    public func setRefreshShouldFail(_ shouldFail: Bool)","    public func setArtificialDelay(_ delay: Duration)","}","","public enum SimulatedPaywallError: Error, Equatable {","    case restoreFailed","    case refreshFailed","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" only models "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":", so "},{"type":"codeVoice","code":"grantTrial()"},{"type":"text","text":" yields "},{"type":"codeVoice","code":"isPro == true"},{"type":"text","text":" and is distinguished from "},{"type":"codeVoice","code":"grantPro()"},{"type":"text","text":" only in the log line."}]},{"type":"heading","level":3,"anchor":"SwiduxDevPaywallUI","text":"`SwiduxDevPaywallUI`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A separate, opt-in library product ("},{"type":"codeVoice","code":"import SwiduxDevPaywallUI"},{"type":"text","text":") providing a bare-bones debug paywall sheet. It mirrors the shape of the vendor paywall UI so the call site is unchanged when a real provider is adopted:"}]},{"type":"codeListing","syntax":"swift","code":["someView.devPaywall(","    state: store.paywall,","    service: simulatedPaywallService,","    onAction: { store.send(.paywall($0)) }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sheet shows the live "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":", grant buttons, real Restore\/Refresh flows, and QA failure\/latency toggles. On macOS the sheet uses a 400×600 minimum, matching the vendor paywall UI. Hold a "},{"type":"strong","inlineContent":[{"text":"single","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"SimulatedPaywallService"},{"type":"text","text":" instance and pass it to both "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" (as the plugin’s "},{"type":"codeVoice","code":"service:"},{"type":"text","text":") and "},{"type":"codeVoice","code":".devPaywall(...)"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["@State private var paywallService = SimulatedPaywallService()","@State private var store: AppStore","","init() {","    let service = SimulatedPaywallService()","    _paywallService = State(initialValue: service)","    _store = State(initialValue: .configured(paywallService: service))","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the one place a dev\/QA service is intentionally constructed outside "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":", because the debug UI must drive the same instance the plugin observes. Swapping to a real provider removes the shared-instance wiring and the "},{"type":"codeVoice","code":"SwiduxDevPaywallUI"},{"type":"text","text":" import along with the two-line "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" change."}]},{"type":"heading","level":2,"anchor":"Action-semantics","text":"Action semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}]},{"type":"heading","level":3,"anchor":"requestreason-String","text":"`request(reason: String)`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPresented = true"},{"type":"text","text":" and stores "},{"type":"codeVoice","code":"requestedReason"},{"type":"text","text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase."}]},{"type":"heading","level":3,"anchor":"dismiss","text":"`dismiss`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPresented = false"},{"type":"text","text":" and clears "},{"type":"codeVoice","code":"requestedReason"},{"type":"text","text":". Returns an effect that dispatches "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up)."}]},{"type":"heading","level":3,"anchor":"observeCustomerInfo","text":"`observeCustomerInfo`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns a long-lived effect that consumes "},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" for every snapshot. Dispatch once on app launch (typically from a "},{"type":"codeVoice","code":".task"},{"type":"text","text":" on the root view). The effect lives for the duration of the stream. Idempotent: "},{"type":"codeVoice","code":"isObservingCustomerInfo"},{"type":"text","text":" guards against double-subscription, so a re-dispatched "},{"type":"codeVoice","code":".task"},{"type":"text","text":" (view identity change, scene reconnect) won’t start a duplicate stream."}]},{"type":"heading","level":3,"anchor":"refreshCustomerInfo","text":"`refreshCustomerInfo`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isLoading = true"},{"type":"text","text":". Returns a one-shot effect that calls "},{"type":"codeVoice","code":"PaywallService.customerInfo()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"code":".refreshFailed","type":"codeVoice"},{"type":"text","text":" on error."}]},{"type":"heading","level":3,"anchor":"customerInfoUpdatedEntitlementSnapshot","text":"`customerInfoUpdated(EntitlementSnapshot)`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"isPro","type":"codeVoice"},{"type":"text","text":" and "},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":" from the snapshot, clears ","type":"text"},{"code":"isLoading","type":"codeVoice"},{"text":", and clears ","type":"text"},{"code":"error","type":"codeVoice"},{"text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly. Note that the plugin emits this on ","type":"text"},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"text":" snapshot (each ","type":"text"},{"code":"customerInfoStream()","type":"codeVoice"},{"text":" value, every ","type":"text"},{"code":"refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"restorePurchases"},{"text":"), not only on entitlement changes — observe ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":" (or a value derived from it) for transitions rather than mapping this action directly. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":3,"anchor":"refreshFailedString","text":"`refreshFailed(String)`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"error","type":"codeVoice"},{"text":" to the given message and clears ","type":"text"},{"code":"isLoading","type":"codeVoice"},{"type":"text","text":". Returns no effect."}]},{"type":"heading","level":3,"anchor":"restorePurchases","text":"`restorePurchases`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"isLoading = true","type":"codeVoice"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"code":"PaywallService.restorePurchases()","type":"codeVoice"},{"text":" and dispatches ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" on error."}]},{"text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","level":3,"anchor":"presentCustomerCenter--dismissCustomerCenter","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Toggle ","type":"text"},{"type":"codeVoice","code":"isCustomerCenterPresented"},{"text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does).","type":"text"}]},{"type":"heading","text":"`openManageSubscriptions`","anchor":"openManageSubscriptions","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns an effect that opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" via the configured "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS."}]},{"type":"heading","text":"Implementing a `PaywallService`","anchor":"Implementing-a-PaywallService","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol has three methods:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"customerInfo() async throws -> EntitlementSnapshot","type":"codeVoice"}]},{"type":"text","text":" — One-shot fetch of the current entitlement. The plugin calls this from "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>","type":"codeVoice"}]},{"type":"text","text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"restorePurchases() async throws -> EntitlementSnapshot","type":"codeVoice"}]},{"type":"text","text":" — Performs a restore against the user’s account and returns the resulting entitlement."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Note what the protocol does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into ","type":"text"},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":" values. A vanilla StoreKit conformer iterates ","type":"text"},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"text":" and listens to ","type":"text"},{"code":"Transaction.updates","type":"codeVoice"},{"text":". Either way, the plugin stays the same.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swidux\/pluginpaywallreference"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"https://heirloomlogic.github.io/SwiduxRevenueCatPaywall/documentation/swiduxrevenuecatpaywall/":{"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","title":"DocC reference","titleInlineContent":[{"type":"text","text":"DocC reference"}],"url":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","type":"link"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","url":"\/documentation\/swidux\/troubleshooting","abstract":[{"type":"text","text":"Symptoms you may hit while 