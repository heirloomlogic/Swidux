{"abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"article","modules":[{"name":"Swidux"}],"title":"SwiduxPaywall Reference","roleHeading":"Article"},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"title":"Reference","generated":true,"anchor":"Reference"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginpaywallreference"]}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]},{"level":2,"anchor":"Library-target","type":"heading","text":"Library target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"code":"SwiduxPaywall","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"code":"import SwiduxPaywall","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":" alongside "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":"."}]},{"level":2,"anchor":"Provided-implementations","type":"heading","text":"Provided implementations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" — fixed snapshot, stream finishes immediately; for previews and tests."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"SimulatedPaywallService","type":"codeVoice"},{"type":"text","text":" — a stateful, fully driveable service. Paired with the "},{"code":"SwiduxDevPaywallUI","type":"codeVoice"},{"type":"text","text":" debug sheet, it lets a developer or QA tester grant Pro\/Trial\/Permanent, restore, and simulate failure\/latency — all flowing through the real plugin pipeline, with no SDK and no vendor commitment. Use it as the "},{"code":"service:","type":"codeVoice"},{"type":"text","text":" while the paywall vendor decision is still open."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For production RevenueCat integrations, the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},{"type":"text","text":" companion package provides:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" — a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that bridges RevenueCat’s "},{"code":"CustomerInfo","type":"codeVoice"},{"type":"text","text":" stream and "},{"code":"restorePurchases()","type":"codeVoice"},{"type":"text","text":" API."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" — a RevenueCat-flavored mock for previews."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Full API documentation lives in the package’s own "},{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For other backends (StoreKit, custom server), implement "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" directly — see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"type":"text","text":" Step 3, Path B."}]},{"level":2,"anchor":"Types","type":"heading","text":"Types"},{"level":3,"anchor":"PaywallPlugin%3CRootState-RootAction%3E","type":"heading","text":"`PaywallPlugin<RootState, RootAction>`"},{"type":"paragraph","inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" "},{"code":"SwiduxPlugin","type":"codeVoice"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":" and an action enum typed as "},{"code":"PaywallAction","type":"codeVoice"},{"type":"text","text":"."}]},{"code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" handler calls "},{"code":"UIApplication.shared.open","type":"codeVoice"},{"type":"text","text":" on UIKit and "},{"code":"NSWorkspace.shared.open","type":"codeVoice"},{"type":"text","text":" on AppKit. Override it for testing or for non-standard environments."}]},{"level":3,"anchor":"PaywallState","type":"heading","text":"`PaywallState`"},{"type":"paragraph","inlineContent":[{"code":"Sendable","type":"codeVoice"},{"type":"text","text":", "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":" struct. The slice the plugin owns."}]},{"code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","    public var isObservingCustomerInfo: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false,","        isObservingCustomerInfo: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"isGateSatisfied","type":"codeVoice"},{"type":"text","text":" is the single read your feature code should consult before running gated work. It is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" when the user holds an active pro subscription or a permanent license."}]},{"level":3,"anchor":"PaywallAction","type":"heading","text":"`PaywallAction`"},{"code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"EntitlementSnapshot","type":"heading","text":"`EntitlementSnapshot`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provider-agnostic value the service emits to describe the user’s current entitlement."}]},{"code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"PaywallService-protocol","type":"heading","text":"`PaywallService` (protocol)"},{"code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"MockPaywallService","type":"heading","text":"`MockPaywallService`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately."}]},{"code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"SimulatedPaywallService","type":"heading","text":"`SimulatedPaywallService`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Stateful "},{"code":"actor","type":"codeVoice"},{"type":"text","text":" conformer for development and QA. Holds the current entitlement and multicasts changes through "},{"code":"customerInfoStream()","type":"codeVoice"},{"type":"text","text":", so simulated grants survive a later "},{"code":"refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"restorePurchases","type":"codeVoice"},{"type":"text","text":" exactly as a real service would."}]},{"code":["public actor SimulatedPaywallService: PaywallService {","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        subsystem: String = \"Swidux\",","        category: String = \"Paywall\"","    )","","    \/\/ PaywallService: customerInfo \/ customerInfoStream \/ restorePurchases","","    \/\/ Simulation surface (not part of PaywallService — driven by the dev UI):","    public func grantPro()","    public func grantTrial()","    public func grantPermanentLicense()","    public func setFree()","    public func setRestoreShouldFail(_ shouldFail: Bool)","    public func setRefreshShouldFail(_ shouldFail: Bool)","    public func setArtificialDelay(_ delay: Duration)","}","","public enum SimulatedPaywallError: Error, Equatable {","    case restoreFailed","    case refreshFailed","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"EntitlementSnapshot","type":"codeVoice"},{"type":"text","text":" only models "},{"code":"isPro","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"hasPermanentLicense","type":"codeVoice"},{"type":"text","text":", so "},{"code":"grantTrial()","type":"codeVoice"},{"type":"text","text":" yields "},{"code":"isPro == true","type":"codeVoice"},{"type":"text","text":" and is distinguished from "},{"code":"grantPro()","type":"codeVoice"},{"type":"text","text":" only in the log line."}]},{"anchor":"SwiduxDevPaywallUI","level":3,"text":"`SwiduxDevPaywallUI`","type":"heading"},{"inlineContent":[{"type":"text","text":"A separate, opt-in library product ("},{"code":"import SwiduxDevPaywallUI","type":"codeVoice"},{"type":"text","text":") providing a bare-bones debug paywall sheet. It mirrors the shape of the vendor paywall UI so the call site is unchanged when a real provider is adopted:"}],"type":"paragraph"},{"syntax":"swift","code":["someView.devPaywall(","    state: store.paywall,","    service: simulatedPaywallService,","    onAction: { store.send(.paywall($0)) }",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The sheet shows the live "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":", grant buttons, real Restore\/Refresh flows, and QA failure\/latency toggles. On macOS the sheet uses a 400×600 minimum, matching the vendor paywall UI. Hold a "},{"inlineContent":[{"type":"text","text":"single"}],"type":"strong"},{"type":"text","text":" "},{"code":"SimulatedPaywallService","type":"codeVoice"},{"type":"text","text":" instance and pass it to both "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" (as the plugin’s "},{"code":"service:","type":"codeVoice"},{"type":"text","text":") and "},{"code":".devPaywall(...)","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["@State private var paywallService = SimulatedPaywallService()","@State private var store: AppStore","","init() {","    let service = SimulatedPaywallService()","    _paywallService = State(initialValue: service)","    _store = State(initialValue: .configured(paywallService: service))","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is the one place a dev\/QA service is intentionally constructed outside "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":", because the debug UI must drive the same instance the plugin observes. Swapping to a real provider removes the shared-instance wiring and the "},{"code":"SwiduxDevPaywallUI","type":"codeVoice"},{"type":"text","text":" import along with the two-line "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" change."}],"type":"paragraph"},{"text":"Action semantics","anchor":"Action-semantics","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}],"type":"paragraph"},{"anchor":"requestreason-String","level":3,"text":"`request(reason: String)`","type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPresented = true"},{"type":"text","text":" and stores "},{"type":"codeVoice","code":"requestedReason"},{"type":"text","text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase."}],"type":"paragraph"},{"anchor":"dismiss","level":3,"text":"`dismiss`","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"isPresented = false","type":"codeVoice"},{"text":" and clears ","type":"text"},{"code":"requestedReason","type":"codeVoice"},{"text":". Returns an effect that dispatches ","type":"text"},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up).","type":"text"}]},{"level":3,"type":"heading","text":"`observeCustomerInfo`","anchor":"observeCustomerInfo"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns a long-lived effect that consumes "},{"code":"PaywallService.customerInfoStream()","type":"codeVoice"},{"type":"text","text":" and dispatches "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" for every snapshot. Dispatch once on app launch (typically from a "},{"code":".task","type":"codeVoice"},{"type":"text","text":" on the root view). The effect lives for the duration of the stream. Idempotent: "},{"code":"isObservingCustomerInfo","type":"codeVoice"},{"text":" guards against double-subscription, so a re-dispatched ","type":"text"},{"code":".task","type":"codeVoice"},{"type":"text","text":" (view identity change, scene reconnect) won’t start a duplicate stream."}]},{"anchor":"refreshCustomerInfo","level":3,"text":"`refreshCustomerInfo`","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"isLoading = true","type":"codeVoice"},{"type":"text","text":". Returns a one-shot effect that calls "},{"code":"PaywallService.customerInfo()","type":"codeVoice"},{"type":"text","text":" and dispatches "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" on success or "},{"code":".refreshFailed","type":"codeVoice"},{"type":"text","text":" on error."}]},{"type":"heading","anchor":"customerInfoUpdatedEntitlementSnapshot","level":3,"text":"`customerInfoUpdated(EntitlementSnapshot)`"},{"inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isPro"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":" from the snapshot, clears ","type":"text"},{"type":"codeVoice","code":"isLoading"},{"text":", and clears ","type":"text"},{"type":"codeVoice","code":"error"},{"text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly. Note that the plugin emits this on ","type":"text"},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"text":" snapshot (each ","type":"text"},{"code":"customerInfoStream()","type":"codeVoice"},{"text":" value, every ","type":"text"},{"code":"refreshCustomerInfo","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"restorePurchases","type":"codeVoice"},{"text":"), not only on entitlement changes — observe ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":" (or a value derived from it) for transitions rather than mapping this action directly. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"`refreshFailed(String)`","anchor":"refreshFailedString","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Sets "},{"code":"error","type":"codeVoice"},{"type":"text","text":" to the given message and clears "},{"code":"isLoading","type":"codeVoice"},{"type":"text","text":". Returns no effect."}],"type":"paragraph"},{"level":3,"type":"heading","text":"`restorePurchases`","anchor":"restorePurchases"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"isLoading = true","type":"codeVoice"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"code":"PaywallService.restorePurchases()","type":"codeVoice"},{"text":" and dispatches ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" on success or ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" on error.","type":"text"}],"type":"paragraph"},{"level":3,"type":"heading","text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","anchor":"presentCustomerCenter--dismissCustomerCenter"},{"inlineContent":[{"text":"Toggle ","type":"text"},{"code":"isCustomerCenterPresented","type":"codeVoice"},{"text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does).","type":"text"}],"type":"paragraph"},{"anchor":"openManageSubscriptions","level":3,"text":"`openManageSubscriptions`","type":"heading"},{"inlineContent":[{"text":"Returns an effect that opens ","type":"text"},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"text":" via the configured ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS.","type":"text"}],"type":"paragraph"},{"anchor":"Implementing-a-PaywallService","text":"Implementing a `PaywallService`","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an "},{"code":"EntitlementSnapshot","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"The protocol has three methods:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"customerInfo() async throws -> EntitlementSnapshot","type":"codeVoice"}],"type":"strong"},{"text":" — One-shot fetch of the current entitlement. The plugin calls this from ","type":"text"},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>"}]},{"text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from ","type":"text"},{"type":"codeVoice","code":".observeCustomerInfo"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"restorePurchases() async throws -> EntitlementSnapshot"}],"type":"strong"},{"text":" — Performs a restore against the user’s account and returns the resulting entitlement.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Note what the protocol does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into "},{"code":"EntitlementSnapshot","type":"codeVoice"},{"type":"text","text":" values. A vanilla StoreKit conformer iterates "},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"type":"text","text":" and listens to "},{"code":"Transaction.updates","type":"codeVoice"},{"type":"text","text":". Either way, the plugin stays the same."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","sections":[],"references":{"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"topic","kind":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"role":"article","url":"\/documentation\/swidux\/entitystoreguide","title":"EntityStore"},"https://heirloomlogic.github.io/SwiduxRevenueCatPaywall/documentation/swiduxrevenuecatpaywall/":{"type":"link","url":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","title":"DocC reference","titleInlineContent":[{"type":"text","text":"DocC reference"}]},"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"url":"\/documentation\/swidux\/undoplugin","title":"UndoPlugin"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","type":"topic","kind":"article","abstract":[{"text":"Public API surface for the ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"role":"article","url":"\/documentation\/swidux\/pluginkillswitchreference","title":"SwiduxKillswitch Reference"},"doc://Swidux/documentation/Swidux/MacrosReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","type":"topic","kind":"article","abstract":[{"type":"text","text":"Reference for "},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"