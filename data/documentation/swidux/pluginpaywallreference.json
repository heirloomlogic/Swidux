{"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginpaywallreference"]}],"sections":[],"metadata":{"modules":[{"name":"Swidux"}],"title":"SwiduxPaywall Reference","roleHeading":"Article","role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"generated":true,"anchor":"Reference"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"text":". For where this plugin sits in the lifecycle, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}]},{"text":"Library target","type":"heading","anchor":"Library-target","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxPaywall","type":"codeVoice"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target dependencies in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" alongside ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"Provided implementations","type":"heading","anchor":"Provided-implementations","level":2},{"type":"paragraph","inlineContent":[{"text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"MockPaywallService","type":"codeVoice"},{"text":" — fixed snapshot, stream finishes immediately; for previews and tests.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"SimulatedPaywallService","type":"codeVoice"},{"text":" — a stateful, fully driveable service. Paired with the ","type":"text"},{"code":"SwiduxDevPaywallUI","type":"codeVoice"},{"text":" debug sheet, it lets a developer or QA tester grant Pro\/Trial\/Permanent, restore, and simulate failure\/latency — all flowing through the real plugin pipeline, with no SDK and no vendor commitment. Use it as the ","type":"text"},{"code":"service:","type":"codeVoice"},{"text":" while the paywall vendor decision is still open.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"For production RevenueCat integrations, the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},{"text":" companion package provides:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" — a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that bridges RevenueCat’s ","type":"text"},{"code":"CustomerInfo","type":"codeVoice"},{"text":" stream and ","type":"text"},{"code":"restorePurchases()","type":"codeVoice"},{"text":" API.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" — a RevenueCat-flavored mock for previews.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Full API documentation lives in the package’s own ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For other backends (StoreKit, custom server), implement ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" directly — see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"text":" Step 3, Path B.","type":"text"}]},{"text":"Resilient last-known-good decorator","type":"heading","anchor":"Resilient-last-known-good-decorator","level":3},{"type":"paragraph","inlineContent":[{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" wraps any ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" so a transient failure to read entitlements at cold launch never presents a previously-seen paid user as free. It retries with backoff, then falls back to a last-known-good snapshot persisted through an injected "},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":". Because that cache vouches for a paid entitlement while offline, back it with "},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" — not ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":", whose plist a user can edit or restore from a doctored backup:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feed the wrapped instance to both "},{"type":"codeVoice","code":"PaywallPlugin(..., service:)"},{"type":"text","text":" and any app-side entitlement reader. The live provider stays authoritative: any successful snapshot overwrites the cache. See the type’s own documentation for the staleness policy and threat model."}]},{"text":"Types","type":"heading","anchor":"Types","level":2},{"text":"`PaywallPlugin<RootState, RootAction>`","type":"heading","anchor":"PaywallPlugin%3CRootState-RootAction%3E","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"code":"PaywallState","type":"codeVoice"},{"text":" and an action enum typed as ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"]},{"inlineContent":[{"text":"The default ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" handler calls ","type":"text"},{"type":"codeVoice","code":"UIApplication.shared.open"},{"type":"text","text":" on UIKit and "},{"type":"codeVoice","code":"NSWorkspace.shared.open"},{"type":"text","text":" on AppKit. Override it for testing or for non-standard environments."}],"type":"paragraph"},{"type":"heading","text":"`PaywallState`","level":3,"anchor":"PaywallState"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sendable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" struct. The slice the plugin owns.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","    public var isObservingCustomerInfo: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false,","        isObservingCustomerInfo: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"]},{"type":"paragraph","inlineContent":[{"code":"isGateSatisfied","type":"codeVoice"},{"text":" is the single read your feature code should consult before running gated work. It is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" when the user holds an active pro subscription or a permanent license.","type":"text"}]},{"type":"heading","text":"`PaywallAction`","level":3,"anchor":"PaywallAction"},{"syntax":"swift","code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"],"type":"codeListing"},{"text":"`EntitlementSnapshot`","level":3,"anchor":"EntitlementSnapshot","type":"heading"},{"inlineContent":[{"text":"Provider-agnostic value the service emits to describe the user’s current entitlement.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"],"type":"codeListing"},{"text":"`PaywallService` (protocol)","level":3,"anchor":"PaywallService-protocol","type":"heading"},{"syntax":"swift","code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"],"type":"codeListing"},{"text":"`MockPaywallService`","level":3,"anchor":"MockPaywallService","type":"heading"},{"inlineContent":[{"text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"],"type":"codeListing"},{"text":"`SimulatedPaywallService`","level":3,"anchor":"SimulatedPaywallService","type":"heading"},{"inlineContent":[{"text":"Stateful ","type":"text"},{"code":"actor","type":"codeVoice"},{"text":" conformer for development and QA. Holds the current entitlement and multicasts changes through ","type":"text"},{"code":"customerInfoStream()","type":"codeVoice"},{"text":", so simulated grants survive a later ","type":"text"},{"code":"refreshCustomerInfo","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"restorePurchases","type":"codeVoice"},{"text":" exactly as a real service would.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public actor SimulatedPaywallService: PaywallService {","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        subsystem: String = \"Swidux\",","        category: String = \"Paywall\"","    )","","    \/\/ PaywallService: customerInfo \/ customerInfoStream \/ restorePurchases","","    \/\/ Simulation surface (not part of PaywallService — driven by the dev UI):","    public func grantPro()","    public func grantTrial()","    public func grantPermanentLicense()","    public func setFree()","    public func setRestoreShouldFail(_ shouldFail: Bool)","    public func setRefreshShouldFail(_ shouldFail: Bool)","    public func setArtificialDelay(_ delay: Duration)","}","","public enum SimulatedPaywallError: Error, Equatable {","    case restoreFailed","    case refreshFailed","}"],"type":"codeListing"},{"inlineContent":[{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":" only models ","type":"text"},{"code":"isPro","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"grantTrial()","type":"codeVoice"},{"text":" yields ","type":"text"},{"code":"isPro == true","type":"codeVoice"},{"text":" and is distinguished from ","type":"text"},{"code":"grantPro()","type":"codeVoice"},{"text":" only in the log line.","type":"text"}],"type":"paragraph"},{"text":"`SwiduxDevPaywallUI`","level":3,"anchor":"SwiduxDevPaywallUI","type":"heading"},{"inlineContent":[{"text":"A separate, opt-in library product (","type":"text"},{"code":"import SwiduxDevPaywallUI","type":"codeVoice"},{"text":") providing a bare-bones debug paywall sheet. It mirrors the shape of the vendor paywall UI so the call site is unchanged when a real provider is adopted:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["someView.devPaywall(","    state: store.paywall,","    service: simulatedPaywallService,","    onAction: { store.send(.paywall($0)) }",")"],"type":"codeListing"},{"inlineContent":[{"text":"The sheet shows the live ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":", grant buttons, real Restore\/Refresh flows, and QA failure\/latency toggles. On macOS the sheet uses a 400×600 minimum, matching the vendor paywall UI. Hold a ","type":"text"},{"inlineContent":[{"text":"single","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"SimulatedPaywallService","type":"codeVoice"},{"text":" instance and pass it to both ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" (as the plugin’s ","type":"text"},{"code":"service:","type":"codeVoice"},{"text":") and ","type":"text"},{"code":".devPaywall(...)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@State private var paywallService = SimulatedPaywallService()","@State private var store: AppStore","","init() {","    let service = SimulatedPaywallService()","    _paywallService = State(initialValue: service)","    _store = State(initialValue: .configured(paywallService: service))","}"],"type":"codeListing"},{"inlineContent":[{"text":"This is the one place a dev\/QA service is intentionally constructed outside ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":", because the debug UI must drive the same instance the plugin observes. Swapping to a real provider removes the shared-instance wiring and the ","type":"text"},{"code":"SwiduxDevPaywallUI","type":"codeVoice"},{"text":" import along with the two-line ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" change.","type":"text"}],"type":"paragraph"},{"text":"Action semantics","level":2,"anchor":"Action-semantics","type":"heading"},{"inlineContent":[{"text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns.","type":"text"}],"type":"paragraph"},{"text":"`request(reason: String)`","level":3,"anchor":"requestreason-String","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"isPresented = true","type":"codeVoice"},{"text":" and stores ","type":"text"},{"code":"requestedReason","type":"codeVoice"},{"text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase.","type":"text"}],"type":"paragraph"},{"text":"`dismiss`","level":3,"anchor":"dismiss","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"isPresented = false","type":"codeVoice"},{"text":" and clears ","type":"text"},{"code":"requestedReason","type":"codeVoice"},{"text":". Returns an effect that dispatches ","type":"text"},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up).","type":"text"}],"type":"paragraph"},{"text":"`observeCustomerInfo`","level":3,"anchor":"observeCustomerInfo","type":"heading"},{"inlineContent":[{"text":"Returns a long-lived effect that consumes ","type":"text"},{"code":"PaywallService.customerInfoStream()","type":"codeVoice"},{"text":" and dispatches ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" for every snapshot. Dispatch once on app launch (typically from a ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" on the root view). The effect lives for the duration of the stream. Idempotent: ","type":"text"},{"code":"isObservingCustomerInfo","type":"codeVoice"},{"text":" guards against double-subscription, so a re-dispatched ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" (view identity change, scene reconnect) won’t start a duplicate stream.","type":"text"}],"type":"paragraph"},{"text":"`refreshCustomerInfo`","level":3,"anchor":"refreshCustomerInfo","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"isLoading = true","type":"codeVoice"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"code":"PaywallService.customerInfo()","type":"codeVoice"},{"text":" and dispatches ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" on success or ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" on error.","type":"text"}],"type":"paragraph"},{"text":"`customerInfoUpdated(EntitlementSnapshot)`","level":3,"anchor":"customerInfoUpdatedEntitlementSnapshot","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"isPro","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":" from the snapshot, clears ","type":"text"},{"code":"isLoading","type":"codeVoice"},{"text":", and clears ","type":"text"},{"code":"error","type":"codeVoice"},{"text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly. Note that the plugin emits this on ","type":"text"},{"inlineContent":[{"text":"every","type":"text"}],"type":"strong"},{"text":" snapshot (each ","type":"text"},{"code":"customerInfoStream()","type":"codeVoice"},{"text":" value, every ","type":"text"},{"code":"refreshCustomerInfo","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"restorePurchases","type":"codeVoice"},{"text":"), not only on entitlement changes — observe ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":" (or a value derived from it) for transitions rather than mapping this action directly. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"`refreshFailed(String)`","level":3,"anchor":"refreshFailedString","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"error","type":"codeVoice"},{"text":" to the given message and clears ","type":"text"},{"code":"isLoading","type":"codeVoice"},{"text":". Returns no effect.","type":"text"}],"type":"paragraph"},{"text":"`restorePurchases`","level":3,"anchor":"restorePurchases","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"isLoading = true","type":"codeVoice"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"code":"PaywallService.restorePurchases()","type":"codeVoice"},{"text":" and dispatches ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" on success or ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" on error.","type":"text"}],"type":"paragraph"},{"text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","level":3,"anchor":"presentCustomerCenter--dismissCustomerCenter","type":"heading"},{"inlineContent":[{"text":"Toggle ","type":"text"},{"code":"isCustomerCenterPresented","type":"codeVoice"},{"text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does).","type":"text"}],"type":"paragraph"},{"text":"`openManageSubscriptions`","level":3,"anchor":"openManageSubscriptions","type":"heading"},{"inlineContent":[{"text":"Returns an effect that opens ","type":"text"},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"text":" via the configured ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS.","type":"text"}],"type":"paragraph"},{"text":"Implementing a `PaywallService`","level":2,"anchor":"Implementing-a-PaywallService","type":"heading"},{"inlineContent":[{"text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an ","type":"text"},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The protocol has three methods:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfo() async throws -> EntitlementSnapshot"}]},{"type":"text","text":" — One-shot fetch of the current entitlement. The plugin calls this from "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>"}]},{"type":"text","text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"restorePurchases() async throws -> EntitlementSnapshot"}]},{"type":"text","text":" — Performs a restore against the user’s account and returns the resulting entitlement."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Note what the protocol does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into ","type":"text"},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":" values. A vanilla StoreKit conformer iterates ","type":"text"},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"text":" and listens to ","type":"text"},{"code":"Transaction.updates","type":"codeVoice"},{"text":". Either way, the plugin stays the same.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"references":{"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"title":"Persistence Middleware","type":"topic","url":"\/documentation\/swidux\/persistencemiddlewareguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","u