{"sections":[],"metadata":{"role":"article","modules":[{"name":"Swidux"}],"title":"SwiduxPaywall Reference","roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"text":". For where this plugin sits in the lifecycle, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}]},{"type":"heading","level":2,"anchor":"Library-target","text":"Library target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"type":"codeVoice","code":"import SwiduxPaywall"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"Provided implementations","anchor":"Provided-implementations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockPaywallService"},{"text":" — fixed snapshot, stream finishes immediately; for previews and tests.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"SimulatedPaywallService"},{"text":" — a stateful, fully driveable service. Paired with the ","type":"text"},{"type":"codeVoice","code":"SwiduxDevPaywallUI"},{"text":" debug sheet, it lets a developer or QA tester grant Pro\/Trial\/Permanent, restore, and simulate failure\/latency — all flowing through the real plugin pipeline, with no SDK and no vendor commitment. Use it as the ","type":"text"},{"type":"codeVoice","code":"service:"},{"text":" while the paywall vendor decision is still open.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For production RevenueCat integrations, the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},{"type":"text","text":" companion package provides:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"RevenueCatPaywallService"},{"text":" — a ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" conformer that bridges RevenueCat’s ","type":"text"},{"type":"codeVoice","code":"CustomerInfo"},{"text":" stream and ","type":"text"},{"type":"codeVoice","code":"restorePurchases()"},{"text":" API.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"text":" — a RevenueCat-flavored mock for previews.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Full API documentation lives in the package’s own "},{"type":"reference","isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For other backends (StoreKit, custom server), implement "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" directly — see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"type":"text","text":" Step 3, Path B."}]},{"level":2,"type":"heading","text":"Types","anchor":"Types"},{"level":3,"type":"heading","text":"`PaywallPlugin<RootState, RootAction>`","anchor":"PaywallPlugin%3CRootState-RootAction%3E"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":" and an action enum typed as "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler calls "},{"type":"codeVoice","code":"UIApplication.shared.open"},{"type":"text","text":" on UIKit and "},{"type":"codeVoice","code":"NSWorkspace.shared.open"},{"type":"text","text":" on AppKit. Override it for testing or for non-standard environments."}]},{"level":3,"type":"heading","text":"`PaywallState`","anchor":"PaywallState"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" struct. The slice the plugin owns."}]},{"syntax":"swift","type":"codeListing","code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","    public var isObservingCustomerInfo: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false,","        isObservingCustomerInfo: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isGateSatisfied"},{"type":"text","text":" is the single read your feature code should consult before running gated work. It is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when the user holds an active pro subscription or a permanent license."}]},{"level":3,"type":"heading","text":"`PaywallAction`","anchor":"PaywallAction"},{"syntax":"swift","type":"codeListing","code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"]},{"level":3,"type":"heading","text":"`EntitlementSnapshot`","anchor":"EntitlementSnapshot"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provider-agnostic value the service emits to describe the user’s current entitlement."}]},{"syntax":"swift","type":"codeListing","code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"]},{"level":3,"type":"heading","text":"`PaywallService` (protocol)","anchor":"PaywallService-protocol"},{"syntax":"swift","type":"codeListing","code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"level":3,"type":"heading","text":"`MockPaywallService`","anchor":"MockPaywallService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately."}]},{"syntax":"swift","type":"codeListing","code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"level":3,"type":"heading","text":"`SimulatedPaywallService`","anchor":"SimulatedPaywallService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Stateful "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" conformer for development and QA. Holds the current entitlement and multicasts changes through "},{"type":"codeVoice","code":"customerInfoStream()"},{"type":"text","text":", so simulated grants survive a later "},{"type":"codeVoice","code":"refreshCustomerInfo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"restorePurchases"},{"type":"text","text":" exactly as a real service would."}]},{"syntax":"swift","type":"codeListing","code":["public actor SimulatedPaywallService: PaywallService {","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        subsystem: String = \"Swidux\",","        category: String = \"Paywall\"","    )","","    \/\/ PaywallService: customerInfo \/ customerInfoStream \/ restorePurchases","","    \/\/ Simulation surface (not part of PaywallService — driven by the dev UI):","    public func grantPro()","    public func grantTrial()","    public func grantPermanentLicense()","    public func setFree()","    public func setRestoreShouldFail(_ shouldFail: Bool)","    public func setRefreshShouldFail(_ shouldFail: Bool)","    public func setArtificialDelay(_ delay: Duration)","}","","public enum SimulatedPaywallError: Error, Equatable {","    case restoreFailed","    case refreshFailed","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" only models "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":", so "},{"type":"codeVoice","code":"grantTrial()"},{"type":"text","text":" yields "},{"type":"codeVoice","code":"isPro == true"},{"type":"text","text":" and is distinguished from "},{"type":"codeVoice","code":"grantPro()"},{"type":"text","text":" only in the log line."}]},{"level":3,"type":"heading","text":"`SwiduxDevPaywallUI`","anchor":"SwiduxDevPaywallUI"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A separate, opt-in library product ("},{"type":"codeVoice","code":"import SwiduxDevPaywallUI"},{"type":"text","text":") providing a bare-bones debug paywall sheet. It mirrors the shape of the vendor paywall UI so the call site is unchanged when a real provider is adopted:"}]},{"syntax":"swift","type":"codeListing","code":["someView.devPaywall(","    state: store.paywall,","    service: simulatedPaywallService,","    onAction: { store.send(.paywall($0)) }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sheet shows the live "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":", grant buttons, real Restore\/Refresh flows, and QA failure\/latency toggles. On macOS the sheet uses a 400×600 minimum, matching the vendor paywall UI. Hold a "},{"type":"strong","inlineContent":[{"text":"single","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"SimulatedPaywallService"},{"type":"text","text":" instance and pass it to both "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" (as the plugin’s "},{"type":"codeVoice","code":"service:"},{"type":"text","text":") and "},{"type":"codeVoice","code":".devPaywall(...)"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["@State private var paywallService = SimulatedPaywallService()","@State private var store: AppStore","","init() {","    let service = SimulatedPaywallService()","    _paywallService = State(initialValue: service)","    _store = State(initialValue: .configured(paywallService: service))","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the one place a dev\/QA service is intentionally constructed outside "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":", because the debug UI must drive the same instance the plugin observes. Swapping to a real provider removes the shared-instance wiring and the "},{"type":"codeVoice","code":"SwiduxDevPaywallUI"},{"type":"text","text":" import along with the two-line "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" change."}]},{"level":2,"type":"heading","text":"Action semantics","anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}]},{"level":3,"type":"heading","text":"`request(reason: String)`","anchor":"requestreason-String"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPresented = true"},{"type":"text","text":" and stores "},{"type":"codeVoice","code":"requestedReason"},{"type":"text","text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase."}]},{"level":3,"type":"heading","text":"`dismiss`","anchor":"dismiss"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPresented = false"},{"type":"text","text":" and clears "},{"type":"codeVoice","code":"requestedReason"},{"type":"text","text":". Returns an effect that dispatches "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up)."}]},{"level":3,"type":"heading","text":"`observeCustomerInfo`","anchor":"observeCustomerInfo"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns a long-lived effect that consumes "},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" for every snapshot. Dispatch once on app launch (typically from a "},{"type":"codeVoice","code":".task"},{"type":"text","text":" on the root view). The effect lives for the duration of the stream. Idempotent: "},{"type":"codeVoice","code":"isObservingCustomerInfo"},{"type":"text","text":" guards against double-subscription, so a re-dispatched "},{"type":"codeVoice","code":".task"},{"type":"text","text":" (view identity change, scene reconnect) won’t start a duplicate stream."}]},{"level":3,"type":"heading","text":"`refreshCustomerInfo`","anchor":"refreshCustomerInfo"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isLoading = true"},{"type":"text","text":". Returns a one-shot effect that calls "},{"type":"codeVoice","code":"PaywallService.customerInfo()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" on error."}]},{"level":3,"type":"heading","text":"`customerInfoUpdated(EntitlementSnapshot)`","anchor":"customerInfoUpdatedEntitlementSnapshot"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" from the snapshot, clears "},{"type":"codeVoice","code":"isLoading"},{"type":"text","text":", and clears "},{"type":"codeVoice","code":"error"},{"type":"text","text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly. Note that the plugin emits this on "},{"type":"strong","inlineContent":[{"text":"every","type":"text"}]},{"type":"text","text":" snapshot (each "},{"type":"codeVoice","code":"customerInfoStream()"},{"type":"text","text":" value, every "},{"type":"codeVoice","code":"refreshCustomerInfo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"restorePurchases"},{"type":"text","text":"), not only on entitlement changes — observe "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":" (or a value derived from it) for transitions rather than mapping this action directly. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation"},{"type":"text","text":"."}]},{"level":3,"type":"heading","text":"`refreshFailed(String)`","anchor":"refreshFailedString"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"error"},{"type":"text","text":" to the given message and clears "},{"type":"codeVoice","code":"isLoading"},{"type":"text","text":". Returns no effect."}]},{"level":3,"type":"heading","text":"`restorePurchases`","anchor":"restorePurchases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isLoading = true"},{"type":"text","text":". Returns a one-shot effect that calls "},{"type":"codeVoice","code":"PaywallService.restorePurchases()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" on error."}]},{"level":3,"type":"heading","text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","anchor":"presentCustomerCenter--dismissCustomerCenter"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Toggle "},{"type":"codeVoice","code":"isCustomerCenterPresented"},{"type":"text","text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does)."}]},{"level":3,"type":"heading","text":"`openManageSubscriptions`","anchor":"openManageSubscriptions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns an effect that opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" via the configured "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS."}]},{"level":2,"type":"heading","text":"Implementing a `PaywallService`","anchor":"Implementing-a-PaywallService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol has three methods:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfo() async throws -> EntitlementSnapshot"}]},{"text":" — One-shot fetch of the current entitlement. The plugin calls this from ","type":"text"},{"type":"codeVoice","code":".refreshCustomerInfo"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>"}]},{"text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from ","type":"text"},{"type":"codeVoice","code":".observeCustomerInfo"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"restorePurchases() async throws -> EntitlementSnapshot"}]},{"text":" — Performs a restore against the user’s account and returns the resulting entitlement.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note what the protocol does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" values. A vanilla StoreKit conformer iterates "},{"type":"codeVoice","code":"Transaction.currentEntitlements"},{"type":"text","text":" and listens to "},{"type":"codeVoice","code":"Transaction.updates"},{"type":"text","text":". Either way, the plugin stays the same."}]}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"kind":"article","identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference","anchor":"Reference","generated":true}],"variants":[{"paths":["\/documentation\/swidux\/pluginpaywallreference"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Swidux/documentation/Swidux/PluginArchitecture":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","role":"article","kind":"article","url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"title":"Plugin Architecture","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","role":"article"},"doc://Swidux/documentation/Swidux/UndoRedo":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","role":"article","kind":"article","url":"\/documentation\/swidux\/undoredo","title":"Undo \/ Redo","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","role":"article","url":"\/documentation\/swidux\/pluginkillswitchreference","title":"SwiduxKillswitch Reference"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","role":"article","url":"\/docume