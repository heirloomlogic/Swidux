{"sections":[],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"title":"Reference","generated":true}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"title":"SwiduxPaywall Reference","role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"variants":[{"paths":["\/documentation\/swidux\/pluginpaywallreference"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions."}]},{"inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Library target","anchor":"Library-target"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxPaywall"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Import: ","type":"text"},{"type":"codeVoice","code":"import SwiduxPaywall"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" alongside "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Provided implementations","anchor":"Provided-implementations","type":"heading"},{"inlineContent":[{"type":"text","text":"The plugin ships with "},{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" for previews and tests. For production RevenueCat integrations, the "},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"reference","isActive":true},{"type":"text","text":" companion package provides:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" — a "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that bridges RevenueCat’s "},{"type":"codeVoice","code":"CustomerInfo"},{"type":"text","text":" stream and "},{"type":"codeVoice","code":"restorePurchases()"},{"type":"text","text":" API."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" — a RevenueCat-flavored mock for previews."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For other backends (StoreKit, custom server), implement "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" directly — see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"type":"text","text":" Step 3, Path B."}],"type":"paragraph"},{"level":2,"text":"Types","anchor":"Types","type":"heading"},{"type":"heading","level":3,"text":"`PaywallPlugin<RootState, RootAction>`","anchor":"PaywallPlugin%3CRootState-RootAction%3E"},{"type":"paragraph","inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" "},{"code":"SwiduxPlugin","type":"codeVoice"},{"text":" conformer. Owns a slice of root state typed as ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":" and an action enum typed as ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"]},{"type":"paragraph","inlineContent":[{"text":"The default ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" handler calls ","type":"text"},{"code":"UIApplication.shared.open","type":"codeVoice"},{"text":" on UIKit and ","type":"text"},{"code":"NSWorkspace.shared.open","type":"codeVoice"},{"text":" on AppKit. Override it for testing or for non-standard environments.","type":"text"}]},{"type":"heading","level":3,"text":"`PaywallState`","anchor":"PaywallState"},{"type":"paragraph","inlineContent":[{"code":"Sendable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" struct. The slice the plugin owns.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"]},{"type":"paragraph","inlineContent":[{"code":"isGateSatisfied","type":"codeVoice"},{"text":" is the single read your feature code should consult before running gated work. It is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" when the user holds an active pro subscription or a permanent license.","type":"text"}]},{"type":"heading","level":3,"text":"`PaywallAction`","anchor":"PaywallAction"},{"type":"codeListing","syntax":"swift","code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"]},{"type":"heading","level":3,"text":"`EntitlementSnapshot`","anchor":"EntitlementSnapshot"},{"type":"paragraph","inlineContent":[{"text":"Provider-agnostic value the service emits to describe the user’s current entitlement.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"]},{"type":"heading","level":3,"text":"`PaywallService` (protocol)","anchor":"PaywallService-protocol"},{"type":"codeListing","syntax":"swift","code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"type":"heading","level":3,"text":"`MockPaywallService`","anchor":"MockPaywallService"},{"type":"paragraph","inlineContent":[{"text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"type":"heading","level":2,"text":"Action semantics","anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns.","type":"text"}]},{"type":"heading","level":3,"text":"`request(reason: String)`","anchor":"requestreason-String"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"isPresented = true","type":"codeVoice"},{"text":" and stores ","type":"text"},{"code":"requestedReason","type":"codeVoice"},{"text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase.","type":"text"}]},{"type":"heading","level":3,"text":"`dismiss`","anchor":"dismiss"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"isPresented = false","type":"codeVoice"},{"text":" and clears ","type":"text"},{"code":"requestedReason","type":"codeVoice"},{"text":". Returns an effect that dispatches ","type":"text"},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up).","type":"text"}]},{"type":"heading","level":3,"text":"`observeCustomerInfo`","anchor":"observeCustomerInfo"},{"type":"paragraph","inlineContent":[{"text":"Returns a long-lived effect that consumes ","type":"text"},{"code":"PaywallService.customerInfoStream()","type":"codeVoice"},{"text":" and dispatches ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" for every snapshot. Dispatch once on app launch (typically from a ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" on the root view). The effect lives for the duration of the stream.","type":"text"}]},{"type":"heading","level":3,"text":"`refreshCustomerInfo`","anchor":"refreshCustomerInfo"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"isLoading = true","type":"codeVoice"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"code":"PaywallService.customerInfo()","type":"codeVoice"},{"text":" and dispatches ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" on success or ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" on error.","type":"text"}]},{"type":"heading","level":3,"text":"`customerInfoUpdated(EntitlementSnapshot)`","anchor":"customerInfoUpdatedEntitlementSnapshot"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"isPro","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":" from the snapshot, clears ","type":"text"},{"code":"isLoading","type":"codeVoice"},{"text":", and clears ","type":"text"},{"code":"error","type":"codeVoice"},{"text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly.","type":"text"}]},{"type":"heading","level":3,"text":"`refreshFailed(String)`","anchor":"refreshFailedString"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"error","type":"codeVoice"},{"text":" to the given message and clears ","type":"text"},{"code":"isLoading","type":"codeVoice"},{"text":". Returns no effect.","type":"text"}]},{"type":"heading","level":3,"text":"`restorePurchases`","anchor":"restorePurchases"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"isLoading = true","type":"codeVoice"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"code":"PaywallService.restorePurchases()","type":"codeVoice"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" on error."}]},{"type":"heading","level":3,"text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","anchor":"presentCustomerCenter--dismissCustomerCenter"},{"type":"paragraph","inlineContent":[{"text":"Toggle ","type":"text"},{"type":"codeVoice","code":"isCustomerCenterPresented"},{"text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does).","type":"text"}]},{"type":"heading","level":3,"text":"`openManageSubscriptions`","anchor":"openManageSubscriptions"},{"type":"paragraph","inlineContent":[{"text":"Returns an effect that opens ","type":"text"},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"text":" via the configured ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS.","type":"text"}]},{"type":"heading","level":2,"text":"Implementing a `PaywallService`","anchor":"Implementing-a-PaywallService"},{"type":"paragraph","inlineContent":[{"text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The protocol has three methods:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"customerInfo() async throws -> EntitlementSnapshot","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — One-shot fetch of the current entitlement. The plugin calls this from "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"restorePurchases() async throws -> EntitlementSnapshot","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Performs a restore against the user’s account and returns the resulting entitlement."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Note what the protocol does ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into "},{"code":"EntitlementSnapshot","type":"codeVoice"},{"type":"text","text":" values. A vanilla StoreKit conformer iterates "},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"type":"text","text":" and listens to "},{"code":"Transaction.updates","type":"codeVoice"},{"type":"text","text":". Either way, the plugin stays the same."}]}]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"references":{"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","role":"collectionGroup","title":"KeyValueStore","url":"\/documentation\/swidux\/keyvaluestoreguide","type":"topic","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","role":"article","title":"Add a Paywall","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"type":"topic","url":"\/documentation\/swidux\/howtoaddapaywall"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"title":"Persistence Middleware","url":"\/documentation\/swidux\/persistencemiddlewareguide","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},"doc://Swidux/documentation/Swidux/GettingStarted":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","role":"article","url":"\/documentation\/swidux\/gettingstarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"type":"topic","title":"Getting Started with Swidux"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"title":"SwiduxFeatureFlags Reference","url":"\/documentation\/swidux\/pluginfeatureflagsreference","kind":"article","type":"topic","role":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},"doc://Swidux/documentation/Swidux":{"title":"Swidux","url":"\/documentation\/swidux","type":"topic","kind":"symbol","role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","role":"article","title":"SwiduxParentalGate Reference","abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"type":"topic","url":"\/documentation\/swidux\/pluginparentalgatereference"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"title":"EntityStore","url":"\/documentation\/swidux\/entitystoreguide","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},"doc://Swidux/documentation/Swidux/MacrosReference":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","type":"topic","abstract":[{"text":"Reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" — the two macros that generate the observation bridge between value-type state and SwiftUI.","type":"text"}],"title":"Macros","url":"\/documentation\/swidux\/macrosreference","role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"title":"UndoPlugin","url":"\/documentation\/swidux\/undoplugin","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}],"type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"title":"SwiduxKillswitch Reference","url":"\/documentation\/swidux\/pluginkillswitchreference","type":"topic","kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","abstract":[{"text":"Public API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}]},"doc://Swidux/documentation/Swidux/UndoRedo":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","kind":"article","type":"topic","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"text":".","type":"text"}],"title":"Undo \/ Redo","url":"\/documentation\/swidux\/undoredo","role":"article"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","role":"article","url":"\/documentation\/swidux\/pluginanalyticsreference","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"type":"topic","title":"SwiduxAnalytics Reference"},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"link","titleInlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"}],"title":"SwiduxRevenueCatPaywall"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","role":"article","title":"Plugin Architecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"type":"topic","url":"\/documentation\/swidux\/pluginarchitecture"}}}