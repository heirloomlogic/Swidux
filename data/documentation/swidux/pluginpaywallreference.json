{"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"title":"Reference","anchor":"Reference","generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"]}],"kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"Swidux"}],"role":"article","title":"SwiduxPaywall Reference","roleHeading":"Article"},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions."}]},{"type":"paragraph","inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"reference"},{"text":". For where this plugin sits in the lifecycle, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":".","type":"text"}]},{"anchor":"Library-target","type":"heading","text":"Library target","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Product: ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"}]}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxPaywall","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target dependencies in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":" alongside ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":".","type":"text"}]},{"anchor":"Provided-implementations","type":"heading","text":"Provided implementations","level":2},{"inlineContent":[{"type":"text","text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"MockPaywallService","type":"codeVoice"},{"text":" — fixed snapshot, stream finishes immediately; for previews and tests.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SimulatedPaywallService"},{"text":" — a stateful, fully driveable service. Paired with the ","type":"text"},{"type":"codeVoice","code":"SwiduxDevPaywallUI"},{"text":" debug sheet, it lets a developer or QA tester grant Pro\/Trial\/Permanent, restore, and simulate failure\/latency — all flowing through the real plugin pipeline, with no SDK and no vendor commitment. Use it as the ","type":"text"},{"code":"service:","type":"codeVoice"},{"text":" while the paywall vendor decision is still open.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"For production RevenueCat integrations, the ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"reference"},{"text":" companion package provides:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"RevenueCatPaywallService"},{"text":" — a ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" conformer that bridges RevenueCat’s ","type":"text"},{"type":"codeVoice","code":"CustomerInfo"},{"type":"text","text":" stream and "},{"type":"codeVoice","code":"restorePurchases()"},{"type":"text","text":" API."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" — a RevenueCat-flavored mock for previews."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"For other backends (StoreKit, custom server), implement ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" directly — see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"reference","isActive":true},{"text":" Step 3, Path B.","type":"text"}],"type":"paragraph"},{"text":"Types","level":2,"type":"heading","anchor":"Types"},{"text":"`PaywallPlugin<RootState, RootAction>`","anchor":"PaywallPlugin%3CRootState-RootAction%3E","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SwiduxPlugin"},{"text":" conformer. Owns a slice of root state typed as ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":" and an action enum typed as ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"]},{"inlineContent":[{"text":"The default ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" handler calls ","type":"text"},{"type":"codeVoice","code":"UIApplication.shared.open"},{"text":" on UIKit and ","type":"text"},{"type":"codeVoice","code":"NSWorkspace.shared.open"},{"text":" on AppKit. Override it for testing or for non-standard environments.","type":"text"}],"type":"paragraph"},{"text":"`PaywallState`","anchor":"PaywallState","type":"heading","level":3},{"inlineContent":[{"type":"codeVoice","code":"Sendable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" struct. The slice the plugin owns.","type":"text"}],"type":"paragraph"},{"code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"isGateSatisfied"},{"text":" is the single read your feature code should consult before running gated work. It is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" when the user holds an active pro subscription or a permanent license.","type":"text"}],"type":"paragraph"},{"text":"`PaywallAction`","anchor":"PaywallAction","type":"heading","level":3},{"code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"],"type":"codeListing","syntax":"swift"},{"text":"`EntitlementSnapshot`","anchor":"EntitlementSnapshot","type":"heading","level":3},{"inlineContent":[{"text":"Provider-agnostic value the service emits to describe the user’s current entitlement.","type":"text"}],"type":"paragraph"},{"code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"],"type":"codeListing","syntax":"swift"},{"text":"`PaywallService` (protocol)","anchor":"PaywallService-protocol","type":"heading","level":3},{"code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"],"type":"codeListing","syntax":"swift"},{"text":"`MockPaywallService`","anchor":"MockPaywallService","type":"heading","level":3},{"inlineContent":[{"text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately.","type":"text"}],"type":"paragraph"},{"code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"],"type":"codeListing","syntax":"swift"},{"text":"`SimulatedPaywallService`","anchor":"SimulatedPaywallService","type":"heading","level":3},{"inlineContent":[{"text":"Stateful ","type":"text"},{"type":"codeVoice","code":"actor"},{"text":" conformer for development and QA. Holds the current entitlement and multicasts changes through ","type":"text"},{"type":"codeVoice","code":"customerInfoStream()"},{"text":", so simulated grants survive a later ","type":"text"},{"type":"codeVoice","code":"refreshCustomerInfo"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"restorePurchases"},{"text":" exactly as a real service would.","type":"text"}],"type":"paragraph"},{"code":["public actor SimulatedPaywallService: PaywallService {","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        subsystem: String = \"Swidux\",","        category: String = \"Paywall\"","    )","","    \/\/ PaywallService: customerInfo \/ customerInfoStream \/ restorePurchases","","    \/\/ Simulation surface (not part of PaywallService — driven by the dev UI):","    public func grantPro()","    public func grantTrial()","    public func grantPermanentLicense()","    public func setFree()","    public func setRestoreShouldFail(_ shouldFail: Bool)","    public func setRefreshShouldFail(_ shouldFail: Bool)","    public func setArtificialDelay(_ delay: Duration)","}","","public enum SimulatedPaywallError: Error, Equatable {","    case restoreFailed","    case refreshFailed","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"EntitlementSnapshot"},{"text":" only models ","type":"text"},{"type":"codeVoice","code":"isPro"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":", so ","type":"text"},{"type":"codeVoice","code":"grantTrial()"},{"text":" yields ","type":"text"},{"type":"codeVoice","code":"isPro == true"},{"text":" and is distinguished from ","type":"text"},{"type":"codeVoice","code":"grantPro()"},{"text":" only in the log line.","type":"text"}],"type":"paragraph"},{"text":"`SwiduxDevPaywallUI`","anchor":"SwiduxDevPaywallUI","type":"heading","level":3},{"inlineContent":[{"text":"A separate, opt-in library product (","type":"text"},{"type":"codeVoice","code":"import SwiduxDevPaywallUI"},{"text":") providing a bare-bones debug paywall sheet. It mirrors the shape of the vendor paywall UI so the call site is unchanged when a real provider is adopted:","type":"text"}],"type":"paragraph"},{"code":["someView.devPaywall(","    state: store.paywall,","    service: simulatedPaywallService,","    onAction: { store.send(.paywall($0)) }",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The sheet shows the live ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":", grant buttons, real Restore\/Refresh flows, and QA failure\/latency toggles. On macOS the sheet uses a 400×600 minimum, matching the vendor paywall UI. Hold a ","type":"text"},{"inlineContent":[{"type":"text","text":"single"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SimulatedPaywallService"},{"text":" instance and pass it to both ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" (as the plugin’s ","type":"text"},{"type":"codeVoice","code":"service:"},{"text":") and ","type":"text"},{"type":"codeVoice","code":".devPaywall(...)"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["@State private var paywallService = SimulatedPaywallService()","@State private var store: AppStore","","init() {","    let service = SimulatedPaywallService()","    _paywallService = State(initialValue: service)","    _store = State(initialValue: .configured(paywallService: service))","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"This is the one place a dev\/QA service is intentionally constructed outside ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":", because the debug UI must drive the same instance the plugin observes. Swapping to a real provider removes the shared-instance wiring and the ","type":"text"},{"type":"codeVoice","code":"SwiduxDevPaywallUI"},{"text":" import along with the two-line ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" change.","type":"text"}],"type":"paragraph"},{"text":"Action semantics","anchor":"Action-semantics","type":"heading","level":2},{"inlineContent":[{"text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns.","type":"text"}],"type":"paragraph"},{"text":"`request(reason: String)`","anchor":"requestreason-String","type":"heading","level":3},{"inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isPresented = true"},{"text":" and stores ","type":"text"},{"type":"codeVoice","code":"requestedReason"},{"text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase.","type":"text"}],"type":"paragraph"},{"text":"`dismiss`","anchor":"dismiss","type":"heading","level":3},{"inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isPresented = false"},{"text":" and clears ","type":"text"},{"type":"codeVoice","code":"requestedReason"},{"text":". Returns an effect that dispatches ","type":"text"},{"type":"codeVoice","code":".refreshCustomerInfo"},{"text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up).","type":"text"}],"type":"paragraph"},{"text":"`observeCustomerInfo`","anchor":"observeCustomerInfo","type":"heading","level":3},{"inlineContent":[{"text":"Returns a long-lived effect that consumes ","type":"text"},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"text":" and dispatches ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" for every snapshot. Dispatch once on app launch (typically from a ","type":"text"},{"type":"codeVoice","code":".task"},{"text":" on the root view). The effect lives for the duration of the stream.","type":"text"}],"type":"paragraph"},{"text":"`refreshCustomerInfo`","anchor":"refreshCustomerInfo","type":"heading","level":3},{"inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isLoading = true"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"type":"codeVoice","code":"PaywallService.customerInfo()"},{"text":" and dispatches ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" on success or ","type":"text"},{"type":"codeVoice","code":".refreshFailed"},{"text":" on error.","type":"text"}],"type":"paragraph"},{"text":"`customerInfoUpdated(EntitlementSnapshot)`","anchor":"customerInfoUpdatedEntitlementSnapshot","type":"heading","level":3},{"inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isPro"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":" from the snapshot, clears ","type":"text"},{"type":"codeVoice","code":"isLoading"},{"text":", and clears ","type":"text"},{"type":"codeVoice","code":"error"},{"text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly. Note that the plugin emits this on ","type":"text"},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"text":" snapshot (each ","type":"text"},{"type":"codeVoice","code":"customerInfoStream()"},{"text":" value, every ","type":"text"},{"type":"codeVoice","code":"refreshCustomerInfo"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"restorePurchases"},{"text":"), not only on entitlement changes — observe ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":" (or a value derived from it) for transitions rather than mapping this action directly. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"`refreshFailed(String)`","anchor":"refreshFailedString","type":"heading","level":3},{"inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"error"},{"text":" to the given message and clears ","type":"text"},{"type":"codeVoice","code":"isLoading"},{"text":". Returns no effect.","type":"text"}],"type":"paragraph"},{"text":"`restorePurchases`","anchor":"restorePurchases","type":"heading","level":3},{"inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isLoading = true"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"type":"codeVoice","code":"PaywallService.restorePurchases()"},{"text":" and dispatches ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" on success or ","type":"text"},{"type":"codeVoice","code":".refreshFailed"},{"text":" on error.","type":"text"}],"type":"paragraph"},{"text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","anchor":"presentCustomerCenter--dismissCustomerCenter","type":"heading","level":3},{"inlineContent":[{"text":"Toggle ","type":"text"},{"code":"isCustomerCenterPresented","type":"codeVoice"},{"text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does).","type":"text"}],"type":"paragraph"},{"text":"`openManageSubscriptions`","anchor":"openManageSubscriptions","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Returns an effect that opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" via the configured "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS."}],"type":"paragraph"},{"text":"Implementing a `PaywallService`","anchor":"Implementing-a-PaywallService","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol has three methods:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"customerInfo() async throws -> EntitlementSnapshot"}],"type":"strong"},{"text":" — One-shot fetch of the current entitlement. The plugin calls this from ","type":"text"},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>"}],"type":"strong"},{"text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from ","type":"text"},{"code":".observeCustomerInfo","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"restorePurchases() async throws -> EntitlementSnapshot"}]},{"type":"text","text":" — Performs a restore against the user’s account and returns the resulting entitlement."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Note what the protocol does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into "},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":" values. A vanilla StoreKit conformer iterates ","type":"text"},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"text":" and listens to ","type":"text"},{"type":"codeVoice","code":"Transaction.updates"},{"text":". Either way, the plugin stays the same.","type":"text"}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"paths":["\/documentation\/swidux\/pluginpaywallreference"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","interfaceLanguage":"swift"},"references":{"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"title":"SwiduxParentalGate Reference","url":"\/documentation\/swidux\/pluginparentalgatereference","kind":"article","abstract":[{"text":"API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","kind":"article","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"title":"KeyValueStore","type":"topic","url":"\/documentation\/swidux\/keyvaluestoreguide","role":"collectionGroup"},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"title":"Service-Result Actions and Transition Observation","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","url":"\/documentation\/swidux\/pluginarchitecture#Service-Result-Actions-and-Transition-Observation","abstract":[],"type":"topic","kind":"section"},"doc://Swidux/documentation/Swidux/UndoRedo":{"title":"Undo \/ Redo","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference","isActive":true},{"text":".","type":"text"}],"url":"\/documentation\/swidux\/undoredo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/MacrosReference":{"title":"Macros","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"text":" — the two macros that generate the observation bridge between value-type state and SwiftUI.","type":"text"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","url":"\/documentation\/swidux\/macrosreference","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"title":"Persistence Middleware","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","url":"\/documentation\/swidux\/persistencemiddlewareguide","kind":"article","role":"article"},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"title":"SwiduxRevenueCatPaywall","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","titleInlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"}],"url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"link"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","kind":"article","title":"SwiduxKillswitch Reference","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"url":"\/documentation\/swidux\/pluginkillswitchreference","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","kind":"article","title":"Add a Paywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"title":"EntityStore","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","url":"\/documentation\/swidux\/entitystoreguide","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"title":"Swidux","type":"topic","url":"\/documentation\/swidux","role":"collection"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"title":"SwiduxFeatureFlags Reference","type":"topic","url":"\/documentation\/swidux\/pluginfeatureflagsreference","role":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","kind":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"title":"Getting Started with Swidux","type":"topic","url":"\/documentation\/swidux\/gettingstarted","role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"title":"UndoPlugin","url":"\/documentation\/swidux\/undoplugin","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}],"type":"topic","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","kind":"article","title":"Plugin Architecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"url":"\/documentation\/swidux\/pluginarchitecture","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"title":"SwiduxAnalytics Reference","url":"\/documentation\/swidux\/pluginanalyticsreference","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference"}}}