{"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"anchor":"Reference","generated":true,"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"text":". For where this plugin sits in the lifecycle, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Library target","anchor":"Library-target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"type":"codeVoice","code":"import SwiduxPaywall"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target dependencies in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":" alongside ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Provided implementations","anchor":"Provided-implementations"},{"type":"paragraph","inlineContent":[{"text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockPaywallService"},{"text":" — fixed snapshot, stream finishes immediately; for previews and tests.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"SimulatedPaywallService"},{"text":" — a stateful, fully driveable service. Paired with the ","type":"text"},{"type":"codeVoice","code":"SwiduxDevPaywallUI"},{"text":" debug sheet, it lets a developer or QA tester grant Pro\/Trial\/Permanent, restore, and simulate failure\/latency — all flowing through the real plugin pipeline, with no SDK and no vendor commitment. Use it as the ","type":"text"},{"type":"codeVoice","code":"service:"},{"text":" while the paywall vendor decision is still open.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"For production RevenueCat integrations, the ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},{"text":" companion package provides:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"RevenueCatPaywallService"},{"text":" — a ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" conformer that bridges RevenueCat’s ","type":"text"},{"type":"codeVoice","code":"CustomerInfo"},{"text":" stream and ","type":"text"},{"type":"codeVoice","code":"restorePurchases()"},{"text":" API.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"text":" — a RevenueCat-flavored mock for previews.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Full API documentation lives in the package’s own ","type":"text"},{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For other backends (StoreKit, custom server), implement ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" directly — see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"text":" Step 3, Path B.","type":"text"}]},{"level":3,"type":"heading","text":"Resilient last-known-good decorator","anchor":"Resilient-last-known-good-decorator"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ResilientPaywallService"},{"text":" wraps any ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" so a transient failure to read entitlements at cold launch never presents a previously-seen paid user as free. It retries with backoff, then falls back to a last-known-good snapshot persisted through an injected ","type":"text"},{"type":"codeVoice","code":"KeyValueStore"},{"text":". Because that cache vouches for a paid entitlement while offline, back it with ","type":"text"},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"text":" — not ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"text":", whose plist a user can edit or restore from a doctored backup:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")"]},{"type":"paragraph","inlineContent":[{"text":"Feed the wrapped instance to both ","type":"text"},{"type":"codeVoice","code":"PaywallPlugin(..., service:)"},{"text":" and any app-side entitlement reader. The live provider stays authoritative: successful live snapshots overwrite the cache unless a newer successful read or live stream update has superseded them. Starting or failing an independent read does not discard another caller’s successful response. Cached values preserve their original freshness window. See the type’s own documentation for the staleness policy and threat model.","type":"text"}]},{"level":2,"type":"heading","text":"Types","anchor":"Types"},{"level":3,"type":"heading","text":"`PaywallPlugin<RootState, RootAction>`","anchor":"PaywallPlugin%3CRootState-RootAction%3E"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SwiduxPlugin"},{"text":" conformer. Owns a slice of root state typed as ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":" and an action enum typed as ","type":"text"},{"type":"codeVoice","code":"PaywallAction"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"]},{"type":"paragraph","inlineContent":[{"text":"The default ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" handler calls ","type":"text"},{"type":"codeVoice","code":"UIApplication.shared.open"},{"text":" on UIKit and ","type":"text"},{"type":"codeVoice","code":"NSWorkspace.shared.open"},{"text":" on AppKit. Override it for testing or for non-standard environments.","type":"text"}]},{"level":3,"type":"heading","text":"`PaywallState`","anchor":"PaywallState"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sendable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" struct. The slice the plugin owns.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","    public var isObservingCustomerInfo: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false,","        isObservingCustomerInfo: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isGateSatisfied"},{"text":" is the single read your feature code should consult before running gated work. It is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" when the user holds an active pro subscription or a permanent license.","type":"text"}]},{"level":3,"type":"heading","text":"`PaywallAction`","anchor":"PaywallAction"},{"type":"codeListing","syntax":"swift","code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case refreshCancelled(requestID: UUID)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"]},{"type":"paragraph","inlineContent":[{"text":"The plugin emits ","type":"text"},{"type":"codeVoice","code":"refreshCancelled(requestID:)"},{"text":" when a refresh or restore task is cancelled. It clears that request’s loading state without changing entitlements or reporting an error, even if the provider remains suspended. The reducer checks the request ID so delayed cancellation cannot finish a newer request. App code starts refreshes and restores; it does not construct cancellation-completion actions.","type":"text"}]},{"level":3,"type":"heading","text":"`EntitlementSnapshot`","anchor":"EntitlementSnapshot"},{"type":"paragraph","inlineContent":[{"text":"Provider-agnostic value the service emits to describe the user’s current entitlement.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public enum Source: Sendable, Equatable {","        case live","        case cache","        case cacheSeed","    }","","    public let isPro: Bool","    public let hasPermanentLicense: Bool","    public let source: Source","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false, source: Source = .live)","}"]},{"type":"paragraph","inlineContent":[{"text":"Providers use ","type":"text"},{"type":"codeVoice","code":".live"},{"text":" for their responses and updates. ","type":"text"},{"type":"codeVoice","code":"ResilientPaywallService"},{"text":" labels a one-shot cached fallback ","type":"text"},{"type":"codeVoice","code":".cache"},{"text":" and its initial stream bootstrap ","type":"text"},{"type":"codeVoice","code":".cacheSeed"},{"text":". A seed can populate initial entitlement state, but it neither finishes a pending refresh nor supersedes a resolved snapshot. A cached fallback completes the read normally. Equality includes ","type":"text"},{"type":"codeVoice","code":"source"},{"text":", so identical entitlement flags with different provenance are distinct snapshots.","type":"text"}]},{"level":3,"type":"heading","text":"`PaywallService` (protocol)","anchor":"PaywallService-protocol"},{"type":"codeListing","syntax":"swift","code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"level":3,"type":"heading","text":"`MockPaywallService`","anchor":"MockPaywallService"},{"type":"paragraph","inlineContent":[{"text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"level":3,"type":"heading","text":"`SimulatedPaywallService`","anchor":"SimulatedPaywallService"},{"type":"paragraph","inlineContent":[{"text":"Stateful ","type":"text"},{"type":"codeVoice","code":"actor"},{"text":" conformer for development and QA. Holds the current entitlement and multicasts changes through ","type":"text"},{"type":"codeVoice","code":"customerInfoStream()"},{"text":", so simulated grants survive a later ","type":"text"},{"type":"codeVoice","code":"refreshCustomerInfo"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"restorePurchases"},{"text":" exactly as a real service would.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public actor SimulatedPaywallService: PaywallService {","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        subsystem: String = \"Swidux\",","        category: String = \"Paywall\"","    )","","    \/\/ PaywallService: customerInfo \/ customerInfoStream \/ restorePurchases","","    \/\/ Simulation surface (not part of PaywallService — driven by the dev UI):","    public func grantPro()","    public func grantTrial()","    public func grantPermanentLicense()","    public func setFree()","    public func setRestoreShouldFail(_ shouldFail: Bool)","    public func setRefreshShouldFail(_ shouldFail: Bool)","    public func setArtificialDelay(_ delay: Duration)","}","","public enum SimulatedPaywallError: Error, Equatable {","    case restoreFailed","    case refreshFailed","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EntitlementSnapshot"},{"text":" only models ","type":"text"},{"type":"codeVoice","code":"isPro"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":", so ","type":"text"},{"type":"codeVoice","code":"grantTrial()"},{"text":" yields ","type":"text"},{"type":"codeVoice","code":"isPro == true"},{"text":" and is distinguished from ","type":"text"},{"type":"codeVoice","code":"grantPro()"},{"text":" only in the log line.","type":"text"}]},{"level":3,"type":"heading","text":"`SwiduxDevPaywallUI`","anchor":"SwiduxDevPaywallUI"},{"type":"paragraph","inlineContent":[{"text":"A separate, opt-in library product (","type":"text"},{"type":"codeVoice","code":"import SwiduxDevPaywallUI"},{"text":") providing a bare-bones debug paywall sheet. It mirrors the shape of the vendor paywall UI so the call site is unchanged when a real provider is adopted:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["someView.devPaywall(","    state: store.paywall,","    service: simulatedPaywallService,","    onAction: { store.send(.paywall($0)) }",")"]},{"type":"paragraph","inlineContent":[{"text":"The sheet shows the live ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":", grant buttons, real Restore\/Refresh flows, and QA failure\/latency toggles. On macOS the sheet uses a 400×600 minimum, matching the vendor paywall UI. Hold a ","type":"text"},{"inlineContent":[{"text":"single","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SimulatedPaywallService"},{"text":" instance and pass it to both ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" (as the plugin’s ","type":"text"},{"type":"codeVoice","code":"service:"},{"text":") and ","type":"text"},{"type":"codeVoice","code":".devPaywall(...)"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@State private var paywallService = SimulatedPaywallService()","@State private var store: AppStore","","init() {","    let service = SimulatedPaywallService()","    _paywallService = State(initialValue: service)","    _store = State(initialValue: .configured(paywallService: service))","}"]},{"type":"paragraph","inlineContent":[{"text":"This is the one place a dev\/QA service is intentionally constructed outside ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":", because the debug UI must drive the same instance the plugin observes. Swapping to a real provider removes the shared-instance wiring and the ","type":"text"},{"type":"codeVoice","code":"SwiduxDevPaywallUI"},{"text":" import along with the two-line ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" change.","type":"text"}]},{"level":2,"type":"heading","text":"Action semantics","anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns.","type":"text"}]},{"level":3,"type":"heading","text":"`request(reason: String)`","anchor":"requestreason-String"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isPresented = true"},{"text":" and stores ","type":"text"},{"type":"codeVoice","code":"requestedReason"},{"text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase.","type":"text"}]},{"level":3,"type":"heading","text":"`dismiss`","anchor":"dismiss"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isPresented = false"},{"text":" and clears ","type":"text"},{"type":"codeVoice","code":"requestedReason"},{"text":". Returns an effect that dispatches ","type":"text"},{"type":"codeVoice","code":".refreshCustomerInfo"},{"text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up).","type":"text"}]},{"level":3,"type":"heading","text":"`observeCustomerInfo`","anchor":"observeCustomerInfo"},{"type":"paragraph","inlineContent":[{"text":"Returns a long-lived effect that consumes ","type":"text"},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"text":" and dispatches ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" for every snapshot. Dispatch once on app launch (typically from a ","type":"text"},{"type":"codeVoice","code":".task"},{"text":" on the root view). The effect lives for the duration of the stream. Idempotent: ","type":"text"},{"type":"codeVoice","code":"isObservingCustomerInfo"},{"text":" guards against double-subscription, so a re-dispatched ","type":"text"},{"type":"codeVoice","code":".task"},{"text":" (view identity change, scene reconnect) won’t start a duplicate stream.","type":"text"}]},{"level":3,"type":"heading","text":"`refreshCustomerInfo`","anchor":"refreshCustomerInfo"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isLoading = true"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"type":"codeVoice","code":"PaywallService.customerInfo()"},{"text":" and dispatches ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" on success or ","type":"text"},{"type":"codeVoice","code":".refreshFailed"},{"text":" on error.","type":"text"}]},{"level":3,"type":"heading","text":"`customerInfoUpdated(EntitlementSnapshot)`","anchor":"customerInfoUpdatedEntitlementSnapshot"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isPro"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":" from the snapshot, clears ","type":"text"},{"type":"codeVoice","code":"isLoading"},{"text":", and clears ","type":"text"},{"type":"codeVoice","code":"error"},{"text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly. Note that the plugin emits this on ","type":"text"},{"inlineContent":[{"text":"every","type":"text"}],"type":"strong"},{"text":" snapshot (each ","type":"text"},{"type":"codeVoice","code":"customerInfoStream()"},{"text":" value, every ","type":"text"},{"type":"codeVoice","code":"refreshCustomerInfo"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"restorePurchases"},{"text":"), not only on entitlement changes — observe ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":" (or a value derived from it) for transitions rather than mapping this action directly. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation"},{"text":".","type":"text"}]},{"level":3,"type":"heading","text":"`refreshFailed(String)`","anchor":"refreshFailedString"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"error"},{"text":" to the given message and clears ","type":"text"},{"type":"codeVoice","code":"isLoading"},{"text":". Returns no effect.","type":"text"}]},{"level":3,"type":"heading","text":"`restorePurchases`","anchor":"restorePurchases"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isLoading = true"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"type":"codeVoice","code":"PaywallService.restorePurchases()"},{"text":" and dispatches ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" on success or ","type":"text"},{"type":"codeVoice","code":".refreshFailed"},{"text":" on error.","type":"text"}]},{"level":3,"type":"heading","text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","anchor":"presentCustomerCenter--dismissCustomerCenter"},{"type":"paragraph","inlineContent":[{"text":"Toggle ","type":"text"},{"type":"codeVoice","code":"isCustomerCenterPresented"},{"text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does).","type":"text"}]},{"level":3,"type":"heading","text":"`openManageSubscriptions`","anchor":"openManageSubscriptions"},{"type":"paragraph","inlineContent":[{"text":"Returns an effect that opens ","type":"text"},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"text":" via the configured ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS.","type":"text"}]},{"level":2,"type":"heading","text":"Implementing a `PaywallService`","anchor":"Implementing-a-PaywallService"},{"type":"paragraph","inlineContent":[{"text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The protocol has three methods:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfo() async throws -> EntitlementSnapshot"}]},{"text":" — One-shot fetch of the current entitlement. The plugin calls this from ","type":"text"},{"type":"codeVoice","code":".refreshCustomerInfo"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>"}]},{"text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from ","type":"text"},{"type":"codeVoice","code":".observeCustomerInfo"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"restorePurchases() async throws -> EntitlementSnapshot"}]},{"text":" — Performs a restore against the user’s account and returns the resulting entitlement.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Note what the protocol does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot"},{"text":" values. A vanilla StoreKit conformer iterates ","type":"text"},{"type":"codeVoice","code":"Transaction.currentEntitlements"},{"text":" and listens to ","type":"text"},{"type":"codeVoice","code":"Transaction.updates"},{"text":". Either way, the plugin stays the same.","type":"text"}]}]}],"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/swidux\/pluginpaywallreference"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","sections":[],"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"SwiduxPaywall Reference","role":"article"},"references":{"doc://Swidux/documentation/Swidux/PluginArchitecture":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"url":"\/documentation\/swidux\/pluginarchitecture","role":"article","title":"Plugin Architecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"kind":"article","type":"topic","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"url":"\/documentation\/swidux\/persistencemiddlewareguide","role":"article","title":"Persistence Middleware","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"navigatorTitle":[{"t