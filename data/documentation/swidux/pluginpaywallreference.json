{"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"reference"},{"text":". For where this plugin sits in the lifecycle, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Library-target","level":2,"text":"Library target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxPaywall"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxPaywall"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target dependencies in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":" alongside ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Provided-implementations","level":2,"text":"Provided implementations"},{"type":"paragraph","inlineContent":[{"text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" — fixed snapshot, stream finishes immediately; for previews and tests."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"SimulatedPaywallService"},{"type":"text","text":" — a stateful, fully driveable service. Paired with the "},{"type":"codeVoice","code":"SwiduxDevPaywallUI"},{"type":"text","text":" debug sheet, it lets a developer or QA tester grant Pro\/Trial\/Permanent, restore, and simulate failure\/latency — all flowing through the real plugin pipeline, with no SDK and no vendor commitment. Use it as the "},{"type":"codeVoice","code":"service:"},{"type":"text","text":" while the paywall vendor decision is still open."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"For production RevenueCat integrations, the ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"reference"},{"text":" companion package provides:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" — a "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that bridges RevenueCat’s "},{"type":"codeVoice","code":"CustomerInfo"},{"type":"text","text":" stream and "},{"type":"codeVoice","code":"restorePurchases()"},{"type":"text","text":" API."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" — a RevenueCat-flavored mock for previews."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"For other backends (StoreKit, custom server), implement ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" directly — see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"reference"},{"text":" Step 3, Path B.","type":"text"}]},{"type":"heading","anchor":"Types","level":2,"text":"Types"},{"type":"heading","anchor":"PaywallPlugin%3CRootState-RootAction%3E","level":3,"text":"`PaywallPlugin<RootState, RootAction>`"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SwiduxPlugin"},{"text":" conformer. Owns a slice of root state typed as ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":" and an action enum typed as ","type":"text"},{"type":"codeVoice","code":"PaywallAction"},{"text":".","type":"text"}]},{"code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler calls "},{"type":"codeVoice","code":"UIApplication.shared.open"},{"type":"text","text":" on UIKit and "},{"type":"codeVoice","code":"NSWorkspace.shared.open"},{"type":"text","text":" on AppKit. Override it for testing or for non-standard environments."}],"type":"paragraph"},{"level":3,"text":"`PaywallState`","anchor":"PaywallState","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" struct. The slice the plugin owns."}],"type":"paragraph"},{"code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"],"syntax":"swift","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isGateSatisfied"},{"text":" is the single read your feature code should consult before running gated work. It is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" when the user holds an active pro subscription or a permanent license.","type":"text"}]},{"level":3,"text":"`PaywallAction`","anchor":"PaywallAction","type":"heading"},{"type":"codeListing","syntax":"swift","code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"]},{"type":"heading","anchor":"EntitlementSnapshot","level":3,"text":"`EntitlementSnapshot`"},{"type":"paragraph","inlineContent":[{"text":"Provider-agnostic value the service emits to describe the user’s current entitlement.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"]},{"anchor":"PaywallService-protocol","level":3,"type":"heading","text":"`PaywallService` (protocol)"},{"code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"],"type":"codeListing","syntax":"swift"},{"anchor":"MockPaywallService","level":3,"text":"`MockPaywallService`","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately."}]},{"type":"codeListing","code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"],"syntax":"swift"},{"anchor":"SimulatedPaywallService","level":3,"type":"heading","text":"`SimulatedPaywallService`"},{"type":"paragraph","inlineContent":[{"text":"Stateful ","type":"text"},{"type":"codeVoice","code":"actor"},{"type":"text","text":" conformer for development and QA. Holds the current entitlement and multicasts changes through "},{"type":"codeVoice","code":"customerInfoStream()"},{"type":"text","text":", so simulated grants survive a later "},{"code":"refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"restorePurchases","type":"codeVoice"},{"type":"text","text":" exactly as a real service would."}]},{"type":"codeListing","syntax":"swift","code":["public actor SimulatedPaywallService: PaywallService {","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        subsystem: String = \"Swidux\",","        category: String = \"Paywall\"","    )","","    \/\/ PaywallService: customerInfo \/ customerInfoStream \/ restorePurchases","","    \/\/ Simulation surface (not part of PaywallService — driven by the dev UI):","    public func grantPro()","    public func grantTrial()","    public func grantPermanentLicense()","    public func setFree()","    public func setRestoreShouldFail(_ shouldFail: Bool)","    public func setRefreshShouldFail(_ shouldFail: Bool)","    public func setArtificialDelay(_ delay: Duration)","}","","public enum SimulatedPaywallError: Error, Equatable {","    case restoreFailed","    case refreshFailed","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" only models "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":", so "},{"type":"codeVoice","code":"grantTrial()"},{"type":"text","text":" yields "},{"type":"codeVoice","code":"isPro == true"},{"type":"text","text":" and is distinguished from "},{"type":"codeVoice","code":"grantPro()"},{"type":"text","text":" only in the log line."}]},{"anchor":"SwiduxDevPaywallUI","level":3,"type":"heading","text":"`SwiduxDevPaywallUI`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A separate, opt-in library product ("},{"type":"codeVoice","code":"import SwiduxDevPaywallUI"},{"type":"text","text":") providing a bare-bones debug paywall sheet. It mirrors the shape of the vendor paywall UI so the call site is unchanged when a real provider is adopted:"}]},{"type":"codeListing","syntax":"swift","code":["someView.devPaywall(","    state: store.paywall,","    service: simulatedPaywallService,","    onAction: { store.send(.paywall($0)) }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sheet shows the live "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":", grant buttons, real Restore\/Refresh flows, and QA failure\/latency toggles. On macOS the sheet uses a 400×600 minimum, matching the vendor paywall UI. Hold a "},{"type":"strong","inlineContent":[{"text":"single","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"SimulatedPaywallService"},{"type":"text","text":" instance and pass it to both "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" (as the plugin’s "},{"type":"codeVoice","code":"service:"},{"type":"text","text":") and "},{"type":"codeVoice","code":".devPaywall(...)"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["@State private var paywallService = SimulatedPaywallService()","@State private var store: AppStore","","init() {","    let service = SimulatedPaywallService()","    _paywallService = State(initialValue: service)","    _store = State(initialValue: .configured(paywallService: service))","}"]},{"type":"paragraph","inlineContent":[{"text":"This is the one place a dev\/QA service is intentionally constructed outside ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":", because the debug UI must drive the same instance the plugin observes. Swapping to a real provider removes the shared-instance wiring and the ","type":"text"},{"type":"codeVoice","code":"SwiduxDevPaywallUI"},{"text":" import along with the two-line ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" change.","type":"text"}]},{"anchor":"Action-semantics","level":2,"type":"heading","text":"Action semantics"},{"type":"paragraph","inlineContent":[{"text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns.","type":"text"}]},{"anchor":"requestreason-String","level":3,"type":"heading","text":"`request(reason: String)`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isPresented = true"},{"text":" and stores ","type":"text"},{"type":"codeVoice","code":"requestedReason"},{"text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase.","type":"text"}]},{"anchor":"dismiss","level":3,"type":"heading","text":"`dismiss`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isPresented = false"},{"text":" and clears ","type":"text"},{"type":"codeVoice","code":"requestedReason"},{"text":". Returns an effect that dispatches ","type":"text"},{"type":"codeVoice","code":".refreshCustomerInfo"},{"text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up).","type":"text"}]},{"anchor":"observeCustomerInfo","level":3,"type":"heading","text":"`observeCustomerInfo`"},{"type":"paragraph","inlineContent":[{"text":"Returns a long-lived effect that consumes ","type":"text"},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"text":" and dispatches ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" for every snapshot. Dispatch once on app launch (typically from a ","type":"text"},{"type":"codeVoice","code":".task"},{"text":" on the root view). The effect lives for the duration of the stream.","type":"text"}]},{"anchor":"refreshCustomerInfo","level":3,"type":"heading","text":"`refreshCustomerInfo`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isLoading = true"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"type":"codeVoice","code":"PaywallService.customerInfo()"},{"text":" and dispatches ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" on success or ","type":"text"},{"type":"codeVoice","code":".refreshFailed"},{"text":" on error.","type":"text"}]},{"anchor":"customerInfoUpdatedEntitlementSnapshot","level":3,"type":"heading","text":"`customerInfoUpdated(EntitlementSnapshot)`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isPro"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":" from the snapshot, clears ","type":"text"},{"type":"codeVoice","code":"isLoading"},{"text":", and clears ","type":"text"},{"type":"codeVoice","code":"error"},{"text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly. Note that the plugin emits this on ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"every"}]},{"text":" snapshot (each ","type":"text"},{"type":"codeVoice","code":"customerInfoStream()"},{"text":" value, every ","type":"text"},{"type":"codeVoice","code":"refreshCustomerInfo"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"restorePurchases"},{"text":"), not only on entitlement changes — observe ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":" (or a value derived from it) for transitions rather than mapping this action directly. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","type":"reference"},{"text":".","type":"text"}]},{"anchor":"refreshFailedString","level":3,"type":"heading","text":"`refreshFailed(String)`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"error"},{"text":" to the given message and clears ","type":"text"},{"type":"codeVoice","code":"isLoading"},{"text":". Returns no effect.","type":"text"}]},{"anchor":"restorePurchases","level":3,"type":"heading","text":"`restorePurchases`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isLoading = true"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"type":"codeVoice","code":"PaywallService.restorePurchases()"},{"text":" and dispatches ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" on success or ","type":"text"},{"type":"codeVoice","code":".refreshFailed"},{"text":" on error.","type":"text"}]},{"anchor":"presentCustomerCenter--dismissCustomerCenter","level":3,"type":"heading","text":"`presentCustomerCenter` \/ `dismissCustomerCenter`"},{"type":"paragraph","inlineContent":[{"text":"Toggle ","type":"text"},{"type":"codeVoice","code":"isCustomerCenterPresented"},{"text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does).","type":"text"}]},{"anchor":"openManageSubscriptions","level":3,"type":"heading","text":"`openManageSubscriptions`"},{"type":"paragraph","inlineContent":[{"text":"Returns an effect that opens ","type":"text"},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"text":" via the configured ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS.","type":"text"}]},{"anchor":"Implementing-a-PaywallService","level":2,"type":"heading","text":"Implementing a `PaywallService`"},{"type":"paragraph","inlineContent":[{"text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The protocol has three methods:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"customerInfo() async throws -> EntitlementSnapshot","type":"codeVoice"}]},{"text":" — One-shot fetch of the current entitlement. The plugin calls this from ","type":"text"},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>","type":"codeVoice"}],"type":"strong"},{"text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from ","type":"text"},{"code":".observeCustomerInfo","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"restorePurchases() async throws -> EntitlementSnapshot","type":"codeVoice"}],"type":"strong"},{"text":" — Performs a restore against the user’s account and returns the resulting entitlement.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note what the protocol does "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results.","type":"text"}]},{"inlineContent":[{"text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into ","type":"text"},{"code":"EntitlementSnapshot","type":"codeVoice"},{"type":"text","text":" values. A vanilla StoreKit conformer iterates "},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"type":"text","text":" and listens to "},{"code":"Transaction.updates","type":"codeVoice"},{"type":"text","text":". Either way, the plugin stays the same."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"variants":[{"paths":["\/documentation\/swidux\/pluginpaywallreference"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"Swidux"}],"title":"SwiduxPaywall Reference","role":"article","roleHeading":"Article"},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"anchor":"Reference","generated":true,"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"]}],"kind":"article","sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"role":"article","type":"topic","url":"\/documentation\/swidux\/pluginfeatureflagsreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","kind":"article","title":"SwiduxFeatureFlags Reference"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"url":"\/documentation\/swidux\/howtoaddapaywall","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","role":"article","title":"Add a Paywall","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}]},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"title":"Service-Result Actions and Transition Observation","url":"\/documentation\/swidux\/pluginarchitecture#Service-Result-Actions-and-Transition-Observation","kind":"section","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","abstract":[],"type":"topic"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"url":"\/documentation\/swidux\/entitystoreguide","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","role":"article","title":"EntityStore","type":"topic","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"role":"article","type":"topic","url":"\/documentation\/swidux\/pluginanalyticsreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","kind":"article","title":"SwiduxAnalytics Reference"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"url":"\/documentation\/swidux\/persistencemiddlewareguide","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","role":"article","title":"Persistence Middleware","type":"topic","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}]},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"link","titleInlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"}],"url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","title":"SwiduxRevenueCatPaywall"},"doc://Swidux/documentation/Swidux/GettingStarted":{"url":"\/documentation\/swidux\/gettingstarted","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","role":"article","title":"Getting Started with Swidux","type":"topic","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","url":"\/documentation\/swidux\/pluginarchitecture","title":"Plugin Architecture","type":"topic","kind":"article","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"role":"article","type":"topic","url":"\/documentation\/swidux\/pluginkillswitchreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","kind":"article","title":"SwiduxKillswitch Reference"},"doc://Swidux/documentation/Swidux":{"abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"role":"collection","type":"topic","url":"\/documentation\/swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","title":"Swidux"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","url":"\/documentation\/swidux\/undoplugin","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"title":"UndoPlugin","type":"topic","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}],"abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}]},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"role":"collectionGroup","type":"topic","url":"\/documentation\/swidux\/keyvaluestoreguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","kind":"article","title":"KeyValueStore"},"doc://Swidux/documentation/Swidux/MacrosReference":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","url":"\/documentation\/swidux\/macrosreference","title":"Macros","type":"topic","kind":"article","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" — the two macros that generate the observation bridge between value-type state and SwiftUI."}]},"doc://Swidux/documentation/Swidux/UndoRedo":{"abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":"."}],"role":"article","type":"topic","url":"\/documentation\/swidux\/undoredo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","kind":"article","title":"Undo \/ Redo"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"role":"article","type":"topic","url":"\/documentation\/swidux\/pluginparentalgatereference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","kind":"article","title":"SwiduxParentalGate Reference"}}}