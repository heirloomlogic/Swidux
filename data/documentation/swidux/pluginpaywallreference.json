{"sections":[],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","interfaceLanguage":"swift"},"kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"variants":[{"paths":["\/documentation\/swidux\/pluginpaywallreference"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"anchor":"Reference","generated":true,"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}],"title":"SwiduxPaywall Reference"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"text":". For where this plugin sits in the lifecycle, see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]},{"type":"heading","text":"Library target","level":2,"anchor":"Library-target"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxPaywall"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxPaywall"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target dependencies in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":" alongside ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":".","type":"text"}]},{"anchor":"Provided-implementations","level":2,"type":"heading","text":"Provided implementations"},{"inlineContent":[{"text":"The plugin ships with ","type":"text"},{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" for previews and tests. For production RevenueCat integrations, the "},{"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","isActive":true},{"type":"text","text":" companion package provides:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RevenueCatPaywallService"},{"text":" — a ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" conformer that bridges RevenueCat’s ","type":"text"},{"code":"CustomerInfo","type":"codeVoice"},{"type":"text","text":" stream and "},{"type":"codeVoice","code":"restorePurchases()"},{"type":"text","text":" API."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" — a RevenueCat-flavored mock for previews."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For other backends (StoreKit, custom server), implement "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" directly — see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"reference","isActive":true},{"text":" Step 3, Path B.","type":"text"}]},{"anchor":"Types","type":"heading","level":2,"text":"Types"},{"type":"heading","text":"`PaywallPlugin<RootState, RootAction>`","level":3,"anchor":"PaywallPlugin%3CRootState-RootAction%3E"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiduxPlugin"},{"text":" conformer. Owns a slice of root state typed as ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":" and an action enum typed as ","type":"text"},{"type":"codeVoice","code":"PaywallAction"},{"text":".","type":"text"}]},{"type":"codeListing","code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The default ","type":"text"},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler calls "},{"type":"codeVoice","code":"UIApplication.shared.open"},{"type":"text","text":" on UIKit and "},{"type":"codeVoice","code":"NSWorkspace.shared.open"},{"type":"text","text":" on AppKit. Override it for testing or for non-standard environments."}]},{"type":"heading","text":"`PaywallState`","level":3,"anchor":"PaywallState"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" struct. The slice the plugin owns."}]},{"type":"codeListing","code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isGateSatisfied"},{"type":"text","text":" is the single read your feature code should consult before running gated work. It is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when the user holds an active pro subscription or a permanent license."}]},{"type":"heading","text":"`PaywallAction`","level":3,"anchor":"PaywallAction"},{"type":"codeListing","code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"],"syntax":"swift"},{"type":"heading","text":"`EntitlementSnapshot`","level":3,"anchor":"EntitlementSnapshot"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provider-agnostic value the service emits to describe the user’s current entitlement."}]},{"type":"codeListing","code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"],"syntax":"swift"},{"type":"heading","text":"`PaywallService` (protocol)","level":3,"anchor":"PaywallService-protocol"},{"type":"codeListing","code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"],"syntax":"swift"},{"level":3,"text":"`MockPaywallService`","type":"heading","anchor":"MockPaywallService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately."}]},{"code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Action semantics","type":"heading","anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns.","type":"text"}]},{"level":3,"text":"`request(reason: String)`","type":"heading","anchor":"requestreason-String"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"isPresented = true","type":"codeVoice"},{"text":" and stores ","type":"text"},{"code":"requestedReason","type":"codeVoice"},{"text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase.","type":"text"}],"type":"paragraph"},{"level":3,"text":"`dismiss`","type":"heading","anchor":"dismiss"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPresented = false"},{"type":"text","text":" and clears "},{"type":"codeVoice","code":"requestedReason"},{"text":". Returns an effect that dispatches ","type":"text"},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up)."}]},{"text":"`observeCustomerInfo`","type":"heading","level":3,"anchor":"observeCustomerInfo"},{"inlineContent":[{"type":"text","text":"Returns a long-lived effect that consumes "},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" for every snapshot. Dispatch once on app launch (typically from a "},{"type":"codeVoice","code":".task"},{"type":"text","text":" on the root view). The effect lives for the duration of the stream."}],"type":"paragraph"},{"anchor":"refreshCustomerInfo","type":"heading","text":"`refreshCustomerInfo`","level":3},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isLoading = true"},{"type":"text","text":". Returns a one-shot effect that calls "},{"type":"codeVoice","code":"PaywallService.customerInfo()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" on error."}],"type":"paragraph"},{"anchor":"customerInfoUpdatedEntitlementSnapshot","type":"heading","level":3,"text":"`customerInfoUpdated(EntitlementSnapshot)`"},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":" from the snapshot, clears ","type":"text"},{"code":"isLoading","type":"codeVoice"},{"text":", and clears ","type":"text"},{"code":"error","type":"codeVoice"},{"type":"text","text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly."}],"type":"paragraph"},{"text":"`refreshFailed(String)`","type":"heading","level":3,"anchor":"refreshFailedString"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"error"},{"text":" to the given message and clears ","type":"text"},{"code":"isLoading","type":"codeVoice"},{"text":". Returns no effect.","type":"text"}]},{"type":"heading","text":"`restorePurchases`","level":3,"anchor":"restorePurchases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isLoading = true"},{"type":"text","text":". Returns a one-shot effect that calls "},{"type":"codeVoice","code":"PaywallService.restorePurchases()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" on error."}]},{"type":"heading","text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","level":3,"anchor":"presentCustomerCenter--dismissCustomerCenter"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Toggle "},{"type":"codeVoice","code":"isCustomerCenterPresented"},{"type":"text","text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does)."}]},{"type":"heading","text":"`openManageSubscriptions`","level":3,"anchor":"openManageSubscriptions"},{"type":"paragraph","inlineContent":[{"text":"Returns an effect that opens ","type":"text"},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"text":" via the configured ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS.","type":"text"}]},{"type":"heading","text":"Implementing a `PaywallService`","level":2,"anchor":"Implementing-a-PaywallService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol has three methods:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfo() async throws -> EntitlementSnapshot"}]},{"text":" — One-shot fetch of the current entitlement. The plugin calls this from ","type":"text"},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>"}]},{"text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from ","type":"text"},{"code":".observeCustomerInfo","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"restorePurchases() async throws -> EntitlementSnapshot"}]},{"text":" — Performs a restore against the user’s account and returns the resulting entitlement.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note what the protocol does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" values. A vanilla StoreKit conformer iterates "},{"type":"codeVoice","code":"Transaction.currentEntitlements"},{"type":"text","text":" and listens to "},{"type":"codeVoice","code":"Transaction.updates"},{"type":"text","text":". Either way, the plugin stays the same."}]}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"references":{"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"url":"\/documentation\/swidux\/pluginparentalgatereference","title":"SwiduxParentalGate Reference","type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","role":"article","abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"kind":"article","url":"\/documentation\/swidux\/pluginarchitecture","type":"topic","title":"Plugin Architecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","title":"Persistence Middleware","url":"\/documentation\/swidux\/persistencemiddlewareguide","role":"article","kind":"article","type":"topic","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}]},"doc://Swidux/documentation/Swidux/UndoRedo":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","title":"Undo \/ Redo","url":"\/documentation\/swidux\/undoredo","role":"article","kind":"article","type":"topic","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":".","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"type":"topic","url":"\/documentation\/swidux\/pluginkillswitchreference","title":"SwiduxKillswitch Reference","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","role":"article","abstract":[{"type":"text","text":"Public API surface for the "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}]},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"type":"topic","title":"KeyValueStore","url":"\/documentation\/swidux\/keyvaluestoreguide","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","role":"collectionGroup","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}]},"doc://Swidux/documentation/Swidux":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","role":"collection","kind":"symbol","title":"Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"kind":"article","title":"Add a Paywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"type":"topic","title":"EntityStore","url":"\/documentation\/swidux\/entitystoreguide","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","role":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","url":"\/documentation\/swidux\/gettingstarted","role":"article","kind":"article","title":"Getting Started with Swidux","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}]},"doc://Swidux/documentation/Swidux/UndoPlugin":{"kind":"symbol","url":"\/documentation\/swidux\/undoplugin","type":"topic","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}],"title":"UndoPlugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"kind":"identifier","text":"UndoPlugin"}],"role":"symbol"},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"titleInlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}],"identifier":"https:\/\/github.com\/heirloomlogic\/Swidu