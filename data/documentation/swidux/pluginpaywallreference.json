{"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Library target","level":2,"type":"heading","anchor":"Library-target"},{"items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxPaywall","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Provided implementations","level":2,"type":"heading","anchor":"Provided-implementations"},{"inlineContent":[{"type":"text","text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"MockPaywallService","type":"codeVoice"},{"text":" — fixed snapshot, stream finishes immediately; for previews and tests.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"SimulatedPaywallService","type":"codeVoice"},{"text":" — a stateful, fully driveable service. Paired with the ","type":"text"},{"code":"SwiduxDevPaywallUI","type":"codeVoice"},{"text":" debug sheet, it lets a developer or QA tester grant Pro\/Trial\/Permanent, restore, and simulate failure\/latency — all flowing through the real plugin pipeline, with no SDK and no vendor commitment. Use it as the ","type":"text"},{"code":"service:","type":"codeVoice"},{"text":" while the paywall vendor decision is still open.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For production RevenueCat integrations, the "},{"type":"reference","isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},{"type":"text","text":" companion package provides:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" — a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that bridges RevenueCat’s ","type":"text"},{"code":"CustomerInfo","type":"codeVoice"},{"text":" stream and ","type":"text"},{"code":"restorePurchases()","type":"codeVoice"},{"text":" API.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" — a RevenueCat-flavored mock for previews.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For other backends (StoreKit, custom server), implement "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" directly — see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"type":"text","text":" Step 3, Path B."}],"type":"paragraph"},{"text":"Types","level":2,"type":"heading","anchor":"Types"},{"text":"`PaywallPlugin<RootState, RootAction>`","level":3,"type":"heading","anchor":"PaywallPlugin%3CRootState-RootAction%3E"},{"inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":" and an action enum typed as "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler calls "},{"type":"codeVoice","code":"UIApplication.shared.open"},{"type":"text","text":" on UIKit and "},{"type":"codeVoice","code":"NSWorkspace.shared.open"},{"type":"text","text":" on AppKit. Override it for testing or for non-standard environments."}],"type":"paragraph"},{"text":"`PaywallState`","level":3,"type":"heading","anchor":"PaywallState"},{"inlineContent":[{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" struct. The slice the plugin owns."}],"type":"paragraph"},{"type":"codeListing","code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"isGateSatisfied"},{"type":"text","text":" is the single read your feature code should consult before running gated work. It is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when the user holds an active pro subscription or a permanent license."}],"type":"paragraph"},{"text":"`PaywallAction`","level":3,"type":"heading","anchor":"PaywallAction"},{"type":"codeListing","code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"],"syntax":"swift"},{"text":"`EntitlementSnapshot`","level":3,"type":"heading","anchor":"EntitlementSnapshot"},{"inlineContent":[{"type":"text","text":"Provider-agnostic value the service emits to describe the user’s current entitlement."}],"type":"paragraph"},{"type":"codeListing","code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"],"syntax":"swift"},{"text":"`PaywallService` (protocol)","level":3,"type":"heading","anchor":"PaywallService-protocol"},{"type":"codeListing","code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"],"syntax":"swift"},{"text":"`MockPaywallService`","level":3,"type":"heading","anchor":"MockPaywallService"},{"inlineContent":[{"type":"text","text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately."}],"type":"paragraph"},{"type":"codeListing","code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"],"syntax":"swift"},{"text":"`SimulatedPaywallService`","level":3,"type":"heading","anchor":"SimulatedPaywallService"},{"inlineContent":[{"type":"text","text":"Stateful "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" conformer for development and QA. Holds the current entitlement and multicasts changes through "},{"type":"codeVoice","code":"customerInfoStream()"},{"type":"text","text":", so simulated grants survive a later "},{"type":"codeVoice","code":"refreshCustomerInfo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"restorePurchases"},{"type":"text","text":" exactly as a real service would."}],"type":"paragraph"},{"type":"codeListing","code":["public actor SimulatedPaywallService: PaywallService {","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        subsystem: String = \"Swidux\",","        category: String = \"Paywall\"","    )","","    \/\/ PaywallService: customerInfo \/ customerInfoStream \/ restorePurchases","","    \/\/ Simulation surface (not part of PaywallService — driven by the dev UI):","    public func grantPro()","    public func grantTrial()","    public func grantPermanentLicense()","    public func setFree()","    public func setRestoreShouldFail(_ shouldFail: Bool)","    public func setRefreshShouldFail(_ shouldFail: Bool)","    public func setArtificialDelay(_ delay: Duration)","}","","public enum SimulatedPaywallError: Error, Equatable {","    case restoreFailed","    case refreshFailed","}"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" only models "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":", so "},{"type":"codeVoice","code":"grantTrial()"},{"type":"text","text":" yields "},{"type":"codeVoice","code":"isPro == true"},{"type":"text","text":" and is distinguished from "},{"type":"codeVoice","code":"grantPro()"},{"type":"text","text":" only in the log line."}],"type":"paragraph"},{"text":"`SwiduxDevPaywallUI`","level":3,"type":"heading","anchor":"SwiduxDevPaywallUI"},{"inlineContent":[{"type":"text","text":"A separate, opt-in library product ("},{"type":"codeVoice","code":"import SwiduxDevPaywallUI"},{"type":"text","text":") providing a bare-bones debug paywall sheet. It mirrors the shape of the vendor paywall UI so the call site is unchanged when a real provider is adopted:"}],"type":"paragraph"},{"type":"codeListing","code":["someView.devPaywall(","    state: store.paywall,","    service: simulatedPaywallService,","    onAction: { store.send(.paywall($0)) }",")"],"syntax":"swift"},{"inlineContent":[{"text":"The sheet shows the live ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":", grant buttons, real Restore\/Refresh flows, and QA failure\/latency toggles. On macOS the sheet uses a 400×600 minimum, matching the vendor paywall UI. Hold a ","type":"text"},{"inlineContent":[{"type":"text","text":"single"}],"type":"strong"},{"text":" ","type":"text"},{"code":"SimulatedPaywallService","type":"codeVoice"},{"type":"text","text":" instance and pass it to both "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" (as the plugin’s "},{"type":"codeVoice","code":"service:"},{"type":"text","text":") and "},{"type":"codeVoice","code":".devPaywall(...)"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["@State private var paywallService = SimulatedPaywallService()","@State private var store: AppStore","","init() {","    let service = SimulatedPaywallService()","    _paywallService = State(initialValue: service)","    _store = State(initialValue: .configured(paywallService: service))","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This is the one place a dev\/QA service is intentionally constructed outside ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":", because the debug UI must drive the same instance the plugin observes. Swapping to a real provider removes the shared-instance wiring and the ","type":"text"},{"code":"SwiduxDevPaywallUI","type":"codeVoice"},{"text":" import along with the two-line ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" change.","type":"text"}]},{"type":"heading","anchor":"Action-semantics","level":2,"text":"Action semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}]},{"type":"heading","anchor":"requestreason-String","level":3,"text":"`request(reason: String)`"},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPresented = true"},{"type":"text","text":" and stores "},{"type":"codeVoice","code":"requestedReason"},{"type":"text","text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase."}],"type":"paragraph"},{"text":"`dismiss`","anchor":"dismiss","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isPresented = false"},{"text":" and clears ","type":"text"},{"code":"requestedReason","type":"codeVoice"},{"text":". Returns an effect that dispatches ","type":"text"},{"code":".refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up)."}]},{"type":"heading","anchor":"observeCustomerInfo","level":3,"text":"`observeCustomerInfo`"},{"inlineContent":[{"type":"text","text":"Returns a long-lived effect that consumes "},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" for every snapshot. Dispatch once on app launch (typically from a "},{"code":".task","type":"codeVoice"},{"type":"text","text":" on the root view). The effect lives for the duration of the stream."}],"type":"paragraph"},{"level":3,"anchor":"refreshCustomerInfo","text":"`refreshCustomerInfo`","type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"code":"isLoading = true","type":"codeVoice"},{"type":"text","text":". Returns a one-shot effect that calls "},{"code":"PaywallService.customerInfo()","type":"codeVoice"},{"type":"text","text":" and dispatches "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" on success or "},{"code":".refreshFailed","type":"codeVoice"},{"type":"text","text":" on error."}],"type":"paragraph"},{"level":3,"anchor":"customerInfoUpdatedEntitlementSnapshot","text":"`customerInfoUpdated(EntitlementSnapshot)`","type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"code":"isPro","type":"codeVoice"},{"type":"text","text":" and "},{"code":"hasPermanentLicense","type":"codeVoice"},{"type":"text","text":" from the snapshot, clears "},{"code":"isLoading","type":"codeVoice"},{"type":"text","text":", and clears "},{"code":"error","type":"codeVoice"},{"type":"text","text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly. Note that the plugin emits this on "},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"type":"text","text":" snapshot (each "},{"code":"customerInfoStream()","type":"codeVoice"},{"type":"text","text":" value, every "},{"code":"refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"restorePurchases","type":"codeVoice"},{"type":"text","text":"), not only on entitlement changes — observe "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":" (or a value derived from it) for transitions rather than mapping this action directly. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"anchor":"refreshFailedString","text":"`refreshFailed(String)`","type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"code":"error","type":"codeVoice"},{"type":"text","text":" to the given message and clears "},{"code":"isLoading","type":"codeVoice"},{"type":"text","text":". Returns no effect."}],"type":"paragraph"},{"level":3,"anchor":"restorePurchases","text":"`restorePurchases`","type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"code":"isLoading = true","type":"codeVoice"},{"type":"text","text":". Returns a one-shot effect that calls "},{"code":"PaywallService.restorePurchases()","type":"codeVoice"},{"type":"text","text":" and dispatches "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" on success or "},{"code":".refreshFailed","type":"codeVoice"},{"type":"text","text":" on error."}],"type":"paragraph"},{"level":3,"anchor":"presentCustomerCenter--dismissCustomerCenter","text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","type":"heading"},{"inlineContent":[{"type":"text","text":"Toggle "},{"code":"isCustomerCenterPresented","type":"codeVoice"},{"type":"text","text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does)."}],"type":"paragraph"},{"level":3,"anchor":"openManageSubscriptions","text":"`openManageSubscriptions`","type":"heading"},{"inlineContent":[{"type":"text","text":"Returns an effect that opens "},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"type":"text","text":" via the configured "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS."}],"type":"paragraph"},{"level":2,"anchor":"Implementing-a-PaywallService","text":"Implementing a `PaywallService`","type":"heading"},{"inlineContent":[{"type":"text","text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an "},{"code":"EntitlementSnapshot","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The protocol has three methods:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfo() async throws -> EntitlementSnapshot"}]},{"type":"text","text":" — One-shot fetch of the current entitlement. The plugin calls this from "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>"}]},{"type":"text","text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from "},{"code":".observeCustomerInfo","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"restorePurchases() async throws -> EntitlementSnapshot"}]},{"type":"text","text":" — Performs a restore against the user’s account and returns the resulting entitlement."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Note what the protocol does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot"},{"text":" values. A vanilla StoreKit conformer iterates ","type":"text"},{"type":"codeVoice","code":"Transaction.currentEntitlements"},{"type":"text","text":" and listens to "},{"type":"codeVoice","code":"Transaction.updates"},{"text":". Either way, the plugin stays the same.","type":"text"}]}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","interfaceLanguage":"swift"},"abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginpaywallreference"]}],"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true}],"kind":"article","metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"SwiduxPaywall Reference"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://Swidux/documentation/Swidux/UndoPlugin":{"kind":"symbol","url":"\/documentation\/swidux\/undoplugin","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","title":"UndoPlugin","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}]},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"type":"topic","url":"\/documentation\/swidux\/entitystoreguide","kind":"article","title":"EntityStore"},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"type":"topic","url":"\/documentation\/swidux\/gettingstarted","kind":"article","title":"Getting Started with Swidux"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"role":"collectionGroup","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"type":"topic","url":"\/documentation\/swidux\/keyvaluestoreguide","kind":"article","title":"KeyValueStore"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"type":"topic","url":"\/documentation\/swidux\/howtoaddapaywall","kind":"article","title":"Add a Paywall"},"doc://Swidux/documentation/Swidux/MacrosReference":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":")."}],"type":"topic","url":"\/documentation\/swidux\/macrosreference","kind":"article","title":"Macros"},"doc://Swidux/documentation/Swidux/UndoRedo":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":".","type":"text"}],"type":"topic","url":"\/documentation\/swidux\/undoredo","kind":"article","title":"Undo \/ Redo"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"type":"topic","url":"\/documentation\/swidux\/pluginparentalgatereference","kind":"article","title":"SwiduxParentalGate Reference"},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"title":"Service-Result Actions and Transition Observation","abstract":[],"kind":"section","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","url":"\/documentation\/swidux\/pluginarchitecture#Service-Result-Actions-and-Transition-Observation","type":"topic"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"type":"topic","url":"\/documentation\/swidux\/pluginkillswitchreference","kind":"article","title":"SwiduxKillswitch Reference"},"doc://Swidux/documentation/Swidux":{"role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"type":"topic","url":"\/documentation\/swidux","kind":"symbol","title":"Swidux"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"type":"topic","url":"\/documentation\/swidux\/pluginanalyticsreference","kind":"article","title":"SwiduxAnalytics Reference"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"type":"topic","url":"\/documentation\/swidux\/pluginfeatureflagsreference","kind":"article","title":"SwiduxFeatureFlags Reference"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"type":"topic","url":"\/documentation\/swidux\/persistencemiddlewareguide","kind":"article","title":"Persistence Middleware"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"type":"topic","url":"\/documentation\/swidux\/pluginarchitecture","kind":"article","title":"Plugin Architecture"},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"title":"SwiduxRevenueCatPaywall","titleInlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywall"}],"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"link"}}}