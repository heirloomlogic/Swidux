{"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference","generated":true,"anchor":"Reference"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"paths":["\/documentation\/swidux\/pluginpaywallreference"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"metadata":{"title":"SwiduxPaywall Reference","roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","isActive":true,"type":"reference"},{"text":". For where this plugin sits in the lifecycle, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"type":"heading","level":2,"anchor":"Library-target","text":"Library target"},{"items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"code":"import SwiduxPaywall","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"code":"Package.swift","type":"codeVoice"},{"text":" alongside ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Provided implementations","level":2,"type":"heading","anchor":"Provided-implementations"},{"inlineContent":[{"type":"text","text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" — fixed snapshot, stream finishes immediately; for previews and tests."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"SimulatedPaywallService","type":"codeVoice"},{"text":" — a stateful, fully driveable service. Paired with the ","type":"text"},{"code":"SwiduxDevPaywallUI","type":"codeVoice"},{"text":" debug sheet, it lets a developer or QA tester grant Pro\/Trial\/Permanent, restore, and simulate failure\/latency — all flowing through the real plugin pipeline, with no SDK and no vendor commitment. Use it as the ","type":"text"},{"code":"service:","type":"codeVoice"},{"text":" while the paywall vendor decision is still open.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"For production RevenueCat integrations, the ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"reference"},{"text":" companion package provides:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" — a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that bridges RevenueCat’s ","type":"text"},{"code":"CustomerInfo","type":"codeVoice"},{"text":" stream and ","type":"text"},{"code":"restorePurchases()","type":"codeVoice"},{"text":" API.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" — a RevenueCat-flavored mock for previews.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Full API documentation lives in the package’s own ","type":"text"},{"type":"reference","isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For other backends (StoreKit, custom server), implement ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" directly — see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"text":" Step 3, Path B.","type":"text"}],"type":"paragraph"},{"text":"Resilient last-known-good decorator","anchor":"Resilient-last-known-good-decorator","type":"heading","level":3},{"inlineContent":[{"code":"ResilientPaywallService","type":"codeVoice"},{"text":" wraps any ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" so a transient failure to read entitlements at cold launch never presents a previously-seen paid user as free. It retries with backoff, then falls back to a last-known-good snapshot persisted through an injected ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":". Because that cache vouches for a paid entitlement while offline, back it with ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" — not ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":", whose plist a user can edit or restore from a doctored backup:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")"],"type":"codeListing"},{"inlineContent":[{"text":"Feed the wrapped instance to both ","type":"text"},{"code":"PaywallPlugin(..., service:)","type":"codeVoice"},{"text":" and any app-side entitlement reader. The live provider stays authoritative: any successful snapshot overwrites the cache. See the type’s own documentation for the staleness policy and threat model.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Types","type":"heading","text":"Types"},{"level":3,"anchor":"PaywallPlugin%3CRootState-RootAction%3E","type":"heading","text":"`PaywallPlugin<RootState, RootAction>`"},{"inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"text":" ","type":"text"},{"code":"SwiduxPlugin","type":"codeVoice"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":" and an action enum typed as "},{"code":"PaywallAction","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The default "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" handler calls "},{"code":"UIApplication.shared.open","type":"codeVoice"},{"type":"text","text":" on UIKit and "},{"code":"NSWorkspace.shared.open","type":"codeVoice"},{"type":"text","text":" on AppKit. Override it for testing or for non-standard environments."}],"type":"paragraph"},{"level":3,"anchor":"PaywallState","text":"`PaywallState`","type":"heading"},{"inlineContent":[{"code":"Sendable","type":"codeVoice"},{"type":"text","text":", "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":" struct. The slice the plugin owns."}],"type":"paragraph"},{"code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","    public var isObservingCustomerInfo: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false,","        isObservingCustomerInfo: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"isGateSatisfied","type":"codeVoice"},{"type":"text","text":" is the single read your feature code should consult before running gated work. It is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" when the user holds an active pro subscription or a permanent license."}],"type":"paragraph"},{"level":3,"anchor":"PaywallAction","text":"`PaywallAction`","type":"heading"},{"code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"EntitlementSnapshot","text":"`EntitlementSnapshot`","type":"heading"},{"inlineContent":[{"type":"text","text":"Provider-agnostic value the service emits to describe the user’s current entitlement."}],"type":"paragraph"},{"code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"PaywallService-protocol","text":"`PaywallService` (protocol)","type":"heading"},{"code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"MockPaywallService","text":"`MockPaywallService`","type":"heading"},{"inlineContent":[{"type":"text","text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately."}],"type":"paragraph"},{"code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"SimulatedPaywallService","text":"`SimulatedPaywallService`","type":"heading"},{"inlineContent":[{"type":"text","text":"Stateful "},{"code":"actor","type":"codeVoice"},{"type":"text","text":" conformer for development and QA. Holds the current entitlement and multicasts changes through "},{"code":"customerInfoStream()","type":"codeVoice"},{"type":"text","text":", so simulated grants survive a later "},{"code":"refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"restorePurchases","type":"codeVoice"},{"type":"text","text":" exactly as a real service would."}],"type":"paragraph"},{"code":["public actor SimulatedPaywallService: PaywallService {","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        subsystem: String = \"Swidux\",","        category: String = \"Paywall\"","    )","","    \/\/ PaywallService: customerInfo \/ customerInfoStream \/ restorePurchases","","    \/\/ Simulation surface (not part of PaywallService — driven by the dev UI):","    public func grantPro()","    public func grantTrial()","    public func grantPermanentLicense()","    public func setFree()","    public func setRestoreShouldFail(_ shouldFail: Bool)","    public func setRefreshShouldFail(_ shouldFail: Bool)","    public func setArtificialDelay(_ delay: Duration)","}","","public enum SimulatedPaywallError: Error, Equatable {","    case restoreFailed","    case refreshFailed","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"EntitlementSnapshot","type":"codeVoice"},{"type":"text","text":" only models "},{"code":"isPro","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"hasPermanentLicense","type":"codeVoice"},{"type":"text","text":", so "},{"code":"grantTrial()","type":"codeVoice"},{"type":"text","text":" yields "},{"code":"isPro == true","type":"codeVoice"},{"type":"text","text":" and is distinguished from "},{"code":"grantPro()","type":"codeVoice"},{"type":"text","text":" only in the log line."}],"type":"paragraph"},{"level":3,"anchor":"SwiduxDevPaywallUI","text":"`SwiduxDevPaywallUI`","type":"heading"},{"inlineContent":[{"type":"text","text":"A separate, opt-in library product ("},{"code":"import SwiduxDevPaywallUI","type":"codeVoice"},{"type":"text","text":") providing a bare-bones debug paywall sheet. It mirrors the shape of the vendor paywall UI so the call site is unchanged when a real provider is adopted:"}],"type":"paragraph"},{"code":["someView.devPaywall(","    state: store.paywall,","    service: simulatedPaywallService,","    onAction: { store.send(.paywall($0)) }",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The sheet shows the live "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":", grant buttons, real Restore\/Refresh flows, and QA failure\/latency toggles. On macOS the sheet uses a 400×600 minimum, matching the vendor paywall UI. Hold a "},{"inlineContent":[{"text":"single","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"code":"SimulatedPaywallService","type":"codeVoice"},{"type":"text","text":" instance and pass it to both "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" (as the plugin’s "},{"code":"service:","type":"codeVoice"},{"type":"text","text":") and "},{"code":".devPaywall(...)","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["@State private var paywallService = SimulatedPaywallService()","@State private var store: AppStore","","init() {","    let service = SimulatedPaywallService()","    _paywallService = State(initialValue: service)","    _store = State(initialValue: .configured(paywallService: service))","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This is the one place a dev\/QA service is intentionally constructed outside "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":", because the debug UI must drive the same instance the plugin observes. Swapping to a real provider removes the shared-instance wiring and the "},{"code":"SwiduxDevPaywallUI","type":"codeVoice"},{"type":"text","text":" import along with the two-line "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" change."}],"type":"paragraph"},{"level":2,"anchor":"Action-semantics","text":"Action semantics","type":"heading"},{"inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}],"type":"paragraph"},{"level":3,"anchor":"requestreason-String","text":"`request(reason: String)`","type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"code":"isPresented = true","type":"codeVoice"},{"type":"text","text":" and stores "},{"code":"requestedReason","type":"codeVoice"},{"type":"text","text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase."}],"type":"paragraph"},{"level":3,"anchor":"dismiss","text":"`dismiss`","type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"code":"isPresented = false","type":"codeVoice"},{"type":"text","text":" and clears "},{"code":"requestedReason","type":"codeVoice"},{"type":"text","text":". Returns an effect that dispatches "},{"code":".refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up)."}],"type":"paragraph"},{"level":3,"anchor":"observeCustomerInfo","text":"`observeCustomerInfo`","type":"heading"},{"inlineContent":[{"type":"text","text":"Returns a long-lived effect that consumes "},{"code":"PaywallService.customerInfoStream()","type":"codeVoice"},{"type":"text","text":" and dispatches "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" for every snapshot. Dispatch once on app launch (typically from a "},{"code":".task","type":"codeVoice"},{"type":"text","text":" on the root view). The effect lives for the duration of the stream. Idempotent: "},{"code":"isObservingCustomerInfo","type":"codeVoice"},{"type":"text","text":" guards against double-subscription, so a re-dispatched "},{"code":".task","type":"codeVoice"},{"type":"text","text":" (view identity change, scene reconnect) won’t start a duplicate stream."}],"type":"paragraph"},{"level":3,"anchor":"refreshCustomerInfo","text":"`refreshCustomerInfo`","type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"code":"isLoading = true","type":"codeVoice"},{"type":"text","text":". Returns a one-shot effect that calls "},{"code":"PaywallService.customerInfo()","type":"codeVoice"},{"type":"text","text":" and dispatches "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" on success or "},{"code":".refreshFailed","type":"codeVoice"},{"type":"text","text":" on error."}],"type":"paragraph"},{"level":3,"anchor":"customerInfoUpdatedEntitlementSnapshot","text":"`customerInfoUpdated(EntitlementSnapshot)`","type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"code":"isPro","type":"codeVoice"},{"type":"text","text":" and "},{"code":"hasPermanentLicense","type":"codeVoice"},{"type":"text","text":" from the snapshot, clears "},{"code":"isLoading","type":"codeVoice"},{"type":"text","text":", and clears "},{"code":"error","type":"codeVoice"},{"type":"text","text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly. Note that the plugin emits this on "},{"inlineContent":[{"text":"every","type":"text"}],"type":"strong"},{"type":"text","text":" snapshot (each "},{"code":"customerInfoStream()","type":"codeVoice"},{"type":"text","text":" value, every "},{"code":"refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"restorePurchases","type":"codeVoice"},{"type":"text","text":"), not only on entitlement changes — observe "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":" (or a value derived from it) for transitions rather than mapping this action directly. See "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"anchor":"refreshFailedString","text":"`refreshFailed(String)`","type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"code":"error","type":"codeVoice"},{"type":"text","text":" to the given message and clears "},{"code":"isLoading","type":"codeVoice"},{"type":"text","text":". Returns no effect."}],"type":"paragraph"},{"level":3,"anchor":"restorePurchases","text":"`restorePurchases`","type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"code":"isLoading = true","type":"codeVoice"},{"type":"text","text":". Returns a one-shot effect that calls "},{"code":"PaywallService.restorePurchases()","type":"codeVoice"},{"type":"text","text":" and dispatches "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" on success or "},{"code":".refreshFailed","type":"codeVoice"},{"type":"text","text":" on error."}],"type":"paragraph"},{"level":3,"anchor":"presentCustomerCenter--dismissCustomerCenter","text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","type":"heading"},{"inlineContent":[{"type":"text","text":"Toggle "},{"code":"isCustomerCenterPresented","type":"codeVoice"},{"type":"text","text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does)."}],"type":"paragraph"},{"level":3,"anchor":"openManageSubscriptions","text":"`openManageSubscriptions`","type":"heading"},{"inlineContent":[{"type":"text","text":"Returns an effect that opens "},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"type":"text","text":" via the configured "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS."}],"type":"paragraph"},{"level":2,"anchor":"Implementing-a-PaywallService","text":"Implementing a `PaywallService`","type":"heading"},{"inlineContent":[{"type":"text","text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an "},{"code":"EntitlementSnapshot","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The protocol has three methods:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"customerInfo() async throws -> EntitlementSnapshot","type":"codeVoice"}],"type":"strong"},{"text":" — One-shot fetch of the current entitlement. The plugin calls this from ","type":"text"},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>","type":"codeVoice"}],"type":"strong"},{"text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from ","type":"text"},{"code":".observeCustomerInfo","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"restorePurchases() async throws -> EntitlementSnapshot","type":"codeVoice"}],"type":"strong"},{"text":" — Performs a restore against the user’s account and returns the resulting entitlement.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Note what the protocol does "},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"type":"text","text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into "},{"code":"EntitlementSnapshot","type":"codeVoice"},{"type":"text","text":" values. A vanilla StoreKit conformer iterates "},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"type":"text","text":" and listens to "},{"code":"Transaction.updates","type":"codeVoice"},{"type":"text","text":". Either way, the plugin stays the same."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"kind":"article","references":{"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"title":"SwiduxRevenueCatPaywall","url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","titleInlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}],"type":"link","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","url":"\/documentation\/swidux\/troubleshooting","abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually me