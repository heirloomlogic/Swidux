{"kind":"article","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginpaywallreference"]}],"abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation","title":"Related Documentation"},{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"anchor":"Reference","title":"Reference"}],"metadata":{"roleHeading":"Article","role":"article","title":"SwiduxPaywall Reference","modules":[{"name":"Swidux"}]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"reference","isActive":true},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Library-target","type":"heading","text":"Library target"},{"items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxPaywall"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":"."}]},{"level":2,"anchor":"Provided-implementations","type":"heading","text":"Provided implementations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin ships with "},{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" for previews and tests. For production RevenueCat integrations, the "},{"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","isActive":true},{"type":"text","text":" companion package provides:"}]},{"items":[{"content":[{"inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" — a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that bridges RevenueCat’s ","type":"text"},{"code":"CustomerInfo","type":"codeVoice"},{"text":" stream and ","type":"text"},{"code":"restorePurchases()","type":"codeVoice"},{"text":" API.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" — a RevenueCat-flavored mock for previews."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For other backends (StoreKit, custom server), implement "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" directly — see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","isActive":true,"type":"reference"},{"type":"text","text":" Step 3, Path B."}],"type":"paragraph"},{"text":"Types","level":2,"anchor":"Types","type":"heading"},{"text":"`PaywallPlugin<RootState, RootAction>`","level":3,"anchor":"PaywallPlugin%3CRootState-RootAction%3E","type":"heading"},{"inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" "},{"code":"SwiduxPlugin","type":"codeVoice"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":" and an action enum typed as "},{"code":"PaywallAction","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The default "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" handler calls "},{"code":"UIApplication.shared.open","type":"codeVoice"},{"type":"text","text":" on UIKit and "},{"code":"NSWorkspace.shared.open","type":"codeVoice"},{"type":"text","text":" on AppKit. Override it for testing or for non-standard environments."}],"type":"paragraph"},{"text":"`PaywallState`","level":3,"anchor":"PaywallState","type":"heading"},{"inlineContent":[{"code":"Sendable","type":"codeVoice"},{"type":"text","text":", "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":" struct. The slice the plugin owns."}],"type":"paragraph"},{"code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"isGateSatisfied","type":"codeVoice"},{"type":"text","text":" is the single read your feature code should consult before running gated work. It is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" when the user holds an active pro subscription or a permanent license."}],"type":"paragraph"},{"text":"`PaywallAction`","level":3,"anchor":"PaywallAction","type":"heading"},{"code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"],"syntax":"swift","type":"codeListing"},{"text":"`EntitlementSnapshot`","level":3,"anchor":"EntitlementSnapshot","type":"heading"},{"inlineContent":[{"type":"text","text":"Provider-agnostic value the service emits to describe the user’s current entitlement."}],"type":"paragraph"},{"code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"],"syntax":"swift","type":"codeListing"},{"text":"`PaywallService` (protocol)","level":3,"anchor":"PaywallService-protocol","type":"heading"},{"code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"],"syntax":"swift","type":"codeListing"},{"text":"`MockPaywallService`","level":3,"anchor":"MockPaywallService","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately.","type":"text"}]},{"code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Action-semantics","type":"heading","text":"Action semantics"},{"inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}],"type":"paragraph"},{"level":3,"text":"`request(reason: String)`","type":"heading","anchor":"requestreason-String"},{"inlineContent":[{"type":"text","text":"Sets "},{"code":"isPresented = true","type":"codeVoice"},{"text":" and stores ","type":"text"},{"code":"requestedReason","type":"codeVoice"},{"type":"text","text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase."}],"type":"paragraph"},{"text":"`dismiss`","level":3,"anchor":"dismiss","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"isPresented = false","type":"codeVoice"},{"text":" and clears ","type":"text"},{"code":"requestedReason","type":"codeVoice"},{"text":". Returns an effect that dispatches ","type":"text"},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up).","type":"text"}]},{"level":3,"text":"`observeCustomerInfo`","type":"heading","anchor":"observeCustomerInfo"},{"type":"paragraph","inlineContent":[{"text":"Returns a long-lived effect that consumes ","type":"text"},{"code":"PaywallService.customerInfoStream()","type":"codeVoice"},{"text":" and dispatches ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" for every snapshot. Dispatch once on app launch (typically from a "},{"code":".task","type":"codeVoice"},{"text":" on the root view). The effect lives for the duration of the stream.","type":"text"}]},{"level":3,"anchor":"refreshCustomerInfo","type":"heading","text":"`refreshCustomerInfo`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"isLoading = true","type":"codeVoice"},{"type":"text","text":". Returns a one-shot effect that calls "},{"code":"PaywallService.customerInfo()","type":"codeVoice"},{"type":"text","text":" and dispatches "},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" on success or ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" on error.","type":"text"}]},{"text":"`customerInfoUpdated(EntitlementSnapshot)`","level":3,"anchor":"customerInfoUpdatedEntitlementSnapshot","type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPro"},{"text":" and ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"type":"text","text":" from the snapshot, clears "},{"code":"isLoading","type":"codeVoice"},{"text":", and clears ","type":"text"},{"type":"codeVoice","code":"error"},{"type":"text","text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly."}],"type":"paragraph"},{"level":3,"anchor":"refreshFailedString","type":"heading","text":"`refreshFailed(String)`"},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"error"},{"text":" to the given message and clears ","type":"text"},{"code":"isLoading","type":"codeVoice"},{"text":". Returns no effect.","type":"text"}],"type":"paragraph"},{"text":"`restorePurchases`","anchor":"restorePurchases","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isLoading = true"},{"type":"text","text":". Returns a one-shot effect that calls "},{"type":"codeVoice","code":"PaywallService.restorePurchases()"},{"text":" and dispatches ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" on success or ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" on error.","type":"text"}]},{"anchor":"presentCustomerCenter--dismissCustomerCenter","level":3,"text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Toggle ","type":"text"},{"code":"isCustomerCenterPresented","type":"codeVoice"},{"type":"text","text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does)."}]},{"type":"heading","anchor":"openManageSubscriptions","text":"`openManageSubscriptions`","level":3},{"type":"paragraph","inlineContent":[{"text":"Returns an effect that opens ","type":"text"},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"text":" via the configured ","type":"text"},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS."}]},{"level":2,"anchor":"Implementing-a-PaywallService","type":"heading","text":"Implementing a `PaywallService`"},{"inlineContent":[{"text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The protocol has three methods:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfo() async throws -> EntitlementSnapshot"}]},{"type":"text","text":" — One-shot fetch of the current entitlement. The plugin calls this from "},{"code":".refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>"}]},{"text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from ","type":"text"},{"type":"codeVoice","code":".observeCustomerInfo"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"restorePurchases() async throws -> EntitlementSnapshot","type":"codeVoice"}]},{"type":"text","text":" — Performs a restore against the user’s account and returns the resulting entitlement."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Note what the protocol does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into "},{"code":"EntitlementSnapshot","type":"codeVoice"},{"type":"text","text":" values. A vanilla StoreKit conformer iterates "},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"type":"text","text":" and listens to "},{"code":"Transaction.updates","type":"codeVoice"},{"type":"text","text":". Either way, the plugin stays the same."}],"type":"paragraph"}]}],"references":{"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"title":"Persistence Middleware","url":"\/documentation\/swidux\/persistencemiddlewareguide","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","role":"article","kind":"article","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","url":"\/documentation\/swidux\/pluginarchitecture","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic","title":"Plugin Architecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}]},"doc://Swidux/documentation/Swidux":{"role":"collection","url":"\/documentation\/swidux","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux","type":"topic","title":"Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}]},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"role":"collectionGroup","url":"\/documentation\/swidux\/keyvaluestoreguide","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","type":"topic","title":"KeyValueStore","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","role":"article","kind":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}]},"doc://Swidux/documentation/Swidux/UndoRedo":{"title":"Undo \/ Redo","url":"\/documentation\/swidux\/undoredo","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","role":"article","kind":"article","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":".","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"title":"SwiduxParentalGate Reference","url":"\/documentation\/swidux\/pluginparentalgatereference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","role":"article","kind":"article","abstract":[{"text":"API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}]},"doc://Swidux/documentation/Swidux/UndoPlugin":{"title":"UndoPlugin","url":"\/documentation\/swidux\/undoplugin","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}]},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"titleInlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}],"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"link","title":"SwiduxRevenueCatPaywall"},"doc://Swidux/documentation/Swidux/MacrosReference":{"title":"Macros","url":"\/documentation\/swidux\/macrosreference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","role":"article","kind":"article","abstract":[{"text":"Reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" — the two macros that generate the observation bridge between value-type state and SwiftUI.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"title":"SwiduxKillswitch Reference","url":"\/documentation\/swidux\/pluginkillswitchreference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","role":"article","kind":"article","abstract":[{"text":"Public API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}]},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"title":"EntityStore","url":"\/documentation\/swidux\/entitystoreguide","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","role":"article","kind":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}]},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"title":"Add a Paywall","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","role":"article","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}]}}}