{"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true,"anchor":"Reference"}],"metadata":{"title":"SwiduxPaywall Reference","modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/swidux\/pluginpaywallreference"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"article","primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Library-target","text":"Library target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"code":"SwiduxPaywall","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxPaywall"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target dependencies in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" alongside ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":".","type":"text"}]},{"text":"Provided implementations","type":"heading","level":2,"anchor":"Provided-implementations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin ships with "},{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" for previews and tests. For production RevenueCat integrations, the "},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"reference","isActive":true},{"text":" companion package provides:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"RevenueCatPaywallService"},{"text":" — a ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that bridges RevenueCat’s "},{"type":"codeVoice","code":"CustomerInfo"},{"type":"text","text":" stream and "},{"code":"restorePurchases()","type":"codeVoice"},{"type":"text","text":" API."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" — a RevenueCat-flavored mock for previews."}]}]},{"content":[{"inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"For other backends (StoreKit, custom server), implement "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" directly — see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","isActive":true},{"type":"text","text":" Step 3, Path B."}],"type":"paragraph"},{"level":2,"text":"Types","type":"heading","anchor":"Types"},{"type":"heading","level":3,"anchor":"PaywallPlugin%3CRootState-RootAction%3E","text":"`PaywallPlugin<RootState, RootAction>`"},{"inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" "},{"code":"SwiduxPlugin","type":"codeVoice"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":" and an action enum typed as "},{"code":"PaywallAction","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" handler calls "},{"code":"UIApplication.shared.open","type":"codeVoice"},{"type":"text","text":" on UIKit and "},{"code":"NSWorkspace.shared.open","type":"codeVoice"},{"type":"text","text":" on AppKit. Override it for testing or for non-standard environments."}]},{"type":"heading","level":3,"anchor":"PaywallState","text":"`PaywallState`"},{"type":"paragraph","inlineContent":[{"code":"Sendable","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"Equatable"},{"text":" struct. The slice the plugin owns.","type":"text"}]},{"code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"isGateSatisfied","type":"codeVoice"},{"type":"text","text":" is the single read your feature code should consult before running gated work. It is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when the user holds an active pro subscription or a permanent license."}]},{"type":"heading","level":3,"anchor":"PaywallAction","text":"`PaywallAction`"},{"code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":3,"anchor":"EntitlementSnapshot","text":"`EntitlementSnapshot`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provider-agnostic value the service emits to describe the user’s current entitlement."}]},{"code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"`PaywallService` (protocol)","anchor":"PaywallService-protocol"},{"code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"],"type":"codeListing","syntax":"swift"},{"type":"heading","text":"`MockPaywallService`","level":3,"anchor":"MockPaywallService"},{"type":"paragraph","inlineContent":[{"text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"type":"heading","text":"Action semantics","level":2,"anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}]},{"type":"heading","text":"`request(reason: String)`","level":3,"anchor":"requestreason-String"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPresented = true"},{"type":"text","text":" and stores "},{"type":"codeVoice","code":"requestedReason"},{"type":"text","text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase."}]},{"type":"heading","level":3,"anchor":"dismiss","text":"`dismiss`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPresented = false"},{"type":"text","text":" and clears "},{"type":"codeVoice","code":"requestedReason"},{"type":"text","text":". Returns an effect that dispatches "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up)."}]},{"type":"heading","level":3,"anchor":"observeCustomerInfo","text":"`observeCustomerInfo`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns a long-lived effect that consumes "},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" for every snapshot. Dispatch once on app launch (typically from a "},{"type":"codeVoice","code":".task"},{"type":"text","text":" on the root view). The effect lives for the duration of the stream."}]},{"type":"heading","level":3,"anchor":"refreshCustomerInfo","text":"`refreshCustomerInfo`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isLoading = true"},{"type":"text","text":". Returns a one-shot effect that calls "},{"type":"codeVoice","code":"PaywallService.customerInfo()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" on error."}]},{"type":"heading","level":3,"anchor":"customerInfoUpdatedEntitlementSnapshot","text":"`customerInfoUpdated(EntitlementSnapshot)`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" from the snapshot, clears "},{"type":"codeVoice","code":"isLoading"},{"type":"text","text":", and clears "},{"type":"codeVoice","code":"error"},{"type":"text","text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly. Note that the plugin emits this on "},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"type":"text","text":" snapshot (each "},{"type":"codeVoice","code":"customerInfoStream()"},{"type":"text","text":" value, every "},{"type":"codeVoice","code":"refreshCustomerInfo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"restorePurchases"},{"type":"text","text":"), not only on entitlement changes — observe "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":" (or a value derived from it) for transitions rather than mapping this action directly. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation"},{"type":"text","text":"."}]},{"type":"heading","level":3,"anchor":"refreshFailedString","text":"`refreshFailed(String)`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"error"},{"type":"text","text":" to the given message and clears "},{"type":"codeVoice","code":"isLoading"},{"type":"text","text":". Returns no effect."}]},{"type":"heading","level":3,"anchor":"restorePurchases","text":"`restorePurchases`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isLoading = true"},{"type":"text","text":". Returns a one-shot effect that calls "},{"type":"codeVoice","code":"PaywallService.restorePurchases()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" on error."}]},{"type":"heading","level":3,"anchor":"presentCustomerCenter--dismissCustomerCenter","text":"`presentCustomerCenter` \/ `dismissCustomerCenter`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Toggle "},{"type":"codeVoice","code":"isCustomerCenterPresented"},{"type":"text","text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does)."}]},{"type":"heading","level":3,"anchor":"openManageSubscriptions","text":"`openManageSubscriptions`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns an effect that opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" via the configured "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS."}]},{"type":"heading","level":2,"anchor":"Implementing-a-PaywallService","text":"Implementing a `PaywallService`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol has three methods:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"customerInfo() async throws -> EntitlementSnapshot","type":"codeVoice"}]},{"text":" — One-shot fetch of the current entitlement. The plugin calls this from ","type":"text"},{"type":"codeVoice","code":".refreshCustomerInfo"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>","type":"codeVoice"}]},{"text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from ","type":"text"},{"type":"codeVoice","code":".observeCustomerInfo"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"restorePurchases() async throws -> EntitlementSnapshot","type":"codeVoice"}]},{"text":" — Performs a restore against the user’s account and returns the resulting entitlement.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note what the protocol does "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" values. A vanilla StoreKit conformer iterates "},{"type":"codeVoice","code":"Transaction.currentEntitlements"},{"type":"text","text":" and listens to "},{"type":"codeVoice","code":"Transaction.updates"},{"type":"text","text":". Either way, the plugin stays the same."}]}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"url":"\/documentation\/swidux\/pluginfeatureflagsreference","title":"SwiduxFeatureFlags Reference","kind":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"title":"Service-Result Actions and Transition Observation","abstract":[],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","kind":"section","type":"topic","url":"\/documentation\/swidux\/pluginarchitecture#Service-Result-Actions-and-Transition-Observation"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","role":"article","title":"Add a Paywall","type":"topic","url":"\/documentation\/swidux\/howtoaddapaywall","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","role":"article","title":"Getting Started with Swidux","type":"topic","url":"\/documentation\/swidux\/gettingstarted","kind":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","url":"\/documentation\/swidux\/pluginkillswitchreference","ti