/documentation\/swidux\/undoredo","kind":"article","type":"topic","title":"Undo \/ Redo","role":"article","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":"."}]},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","role":"collectionGroup","title":"KeyValueStore","type":"topic","url":"\/documentation\/swidux\/keyvaluestoreguide","kind":"article","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","url":"\/documentation\/swidux\/pluginanalyticsreference","kind":"article","type":"topic","title":"SwiduxAnalytics Reference","role":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"url":"\/documentation\/swidux\/pluginparentalgatereference","title":"SwiduxParentalGate Reference","kind":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}],"role":"symbol","title":"UndoPlugin","type":"topic","url":"\/documentation\/swidux\/undoplugin","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}]},"doc://Swidux/documentation/Swidux/MacrosReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","url":"\/documentation\/swidux\/macrosreference","kind":"article","type":"topic","title":"Macros","role":"article","abstract":[{"text":"Reference for ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" — the two macros that generate the observation bridge between value-type state and SwiftUI.","type":"text"}]},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","url":"\/documentation\/swidux\/entitystoreguide","title":"EntityStore","kind":"article","type":"topic","role":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}]}}}