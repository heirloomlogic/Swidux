{"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"title":"Reference","generated":true}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"sections":[],"metadata":{"role":"article","roleHeading":"Article","title":"SwiduxPaywall Reference","modules":[{"name":"Swidux"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/swidux\/pluginpaywallreference"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"text":". For where this plugin sits in the lifecycle, see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Library target","anchor":"Library-target"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"code":"SwiduxPaywall","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxPaywall","type":"codeVoice"}]}]}]},{"inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":" alongside "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Provided-implementations","type":"heading","level":2,"text":"Provided implementations"},{"inlineContent":[{"type":"text","text":"The plugin ships with "},{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" for previews and tests. For production RevenueCat integrations, the "},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"reference","isActive":true},{"type":"text","text":" companion package provides:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" — a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that bridges RevenueCat’s ","type":"text"},{"code":"CustomerInfo","type":"codeVoice"},{"text":" stream and ","type":"text"},{"code":"restorePurchases()","type":"codeVoice"},{"text":" API.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" — a RevenueCat-flavored mock for previews.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin.","type":"text"}]}]}]},{"inlineContent":[{"text":"For other backends (StoreKit, custom server), implement ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" directly — see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"type":"text","text":" Step 3, Path B."}],"type":"paragraph"},{"anchor":"Types","type":"heading","level":2,"text":"Types"},{"anchor":"PaywallPlugin%3CRootState-RootAction%3E","type":"heading","level":3,"text":"`PaywallPlugin<RootState, RootAction>`"},{"inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":" and an action enum typed as "},{"code":"PaywallAction","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The default ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" handler calls ","type":"text"},{"type":"codeVoice","code":"UIApplication.shared.open"},{"text":" on UIKit and ","type":"text"},{"type":"codeVoice","code":"NSWorkspace.shared.open"},{"text":" on AppKit. Override it for testing or for non-standard environments.","type":"text"}]},{"level":3,"type":"heading","text":"`PaywallState`","anchor":"PaywallState"},{"type":"paragraph","inlineContent":[{"code":"Sendable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":" struct. The slice the plugin owns."}]},{"type":"codeListing","syntax":"swift","code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"]},{"type":"paragraph","inlineContent":[{"code":"isGateSatisfied","type":"codeVoice"},{"type":"text","text":" is the single read your feature code should consult before running gated work. It is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" when the user holds an active pro subscription or a permanent license."}]},{"anchor":"PaywallAction","type":"heading","text":"`PaywallAction`","level":3},{"type":"codeListing","syntax":"swift","code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"]},{"anchor":"EntitlementSnapshot","type":"heading","text":"`EntitlementSnapshot`","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provider-agnostic value the service emits to describe the user’s current entitlement."}]},{"type":"codeListing","syntax":"swift","code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"]},{"anchor":"PaywallService-protocol","type":"heading","text":"`PaywallService` (protocol)","level":3},{"type":"codeListing","syntax":"swift","code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"anchor":"MockPaywallService","type":"heading","text":"`MockPaywallService`","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately."}]},{"type":"codeListing","syntax":"swift","code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"anchor":"Action-semantics","type":"heading","text":"Action semantics","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}]},{"anchor":"requestreason-String","type":"heading","text":"`request(reason: String)`","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"isPresented = true","type":"codeVoice"},{"type":"text","text":" and stores "},{"code":"requestedReason","type":"codeVoice"},{"type":"text","text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase."}]},{"anchor":"dismiss","type":"heading","text":"`dismiss`","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"isPresented = false","type":"codeVoice"},{"type":"text","text":" and clears "},{"code":"requestedReason","type":"codeVoice"},{"type":"text","text":". Returns an effect that dispatches "},{"code":".refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up)."}]},{"anchor":"observeCustomerInfo","type":"heading","text":"`observeCustomerInfo`","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns a long-lived effect that consumes "},{"code":"PaywallService.customerInfoStream()","type":"codeVoice"},{"type":"text","text":" and dispatches "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" for every snapshot. Dispatch once on app launch (typically from a "},{"code":".task","type":"codeVoice"},{"type":"text","text":" on the root view). The effect lives for the duration of the stream."}]},{"anchor":"refreshCustomerInfo","type":"heading","text":"`refreshCustomerInfo`","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isLoading = true"},{"type":"text","text":". Returns a one-shot effect that calls "},{"type":"codeVoice","code":"PaywallService.customerInfo()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"code":".refreshFailed","type":"codeVoice"},{"text":" on error.","type":"text"}]},{"anchor":"customerInfoUpdatedEntitlementSnapshot","level":3,"text":"`customerInfoUpdated(EntitlementSnapshot)`","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isPro"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":" from the snapshot, clears ","type":"text"},{"type":"codeVoice","code":"isLoading"},{"text":", and clears ","type":"text"},{"type":"codeVoice","code":"error"},{"text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly.","type":"text"}],"type":"paragraph"},{"anchor":"refreshFailedString","level":3,"text":"`refreshFailed(String)`","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"error","type":"codeVoice"},{"type":"text","text":" to the given message and clears "},{"code":"isLoading","type":"codeVoice"},{"text":". Returns no effect.","type":"text"}],"type":"paragraph"},{"text":"`restorePurchases`","anchor":"restorePurchases","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isLoading = true"},{"type":"text","text":". Returns a one-shot effect that calls "},{"type":"codeVoice","code":"PaywallService.restorePurchases()"},{"type":"text","text":" and dispatches "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" on success or "},{"code":".refreshFailed","type":"codeVoice"},{"type":"text","text":" on error."}]},{"text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","anchor":"presentCustomerCenter--dismissCustomerCenter","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Toggle ","type":"text"},{"code":"isCustomerCenterPresented","type":"codeVoice"},{"text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does).","type":"text"}]},{"level":3,"type":"heading","text":"`openManageSubscriptions`","anchor":"openManageSubscriptions"},{"inlineContent":[{"text":"Returns an effect that opens ","type":"text"},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"text":" via the configured ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS.","type":"text"}],"type":"paragraph"},{"anchor":"Implementing-a-PaywallService","level":2,"text":"Implementing a `PaywallService`","type":"heading"},{"inlineContent":[{"text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol has three methods:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfo() async throws -> EntitlementSnapshot"}]},{"text":" — One-shot fetch of the current entitlement. The plugin calls this from ","type":"text"},{"type":"codeVoice","code":".refreshCustomerInfo"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"restorePurchases() async throws -> EntitlementSnapshot"}]},{"text":" — Performs a restore against the user’s account and returns the resulting entitlement.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Note what the protocol does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" values. A vanilla StoreKit conformer iterates "},{"type":"codeVoice","code":"Transaction.currentEntitlements"},{"type":"text","text":" and listens to "},{"type":"codeVoice","code":"Transaction.updates"},{"type":"text","text":". Either way, the plugin stays the same."}]}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","interfaceLanguage":"swift"},"references":{"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"title":"Add a Paywall","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"topic"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"topic","title":"UndoPlugin","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}],"kind":"symbol","role":"symbol","url":"\/documentation\/swidux\/undoplugin","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"type":"topic","title":"Getting St