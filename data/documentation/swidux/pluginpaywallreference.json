{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginpaywallreference"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"generated":true,"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"title":"Reference"}],"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"SwiduxPaywall Reference"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"Overview","type":"heading"},{"inlineContent":[{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","isActive":true,"type":"reference"},{"text":". For where this plugin sits in the lifecycle, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Library target","level":2,"anchor":"Library-target","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxPaywall"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxPaywall"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Add the product to your target dependencies in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" alongside ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Provided implementations","level":2,"anchor":"Provided-implementations","type":"heading"},{"inlineContent":[{"text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" — fixed snapshot, stream finishes immediately; for previews and tests."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"SimulatedPaywallService"},{"type":"text","text":" — a stateful, fully driveable service. Paired with the "},{"type":"codeVoice","code":"SwiduxDevPaywallUI"},{"type":"text","text":" debug sheet, it lets a developer or QA tester grant Pro\/Trial\/Permanent, restore, and simulate failure\/latency — all flowing through the real plugin pipeline, with no SDK and no vendor commitment. Use it as the "},{"type":"codeVoice","code":"service:"},{"type":"text","text":" while the paywall vendor decision is still open."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"For production RevenueCat integrations, the ","type":"text"},{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","isActive":true,"type":"reference"},{"text":" companion package provides:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"RevenueCatPaywallService"},{"type":"text","text":" — a "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that bridges RevenueCat’s "},{"type":"codeVoice","code":"CustomerInfo"},{"type":"text","text":" stream and "},{"type":"codeVoice","code":"restorePurchases()"},{"type":"text","text":" API."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" — a RevenueCat-flavored mock for previews."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"For other backends (StoreKit, custom server), implement ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" directly — see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","isActive":true,"type":"reference"},{"text":" Step 3, Path B.","type":"text"}],"type":"paragraph"},{"text":"Types","level":2,"anchor":"Types","type":"heading"},{"text":"`PaywallPlugin<RootState, RootAction>`","level":3,"anchor":"PaywallPlugin%3CRootState-RootAction%3E","type":"heading"},{"inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"text":" ","type":"text"},{"code":"SwiduxPlugin","type":"codeVoice"},{"text":" conformer. Owns a slice of root state typed as ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":" and an action enum typed as ","type":"text"},{"code":"PaywallAction","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"],"type":"codeListing"},{"inlineContent":[{"text":"The default ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" handler calls ","type":"text"},{"code":"UIApplication.shared.open","type":"codeVoice"},{"text":" on UIKit and ","type":"text"},{"code":"NSWorkspace.shared.open","type":"codeVoice"},{"text":" on AppKit. Override it for testing or for non-standard environments.","type":"text"}],"type":"paragraph"},{"text":"`PaywallState`","level":3,"anchor":"PaywallState","type":"heading"},{"inlineContent":[{"code":"Sendable","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Equatable","type":"codeVoice"},{"text":" struct. The slice the plugin owns.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"],"type":"codeListing"},{"inlineContent":[{"code":"isGateSatisfied","type":"codeVoice"},{"text":" is the single read your feature code should consult before running gated work. It is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" when the user holds an active pro subscription or a permanent license.","type":"text"}],"type":"paragraph"},{"text":"`PaywallAction`","level":3,"anchor":"PaywallAction","type":"heading"},{"syntax":"swift","code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"],"type":"codeListing"},{"text":"`EntitlementSnapshot`","level":3,"anchor":"EntitlementSnapshot","type":"heading"},{"inlineContent":[{"text":"Provider-agnostic value the service emits to describe the user’s current entitlement.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"],"type":"codeListing"},{"text":"`PaywallService` (protocol)","level":3,"anchor":"PaywallService-protocol","type":"heading"},{"syntax":"swift","code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"],"type":"codeListing"},{"text":"`MockPaywallService`","level":3,"anchor":"MockPaywallService","type":"heading"},{"inlineContent":[{"text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"],"type":"codeListing"},{"text":"`SimulatedPaywallService`","level":3,"anchor":"SimulatedPaywallService","type":"heading"},{"inlineContent":[{"text":"Stateful ","type":"text"},{"code":"actor","type":"codeVoice"},{"text":" conformer for development and QA. Holds the current entitlement and multicasts changes through ","type":"text"},{"code":"customerInfoStream()","type":"codeVoice"},{"text":", so simulated grants survive a later ","type":"text"},{"code":"refreshCustomerInfo","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"restorePurchases","type":"codeVoice"},{"text":" exactly as a real service would.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public actor SimulatedPaywallService: PaywallService {","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        subsystem: String = \"Swidux\",","        category: String = \"Paywall\"","    )","","    \/\/ PaywallService: customerInfo \/ customerInfoStream \/ restorePurchases","","    \/\/ Simulation surface (not part of PaywallService — driven by the dev UI):","    public func grantPro()","    public func grantTrial()","    public func grantPermanentLicense()","    public func setFree()","    public func setRestoreShouldFail(_ shouldFail: Bool)","    public func setRefreshShouldFail(_ shouldFail: Bool)","    public func setArtificialDelay(_ delay: Duration)","}","","public enum SimulatedPaywallError: Error, Equatable {","    case restoreFailed","    case refreshFailed","}"],"type":"codeListing"},{"inlineContent":[{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":" only models ","type":"text"},{"code":"isPro","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":", so ","type":"text"},{"code":"grantTrial()","type":"codeVoice"},{"text":" yields ","type":"text"},{"code":"isPro == true","type":"codeVoice"},{"text":" and is distinguished from ","type":"text"},{"code":"grantPro()","type":"codeVoice"},{"text":" only in the log line.","type":"text"}],"type":"paragraph"},{"text":"`SwiduxDevPaywallUI`","level":3,"anchor":"SwiduxDevPaywallUI","type":"heading"},{"inlineContent":[{"text":"A separate, opt-in library product (","type":"text"},{"code":"import SwiduxDevPaywallUI","type":"codeVoice"},{"text":") providing a bare-bones debug paywall sheet. It mirrors the shape of the vendor paywall UI so the call site is unchanged when a real provider is adopted:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["someView.devPaywall(","    state: store.paywall,","    service: simulatedPaywallService,","    onAction: { store.send(.paywall($0)) }",")"],"type":"codeListing"},{"inlineContent":[{"text":"The sheet shows the live ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":", grant buttons, real Restore\/Refresh flows, and QA failure\/latency toggles. Hold a ","type":"text"},{"inlineContent":[{"text":"single","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"code":"SimulatedPaywallService","type":"codeVoice"},{"text":" instance and pass it to both ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" (as the plugin’s ","type":"text"},{"code":"service:","type":"codeVoice"},{"text":") and ","type":"text"},{"code":".devPaywall(...)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@State private var paywallService = SimulatedPaywallService()","@State private var store: AppStore","","init() {","    let service = SimulatedPaywallService()","    _paywallService = State(initialValue: service)","    _store = State(initialValue: .configured(paywallService: service))","}"],"type":"codeListing"},{"inlineContent":[{"text":"This is the one place a dev\/QA service is intentionally constructed outside ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":", because the debug UI must drive the same instance the plugin observes. Swapping to a real provider removes the shared-instance wiring and the ","type":"text"},{"code":"SwiduxDevPaywallUI","type":"codeVoice"},{"text":" import along with the two-line ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" change.","type":"text"}],"type":"paragraph"},{"text":"Action semantics","level":2,"anchor":"Action-semantics","type":"heading"},{"inlineContent":[{"text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns.","type":"text"}],"type":"paragraph"},{"text":"`request(reason: String)`","level":3,"anchor":"requestreason-String","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"isPresented = true","type":"codeVoice"},{"text":" and stores ","type":"text"},{"code":"requestedReason","type":"codeVoice"},{"text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase.","type":"text"}],"type":"paragraph"},{"text":"`dismiss`","level":3,"anchor":"dismiss","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"isPresented = false","type":"codeVoice"},{"text":" and clears ","type":"text"},{"code":"requestedReason","type":"codeVoice"},{"text":". Returns an effect that dispatches ","type":"text"},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up).","type":"text"}],"type":"paragraph"},{"text":"`observeCustomerInfo`","level":3,"anchor":"observeCustomerInfo","type":"heading"},{"inlineContent":[{"text":"Returns a long-lived effect that consumes ","type":"text"},{"code":"PaywallService.customerInfoStream()","type":"codeVoice"},{"text":" and dispatches ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" for every snapshot. Dispatch once on app launch (typically from a ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" on the root view). The effect lives for the duration of the stream.","type":"text"}],"type":"paragraph"},{"text":"`refreshCustomerInfo`","level":3,"anchor":"refreshCustomerInfo","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"isLoading = true","type":"codeVoice"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"code":"PaywallService.customerInfo()","type":"codeVoice"},{"text":" and dispatches ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" on success or ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" on error.","type":"text"}],"type":"paragraph"},{"text":"`customerInfoUpdated(EntitlementSnapshot)`","level":3,"anchor":"customerInfoUpdatedEntitlementSnapshot","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"isPro","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":" from the snapshot, clears ","type":"text"},{"code":"isLoading","type":"codeVoice"},{"text":", and clears ","type":"text"},{"code":"error","type":"codeVoice"},{"text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly. Note that the plugin emits this on ","type":"text"},{"inlineContent":[{"text":"every","type":"text"}],"type":"strong"},{"text":" snapshot (each ","type":"text"},{"code":"customerInfoStream()","type":"codeVoice"},{"text":" value, every ","type":"text"},{"code":"refreshCustomerInfo","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"restorePurchases","type":"codeVoice"},{"text":"), not only on entitlement changes — observe ","type":"text"},{"code":"PaywallState","type":"codeVoice"},{"text":" (or a value derived from it) for transitions rather than mapping this action directly. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"`refreshFailed(String)`","level":3,"anchor":"refreshFailedString","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"error","type":"codeVoice"},{"text":" to the given message and clears ","type":"text"},{"code":"isLoading","type":"codeVoice"},{"text":". Returns no effect.","type":"text"}],"type":"paragraph"},{"text":"`restorePurchases`","level":3,"anchor":"restorePurchases","type":"heading"},{"inlineContent":[{"text":"Sets ","type":"text"},{"code":"isLoading = true","type":"codeVoice"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"code":"PaywallService.restorePurchases()","type":"codeVoice"},{"text":" and dispatches ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" on success or ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" on error.","type":"text"}],"type":"paragraph"},{"text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","level":3,"anchor":"presentCustomerCenter--dismissCustomerCenter","type":"heading"},{"inlineContent":[{"text":"Toggle ","type":"text"},{"code":"isCustomerCenterPresented","type":"codeVoice"},{"text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does).","type":"text"}],"type":"paragraph"},{"text":"`openManageSubscriptions`","level":3,"anchor":"openManageSubscriptions","type":"heading"},{"inlineContent":[{"text":"Returns an effect that opens ","type":"text"},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"text":" via the configured ","type":"text"},{"code":"openURL","type":"codeVoice"},{"text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS.","type":"text"}],"type":"paragraph"},{"text":"Implementing a `PaywallService`","level":2,"anchor":"Implementing-a-PaywallService","type":"heading"},{"inlineContent":[{"text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an ","type":"text"},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The protocol has three methods:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"customerInfo() async throws -> EntitlementSnapshot"}],"type":"strong"},{"type":"text","text":" — One-shot fetch of the current entitlement. The plugin calls this from "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>"}],"type":"strong"},{"type":"text","text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"restorePurchases() async throws -> EntitlementSnapshot"}],"type":"strong"},{"type":"text","text":" — Performs a restore against the user’s account and returns the resulting entitlement."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Note what the protocol does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into ","type":"text"},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":" values. A vanilla StoreKit conformer iterates ","type":"text"},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"text":" and listens to ","type":"text"},{"code":"Transaction.updates","type":"codeVoice"},{"text":". Either way, the plugin stays the same.","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"references":{"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"link","titleInlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}],"title":"SwiduxRevenueCatPaywall"},"doc://Swidux/documentation/Swidux/UndoRedo":{"type":"topic","title":"Undo \/ Redo","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/swidux\/undoredo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"type":"topic","title":"SwiduxAnalytics Reference","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"url":"\/documentation\/swidux\/pluginanalyticsreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"type":"topic","title":"EntityStore","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"url":"\/documentation\/swidux\/entitystoreguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","type":"topic","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddapaywall","role":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"type":"topic","title":"SwiduxParentalGate Reference","abstract":[{"type":"text","text":"API surface for the "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"url":"\/documentation\/swidux\/pluginparentalgatereference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/MacrosReference":{"type":"topic","title":"Macros","abstract":[{"type":"text","text":"Reference for "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" and "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":" — the two macros that generate the observation bridge between value-type state and SwiftUI."}],"url":"\/documentation\/swidux\/macrosreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux":{"type":"topic","title":"Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"url":"\/documentation\/swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","role":"collection"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"type":"topic","title":"Plugin Architecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"url":"\/documentation\/swidux\/pluginarchitecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"title":"UndoPlugin","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"url":"\/documentation\/swidux\/undoplugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","title":"Service-Result Actions and Transition Observation","url":"\/documentation\/swidux\/pluginarchitecture#Service-Result-Actions-and-Transition-Observation","type":"topic","kind":"section","abstract":[]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"type":"topic","title":"SwiduxKillswitch Reference","abstract":[{"type":"text","text":"Public API surface for the "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"url":"\/documentation\/swidux\/pluginkillswitchreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"type":"topic","title":"SwiduxFeatureFlags Reference","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"url":"\/documentation\/swidux\/pluginfeatureflagsreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"title":"Getting Started with Swidux","kind":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","url":"\/documentation\/swidux\/gettingstarted","role":"article"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"type":"topic","title":"Persistence Middleware","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"url":"\/documentation\/swidux\/persistencemiddlewareguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"type":"topic","title":"KeyValueStore","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"url":"\/documentation\/swidux\/keyvaluestoreguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","kind":"article","role":"collectionGroup"}}}