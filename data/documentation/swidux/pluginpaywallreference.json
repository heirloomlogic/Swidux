{"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"anchor":"Reference","generated":true,"title":"Reference"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"reference","isActive":true},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"type":"text","text":"."}]},{"anchor":"Library-target","text":"Library target","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxPaywall"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Provided implementations","anchor":"Provided-implementations","level":2},{"inlineContent":[{"type":"text","text":"The plugin ships with "},{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" for previews and tests. For production RevenueCat integrations, the "},{"isActive":true,"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall"},{"type":"text","text":" companion package provides:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" — a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that bridges RevenueCat’s "},{"code":"CustomerInfo","type":"codeVoice"},{"text":" stream and ","type":"text"},{"type":"codeVoice","code":"restorePurchases()"},{"type":"text","text":" API."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"type":"text","text":" — a RevenueCat-flavored mock for previews."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For other backends (StoreKit, custom server), implement "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" directly — see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"type":"text","text":" Step 3, Path B."}]},{"type":"heading","text":"Types","anchor":"Types","level":2},{"type":"heading","text":"`PaywallPlugin<RootState, RootAction>`","level":3,"anchor":"PaywallPlugin%3CRootState-RootAction%3E"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":" and an action enum typed as "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":"."}]},{"code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The default ","type":"text"},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" handler calls "},{"code":"UIApplication.shared.open","type":"codeVoice"},{"text":" on UIKit and ","type":"text"},{"type":"codeVoice","code":"NSWorkspace.shared.open"},{"type":"text","text":" on AppKit. Override it for testing or for non-standard environments."}],"type":"paragraph"},{"level":3,"type":"heading","anchor":"PaywallState","text":"`PaywallState`"},{"type":"paragraph","inlineContent":[{"code":"Sendable","type":"codeVoice"},{"type":"text","text":", "},{"code":"Equatable","type":"codeVoice"},{"text":" struct. The slice the plugin owns.","type":"text"}]},{"code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"code":"isGateSatisfied","type":"codeVoice"},{"type":"text","text":" is the single read your feature code should consult before running gated work. It is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" when the user holds an active pro subscription or a permanent license."}],"type":"paragraph"},{"anchor":"PaywallAction","text":"`PaywallAction`","type":"heading","level":3},{"type":"codeListing","syntax":"swift","code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"]},{"type":"heading","text":"`EntitlementSnapshot`","anchor":"EntitlementSnapshot","level":3},{"type":"paragraph","inlineContent":[{"text":"Provider-agnostic value the service emits to describe the user’s current entitlement.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"]},{"text":"`PaywallService` (protocol)","level":3,"anchor":"PaywallService-protocol","type":"heading"},{"syntax":"swift","code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"],"type":"codeListing"},{"text":"`MockPaywallService`","level":3,"anchor":"MockPaywallService","type":"heading"},{"inlineContent":[{"type":"text","text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"level":2,"anchor":"Action-semantics","text":"Action semantics","type":"heading"},{"inlineContent":[{"text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"requestreason-String","text":"`request(reason: String)`","type":"heading"},{"inlineContent":[{"type":"text","text":"Sets "},{"code":"isPresented = true","type":"codeVoice"},{"text":" and stores ","type":"text"},{"code":"requestedReason","type":"codeVoice"},{"text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase.","type":"text"}],"type":"paragraph"},{"text":"`dismiss`","anchor":"dismiss","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"isPresented = false","type":"codeVoice"},{"type":"text","text":" and clears "},{"type":"codeVoice","code":"requestedReason"},{"text":". Returns an effect that dispatches ","type":"text"},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up).","type":"text"}]},{"level":3,"text":"`observeCustomerInfo`","type":"heading","anchor":"observeCustomerInfo"},{"inlineContent":[{"type":"text","text":"Returns a long-lived effect that consumes "},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"text":" and dispatches ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" for every snapshot. Dispatch once on app launch (typically from a ","type":"text"},{"code":".task","type":"codeVoice"},{"text":" on the root view). The effect lives for the duration of the stream.","type":"text"}],"type":"paragraph"},{"level":3,"text":"`refreshCustomerInfo`","type":"heading","anchor":"refreshCustomerInfo"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isLoading = true"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"code":"PaywallService.customerInfo()","type":"codeVoice"},{"text":" and dispatches ","type":"text"},{"code":".customerInfoUpdated","type":"codeVoice"},{"text":" on success or ","type":"text"},{"type":"codeVoice","code":".refreshFailed"},{"text":" on error.","type":"text"}]},{"anchor":"customerInfoUpdatedEntitlementSnapshot","type":"heading","level":3,"text":"`customerInfoUpdated(EntitlementSnapshot)`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isPro"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":" from the snapshot, clears ","type":"text"},{"type":"codeVoice","code":"isLoading"},{"text":", and clears ","type":"text"},{"type":"codeVoice","code":"error"},{"text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly.","type":"text"}]},{"anchor":"refreshFailedString","type":"heading","level":3,"text":"`refreshFailed(String)`"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"code":"error","type":"codeVoice"},{"text":" to the given message and clears ","type":"text"},{"code":"isLoading","type":"codeVoice"},{"text":". Returns no effect.","type":"text"}]},{"text":"`restorePurchases`","type":"heading","level":3,"anchor":"restorePurchases"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isLoading = true"},{"type":"text","text":". Returns a one-shot effect that calls "},{"type":"codeVoice","code":"PaywallService.restorePurchases()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" on error."}]},{"text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","type":"heading","level":3,"anchor":"presentCustomerCenter--dismissCustomerCenter"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Toggle "},{"type":"codeVoice","code":"isCustomerCenterPresented"},{"type":"text","text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does)."}]},{"text":"`openManageSubscriptions`","type":"heading","level":3,"anchor":"openManageSubscriptions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns an effect that opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" via the configured "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS."}]},{"text":"Implementing a `PaywallService`","type":"heading","level":2,"anchor":"Implementing-a-PaywallService"},{"inlineContent":[{"text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol has three methods:"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"customerInfo() async throws -> EntitlementSnapshot","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — One-shot fetch of the current entitlement. The plugin calls this from "},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>"}],"type":"strong"},{"text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from ","type":"text"},{"type":"codeVoice","code":".observeCustomerInfo"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"restorePurchases() async throws -> EntitlementSnapshot","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Performs a restore against the user’s account and returns the resulting entitlement."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Note what the protocol does ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results."}]},{"type":"paragraph","inlineContent":[{"text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot"},{"text":" values. A vanilla StoreKit conformer iterates ","type":"text"},{"type":"codeVoice","code":"Transaction.currentEntitlements"},{"text":" and listens to ","type":"text"},{"type":"codeVoice","code":"Transaction.updates"},{"text":". Either way, the plugin stays the same.","type":"text"}]}]}],"kind":"article","identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","interfaceLanguage":"swift"},"abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"metadata":{"modules":[{"name":"Swidux"}],"title":"SwiduxPaywall Reference","role":"article","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginpaywallreference"]}],"sections":[],"references":{"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"url":"\/documentation\/swidux\/howtoaddapaywall","role":"article","kind":"article","title":"Add a Paywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"topic","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}]},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"url":"\/documentation\/swidux\/entitystoreguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","role":"article","kind":"article","type":"topic","title":"EntityStore","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}]},"doc://Swidux/document