{"sections":[],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article","title":"SwiduxPaywall Reference"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"title":"Reference","generated":true,"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginpaywallreference"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","isActive":true},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}]},{"type":"heading","text":"Library target","anchor":"Library-target","level":2},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxPaywall"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Import: "},{"type":"codeVoice","code":"import SwiduxPaywall"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target dependencies in ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":" alongside ","type":"text"},{"type":"codeVoice","code":"Swidux"},{"text":".","type":"text"}]},{"type":"heading","text":"Provided implementations","level":2,"anchor":"Provided-implementations"},{"type":"paragraph","inlineContent":[{"text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" — fixed snapshot, stream finishes immediately; for previews and tests."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"SimulatedPaywallService","type":"codeVoice"},{"type":"text","text":" — a stateful, fully driveable service. Paired with the "},{"code":"SwiduxDevPaywallUI","type":"codeVoice"},{"type":"text","text":" debug sheet, it lets a developer or QA tester grant Pro\/Trial\/Permanent, restore, and simulate failure\/latency — all flowing through the real plugin pipeline, with no SDK and no vendor commitment. Use it as the "},{"code":"service:","type":"codeVoice"},{"type":"text","text":" while the paywall vendor decision is still open."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"For production RevenueCat integrations, the ","type":"text"},{"isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"reference"},{"text":" companion package provides:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" — a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that bridges RevenueCat’s "},{"code":"CustomerInfo","type":"codeVoice"},{"type":"text","text":" stream and "},{"code":"restorePurchases()","type":"codeVoice"},{"type":"text","text":" API."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" — a RevenueCat-flavored mock for previews."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"For other backends (StoreKit, custom server), implement ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" directly — see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"reference"},{"text":" Step 3, Path B.","type":"text"}]},{"type":"heading","text":"Types","level":2,"anchor":"Types"},{"type":"heading","text":"`PaywallPlugin<RootState, RootAction>`","level":3,"anchor":"PaywallPlugin%3CRootState-RootAction%3E"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SwiduxPlugin"},{"text":" conformer. Owns a slice of root state typed as ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":" and an action enum typed as ","type":"text"},{"type":"codeVoice","code":"PaywallAction"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"]},{"type":"paragraph","inlineContent":[{"text":"The default ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" handler calls ","type":"text"},{"type":"codeVoice","code":"UIApplication.shared.open"},{"text":" on UIKit and ","type":"text"},{"type":"codeVoice","code":"NSWorkspace.shared.open"},{"text":" on AppKit. Override it for testing or for non-standard environments.","type":"text"}]},{"type":"heading","text":"`PaywallState`","level":3,"anchor":"PaywallState"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sendable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" struct. The slice the plugin owns.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","    public var isObservingCustomerInfo: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false,","        isObservingCustomerInfo: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isGateSatisfied"},{"text":" is the single read your feature code should consult before running gated work. It is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" when the user holds an active pro subscription or a permanent license.","type":"text"}]},{"type":"heading","text":"`PaywallAction`","level":3,"anchor":"PaywallAction"},{"type":"codeListing","syntax":"swift","code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"]},{"type":"heading","text":"`EntitlementSnapshot`","level":3,"anchor":"EntitlementSnapshot"},{"type":"paragraph","inlineContent":[{"text":"Provider-agnostic value the service emits to describe the user’s current entitlement.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"]},{"type":"heading","text":"`PaywallService` (protocol)","level":3,"anchor":"PaywallService-protocol"},{"type":"codeListing","syntax":"swift","code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"type":"heading","text":"`MockPaywallService`","level":3,"anchor":"MockPaywallService"},{"type":"paragraph","inlineContent":[{"text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"type":"heading","text":"`SimulatedPaywallService`","level":3,"anchor":"SimulatedPaywallService"},{"type":"paragraph","inlineContent":[{"text":"Stateful ","type":"text"},{"type":"codeVoice","code":"actor"},{"text":" conformer for development and QA. Holds the current entitlement and multicasts changes through ","type":"text"},{"type":"codeVoice","code":"customerInfoStream()"},{"text":", so simulated grants survive a later ","type":"text"},{"type":"codeVoice","code":"refreshCustomerInfo"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"restorePurchases"},{"text":" exactly as a real service would.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public actor SimulatedPaywallService: PaywallService {","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        subsystem: String = \"Swidux\",","        category: String = \"Paywall\"","    )","","    \/\/ PaywallService: customerInfo \/ customerInfoStream \/ restorePurchases","","    \/\/ Simulation surface (not part of PaywallService — driven by the dev UI):","    public func grantPro()","    public func grantTrial()","    public func grantPermanentLicense()","    public func setFree()","    public func setRestoreShouldFail(_ shouldFail: Bool)","    public func setRefreshShouldFail(_ shouldFail: Bool)","    public func setArtificialDelay(_ delay: Duration)","}","","public enum SimulatedPaywallError: Error, Equatable {","    case restoreFailed","    case refreshFailed","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EntitlementSnapshot"},{"text":" only models ","type":"text"},{"type":"codeVoice","code":"isPro"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":", so ","type":"text"},{"type":"codeVoice","code":"grantTrial()"},{"text":" yields ","type":"text"},{"type":"codeVoice","code":"isPro == true"},{"text":" and is distinguished from ","type":"text"},{"type":"codeVoice","code":"grantPro()"},{"text":" only in the log line.","type":"text"}]},{"type":"heading","text":"`SwiduxDevPaywallUI`","level":3,"anchor":"SwiduxDevPaywallUI"},{"type":"paragraph","inlineContent":[{"text":"A separate, opt-in library product (","type":"text"},{"type":"codeVoice","code":"import SwiduxDevPaywallUI"},{"text":") providing a bare-bones debug paywall sheet. It mirrors the shape of the vendor paywall UI so the call site is unchanged when a real provider is adopted:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["someView.devPaywall(","    state: store.paywall,","    service: simulatedPaywallService,","    onAction: { store.send(.paywall($0)) }",")"]},{"type":"paragraph","inlineContent":[{"text":"The sheet shows the live ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":", grant buttons, real Restore\/Refresh flows, and QA failure\/latency toggles. On macOS the sheet uses a 400×600 minimum, matching the vendor paywall UI. Hold a ","type":"text"},{"inlineContent":[{"type":"text","text":"single"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SimulatedPaywallService"},{"text":" instance and pass it to both ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" (as the plugin’s ","type":"text"},{"type":"codeVoice","code":"service:"},{"text":") and ","type":"text"},{"type":"codeVoice","code":".devPaywall(...)"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@State private var paywallService = SimulatedPaywallService()","@State private var store: AppStore","","init() {","    let service = SimulatedPaywallService()","    _paywallService = State(initialValue: service)","    _store = State(initialValue: .configured(paywallService: service))","}"]},{"inlineContent":[{"type":"text","text":"This is the one place a dev\/QA service is intentionally constructed outside "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":", because the debug UI must drive the same instance the plugin observes. Swapping to a real provider removes the shared-instance wiring and the "},{"type":"codeVoice","code":"SwiduxDevPaywallUI"},{"type":"text","text":" import along with the two-line "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" change."}],"type":"paragraph"},{"anchor":"Action-semantics","type":"heading","text":"Action semantics","level":2},{"inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}],"type":"paragraph"},{"anchor":"requestreason-String","type":"heading","text":"`request(reason: String)`","level":3},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPresented = true"},{"type":"text","text":" and stores "},{"type":"codeVoice","code":"requestedReason"},{"type":"text","text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase."}],"type":"paragraph"},{"anchor":"dismiss","type":"heading","text":"`dismiss`","level":3},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPresented = false"},{"type":"text","text":" and clears "},{"type":"codeVoice","code":"requestedReason"},{"type":"text","text":". Returns an effect that dispatches "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up)."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"observeCustomerInfo","text":"`observeCustomerInfo`"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns a long-lived effect that consumes "},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"type":"text","text":" and dispatches "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" for every snapshot. Dispatch once on app launch (typically from a "},{"type":"codeVoice","code":".task"},{"type":"text","text":" on the root view). The effect lives for the duration of the stream. Idempotent: "},{"type":"codeVoice","code":"isObservingCustomerInfo"},{"text":" guards against double-subscription, so a re-dispatched ","type":"text"},{"type":"codeVoice","code":".task"},{"text":" (view identity change, scene reconnect) won’t start a duplicate stream.","type":"text"}]},{"level":3,"type":"heading","text":"`refreshCustomerInfo`","anchor":"refreshCustomerInfo"},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isLoading = true"},{"type":"text","text":". Returns a one-shot effect that calls "},{"type":"codeVoice","code":"PaywallService.customerInfo()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"code":".refreshFailed","type":"codeVoice"},{"type":"text","text":" on error."}],"type":"paragraph"},{"anchor":"customerInfoUpdatedEntitlementSnapshot","type":"heading","text":"`customerInfoUpdated(EntitlementSnapshot)`","level":3},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" from the snapshot, clears "},{"type":"codeVoice","code":"isLoading"},{"type":"text","text":", and clears "},{"type":"codeVoice","code":"error"},{"type":"text","text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly. Note that the plugin emits this on "},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"type":"text","text":" snapshot (each "},{"type":"codeVoice","code":"customerInfoStream()"},{"type":"text","text":" value, every "},{"type":"codeVoice","code":"refreshCustomerInfo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"restorePurchases"},{"type":"text","text":"), not only on entitlement changes — observe "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":" (or a value derived from it) for transitions rather than mapping this action directly. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"level":3,"type":"heading","text":"`refreshFailed(String)`","anchor":"refreshFailedString"},{"inlineContent":[{"type":"text","text":"Sets "},{"code":"error","type":"codeVoice"},{"type":"text","text":" to the given message and clears "},{"code":"isLoading","type":"codeVoice"},{"type":"text","text":". Returns no effect."}],"type":"paragraph"},{"text":"`restorePurchases`","anchor":"restorePurchases","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isLoading = true"},{"type":"text","text":". Returns a one-shot effect that calls "},{"type":"codeVoice","code":"PaywallService.restorePurchases()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"type":"codeVoice","code":".refreshFailed"},{"text":" on error.","type":"text"}],"type":"paragraph"},{"anchor":"presentCustomerCenter--dismissCustomerCenter","type":"heading","text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","level":3},{"inlineContent":[{"type":"text","text":"Toggle "},{"type":"codeVoice","code":"isCustomerCenterPresented"},{"type":"text","text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does)."}],"type":"paragraph"},{"type":"heading","text":"`openManageSubscriptions`","level":3,"anchor":"openManageSubscriptions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns an effect that opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"text":" via the configured ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS.","type":"text"}]},{"type":"heading","text":"Implementing a `PaywallService`","level":2,"anchor":"Implementing-a-PaywallService"},{"inlineContent":[{"type":"text","text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The protocol has three methods:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"customerInfo() async throws -> EntitlementSnapshot","type":"codeVoice"}]},{"type":"text","text":" — One-shot fetch of the current entitlement. The plugin calls this from "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>","type":"codeVoice"}]},{"type":"text","text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"restorePurchases() async throws -> EntitlementSnapshot","type":"codeVoice"}]},{"type":"text","text":" — Performs a restore against the user’s account and returns the resulting entitlement."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Note what the protocol does "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" values. A vanilla StoreKit conformer iterates "},{"type":"codeVoice","code":"Transaction.currentEntitlements"},{"type":"text","text":" and listens to "},{"type":"codeVoice","code":"Transaction.updates"},{"type":"text","text":". Either way, the plugin stays the same."}],"type":"paragraph"}]}],"references":{"doc://Swidux/documentation/Swidux":{"title":"Swidux","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"role":"collection","url":"\/documentation\/swidux","kind":"symbol"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"role":"article","type":"topic","title":"SwiduxFeatureFlags Reference","kind":"article","url":"\/documentation\/swidux\/pluginfeatureflagsreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic","title":"Add a Paywall","role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"url":"\/documentation\/swidux\/undoplugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","title":"UndoPlugin"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"title":"Plugin Architecture","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","url":"\/documentation\/swidux\/pluginarchitecture"},"doc://Swidux/documentation/Swidux/UndoRedo":{"role":"article","url":"\/documentation\/swidux\/undoredo","title":"Undo \/ Redo","kind":"article","abstract":[{"type":"text","text":"Add stack-based 