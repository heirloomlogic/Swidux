{"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"sections":[],"kind":"article","metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Swidux"}],"title":"SwiduxPaywall Reference"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"inlineContent":[{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"reference"},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Library-target","type":"heading","text":"Library target","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Product: ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxPaywall","type":"codeVoice"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Provided-implementations","type":"heading","text":"Provided implementations","level":2},{"inlineContent":[{"type":"text","text":"The plugin ships with "},{"type":"codeVoice","code":"MockPaywallService"},{"type":"text","text":" for previews and tests. For production RevenueCat integrations, the "},{"isActive":true,"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","type":"reference"},{"type":"text","text":" companion package provides:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":" — a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" conformer that bridges RevenueCat’s ","type":"text"},{"code":"CustomerInfo","type":"codeVoice"},{"text":" stream and ","type":"text"},{"code":"restorePurchases()","type":"codeVoice"},{"text":" API.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":" — a RevenueCat-flavored mock for previews.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"For other backends (StoreKit, custom server), implement "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" directly — see "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"reference"},{"type":"text","text":" Step 3, Path B."}],"type":"paragraph"},{"anchor":"Types","type":"heading","text":"Types","level":2},{"anchor":"PaywallPlugin%3CRootState-RootAction%3E","type":"heading","text":"`PaywallPlugin<RootState, RootAction>`","level":3},{"inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":" and an action enum typed as "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"],"syntax":"swift"},{"inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler calls "},{"type":"codeVoice","code":"UIApplication.shared.open"},{"type":"text","text":" on UIKit and "},{"type":"codeVoice","code":"NSWorkspace.shared.open"},{"type":"text","text":" on AppKit. Override it for testing or for non-standard environments."}],"type":"paragraph"},{"anchor":"PaywallState","type":"heading","text":"`PaywallState`","level":3},{"inlineContent":[{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" struct. The slice the plugin owns."}],"type":"paragraph"},{"type":"codeListing","code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"isGateSatisfied"},{"type":"text","text":" is the single read your feature code should consult before running gated work. It is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when the user holds an active pro subscription or a permanent license."}],"type":"paragraph"},{"anchor":"PaywallAction","type":"heading","text":"`PaywallAction`","level":3},{"type":"codeListing","code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"],"syntax":"swift"},{"anchor":"EntitlementSnapshot","type":"heading","text":"`EntitlementSnapshot`","level":3},{"inlineContent":[{"type":"text","text":"Provider-agnostic value the service emits to describe the user’s current entitlement."}],"type":"paragraph"},{"type":"codeListing","code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"],"syntax":"swift"},{"anchor":"PaywallService-protocol","type":"heading","text":"`PaywallService` (protocol)","level":3},{"type":"codeListing","code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"],"syntax":"swift"},{"anchor":"MockPaywallService","type":"heading","text":"`MockPaywallService`","level":3},{"inlineContent":[{"type":"text","text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately."}],"type":"paragraph"},{"type":"codeListing","code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"],"syntax":"swift"},{"anchor":"Action-semantics","type":"heading","text":"Action semantics","level":2},{"inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}],"type":"paragraph"},{"anchor":"requestreason-String","type":"heading","text":"`request(reason: String)`","level":3},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPresented = true"},{"type":"text","text":" and stores "},{"type":"codeVoice","code":"requestedReason"},{"type":"text","text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase."}],"type":"paragraph"},{"anchor":"dismiss","type":"heading","text":"`dismiss`","level":3},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPresented = false"},{"type":"text","text":" and clears "},{"type":"codeVoice","code":"requestedReason"},{"type":"text","text":". Returns an effect that dispatches "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up)."}],"type":"paragraph"},{"anchor":"observeCustomerInfo","type":"heading","text":"`observeCustomerInfo`","level":3},{"inlineContent":[{"type":"text","text":"Returns a long-lived effect that consumes "},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" for every snapshot. Dispatch once on app launch (typically from a "},{"type":"codeVoice","code":".task"},{"type":"text","text":" on the root view). The effect lives for the duration of the stream."}],"type":"paragraph"},{"anchor":"refreshCustomerInfo","type":"heading","text":"`refreshCustomerInfo`","level":3},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isLoading = true"},{"type":"text","text":". Returns a one-shot effect that calls "},{"type":"codeVoice","code":"PaywallService.customerInfo()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" on error."}],"type":"paragraph"},{"anchor":"customerInfoUpdatedEntitlementSnapshot","type":"heading","text":"`customerInfoUpdated(EntitlementSnapshot)`","level":3},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" and "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" from the snapshot, clears "},{"type":"codeVoice","code":"isLoading"},{"type":"text","text":", and clears "},{"type":"codeVoice","code":"error"},{"type":"text","text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly."}],"type":"paragraph"},{"anchor":"refreshFailedString","type":"heading","text":"`refreshFailed(String)`","level":3},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"error"},{"type":"text","text":" to the given message and clears "},{"type":"codeVoice","code":"isLoading"},{"type":"text","text":". Returns no effect."}],"type":"paragraph"},{"anchor":"restorePurchases","type":"heading","text":"`restorePurchases`","level":3},{"inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isLoading = true"},{"type":"text","text":". Returns a one-shot effect that calls "},{"type":"codeVoice","code":"PaywallService.restorePurchases()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" on success or "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" on error."}],"type":"paragraph"},{"anchor":"presentCustomerCenter--dismissCustomerCenter","type":"heading","text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","level":3},{"inlineContent":[{"type":"text","text":"Toggle "},{"type":"codeVoice","code":"isCustomerCenterPresented"},{"type":"text","text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does)."}],"type":"paragraph"},{"anchor":"openManageSubscriptions","type":"heading","text":"`openManageSubscriptions`","level":3},{"inlineContent":[{"type":"text","text":"Returns an effect that opens "},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"type":"text","text":" via the configured "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS."}],"type":"paragraph"},{"anchor":"Implementing-a-PaywallService","type":"heading","text":"Implementing a `PaywallService`","level":2},{"inlineContent":[{"type":"text","text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an "},{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The protocol has three methods:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":"customerInfo() async throws -> EntitlementSnapshot","type":"codeVoice"}],"type":"strong"},{"text":" — One-shot fetch of the current entitlement. The plugin calls this from ","type":"text"},{"code":".refreshCustomerInfo","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>"}]},{"text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from ","type":"text"},{"type":"codeVoice","code":".observeCustomerInfo"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":"restorePurchases() async throws -> EntitlementSnapshot","type":"codeVoice"}],"type":"strong"},{"text":" — Performs a restore against the user’s account and returns the resulting entitlement.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Note what the protocol does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into "},{"code":"EntitlementSnapshot","type":"codeVoice"},{"text":" values. A vanilla StoreKit conformer iterates ","type":"text"},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"text":" and listens to ","type":"text"},{"type":"codeVoice","code":"Transaction.updates"},{"type":"text","text":". Either way, the plugin stays the same."}]}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginpaywallreference"]}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"title":"Reference","generated":true}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"title":"EntityStore","url":"\/documentation\/swidux\/entitystoreguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/MacrosReference":{"abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" — the two macros that generate the observation bridge between value-type state and SwiftUI."}],"title":"Macros","url":"\/documentation\/swidux\/macrosreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","url":"\/documentation\/swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","type":"topic","kind":"symbol","role":"collection"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"title":"Add a Paywall","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"title":"UndoPlugin","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"url":"\/documentation\/swidux\/undoplugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"topic","kind":"symbol","role":"symbol"},"https://github.com/heirloomlogic/SwiduxRevenueCatPaywall":{"identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","title":"SwiduxRevenueCatPaywall","url":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","titleInlineContent":[{"code":"SwiduxRevenueCatPaywall","type":"codeVoice"}],"type":"link"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover."}],"title":"SwiduxAnalytics Reference","url":"\/documentation\/swidux\/pluginanalyticsreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"title":"SwiduxParentalGate Reference","url":"\/documentation\/swidux\/pluginparentalgatereference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"title":"Plugin Architecture","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"abstract":[{"type":"text","text":"Public API surface for the "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"title":"SwiduxKillswitch Reference","url":"\/documentation\/swidux\/pluginkillswitchreference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","url":"\/documentation\/swidux\/persistencemiddlewareguide","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"title":"Persistence Middleware","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/UndoRedo":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","url":"\/documentation\/swidux\/undoredo","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"type":"text","text":"."}],"title":"Undo \/ Redo","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","url":"\/documentation\/swidux\/keyvaluestoreguide","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"title":"KeyValueStore","type":"topic","kind":"article","role":"collectionGroup"}}}