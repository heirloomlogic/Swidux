{"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPaywall"},{"text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions."}]},{"type":"paragraph","inlineContent":[{"text":"For end-to-end wiring, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"reference","isActive":true},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Library target","anchor":"Library-target"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product: "},{"type":"codeVoice","code":"SwiduxPaywall"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Import: ","type":"text"},{"code":"import SwiduxPaywall","type":"codeVoice"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Add the product to your target dependencies in ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" alongside ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":".","type":"text"}]},{"anchor":"Provided-implementations","text":"Provided implementations","level":2,"type":"heading"},{"inlineContent":[{"text":"The plugin ships with ","type":"text"},{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" for previews and tests. For production RevenueCat integrations, the "},{"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","isActive":true},{"type":"text","text":" companion package provides:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RevenueCatPaywallService"},{"text":" — a ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that bridges RevenueCat’s "},{"type":"codeVoice","code":"CustomerInfo"},{"type":"text","text":" stream and "},{"type":"codeVoice","code":"restorePurchases()"},{"type":"text","text":" API."}]}]},{"content":[{"inlineContent":[{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" — a RevenueCat-flavored mock for previews."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"For other backends (StoreKit, custom server), implement ","type":"text"},{"code":"PaywallService","type":"codeVoice"},{"text":" directly — see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"reference","isActive":true},{"type":"text","text":" Step 3, Path B."}]},{"anchor":"Types","text":"Types","level":2,"type":"heading"},{"anchor":"PaywallPlugin%3CRootState-RootAction%3E","text":"`PaywallPlugin<RootState, RootAction>`","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"code":"@MainActor","type":"codeVoice"},{"text":" ","type":"text"},{"code":"SwiduxPlugin","type":"codeVoice"},{"text":" conformer. Owns a slice of root state typed as ","type":"text"},{"type":"codeVoice","code":"PaywallState"},{"text":" and an action enum typed as ","type":"text"},{"type":"codeVoice","code":"PaywallAction"},{"text":".","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler calls "},{"type":"codeVoice","code":"UIApplication.shared.open"},{"type":"text","text":" on UIKit and "},{"type":"codeVoice","code":"NSWorkspace.shared.open"},{"type":"text","text":" on AppKit. Override it for testing or for non-standard environments."}]},{"text":"`PaywallState`","type":"heading","anchor":"PaywallState","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" struct. The slice the plugin owns."}]},{"syntax":"swift","type":"codeListing","code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isGateSatisfied"},{"type":"text","text":" is the single read your feature code should consult before running gated work. It is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when the user holds an active pro subscription or a permanent license."}]},{"text":"`PaywallAction`","type":"heading","anchor":"PaywallAction","level":3},{"code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"`EntitlementSnapshot`","anchor":"EntitlementSnapshot"},{"type":"paragraph","inlineContent":[{"text":"Provider-agnostic value the service emits to describe the user’s current entitlement.","type":"text"}]},{"code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"`PaywallService` (protocol)","anchor":"PaywallService-protocol"},{"code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"],"type":"codeListing","syntax":"swift"},{"level":3,"type":"heading","text":"`MockPaywallService`","anchor":"MockPaywallService"},{"type":"paragraph","inlineContent":[{"text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately.","type":"text"}]},{"code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Action semantics","anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns.","type":"text"}]},{"level":3,"type":"heading","text":"`request(reason: String)`","anchor":"requestreason-String"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isPresented = true"},{"text":" and stores ","type":"text"},{"type":"codeVoice","code":"requestedReason"},{"text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase.","type":"text"}]},{"level":3,"type":"heading","text":"`dismiss`","anchor":"dismiss"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isPresented = false"},{"text":" and clears ","type":"text"},{"type":"codeVoice","code":"requestedReason"},{"text":". Returns an effect that dispatches ","type":"text"},{"type":"codeVoice","code":".refreshCustomerInfo"},{"text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up).","type":"text"}]},{"level":3,"type":"heading","text":"`observeCustomerInfo`","anchor":"observeCustomerInfo"},{"type":"paragraph","inlineContent":[{"text":"Returns a long-lived effect that consumes ","type":"text"},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"text":" and dispatches ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" for every snapshot. Dispatch once on app launch (typically from a ","type":"text"},{"type":"codeVoice","code":".task"},{"text":" on the root view). The effect lives for the duration of the stream.","type":"text"}]},{"level":3,"type":"heading","text":"`refreshCustomerInfo`","anchor":"refreshCustomerInfo"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isLoading = true"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"type":"codeVoice","code":"PaywallService.customerInfo()"},{"text":" and dispatches ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" on success or ","type":"text"},{"type":"codeVoice","code":".refreshFailed"},{"text":" on error.","type":"text"}]},{"level":3,"type":"heading","text":"`customerInfoUpdated(EntitlementSnapshot)`","anchor":"customerInfoUpdatedEntitlementSnapshot"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isPro"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":" from the snapshot, clears ","type":"text"},{"type":"codeVoice","code":"isLoading"},{"text":", and clears ","type":"text"},{"type":"codeVoice","code":"error"},{"text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly.","type":"text"}]},{"level":3,"type":"heading","text":"`refreshFailed(String)`","anchor":"refreshFailedString"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"error"},{"text":" to the given message and clears ","type":"text"},{"type":"codeVoice","code":"isLoading"},{"text":". Returns no effect.","type":"text"}]},{"level":3,"type":"heading","text":"`restorePurchases`","anchor":"restorePurchases"},{"type":"paragraph","inlineContent":[{"text":"Sets ","type":"text"},{"type":"codeVoice","code":"isLoading = true"},{"text":". Returns a one-shot effect that calls ","type":"text"},{"type":"codeVoice","code":"PaywallService.restorePurchases()"},{"text":" and dispatches ","type":"text"},{"type":"codeVoice","code":".customerInfoUpdated"},{"text":" on success or ","type":"text"},{"type":"codeVoice","code":".refreshFailed"},{"text":" on error.","type":"text"}]},{"level":3,"type":"heading","text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","anchor":"presentCustomerCenter--dismissCustomerCenter"},{"type":"paragraph","inlineContent":[{"text":"Toggle ","type":"text"},{"type":"codeVoice","code":"isCustomerCenterPresented"},{"text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does).","type":"text"}]},{"level":3,"type":"heading","text":"`openManageSubscriptions`","anchor":"openManageSubscriptions"},{"type":"paragraph","inlineContent":[{"text":"Returns an effect that opens ","type":"text"},{"type":"codeVoice","code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions"},{"text":" via the configured ","type":"text"},{"type":"codeVoice","code":"openURL"},{"text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS.","type":"text"}]},{"level":2,"type":"heading","text":"Implementing a `PaywallService`","anchor":"Implementing-a-PaywallService"},{"type":"paragraph","inlineContent":[{"text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The protocol has three methods:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"customerInfo() async throws -> EntitlementSnapshot","type":"codeVoice"}]},{"type":"text","text":" — One-shot fetch of the current entitlement. The plugin calls this from "},{"code":".refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>","type":"codeVoice"}]},{"type":"text","text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from "},{"code":".observeCustomerInfo","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"restorePurchases() async throws -> EntitlementSnapshot","type":"codeVoice"}]},{"type":"text","text":" — Performs a restore against the user’s account and returns the resulting entitlement."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Note what the protocol does ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into ","type":"text"},{"type":"codeVoice","code":"EntitlementSnapshot"},{"text":" values. A vanilla StoreKit conformer iterates ","type":"text"},{"type":"codeVoice","code":"Transaction.currentEntitlements"},{"text":" and listens to ","type":"text"},{"type":"codeVoice","code":"Transaction.updates"},{"text":". Either way, the plugin stays the same.","type":"text"}]}]}],"metadata":{"modules":[{"name":"Swidux"}],"title":"SwiduxPaywall Reference","role":"article","roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginpaywallreference"]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"type":"text","t