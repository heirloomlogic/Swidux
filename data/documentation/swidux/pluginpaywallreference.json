{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginpaywallreference"]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"metadata":{"title":"SwiduxPaywall Reference","modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article"},"kind":"article","seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"generated":true,"anchor":"Reference"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" is a domain plugin that owns the paywall slice of your app’s state and routes paywall actions through the Swidux dispatch cycle. It is provider-agnostic: the plugin knows nothing about RevenueCat, StoreKit, products, prices, or purchase results. You supply a "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" conformer that talks to whichever purchase backend you use, and the plugin manages presentation state, async progress, and entitlement transitions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For end-to-end wiring, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","isActive":true},{"type":"text","text":". For where this plugin sits in the lifecycle, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"Library target","anchor":"Library-target"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product: "},{"code":"SwiduxPaywall","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import: "},{"code":"import SwiduxPaywall","type":"codeVoice"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the product to your target dependencies in "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"Provided implementations","anchor":"Provided-implementations"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin ships with two in-repo conformers, both provider-agnostic and SDK-free:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"MockPaywallService","type":"codeVoice"},{"type":"text","text":" — fixed snapshot, stream finishes immediately; for previews and tests."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"SimulatedPaywallService","type":"codeVoice"},{"type":"text","text":" — a stateful, fully driveable service. Paired with the "},{"code":"SwiduxDevPaywallUI","type":"codeVoice"},{"type":"text","text":" debug sheet, it lets a developer or QA tester grant Pro\/Trial\/Permanent, restore, and simulate failure\/latency — all flowing through the real plugin pipeline, with no SDK and no vendor commitment. Use it as the "},{"code":"service:","type":"codeVoice"},{"type":"text","text":" while the paywall vendor decision is still open."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For production RevenueCat integrations, the "},{"type":"reference","identifier":"https:\/\/github.com\/heirloomlogic\/SwiduxRevenueCatPaywall","isActive":true},{"type":"text","text":" companion package provides:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" — a "},{"code":"PaywallService","type":"codeVoice"},{"type":"text","text":" conformer that bridges RevenueCat’s "},{"code":"CustomerInfo","type":"codeVoice"},{"type":"text","text":" stream and "},{"code":"restorePurchases()","type":"codeVoice"},{"type":"text","text":" API."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":" — a RevenueCat-flavored mock for previews."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" — a SwiftUI sheet built on RevenueCatUI that hands purchase results back through the plugin."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Full API documentation lives in the package’s own "},{"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For other backends (StoreKit, custom server), implement "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" directly — see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","isActive":true},{"type":"text","text":" Step 3, Path B."}]},{"level":3,"type":"heading","text":"Resilient last-known-good decorator","anchor":"Resilient-last-known-good-decorator"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ResilientPaywallService"},{"type":"text","text":" wraps any "},{"type":"codeVoice","code":"PaywallService"},{"type":"text","text":" so a transient failure to read entitlements at cold launch never presents a previously-seen paid user as free. It retries with backoff, then falls back to a last-known-good snapshot persisted through an injected "},{"type":"codeVoice","code":"KeyValueStore"},{"type":"text","text":". Because that cache vouches for a paid entitlement while offline, back it with "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" — not "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":", whose plist a user can edit or restore from a doctored backup:"}]},{"syntax":"swift","type":"codeListing","code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feed the wrapped instance to both "},{"type":"codeVoice","code":"PaywallPlugin(..., service:)"},{"type":"text","text":" and any app-side entitlement reader. The live provider stays authoritative: any successful snapshot overwrites the cache. See the type’s own documentation for the staleness policy and threat model."}]},{"level":2,"type":"heading","text":"Types","anchor":"Types"},{"level":3,"type":"heading","text":"`PaywallPlugin<RootState, RootAction>`","anchor":"PaywallPlugin%3CRootState-RootAction%3E"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"codeVoice","code":"SwiduxPlugin"},{"type":"text","text":" conformer. Owns a slice of root state typed as "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":" and an action enum typed as "},{"type":"codeVoice","code":"PaywallAction"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["public init(","    state: WritableKeyPath<RootState, PaywallState>,","    action toRootAction: @escaping @Sendable (PaywallAction) -> RootAction,","    extractAction: @escaping @Sendable (RootAction) -> PaywallAction?,","    service: any PaywallService,","    openURL: @escaping @Sendable (URL) async -> Void = { \/* default *\/ }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"openURL"},{"type":"text","text":" handler calls "},{"type":"codeVoice","code":"UIApplication.shared.open"},{"type":"text","text":" on UIKit and "},{"type":"codeVoice","code":"NSWorkspace.shared.open"},{"type":"text","text":" on AppKit. Override it for testing or for non-standard environments."}]},{"level":3,"type":"heading","text":"`PaywallState`","anchor":"PaywallState"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Sendable"},{"type":"text","text":", "},{"type":"codeVoice","code":"Equatable"},{"type":"text","text":" struct. The slice the plugin owns."}]},{"syntax":"swift","type":"codeListing","code":["public struct PaywallState: Sendable, Equatable {","    public var isPro: Bool","    public var hasPermanentLicense: Bool","    public var isPresented: Bool","    public var requestedReason: String?","    public var isLoading: Bool","    public var error: String?","    public var isCustomerCenterPresented: Bool","    public var isObservingCustomerInfo: Bool","","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        isPresented: Bool = false,","        requestedReason: String? = nil,","        isLoading: Bool = false,","        error: String? = nil,","        isCustomerCenterPresented: Bool = false,","        isObservingCustomerInfo: Bool = false","    )","","    public var isGateSatisfied: Bool { isPro || hasPermanentLicense }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"isGateSatisfied"},{"type":"text","text":" is the single read your feature code should consult before running gated work. It is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" when the user holds an active pro subscription or a permanent license."}]},{"level":3,"type":"heading","text":"`PaywallAction`","anchor":"PaywallAction"},{"syntax":"swift","type":"codeListing","code":["public enum PaywallAction: Sendable {","    case request(reason: String)","    case dismiss","    case observeCustomerInfo","    case refreshCustomerInfo","    case customerInfoUpdated(EntitlementSnapshot)","    case refreshFailed(String)","    case restorePurchases","    case presentCustomerCenter","    case dismissCustomerCenter","    case openManageSubscriptions","}"]},{"level":3,"type":"heading","text":"`EntitlementSnapshot`","anchor":"EntitlementSnapshot"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provider-agnostic value the service emits to describe the user’s current entitlement."}]},{"syntax":"swift","type":"codeListing","code":["public struct EntitlementSnapshot: Sendable, Equatable {","    public let isPro: Bool","    public let hasPermanentLicense: Bool","","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","}"]},{"level":3,"type":"heading","text":"`PaywallService` (protocol)","anchor":"PaywallService-protocol"},{"syntax":"swift","type":"codeListing","code":["public protocol PaywallService: Sendable {","    func customerInfo() async throws -> EntitlementSnapshot","    func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"level":3,"type":"heading","text":"`MockPaywallService`","anchor":"MockPaywallService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Test\/preview conformer that returns a fixed snapshot. Its stream finishes immediately."}]},{"syntax":"swift","type":"codeListing","code":["public struct MockPaywallService: PaywallService {","    public init(isPro: Bool = false, hasPermanentLicense: Bool = false)","    public func customerInfo() async throws -> EntitlementSnapshot","    public func customerInfoStream() -> AsyncStream<EntitlementSnapshot>","    public func restorePurchases() async throws -> EntitlementSnapshot","}"]},{"level":3,"type":"heading","text":"`SimulatedPaywallService`","anchor":"SimulatedPaywallService"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Stateful "},{"type":"codeVoice","code":"actor"},{"type":"text","text":" conformer for development and QA. Holds the current entitlement and multicasts changes through "},{"type":"codeVoice","code":"customerInfoStream()"},{"type":"text","text":", so simulated grants survive a later "},{"type":"codeVoice","code":"refreshCustomerInfo"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"restorePurchases"},{"type":"text","text":" exactly as a real service would."}]},{"syntax":"swift","type":"codeListing","code":["public actor SimulatedPaywallService: PaywallService {","    public init(","        isPro: Bool = false,","        hasPermanentLicense: Bool = false,","        subsystem: String = \"Swidux\",","        category: String = \"Paywall\"","    )","","    \/\/ PaywallService: customerInfo \/ customerInfoStream \/ restorePurchases","","    \/\/ Simulation surface (not part of PaywallService — driven by the dev UI):","    public func grantPro()","    public func grantTrial()","    public func grantPermanentLicense()","    public func setFree()","    public func setRestoreShouldFail(_ shouldFail: Bool)","    public func setRefreshShouldFail(_ shouldFail: Bool)","    public func setArtificialDelay(_ delay: Duration)","}","","public enum SimulatedPaywallError: Error, Equatable {","    case restoreFailed","    case refreshFailed","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" only models "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":", so "},{"type":"codeVoice","code":"grantTrial()"},{"type":"text","text":" yields "},{"type":"codeVoice","code":"isPro == true"},{"type":"text","text":" and is distinguished from "},{"type":"codeVoice","code":"grantPro()"},{"type":"text","text":" only in the log line."}]},{"level":3,"type":"heading","text":"`SwiduxDevPaywallUI`","anchor":"SwiduxDevPaywallUI"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A separate, opt-in library product ("},{"type":"codeVoice","code":"import SwiduxDevPaywallUI"},{"type":"text","text":") providing a bare-bones debug paywall sheet. It mirrors the shape of the vendor paywall UI so the call site is unchanged when a real provider is adopted:"}]},{"syntax":"swift","type":"codeListing","code":["someView.devPaywall(","    state: store.paywall,","    service: simulatedPaywallService,","    onAction: { store.send(.paywall($0)) }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The sheet shows the live "},{"type":"codeVoice","code":"PaywallState"},{"type":"text","text":", grant buttons, real Restore\/Refresh flows, and QA failure\/latency toggles. On macOS the sheet uses a 400×600 minimum, matching the vendor paywall UI. Hold a "},{"type":"strong","inlineContent":[{"type":"text","text":"single"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"SimulatedPaywallService"},{"type":"text","text":" instance and pass it to both "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" (as the plugin’s "},{"type":"codeVoice","code":"service:"},{"type":"text","text":") and "},{"type":"codeVoice","code":".devPaywall(...)"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["@State private var paywallService = SimulatedPaywallService()","@State private var store: AppStore","","init() {","    let service = SimulatedPaywallService()","    _paywallService = State(initialValue: service)","    _store = State(initialValue: .configured(paywallService: service))","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is the one place a dev\/QA service is intentionally constructed outside "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":", because the debug UI must drive the same instance the plugin observes. Swapping to a real provider removes the shared-instance wiring and the "},{"type":"codeVoice","code":"SwiduxDevPaywallUI"},{"type":"text","text":" import along with the two-line "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" change."}]},{"level":2,"type":"heading","text":"Action semantics","anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case below describes the state mutation the plugin performs and the effect (if any) it returns."}]},{"level":3,"type":"heading","text":"`request(reason: String)`","anchor":"requestreason-String"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"isPresented = true","type":"codeVoice"},{"type":"text","text":" and stores "},{"code":"requestedReason","type":"codeVoice"},{"type":"text","text":". Returns no effect. Dispatch this when a feature needs to gate behind a purchase."}]},{"level":3,"type":"heading","text":"`dismiss`","anchor":"dismiss"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"type":"codeVoice","code":"isPresented = false"},{"type":"text","text":" and clears "},{"type":"codeVoice","code":"requestedReason"},{"type":"text","text":". Returns an effect that dispatches "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":" so the entitlement is reconciled after the sheet closes (the user may have purchased while the sheet was up)."}]},{"type":"heading","text":"`observeCustomerInfo`","anchor":"observeCustomerInfo","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns a long-lived effect that consumes "},{"type":"codeVoice","code":"PaywallService.customerInfoStream()"},{"type":"text","text":" and dispatches "},{"type":"codeVoice","code":".customerInfoUpdated"},{"type":"text","text":" for every snapshot. Dispatch once on app launch (typically from a "},{"code":".task","type":"codeVoice"},{"type":"text","text":" on the root view). The effect lives for the duration of the stream. Idempotent: "},{"code":"isObservingCustomerInfo","type":"codeVoice"},{"type":"text","text":" guards against double-subscription, so a re-dispatched "},{"code":".task","type":"codeVoice"},{"type":"text","text":" (view identity change, scene reconnect) won’t start a duplicate stream."}]},{"type":"heading","text":"`refreshCustomerInfo`","anchor":"refreshCustomerInfo","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"isLoading = true","type":"codeVoice"},{"type":"text","text":". Returns a one-shot effect that calls "},{"code":"PaywallService.customerInfo()","type":"codeVoice"},{"type":"text","text":" and dispatches "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" on success or "},{"code":".refreshFailed","type":"codeVoice"},{"type":"text","text":" on error."}]},{"type":"heading","text":"`customerInfoUpdated(EntitlementSnapshot)`","anchor":"customerInfoUpdatedEntitlementSnapshot","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"isPro","type":"codeVoice"},{"type":"text","text":" and "},{"code":"hasPermanentLicense","type":"codeVoice"},{"type":"text","text":" from the snapshot, clears "},{"code":"isLoading","type":"codeVoice"},{"type":"text","text":", and clears "},{"code":"error","type":"codeVoice"},{"type":"text","text":". Returns no effect. The plugin emits this internally; your code rarely dispatches it directly. Note that the plugin emits this on "},{"inlineContent":[{"type":"text","text":"every"}],"type":"strong"},{"type":"text","text":" snapshot (each "},{"code":"customerInfoStream()","type":"codeVoice"},{"type":"text","text":" value, every "},{"code":"refreshCustomerInfo","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"restorePurchases","type":"codeVoice"},{"type":"text","text":"), not only on entitlement changes — observe "},{"code":"PaywallState","type":"codeVoice"},{"type":"text","text":" (or a value derived from it) for transitions rather than mapping this action directly. See "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"heading","text":"`refreshFailed(String)`","anchor":"refreshFailedString","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"error","type":"codeVoice"},{"type":"text","text":" to the given message and clears "},{"code":"isLoading","type":"codeVoice"},{"type":"text","text":". Returns no effect."}]},{"type":"heading","text":"`restorePurchases`","anchor":"restorePurchases","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sets "},{"code":"isLoading = true","type":"codeVoice"},{"type":"text","text":". Returns a one-shot effect that calls "},{"code":"PaywallService.restorePurchases()","type":"codeVoice"},{"type":"text","text":" and dispatches "},{"code":".customerInfoUpdated","type":"codeVoice"},{"type":"text","text":" on success or "},{"code":".refreshFailed","type":"codeVoice"},{"type":"text","text":" on error."}]},{"type":"heading","text":"`presentCustomerCenter` \/ `dismissCustomerCenter`","anchor":"presentCustomerCenter--dismissCustomerCenter","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Toggle "},{"code":"isCustomerCenterPresented","type":"codeVoice"},{"type":"text","text":". No effects. Bind these to a separate sheet if your purchase backend exposes a customer-center UI (RevenueCat does)."}]},{"type":"heading","text":"`openManageSubscriptions`","anchor":"openManageSubscriptions","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Returns an effect that opens "},{"code":"itms-apps:\/\/apps.apple.com\/account\/subscriptions","type":"codeVoice"},{"type":"text","text":" via the configured "},{"code":"openURL","type":"codeVoice"},{"type":"text","text":" handler. This deep-links into the Settings → Subscriptions page on iOS and the equivalent on macOS."}]},{"type":"heading","text":"Implementing a `PaywallService`","anchor":"Implementing-a-PaywallService","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin is purchase-agnostic. It does not know about products, prices, transactions, or vendor SDKs. Your conformer is responsible for translating whatever a backend reports into an "},{"code":"EntitlementSnapshot","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The protocol has three methods:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfo() async throws -> EntitlementSnapshot"}]},{"type":"text","text":" — One-shot fetch of the current entitlement. The plugin calls this from "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"customerInfoStream() -> AsyncStream<EntitlementSnapshot>"}]},{"type":"text","text":" — Long-lived stream that yields every time the entitlement changes (purchase completes, subscription expires, family sharing update, etc.). The plugin consumes it from "},{"type":"codeVoice","code":".observeCustomerInfo"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"restorePurchases() async throws -> EntitlementSnapshot"}]},{"type":"text","text":" — Performs a restore against the user’s account and returns the resulting entitlement."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Note what the protocol does "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" require: no product list, no purchase method, no receipt validation. Purchases happen inside whichever paywall UI you present (a RevenueCat paywall view, your own StoreKit-backed sheet, etc.). The plugin only cares about the entitlement that results."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical RevenueCat conformer holds a reference to the SDK and bridges its delegate or async APIs into "},{"code":"EntitlementSnapshot","type":"codeVoice"},{"type":"text","text":" values. A vanilla StoreKit conformer iterates "},{"code":"Transaction.currentEntitlements","type":"codeVoice"},{"type":"text","text":" and listens to "},{"code":"Transaction.updates","type":"codeVoice"},{"type":"text","text":". Either way, the plugin stays the same."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"references":{"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"role":"collectionGroup","title":"KeyValueStore","kind":"article","type":"topic","url":"\/documentation\/swidux\/keyvaluestoreguide","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","kind":"symbol","role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux","type":"topic","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}]},"doc://Swidux/documentation/Swidux/MacrosReference":{"url":"\/documentation\/swidux\/macrosreference","kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","title":"Macros","type":"topic","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" and its property markers (the SwiftData persistence bridge, shipped in ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":").","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginArchitecture#Service-Result-Actions-and-Transition-Observation":{"abstract":[],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture#Service-Result-Actions-and-Transition-Observation","title":"Service-Result Actions and Transition Observation","url":"\/documentation\/swidux\/pluginarchitecture#Service-Result-Actions-and-Transition-Observation","kind":"section","type":"topic"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"kind":"article","type":"topic","url":"\/documentation\/swidux\/persistencemiddlewareguide","title":"Persistence Middleware","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},"doc://Swidux/documentation/Swidux/UndoRedo":{"role":"article","title":"Undo \/ Redo","kind":"article","type":"topic","url":"\/documentation\/swidux\/undoredo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your