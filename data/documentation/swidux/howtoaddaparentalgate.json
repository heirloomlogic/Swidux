luginArchitecture":{"url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","title":"Plugin Architecture","role":"article"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux","type":"topic","kind":"symbol"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"url":"\/documentation\/swidux\/howtocanceleffects","abstract":[{"text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code.","type":"text"}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","title":"Cancel Effects","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"url":"\/documentation\/swidux\/howtoaddicloudsync","abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","title":"Add iCloud Sync","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddpersistence","role":"article","title":"Add Persistence","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","role":"article"}}}