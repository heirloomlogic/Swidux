{"metadata":{"role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"Add a Parental Gate"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"When you finish, your app will:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Hold a ","type":"text"},{"code":"ParentalGateState","type":"codeVoice"},{"text":" slice in ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":"parentalGate","type":"codeVoice"},{"text":" action case in ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Run ","type":"text"},{"code":"ParentalGatePlugin","type":"codeVoice"},{"text":" as part of the store’s plugin host.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Present a math-challenge sheet whenever a feature requests a gate, and resume the original action once the user solves it.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For the API surface, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","type":"reference","isActive":true},{"type":"text","text":". For how domain plugins fit into the dispatch lifecycle, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Before you start","anchor":"Before-you-start"},{"inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired with "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", an "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and a "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory. If you don’t, start with the getting-started material and come back here."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"inlineContent":[{"type":"text","text":"The parental-gate plugin ships as a separate library product. Add it to your target’s dependencies:"}],"type":"paragraph"},{"code":["\/\/ Package.swift",".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxParentalGate\", package: \"Swidux\"),","    ]",")"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions"},{"inlineContent":[{"text":"Nest a ","type":"text"},{"code":"ParentalGateState","type":"codeVoice"},{"text":" slice on your root state, and add an action case that wraps ","type":"text"},{"code":"ParentalGateAction","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ AppState.swift","import SwiduxParentalGate","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var parentalGate: ParentalGateState = .init()","    \/\/ … other slices","}","","\/\/ AppAction.swift","enum AppAction: Sendable {","    case parentalGate(ParentalGateAction)","    \/\/ … other cases","}"],"syntax":"swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"import SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" is needed in "},{"inlineContent":[{"text":"every","type":"text"}],"type":"emphasis"},{"text":" file that touches ","type":"text"},{"type":"codeVoice","code":"store.parentalGate.*"},{"text":" or ","type":"text"},{"code":"ParentalGateAction","type":"codeVoice"},{"text":" — including views that read the slice for display. ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":".","type":"text"}]}],"type":"aside","name":"Tip","style":"tip"},{"inlineContent":[{"text":"The plugin owns the parental-gate slice end-to-end, so the root reducer just falls through:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ AppReducer.swift","case .parentalGate:","    return nil"]},{"anchor":"Step-3-Wire-the-plugin","type":"heading","level":2,"text":"Step 3: Wire the plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct "},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":" inside "},{"type":"codeVoice","code":"Store.configured()"},{"text":" and register it with the plugin host. Use ","type":"text"},{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"text":" for production:","type":"text"}]},{"code":["\/\/ AppStore.swift","let parentalGatePlugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: .standard",")","","let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","plugins.register(parentalGatePlugin)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Domain plugins use only the "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" hook, so registration order relative to other domain plugins rarely matters."}]},{"level":2,"type":"heading","text":"Step 4: Gate an action","anchor":"Step-4-Gate-an-action"},{"type":"paragraph","inlineContent":[{"text":"Pick a stable reason key per gated action (for example ","type":"text"},{"code":"\"purchase\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"settings\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"exit-kid-mode\"","type":"codeVoice"},{"text":"). In a view or feature reducer, check ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":" before performing the work:","type":"text"}]},{"code":["Button(\"Buy gems\") {","    if store.parentalGate.passedReasons.contains(\"purchase\") {","        store.send(.shop(.buyGems))","    } else {","        store.send(.parentalGate(.request(reason: \"purchase\")))","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"To resume the original action automatically once the user solves the challenge, listen for "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" in the relevant feature reducer and re-dispatch:"}]},{"code":["\/\/ ShopReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .parentalGate(.answerAccepted(let reason)) where reason == \"purchase\":","        return { send in await send(.shop(.buyGems)) }","    \/\/ …","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This pattern keeps the gate logic local to the feature it protects: the gate just emits "},{"type":"codeVoice","code":"answerAccepted"},{"type":"text","text":", and each feature decides what — if anything — to resume."}]},{"type":"heading","level":2,"anchor":"Step-5-Present-the-challenge-sheet","text":"Step 5: Present the challenge sheet"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Drive sheet presentation off "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":". Bind text input to a local "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" for the typed answer, dispatch "},{"type":"codeVoice","code":"ParentalGateAction.submitAnswer(_:)"},{"type":"text","text":" on confirm, and "},{"type":"codeVoice","code":"ParentalGateAction.regenerateChallenge"},{"type":"text","text":" for a “new question” button."}]},{"code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        \/\/ … your app UI","            .sheet(isPresented: Binding(","                get: { store.parentalGate.pendingReason != nil },","                set: { if !$0 { store.send(.parentalGate(.dismiss)) } }","            )) {","                ParentalGateSheet()","            }","    }","}","","struct ParentalGateSheet: View {","    @Environment(AppStore.self) private var store","    @State private var answer: String = \"\"","","    var body: some View {","        VStack(spacing: 16) {","            if let challenge = store.parentalGate.challenge {","                Text(\"\\(challenge.left) \\(challenge.op.symbol) \\(challenge.right) = ?\")","                    .font(.title)","","                TextField(\"Answer\", text: $answer)","                    .keyboardType(.numberPad)","","                HStack {","                    Button(\"New question\") {","                        store.send(.parentalGate(.regenerateChallenge))","                        answer = \"\"","                    }","                    Button(\"Submit\") {","                        if let value = Int(answer) {","                            store.send(.parentalGate(.submitAnswer(value)))","                        }","                        answer = \"\"","                    }","                }","            }","        }","        .padding()","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the user submits a wrong answer, the plugin increments "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates the challenge automatically, so the sheet just re-renders with the new operands."}]},{"type":"heading","level":2,"anchor":"Reasons-that-should-be-passed-once-vs-always-re-challenged","text":"Reasons that should be passed once vs. always re-challenged"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The auto-pass behavior of "},{"type":"codeVoice","code":"ParentalGateAction.request(reason:)"},{"type":"text","text":" (see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},{"type":"text","text":") is a design choice: once a reason is in "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", future "},{"type":"codeVoice","code":".request"},{"type":"text","text":" calls for it short-circuit. That’s the right default for low-stakes gates inside a single session — the user shouldn’t solve the same problem every time they tap the same button."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For higher-stakes gates that should always re-challenge, use a fresh reason key each time:"}]},{"code":["store.send(.parentalGate(.request(reason: \"purchase-\\(UUID().uuidString)\")))"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or, more usefully, clear the relevant entries from "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" at meaningful boundaries — app launch, session timeout, or returning from background. Mutate the set directly from your own reducer:"}]},{"code":["case .app(.didEnterBackground):","    state.parentalGate.passedReasons.removeAll()","    return nil"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"anchor":"Testing","text":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For deterministic tests, swap the standard generator for "},{"type":"codeVoice","code":"ParentalChallengeSource.fixed(_:)"},{"type":"text","text":":"}]},{"code":["@MainActor","@Test func correctAnswerAcceptsAndPasses() async throws {","    let challenge = MathChallenge(left: 2, right: 3, op: .plus)  \/\/ expected = 5","    let plugin = ParentalGatePlugin<AppState, AppAction>(","        state: \\.parentalGate,","        action: AppAction.parentalGate,","        extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","        challengeSource: .fixed(challenge)","    )","","    var state = AppState()","    state.parentalGate.pendingReason = \"settings\"","    state.parentalGate.challenge = challenge","","    let effect = plugin.reduce(state: &state, action: .parentalGate(.submitAnswer(5)))","    let effect = try #require(effect)","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .parentalGate(.answerAccepted(let reason)) = dispatched.first {","        #expect(reason == \"settings\")","    } else {","        Issue.record(\"expected answerAccepted, got \\(dispatched)\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SwiduxParentalGateTests"},{"type":"text","text":" target in this package uses the same pattern — a fixed challenge plus a small test root state — and is a good reference when wiring tests for your own gated features."}]}],"kind":"content"}],"sections":[],"kind":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","interfaceLanguage":"swift"},"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides","generated":true}],"variants":[{"paths":["\/documentation\/swidux\/howtoaddaparentalgate"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"title":"Add Persistence","type":"topic","kind":"article","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","url":"\/documentation\/swidux\/howtoaddpersistence","role":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"title":"Plugin Architecture","type":"topic","kind":"article","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","url":"\/documentation\/swidux\/pluginarchitecture","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","title":"Add Analytics","role":"article","url":"\/documentation\/swidux\/howtoaddanalytics","type":"topic","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify.","type":"text"}],"kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"title":"Add a Paywall","type":"topic","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","url":"\/documentation\/swidux\/howtoaddapaywall","role":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","url":"\/documentation\/swidux\/pluginparentalgatereference","title":"SwiduxParentalGate Reference","kind":"article","role":"article","abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/SecurityPosture":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","title":"Security Posture","role":"collectionGroup","url":"\/documentation\/swidux\/securityposture","type":"topic","abstract":[{"text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one.","type":"text"}],"kind":"article"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","title":"Building a Domain Plugin","role":"article","url":"\/documentation\/swidux\/buildingadomainplugin","type":"topic","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"kind":"article"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","kind":"symbol","title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"title":"Add iCloud Sync","type":"topic","kind":"article","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","url":"\/documentation\/swidux\/howtoaddicloudsync","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"title":"Add a Version Killswitch","type":"topic","kind":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","title":"Add Feature Flags","role":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"kind":"article"},"doc://Swidux/documentation/Swidux/AgentSkill":{"title":"Using the Swidux Agent Skill","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","role":"article","type":"topic","kind":"article"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","title":"Cancel Effects","role":"article","url":"\/documentation\/swidux\/howtocanceleffects","type":"topic","abstract":[{"text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code.","type":"text"}],"kind":"article"}}}