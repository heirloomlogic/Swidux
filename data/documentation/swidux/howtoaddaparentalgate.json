{"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"When you finish, your app will:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Hold a ","type":"text"},{"code":"ParentalGateState","type":"codeVoice"},{"text":" slice in ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":"parentalGate","type":"codeVoice"},{"text":" action case in ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Run ","type":"text"},{"code":"ParentalGatePlugin","type":"codeVoice"},{"text":" as part of the store’s plugin host.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Present a math-challenge sheet whenever a feature requests a gate, and resume the original action once the user solves it.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"For the API surface, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","isActive":true,"type":"reference"},{"text":". For how domain plugins fit into the dispatch lifecycle, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Before you start","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes you already have a Swidux app wired with ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", an ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and a ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory. If you don’t, start with the getting-started material and come back here.","type":"text"}]},{"level":2,"type":"heading","text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"text":"The parental-gate plugin ships as a separate library product. Add it to your target’s dependencies:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Package.swift",".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxParentalGate\", package: \"Swidux\"),","    ]",")"]},{"level":2,"type":"heading","text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions"},{"type":"paragraph","inlineContent":[{"text":"Nest a ","type":"text"},{"code":"ParentalGateState","type":"codeVoice"},{"text":" slice on your root state, and add an action case that wraps ","type":"text"},{"code":"ParentalGateAction","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ AppState.swift","import SwiduxParentalGate","","@SwiduxState","nonisolated struct AppState: Equatable, Sendable {","    @SwiduxNested var parentalGate: ParentalGateState = .init()","    \/\/ … other slices","}","","\/\/ AppAction.swift","enum AppAction: Sendable {","    case parentalGate(ParentalGateAction)","    \/\/ … other cases","}"]},{"type":"paragraph","inlineContent":[{"text":"The plugin owns the parental-gate slice end-to-end, so the root reducer just falls through:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ AppReducer.swift","case .parentalGate:","    return nil"]},{"level":2,"type":"heading","text":"Step 3: Wire the plugin","anchor":"Step-3-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"text":"Construct ","type":"text"},{"code":"ParentalGatePlugin","type":"codeVoice"},{"text":" inside ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" and register it with the plugin host. Use ","type":"text"},{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"text":" for production:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ AppStore.swift","let parentalGatePlugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: .standard",")","","let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","plugins.register(parentalGatePlugin)"]},{"type":"paragraph","inlineContent":[{"text":"Domain plugins use only the ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" hook, so registration order relative to other domain plugins rarely matters.","type":"text"}]},{"level":2,"type":"heading","text":"Step 4: Gate an action","anchor":"Step-4-Gate-an-action"},{"type":"paragraph","inlineContent":[{"text":"Pick a stable reason key per gated action (for example ","type":"text"},{"code":"\"purchase\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"settings\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"exit-kid-mode\"","type":"codeVoice"},{"text":"). In a view or feature reducer, check ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":" before performing the work:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Button(\"Buy gems\") {","    if store.parentalGate.passedReasons.contains(\"purchase\") {","        store.send(.shop(.buyGems))","    } else {","        store.send(.parentalGate(.request(reason: \"purchase\")))","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"To resume the original action automatically once the user solves the challenge, listen for ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" in the relevant feature reducer and re-dispatch:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ ShopReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .parentalGate(.answerAccepted(let reason)) where reason == \"purchase\":","        return { send in await send(.shop(.buyGems)) }","    \/\/ …","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"This pattern keeps the gate logic local to the feature it protects: the gate just emits ","type":"text"},{"code":"answerAccepted","type":"codeVoice"},{"text":", and each feature decides what — if anything — to resume.","type":"text"}]},{"level":2,"type":"heading","text":"Step 5: Present the challenge sheet","anchor":"Step-5-Present-the-challenge-sheet"},{"type":"paragraph","inlineContent":[{"text":"Drive sheet presentation off ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":". Bind text input to a local ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" for the typed answer, dispatch ","type":"text"},{"code":"ParentalGateAction.submitAnswer(_:)","type":"codeVoice"},{"text":" on confirm, and ","type":"text"},{"code":"ParentalGateAction.regenerateChallenge","type":"codeVoice"},{"text":" for a “new question” button.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        \/\/ … your app UI","            .sheet(isPresented: Binding(","                get: { store.parentalGate.pendingReason != nil },","                set: { if !$0 { store.send(.parentalGate(.dismiss)) } }","            )) {","                ParentalGateSheet()","            }","    }","}","","struct ParentalGateSheet: View {","    @Environment(AppStore.self) private var store","    @State private var answer: String = \"\"","","    var body: some View {","        VStack(spacing: 16) {","            if let challenge = store.parentalGate.challenge {","                Text(\"\\(challenge.left) \\(challenge.op.symbol) \\(challenge.right) = ?\")","                    .font(.title)","","                TextField(\"Answer\", text: $answer)","                    .keyboardType(.numberPad)","","                HStack {","                    Button(\"New question\") {","                        store.send(.parentalGate(.regenerateChallenge))","                        answer = \"\"","                    }","                    Button(\"Submit\") {","                        if let value = Int(answer) {","                            store.send(.parentalGate(.submitAnswer(value)))","                        }","                        answer = \"\"","                    }","                }","            }","        }","        .padding()","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"When the user submits a wrong answer, the plugin increments ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":" and regenerates the challenge automatically, so the sheet just re-renders with the new operands.","type":"text"}]},{"level":2,"type":"heading","text":"Reasons that should be passed once vs. always re-challenged","anchor":"Reasons-that-should-be-passed-once-vs-always-re-challenged"},{"type":"paragraph","inlineContent":[{"text":"The auto-pass behavior of ","type":"text"},{"code":"ParentalGateAction.request(reason:)","type":"codeVoice"},{"text":" (see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","isActive":true},{"text":") is a design choice: once a reason is in ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", future ","type":"text"},{"code":".request","type":"codeVoice"},{"text":" calls for it short-circuit. That’s the right default for low-stakes gates inside a single session — the user shouldn’t solve the same problem every time they tap the same button.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For higher-stakes gates that should always re-challenge, use a fresh reason key each time:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["store.send(.parentalGate(.request(reason: \"purchase-\\(UUID().uuidString)\")))"]},{"type":"paragraph","inlineContent":[{"text":"Or, more usefully, clear the relevant entries from ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":" at meaningful boundaries — app launch, session timeout, or returning from background. Mutate the set directly from your own reducer:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["case .app(.didEnterBackground):","    state.parentalGate.passedReasons.removeAll()","    return nil"]},{"level":2,"type":"heading","text":"Testing","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"For deterministic tests, swap the standard generator for ","type":"text"},{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","@Test func correctAnswerAcceptsAndPasses() async throws {","    let challenge = MathChallenge(left: 2, right: 3, op: .plus)  \/\/ expected = 5","    let plugin = ParentalGatePlugin<AppState, AppAction>(","        state: \\.parentalGate,","        action: AppAction.parentalGate,","        extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","        challengeSource: .fixed(challenge)","    )","","    var state = AppState()","    state.parentalGate.pendingReason = \"settings\"","    state.parentalGate.challenge = challenge","","    let effect = plugin.reduce(state: &state, action: .parentalGate(.submitAnswer(5)))","    let effect = try #require(effect)","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .parentalGate(.answerAccepted(let reason)) = dispatched.first {","        #expect(reason == \"settings\")","    } else {","        Issue.record(\"expected answerAccepted, got \\(dispatched)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"SwiduxParentalGateTests","type":"codeVoice"},{"text":" target in this package uses the same pattern — a fixed challenge plus a small test root state — and is a good reference when wiring tests for your own gated features.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides","generated":true}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddaparentalgate"]}],"abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"article","roleHeading":"Article","title":"Add a Parental Gate","modules":[{"name":"Swidux"}]},"references":{"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"title":"Add a Paywall","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"topic"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","url":"\/documentation\/swidux\/buildingadomainplugin","type":"topic","kind":"article","title":"Building a Domain Plugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}]},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","title":"Add a Version Killswitch"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","kind":"article","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"title":"Plugin Architecture","url":"\/documentation\/swidux\/pluginarchitecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic"},"doc://Swidux/documentation/Swidux/AgentSkill":{"role":"article","kind":"article","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"title":"Using the Swidux Agent Skill","url":"\/documentation\/swidux\/agentskill","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","type":"topic"},"doc://Swidux/documentation/Swidux":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"title":"Swidux","kind":"symbol","url":"\/documentation\/swidux","role":"collection"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"role":"article","type":"topic","url":"\/documentation\/swidux\/pluginparentalgatereference","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","title":"SwiduxParentalGate Reference","abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}]}}}