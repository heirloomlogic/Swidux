{"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddaparentalgate"]}],"sections":[],"abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"title":"How-to Guides","generated":true,"anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"]}],"metadata":{"modules":[{"name":"Swidux"}],"title":"Add a Parental Gate","roleHeading":"Article","role":"article"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you finish, your app will:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Hold a ","type":"text"},{"type":"codeVoice","code":"ParentalGateState"},{"text":" slice in ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" and a ","type":"text"},{"type":"codeVoice","code":"parentalGate"},{"text":" action case in ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Run ","type":"text"},{"type":"codeVoice","code":"ParentalGatePlugin"},{"text":" as part of the store’s plugin host.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Present a math-challenge sheet whenever a feature requests a gate, and resume the original action once the user solves it.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For the API surface, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},{"type":"text","text":". For how domain plugins fit into the dispatch lifecycle, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]},{"level":2,"text":"Before you start","type":"heading","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired with "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and a "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory. If you don’t, start with the getting-started material and come back here."}]},{"level":2,"text":"Step 1: Add the dependency","type":"heading","anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parental-gate plugin ships as a separate library product. Add it to your target’s dependencies:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Package.swift",".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxParentalGate\", package: \"Swidux\"),","    ]",")"]},{"level":2,"text":"Step 2: Add state and actions","type":"heading","anchor":"Step-2-Add-state-and-actions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nest a "},{"type":"codeVoice","code":"ParentalGateState"},{"type":"text","text":" slice on your root state, and add an action case that wraps "},{"type":"codeVoice","code":"ParentalGateAction"},{"type":"text","text":"."}]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppState.swift","import SwiduxParentalGate","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var parentalGate: ParentalGateState = .init()","    \/\/ … other slices","}","","\/\/ AppAction.swift","enum AppAction: Sendable {","    case parentalGate(ParentalGateAction)","    \/\/ … other cases","}"]},{"name":"Tip","type":"aside","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"import SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"text":"every","type":"text"}]},{"type":"text","text":" file that touches "},{"code":"store.parentalGate.*","type":"codeVoice"},{"type":"text","text":" or "},{"code":"ParentalGateAction","type":"codeVoice"},{"type":"text","text":" — including views that read the slice for display. "},{"code":"@_exported import Swidux","type":"codeVoice"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin owns the parental-gate slice end-to-end, so the root reducer just falls through:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppReducer.swift","case .parentalGate:","    return nil"]},{"level":2,"text":"Step 3: Wire the plugin","type":"heading","anchor":"Step-3-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct "},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":" inside "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" and register it with the plugin host. Use "},{"type":"codeVoice","code":"ParentalChallengeSource.standard"},{"type":"text","text":" for production:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppStore.swift","let parentalGatePlugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: .standard",")","","let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","plugins.register(parentalGatePlugin)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Domain plugins use only the "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" hook, so registration order relative to other domain plugins rarely matters."}]},{"level":2,"text":"Step 4: Gate an action","type":"heading","anchor":"Step-4-Gate-an-action"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pick a stable reason key per gated action (for example "},{"type":"codeVoice","code":"\"purchase\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"settings\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"exit-kid-mode\""},{"type":"text","text":"). In a view or feature reducer, check "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" before performing the work:"}]},{"syntax":"swift","type":"codeListing","code":["Button(\"Buy gems\") {","    if store.parentalGate.passedReasons.contains(\"purchase\") {","        store.send(.shop(.buyGems))","    } else {","        store.send(.parentalGate(.request(reason: \"purchase\")))","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To resume the original action automatically once the user solves the challenge, listen for "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" in the relevant feature reducer and re-dispatch:"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ ShopReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .parentalGate(.answerAccepted(let reason)) where reason == \"purchase\":","        return Effect { send in await send(.shop(.buyGems)) }","    \/\/ …","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This pattern keeps the gate logic local to the feature it protects: the gate just emits "},{"type":"codeVoice","code":"answerAccepted"},{"type":"text","text":", and each feature decides what — if anything — to resume."}]},{"level":2,"text":"Step 5: Present the challenge sheet","type":"heading","anchor":"Step-5-Present-the-challenge-sheet"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Drive sheet presentation off "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":". Bind text input to a local "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" for the typed answer, dispatch "},{"type":"codeVoice","code":"ParentalGateAction.submitAnswer(_:)"},{"type":"text","text":" on confirm, and "},{"type":"codeVoice","code":"ParentalGateAction.regenerateChallenge"},{"type":"text","text":" for a “new question” button."}]},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        \/\/ … your app UI","            .sheet(isPresented: Binding(","                get: { store.parentalGate.pendingReason != nil },","                set: { if !$0 { store.send(.parentalGate(.dismiss)) } }","            )) {","                ParentalGateSheet()","            }","    }","}","","struct ParentalGateSheet: View {","    @Environment(AppStore.self) private var store","    @State private var answer: String = \"\"","","    var body: some View {","        VStack(spacing: 16) {","            if let challenge = store.parentalGate.challenge {","                Text(\"\\(challenge.left) \\(challenge.op.symbol) \\(challenge.right) = ?\")","                    .font(.title)","","                TextField(\"Answer\", text: $answer)","                    .keyboardType(.numberPad)","","                HStack {","                    Button(\"New question\") {","                        store.send(.parentalGate(.regenerateChallenge))","                        answer = \"\"","                    }","                    Button(\"Submit\") {","                        if let value = Int(answer) {","                            store.send(.parentalGate(.submitAnswer(value)))","                        }","                        answer = \"\"","                    }","                }","            }","        }","        .padding()","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the user submits a wrong answer, the plugin increments "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates the challenge automatically, so the sheet just re-renders with the new operands."}]},{"level":2,"text":"Reasons that should be passed once vs. always re-challenged","type":"heading","anchor":"Reasons-that-should-be-passed-once-vs-always-re-challenged"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The auto-pass behavior of "},{"type":"codeVoice","code":"ParentalGateAction.request(reason:)"},{"type":"text","text":" (see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},{"type":"text","text":") is a design choice: once a reason is in "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", future "},{"type":"codeVoice","code":".request"},{"type":"text","text":" calls for it short-circuit. That’s the right default for low-stakes gates inside a single session — the user shouldn’t solve the same problem every time they tap the same button."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For higher-stakes gates that should always re-challenge, use a fresh reason key each time:"}]},{"syntax":"swift","type":"codeListing","code":["store.send(.parentalGate(.request(reason: \"purchase-\\(UUID().uuidString)\")))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or, more usefully, clear the relevant entries from "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" at meaningful boundaries — app launch, session timeout, or returning from background. Mutate the set directly from your own reducer:"}]},{"syntax":"swift","type":"codeListing","code":["case .app(.didEnterBackground):","    state.parentalGate.passedReasons.removeAll()","    return nil"]},{"level":2,"text":"Testing","type":"heading","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For deterministic tests, swap the standard generator for "},{"type":"codeVoice","code":"ParentalChallengeSource.fixed(_:)"},{"type":"text","text":":"}]},{"syntax":"swift","type":"codeListing","code":["@MainActor","@Test func correctAnswerAcceptsAndPasses() async throws {","    let challenge = MathChallenge(left: 2, right: 3, op: .plus)  \/\/ expected = 5","    let plugin = ParentalGatePlugin<AppState, AppAction>(","        state: \\.parentalGate,","        action: AppAction.parentalGate,","        extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","        challengeSource: .fixed(challenge)","    )","","    var state = AppState()","    state.parentalGate.pendingReason = \"settings\"","    state.parentalGate.challenge = challenge","","    let effect = plugin.reduce(state: &state, action: .parentalGate(.submitAnswer(5)))","    let effect = try #require(effect)","","    var dispatched: [AppAction] = []","    try await effect { dispatched.append($0) }","","    if case .parentalGate(.answerAccepted(let reason)) = dispatched.first {","        #expect(reason == \"settings\")","    } else {","        Issue.record(\"expected answerAccepted, got \\(dispatched)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SwiduxParentalGateTests"},{"type":"text","text":" target in this package uses the same pattern — a fixed challenge plus a small test root state — and is a good reference when wiring tests for your own gated features."}]}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"references":{"doc://Swidux/documentation/Swidux/PluginArchitecture":{"kind":"article","type":"topic","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"url":"\/documentation\/swidux\/pluginarchitecture","role":"article","title":"Plugin Architecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","kind":"article","title":"Add Analytics","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"url":"\/documentation\/swidux\/howtoaddanalytics","role":"article"},"doc://Swidux/documentation/Swidux":{"kind":"symbol","type":"topic","url":"\/documentation\/swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux"},"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","kind":"article","title":"Using the Swidux Agent Skill","abstract":[{"text":"Install the bundled ","type":"text"},{"code":"swidux-ref","type":"codeVoice"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"url":"\/documentation\/swidux\/agentskill","role":"article"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","kind":"article","title":"Cancel Effects","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"url":"\/documentation\/swidux\/howtocanceleffects","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","kind":"article","title":"Add Feature Flags","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"url":"\/documentation\/swidux\/howtoaddfeatureflags","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","kind":"article","title":"Add a Paywall","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"url":"\/documentation\/swidux\/howtoaddapaywall","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","kind":"article","title":"Add iCloud Sync","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":" with the "},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"url":"\/documentation\/swidux\/howtoaddicloudsync","role":"article"},"doc://Swidux/documentation/Swidux/SecurityPosture":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","url":"\/documentation\/swidux\/securityposture","abstract":[{"text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one.","type":"text"}],"title":"Security Posture","kind":"article","role":"collectionGroup"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","kind":"article","title":"Building a Domain Plugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"url":"\/documentation\/swidux\/buildingadomainplugin","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","kind":"article","title":"Add Persistence","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":" plugin and the "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" macro — no hand-written "},{"code":"@Model","type":"codeVoice"},{"type":"text","text":" classes, database actors, or "},{"code":"StateWriter","type":"codeVoice"},{"type":"text","text":" closures."}],"url":"\/documentation\/swidux\/howtoaddpersistence","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","kind":"article","title":"Add a Version Killswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"url":"\/documentation\/swidux\/howtoaddaversionkillswitch","role":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"kind":"article","type":"topic","abstract":[{"text":"API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"url":"\/documentation\/swidux\/pluginparentalgatereference","role":"article","title":"SwiduxParentalGate Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"}}}