{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"variants":[{"paths":["\/documentation\/swidux\/howtoaddaparentalgate"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"When you finish, your app will:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Hold a "},{"type":"codeVoice","code":"ParentalGateState"},{"type":"text","text":" slice in "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"parentalGate"},{"type":"text","text":" action case in "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Run "},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":" as part of the store’s plugin host."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Present a math-challenge sheet whenever a feature requests a gate, and resume the original action once the user solves it."}]}]}]},{"inlineContent":[{"text":"For the API surface, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},{"text":". For how domain plugins fit into the dispatch lifecycle, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Before-you-start","text":"Before you start"},{"inlineContent":[{"text":"This guide assumes you already have a Swidux app wired with ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", an ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and a ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory. If you don’t, start with the getting-started material and come back here.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Step-1-Add-the-dependency","text":"Step 1: Add the dependency"},{"inlineContent":[{"text":"The parental-gate plugin ships as a separate library product. Add it to your target’s dependencies:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Package.swift",".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxParentalGate\", package: \"Swidux\"),","    ]",")"]},{"level":2,"type":"heading","anchor":"Step-2-Add-state-and-actions","text":"Step 2: Add state and actions"},{"inlineContent":[{"text":"Nest a ","type":"text"},{"code":"ParentalGateState","type":"codeVoice"},{"text":" slice on your root state, and add an action case that wraps ","type":"text"},{"code":"ParentalGateAction","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ AppState.swift","import SwiduxParentalGate","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var parentalGate: ParentalGateState = .init()","    \/\/ … other slices","}","","\/\/ AppAction.swift","enum AppAction: Sendable {","    case parentalGate(ParentalGateAction)","    \/\/ … other cases","}"]},{"type":"aside","name":"Tip","style":"tip","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"import SwiduxParentalGate"},{"text":" is needed in ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"every"}]},{"text":" file that touches ","type":"text"},{"type":"codeVoice","code":"store.parentalGate.*"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"ParentalGateAction"},{"text":" — including views that read the slice for display. ","type":"text"},{"type":"codeVoice","code":"@_exported import Swidux"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"text":".","type":"text"}]}]},{"inlineContent":[{"text":"The plugin owns the parental-gate slice end-to-end, so the root reducer just falls through:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ AppReducer.swift","case .parentalGate:","    return nil"]},{"level":2,"type":"heading","anchor":"Step-3-Wire-the-plugin","text":"Step 3: Wire the plugin"},{"inlineContent":[{"text":"Construct ","type":"text"},{"code":"ParentalGatePlugin","type":"codeVoice"},{"text":" inside ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" and register it with the plugin host. Use ","type":"text"},{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"text":" for production:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ AppStore.swift","let parentalGatePlugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: .standard",")","","let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","plugins.register(parentalGatePlugin)"]},{"inlineContent":[{"text":"Domain plugins use only the ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" hook, so registration order relative to other domain plugins rarely matters.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Step-4-Gate-an-action","text":"Step 4: Gate an action"},{"inlineContent":[{"text":"Pick a stable reason key per gated action (for example ","type":"text"},{"type":"codeVoice","code":"\"purchase\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"settings\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"exit-kid-mode\""},{"text":"). In a view or feature reducer, check ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":" before performing the work:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Button(\"Buy gems\") {","    if store.parentalGate.passedReasons.contains(\"purchase\") {","        store.send(.shop(.buyGems))","    } else {","        store.send(.parentalGate(.request(reason: \"purchase\")))","    }","}"]},{"inlineContent":[{"text":"To resume the original action automatically once the user solves the challenge, listen for ","type":"text"},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"text":" in the relevant feature reducer and re-dispatch:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ ShopReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .parentalGate(.answerAccepted(let reason)) where reason == \"purchase\":","        return { send in await send(.shop(.buyGems)) }","    \/\/ …","    }","}"]},{"inlineContent":[{"type":"text","text":"This pattern keeps the gate logic local to the feature it protects: the gate just emits "},{"type":"codeVoice","code":"answerAccepted"},{"type":"text","text":", and each feature decides what — if anything — to resume."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Step-5-Present-the-challenge-sheet","text":"Step 5: Present the challenge sheet"},{"inlineContent":[{"type":"text","text":"Drive sheet presentation off "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":". Bind text input to a local "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" for the typed answer, dispatch "},{"type":"codeVoice","code":"ParentalGateAction.submitAnswer(_:)"},{"type":"text","text":" on confirm, and "},{"type":"codeVoice","code":"ParentalGateAction.regenerateChallenge"},{"type":"text","text":" for a “new question” button."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        \/\/ … your app UI","            .sheet(isPresented: Binding(","                get: { store.parentalGate.pendingReason != nil },","                set: { if !$0 { store.send(.parentalGate(.dismiss)) } }","            )) {","                ParentalGateSheet()","            }","    }","}","","struct ParentalGateSheet: View {","    @Environment(AppStore.self) private var store","    @State private var answer: String = \"\"","","    var body: some View {","        VStack(spacing: 16) {","            if let challenge = store.parentalGate.challenge {","                Text(\"\\(challenge.left) \\(challenge.op.symbol) \\(challenge.right) = ?\")","                    .font(.title)","","                TextField(\"Answer\", text: $answer)","                    .keyboardType(.numberPad)","","                HStack {","                    Button(\"New question\") {","                        store.send(.parentalGate(.regenerateChallenge))","                        answer = \"\"","                    }","                    Button(\"Submit\") {","                        if let value = Int(answer) {","                            store.send(.parentalGate(.submitAnswer(value)))","                        }","                        answer = \"\"","                    }","                }","            }","        }","        .padding()","    }","}"]},{"inlineContent":[{"type":"text","text":"When the user submits a wrong answer, the plugin increments "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates the challenge automatically, so the sheet just re-renders with the new operands."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Reasons-that-should-be-passed-once-vs-always-re-challenged","text":"Reasons that should be passed once vs. always re-challenged"},{"inlineContent":[{"type":"text","text":"The auto-pass behavior of "},{"type":"codeVoice","code":"ParentalGateAction.request(reason:)"},{"type":"text","text":" (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},{"type":"text","text":") is a design choice: once a reason is in "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", future "},{"type":"codeVoice","code":".request"},{"type":"text","text":" calls for it short-circuit. That’s the right default for low-stakes gates inside a single session — the user shouldn’t solve the same problem every time they tap the same button."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For higher-stakes gates that should always re-challenge, use a fresh reason key each time:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["store.send(.parentalGate(.request(reason: \"purchase-\\(UUID().uuidString)\")))"]},{"inlineContent":[{"type":"text","text":"Or, more usefully, clear the relevant entries from "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" at meaningful boundaries — app launch, session timeout, or returning from background. Mutate the set directly from your own reducer:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["case .app(.didEnterBackground):","    state.parentalGate.passedReasons.removeAll()","    return nil"]},{"level":2,"type":"heading","anchor":"Testing","text":"Testing"},{"inlineContent":[{"text":"For deterministic tests, swap the standard generator for ","type":"text"},{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@MainActor","@Test func correctAnswerAcceptsAndPasses() async throws {","    let challenge = MathChallenge(left: 2, right: 3, op: .plus)  \/\/ expected = 5","    let plugin = ParentalGatePlugin<AppState, AppAction>(","        state: \\.parentalGate,","        action: AppAction.parentalGate,","        extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","        challengeSource: .fixed(challenge)","    )","","    var state = AppState()","    state.parentalGate.pendingReason = \"settings\"","    state.parentalGate.challenge = challenge","","    let effect = plugin.reduce(state: &state, action: .parentalGate(.submitAnswer(5)))","    let effect = try #require(effect)","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .parentalGate(.answerAccepted(let reason)) = dispatched.first {","        #expect(reason == \"settings\")","    } else {","        Issue.record(\"expected answerAccepted, got \\(dispatched)\")","    }","}"]},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SwiduxParentalGateTests"},{"type":"text","text":" target in this package uses the same pattern — a fixed challenge plus a small test root state — and is a good reference when wiring tests for your own gated features."}],"type":"paragraph"}]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"title":"How-to Guides","anchor":"How-to-Guides"}],"metadata":{"modules":[{"name":"Swidux"}],"title":"Add a Parental Gate","role":"article","roleHeading":"Article"},"abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","references":{"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"url":"\/documentation\/swidux","title":"Swidux","type":"topic"},"doc://Swidux/documentation/Swidux/SecurityPosture":{"kind":"article","url":"\/documentation\/swidux\/securityposture","title":"Security Posture","role":"collectionGroup","type":"topic","abstract":[{"type":"text","text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"title":"Add iCloud Sync","url":"\/documentation\/swidux\/howtoaddicloudsync","role":"article","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"title":"Add Analytics","url":"\/documentation\/swidux\/howtoaddanalytics","role":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"title":"Add a Version Killswitch","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"title":"Add Feature Flags","url":"\/documentation\/swidux\/howtoaddfeatureflags","role":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"topic","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"title":"Add a Paywall","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","kind":"article","role":"article","abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"url":"\/documentation\/swidux\/pluginparentalgatereference","title":"SwiduxParentalGate Reference","type":"topic"},"doc://Swidux/documentation/Swidux/AgentSkill":{"title":"Using the Swidux Agent Skill","url":"\/documentation\/swidux\/agentskill","role":"article","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"title":"Cancel Effects","url":"\/documentation\/swidux\/howtocanceleffects","role":"article","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"title":"Add Persistence","url":"\/documentation\/swidux\/howtoaddpersistence","role":"article","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic","url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"title":"Plugin Architecture","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"url":"\/documentation\/swidux\/buildingadomainplugin","title":"Building a Domain Plugin","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"}}}