{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"kind":"article","sections":[],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"generated":true,"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"text":"When you finish, your app will:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Hold a ","type":"text"},{"type":"codeVoice","code":"ParentalGateState"},{"text":" slice in ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" and a ","type":"text"},{"type":"codeVoice","code":"parentalGate"},{"text":" action case in ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Run ","type":"text"},{"type":"codeVoice","code":"ParentalGatePlugin"},{"text":" as part of the store’s plugin host.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Present a math-challenge sheet whenever a feature requests a gate, and resume the original action once the user solves it.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"For the API surface, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","isActive":true,"type":"reference"},{"text":". For how domain plugins fit into the dispatch lifecycle, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Before you start","type":"heading","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired with "},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":", an ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory. If you don’t, start with the getting-started material and come back here."}]},{"anchor":"Step-1-Add-the-dependency","type":"heading","level":2,"text":"Step 1: Add the dependency"},{"inlineContent":[{"text":"The parental-gate plugin ships as a separate library product. Add it to your target’s dependencies:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Package.swift",".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxParentalGate\", package: \"Swidux\"),","    ]",")"],"syntax":"swift"},{"anchor":"Step-2-Add-state-and-actions","type":"heading","level":2,"text":"Step 2: Add state and actions"},{"type":"paragraph","inlineContent":[{"text":"Nest a ","type":"text"},{"type":"codeVoice","code":"ParentalGateState"},{"text":" slice on your root state, and add an action case that wraps ","type":"text"},{"type":"codeVoice","code":"ParentalGateAction"},{"text":".","type":"text"}]},{"type":"codeListing","code":["\/\/ AppState.swift","import SwiduxParentalGate","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var parentalGate: ParentalGateState = .init()","    \/\/ … other slices","}","","\/\/ AppAction.swift","enum AppAction: Sendable {","    case parentalGate(ParentalGateAction)","    \/\/ … other cases","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The plugin owns the parental-gate slice end-to-end, so the root reducer just falls through:","type":"text"}]},{"type":"codeListing","code":["\/\/ AppReducer.swift","case .parentalGate:","    return nil"],"syntax":"swift"},{"type":"heading","text":"Step 3: Wire the plugin","level":2,"anchor":"Step-3-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct "},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":" inside "},{"type":"codeVoice","code":"Store.configured()"},{"text":" and register it with the plugin host. Use ","type":"text"},{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"text":" for production:","type":"text"}]},{"type":"codeListing","code":["\/\/ AppStore.swift","let parentalGatePlugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: .standard",")","","let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","plugins.register(parentalGatePlugin)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Domain plugins use only the ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" hook, so registration order relative to other domain plugins rarely matters.","type":"text"}]},{"level":2,"text":"Step 4: Gate an action","type":"heading","anchor":"Step-4-Gate-an-action"},{"type":"paragraph","inlineContent":[{"text":"Pick a stable reason key per gated action (for example ","type":"text"},{"code":"\"purchase\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"settings\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"exit-kid-mode\"","type":"codeVoice"},{"text":"). In a view or feature reducer, check ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":" before performing the work:","type":"text"}]},{"type":"codeListing","code":["Button(\"Buy gems\") {","    if store.parentalGate.passedReasons.contains(\"purchase\") {","        store.send(.shop(.buyGems))","    } else {","        store.send(.parentalGate(.request(reason: \"purchase\")))","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"To resume the original action automatically once the user solves the challenge, listen for ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" in the relevant feature reducer and re-dispatch:","type":"text"}]},{"type":"codeListing","code":["\/\/ ShopReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .parentalGate(.answerAccepted(let reason)) where reason == \"purchase\":","        return { send in await send(.shop(.buyGems)) }","    \/\/ …","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This pattern keeps the gate logic local to the feature it protects: the gate just emits ","type":"text"},{"code":"answerAccepted","type":"codeVoice"},{"text":", and each feature decides what — if anything — to resume.","type":"text"}]},{"level":2,"text":"Step 5: Present the challenge sheet","type":"heading","anchor":"Step-5-Present-the-challenge-sheet"},{"type":"paragraph","inlineContent":[{"text":"Drive sheet presentation off ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":". Bind text input to a local "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" for the typed answer, dispatch "},{"type":"codeVoice","code":"ParentalGateAction.submitAnswer(_:)"},{"type":"text","text":" on confirm, and "},{"type":"codeVoice","code":"ParentalGateAction.regenerateChallenge"},{"type":"text","text":" for a “new question” button."}]},{"type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        \/\/ … your app UI","            .sheet(isPresented: Binding(","                get: { store.parentalGate.pendingReason != nil },","                set: { if !$0 { store.send(.parentalGate(.dismiss)) } }","            )) {","                ParentalGateSheet()","            }","    }","}","","struct ParentalGateSheet: View {","    @Environment(AppStore.self) private var store","    @State private var answer: String = \"\"","","    var body: some View {","        VStack(spacing: 16) {","            if let challenge = store.parentalGate.challenge {","                Text(\"\\(challenge.left) \\(challenge.op.symbol) \\(challenge.right) = ?\")","                    .font(.title)","","                TextField(\"Answer\", text: $answer)","                    .keyboardType(.numberPad)","","                HStack {","                    Button(\"New question\") {","                        store.send(.parentalGate(.regenerateChallenge))","                        answer = \"\"","                    }","                    Button(\"Submit\") {","                        if let value = Int(answer) {","                            store.send(.parentalGate(.submitAnswer(value)))","                        }","                        answer = \"\"","                    }","                }","            }","        }","        .padding()","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the user submits a wrong answer, the plugin increments "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates the challenge automatically, so the sheet just re-renders with the new operands."}]},{"level":2,"text":"Reasons that should be passed once vs. always re-challenged","type":"heading","anchor":"Reasons-that-should-be-passed-once-vs-always-re-challenged"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The auto-pass behavior of "},{"type":"codeVoice","code":"ParentalGateAction.request(reason:)"},{"type":"text","text":" (see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","isActive":true},{"type":"text","text":") is a design choice: once a reason is in "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", future "},{"type":"codeVoice","code":".request"},{"type":"text","text":" calls for it short-circuit. That’s the right default for low-stakes gates inside a single session — the user shouldn’t solve the same problem every time they tap the same button."}]},{"type":"paragraph","inlineContent":[{"text":"For higher-stakes gates that should always re-challenge, use a fresh reason key each time:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["store.send(.parentalGate(.request(reason: \"purchase-\\(UUID().uuidString)\")))"]},{"inlineContent":[{"text":"Or, more usefully, clear the relevant entries from ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":" at meaningful boundaries — app launch, session timeout, or returning from background. Mutate the set directly from your own reducer:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["case .app(.didEnterBackground):","    state.parentalGate.passedReasons.removeAll()","    return nil"]},{"anchor":"Testing","type":"heading","level":2,"text":"Testing"},{"inlineContent":[{"text":"For deterministic tests, swap the standard generator for ","type":"text"},{"type":"codeVoice","code":"ParentalChallengeSource.fixed(_:)"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@MainActor","@Test func correctAnswerAcceptsAndPasses() async throws {","    let challenge = MathChallenge(left: 2, right: 3, op: .plus)  \/\/ expected = 5","    let plugin = ParentalGatePlugin<AppState, AppAction>(","        state: \\.parentalGate,","        action: AppAction.parentalGate,","        extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","        challengeSource: .fixed(challenge)","    )","","    var state = AppState()","    state.parentalGate.pendingReason = \"settings\"","    state.parentalGate.challenge = challenge","","    let effect = plugin.reduce(state: &state, action: .parentalGate(.submitAnswer(5)))","    let effect = try #require(effect)","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .parentalGate(.answerAccepted(let reason)) = dispatched.first {","        #expect(reason == \"settings\")","    } else {","        Issue.record(\"expected answerAccepted, got \\(dispatched)\")","    }","}"]},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGateTests"},{"text":" target in this package uses the same pattern — a fixed challenge plus a small test root state — and is a good reference when wiring tests for your own gated features.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article","title":"Add a Parental Gate"},"variants":[{"paths":["\/documentation\/swidux\/howtoaddaparentalgate"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Swidux/documentation/Swidux":{"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"title":"Swidux","role":"collection","type":"topic","url":"\/documentation\/swidux"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","title":"Add a Version Killswitch","abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"role":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"type":"topic","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify.","type":"text"}],"title":"Add Analytics","role":"article","url":"\/documentation\/swidux\/howtoaddanalytics","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"type":"topic","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"title":"Add Feature Flags","role":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","kind":"article"},"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","abstract":[{"text":"Install the bundled ","type":"text"},{"code":"swidux-ref","type":"codeVoice"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"title":"Using the Swidux Agent Skill","role":"article","url":"\/documentation\/swidux\/agentskill","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","kind":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","title":"SwiduxParentalGate Reference","url":"\/documentation\/swidux\/pluginparentalgatereference","type":"topic"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"kind":"article","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","title":"Plugin Architecture","url":"\/documentation\/swidux\/pluginarchitecture","type":"topic"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","title":"Building a Domain Plugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"role":"article","type":"topic","url":"\/documentation\/swidux\/buildingadomainplugin"}}}