{"kind":"article","variants":[{"paths":["\/documentation\/swidux\/howtoaddaparentalgate"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"Swidux"}],"title":"Add a Parental Gate","roleHeading":"Article","role":"article"},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"When you finish, your app will:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Hold a ","type":"text"},{"type":"codeVoice","code":"ParentalGateState"},{"text":" slice in ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":" and a ","type":"text"},{"type":"codeVoice","code":"parentalGate"},{"text":" action case in ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Run ","type":"text"},{"type":"codeVoice","code":"ParentalGatePlugin"},{"text":" as part of the store’s plugin host.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Present a math-challenge sheet whenever a feature requests a gate, and resume the original action once the user solves it.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For the API surface, see "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","type":"reference"},{"type":"text","text":". For how domain plugins fit into the dispatch lifecycle, see "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Before-you-start","level":2,"type":"heading","text":"Before you start"},{"inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired with "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", an "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and a "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory. If you don’t, start with the getting-started material and come back here."}],"type":"paragraph"},{"anchor":"Step-1-Add-the-dependency","level":2,"type":"heading","text":"Step 1: Add the dependency"},{"inlineContent":[{"type":"text","text":"The parental-gate plugin ships as a separate library product. Add it to your target’s dependencies:"}],"type":"paragraph"},{"code":["\/\/ Package.swift",".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxParentalGate\", package: \"Swidux\"),","    ]",")"],"syntax":"swift","type":"codeListing"},{"anchor":"Step-2-Add-state-and-actions","level":2,"type":"heading","text":"Step 2: Add state and actions"},{"inlineContent":[{"type":"text","text":"Nest a "},{"code":"ParentalGateState","type":"codeVoice"},{"type":"text","text":" slice on your root state, and add an action case that wraps "},{"code":"ParentalGateAction","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["\/\/ AppState.swift","import SwiduxParentalGate","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var parentalGate: ParentalGateState = .init()","    \/\/ … other slices","}","","\/\/ AppAction.swift","enum AppAction: Sendable {","    case parentalGate(ParentalGateAction)","    \/\/ … other cases","}"],"syntax":"swift","type":"codeListing"},{"content":[{"inlineContent":[{"text":"","type":"text"},{"code":"import SwiduxParentalGate","type":"codeVoice"},{"text":" is needed in ","type":"text"},{"inlineContent":[{"text":"every","type":"text"}],"type":"emphasis"},{"text":" file that touches ","type":"text"},{"code":"store.parentalGate.*","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"ParentalGateAction","type":"codeVoice"},{"text":" — including views that read the slice for display. ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","style":"tip","name":"Tip"},{"inlineContent":[{"type":"text","text":"The plugin owns the parental-gate slice end-to-end, so the root reducer just falls through:"}],"type":"paragraph"},{"code":["\/\/ AppReducer.swift","case .parentalGate:","    return nil"],"syntax":"swift","type":"codeListing"},{"anchor":"Step-3-Wire-the-plugin","level":2,"type":"heading","text":"Step 3: Wire the plugin"},{"inlineContent":[{"type":"text","text":"Construct "},{"code":"ParentalGatePlugin","type":"codeVoice"},{"type":"text","text":" inside "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" and register it with the plugin host. Use "},{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"type":"text","text":" for production:"}],"type":"paragraph"},{"code":["\/\/ AppStore.swift","let parentalGatePlugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: .standard",")","","let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","plugins.register(parentalGatePlugin)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Domain plugins use only the "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" hook, so registration order relative to other domain plugins rarely matters."}],"type":"paragraph"},{"anchor":"Step-4-Gate-an-action","level":2,"type":"heading","text":"Step 4: Gate an action"},{"inlineContent":[{"type":"text","text":"Pick a stable reason key per gated action (for example "},{"code":"\"purchase\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"settings\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"exit-kid-mode\"","type":"codeVoice"},{"type":"text","text":"). In a view or feature reducer, check "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" before performing the work:"}],"type":"paragraph"},{"code":["Button(\"Buy gems\") {","    if store.parentalGate.passedReasons.contains(\"purchase\") {","        store.send(.shop(.buyGems))","    } else {","        store.send(.parentalGate(.request(reason: \"purchase\")))","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"To resume the original action automatically once the user solves the challenge, listen for "},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"type":"text","text":" in the relevant feature reducer and re-dispatch:"}],"type":"paragraph"},{"code":["\/\/ ShopReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .parentalGate(.answerAccepted(let reason)) where reason == \"purchase\":","        return { send in await send(.shop(.buyGems)) }","    \/\/ …","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This pattern keeps the gate logic local to the feature it protects: the gate just emits "},{"code":"answerAccepted","type":"codeVoice"},{"type":"text","text":", and each feature decides what — if anything — to resume."}],"type":"paragraph"},{"anchor":"Step-5-Present-the-challenge-sheet","level":2,"type":"heading","text":"Step 5: Present the challenge sheet"},{"inlineContent":[{"type":"text","text":"Drive sheet presentation off "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":". Bind text input to a local "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" for the typed answer, dispatch "},{"code":"ParentalGateAction.submitAnswer(_:)","type":"codeVoice"},{"type":"text","text":" on confirm, and "},{"code":"ParentalGateAction.regenerateChallenge","type":"codeVoice"},{"type":"text","text":" for a “new question” button."}],"type":"paragraph"},{"code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        \/\/ … your app UI","            .sheet(isPresented: Binding(","                get: { store.parentalGate.pendingReason != nil },","                set: { if !$0 { store.send(.parentalGate(.dismiss)) } }","            )) {","                ParentalGateSheet()","            }","    }","}","","struct ParentalGateSheet: View {","    @Environment(AppStore.self) private var store","    @State private var answer: String = \"\"","","    var body: some View {","        VStack(spacing: 16) {","            if let challenge = store.parentalGate.challenge {","                Text(\"\\(challenge.left) \\(challenge.op.symbol) \\(challenge.right) = ?\")","                    .font(.title)","","                TextField(\"Answer\", text: $answer)","                    .keyboardType(.numberPad)","","                HStack {","                    Button(\"New question\") {","                        store.send(.parentalGate(.regenerateChallenge))","                        answer = \"\"","                    }","                    Button(\"Submit\") {","                        if let value = Int(answer) {","                            store.send(.parentalGate(.submitAnswer(value)))","                        }","                        answer = \"\"","                    }","                }","            }","        }","        .padding()","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"When the user submits a wrong answer, the plugin increments "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":" and regenerates the challenge automatically, so the sheet just re-renders with the new operands."}],"type":"paragraph"},{"anchor":"Reasons-that-should-be-passed-once-vs-always-re-challenged","level":2,"type":"heading","text":"Reasons that should be passed once vs. always re-challenged"},{"inlineContent":[{"type":"text","text":"The auto-pass behavior of "},{"code":"ParentalGateAction.request(reason:)","type":"codeVoice"},{"type":"text","text":" (see "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","type":"reference"},{"type":"text","text":") is a design choice: once a reason is in "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":", future "},{"code":".request","type":"codeVoice"},{"type":"text","text":" calls for it short-circuit. That’s the right default for low-stakes gates inside a single session — the user shouldn’t solve the same problem every time they tap the same button."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For higher-stakes gates that should always re-challenge, use a fresh reason key each time:"}],"type":"paragraph"},{"code":["store.send(.parentalGate(.request(reason: \"purchase-\\(UUID().uuidString)\")))"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Or, more usefully, clear the relevant entries from "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" at meaningful boundaries — app launch, session timeout, or returning from background. Mutate the set directly from your own reducer:"}],"type":"paragraph"},{"code":["case .app(.didEnterBackground):","    state.parentalGate.passedReasons.removeAll()","    return nil"],"syntax":"swift","type":"codeListing"},{"anchor":"Testing","level":2,"type":"heading","text":"Testing"},{"inlineContent":[{"type":"text","text":"For deterministic tests, swap the standard generator for "},{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["@MainActor","@Test func correctAnswerAcceptsAndPasses() async throws {","    let challenge = MathChallenge(left: 2, right: 3, op: .plus)  \/\/ expected = 5","    let plugin = ParentalGatePlugin<AppState, AppAction>(","        state: \\.parentalGate,","        action: AppAction.parentalGate,","        extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","        challengeSource: .fixed(challenge)","    )","","    var state = AppState()","    state.parentalGate.pendingReason = \"settings\"","    state.parentalGate.challenge = challenge","","    let effect = plugin.reduce(state: &state, action: .parentalGate(.submitAnswer(5)))","    let effect = try #require(effect)","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .parentalGate(.answerAccepted(let reason)) = dispatched.first {","        #expect(reason == \"settings\")","    } else {","        Issue.record(\"expected answerAccepted, got \\(dispatched)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGateTests"},{"text":" target in this package uses the same pattern — a fixed challenge plus a small test root state — and is a good reference when wiring tests for your own gated features.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://Swidux/documentation/Swidux/AgentSkill":{"url":"\/documentation\/swidux\/agentskill","kind":"article","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"title":"Using the Swidux Agent Skill","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"title":"Add Persistence","url":"\/documentation\/swidux\/howtoaddpersistence","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"kind":"article","type":"topic"},"doc://Swidux/documentation/Swidux":{"role":"collection","url":