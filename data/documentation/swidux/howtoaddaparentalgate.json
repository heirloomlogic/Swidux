{"variants":[{"paths":["\/documentation\/swidux\/howtoaddaparentalgate"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"metadata":{"title":"Add a Parental Gate","roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article"},"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"When you finish, your app will:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Hold a "},{"code":"ParentalGateState","type":"codeVoice"},{"type":"text","text":" slice in "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":" and a "},{"code":"parentalGate","type":"codeVoice"},{"type":"text","text":" action case in "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Run ","type":"text"},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":" as part of the store’s plugin host."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Present a math-challenge sheet whenever a feature requests a gate, and resume the original action once the user solves it.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"For the API surface, see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},{"text":". For how domain plugins fit into the dispatch lifecycle, see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}]},{"text":"Before you start","anchor":"Before-you-start","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"This guide assumes you already have a Swidux app wired with ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":", an ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory. If you don’t, start with the getting-started material and come back here.","type":"text"}]},{"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The parental-gate plugin ships as a separate library product. Add it to your target’s dependencies:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Package.swift",".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxParentalGate\", package: \"Swidux\"),","    ]",")"]},{"text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Nest a ","type":"text"},{"code":"ParentalGateState","type":"codeVoice"},{"text":" slice on your root state, and add an action case that wraps ","type":"text"},{"code":"ParentalGateAction","type":"codeVoice"},{"type":"text","text":"."}]},{"code":["\/\/ AppState.swift","import SwiduxParentalGate","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var parentalGate: ParentalGateState = .init()","    \/\/ … other slices","}","","\/\/ AppAction.swift","enum AppAction: Sendable {","    case parentalGate(ParentalGateAction)","    \/\/ … other cases","}"],"syntax":"swift","type":"codeListing"},{"name":"Tip","type":"aside","style":"tip","content":[{"inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"import SwiduxParentalGate"},{"text":" is needed in ","type":"text"},{"inlineContent":[{"type":"text","text":"every"}],"type":"emphasis"},{"text":" file that touches ","type":"text"},{"type":"codeVoice","code":"store.parentalGate.*"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"ParentalGateAction"},{"text":" — including views that read the slice for display. ","type":"text"},{"type":"codeVoice","code":"@_exported import Swidux"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"The plugin owns the parental-gate slice end-to-end, so the root reducer just falls through:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ AppReducer.swift","case .parentalGate:","    return nil"]},{"anchor":"Step-3-Wire-the-plugin","text":"Step 3: Wire the plugin","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Construct ","type":"text"},{"code":"ParentalGatePlugin","type":"codeVoice"},{"text":" inside ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" and register it with the plugin host. Use ","type":"text"},{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"text":" for production:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ AppStore.swift","let parentalGatePlugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: .standard",")","","let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","plugins.register(parentalGatePlugin)"]},{"inlineContent":[{"text":"Domain plugins use only the ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" hook, so registration order relative to other domain plugins rarely matters.","type":"text"}],"type":"paragraph"},{"anchor":"Step-4-Gate-an-action","text":"Step 4: Gate an action","type":"heading","level":2},{"inlineContent":[{"text":"Pick a stable reason key per gated action (for example ","type":"text"},{"type":"codeVoice","code":"\"purchase\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"settings\""},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"exit-kid-mode\""},{"text":"). In a view or feature reducer, check ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":" before performing the work:","type":"text"}],"type":"paragraph"},{"code":["Button(\"Buy gems\") {","    if store.parentalGate.passedReasons.contains(\"purchase\") {","        store.send(.shop(.buyGems))","    } else {","        store.send(.parentalGate(.request(reason: \"purchase\")))","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"To resume the original action automatically once the user solves the challenge, listen for ","type":"text"},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"text":" in the relevant feature reducer and re-dispatch:","type":"text"}],"type":"paragraph"},{"code":["\/\/ ShopReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .parentalGate(.answerAccepted(let reason)) where reason == \"purchase\":","        return { send in await send(.shop(.buyGems)) }","    \/\/ …","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This pattern keeps the gate logic local to the feature it protects: the gate just emits ","type":"text"},{"type":"codeVoice","code":"answerAccepted"},{"text":", and each feature decides what — if anything — to resume.","type":"text"}],"type":"paragraph"},{"anchor":"Step-5-Present-the-challenge-sheet","text":"Step 5: Present the challenge sheet","type":"heading","level":2},{"inlineContent":[{"text":"Drive sheet presentation off ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":". Bind text input to a local ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" for the typed answer, dispatch ","type":"text"},{"type":"codeVoice","code":"ParentalGateAction.submitAnswer(_:)"},{"text":" on confirm, and ","type":"text"},{"type":"codeVoice","code":"ParentalGateAction.regenerateChallenge"},{"text":" for a “new question” button.","type":"text"}],"type":"paragraph"},{"code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        \/\/ … your app UI","            .sheet(isPresented: Binding(","                get: { store.parentalGate.pendingReason != nil },","                set: { if !$0 { store.send(.parentalGate(.dismiss)) } }","            )) {","                ParentalGateSheet()","            }","    }","}","","struct ParentalGateSheet: View {","    @Environment(AppStore.self) private var store","    @State private var answer: String = \"\"","","    var body: some View {","        VStack(spacing: 16) {","            if let challenge = store.parentalGate.challenge {","                Text(\"\\(challenge.left) \\(challenge.op.symbol) \\(challenge.right) = ?\")","                    .font(.title)","","                TextField(\"Answer\", text: $answer)","                    .keyboardType(.numberPad)","","                HStack {","                    Button(\"New question\") {","                        store.send(.parentalGate(.regenerateChallenge))","                        answer = \"\"","                    }","                    Button(\"Submit\") {","                        if let value = Int(answer) {","                            store.send(.parentalGate(.submitAnswer(value)))","                        }","                        answer = \"\"","                    }","                }","            }","        }","        .padding()","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When the user submits a wrong answer, the plugin increments ","type":"text"},{"type":"codeVoice","code":"attempts"},{"text":" and regenerates the challenge automatically, so the sheet just re-renders with the new operands.","type":"text"}],"type":"paragraph"},{"anchor":"Reasons-that-should-be-passed-once-vs-always-re-challenged","text":"Reasons that should be passed once vs. always re-challenged","type":"heading","level":2},{"inlineContent":[{"text":"The auto-pass behavior of ","type":"text"},{"type":"codeVoice","code":"ParentalGateAction.request(reason:)"},{"text":" (see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},{"text":") is a design choice: once a reason is in ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":", future ","type":"text"},{"type":"codeVoice","code":".request"},{"text":" calls for it short-circuit. That’s the right default for low-stakes gates inside a single session — the user shouldn’t solve the same problem every time they tap the same button.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For higher-stakes gates that should always re-challenge, use a fresh reason key each time:","type":"text"}],"type":"paragraph"},{"code":["store.send(.parentalGate(.request(reason: \"purchase-\\(UUID().uuidString)\")))"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Or, more usefully, clear the relevant entries from ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":" at meaningful boundaries — app launch, session timeout, or returning from background. Mutate the set directly from your own reducer:","type":"text"}],"type":"paragraph"},{"code":["case .app(.didEnterBackground):","    state.parentalGate.passedReasons.removeAll()","    return nil"],"syntax":"swift","type":"codeListing"},{"anchor":"Testing","text":"Testing","type":"heading","level":2},{"inlineContent":[{"text":"For deterministic tests, swap the standard generator for ","type":"text"},{"type":"codeVoice","code":"ParentalChallengeSource.fixed(_:)"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["@MainActor","@Test func correctAnswerAcceptsAndPasses() async throws {","    let challenge = MathChallenge(left: 2, right: 3, op: .plus)  \/\/ expected = 5","    let plugin = ParentalGatePlugin<AppState, AppAction>(","        state: \\.parentalGate,","        action: AppAction.parentalGate,","        extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","        challengeSource: .fixed(challenge)","    )","","    var state = AppState()","    state.parentalGate.pendingReason = \"settings\"","    state.parentalGate.challenge = challenge","","    let effect = plugin.reduce(state: &state, action: .parentalGate(.submitAnswer(5)))","    let effect = try #require(effect)","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .parentalGate(.answerAccepted(let reason)) = dispatched.first {","        #expect(reason == \"settings\")","    } else {","        Issue.record(\"expected answerAccepted, got \\(dispatched)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGateTests"},{"text":" target in this package uses the same pattern — a fixed challenge plus a small test root state — and is a good reference when wiring tests for your own gated features.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"generated":true,"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","references":{"doc://Swidux/documentation/Swidux/PluginArchitecture":{"url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic","kind":"article","title":"Plugin Architecture","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"url":"\/documentation\/swidux\/howtoaddicloudsync","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"topic","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"kind":"article","title":"Add iCloud Sync","role":"article"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","role":"collection","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"url":"\/documentation\/swidux\/howtoaddaversionkillswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","type":"topic","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"kind":"article","title":"Add a Version Killswitch","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"url":"\/documentation\/swidux\/howtoaddanalytics","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"kind":"article","title":"Add Analytics","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"url":"\/documentation\/swidux\/howtoaddfeatureflags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"kind":"article","title":"Add Feature Flags","role":"article"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"url":"\/documentation\/swidux\/buildingadomainplugin","type":"topic","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","title":"Building a Domain Plugin","role":"article","kind":"article"},"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","url":"\/documentation\/swidux\/agentskill","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","abstract":[{"text":"Install the bundled ","type":"text"},{"type":"codeVoice","code":"swidux-ref"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"kind":"article","title":"Using the Swidux Agent Skill","role":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"title":"SwiduxParentalGate Reference","type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","kind":"article","url":"\/documentation\/swidux\/pluginparentalgatereference"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" plugin and the ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" macro — no hand-written ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":" classes, database actors, or ","type":"text"},{"type":"codeVoice","code":"StateWriter"},{"text":" closures.","type":"text"}],"title":"Add Persistence","role":"article","url":"\/documentation\/swidux\/howtoaddpersistence","kind":"article","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"url":"\/documentation\/swidux\/howtoaddapaywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"kind":"article","title":"Add a Paywall","role":"article"}}}