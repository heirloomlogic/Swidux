lGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}]},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"kind":"article","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic","title":"Add a Paywall"},"doc://Swidux/documentation/Swidux/SecurityPosture":{"title":"Security Posture","url":"\/documentation\/swidux\/securityposture","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","abstract":[{"type":"text","text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one."}],"role":"collectionGroup","type":"topic"}}}