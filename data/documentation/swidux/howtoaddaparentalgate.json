{"abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddaparentalgate"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you finish, your app will:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Hold a "},{"type":"codeVoice","code":"ParentalGateState"},{"type":"text","text":" slice in "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"parentalGate"},{"type":"text","text":" action case in "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Run ","type":"text"},{"type":"codeVoice","code":"ParentalGatePlugin"},{"text":" as part of the store’s plugin host.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Present a math-challenge sheet whenever a feature requests a gate, and resume the original action once the user solves it."}]}]}]},{"inlineContent":[{"text":"For the API surface, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","isActive":true,"type":"reference"},{"text":". For how domain plugins fit into the dispatch lifecycle, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Before you start","anchor":"Before-you-start","type":"heading","level":2},{"inlineContent":[{"text":"This guide assumes you already have a Swidux app wired with ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", an ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and a ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory. If you don’t, start with the getting-started material and come back here.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Step 1: Add the dependency","type":"heading","anchor":"Step-1-Add-the-dependency"},{"inlineContent":[{"text":"The parental-gate plugin ships as a separate library product. Add it to your target’s dependencies:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Package.swift",".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxParentalGate\", package: \"Swidux\"),","    ]",")"]},{"level":2,"text":"Step 2: Add state and actions","type":"heading","anchor":"Step-2-Add-state-and-actions"},{"inlineContent":[{"type":"text","text":"Nest a "},{"type":"codeVoice","code":"ParentalGateState"},{"type":"text","text":" slice on your root state, and add an action case that wraps "},{"type":"codeVoice","code":"ParentalGateAction"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ AppState.swift","import SwiduxParentalGate","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var parentalGate: ParentalGateState = .init()","    \/\/ … other slices","}","","\/\/ AppAction.swift","enum AppAction: Sendable {","    case parentalGate(ParentalGateAction)","    \/\/ … other cases","}"]},{"name":"Tip","type":"aside","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxParentalGate"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"text":"every","type":"text"}]},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.parentalGate.*"},{"type":"text","text":" or "},{"type":"codeVoice","code":"ParentalGateAction"},{"type":"text","text":" — including views that read the slice for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]}]},{"inlineContent":[{"text":"The plugin owns the parental-gate slice end-to-end, so the root reducer just falls through:","type":"text"}],"type":"paragraph"},{"code":["\/\/ AppReducer.swift","case .parentalGate:","    return nil"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-3-Wire-the-plugin","level":2,"text":"Step 3: Wire the plugin","type":"heading"},{"inlineContent":[{"type":"text","text":"Construct "},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":" inside "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" and register it with the plugin host. Use "},{"type":"codeVoice","code":"ParentalChallengeSource.standard"},{"type":"text","text":" for production:"}],"type":"paragraph"},{"code":["\/\/ AppStore.swift","let parentalGatePlugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: .standard",")","","let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","plugins.register(parentalGatePlugin)"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Domain plugins use only the ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" hook, so registration order relative to other domain plugins rarely matters.","type":"text"}],"type":"paragraph"},{"anchor":"Step-4-Gate-an-action","level":2,"text":"Step 4: Gate an action","type":"heading"},{"inlineContent":[{"type":"text","text":"Pick a stable reason key per gated action (for example "},{"type":"codeVoice","code":"\"purchase\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"settings\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"exit-kid-mode\""},{"type":"text","text":"). In a view or feature reducer, check "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" before performing the work:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Button(\"Buy gems\") {","    if store.parentalGate.passedReasons.contains(\"purchase\") {","        store.send(.shop(.buyGems))","    } else {","        store.send(.parentalGate(.request(reason: \"purchase\")))","    }","}"]},{"inlineContent":[{"text":"To resume the original action automatically once the user solves the challenge, listen for ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" in the relevant feature reducer and re-dispatch:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ ShopReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .parentalGate(.answerAccepted(let reason)) where reason == \"purchase\":","        return { send in await send(.shop(.buyGems)) }","    \/\/ …","    }","}"]},{"inlineContent":[{"type":"text","text":"This pattern keeps the gate logic local to the feature it protects: the gate just emits "},{"code":"answerAccepted","type":"codeVoice"},{"type":"text","text":", and each feature decides what — if anything — to resume."}],"type":"paragraph"},{"level":2,"anchor":"Step-5-Present-the-challenge-sheet","text":"Step 5: Present the challenge sheet","type":"heading"},{"inlineContent":[{"type":"text","text":"Drive sheet presentation off "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":". Bind text input to a local "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" for the typed answer, dispatch "},{"type":"codeVoice","code":"ParentalGateAction.submitAnswer(_:)"},{"type":"text","text":" on confirm, and "},{"type":"codeVoice","code":"ParentalGateAction.regenerateChallenge"},{"type":"text","text":" for a “new question” button."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        \/\/ … your app UI","            .sheet(isPresented: Binding(","                get: { store.parentalGate.pendingReason != nil },","                set: { if !$0 { store.send(.parentalGate(.dismiss)) } }","            )) {","                ParentalGateSheet()","            }","    }","}","","struct ParentalGateSheet: View {","    @Environment(AppStore.self) private var store","    @State private var answer: String = \"\"","","    var body: some View {","        VStack(spacing: 16) {","            if let challenge = store.parentalGate.challenge {","                Text(\"\\(challenge.left) \\(challenge.op.symbol) \\(challenge.right) = ?\")","                    .font(.title)","","                TextField(\"Answer\", text: $answer)","                    .keyboardType(.numberPad)","","                HStack {","                    Button(\"New question\") {","                        store.send(.parentalGate(.regenerateChallenge))","                        answer = \"\"","                    }","                    Button(\"Submit\") {","                        if let value = Int(answer) {","                            store.send(.parentalGate(.submitAnswer(value)))","                        }","                        answer = \"\"","                    }","                }","            }","        }","        .padding()","    }","}"]},{"inlineContent":[{"type":"text","text":"When the user submits a wrong answer, the plugin increments "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates the challenge automatically, so the sheet just re-renders with the new operands."}],"type":"paragraph"},{"level":2,"anchor":"Reasons-that-should-be-passed-once-vs-always-re-challenged","text":"Reasons that should be passed once vs. always re-challenged","type":"heading"},{"inlineContent":[{"text":"The auto-pass behavior of ","type":"text"},{"code":"ParentalGateAction.request(reason:)","type":"codeVoice"},{"type":"text","text":" (see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","isActive":true},{"type":"text","text":") is a design choice: once a reason is in "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", future "},{"type":"codeVoice","code":".request"},{"type":"text","text":" calls for it short-circuit. That’s the right default for low-stakes gates inside a single session — the user shouldn’t solve the same problem every time they tap the same button."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For higher-stakes gates that should always re-challenge, use a fresh reason key each time:"}]},{"type":"codeListing","syntax":"swift","code":["store.send(.parentalGate(.request(reason: \"purchase-\\(UUID().uuidString)\")))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or, more usefully, clear the relevant entries from "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" at meaningful boundaries — app launch, session timeout, or returning from background. Mutate the set directly from your own reducer:"}]},{"type":"codeListing","syntax":"swift","code":["case .app(.didEnterBackground):","    state.parentalGate.passedReasons.removeAll()","    return nil"]},{"level":2,"type":"heading","text":"Testing","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"For deterministic tests, swap the standard generator for ","type":"text"},{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","@Test func correctAnswerAcceptsAndPasses() async throws {","    let challenge = MathChallenge(left: 2, right: 3, op: .plus)  \/\/ expected = 5","    let plugin = ParentalGatePlugin<AppState, AppAction>(","        state: \\.parentalGate,","        action: AppAction.parentalGate,","        extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","        challengeSource: .fixed(challenge)","    )","","    var state = AppState()","    state.parentalGate.pendingReason = \"settings\"","    state.parentalGate.challenge = challenge","","    let effect = plugin.reduce(state: &state, action: .parentalGate(.submitAnswer(5)))","    let effect = try #require(effect)","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .parentalGate(.answerAccepted(let reason)) = dispatched.first {","        #expect(reason == \"settings\")","    } else {","        Issue.record(\"expected answerAccepted, got \\(dispatched)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGateTests"},{"text":" target in this package uses the same pattern — a fixed challenge plus a small test root state — and is a good reference when wiring tests for your own gated features.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"Add a Parental Gate"},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"title":"How-to Guides","generated":true,"anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify.","type":"text"}],"title":"Add Analytics","url":"\/documentation\/swidux\/howtoaddanalytics","type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"url":"\/documentation\/swidux\/pluginparentalgatereference","abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"role":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","kind":"article","title":"SwiduxParentalGate Reference"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"url":"\/documentation\/swidux\/buildingadomainplugin","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","title":"Building a Domain Plugin"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"kind":"article","role":"article","url":"\/documentation\/swidux\/pluginarchitecture","title":"Plugin Architecture","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},"doc://Swidux/documentation/Swidux":{"abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux","title":"Swidux","url":"\/documentation\/swidux","type":"topic","kind":"symbol","role":"collection"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"kind":"article","role":"article","url":"\/documentation\/swidux\/howtoaddicloudsync","title":"Add iCloud Sync","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","title":"Add Feature Flags"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"url":"\/documentation\/swidux\/howtoaddpersistence","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"role":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","kind":"article","title":"Add Persistence"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"kind":"article","type":"topic","title":"Add a Version Killswitch","abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"role":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","kind":"article","title":"Add a Paywall"},"doc://Swidux/documentation/Swidux/AgentSkill":{"abstract":[{"text":"Install the bundled ","type":"text"},{"code":"swidux-ref","type":"codeVoice"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","type":"topic","url":"\/documentation\/swidux\/agentskill","title":"Using the Swidux Agent Skill","kind":"article","role":"article"}}}