{"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"When you finish, your app will:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Hold a ","type":"text"},{"code":"ParentalGateState","type":"codeVoice"},{"text":" slice in ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" and a ","type":"text"},{"code":"parentalGate","type":"codeVoice"},{"text":" action case in ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Run ","type":"text"},{"code":"ParentalGatePlugin","type":"codeVoice"},{"text":" as part of the store’s plugin host.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Present a math-challenge sheet whenever a feature requests a gate, and resume the original action once the user solves it.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For the API surface, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","isActive":true},{"type":"text","text":". For how domain plugins fit into the dispatch lifecycle, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Before you start","level":2,"type":"heading","anchor":"Before-you-start"},{"inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired with "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and a "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory. If you don’t, start with the getting-started material and come back here."}],"type":"paragraph"},{"text":"Step 1: Add the dependency","level":2,"type":"heading","anchor":"Step-1-Add-the-dependency"},{"inlineContent":[{"type":"text","text":"The parental-gate plugin ships as a separate library product. Add it to your target’s dependencies:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Package.swift",".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxParentalGate\", package: \"Swidux\"),","    ]",")"],"type":"codeListing"},{"text":"Step 2: Add state and actions","level":2,"type":"heading","anchor":"Step-2-Add-state-and-actions"},{"inlineContent":[{"type":"text","text":"Nest a "},{"type":"codeVoice","code":"ParentalGateState"},{"type":"text","text":" slice on your root state, and add an action case that wraps "},{"type":"codeVoice","code":"ParentalGateAction"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ AppState.swift","import SwiduxParentalGate","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var parentalGate: ParentalGateState = .init()","    \/\/ … other slices","}","","\/\/ AppAction.swift","enum AppAction: Sendable {","    case parentalGate(ParentalGateAction)","    \/\/ … other cases","}"],"type":"codeListing"},{"style":"tip","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"import SwiduxParentalGate","type":"codeVoice"},{"text":" is needed in ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"every","type":"text"}]},{"text":" file that touches ","type":"text"},{"code":"store.parentalGate.*","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"ParentalGateAction","type":"codeVoice"},{"text":" — including views that read the slice for display. ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"text":".","type":"text"}]}],"type":"aside","name":"Tip"},{"inlineContent":[{"type":"text","text":"The plugin owns the parental-gate slice end-to-end, so the root reducer just falls through:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ AppReducer.swift","case .parentalGate:","    return nil"],"type":"codeListing"},{"text":"Step 3: Wire the plugin","level":2,"type":"heading","anchor":"Step-3-Wire-the-plugin"},{"inlineContent":[{"text":"Construct ","type":"text"},{"type":"codeVoice","code":"ParentalGatePlugin"},{"text":" inside ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" and register it with the plugin host. Use ","type":"text"},{"type":"codeVoice","code":"ParentalChallengeSource.standard"},{"text":" for production:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ AppStore.swift","let parentalGatePlugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: .standard",")","","let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","plugins.register(parentalGatePlugin)"]},{"inlineContent":[{"type":"text","text":"Domain plugins use only the "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" hook, so registration order relative to other domain plugins rarely matters."}],"type":"paragraph"},{"text":"Step 4: Gate an action","type":"heading","anchor":"Step-4-Gate-an-action","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pick a stable reason key per gated action (for example "},{"code":"\"purchase\"","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"\"settings\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"exit-kid-mode\""},{"type":"text","text":"). In a view or feature reducer, check "},{"type":"codeVoice","code":"passedReasons"},{"text":" before performing the work:","type":"text"}]},{"type":"codeListing","code":["Button(\"Buy gems\") {","    if store.parentalGate.passedReasons.contains(\"purchase\") {","        store.send(.shop(.buyGems))","    } else {","        store.send(.parentalGate(.request(reason: \"purchase\")))","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"To resume the original action automatically once the user solves the challenge, listen for ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" in the relevant feature reducer and re-dispatch:","type":"text"}]},{"type":"codeListing","code":["\/\/ ShopReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .parentalGate(.answerAccepted(let reason)) where reason == \"purchase\":","        return { send in await send(.shop(.buyGems)) }","    \/\/ …","    }","}"],"syntax":"swift"},{"inlineContent":[{"text":"This pattern keeps the gate logic local to the feature it protects: the gate just emits ","type":"text"},{"code":"answerAccepted","type":"codeVoice"},{"text":", and each feature decides what — if anything — to resume.","type":"text"}],"type":"paragraph"},{"text":"Step 5: Present the challenge sheet","type":"heading","anchor":"Step-5-Present-the-challenge-sheet","level":2},{"inlineContent":[{"text":"Drive sheet presentation off ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":". Bind text input to a local ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" for the typed answer, dispatch ","type":"text"},{"code":"ParentalGateAction.submitAnswer(_:)","type":"codeVoice"},{"text":" on confirm, and ","type":"text"},{"type":"codeVoice","code":"ParentalGateAction.regenerateChallenge"},{"text":" for a “new question” button.","type":"text"}],"type":"paragraph"},{"code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        \/\/ … your app UI","            .sheet(isPresented: Binding(","                get: { store.parentalGate.pendingReason != nil },","                set: { if !$0 { store.send(.parentalGate(.dismiss)) } }","            )) {","                ParentalGateSheet()","            }","    }","}","","struct ParentalGateSheet: View {","    @Environment(AppStore.self) private var store","    @State private var answer: String = \"\"","","    var body: some View {","        VStack(spacing: 16) {","            if let challenge = store.parentalGate.challenge {","                Text(\"\\(challenge.left) \\(challenge.op.symbol) \\(challenge.right) = ?\")","                    .font(.title)","","                TextField(\"Answer\", text: $answer)","                    .keyboardType(.numberPad)","","                HStack {","                    Button(\"New question\") {","                        store.send(.parentalGate(.regenerateChallenge))","                        answer = \"\"","                    }","                    Button(\"Submit\") {","                        if let value = Int(answer) {","                            store.send(.parentalGate(.submitAnswer(value)))","                        }","                        answer = \"\"","                    }","                }","            }","        }","        .padding()","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"When the user submits a wrong answer, the plugin increments ","type":"text"},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates the challenge automatically, so the sheet just re-renders with the new operands."}],"type":"paragraph"},{"anchor":"Reasons-that-should-be-passed-once-vs-always-re-challenged","text":"Reasons that should be passed once vs. always re-challenged","type":"heading","level":2},{"inlineContent":[{"text":"The auto-pass behavior of ","type":"text"},{"code":"ParentalGateAction.request(reason:)","type":"codeVoice"},{"text":" (see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","isActive":true},{"text":") is a design choice: once a reason is in ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", future ","type":"text"},{"type":"codeVoice","code":".request"},{"type":"text","text":" calls for it short-circuit. That’s the right default for low-stakes gates inside a single session — the user shouldn’t solve the same problem every time they tap the same button."}],"type":"paragraph"},{"inlineContent":[{"text":"For higher-stakes gates that should always re-challenge, use a fresh reason key each time:","type":"text"}],"type":"paragraph"},{"code":["store.send(.parentalGate(.request(reason: \"purchase-\\(UUID().uuidString)\")))"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"Or, more usefully, clear the relevant entries from ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":" at meaningful boundaries — app launch, session timeout, or returning from background. Mutate the set directly from your own reducer:","type":"text"}],"type":"paragraph"},{"code":["case .app(.didEnterBackground):","    state.parentalGate.passedReasons.removeAll()","    return nil"],"type":"codeListing","syntax":"swift"},{"anchor":"Testing","text":"Testing","type":"heading","level":2},{"inlineContent":[{"text":"For deterministic tests, swap the standard generator for ","type":"text"},{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["@MainActor","@Test func correctAnswerAcceptsAndPasses() async throws {","    let challenge = MathChallenge(left: 2, right: 3, op: .plus)  \/\/ expected = 5","    let plugin = ParentalGatePlugin<AppState, AppAction>(","        state: \\.parentalGate,","        action: AppAction.parentalGate,","        extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","        challengeSource: .fixed(challenge)","    )","","    var state = AppState()","    state.parentalGate.pendingReason = \"settings\"","    state.parentalGate.challenge = challenge","","    let effect = plugin.reduce(state: &state, action: .parentalGate(.submitAnswer(5)))","    let effect = try #require(effect)","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .parentalGate(.answerAccepted(let reason)) = dispatched.first {","        #expect(reason == \"settings\")","    } else {","        Issue.record(\"expected answerAccepted, got \\(dispatched)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"SwiduxParentalGateTests","type":"codeVoice"},{"text":" target in this package uses the same pattern — a fixed challenge plus a small test root state — and is a good reference when wiring tests for your own gated features.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/swidux\/howtoaddaparentalgate"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Swidux"}],"title":"Add a Parental Gate"},"kind":"article","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"anchor":"How-to-Guides","title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true}],"references":{"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","url":"\/documentation\/swidux\/pluginparentalgatereference","abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"title":"SwiduxParentalGate Reference"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"title":"Add a Paywall"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"url":"\/documentation\/swidux\/howtoaddanalytics","title":"Add Analytics","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"url":"\/documentation\/swidux\/howtoaddpersistence","title":"Add Persistence","role":"article","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","url":"\/documentation\/swidux\/howtoaddicloudsync","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":" with the "},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"title":"Add iCloud Sync"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"title":"Plugin Architecture","kind":"article","type":"topic","url":"\/documentation\/swidux\/pluginarchitecture","role":"article","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},"doc://Swidux/documentation/Swidux/AgentSkill":{"kind":"article","role":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"url":"\/documentation\/swidux\/agentskill","title":"Using the Swidux Agent Skill"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"url":"\/documentation\/swidux\/howtoaddfeatureflags","title":"Add Feature Flags","kind":"article","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config.","type":"text"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","role":"article"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"title":"Building a Domain Plugin","kind":"article","type":"topic","url":"\/documentation\/swidux\/buildingadomainplugin","role":"article","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin"},"doc://Swidux/documentation/Swidux/SecurityPosture":{"title":"Security Posture","type":"topic","url":"\/documentation\/swidux\/securityposture","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","role":"collectionGroup","abstract":[{"type":"text","text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one."}]},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"kind":"article","role":"article","type":"topic","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","url":"\/documentation\/swidux\/howtocanceleffects","title":"Cancel Effects"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"title":"Add a Version Killswitch"},"doc://Swidux/documentation/Swidux":{"kind":"symbol","role":"collection","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","url":"\/documentation\/swidux"}}}