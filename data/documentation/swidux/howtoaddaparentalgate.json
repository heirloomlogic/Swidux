{"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"When you finish, your app will:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Hold a "},{"type":"codeVoice","code":"ParentalGateState"},{"type":"text","text":" slice in "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"parentalGate"},{"type":"text","text":" action case in "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Run "},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":" as part of the store’s plugin host."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Present a math-challenge sheet whenever a feature requests a gate, and resume the original action once the user solves it."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"For the API surface, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","isActive":true},{"type":"text","text":". For how domain plugins fit into the dispatch lifecycle, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Before-you-start","text":"Before you start","type":"heading"},{"inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired with "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and a "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory. If you don’t, start with the getting-started material and come back here."}],"type":"paragraph"},{"level":2,"anchor":"Step-1-Add-the-dependency","text":"Step 1: Add the dependency","type":"heading"},{"inlineContent":[{"type":"text","text":"The parental-gate plugin ships as a separate library product. Add it to your target’s dependencies:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Package.swift",".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxParentalGate\", package: \"Swidux\"),","    ]",")"]},{"level":2,"anchor":"Step-2-Add-state-and-actions","text":"Step 2: Add state and actions","type":"heading"},{"inlineContent":[{"type":"text","text":"Nest a "},{"type":"codeVoice","code":"ParentalGateState"},{"type":"text","text":" slice on your root state, and add an action case that wraps "},{"type":"codeVoice","code":"ParentalGateAction"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ AppState.swift","import SwiduxParentalGate","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var parentalGate: ParentalGateState = .init()","    \/\/ … other slices","}","","\/\/ AppAction.swift","enum AppAction: Sendable {","    case parentalGate(ParentalGateAction)","    \/\/ … other cases","}"]},{"style":"tip","name":"Tip","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxParentalGate"},{"type":"text","text":" is needed in "},{"inlineContent":[{"type":"text","text":"every"}],"type":"emphasis"},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.parentalGate.*"},{"type":"text","text":" or "},{"type":"codeVoice","code":"ParentalGateAction"},{"type":"text","text":" — including views that read the slice for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"type":"text","text":"."}]}]},{"inlineContent":[{"type":"text","text":"The plugin owns the parental-gate slice end-to-end, so the root reducer just falls through:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ AppReducer.swift","case .parentalGate:","    return nil"]},{"level":2,"anchor":"Step-3-Wire-the-plugin","text":"Step 3: Wire the plugin","type":"heading"},{"inlineContent":[{"type":"text","text":"Construct "},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":" inside "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" and register it with the plugin host. Use "},{"type":"codeVoice","code":"ParentalChallengeSource.standard"},{"type":"text","text":" for production:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ AppStore.swift","let parentalGatePlugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: .standard",")","","let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","plugins.register(parentalGatePlugin)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Domain plugins use only the "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" hook, so registration order relative to other domain plugins rarely matters."}]},{"type":"heading","level":2,"text":"Step 4: Gate an action","anchor":"Step-4-Gate-an-action"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pick a stable reason key per gated action (for example "},{"code":"\"purchase\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"settings\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"exit-kid-mode\"","type":"codeVoice"},{"text":"). In a view or feature reducer, check ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":" before performing the work:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["Button(\"Buy gems\") {","    if store.parentalGate.passedReasons.contains(\"purchase\") {","        store.send(.shop(.buyGems))","    } else {","        store.send(.parentalGate(.request(reason: \"purchase\")))","    }","}"]},{"inlineContent":[{"type":"text","text":"To resume the original action automatically once the user solves the challenge, listen for "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" in the relevant feature reducer and re-dispatch:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ ShopReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .parentalGate(.answerAccepted(let reason)) where reason == \"purchase\":","        return { send in await send(.shop(.buyGems)) }","    \/\/ …","    }","}"]},{"inlineContent":[{"type":"text","text":"This pattern keeps the gate logic local to the feature it protects: the gate just emits "},{"type":"codeVoice","code":"answerAccepted"},{"type":"text","text":", and each feature decides what — if anything — to resume."}],"type":"paragraph"},{"anchor":"Step-5-Present-the-challenge-sheet","text":"Step 5: Present the challenge sheet","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Drive sheet presentation off "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":". Bind text input to a local "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" for the typed answer, dispatch "},{"type":"codeVoice","code":"ParentalGateAction.submitAnswer(_:)"},{"type":"text","text":" on confirm, and "},{"type":"codeVoice","code":"ParentalGateAction.regenerateChallenge"},{"type":"text","text":" for a “new question” button."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        \/\/ … your app UI","            .sheet(isPresented: Binding(","                get: { store.parentalGate.pendingReason != nil },","                set: { if !$0 { store.send(.parentalGate(.dismiss)) } }","            )) {","                ParentalGateSheet()","            }","    }","}","","struct ParentalGateSheet: View {","    @Environment(AppStore.self) private var store","    @State private var answer: String = \"\"","","    var body: some View {","        VStack(spacing: 16) {","            if let challenge = store.parentalGate.challenge {","                Text(\"\\(challenge.left) \\(challenge.op.symbol) \\(challenge.right) = ?\")","                    .font(.title)","","                TextField(\"Answer\", text: $answer)","                    .keyboardType(.numberPad)","","                HStack {","                    Button(\"New question\") {","                        store.send(.parentalGate(.regenerateChallenge))","                        answer = \"\"","                    }","                    Button(\"Submit\") {","                        if let value = Int(answer) {","                            store.send(.parentalGate(.submitAnswer(value)))","                        }","                        answer = \"\"","                    }","                }","            }","        }","        .padding()","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the user submits a wrong answer, the plugin increments "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates the challenge automatically, so the sheet just re-renders with the new operands."}]},{"type":"heading","level":2,"text":"Reasons that should be passed once vs. always re-challenged","anchor":"Reasons-that-should-be-passed-once-vs-always-re-challenged"},{"inlineContent":[{"type":"text","text":"The auto-pass behavior of "},{"type":"codeVoice","code":"ParentalGateAction.request(reason:)"},{"type":"text","text":" (see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","isActive":true},{"type":"text","text":") is a design choice: once a reason is in "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", future "},{"type":"codeVoice","code":".request"},{"type":"text","text":" calls for it short-circuit. That’s the right default for low-stakes gates inside a single session — the user shouldn’t solve the same problem every time they tap the same button."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For higher-stakes gates that should always re-challenge, use a fresh reason key each time:"}]},{"type":"codeListing","syntax":"swift","code":["store.send(.parentalGate(.request(reason: \"purchase-\\(UUID().uuidString)\")))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or, more usefully, clear the relevant entries from "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" at meaningful boundaries — app launch, session timeout, or returning from background. Mutate the set directly from your own reducer:"}]},{"type":"codeListing","syntax":"swift","code":["case .app(.didEnterBackground):","    state.parentalGate.passedReasons.removeAll()","    return nil"]},{"type":"heading","level":2,"text":"Testing","anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"For deterministic tests, swap the standard generator for ","type":"text"},{"type":"codeVoice","code":"ParentalChallengeSource.fixed(_:)"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","@Test func correctAnswerAcceptsAndPasses() async throws {","    let challenge = MathChallenge(left: 2, right: 3, op: .plus)  \/\/ expected = 5","    let plugin = ParentalGatePlugin<AppState, AppAction>(","        state: \\.parentalGate,","        action: AppAction.parentalGate,","        extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","        challengeSource: .fixed(challenge)","    )","","    var state = AppState()","    state.parentalGate.pendingReason = \"settings\"","    state.parentalGate.challenge = challenge","","    let effect = plugin.reduce(state: &state, action: .parentalGate(.submitAnswer(5)))","    let effect = try #require(effect)","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .parentalGate(.answerAccepted(let reason)) = dispatched.first {","        #expect(reason == \"settings\")","    } else {","        Issue.record(\"expected answerAccepted, got \\(dispatched)\")","    }","}"]},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SwiduxParentalGateTests"},{"type":"text","text":" target in this package uses the same pattern — a fixed challenge plus a small test root state — and is a good reference when wiring tests for your own gated features."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","title":"Add a Parental Gate","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"anchor":"How-to-Guides","generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"title":"How-to Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddaparentalgate"]}],"abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"kind":"article","references":{"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"title":"Add a Version Killswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","type":"topic","role":"article","abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"kind":"article"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"title":"Cancel Effects","url":"\/documentation\/swidux\/howtocanceleffects","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","type":"topic","role":"article","abstract":[{"text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code.","type":"text"}],"kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"title":"Add a Paywall","url":"\/documentation\/swidux\/howtoaddapaywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"topic","role":"article","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"title":"Add Persistence","url":"\/documentation\/swidux\/howtoaddpersistence","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","type":"topic","role":"article","abstract":[{"text":"Persist your domain entities to SwiftData with the ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" plugin and the ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" macro — no hand-written ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" classes, database actors, or ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" closures.","type":"text"}],"kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"title":"Add iCloud Sync","url":"\/documentation\/swidux\/howtoaddicloudsync","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"topic","role":"article","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"kind":"article"},"doc://Swidux/documentation/Swidux/AgentSkill":{"abstract":[{"text":"Install the bundled ","type":"text"},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"title":"Using the Swidux Agent Skill","role":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","url":"\/documentation\/swidux\/agentskill","kind":"article"},"doc://Swidux/documentation/Swidux":{"role":"collection","url":"\/documentation\/swidux","title":"Swidux","type":"topic","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"title":"Plugin Architecture","url":"\/documentation\/swidux\/pluginarchitecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic","role":"article","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"abstract":[{"text":"Wire the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify.","type":"text"}],"title":"Add Analytics","role":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","url":"\/documentation\/swidux\/howtoaddanalytics","kind":"article"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"title":"Building a Domain Plugin","url":"\/documentation\/swidux\/buildingadomainplugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","type":"topic","role":"article","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"kind":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"title":"SwiduxParentalGate Reference","role":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","url":"\/documentation\/swidux\/pluginparentalgatereference","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"title":"Add Feature Flags","role":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article"}}}