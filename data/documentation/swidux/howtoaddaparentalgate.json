ode":"ParentalGatePlugin","type":"codeVoice"},{"text":" as part of the store’s plugin host.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Present a math-challenge sheet whenever a feature requests a gate, and resume the original action once the user solves it.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"For the API surface, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},{"text":". For how domain plugins fit into the dispatch lifecycle, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}]},{"text":"Before you start","type":"heading","level":2,"anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes you already have a Swidux app wired with ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", an ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and a ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory. If you don’t, start with the getting-started material and come back here.","type":"text"}]},{"text":"Step 1: Add the dependency","type":"heading","level":2,"anchor":"Step-1-Add-the-dependency"},{"type":"paragraph","inlineContent":[{"text":"The parental-gate plugin ships as a separate library product. Add it to your target’s dependencies:","type":"text"}]},{"type":"codeListing","code":["\/\/ Package.swift",".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxParentalGate\", package: \"Swidux\"),","    ]",")"],"syntax":"swift"},{"text":"Step 2: Add state and actions","type":"heading","level":2,"anchor":"Step-2-Add-state-and-actions"},{"type":"paragraph","inlineContent":[{"text":"Nest a ","type":"text"},{"code":"ParentalGateState","type":"codeVoice"},{"text":" slice on your root state, and add an action case that wraps ","type":"text"},{"code":"ParentalGateAction","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","code":["\/\/ AppState.swift","import SwiduxParentalGate","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var parentalGate: ParentalGateState = .init()","    \/\/ … other slices","}","","\/\/ AppAction.swift","enum AppAction: Sendable {","    case parentalGate(ParentalGateAction)","    \/\/ … other cases","}"],"syntax":"swift"},{"content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxParentalGate"},{"type":"text","text":" is needed in "},{"type":"emphasis","inlineContent":[{"text":"every","type":"text"}]},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.parentalGate.*"},{"type":"text","text":" or "},{"type":"codeVoice","code":"ParentalGateAction"},{"type":"text","text":" — including views that read the slice for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","style":"tip","name":"Tip"},{"type":"paragraph","inlineContent":[{"text":"The plugin owns the parental-gate slice end-to-end, so the root reducer just falls through:","type":"text"}]},{"type":"codeListing","code":["\/\/ AppReducer.swift","case .parentalGate:","    return nil"],"syntax":"swift"},{"text":"Step 3: Wire the plugin","type":"heading","level":2,"anchor":"Step-3-Wire-the-plugin"},{"type":"paragraph","inlineContent":[{"text":"Construct ","type":"text"},{"code":"ParentalGatePlugin","type":"codeVoice"},{"text":" inside ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" and register it with the plugin host. Use ","type":"text"},{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"text":" for production:","type":"text"}]},{"type":"codeListing","code":["\/\/ AppStore.swift","let parentalGatePlugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: .standard",")","","let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","plugins.register(parentalGatePlugin)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Domain plugins use only the ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" hook, so registration order relative to other domain plugins rarely matters.","type":"text"}]},{"text":"Step 4: Gate an action","type":"heading","level":2,"anchor":"Step-4-Gate-an-action"},{"type":"paragraph","inlineContent":[{"text":"Pick a stable reason key per gated action (for example ","type":"text"},{"code":"\"purchase\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"settings\"","type":"codeVoice"},{"text":", ","type":"text"},{"code":"\"exit-kid-mode\"","type":"codeVoice"},{"text":"). In a view or feature reducer, check ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":" before performing the work:","type":"text"}]},{"type":"codeListing","code":["Button(\"Buy gems\") {","    if store.parentalGate.passedReasons.contains(\"purchase\") {","        store.send(.shop(.buyGems))","    } else {","        store.send(.parentalGate(.request(reason: \"purchase\")))","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"To resume the original action automatically once the user solves the challenge, listen for ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" in the relevant feature reducer and re-dispatch:","type":"text"}]},{"type":"codeListing","code":["\/\/ ShopReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .parentalGate(.answerAccepted(let reason)) where reason == \"purchase\":","        return { send in await send(.shop(.buyGems)) }","    \/\/ …","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"This pattern keeps the gate logic local to the feature it protects: the gate just emits ","type":"text"},{"code":"answerAccepted","type":"codeVoice"},{"text":", and each feature decides what — if anything — to resume.","type":"text"}]},{"text":"Step 5: Present the challenge sheet","type":"heading","level":2,"anchor":"Step-5-Present-the-challenge-sheet"},{"type":"paragraph","inlineContent":[{"text":"Drive sheet presentation off ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":". Bind text input to a local ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" for the typed answer, dispatch ","type":"text"},{"code":"ParentalGateAction.submitAnswer(_:)","type":"codeVoice"},{"text":" on confirm, and ","type":"text"},{"code":"ParentalGateAction.regenerateChallenge","type":"codeVoice"},{"text":" for a “new question” button.","type":"text"}]},{"type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        \/\/ … your app UI","            .sheet(isPresented: Binding(","                get: { store.parentalGate.pendingReason != nil },","                set: { if !$0 { store.send(.parentalGate(.dismiss)) } }","            )) {","                ParentalGateSheet()","            }","    }","}","","struct ParentalGateSheet: View {","    @Environment(AppStore.self) private var store","    @State private var answer: String = \"\"","","    var body: some View {","        VStack(spacing: 16) {","            if let challenge = store.parentalGate.challenge {","                Text(\"\\(challenge.left) \\(challenge.op.symbol) \\(challenge.right) = ?\")","                    .font(.title)","","                TextField(\"Answer\", text: $answer)","                    .keyboardType(.numberPad)","","                HStack {","                    Button(\"New question\") {","                        store.send(.parentalGate(.regenerateChallenge))","                        answer = \"\"","                    }","                    Button(\"Submit\") {","                        if let value = Int(answer) {","                            store.send(.parentalGate(.submitAnswer(value)))","                        }","                        answer = \"\"","                    }","                }","            }","        }","        .padding()","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"When the user submits a wrong answer, the plugin increments ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":" and regenerates the challenge automatically, so the sheet just re-renders with the new operands.","type":"text"}]},{"text":"Reasons that should be passed once vs. always re-challenged","type":"heading","level":2,"anchor":"Reasons-that-should-be-passed-once-vs-always-re-challenged"},{"type":"paragraph","inlineContent":[{"text":"The auto-pass behavior of ","type":"text"},{"code":"ParentalGateAction.request(reason:)","type":"codeVoice"},{"text":" (see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},{"text":") is a design choice: once a reason is in ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", future ","type":"text"},{"code":".request","type":"codeVoice"},{"text":" calls for it short-circuit. That’s the right default for low-stakes gates inside a single session — the user shouldn’t solve the same problem every time they tap the same button.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For higher-stakes gates that should always re-challenge, use a fresh reason key each time:","type":"text"}]},{"type":"codeListing","code":["store.send(.parentalGate(.request(reason: \"purchase-\\(UUID().uuidString)\")))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Or, more usefully, clear the relevant entries from ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":" at meaningful boundaries — app launch, session timeout, or returning from background. Mutate the set directly from your own reducer:","type":"text"}]},{"type":"codeListing","code":["case .app(.didEnterBackground):","    state.parentalGate.passedReasons.removeAll()","    return nil"],"syntax":"swift"},{"text":"Testing","type":"heading","level":2,"anchor":"Testing"},{"type":"paragraph","inlineContent":[{"text":"For deterministic tests, swap the standard generator for ","type":"text"},{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["@MainActor","@Test func correctAnswerAcceptsAndPasses() async throws {","    let challenge = MathChallenge(left: 2, right: 3, op: .plus)  \/\/ expected = 5","    let plugin = ParentalGatePlugin<AppState, AppAction>(","        state: \\.parentalGate,","        action: AppAction.parentalGate,","        extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","        challengeSource: .fixed(challenge)","    )","","    var state = AppState()","    state.parentalGate.pendingReason = \"settings\"","    state.parentalGate.challenge = challenge","","    let effect = plugin.reduce(state: &state, action: .parentalGate(.submitAnswer(5)))","    let effect = try #require(effect)","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .parentalGate(.answerAccepted(let reason)) = dispatched.first {","        #expect(reason == \"settings\")","    } else {","        Issue.record(\"expected answerAccepted, got \\(dispatched)\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SwiduxParentalGateTests"},{"type":"text","text":" target in this package uses the same pattern — a fixed challenge plus a small test root state — and is a good reference when wiring tests for your own gated features."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddaparentalgate"]}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","interfaceLanguage":"swift"},"references":{"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"kind":"article","role":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"title":"Add a Version Killswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","type":"topic"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"title":"Add Analytics","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","kind":"article","url":"\/documentation\/swidux\/howtoaddanalytics","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"kind":"article","role":"article","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"ti