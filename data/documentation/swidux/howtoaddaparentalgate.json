{"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"How-to Guides","generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides"}],"abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"Add a Parental Gate"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When you finish, your app will:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Hold a "},{"type":"codeVoice","code":"ParentalGateState"},{"type":"text","text":" slice in "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"parentalGate"},{"type":"text","text":" action case in "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Run "},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":" as part of the store’s plugin host."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Present a math-challenge sheet whenever a feature requests a gate, and resume the original action once the user solves it."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"For the API surface, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","type":"reference","isActive":true},{"text":". For how domain plugins fit into the dispatch lifecycle, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"text":".","type":"text"}]},{"type":"heading","text":"Before you start","anchor":"Before-you-start","level":2},{"type":"paragraph","inlineContent":[{"text":"This guide assumes you already have a Swidux app wired with ","type":"text"},{"type":"codeVoice","code":"AppState"},{"text":", ","type":"text"},{"type":"codeVoice","code":"AppAction"},{"text":", an ","type":"text"},{"type":"codeVoice","code":"AppReducer"},{"text":", and a ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" factory. If you don’t, start with the getting-started material and come back here.","type":"text"}]},{"type":"heading","text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency","level":2},{"type":"paragraph","inlineContent":[{"text":"The parental-gate plugin ships as a separate library product. Add it to your target’s dependencies:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Package.swift",".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxParentalGate\", package: \"Swidux\"),","    ]",")"]},{"type":"heading","text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions","level":2},{"type":"paragraph","inlineContent":[{"text":"Nest a ","type":"text"},{"type":"codeVoice","code":"ParentalGateState"},{"text":" slice on your root state, and add an action case that wraps ","type":"text"},{"type":"codeVoice","code":"ParentalGateAction"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ AppState.swift","import SwiduxParentalGate","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var parentalGate: ParentalGateState = .init()","    \/\/ … other slices","}","","\/\/ AppAction.swift","enum AppAction: Sendable {","    case parentalGate(ParentalGateAction)","    \/\/ … other cases","}"]},{"type":"aside","style":"tip","name":"Tip","content":[{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"import SwiduxParentalGate"},{"type":"text","text":" is needed in "},{"inlineContent":[{"text":"every","type":"text"}],"type":"emphasis"},{"type":"text","text":" file that touches "},{"type":"codeVoice","code":"store.parentalGate.*"},{"type":"text","text":" or "},{"type":"codeVoice","code":"ParentalGateAction"},{"type":"text","text":" — including views that read the slice for display. "},{"type":"codeVoice","code":"@_exported import Swidux"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"The plugin owns the parental-gate slice end-to-end, so the root reducer just falls through:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ AppReducer.swift","case .parentalGate:","    return nil"]},{"type":"heading","text":"Step 3: Wire the plugin","anchor":"Step-3-Wire-the-plugin","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct "},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":" inside "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" and register it with the plugin host. Use "},{"type":"codeVoice","code":"ParentalChallengeSource.standard"},{"type":"text","text":" for production:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ AppStore.swift","let parentalGatePlugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: .standard",")","","let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","plugins.register(parentalGatePlugin)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Domain plugins use only the "},{"type":"codeVoice","code":"reduce"},{"type":"text","text":" hook, so registration order relative to other domain plugins rarely matters."}]},{"type":"heading","text":"Step 4: Gate an action","anchor":"Step-4-Gate-an-action","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pick a stable reason key per gated action (for example "},{"type":"codeVoice","code":"\"purchase\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"settings\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"exit-kid-mode\""},{"type":"text","text":"). In a view or feature reducer, check "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" before performing the work:"}]},{"type":"codeListing","syntax":"swift","code":["Button(\"Buy gems\") {","    if store.parentalGate.passedReasons.contains(\"purchase\") {","        store.send(.shop(.buyGems))","    } else {","        store.send(.parentalGate(.request(reason: \"purchase\")))","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To resume the original action automatically once the user solves the challenge, listen for "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" in the relevant feature reducer and re-dispatch:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ ShopReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .parentalGate(.answerAccepted(let reason)) where reason == \"purchase\":","        return { send in await send(.shop(.buyGems)) }","    \/\/ …","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This pattern keeps the gate logic local to the feature it protects: the gate just emits "},{"type":"codeVoice","code":"answerAccepted"},{"type":"text","text":", and each feature decides what — if anything — to resume."}]},{"type":"heading","text":"Step 5: Present the challenge sheet","anchor":"Step-5-Present-the-challenge-sheet","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Drive sheet presentation off "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":". Bind text input to a local "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" for the typed answer, dispatch "},{"type":"codeVoice","code":"ParentalGateAction.submitAnswer(_:)"},{"type":"text","text":" on confirm, and "},{"type":"codeVoice","code":"ParentalGateAction.regenerateChallenge"},{"type":"text","text":" for a “new question” button."}]},{"type":"codeListing","syntax":"swift","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        \/\/ … your app UI","            .sheet(isPresented: Binding(","                get: { store.parentalGate.pendingReason != nil },","                set: { if !$0 { store.send(.parentalGate(.dismiss)) } }","            )) {","                ParentalGateSheet()","            }","    }","}","","struct ParentalGateSheet: View {","    @Environment(AppStore.self) private var store","    @State private var answer: String = \"\"","","    var body: some View {","        VStack(spacing: 16) {","            if let challenge = store.parentalGate.challenge {","                Text(\"\\(challenge.left) \\(challenge.op.symbol) \\(challenge.right) = ?\")","                    .font(.title)","","                TextField(\"Answer\", text: $answer)","                    .keyboardType(.numberPad)","","                HStack {","                    Button(\"New question\") {","                        store.send(.parentalGate(.regenerateChallenge))","                        answer = \"\"","                    }","                    Button(\"Submit\") {","                        if let value = Int(answer) {","                            store.send(.parentalGate(.submitAnswer(value)))","                        }","                        answer = \"\"","                    }","                }","            }","        }","        .padding()","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the user submits a wrong answer, the plugin increments "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates the challenge automatically, so the sheet just re-renders with the new operands."}]},{"anchor":"Reasons-that-should-be-passed-once-vs-always-re-challenged","level":2,"type":"heading","text":"Reasons that should be passed once vs. always re-challenged"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The auto-pass behavior of "},{"type":"codeVoice","code":"ParentalGateAction.request(reason:)"},{"type":"text","text":" (see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","isActive":true},{"type":"text","text":") is a design choice: once a reason is in "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", future "},{"type":"codeVoice","code":".request"},{"type":"text","text":" calls for it short-circuit. That’s the right default for low-stakes gates inside a single session — the user shouldn’t solve the same problem every time they tap the same button."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For higher-stakes gates that should always re-challenge, use a fresh reason key each time:"}]},{"type":"codeListing","code":["store.send(.parentalGate(.request(reason: \"purchase-\\(UUID().uuidString)\")))"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or, more usefully, clear the relevant entries from "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" at meaningful boundaries — app launch, session timeout, or returning from background. Mutate the set directly from your own reducer:"}]},{"type":"codeListing","syntax":"swift","code":["case .app(.didEnterBackground):","    state.parentalGate.passedReasons.removeAll()","    return nil"]},{"type":"heading","text":"Testing","anchor":"Testing","level":2},{"inlineContent":[{"type":"text","text":"For deterministic tests, swap the standard generator for "},{"type":"codeVoice","code":"ParentalChallengeSource.fixed(_:)"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["@MainActor","@Test func correctAnswerAcceptsAndPasses() async throws {","    let challenge = MathChallenge(left: 2, right: 3, op: .plus)  \/\/ expected = 5","    let plugin = ParentalGatePlugin<AppState, AppAction>(","        state: \\.parentalGate,","        action: AppAction.parentalGate,","        extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","        challengeSource: .fixed(challenge)","    )","","    var state = AppState()","    state.parentalGate.pendingReason = \"settings\"","    state.parentalGate.challenge = challenge","","    let effect = plugin.reduce(state: &state, action: .parentalGate(.submitAnswer(5)))","    let effect = try #require(effect)","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .parentalGate(.answerAccepted(let reason)) = dispatched.first {","        #expect(reason == \"settings\")","    } else {","        Issue.record(\"expected answerAccepted, got \\(dispatched)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SwiduxParentalGateTests"},{"type":"text","text":" target in this package uses the same pattern — a fixed challenge plus a small test root state — and is a good reference when wiring tests for your own gated features."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"variants":[{"paths":["\/documentation\/swidux\/howtoaddaparentalgate"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"references":{"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic","title":"Add a Paywall","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"role":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddanalytics","kind":"article","title":"Add Analytics"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"role":"article","type":"topic","url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article","title":"Add Feature Flags"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","type":"topic","title":"Add a Version Killswitch","role":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"role":"article","type":"topic","title":"SwiduxParentalGate Reference","kind":"article","url":"\/documentation\/swidux\/pluginparentalgatereference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},"doc://Swidux/documentation/Swidux":{"title":"Swidux","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"role":"collection","url":"\/documentation\/swidux","kind":"symbol"},"doc://Swidux/documentation/Swidux/AgentSkill":{"url":"\/documentation\/swidux\/agentskill","kind":"article","type":"topic","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","title":"Using the Swidux Agent Skill"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"abstract":[{"text":"Layer opt-in, cross-device iCloud sync on top of ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" with the ","type":"text"},{"code":"SwiduxCloudKitSync","type":"codeVoice"},{"text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration.","type":"text"}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","url":"\/documentation\/swidux\/howtoaddicloudsync","type":"topic","title":"Add iCloud Sync","role":"article"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"title":"Plugin Architecture","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","url":"\/documentation\/swidux\/pluginarchitecture"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"title":"Add Persistence","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","url":"\/documentation\/swidux\/howtoaddpersistence"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"url":"\/documentation\/swidux\/buildingadomainplugin","kind":"article","type":"topic","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","title":"Building a Domain Plugin"}}}