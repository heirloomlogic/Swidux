uxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"title":"Add Feature Flags","type":"topic","url":"\/documentation\/swidux\/howtoaddfeatureflags","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"role":"article","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"title":"Add a Version Killswitch","type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"url":"\/documentation\/swidux\/howtoaddapaywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"topic","title":"Add a Paywall","role":"article","kind":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}]},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"role":"article","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"title":"Cancel Effects","type":"topic","url":"\/documentation\/swidux\/howtocanceleffects","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"role":"article","abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"title":"SwiduxParentalGate Referen