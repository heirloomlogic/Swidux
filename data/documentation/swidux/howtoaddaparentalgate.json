{"metadata":{"title":"Add a Parental Gate","modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article"},"kind":"article","variants":[{"paths":["\/documentation\/swidux\/howtoaddaparentalgate"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"When you finish, your app will:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Hold a "},{"type":"codeVoice","code":"ParentalGateState"},{"type":"text","text":" slice in "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"parentalGate"},{"type":"text","text":" action case in "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Run "},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":" as part of the store’s plugin host."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Present a math-challenge sheet whenever a feature requests a gate, and resume the original action once the user solves it."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For the API surface, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","isActive":true,"type":"reference"},{"type":"text","text":". For how domain plugins fit into the dispatch lifecycle, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Before you start","anchor":"Before-you-start"},{"inlineContent":[{"type":"text","text":"This guide assumes you already have a Swidux app wired with "},{"code":"AppState","type":"codeVoice"},{"type":"text","text":", "},{"code":"AppAction","type":"codeVoice"},{"type":"text","text":", an "},{"code":"AppReducer","type":"codeVoice"},{"type":"text","text":", and a "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" factory. If you don’t, start with the getting-started material and come back here."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Step 1: Add the dependency","anchor":"Step-1-Add-the-dependency"},{"inlineContent":[{"type":"text","text":"The parental-gate plugin ships as a separate library product. Add it to your target’s dependencies:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ Package.swift",".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxParentalGate\", package: \"Swidux\"),","    ]",")"]},{"type":"heading","level":2,"text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions"},{"inlineContent":[{"type":"text","text":"Nest a "},{"code":"ParentalGateState","type":"codeVoice"},{"type":"text","text":" slice on your root state, and add an action case that wraps "},{"code":"ParentalGateAction","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ AppState.swift","import SwiduxParentalGate","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var parentalGate: ParentalGateState = .init()","    \/\/ … other slices","}","","\/\/ AppAction.swift","enum AppAction: Sendable {","    case parentalGate(ParentalGateAction)","    \/\/ … other cases","}"]},{"style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"import SwiduxParentalGate"},{"text":" is needed in ","type":"text"},{"inlineContent":[{"type":"text","text":"every"}],"type":"emphasis"},{"text":" file that touches ","type":"text"},{"type":"codeVoice","code":"store.parentalGate.*"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"ParentalGateAction"},{"text":" — including views that read the slice for display. ","type":"text"},{"type":"codeVoice","code":"@_exported import Swidux"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"text":".","type":"text"}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"The plugin owns the parental-gate slice end-to-end, so the root reducer just falls through:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ AppReducer.swift","case .parentalGate:","    return nil"]},{"type":"heading","level":2,"text":"Step 3: Wire the plugin","anchor":"Step-3-Wire-the-plugin"},{"inlineContent":[{"type":"text","text":"Construct "},{"code":"ParentalGatePlugin","type":"codeVoice"},{"type":"text","text":" inside "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" and register it with the plugin host. Use "},{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"type":"text","text":" for production:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ AppStore.swift","let parentalGatePlugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: .standard",")","","let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","plugins.register(parentalGatePlugin)"]},{"inlineContent":[{"type":"text","text":"Domain plugins use only the "},{"code":"reduce","type":"codeVoice"},{"type":"text","text":" hook, so registration order relative to other domain plugins rarely matters."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Step 4: Gate an action","anchor":"Step-4-Gate-an-action"},{"inlineContent":[{"type":"text","text":"Pick a stable reason key per gated action (for example "},{"code":"\"purchase\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"settings\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"exit-kid-mode\"","type":"codeVoice"},{"type":"text","text":"). In a view or feature reducer, check "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" before performing the work:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Button(\"Buy gems\") {","    if store.parentalGate.passedReasons.contains(\"purchase\") {","        store.send(.shop(.buyGems))","    } else {","        store.send(.parentalGate(.request(reason: \"purchase\")))","    }","}"]},{"inlineContent":[{"type":"text","text":"To resume the original action automatically once the user solves the challenge, listen for "},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"type":"text","text":" in the relevant feature reducer and re-dispatch:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ ShopReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .parentalGate(.answerAccepted(let reason)) where reason == \"purchase\":","        return { send in await send(.shop(.buyGems)) }","    \/\/ …","    }","}"]},{"inlineContent":[{"type":"text","text":"This pattern keeps the gate logic local to the feature it protects: the gate just emits "},{"code":"answerAccepted","type":"codeVoice"},{"type":"text","text":", and each feature decides what — if anything — to resume."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Step 5: Present the challenge sheet","anchor":"Step-5-Present-the-challenge-sheet"},{"inlineContent":[{"type":"text","text":"Drive sheet presentation off "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":". Bind text input to a local "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" for the typed answer, dispatch "},{"code":"ParentalGateAction.submitAnswer(_:)","type":"codeVoice"},{"type":"text","text":" on confirm, and "},{"code":"ParentalGateAction.regenerateChallenge","type":"codeVoice"},{"type":"text","text":" for a “new question” button."}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        \/\/ … your app UI","            .sheet(isPresented: Binding(","                get: { store.parentalGate.pendingReason != nil },","                set: { if !$0 { store.send(.parentalGate(.dismiss)) } }","            )) {","                ParentalGateSheet()","            }","    }","}","","struct ParentalGateSheet: View {","    @Environment(AppStore.self) private var store","    @State private var answer: String = \"\"","","    var body: some View {","        VStack(spacing: 16) {","            if let challenge = store.parentalGate.challenge {","                Text(\"\\(challenge.left) \\(challenge.op.symbol) \\(challenge.right) = ?\")","                    .font(.title)","","                TextField(\"Answer\", text: $answer)","                    .keyboardType(.numberPad)","","                HStack {","                    Button(\"New question\") {","                        store.send(.parentalGate(.regenerateChallenge))","                        answer = \"\"","                    }","                    Button(\"Submit\") {","                        if let value = Int(answer) {","                            store.send(.parentalGate(.submitAnswer(value)))","                        }","                        answer = \"\"","                    }","                }","            }","        }","        .padding()","    }","}"]},{"inlineContent":[{"type":"text","text":"When the user submits a wrong answer, the plugin increments "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":" and regenerates the challenge automatically, so the sheet just re-renders with the new operands."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Reasons that should be passed once vs. always re-challenged","anchor":"Reasons-that-should-be-passed-once-vs-always-re-challenged"},{"inlineContent":[{"type":"text","text":"The auto-pass behavior of "},{"code":"ParentalGateAction.request(reason:)","type":"codeVoice"},{"type":"text","text":" (see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","isActive":true,"type":"reference"},{"type":"text","text":") is a design choice: once a reason is in "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":", future "},{"code":".request","type":"codeVoice"},{"type":"text","text":" calls for it short-circuit. That’s the right default for low-stakes gates inside a single session — the user shouldn’t solve the same problem every time they tap the same button."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For higher-stakes gates that should always re-challenge, use a fresh reason key each time:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["store.send(.parentalGate(.request(reason: \"purchase-\\(UUID().uuidString)\")))"]},{"inlineContent":[{"type":"text","text":"Or, more usefully, clear the relevant entries from "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" at meaningful boundaries — app launch, session timeout, or returning from background. Mutate the set directly from your own reducer:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["case .app(.didEnterBackground):","    state.parentalGate.passedReasons.removeAll()","    return nil"]},{"type":"heading","level":2,"text":"Testing","anchor":"Testing"},{"inlineContent":[{"type":"text","text":"For deterministic tests, swap the standard generator for "},{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["@MainActor","@Test func correctAnswerAcceptsAndPasses() async throws {","    let challenge = MathChallenge(left: 2, right: 3, op: .plus)  \/\/ expected = 5","    let plugin = ParentalGatePlugin<AppState, AppAction>(","        state: \\.parentalGate,","        action: AppAction.parentalGate,","        extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","        challengeSource: .fixed(challenge)","    )","","    var state = AppState()","    state.parentalGate.pendingReason = \"settings\"","    state.parentalGate.challenge = challenge","","    let effect = plugin.reduce(state: &state, action: .parentalGate(.submitAnswer(5)))","    let effect = try #require(effect)","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .parentalGate(.answerAccepted(let reason)) = dispatched.first {","        #expect(reason == \"settings\")","    } else {","        Issue.record(\"expected answerAccepted, got \\(dispatched)\")","    }","}"]},{"inlineContent":[{"type":"text","text":"The "},{"code":"SwiduxParentalGateTests","type":"codeVoice"},{"type":"text","text":" target in this package uses the same pattern — a fixed challenge plus a small test root state — and is a good reference when wiring tests for your own gated features."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"generated":true,"title":"How-to Guides","anchor":"How-to-Guides"}],"references":{"doc://Swidux/documentation/Swidux/SecurityPosture":{"abstract":[{"type":"text","text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one."}],"role":"collectionGroup","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","url":"\/documentation\/swidux\/securityposture","kind":"article","type":"topic","title":"Security Posture"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"title":"Plugin Architecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic","url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"role":"article","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"title":"Add Analytics","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","type":"topic","url":"\/documentation\/swidux\/howtoaddanalytics","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxAnalytics"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"role":"article","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddPersistence":{"title":"Add Persistence","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","type":"topic","url":"\/documentation\/swidux\/howtoaddpersistence","abstract":[{"type":"text","text":"Persist your domain entities to SwiftData with the "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" plugin and the "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" macro — no hand-written "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" classes, database actors, or "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" closures."}],"role":"article","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"title":"Add iCloud Sync","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"topic","url":"\/documentation\/swidux\/howtoaddicloudsync","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"role":"article","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"title":"Add a Version Killswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","type":"topic","url":"\/documentation\/swidux\/howtoaddaversionkillswitch","abstract":[{"type":"text","text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store."}],"role":"article","kind":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","title":"SwiduxParentalGate Reference","type":"topic","url":"\/documentation\/swidux\/pluginparentalgatereference","abstract":[{"text":"API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"role":"article","kind":"article"},"doc://Swidux/documentation/Swidux/AgentSkill":{"title":"Using the Swidux Agent Skill","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","type":"topic","url":"\/documentation\/swidux\/agentskill","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"role":"article","kind":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"title":"Add a Paywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"topic","url":"\/documentation\/swidux\/howtoaddapaywall","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"role":"article","kind":"article"},"doc://Swidux/documentation/Swidux/HowToCancelEffects":{"title":"Cancel Effects","type":"topic","url":"\/documentation\/swidux\/howtocanceleffects","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","abstract":[{"type":"text","text":"Tag an effect with an identity so it can be cancelled later — by another effect, or imperatively from view code."}],"kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"title":"Add Feature Flags","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"topic","url":"\/documentation\/swidux\/howtoaddfeatureflags","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"role":"article","kind":"article"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"title":"Building a Domain Plugin","type":"topic","url":"\/documentation\/swidux\/buildingadomainplugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"kind":"article","role":"article"},"doc://Swidux/documentation/Swidux":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"kind":"symbol","role":"collection","url":"\/documentation\/swidux","title":"Swidux"}}}