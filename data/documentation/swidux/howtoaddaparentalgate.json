{"sections":[],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"generated":true,"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides"}],"metadata":{"role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"Add a Parental Gate"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"text":"When you finish, your app will:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Hold a ","type":"text"},{"code":"ParentalGateState","type":"codeVoice"},{"type":"text","text":" slice in "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"parentalGate"},{"type":"text","text":" action case in "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Run "},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":" as part of the store’s plugin host."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Present a math-challenge sheet whenever a feature requests a gate, and resume the original action once the user solves it."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"For the API surface, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},{"text":". For how domain plugins fit into the dispatch lifecycle, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}]},{"anchor":"Before-you-start","level":2,"text":"Before you start","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes you already have a Swidux app wired with ","type":"text"},{"type":"codeVoice","code":"AppState"},{"type":"text","text":", "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":", an "},{"type":"codeVoice","code":"AppReducer"},{"type":"text","text":", and a "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" factory. If you don’t, start with the getting-started material and come back here."}]},{"anchor":"Step-1-Add-the-dependency","text":"Step 1: Add the dependency","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parental-gate plugin ships as a separate library product. Add it to your target’s dependencies:"}]},{"code":["\/\/ Package.swift",".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxParentalGate\", package: \"Swidux\"),","    ]",")"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-2-Add-state-and-actions","text":"Step 2: Add state and actions","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nest a "},{"code":"ParentalGateState","type":"codeVoice"},{"type":"text","text":" slice on your root state, and add an action case that wraps "},{"code":"ParentalGateAction","type":"codeVoice"},{"type":"text","text":"."}]},{"code":["\/\/ AppState.swift","import SwiduxParentalGate","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var parentalGate: ParentalGateState = .init()","    \/\/ … other slices","}","","\/\/ AppAction.swift","enum AppAction: Sendable {","    case parentalGate(ParentalGateAction)","    \/\/ … other cases","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The plugin owns the parental-gate slice end-to-end, so the root reducer just falls through:"}]},{"code":["\/\/ AppReducer.swift","case .parentalGate:","    return nil"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-3-Wire-the-plugin","text":"Step 3: Wire the plugin","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Construct "},{"type":"codeVoice","code":"ParentalGatePlugin"},{"text":" inside ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" and register it with the plugin host. Use ","type":"text"},{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"text":" for production:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ AppStore.swift","let parentalGatePlugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: .standard",")","","let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","plugins.register(parentalGatePlugin)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Domain plugins use only the "},{"code":"reduce","type":"codeVoice"},{"text":" hook, so registration order relative to other domain plugins rarely matters.","type":"text"}]},{"level":2,"type":"heading","text":"Step 4: Gate an action","anchor":"Step-4-Gate-an-action"},{"inlineContent":[{"text":"Pick a stable reason key per gated action (for example ","type":"text"},{"type":"codeVoice","code":"\"purchase\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"settings\""},{"type":"text","text":", "},{"type":"codeVoice","code":"\"exit-kid-mode\""},{"text":"). In a view or feature reducer, check ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" before performing the work:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["Button(\"Buy gems\") {","    if store.parentalGate.passedReasons.contains(\"purchase\") {","        store.send(.shop(.buyGems))","    } else {","        store.send(.parentalGate(.request(reason: \"purchase\")))","    }","}"]},{"inlineContent":[{"type":"text","text":"To resume the original action automatically once the user solves the challenge, listen for "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"text":" in the relevant feature reducer and re-dispatch:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ ShopReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .parentalGate(.answerAccepted(let reason)) where reason == \"purchase\":","        return { send in await send(.shop(.buyGems)) }","    \/\/ …","    }","}"]},{"inlineContent":[{"text":"This pattern keeps the gate logic local to the feature it protects: the gate just emits ","type":"text"},{"code":"answerAccepted","type":"codeVoice"},{"text":", and each feature decides what — if anything — to resume.","type":"text"}],"type":"paragraph"},{"text":"Step 5: Present the challenge sheet","type":"heading","level":2,"anchor":"Step-5-Present-the-challenge-sheet"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Drive sheet presentation off "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":". Bind text input to a local "},{"code":"@State","type":"codeVoice"},{"text":" for the typed answer, dispatch ","type":"text"},{"type":"codeVoice","code":"ParentalGateAction.submitAnswer(_:)"},{"type":"text","text":" on confirm, and "},{"type":"codeVoice","code":"ParentalGateAction.regenerateChallenge"},{"type":"text","text":" for a “new question” button."}]},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        \/\/ … your app UI","            .sheet(isPresented: Binding(","                get: { store.parentalGate.pendingReason != nil },","                set: { if !$0 { store.send(.parentalGate(.dismiss)) } }","            )) {","                ParentalGateSheet()","            }","    }","}","","struct ParentalGateSheet: View {","    @Environment(AppStore.self) private var store","    @State private var answer: String = \"\"","","    var body: some View {","        VStack(spacing: 16) {","            if let challenge = store.parentalGate.challenge {","                Text(\"\\(challenge.left) \\(challenge.op.symbol) \\(challenge.right) = ?\")","                    .font(.title)","","                TextField(\"Answer\", text: $answer)","                    .keyboardType(.numberPad)","","                HStack {","                    Button(\"New question\") {","                        store.send(.parentalGate(.regenerateChallenge))","                        answer = \"\"","                    }","                    Button(\"Submit\") {","                        if let value = Int(answer) {","                            store.send(.parentalGate(.submitAnswer(value)))","                        }","                        answer = \"\"","                    }","                }","            }","        }","        .padding()","    }","}"]},{"inlineContent":[{"text":"When the user submits a wrong answer, the plugin increments ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":" and regenerates the challenge automatically, so the sheet just re-renders with the new operands.","type":"text"}],"type":"paragraph"},{"anchor":"Reasons-that-should-be-passed-once-vs-always-re-challenged","level":2,"type":"heading","text":"Reasons that should be passed once vs. always re-challenged"},{"inlineContent":[{"text":"The auto-pass behavior of ","type":"text"},{"type":"codeVoice","code":"ParentalGateAction.request(reason:)"},{"text":" (see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","type":"reference","isActive":true},{"text":") is a design choice: once a reason is in ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":", future ","type":"text"},{"type":"codeVoice","code":".request"},{"text":" calls for it short-circuit. That’s the right default for low-stakes gates inside a single session — the user shouldn’t solve the same problem every time they tap the same button.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For higher-stakes gates that should always re-challenge, use a fresh reason key each time:"}]},{"type":"codeListing","syntax":"swift","code":["store.send(.parentalGate(.request(reason: \"purchase-\\(UUID().uuidString)\")))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or, more usefully, clear the relevant entries from "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" at meaningful boundaries — app launch, session timeout, or returning from background. Mutate the set directly from your own reducer:"}]},{"type":"codeListing","syntax":"swift","code":["case .app(.didEnterBackground):","    state.parentalGate.passedReasons.removeAll()","    return nil"]},{"type":"heading","text":"Testing","anchor":"Testing","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For deterministic tests, swap the standard generator for "},{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","@Test func correctAnswerAcceptsAndPasses() async throws {","    let challenge = MathChallenge(left: 2, right: 3, op: .plus)  \/\/ expected = 5","    let plugin = ParentalGatePlugin<AppState, AppAction>(","        state: \\.parentalGate,","        action: AppAction.parentalGate,","        extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","        challengeSource: .fixed(challenge)","    )","","    var state = AppState()","    state.parentalGate.pendingReason = \"settings\"","    state.parentalGate.challenge = challenge","","    let effect = plugin.reduce(state: &state, action: .parentalGate(.submitAnswer(5)))","    let effect = try #require(effect)","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .parentalGate(.answerAccepted(let reason)) = dispatched.first {","        #expect(reason == \"settings\")","    } else {","        Issue.record(\"expected answerAccepted, got \\(dispatched)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"SwiduxParentalGateTests","type":"codeVoice"},{"text":" target in this package uses the same pattern — a fixed challenge plus a small test root state — and is a good reference when wiring tests for your own gated features.","type":"text"}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","interfaceLanguage":"swift"},"kind":"article","variants":[{"paths":["\/documentation\/swidux\/howtoaddaparentalgate"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"url":"\/documentation\/swidux\/howtoaddapaywall","role":"article","kind":"article","title":"Add a Paywall","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"topic","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"url":"\/documentation\/swidux\/pluginarchitecture","role":"article","kind":"article","title":"Plugin Architecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}]},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"title":"Add Analytics","type":"topic","abstract":[{"text":"Wire the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for centralized event tracking with declarative event mapping and auto-identify."}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","url":"\/documentation\/swidux\/howtoaddanalytics","kind":"article"},"doc://Swidux/documentation/Swidux/PluginParentalGateReference":{"url":"\/documentation\/swidux\/pluginparentalgatereference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","role":"article","kind":"article","type":"topic","title":"SwiduxParentalGate Reference","abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}]},"doc://Swidux/documentation/Swidux/HowToAddAVersionKillswitch":{"type":"topic","kind":"article","abstract":[{"text":"Wire a remote-controlled blocker that prevents unsupported app versions from running, with an “Update” path back to the App Store.","type":"text"}],"url":"\/documentation\/swidux\/howtoaddaversionkillswitch","title":"Add a Version Killswitch","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","role":"article"},"doc://Swidux/documentation/Swidux/AgentSkill":{"role":"article","kind":"article","url":"\/documentation\/swidux\/agentskill","title":"Using the Swidux Agent Skill","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","type":"topic"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","role":"collection","kind":"symbol","title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","type":"topic","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}]},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"title":"Add Feature Flags","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","kind":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"url":"\/documentation\/swidux\/buildingadomainplugin","role":"article","kind":"article","title":"Building a Domain Plugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","type":"topic","abstract":[{"text":"Create a self-contained feature plugin with its own state, actions, and effects.","type":"text"}]}}}