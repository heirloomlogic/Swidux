{"abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"Add a Parental Gate"},"kind":"article","identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"How-to Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"],"anchor":"How-to-Guides","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"When you finish, your app will:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Hold a "},{"type":"codeVoice","code":"ParentalGateState"},{"type":"text","text":" slice in "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"parentalGate"},{"type":"text","text":" action case in "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Run "},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":" as part of the store’s plugin host."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Present a math-challenge sheet whenever a feature requests a gate, and resume the original action once the user solves it."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For the API surface, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","isActive":true,"type":"reference"},{"type":"text","text":". For how domain plugins fit into the dispatch lifecycle, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Before-you-start","text":"Before you start","type":"heading"},{"inlineContent":[{"text":"This guide assumes you already have a Swidux app wired with ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", an ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and a ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory. If you don’t, start with the getting-started material and come back here.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Step-1-Add-the-dependency","text":"Step 1: Add the dependency"},{"inlineContent":[{"type":"text","text":"The parental-gate plugin ships as a separate library product. Add it to your target’s dependencies:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Package.swift",".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxParentalGate\", package: \"Swidux\"),","    ]",")"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Step-2-Add-state-and-actions","text":"Step 2: Add state and actions"},{"inlineContent":[{"text":"Nest a ","type":"text"},{"type":"codeVoice","code":"ParentalGateState"},{"text":" slice on your root state, and add an action case that wraps ","type":"text"},{"type":"codeVoice","code":"ParentalGateAction"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ AppState.swift","import SwiduxParentalGate","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var parentalGate: ParentalGateState = .init()","    \/\/ … other slices","}","","\/\/ AppAction.swift","enum AppAction: Sendable {","    case parentalGate(ParentalGateAction)","    \/\/ … other cases","}"],"syntax":"swift"},{"type":"aside","name":"Tip","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"code":"import SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" is needed in "},{"inlineContent":[{"text":"every","type":"text"}],"type":"emphasis"},{"type":"text","text":" file that touches "},{"code":"store.parentalGate.*","type":"codeVoice"},{"type":"text","text":" or "},{"code":"ParentalGateAction","type":"codeVoice"},{"type":"text","text":" — including views that read the slice for display. "},{"code":"@_exported import Swidux","type":"codeVoice"},{"type":"text","text":" re-exports core Swidux only, not plugin modules. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]}]},{"inlineContent":[{"text":"The plugin owns the parental-gate slice end-to-end, so the root reducer just falls through:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ AppReducer.swift","case .parentalGate:","    return nil"],"syntax":"swift"},{"level":2,"type":"heading","anchor":"Step-3-Wire-the-plugin","text":"Step 3: Wire the plugin"},{"inlineContent":[{"text":"Construct ","type":"text"},{"type":"codeVoice","code":"ParentalGatePlugin"},{"text":" inside ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" and register it with the plugin host. Use "},{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"type":"text","text":" for production:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ AppStore.swift","let parentalGatePlugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: .standard",")","","let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","plugins.register(parentalGatePlugin)"]},{"inlineContent":[{"text":"Domain plugins use only the ","type":"text"},{"type":"codeVoice","code":"reduce"},{"text":" hook, so registration order relative to other domain plugins rarely matters.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Step-4-Gate-an-action","text":"Step 4: Gate an action"},{"inlineContent":[{"type":"text","text":"Pick a stable reason key per gated action (for example "},{"code":"\"purchase\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"settings\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"exit-kid-mode\"","type":"codeVoice"},{"type":"text","text":"). In a view or feature reducer, check "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" before performing the work:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["Button(\"Buy gems\") {","    if store.parentalGate.passedReasons.contains(\"purchase\") {","        store.send(.shop(.buyGems))","    } else {","        store.send(.parentalGate(.request(reason: \"purchase\")))","    }","}"]},{"inlineContent":[{"text":"To resume the original action automatically once the user solves the challenge, listen for ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" in the relevant feature reducer and re-dispatch:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["\/\/ ShopReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .parentalGate(.answerAccepted(let reason)) where reason == \"purchase\":","        return { send in await send(.shop(.buyGems)) }","    \/\/ …","    }","}"]},{"inlineContent":[{"text":"This pattern keeps the gate logic local to the feature it protects: the gate just emits ","type":"text"},{"code":"answerAccepted","type":"codeVoice"},{"text":", and each feature decides what — if anything — to resume.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Step-5-Present-the-challenge-sheet","text":"Step 5: Present the challenge sheet"},{"inlineContent":[{"text":"Drive sheet presentation off ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":". Bind text input to a local ","type":"text"},{"type":"codeVoice","code":"@State"},{"type":"text","text":" for the typed answer, dispatch "},{"code":"ParentalGateAction.submitAnswer(_:)","type":"codeVoice"},{"type":"text","text":" on confirm, and "},{"code":"ParentalGateAction.regenerateChallenge","type":"codeVoice"},{"type":"text","text":" for a “new question” button."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        \/\/ … your app UI","            .sheet(isPresented: Binding(","                get: { store.parentalGate.pendingReason != nil },","                set: { if !$0 { store.send(.parentalGate(.dismiss)) } }","            )) {","                ParentalGateSheet()","            }","    }","}","","struct ParentalGateSheet: View {","    @Environment(AppStore.self) private var store","    @State private var answer: String = \"\"","","    var body: some View {","        VStack(spacing: 16) {","            if let challenge = store.parentalGate.challenge {","                Text(\"\\(challenge.left) \\(challenge.op.symbol) \\(challenge.right) = ?\")","                    .font(.title)","","                TextField(\"Answer\", text: $answer)","                    .keyboardType(.numberPad)","","                HStack {","                    Button(\"New question\") {","                        store.send(.parentalGate(.regenerateChallenge))","                        answer = \"\"","                    }","                    Button(\"Submit\") {","                        if let value = Int(answer) {","                            store.send(.parentalGate(.submitAnswer(value)))","                        }","                        answer = \"\"","                    }","                }","            }","        }","        .padding()","    }","}"]},{"inlineContent":[{"type":"text","text":"When the user submits a wrong answer, the plugin increments "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":" and regenerates the challenge automatically, so the sheet just re-renders with the new operands."}],"type":"paragraph"},{"anchor":"Reasons-that-should-be-passed-once-vs-always-re-challenged","type":"heading","text":"Reasons that should be passed once vs. always re-challenged","level":2},{"inlineContent":[{"type":"text","text":"The auto-pass behavior of "},{"type":"codeVoice","code":"ParentalGateAction.request(reason:)"},{"type":"text","text":" (see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},{"type":"text","text":") is a design choice: once a reason is in "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", future "},{"type":"codeVoice","code":".request"},{"type":"text","text":" calls for it short-circuit. That’s the right default for low-stakes gates inside a single session — the user shouldn’t solve the same problem every time they tap the same button."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For higher-stakes gates that should always re-challenge, use a fresh reason key each time:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["store.send(.parentalGate(.request(reason: \"purchase-\\(UUID().uuidString)\")))"]},{"inlineContent":[{"type":"text","text":"Or, more usefully, clear the relevant entries from "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" at meaningful boundaries — app launch, session timeout, or returning from background. Mutate the set directly from your own reducer:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["case .app(.didEnterBackground):","    state.parentalGate.passedReasons.removeAll()","    return nil"]},{"anchor":"Testing","type":"heading","text":"Testing","level":2},{"inlineContent":[{"text":"For deterministic tests, swap the standard generator for ","type":"text"},{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@MainActor","@Test func correctAnswerAcceptsAndPasses() async throws {","    let challenge = MathChallenge(left: 2, right: 3, op: .plus)  \/\/ expected = 5","    let plugin = ParentalGatePlugin<AppState, AppAction>(","        state: \\.parentalGate,","        action: AppAction.parentalGate,","        extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","        challengeSource: .fixed(challenge)","    )","","    var state = AppState()","    state.parentalGate.pendingReason = \"settings\"","    state.parentalGate.challenge = challenge","","    let effect = plugin.reduce(state: &state, action: .parentalGate(.submitAnswer(5)))","    let effect = try #require(effect)","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .parentalGate(.answerAccepted(let reason)) = dispatched.first {","        #expect(reason == \"settings\")","    } else {","        Issue.record(\"expected answerAccepted, got \\(dispatched)\")","    }","}"]},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGateTests"},{"text":" target in this package uses the same pattern — a fixed challenge plus a small test root state — and is a good reference when wiring tests for your own gated features.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/howtoaddaparentalgate"]}],"references":{"doc://Swidux/documentation/Swidux/AgentSkill":{"type":"topic","kind":"article","url":"\/documentation\/swidux\/agentskill","role":"article","title":"Using the Swidux Agent Skill","abstract":[{"text":"Install the bundled ","type":"text"},{"code":"swidux-ref","type":"codeVoice"},{"text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"topic","role":"article","url":"\/documentation\/swidux\/howtoaddicloudsync","title":"Add iCloud Sync","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}]},"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","type":"topic","role":"article","url":"\/documentation\/swidux\/howtoaddfeatureflags","title":"Add Feature Flags","abstract":[{"text":"Wire the "