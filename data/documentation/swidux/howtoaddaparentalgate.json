{"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article","title":"Add a Parental Gate"},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation"},{"title":"How-to Guides","generated":true,"anchor":"How-to-Guides","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAVersionKillswitch","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","doc:\/\/Swidux\/documentation\/Swidux\/HowToCancelEffects","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddPersistence","doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"]}],"variants":[{"paths":["\/documentation\/swidux\/howtoaddaparentalgate"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"kind":"article","primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"When you finish, your app will:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Hold a "},{"type":"codeVoice","code":"ParentalGateState"},{"type":"text","text":" slice in "},{"type":"codeVoice","code":"AppState"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"parentalGate"},{"type":"text","text":" action case in "},{"type":"codeVoice","code":"AppAction"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Run "},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":" as part of the store’s plugin host."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Present a math-challenge sheet whenever a feature requests a gate, and resume the original action once the user solves it."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For the API surface, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},{"type":"text","text":". For how domain plugins fit into the dispatch lifecycle, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Before you start","anchor":"Before-you-start"},{"type":"paragraph","inlineContent":[{"text":"This guide assumes you already have a Swidux app wired with ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":", ","type":"text"},{"code":"AppAction","type":"codeVoice"},{"text":", an ","type":"text"},{"code":"AppReducer","type":"codeVoice"},{"text":", and a ","type":"text"},{"code":"Store.configured()","type":"codeVoice"},{"text":" factory. If you don’t, start with the getting-started material and come back here.","type":"text"}]},{"text":"Step 1: Add the dependency","level":2,"anchor":"Step-1-Add-the-dependency","type":"heading"},{"inlineContent":[{"type":"text","text":"The parental-gate plugin ships as a separate library product. Add it to your target’s dependencies:"}],"type":"paragraph"},{"code":["\/\/ Package.swift",".target(","    name: \"MyApp\",","    dependencies: [","        .product(name: \"Swidux\", package: \"Swidux\"),","        .product(name: \"SwiduxParentalGate\", package: \"Swidux\"),","    ]",")"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Step 2: Add state and actions","anchor":"Step-2-Add-state-and-actions"},{"type":"paragraph","inlineContent":[{"text":"Nest a ","type":"text"},{"code":"ParentalGateState","type":"codeVoice"},{"text":" slice on your root state, and add an action case that wraps ","type":"text"},{"code":"ParentalGateAction","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["\/\/ AppState.swift","import SwiduxParentalGate","","@Swidux","nonisolated struct AppState: Equatable, Sendable {","    @Slice var parentalGate: ParentalGateState = .init()","    \/\/ … other slices","}","","\/\/ AppAction.swift","enum AppAction: Sendable {","    case parentalGate(ParentalGateAction)","    \/\/ … other cases","}"],"syntax":"swift","type":"codeListing"},{"style":"tip","name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"import SwiduxParentalGate","type":"codeVoice"},{"text":" is needed in ","type":"text"},{"inlineContent":[{"type":"text","text":"every"}],"type":"emphasis"},{"text":" file that touches ","type":"text"},{"code":"store.parentalGate.*","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"ParentalGateAction","type":"codeVoice"},{"text":" — including views that read the slice for display. ","type":"text"},{"code":"@_exported import Swidux","type":"codeVoice"},{"text":" re-exports core Swidux only, not plugin modules. See ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"The plugin owns the parental-gate slice end-to-end, so the root reducer just falls through:"}],"type":"paragraph"},{"code":["\/\/ AppReducer.swift","case .parentalGate:","    return nil"],"syntax":"swift","type":"codeListing"},{"text":"Step 3: Wire the plugin","level":2,"anchor":"Step-3-Wire-the-plugin","type":"heading"},{"inlineContent":[{"type":"text","text":"Construct "},{"code":"ParentalGatePlugin","type":"codeVoice"},{"type":"text","text":" inside "},{"code":"Store.configured()","type":"codeVoice"},{"type":"text","text":" and register it with the plugin host. Use "},{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"type":"text","text":" for production:"}],"type":"paragraph"},{"code":["\/\/ AppStore.swift","let parentalGatePlugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: .standard",")","","let plugins = PluginHost<AppState, AppAction>()","plugins.register(undoPlugin)","plugins.register(persistencePlugin)","plugins.register(parentalGatePlugin)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Domain plugins use only the ","type":"text"},{"code":"reduce","type":"codeVoice"},{"text":" hook, so registration order relative to other domain plugins rarely matters.","type":"text"}]},{"text":"Step 4: Gate an action","level":2,"anchor":"Step-4-Gate-an-action","type":"heading"},{"inlineContent":[{"type":"text","text":"Pick a stable reason key per gated action (for example "},{"code":"\"purchase\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"settings\"","type":"codeVoice"},{"type":"text","text":", "},{"code":"\"exit-kid-mode\"","type":"codeVoice"},{"type":"text","text":"). In a view or feature reducer, check "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" before performing the work:"}],"type":"paragraph"},{"code":["Button(\"Buy gems\") {","    if store.parentalGate.passedReasons.contains(\"purchase\") {","        store.send(.shop(.buyGems))","    } else {","        store.send(.parentalGate(.request(reason: \"purchase\")))","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"To resume the original action automatically once the user solves the challenge, listen for ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" in the relevant feature reducer and re-dispatch:","type":"text"}]},{"code":["\/\/ ShopReducer.swift","func reduce(","    state: inout AppState,","    action: AppAction,","    environment: AppEnvironment",") -> Effect? {","    switch action {","    case .parentalGate(.answerAccepted(let reason)) where reason == \"purchase\":","        return { send in await send(.shop(.buyGems)) }","    \/\/ …","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"This pattern keeps the gate logic local to the feature it protects: the gate just emits "},{"code":"answerAccepted","type":"codeVoice"},{"type":"text","text":", and each feature decides what — if anything — to resume."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Step 5: Present the challenge sheet","anchor":"Step-5-Present-the-challenge-sheet"},{"type":"paragraph","inlineContent":[{"text":"Drive sheet presentation off ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":". Bind text input to a local ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" for the typed answer, dispatch ","type":"text"},{"code":"ParentalGateAction.submitAnswer(_:)","type":"codeVoice"},{"text":" on confirm, and ","type":"text"},{"code":"ParentalGateAction.regenerateChallenge","type":"codeVoice"},{"text":" for a “new question” button.","type":"text"}]},{"code":["struct ContentView: View {","    @Environment(AppStore.self) private var store","","    var body: some View {","        \/\/ … your app UI","            .sheet(isPresented: Binding(","                get: { store.parentalGate.pendingReason != nil },","                set: { if !$0 { store.send(.parentalGate(.dismiss)) } }","            )) {","                ParentalGateSheet()","            }","    }","}","","struct ParentalGateSheet: View {","    @Environment(AppStore.self) private var store","    @State private var answer: String = \"\"","","    var body: some View {","        VStack(spacing: 16) {","            if let challenge = store.parentalGate.challenge {","                Text(\"\\(challenge.left) \\(challenge.op.symbol) \\(challenge.right) = ?\")","                    .font(.title)","","                TextField(\"Answer\", text: $answer)","                    .keyboardType(.numberPad)","","                HStack {","                    Button(\"New question\") {","                        store.send(.parentalGate(.regenerateChallenge))","                        answer = \"\"","                    }","                    Button(\"Submit\") {","                        if let value = Int(answer) {","                            store.send(.parentalGate(.submitAnswer(value)))","                        }","                        answer = \"\"","                    }","                }","            }","        }","        .padding()","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"When the user submits a wrong answer, the plugin increments "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":" and regenerates the challenge automatically, so the sheet just re-renders with the new operands."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Reasons that should be passed once vs. always re-challenged","anchor":"Reasons-that-should-be-passed-once-vs-always-re-challenged"},{"type":"paragraph","inlineContent":[{"text":"The auto-pass behavior of ","type":"text"},{"code":"ParentalGateAction.request(reason:)","type":"codeVoice"},{"text":" (see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","type":"reference"},{"text":") is a design choice: once a reason is in ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", future ","type":"text"},{"code":".request","type":"codeVoice"},{"text":" calls for it short-circuit. That’s the right default for low-stakes gates inside a single session — the user shouldn’t solve the same problem every time they tap the same button.","type":"text"}]},{"inlineContent":[{"type":"text","text":"For higher-stakes gates that should always re-challenge, use a fresh reason key each time:"}],"type":"paragraph"},{"code":["store.send(.parentalGate(.request(reason: \"purchase-\\(UUID().uuidString)\")))"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Or, more usefully, clear the relevant entries from ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":" at meaningful boundaries — app launch, session timeout, or returning from background. Mutate the set directly from your own reducer:","type":"text"}]},{"code":["case .app(.didEnterBackground):","    state.parentalGate.passedReasons.removeAll()","    return nil"],"syntax":"swift","type":"codeListing"},{"text":"Testing","level":2,"anchor":"Testing","type":"heading"},{"inlineContent":[{"type":"text","text":"For deterministic tests, swap the standard generator for "},{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["@MainActor","@Test func correctAnswerAcceptsAndPasses() async throws {","    let challenge = MathChallenge(left: 2, right: 3, op: .plus)  \/\/ expected = 5","    let plugin = ParentalGatePlugin<AppState, AppAction>(","        state: \\.parentalGate,","        action: AppAction.parentalGate,","        extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","        challengeSource: .fixed(challenge)","    )","","    var state = AppState()","    state.parentalGate.pendingReason = \"settings\"","    state.parentalGate.challenge = challenge","","    let effect = plugin.reduce(state: &state, action: .parentalGate(.submitAnswer(5)))","    let effect = try #require(effect)","","    var dispatched: [AppAction] = []","    await effect { dispatched.append($0) }","","    if case .parentalGate(.answerAccepted(let reason)) = dispatched.first {","        #expect(reason == \"settings\")","    } else {","        Issue.record(\"expected answerAccepted, got \\(dispatched)\")","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"SwiduxParentalGateTests","type":"codeVoice"},{"text":" target in this package uses the same pattern — a fixed challenge plus a small test root state — and is a good reference when wiring tests for your own gated features.","type":"text"}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"],["doc:\/\/Swidux\/documentation\/Swidux","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]]},"references":{"doc://Swidux/documentation/Swidux/AgentSkill":{"role":"article","abstract":[{"type":"text","text":"Install the bundled "},{"type":"codeVoice","code":"swidux-ref"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"title":"Using the Swidux Agent Skill","type":"topic","url":"\/documentation\/swidux\/agentskill","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill"},"doc://Swidux/documentation/Swidux/HowToAddICloudSync":{"role":"article","abstract":[{"type":"text","text":"Layer opt-in, cross-device iCloud sync on top of "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" with the "},{"type":"codeVoice","code":"SwiduxCloudKitSync"},{"type":"text","text":" plugin — including a runtime opt-out toggle, launch-time entitlement detection, and the Apple Developer portal configuration."}],"title":"Add iCloud Sync","type":"topic","url":"\/documentation\/swidux\/howtoaddicloudsync","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},"doc://Swidux/documentation/Swidux/HowToAddAnalytics":{"role":"article","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoic