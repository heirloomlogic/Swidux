{"sections":[],"abstract":[{"text":"A typed, Codable-only key\/value store for scalar preferences.","type":"text"}],"metadata":{"roleHeading":"Protocol","externalID":"s:6Swidux13KeyValueStoreP","modules":[{"name":"Swidux"}],"navigatorTitle":[{"text":"KeyValueStore","kind":"identifier"}],"symbolKind":"protocol","title":"KeyValueStore","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyValueStore"}],"role":"symbol"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KVKey","doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore"],"anchor":"Preferences","title":"Preferences"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"paths":["\/documentation\/swidux\/keyvaluestore"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/contains(_:)","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/removeValue(for:)","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)"],"anchor":"Instance-Methods","title":"Instance Methods"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyValueStore"},{"kind":"text","text":" : "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP","text":"Sendable"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Apps inject a "},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":" through their "},{"code":"Environment","type":"codeVoice"},{"type":"text","text":", hydrate initial"},{"type":"text","text":" "},{"type":"text","text":"state from it once at app start, and write to it from effects:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Environment","struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","}","","\/\/ Hydration","extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(theme: store.value(.theme) ?? .system)","    }","}","","\/\/ Reducer + effect","case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"]},{"level":2,"text":"Hydration-only reads","anchor":"Hydration-only-reads","type":"heading"},{"inlineContent":[{"type":"text","text":"Reads are intended for "},{"type":"strong","inlineContent":[{"type":"text","text":"hydration at app start"}]},{"type":"text","text":", not mid-cycle reads from"},{"type":"text","text":" "},{"type":"text","text":"reducers. UserDefaults itself is thread-safe, but a reducer reading while an"},{"type":"text","text":" "},{"type":"text","text":"effect writes creates ordering ambiguity. Reducers that need a preference"},{"type":"text","text":" "},{"type":"text","text":"should read it once into state and then observe state."}],"type":"paragraph"},{"level":2,"text":"Failures","anchor":"Failures","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Decode","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"value(_:)"},{"type":"text","text":"): missing keys and decode failures both return"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". Decode failures are logged via "},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Encode","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"setValue(_:for:)"},{"type":"text","text":"): encode failures are logged and trigger"},{"type":"text","text":" "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":" in DEBUG. Production builds log and continue. The API"},{"type":"text","text":" "},{"type":"text","text":"does not throw — encoder errors are programmer mistakes (e.g. "},{"type":"codeVoice","code":"Float.nan"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and there is no useful runtime recovery from inside an effect."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Backing store unavailable","type":"text"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"setValue(_:for:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"removeValue(for:)"},{"type":"text","text":" "},{"type":"text","text":"return "},{"type":"codeVoice","code":"false"},{"type":"text","text":". The result is "},{"type":"codeVoice","code":"@discardableResult"},{"type":"text","text":", so writes that cannot"},{"type":"text","text":" "},{"type":"text","text":"fail meaningfully stay a single line. This matters for"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"},{"type":"text","text":", where an unsigned or unentitled build cannot"},{"type":"text","text":" "},{"type":"text","text":"reach the keychain at all. No caller can fix that, so it logs and returns"},{"type":"text","text":" "},{"type":"text","text":"instead of trapping."}]}]}],"type":"unorderedList"},{"level":2,"text":"Schema migration","anchor":"Schema-migration","type":"heading"},{"inlineContent":[{"code":"Codable","type":"codeVoice"},{"type":"text","text":" shape changes that aren’t backward-compatible should declare a"},{"type":"text","text":" "},{"type":"text","text":"new versioned key (e.g. "},{"code":"theme.v2","type":"codeVoice"},{"type":"text","text":"); this protocol does not provide"},{"type":"text","text":" "},{"type":"text","text":"migration."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","relationshipsSections":[{"type":"inheritsFrom","identifiers":["doc:\/\/Swidux\/s8SendableP","doc:\/\/Swidux\/s16SendableMetatypeP"],"kind":"relationships","title":"Inherits From"},{"type":"conformingTypes","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore"],"kind":"relationships","title":"Conforming Types"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","interfaceLanguage":"swift"},"references":{"doc://Swidux/s8SendableP":{"identifier":"doc:\/\/Swidux\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://Swidux/documentation/Swidux/InMemoryKeyValueStore":{"navigatorTitle":[{"kind":"identifier","text":"InMemoryKeyValueStore"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","title":"InMemoryKeyValueStore","type":"topic","url":"\/documentation\/swidux\/inmemorykeyvaluestore","abstract":[{"text":"In-memory ","type":"text"},{"type":"codeVoice","code":"KeyValueStore"},{"text":" for tests.","type":"text"}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"InMemoryKeyValueStore","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/UserDefaultsKeyValueStore":{"abstract":[{"type":"text","text":"A "},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":" backed by a "},{"code":"UserDefaults","type":"codeVoice"},{"type":"text","text":" suite."}],"title":"UserDefaultsKeyValueStore","role":"symbol","type":"topic","url":"\/documentation\/swidux\/userdefaultskeyvaluestore","navigatorTitle":[{"text":"UserDefaultsKeyValueStor