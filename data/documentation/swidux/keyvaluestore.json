 "},{"type":"text","text":"state from it once at app start, and write to it from effects:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Environment","struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","}","","\/\/ Hydration","extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(theme: store.value(.theme) ?? .system)","    }","}","","\/\/ Reducer + effect","case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"],"type":"codeListing"},{"level":2,"anchor":"Hydration-only-reads","text":"Hydration-only reads","type":"heading"},{"inlineContent":[{"type":"text","text":"Reads are intended for "},{"type":"strong","inlineContent":[{"type":"text","text":"hydration at app start"}]},{"type":"text","text":", not mid-cycle reads from"},{"type":"text","text":" "},{"type":"text","text":"reducers. UserDefaults itself is thread-safe, but a reducer reading while an"},{"type":"text","text":" "},{"type":"text","text":"effect writes creates ordering ambiguity. Reducers that need a preference"},{"type":"text","text":" "},{"type":"text","text":"should read it once into state and then observe state."}],"type":"paragraph"},{"anchor":"Failures","level":2,"text":"Failures","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Decode","type":"text"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"value(_:)"},{"text":"): missing keys and decode failures both return","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". Decode failures are logged via "},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Encode"}],"type":"strong"},{"text":" (","type":"text"},{"code":"setValue(_:for:)","type":"codeVoice"},{"type":"text","text":"): encode failures are logged and trigger"},{"type":"text","text":" "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":" in DEBUG. Production builds log and continue. The API"},{"type":"text","text":" "},{"type":"text","text":"does not throw — encoder errors are programmer mistakes (e.g. "},{"code":"Float.nan","type":"codeVoice"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and there is no useful runtime recovery from inside an effect."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Backing store unavailable"}],"type":"strong"},{"type":"text","text":": "},{"type":"codeVoice","code":"setValue(_:for:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"removeValue(for:)"},{"type":"text","text":" "},{"type":"text","text":"return "},{"type":"codeVoice","code":"false"},{"type":"text","text":". The result is "},{"type":"codeVoice","code":"@discardableResult"},{"type":"text","text":", so writes that cannot"},{"type":"text","text":" "},{"type":"text","text":"fail meaningfully stay a single line. This matters for"},{"type":"text","text":" "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true,"type":"reference"},{"type":"text","text":", where an unsigned or unentitled build cannot"},{"type":"text","text":" "},{"type":"text","text":"reach the keychain at all. No caller can fix that, so it logs and returns"},{"type":"text","text":" "},{"type":"text","text":"instead of trapping."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Schema-migration","level":2,"type":"heading","text":"Schema migration"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Codable"},{"type":"text","text":" shape changes that aren’t backward-compatible should declare a"},{"type":"text","text":" "},{"type":"text","text":"new versioned key (e.g. "},{"type":"codeVoice","code":"theme.v2"},{"type":"text","te