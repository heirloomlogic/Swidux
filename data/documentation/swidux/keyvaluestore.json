{"metadata":{"externalID":"s:6Swidux13KeyValueStoreP","roleHeading":"Protocol","modules":[{"name":"Swidux"}],"symbolKind":"protocol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeyValueStore","kind":"identifier"}],"navigatorTitle":[{"text":"KeyValueStore","kind":"identifier"}],"title":"KeyValueStore","role":"symbol"},"seeAlsoSections":[{"title":"Preferences","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KVKey","doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore"],"generated":true,"anchor":"Preferences"}],"abstract":[{"text":"A typed, Codable-only key\/value store for scalar preferences.","type":"text"}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"relationshipsSections":[{"kind":"relationships","title":"Inherits From","identifiers":["doc:\/\/Swidux\/s8SendableP","doc:\/\/Swidux\/s16SendableMetatypeP"],"type":"inheritsFrom"},{"kind":"relationships","title":"Conforming Types","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore"],"type":"conformingTypes"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeyValueStore","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","preciseIdentifier":"s:s8SendableP","kind":"typeIdentifier"}]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Apps inject a ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":" through their ","type":"text"},{"code":"Environment","type":"codeVoice"},{"text":", hydrate initial","type":"text"},{"text":" ","type":"text"},{"text":"state from it once at app start, and write to it from effects:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Environment","struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","}","","\/\/ Hydration","extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(theme: store.value(.theme) ?? .system)","    }","}","","\/\/ Reducer + effect","case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"],"type":"codeListing"},{"text":"Hydration-only reads","level":2,"anchor":"Hydration-only-reads","type":"heading"},{"inlineContent":[{"text":"Reads are intended for ","type":"text"},{"inlineContent":[{"text":"hydration at app start","type":"text"}],"type":"strong"},{"text":", not mid-cycle reads from","type":"text"},{"text":" ","type":"text"},{"text":"reducers. UserDefaults itself is thread-safe, but a reducer reading while an","type":"text"},{"text":" ","type":"text"},{"text":"effect writes creates ordering ambiguity. Reducers that need a preference","type":"text"},{"text":" ","type":"text"},{"text":"should read it once into state and then observe state.","type":"text"}],"type":"paragraph"},{"text":"Failures","level":2,"anchor":"Failures","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Decode"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"value(_:)"},{"type":"text","text":"): missing keys and decode failures both return"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". Decode failures are logged via "},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Encode"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"setValue(_:for:)"},{"type":"text","text":"): encode failures are logged and trigger"},{"type":"text","text":" "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":" in DEBUG. Production builds log and continue. The API"},{"type":"text","text":" "},{"type":"text","text":"does not throw — encoder errors are programmer mistakes (e.g. "},{"type":"codeVoice","code":"Float.nan"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and there is no useful runtime recovery from inside an effect."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Backing store unavailable"}]},{"type":"text","text":": "},{"type":"codeVoice","code":"setValue(_:for:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"removeValue(for:)"},{"type":"text","text":" "},{"type":"text","text":"return "},{"type":"codeVoice","code":"false"},{"type":"text","text":". The result is "},{"type":"codeVoice","code":"@discardableResult"},{"type":"text","text":", so writes that cannot"},{"type":"text","text":" "},{"type":"text","text":"fail meaningfully stay a single line. This matters for"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"},{"type":"text","text":", where an unsigned or unentitled build cannot"},{"type":"text","text":" "},{"type":"text","text":"reach the keychain at all. No caller can fix that, so it logs and returns"},{"type":"text","text":" "},{"type":"text","text":"instead of trapping."}]}]}],"type":"unorderedList"},{"text":"Schema migration","level":2,"anchor":"Schema-migration","type":"heading"},{"inlineContent":[{"code":"Codable","type":"codeVoice"},{"text":" shape changes that aren’t backward-compatible should declare a","type":"text"},{"text":" ","type":"text"},{"text":"new versioned key (e.g. ","type":"text"},{"code":"theme.v2","type":"codeVoice