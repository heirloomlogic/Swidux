{"sections":[],"abstract":[{"text":"A typed, Codable-only key\/value store for scalar preferences.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeyValueStore","kind":"identifier"},{"text":" : ","kind":"text"},{"text":"Sendable","kind":"typeIdentifier","preciseIdentifier":"s:s8SendableP"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Apps inject a "},{"type":"codeVoice","code":"KeyValueStore"},{"type":"text","text":" through their "},{"type":"codeVoice","code":"Environment"},{"type":"text","text":", hydrate initial"},{"type":"text","text":" "},{"type":"text","text":"state from it once at app start, and write to it from effects:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Environment","struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","}","","\/\/ Hydration","extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(theme: store.value(.theme) ?? .system)","    }","}","","\/\/ Reducer + effect","case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"],"type":"codeListing"},{"anchor":"Hydration-only-reads","level":2,"text":"Hydration-only reads","type":"heading"},{"inlineContent":[{"type":"text","text":"Reads are intended for "},{"type":"strong","inlineContent":[{"type":"text","text":"hydration at app start"}]},{"type":"text","text":", not mid-cycle reads from"},{"type":"text","text":" "},{"type":"text","text":"reducers. UserDefaults itself is thread-safe, but a reducer reading while an"},{"type":"text","text":" "},{"type":"text","text":"effect writes creates ordering ambiguity. Reducers that need a preference"},{"type":"text","text":" "},{"type":"text","text":"should read it once into state and then observe state."}],"type":"paragraph"},{"anchor":"Failures","level":2,"text":"Failures","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Decode"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"value(_:)"},{"type":"text","text":"): missing keys and decode failures both return"},{"type":"text","text":" "},{"type":"codeVoice","code":"nil"},{"type":"text","text":". Decode failures are logged via "},{"type":"codeVoice","code":"os.Logger"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Encode"}]},{"type":"text","text":" ("},{"type":"codeVoice","code":"setValue(_:for:)"},{"type":"text","text":"): encode failures are logged and trigger"},{"type":"text","text":" "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":" in DEBUG. Production builds log and continue. The API"},{"type":"text","text":" "},{"type":"text","text":"does not throw — encoder errors are programmer mistakes (e.g. "},{"type":"codeVoice","code":"Float.nan"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and there is no useful runtime recovery from inside an effect."}]}]}],"type":"unorderedList"},{"anchor":"Schema-migration","level":2,"text":"Schema migration","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Codable"},{"type":"text","text":" shape changes that aren’t backward-compatible should declare a"},{"type":"text","text":" "},{"type":"text","text":"new versioned key (e.g. "},{"type":"codeVoice","code":"theme.v2"},{"type":"text","text":"); this protocol does not provide"},{"type":"text","text":" "},{"type":"text","text":"migration."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"t