{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyValueStore"},{"kind":"text","text":" : "},{"preciseIdentifier":"s:s8SendableP","text":"Sendable","kind":"typeIdentifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Apps inject a "},{"type":"codeVoice","code":"KeyValueStore"},{"text":" through their ","type":"text"},{"code":"Environment","type":"codeVoice"},{"text":", hydrate initial","type":"text"},{"text":" ","type":"text"},{"text":"state from it once at app start, and write to it from effects:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Environment","struct AppEnvironment: Sendable {","    var keyValue: any KeyValueStore","}","","\/\/ Hydration","extension AppState {","    static func hydrated(from store: any KeyValueStore) -> AppState {","        AppState(theme: store.value(.theme) ?? .system)","    }","}","","\/\/ Reducer + effect","case .themeChanged(let theme):","    state.theme = theme","    return { @Sendable _ in","        environment.keyValue.setValue(theme, for: .theme)","    }"],"syntax":"swift"},{"text":"Hydration-only reads","type":"heading","anchor":"Hydration-only-reads","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reads are intended for "},{"inlineContent":[{"type":"text","text":"hydration at app start"}],"type":"strong"},{"type":"text","text":", not mid-cycle reads from"},{"text":" ","type":"text"},{"type":"text","text":"reducers. UserDefaults itself is thread-safe, but a reducer reading while an"},{"type":"text","text":" "},{"type":"text","text":"effect writes creates ordering ambiguity. Reducers that need a preference"},{"type":"text","text":" "},{"type":"text","text":"should read it once into state and then observe state."}]},{"type":"heading","level":2,"text":"Failures","anchor":"Failures"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Decode","type":"text"}],"type":"strong"},{"text":" (","type":"text"},{"code":"value(_:)","type":"codeVoice"},{"text":"): missing keys and decode failures both return","type":"text"},{"type":"text","text":" "},{"code":"nil","type":"codeVoice"},{"type":"text","text":". Decode failures are logged via "},{"code":"os.Logger","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Encode","type":"text"}]},{"type":"text","text":" ("},{"code":"setValue(_:for:)","type":"codeVoice"},{"text":"): encode failures are logged and trigger","type":"text"},{"text":" ","type":"text"},{"code":"assertionFailure","type":"codeVoice"},{"text":" in DEBUG. Production builds log and continue. The API","type":"text"},{"text":" ","type":"text"},{"text":"does not throw — encoder errors are programmer mistakes (e.g. ","type":"text"},{"code":"Float.nan","type":"codeVoice"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"and there is no useful runtime recovery from inside an effect.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Backing store unavailable"}],"type":"strong"},{"type":"text","text":": "},{"code":"setValue(_:for:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"removeValue(for:)","type":"codeVoice"},{"type":"text","text":" "},{"text":"return ","type":"text"},{"code":"false","type":"codeVoice"},{"text":". The result is ","type":"text"},{"code":"@discardableResult","type":"codeVoice"},{"type":"text","text":", so writes that cannot"},{"text":" ","type":"text"},{"type":"text","text":"fail meaningfully stay a single line. This matters for"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true,"type":"reference"},{"text":", where an unsigned or unentitled build cannot","type":"text"},{"type":"text","text":" "},{"text":"reach the keychain at all. No caller can fix that, so it logs and returns","type":"text"},{"type":"text","text":" "},{"text":"instead of trapping.","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","anchor":"Schema-migration","text":"Schema migration","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Codable"},{"type":"text","text":" shape changes that aren’t backward-compatible should declare a"},{"type":"text","text":" "},{"type":"text","text":"new versioned key (e.g. "},{"code":"theme.v2","type":"codeVoice"},{"type":"text","text":"); this protocol does not provide"},{"text":" ","type":"text"},{"type":"text","text":"migration."}]}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swidux\/keyvaluestore"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"topicSections":[{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/contains(_:)","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/deviceIdentity(key:)","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/removeValue(for:)","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/setValue(_:for:)","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore\/value(_:)"]}],"metadata":{"externalID":"s:6Swidux13KeyValueStoreP","title":"KeyValueStore","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeyValueStore"}],"symbolKind":"protocol","navigatorTitle":[{"kind":"identifier","text":"KeyValueStore"}],"roleHeading":"Protocol","modules":[{"name":"Swidux"}],"role":"symbol"},"abstract":[{"type":"text","text":"A typed, Codable-only key\/value store for scalar preferences."}],