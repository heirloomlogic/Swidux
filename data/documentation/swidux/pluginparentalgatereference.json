{"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" ships as a separate library target alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":". It provides a single domain plugin ("},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","isActive":true},{"type":"text","text":". For the underlying plugin contract, see "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"Library target","anchor":"Library-target"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" product as a target dependency, then import it where you wire the store and present the gate sheet:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxParentalGate"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package vends three library products: "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":", and "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":". Pull in only what you use."}]},{"level":2,"type":"heading","text":"Types","anchor":"Types"},{"level":3,"type":"heading","text":"ParentalGatePlugin","anchor":"ParentalGatePlugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"MainActor"},{"type":"text","text":"-bound domain plugin generic over the host app’s root state and action types."}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The three wiring closures follow the standard domain-plugin shape described in "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action."}]},{"level":3,"type":"heading","text":"ParentalGateState","anchor":"ParentalGateState"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The state slice the plugin owns."}]},{"type":"codeListing","syntax":"swift","code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" — non-"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" while a challenge is active. Drives sheet presentation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"challenge"},{"type":"text","text":" — the currently-presented arithmetic problem."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"attempts"},{"type":"text","text":" — count of incorrect submissions against the current challenge."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" — reasons already cleared this session (see action semantics below)."}]}]}]},{"level":3,"type":"heading","text":"ParentalGateAction","anchor":"ParentalGateAction"},{"type":"codeListing","syntax":"swift","code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"]},{"level":3,"type":"heading","text":"MathChallenge","anchor":"MathChallenge"},{"type":"codeListing","syntax":"swift","code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expected"},{"type":"text","text":" computes the correct answer from "},{"type":"codeVoice","code":"left"},{"type":"text","text":", "},{"type":"codeVoice","code":"right"},{"type":"text","text":", and "},{"type":"codeVoice","code":"op"},{"type":"text","text":". "},{"type":"codeVoice","code":"Op.symbol"},{"type":"text","text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7)."}]},{"level":3,"type":"heading","text":"ParentalChallengeSource","anchor":"ParentalChallengeSource"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A value-type holder for a challenge generator closure."}]},{"type":"codeListing","syntax":"swift","code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.standard"},{"type":"text","text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.fixed(_:)"},{"type":"text","text":" — always returns the supplied challenge. Use this in tests."}]}]}]},{"level":2,"type":"heading","text":"Action semantics","anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"ParentalGateAction"},{"type":"text","text":" case mutates the state slice as follows:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".request(reason:)"}],"type":"strong"},{"type":"text","text":" — If "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" already contains "},{"type":"codeVoice","code":"reason"},{"type":"text","text":", the plugin returns an effect that immediately dispatches "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" and leaves "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" unchanged. Otherwise, it sets "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", generates a fresh "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and resets "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" to "},{"type":"codeVoice","code":"0"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".dismiss"}],"type":"strong"},{"type":"text","text":" — Clears "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":". Does not modify "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".regenerateChallenge"}],"type":"strong"},{"type":"text","text":" — Replaces "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" with a freshly generated one. Useful for a “new question” button."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".submitAnswer(Int)"}],"type":"strong"},{"type":"text","text":" — Compares against "},{"type":"codeVoice","code":"challenge.expected"},{"type":"text","text":". Returns an effect that dispatches either "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" (with the current "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":") or "},{"type":"codeVoice","code":".answerRejected"},{"type":"text","text":". No-op if "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" or "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".answerAccepted(reason:)"}],"type":"strong"},{"type":"text","text":" — Inserts "},{"type":"codeVoice","code":"reason"},{"type":"text","text":" into "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".answerRejected"}],"type":"strong"},{"type":"text","text":" — Increments "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" so the user faces a new problem."}]}]}]},{"level":3,"type":"heading","text":"Session-pass behavior","anchor":"Session-pass-behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once a reason is in "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", subsequent "},{"type":"codeVoice","code":".request(reason:)"},{"type":"text","text":" calls for that same reason short-circuit: the plugin dispatches "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"Set<String>"},{"type":"text","text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate "},{"type":"codeVoice","code":"state.parentalGate.passedReasons"},{"type":"text","text":" from your own reducer (for example, in response to an "},{"type":"codeVoice","code":"app\/lock"},{"type":"text","text":" action)."}]},{"level":2,"type":"heading","text":"Customizing the challenge","anchor":"Customizing-the-challenge"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource"},{"type":"text","text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:"}]},{"type":"codeListing","syntax":"swift","code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The generator runs synchronously each time the plugin needs a new challenge (on "},{"type":"codeVoice","code":".request"},{"type":"text","text":", "},{"type":"codeVoice","code":".regenerateChallenge"},{"type":"text","text":", and "},{"type":"codeVoice","code":".answerRejected"},{"type":"text","text":"). Keep it cheap and pure — no I\/O."}]}]}],"metadata":{"modules":[{"name":"Swidux"}],"title":"SwiduxParentalGate Reference","role":"article","roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginparentalgatereference"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"title":"Reference","generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"anchor":"Reference"}],"references":{"doc://Swidux/documentation/Swidux/GettingStarted":{"abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"url":"\/documentation\/swidux\/gettingstarted","title":"Getting Started with Swidux","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},"doc://Swidux/documentation/Swidux/MacrosReference":{"role":"article","type":"topic","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" — the two macros that generate the observation bridge between value-type state and SwiftUI."}],"url":"\/documentation\/swidux\/macrosreference","kind":"article","title":"Macros","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"url":"\/documentation\/swidux\/entitystoreguide","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"title":"EntityStore","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide"},"doc://Swidux/documentation/Swidux/UndoRedo":{"url":"\/documentation\/swidux\/undoredo","abstract":[{"type":"text","text":"Add stack-based undo\/redo to your app with "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true},{"type":"text","text":"."}],"title":"Undo \/ Redo","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"title":"Add a Parental Gate","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"url":"\/documentation\/swidux\/persistencemiddlewareguide","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"title":"Persistence Middleware","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"url":"\/documentation\/swidux\/pluginpaywallreference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"title":"SwiduxPaywall Reference","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"url":"\/documentation\/swidux\/pluginarchitecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"title":"Plugin Architecture","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"url":"\/documentation\/swidux\/pluginkillswitchreference","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"title":"SwiduxKillswitch Reference","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","role":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"kind":"article","title":"SwiduxAnalytics Reference","url":"\/documentation\/swidux\/pluginanalyticsreference"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"url":"\/documentation\/swidux\/pluginfeatureflagsreference","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"title":"SwiduxFeatureFlags Reference","type":"topic","role":"article","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference"},"doc://Swidux/documentation/Swidux":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","abstract":[{"type":"text","