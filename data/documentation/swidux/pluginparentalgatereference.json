{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" ships as a separate library target alongside ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":". It provides a single domain plugin (","type":"text"},{"code":"ParentalGatePlugin","type":"codeVoice"},{"text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},{"text":". For the underlying plugin contract, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}]},{"type":"heading","text":"Library target","anchor":"Library-target","level":2},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" product as a target dependency, then import it where you wire the store and present the gate sheet:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxParentalGate"]},{"type":"paragraph","inlineContent":[{"text":"The package vends three library products: ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":". Pull in only what you use.","type":"text"}]},{"type":"heading","text":"Types","anchor":"Types","level":2},{"type":"heading","text":"ParentalGatePlugin","anchor":"ParentalGatePlugin","level":3},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"MainActor","type":"codeVoice"},{"text":"-bound domain plugin generic over the host app’s root state and action types.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"]},{"type":"paragraph","inlineContent":[{"text":"The three wiring closures follow the standard domain-plugin shape described in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action.","type":"text"}]},{"type":"heading","text":"ParentalGateState","anchor":"ParentalGateState","level":3},{"type":"paragraph","inlineContent":[{"text":"The state slice the plugin owns.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"pendingReason"},{"text":" — non-","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" while a challenge is active. Drives sheet presentation.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"challenge"},{"text":" — the currently-presented arithmetic problem.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"attempts"},{"text":" — count of incorrect submissions against the current challenge.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"text":" — reasons already cleared this session (see action semantics below).","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"ParentalGateAction","anchor":"ParentalGateAction","level":3},{"type":"codeListing","syntax":"swift","code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"]},{"type":"heading","text":"MathChallenge","anchor":"MathChallenge","level":3},{"type":"codeListing","syntax":"swift","code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"expected","type":"codeVoice"},{"text":" computes the correct answer from ","type":"text"},{"code":"left","type":"codeVoice"},{"text":", ","type":"text"},{"code":"right","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"op","type":"codeVoice"},{"text":". ","type":"text"},{"code":"Op.symbol","type":"codeVoice"},{"text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7).","type":"text"}]},{"type":"heading","text":"ParentalChallengeSource","anchor":"ParentalChallengeSource","level":3},{"type":"paragraph","inlineContent":[{"text":"A value-type holder for a challenge generator closure.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.standard"},{"text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.fixed(_:)"},{"text":" — always returns the supplied challenge. Use this in tests.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Action semantics","anchor":"Action-semantics","level":2},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"code":"ParentalGateAction","type":"codeVoice"},{"text":" case mutates the state slice as follows:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".request(reason:)"}],"type":"strong"},{"text":" — If ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":" already contains ","type":"text"},{"type":"codeVoice","code":"reason"},{"text":", the plugin returns an effect that immediately dispatches ","type":"text"},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"text":" and leaves ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":" unchanged. Otherwise, it sets ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":", generates a fresh ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":", and resets ","type":"text"},{"type":"codeVoice","code":"attempts"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"0"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".dismiss"}],"type":"strong"},{"text":" — Clears ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":", ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"attempts"},{"text":". Does not modify ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".regenerateChallenge"}],"type":"strong"},{"text":" — Replaces ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":" with a freshly generated one. Useful for a “new question” button.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".submitAnswer(Int)"}],"type":"strong"},{"text":" — Compares against ","type":"text"},{"type":"codeVoice","code":"challenge.expected"},{"text":". Returns an effect that dispatches either ","type":"text"},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"text":" (with the current ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":") or ","type":"text"},{"type":"codeVoice","code":".answerRejected"},{"text":". No-op if ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".answerAccepted(reason:)"}],"type":"strong"},{"text":" — Inserts ","type":"text"},{"type":"codeVoice","code":"reason"},{"text":" into ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":", clears ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":", ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"attempts"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".answerRejected"}],"type":"strong"},{"text":" — Increments ","type":"text"},{"type":"codeVoice","code":"attempts"},{"text":" and regenerates ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":" so the user faces a new problem.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Session-pass behavior","anchor":"Session-pass-behavior","level":3},{"type":"paragraph","inlineContent":[{"text":"Once a reason is in ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", subsequent ","type":"text"},{"code":".request(reason:)","type":"codeVoice"},{"text":" calls for that same reason short-circuit: the plugin dispatches ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" is a "},{"code":"Set<String>","type":"codeVoice"},{"type":"text","text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate "},{"code":"state.parentalGate.passedReasons","type":"codeVoice"},{"type":"text","text":" from your own reducer (for example, in response to an "},{"code":"app\/lock","type":"codeVoice"},{"type":"text","text":" action)."}]},{"type":"heading","text":"Customizing the challenge","anchor":"Customizing-the-challenge","level":2},{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource","type":"codeVoice"},{"type":"text","text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:"}]},{"type":"codeListing","syntax":"swift","code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"]},{"type":"paragraph","inlineContent":[{"text":"The generator runs synchronously each time the plugin needs a new challenge (on ","type":"text"},{"type":"codeVoice","code":".request"},{"text":", ","type":"text"},{"type":"codeVoice","code":".regenerateChallenge"},{"text":", and ","type":"text"},{"type":"codeVoice","code":".answerRejected"},{"text":"). Keep it cheap and pure — no I\/O.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/swidux\/pluginparentalgatereference"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"API surface for the "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"title":"Reference","generated":true,"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/M