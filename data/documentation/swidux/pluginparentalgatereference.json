{"variants":[{"paths":["\/documentation\/swidux\/pluginparentalgatereference"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" ships as a separate library target alongside "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":". It provides a single domain plugin ("},{"code":"ParentalGatePlugin","type":"codeVoice"},{"type":"text","text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","isActive":true,"type":"reference"},{"type":"text","text":". For the underlying plugin contract, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Library target","anchor":"Library-target","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" product as a target dependency, then import it where you wire the store and present the gate sheet:"}],"type":"paragraph"},{"code":["import SwiduxParentalGate"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The package vends three library products: "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":", and "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":". Pull in only what you use."}],"type":"paragraph"},{"text":"Types","anchor":"Types","level":2,"type":"heading"},{"text":"ParentalGatePlugin","anchor":"ParentalGatePlugin","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"code":"MainActor","type":"codeVoice"},{"type":"text","text":"-bound domain plugin generic over the host app’s root state and action types."}],"type":"paragraph"},{"code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The three wiring closures follow the standard domain-plugin shape described in "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"type":"text","text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action."}],"type":"paragraph"},{"text":"ParentalGateState","anchor":"ParentalGateState","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"The state slice the plugin owns."}],"type":"paragraph"},{"code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"],"type":"codeListing","syntax":"swift"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pendingReason"},{"text":" — non-","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" while a challenge is active. Drives sheet presentation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"challenge"},{"text":" — the currently-presented arithmetic problem.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"attempts"},{"text":" — count of incorrect submissions against the current challenge.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"text":" — reasons already cleared this session (see action semantics below).","type":"text"}]}]}],"type":"unorderedList"},{"text":"ParentalGateAction","anchor":"ParentalGateAction","level":3,"type":"heading"},{"code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"],"type":"codeListing","syntax":"swift"},{"text":"MathChallenge","anchor":"MathChallenge","level":3,"type":"heading"},{"code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"code":"expected","type":"codeVoice"},{"type":"text","text":" computes the correct answer from "},{"code":"left","type":"codeVoice"},{"type":"text","text":", "},{"code":"right","type":"codeVoice"},{"type":"text","text":", and "},{"code":"op","type":"codeVoice"},{"type":"text","text":". "},{"code":"Op.symbol","type":"codeVoice"},{"type":"text","text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7)."}],"type":"paragraph"},{"text":"ParentalChallengeSource","anchor":"ParentalChallengeSource","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"A value-type holder for a challenge generator closure."}],"type":"paragraph"},{"code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"],"type":"codeListing","syntax":"swift"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.standard"},{"text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.fixed(_:)"},{"text":" — always returns the supplied challenge. Use this in tests.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Action semantics","anchor":"Action-semantics","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Each "},{"code":"ParentalGateAction","type":"codeVoice"},{"type":"text","text":" case mutates the state slice as follows:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".request(reason:)"}]},{"text":" — If ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":" already contains ","type":"text"},{"type":"codeVoice","code":"reason"},{"text":", the plugin returns an effect that immediately dispatches ","type":"text"},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"text":" and leaves ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" unchanged. Otherwise, it sets "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", generates a fresh "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and resets "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" to "},{"type":"codeVoice","code":"0"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".dismiss","type":"codeVoice"}]},{"type":"text","text":" — Clears "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":". Does not modify "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".regenerateChallenge"}]},{"type":"text","text":" — Replaces "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" with a freshly generated one. Useful for a “new question” button."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".submitAnswer(Int)"}]},{"text":" — Compares against ","type":"text"},{"code":"challenge.expected","type":"codeVoice"},{"text":". Returns an effect that dispatches either ","type":"text"},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"text":" (with the current ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":") or ","type":"text"},{"code":".answerRejected","type":"codeVoice"},{"text":". No-op if ","type":"text"},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" or "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".answerAccepted(reason:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Inserts "},{"type":"codeVoice","code":"reason"},{"type":"text","text":" into "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", clears "},{"code":"pendingReason","type":"codeVoice"},{"text":", ","type":"text"},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", and "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".answerRejected"}]},{"type":"text","text":" — Increments "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" so the user faces a new problem."}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Session-pass behavior","anchor":"Session-pass-behavior","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once a reason is in "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":", subsequent "},{"code":".request(reason:)","type":"codeVoice"},{"type":"text","text":" calls for that same reason short-circuit: the plugin dispatches "},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"type":"text","text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session."}]},{"type":"paragraph","inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" is a "},{"code":"Set<String>","type":"codeVoice"},{"type":"text","text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate "},{"code":"state.parentalGate.passedReasons","type":"codeVoice"},{"type":"text","text":" from your own reducer (for example, in response to an "},{"code":"app\/lock","type":"codeVoice"},{"type":"text","text":" action)."}]},{"level":2,"anchor":"Customizing-the-challenge","type":"heading","text":"Customizing the challenge"},{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource","type":"codeVoice"},{"text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The generator runs synchronously each time the plugin needs a new challenge (on "},{"type":"codeVoice","code":".request"},{"type":"text","text":", "},{"type":"codeVoice","code":".regenerateChallenge"},{"type":"text","text":", and "},{"type":"codeVoice","code":".answerRejected"},{"type":"text","text":"). Keep it cheap and pure — no I\/O."}]}]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}],"title":"SwiduxParentalGate Reference"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"anchor":"Reference","generated":true,"title":"Reference"}],"references":{"doc://Swidux/documentation/Swidux/UndoPlugin":{"title":"UndoPlugin","url":"\/documentation\/swidux\/undoplugin","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"kind":"symbol","abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"role":"article","url":"\/documentation\/swidux\/pluginarchitecture","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic","title":"Plugin Architecture","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}]},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"title":"Persistence Middleware","url":"\/documentation\/swidux\/persistencemiddlewareguide","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","role":"article","kind":"article","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}]},"doc://Swidux/documentation/Swidux/UndoRedo":{"title":"Undo \/ Redo","url":"\/documentation\/swidux\/undoredo","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","role":"article","kind":"article","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":".","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"role":"article","url":"\/documentation\/swidux\/pluginpaywallreference","kind":"article","type":"topic","title":"SwiduxPaywall Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","role":"article","kind":"article","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}]},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"role":"collectionGroup","url":"\/documentation\/swidux\/keyvaluestoreguide","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","type":"topic","title":"KeyValueStore","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}]},"doc://Swidux/documentation/Swidux/MacrosReference":{"title":"Macros","url":"\/documentation\/swidux\/macrosreference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","role":"article","kind":"article","abstract":[{"text":"Reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" — the two macros that generate the observation bridge between value-type state and SwiftUI.","type":"text"}]},"doc://Swidux/documentation/Swidux":{"role":"collection","url":"\/documentation\/swidux","kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux","type":"topic","title":"Swidux","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"title":"SwiduxKillswitch Reference","url":"\/documentation\/swidux\/pluginkillswitchreference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","role":"article","kind":"article","abstract":[{"text":"Public API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}]},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"title":"EntityStore","url":"\/documentation\/swidux\/entitystoreguide","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","role":"article","kind":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}]},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"title":"Add a Parental Gate","url":"\/documentation\/swidux\/howtoaddaparentalgate","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","role":"article","kind":"article","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}]}}}