{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginparentalgatereference"]}],"abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"generated":true,"title":"Reference","anchor":"Reference"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" ships as a separate library target alongside "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":". It provides a single domain plugin ("},{"code":"ParentalGatePlugin","type":"codeVoice"},{"type":"text","text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},{"type":"text","text":". For the underlying plugin contract, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Library-target","text":"Library target"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" product as a target dependency, then import it where you wire the store and present the gate sheet:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxParentalGate"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package vends three library products: "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":", and "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":". Pull in only what you use."}]},{"type":"heading","level":2,"anchor":"Types","text":"Types"},{"type":"heading","level":3,"anchor":"ParentalGatePlugin","text":"ParentalGatePlugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"code":"MainActor","type":"codeVoice"},{"type":"text","text":"-bound domain plugin generic over the host app’s root state and action types."}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"]},{"type":"paragraph","inlineContent":[{"text":"The three wiring closures follow the standard domain-plugin shape described in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action.","type":"text"}]},{"type":"heading","level":3,"anchor":"ParentalGateState","text":"ParentalGateState"},{"type":"paragraph","inlineContent":[{"text":"The state slice the plugin owns.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"pendingReason"},{"text":" — non-","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" while a challenge is active. Drives sheet presentation.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"challenge"},{"text":" — the currently-presented arithmetic problem.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"attempts"},{"text":" — count of incorrect submissions against the current challenge.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"text":" — reasons already cleared this session (see action semantics below).","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":3,"anchor":"ParentalGateAction","text":"ParentalGateAction"},{"type":"codeListing","syntax":"swift","code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"]},{"type":"heading","level":3,"anchor":"MathChallenge","text":"MathChallenge"},{"type":"codeListing","syntax":"swift","code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"expected","type":"codeVoice"},{"text":" computes the correct answer from ","type":"text"},{"code":"left","type":"codeVoice"},{"text":", ","type":"text"},{"code":"right","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"op","type":"codeVoice"},{"text":". ","type":"text"},{"code":"Op.symbol","type":"codeVoice"},{"text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7).","type":"text"}]},{"type":"heading","level":3,"anchor":"ParentalChallengeSource","text":"ParentalChallengeSource"},{"type":"paragraph","inlineContent":[{"text":"A value-type holder for a challenge generator closure.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.standard"},{"type":"text","text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.fixed(_:)"},{"type":"text","text":" — always returns the supplied challenge. Use this in tests."}]}]}]},{"type":"heading","level":2,"anchor":"Action-semantics","text":"Action semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"code":"ParentalGateAction","type":"codeVoice"},{"type":"text","text":" case mutates the state slice as follows:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".request(reason:)","type":"codeVoice"}]},{"type":"text","text":" — If "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" already contains "},{"type":"codeVoice","code":"reason"},{"type":"text","text":", the plugin returns an effect that immediately dispatches "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" and leaves "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" unchanged. Otherwise, it sets "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", generates a fresh "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and resets "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" to "},{"type":"codeVoice","code":"0"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".dismiss","type":"codeVoice"}]},{"type":"text","text":" — Clears "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":". Does not modify "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".regenerateChallenge","type":"codeVoice"}]},{"type":"text","text":" — Replaces "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" with a freshly generated one. Useful for a “new question” button."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".submitAnswer(Int)","type":"codeVoice"}]},{"type":"text","text":" — Compares against "},{"type":"codeVoice","code":"challenge.expected"},{"type":"text","text":". Returns an effect that dispatches either "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" (with the current "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":") or "},{"type":"codeVoice","code":".answerRejected"},{"type":"text","text":". No-op if "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" or "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".answerAccepted(reason:)","type":"codeVoice"}]},{"type":"text","text":" — Inserts "},{"type":"codeVoice","code":"reason"},{"type":"text","text":" into "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".answerRejected","type":"codeVoice"}]},{"type":"text","text":" — Increments "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" so the user faces a new problem."}]}]}]},{"type":"heading","level":3,"anchor":"Session-pass-behavior","text":"Session-pass behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once a reason is in "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":", subsequent "},{"code":".request(reason:)","type":"codeVoice"},{"type":"text","text":" calls for that same reason short-circuit: the plugin dispatches "},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"type":"text","text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session."}]},{"type":"paragraph","inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" is a "},{"code":"Set<String>","type":"codeVoice"},{"type":"text","text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate "},{"code":"state.parentalGate.passedReasons","type":"codeVoice"},{"type":"text","text":" from your own reducer (for example, in response to an "},{"code":"app\/lock","type":"codeVoice"},{"type":"text","text":" action)."}]},{"type":"heading","level":2,"anchor":"Customizing-the-challenge","text":"Customizing the challenge"},{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource","type":"codeVoice"},{"type":"text","text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:"}]},{"type":"codeListing","syntax":"swift","code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The generator runs synchronously each time the plugin needs a new challenge (on "},{"code":".request","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":".regenerateChallenge"},{"type":"text","text":", and "},{"type":"codeVoice","code":".answerRejected"},{"type":"text","text":"). Keep it cheap and pure — no I\/O."}]}]}],"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"SwiduxParentalGate Reference","role":"article"},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"type":"topic","url":"\/documentation\/swidux\/undoplugin","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"title":"UndoPlugin","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","kind":"article","role":"article","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" library — paywall presentation, entitlement observation, and purchase orchestration."}],"url":"\/documentation\/swidux\/pluginpaywallreference","title":"SwiduxPaywall Reference","type":"topic"},"doc://Swidux/documentation/Swidux/MacrosReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","type":"topic","url":"\/documentation\/swidux\/macrosreference","abstrac