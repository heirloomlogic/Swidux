{"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"generated":true,"title":"Reference","anchor":"Reference"}],"sections":[],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" ships as a separate library target alongside "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":". It provides a single domain plugin ("},{"code":"ParentalGatePlugin","type":"codeVoice"},{"type":"text","text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},{"type":"text","text":". For the underlying plugin contract, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Library target","anchor":"Library-target","level":2,"type":"heading"},{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" product as a target dependency, then import it where you wire the store and present the gate sheet:","type":"text"}],"type":"paragraph"},{"code":["import SwiduxParentalGate"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The package vends three library products: "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":", and "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":". Pull in only what you use."}],"type":"paragraph"},{"text":"Types","anchor":"Types","level":2,"type":"heading"},{"text":"ParentalGatePlugin","anchor":"ParentalGatePlugin","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"MainActor"},{"type":"text","text":"-bound domain plugin generic over the host app’s root state and action types."}],"type":"paragraph"},{"code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The three wiring closures follow the standard domain-plugin shape described in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"ParentalGateState","anchor":"ParentalGateState"},{"inlineContent":[{"text":"The state slice the plugin owns.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" — non-"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" while a challenge is active. Drives sheet presentation."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"challenge"},{"text":" — the currently-presented arithmetic problem.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"attempts","type":"codeVoice"},{"type":"text","text":" — count of incorrect submissions against the current challenge."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" — reasons already cleared this session (see action semantics below)."}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"ParentalGateAction","anchor":"ParentalGateAction"},{"syntax":"swift","type":"codeListing","code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"]},{"level":3,"text":"MathChallenge","anchor":"MathChallenge","type":"heading"},{"syntax":"swift","type":"codeListing","code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"]},{"inlineContent":[{"type":"codeVoice","code":"expected"},{"type":"text","text":" computes the correct answer from "},{"type":"codeVoice","code":"left"},{"type":"text","text":", "},{"type":"codeVoice","code":"right"},{"text":", and ","type":"text"},{"code":"op","type":"codeVoice"},{"text":". ","type":"text"},{"type":"codeVoice","code":"Op.symbol"},{"text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7).","type":"text"}],"type":"paragraph"},{"type":"heading","text":"ParentalChallengeSource","anchor":"ParentalChallengeSource","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"A value-type holder for a challenge generator closure."}]},{"code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"],"syntax":"swift","type":"codeListing"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.standard"},{"type":"text","text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.fixed(_:)"},{"type":"text","text":" — always returns the supplied challenge. Use this in tests."}]}]}]},{"text":"Action semantics","anchor":"Action-semantics","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"ParentalGateAction"},{"type":"text","text":" case mutates the state slice as follows:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".request(reason:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — If "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" already contains "},{"type":"codeVoice","code":"reason"},{"type":"text","text":", the plugin returns an effect that immediately dispatches "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" and leaves "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" unchanged. Otherwise, it sets "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", generates a fresh "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and resets "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" to "},{"type":"codeVoice","code":"0"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".dismiss","type":"codeVoice"}]},{"type":"text","text":" — Clears "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", "},{"code":"challenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":". Does not modify ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".regenerateChallenge"}]},{"type":"text","text":" — Replaces "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" with a freshly generated one. Useful for a “new question” button."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".submitAnswer(Int)"}],"type":"strong"},{"type":"text","text":" — Compares against "},{"type":"codeVoice","code":"challenge.expected"},{"type":"text","text":". Returns an effect that dispatches either "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" (with the current "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":") or "},{"type":"codeVoice","code":".answerRejected"},{"type":"text","text":". No-op if "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" or "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".answerAccepted(reason:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Inserts "},{"code":"reason","type":"codeVoice"},{"type":"text","text":" into "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":", clears "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":", "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", and "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".answerRejected"}],"type":"strong"},{"text":" — Increments ","type":"text"},{"type":"codeVoice","code":"attempts"},{"text":" and regenerates ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":" so the user faces a new problem.","type":"text"}]}]}]},{"anchor":"Session-pass-behavior","type":"heading","text":"Session-pass behavior","level":3},{"inlineContent":[{"type":"text","text":"Once a reason is in "},{"type":"codeVoice","code":"passedReasons"},{"text":", subsequent ","type":"text"},{"type":"codeVoice","code":".request(reason:)"},{"text":" calls for that same reason short-circuit: the plugin dispatches ","type":"text"},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"Set<String>"},{"type":"text","text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate "},{"type":"codeVoice","code":"state.parentalGate.passedReasons"},{"type":"text","text":" from your own reducer (for example, in response to an "},{"type":"codeVoice","code":"app\/lock"},{"type":"text","text":" action)."}],"type":"paragraph"},{"anchor":"Customizing-the-challenge","level":2,"type":"heading","text":"Customizing the challenge"},{"inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource"},{"text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"]},{"inlineContent":[{"text":"The generator runs synchronously each time the plugin needs a new challenge (on ","type":"text"},{"code":".request","type":"codeVoice"},{"text":", ","type":"text"},{"code":".regenerateChallenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":".answerRejected","type":"codeVoice"},{"text":"). Keep it cheap and pure — no I\/O.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swidux\/pluginparentalgatereference"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"title":"SwiduxParentalGate Reference","role":"article","roleHeading":"Article","modules":[{"name":"Swidux"}]},"abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"references":{"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"url":"\/documentation\/swidux\/pluginkillswitchreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","title":"SwiduxKillswitch Reference","type":"topic","kind":"article","abstract":[{"text":"Public API surface for the ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"kind":"symbol","url":"\/documentation\/swidux\/undoplugin","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"title":"UndoPlugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"type":"topic","abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}]},"doc://Swidux/documentation/Swidux/UndoRedo":{"url":"\/documentation\/swidux\/undoredo","kind":"article","type":"topic","title":"Undo \/ Redo","identif