{"kind":"article","primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" ships as a separate library target alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":". It provides a single domain plugin ("},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","type":"reference"},{"type":"text","text":". For the underlying plugin contract, see "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Library-target","text":"Library target","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" product as a target dependency, then import it where you wire the store and present the gate sheet:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxParentalGate"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The package vends three library products: "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":", and "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":". Pull in only what you use."}],"type":"paragraph"},{"level":2,"anchor":"Types","text":"Types","type":"heading"},{"level":3,"anchor":"ParentalGatePlugin","text":"ParentalGatePlugin","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"MainActor"},{"type":"text","text":"-bound domain plugin generic over the host app’s root state and action types."}],"type":"paragraph"},{"syntax":"swift","code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The three wiring closures follow the standard domain-plugin shape described in "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"type":"text","text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action."}],"type":"paragraph"},{"level":3,"anchor":"ParentalGateState","text":"ParentalGateState","type":"heading"},{"inlineContent":[{"type":"text","text":"The state slice the plugin owns."}],"type":"paragraph"},{"syntax":"swift","code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":" — non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" while a challenge is active. Drives sheet presentation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"challenge","type":"codeVoice"},{"type":"text","text":" — the currently-presented arithmetic problem."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"attempts","type":"codeVoice"},{"type":"text","text":" — count of incorrect submissions against the current challenge."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" — reasons already cleared this session (see action semantics below)."}]}]}],"type":"unorderedList"},{"level":3,"anchor":"ParentalGateAction","text":"ParentalGateAction","type":"heading"},{"syntax":"swift","code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"],"type":"codeListing"},{"level":3,"anchor":"MathChallenge","text":"MathChallenge","type":"heading"},{"syntax":"swift","code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"expected"},{"type":"text","text":" computes the correct answer from "},{"type":"codeVoice","code":"left"},{"text":", ","type":"text"},{"code":"right","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"op","type":"codeVoice"},{"text":". ","type":"text"},{"code":"Op.symbol","type":"codeVoice"},{"type":"text","text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7)."}],"type":"paragraph"},{"level":3,"anchor":"ParentalChallengeSource","text":"ParentalChallengeSource","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"A value-type holder for a challenge generator closure.","type":"text"}]},{"syntax":"swift","code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.standard"},{"type":"text","text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"type":"text","text":" — always returns the supplied challenge. Use this in tests."}]}]}],"type":"unorderedList"},{"text":"Action semantics","type":"heading","level":2,"anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"code":"ParentalGateAction","type":"codeVoice"},{"type":"text","text":" case mutates the state slice as follows:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".request(reason:)"}]},{"type":"text","text":" — If "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" already contains "},{"code":"reason","type":"codeVoice"},{"type":"text","text":", the plugin returns an effect that immediately dispatches "},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"type":"text","text":" and leaves "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":" unchanged. Otherwise, it sets "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":", generates a fresh "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", and resets "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":" to "},{"code":"0","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".dismiss","type":"codeVoice"}]},{"type":"text","text":" — Clears "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"challenge"},{"text":", and ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":". Does not modify ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".regenerateChallenge","type":"codeVoice"}],"type":"strong"},{"text":" — Replaces ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":" with a freshly generated one. Useful for a “new question” button.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".submitAnswer(Int)"}],"type":"strong"},{"text":" — Compares against ","type":"text"},{"code":"challenge.expected","type":"codeVoice"},{"text":". Returns an effect that dispatches either ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" (with the current ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":") or ","type":"text"},{"code":".answerRejected","type":"codeVoice"},{"text":". No-op if ","type":"text"},{"code":"challenge","type":"codeVoice"},{"type":"text","text":" or "},{"code":"pendingReason","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".answerAccepted(reason:)","type":"codeVoice"}]},{"text":" — Inserts ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":" into ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", clears ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":", ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".answerRejected","type":"codeVoice"}]},{"text":" — Increments ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":" and regenerates ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":" so the user faces a new problem.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Session-pass behavior","type":"heading","level":3,"anchor":"Session-pass-behavior"},{"type":"paragraph","inlineContent":[{"text":"Once a reason is in ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", subsequent ","type":"text"},{"code":".request(reason:)","type":"codeVoice"},{"text":" calls for that same reason short-circuit: the plugin dispatches ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"Set<String>","type":"codeVoice"},{"text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate ","type":"text"},{"code":"state.parentalGate.passedReasons","type":"codeVoice"},{"text":" from your own reducer (for example, in response to an ","type":"text"},{"code":"app\/lock","type":"codeVoice"},{"text":" action).","type":"text"}]},{"text":"Customizing the challenge","type":"heading","level":2,"anchor":"Customizing-the-challenge"},{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource","type":"codeVoice"},{"text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"]},{"type":"paragraph","inlineContent":[{"text":"The generator runs synchronously each time the plugin needs a new challenge (on ","type":"text"},{"code":".request","type":"codeVoice"},{"text":", ","type":"text"},{"code":".regenerateChallenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":".answerRejected","type":"codeVoice"},{"text":"). Keep it cheap and pure — no I\/O.","type":"text"}]}],"kind":"content"}],"abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","interfaceLanguage":"swift"},"seeAlsoSections":[{"title":"Related Documentation","anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"title":"Reference","anchor":"Reference","generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"]}],"sections":[],"variants":[{"paths":["\/documentation\/swidux\/pluginparentalgatereference"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"SwiduxParentalGate Reference","roleHeading":"Article","role":"article","modules":[{"name":"Swidux"}]},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://Swidux/documentation/Swidux/GettingStarted":{"abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"url":"\/documentation\/swidux\/gettingstarted","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","role":"article","title":"Getting Started with Swidux"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"kind":"article","type":"topic","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"title":"SwiduxAnalytics Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","role":"article","url":"\/documentation\/swidux\/pluginanalyticsreference"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"kind":"article","type":"topic","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"title":"EntityStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","role":"article","url":"\/documentation\/swidux\/entitystoreguide"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"kind":"article","type":"topic","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"title":"Persistence Middleware","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","role":"article","url":"\/documentation\/swidux\/persistencemiddlewareguide"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"url":"\/documentation\/swidux\/pluginpaywallreference","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic","role":"article","title":"SwiduxPaywall Reference"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"kind":"article","type":"topic","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"title":"KeyValueStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","role":"collectionGroup","url":"\/documentation\/swidux\/keyvaluestoreguide"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"title":"UndoPlugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"url":"\/documentation\/swidux\/undoplugin","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/MacrosReference":{"kind":"article","type":"topic","abstract":[{"text":"Reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" — the two macros that generate the observation bridge between value-type state and SwiftUI.","type":"text"}],"title":"Macros","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","role":"article","url":"\/documentation\/swidux\/macrosreference"},"doc://Swidux/documentation/Swidux":{"kind":"symbol","type":"topic","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","url":"\/documentation\/swidux"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"url":"\/documentation\/swidux\/pluginfeatureflagsreference","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","type":"topic","role":"article","title":"SwiduxFeatureFlags Reference"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"kind":"article","type":"topic","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"title":"Add a Parental Gate","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","role":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"kind":"article","type":"topic","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"title":"Plugin Architecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","role":"article","url":"\/documentation\/swidux\/pluginarchitecture"},"doc://Swidux/documentation/Swidux/UndoRedo":{"type":"topic","kind":"article","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":".","type":"text"}],"title":"Undo \/ Redo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","role":"article","url":"\/documentation\/swidux\/undoredo"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"kind":"article","type":"topic","abstract":[{"text":"Public API surface for the ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"title":"SwiduxKillswitch Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","role":"article","url":"\/documentation\/swidux\/pluginkillswitchreference"}}}