{"metadata":{"role":"article","title":"SwiduxParentalGate Reference","roleHeading":"Article","modules":[{"name":"Swidux"}]},"abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginparentalgatereference"]}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","interfaceLanguage":"swift"},"kind":"article","seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"anchor":"Reference","generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" ships as a separate library target alongside ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":". It provides a single domain plugin (","type":"text"},{"code":"ParentalGatePlugin","type":"codeVoice"},{"text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","type":"reference"},{"type":"text","text":". For the underlying plugin contract, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"Library target","anchor":"Library-target"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" product as a target dependency, then import it where you wire the store and present the gate sheet:"}]},{"syntax":"swift","code":["import SwiduxParentalGate"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package vends three library products: "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":", and "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":". Pull in only what you use."}]},{"level":2,"type":"heading","text":"Types","anchor":"Types"},{"level":3,"type":"heading","text":"ParentalGatePlugin","anchor":"ParentalGatePlugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"MainActor"},{"type":"text","text":"-bound domain plugin generic over the host app’s root state and action types."}]},{"syntax":"swift","code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The three wiring closures follow the standard domain-plugin shape described in "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"type":"text","text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action."}],"type":"paragraph"},{"text":"ParentalGateState","anchor":"ParentalGateState","level":3,"type":"heading"},{"inlineContent":[{"text":"The state slice the plugin owns.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":" — non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" while a challenge is active. Drives sheet presentation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"challenge","type":"codeVoice"},{"text":" — the currently-presented arithmetic problem.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"attempts","type":"codeVoice"},{"text":" — count of incorrect submissions against the current challenge.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"text":" — reasons already cleared this session (see action semantics below).","type":"text"}]}]}],"type":"unorderedList"},{"text":"ParentalGateAction","anchor":"ParentalGateAction","level":3,"type":"heading"},{"syntax":"swift","code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"],"type":"codeListing"},{"text":"MathChallenge","anchor":"MathChallenge","level":3,"type":"heading"},{"syntax":"swift","code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"expected"},{"type":"text","text":" computes the correct answer from "},{"code":"left","type":"codeVoice"},{"type":"text","text":", "},{"code":"right","type":"codeVoice"},{"type":"text","text":", and "},{"code":"op","type":"codeVoice"},{"type":"text","text":". "},{"code":"Op.symbol","type":"codeVoice"},{"type":"text","text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7)."}],"type":"paragraph"},{"text":"ParentalChallengeSource","type":"heading","level":3,"anchor":"ParentalChallengeSource"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A value-type holder for a challenge generator closure."}]},{"type":"codeListing","syntax":"swift","code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.standard"},{"type":"text","text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"type":"text","text":" — always returns the supplied challenge. Use this in tests."}]}]}]},{"text":"Action semantics","type":"heading","level":2,"anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"ParentalGateAction"},{"type":"text","text":" case mutates the state slice as follows:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".request(reason:)"}],"type":"strong"},{"text":" — If ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":" already contains ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":", the plugin returns an effect that immediately dispatches ","type":"text"},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"text":" and leaves ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":" unchanged. Otherwise, it sets ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":", generates a fresh ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":", and resets ","type":"text"},{"type":"codeVoice","code":"attempts"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"0"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".dismiss","type":"codeVoice"}],"type":"strong"},{"text":" — Clears ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":", ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":". Does not modify ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".regenerateChallenge"}]},{"text":" — Replaces ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":" with a freshly generated one. Useful for a “new question” button.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".submitAnswer(Int)","type":"codeVoice"}]},{"type":"text","text":" — Compares against "},{"type":"codeVoice","code":"challenge.expected"},{"type":"text","text":". Returns an effect that dispatches either "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" (with the current "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":") or "},{"type":"codeVoice","code":".answerRejected"},{"type":"text","text":". No-op if "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" or "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".answerAccepted(reason:)","type":"codeVoice"}]},{"text":" — Inserts ","type":"text"},{"type":"codeVoice","code":"reason"},{"text":" into ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":", clears ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":", ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"attempts"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".answerRejected","type":"codeVoice"}]},{"text":" — Increments ","type":"text"},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" so the user faces a new problem."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Session-pass-behavior","level":3,"text":"Session-pass behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once a reason is in "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":", subsequent "},{"code":".request(reason:)","type":"codeVoice"},{"type":"text","text":" calls for that same reason short-circuit: the plugin dispatches "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"Set<String>"},{"type":"text","text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate "},{"type":"codeVoice","code":"state.parentalGate.passedReasons"},{"type":"text","text":" from your own reducer (for example, in response to an "},{"type":"codeVoice","code":"app\/lock"},{"type":"text","text":" action)."}]},{"anchor":"Customizing-the-challenge","type":"heading","level":2,"text":"Customizing the challenge"},{"inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource"},{"text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:","type":"text"}],"type":"paragraph"},{"code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The generator runs synchronously each time the plugin needs a new challenge (on ","type":"text"},{"type":"codeVoice","code":".request"},{"text":", ","type":"text"},{"type":"codeVoice","code":".regenerateChallenge"},{"text":", and ","type":"text"},{"type":"codeVoice","code":".answerRejected"},{"text":"). Keep it cheap and pure — no I\/O.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"references":{"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","title":"SwiduxAnalytics Reference","url":"\/documentation\/swidux\/pluginanalyticsreference","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","title":"SwiduxKillswitch Reference","url":"\/documentation\/swidux\/pluginkillswitchreference","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"type":"topic","kind":"article","role":"article"},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidu