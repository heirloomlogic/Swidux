{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","interfaceLanguage":"swift"},"abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true,"title":"Reference","anchor":"Reference"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" ships as a separate library target alongside ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":". It provides a single domain plugin (","type":"text"},{"code":"ParentalGatePlugin","type":"codeVoice"},{"text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","type":"reference"},{"text":". For the underlying plugin contract, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Library target","type":"heading","anchor":"Library-target"},{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" product as a target dependency, then import it where you wire the store and present the gate sheet:","type":"text"}],"type":"paragraph"},{"code":["import SwiduxParentalGate"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The package vends three library products: ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":". Pull in only what you use.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Types","type":"heading","anchor":"Types"},{"level":3,"text":"ParentalGatePlugin","type":"heading","anchor":"ParentalGatePlugin"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"MainActor","type":"codeVoice"},{"text":"-bound domain plugin generic over the host app’s root state and action types.","type":"text"}],"type":"paragraph"},{"code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The three wiring closures follow the standard domain-plugin shape described in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action.","type":"text"}],"type":"paragraph"},{"level":3,"text":"ParentalGateState","type":"heading","anchor":"ParentalGateState"},{"inlineContent":[{"text":"The state slice the plugin owns.","type":"text"}],"type":"paragraph"},{"code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" — non-"},{"type":"codeVoice","code":"nil"},{"text":" while a challenge is active. Drives sheet presentation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"challenge"},{"type":"text","text":" — the currently-presented arithmetic problem."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"attempts"},{"type":"text","text":" — count of incorrect submissions against the current challenge."}]}]},{"content":[{"inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" — reasons already cleared this session (see action semantics below)."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"ParentalGateAction","type":"heading","anchor":"ParentalGateAction"},{"syntax":"swift","type":"codeListing","code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"]},{"type":"heading","text":"MathChallenge","anchor":"MathChallenge","level":3},{"syntax":"swift","type":"codeListing","code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"]},{"inlineContent":[{"type":"codeVoice","code":"expected"},{"text":" computes the correct answer from ","type":"text"},{"type":"codeVoice","code":"left"},{"text":", ","type":"text"},{"type":"codeVoice","code":"right"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"op"},{"text":". ","type":"text"},{"type":"codeVoice","code":"Op.symbol"},{"text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7).","type":"text"}],"type":"paragraph"},{"anchor":"ParentalChallengeSource","level":3,"text":"ParentalChallengeSource","type":"heading"},{"inlineContent":[{"text":"A value-type holder for a challenge generator closure.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"type":"text","text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"type":"text","text":" — always returns the supplied challenge. Use this in tests."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Action-semantics","level":2,"text":"Action semantics","type":"heading"},{"inlineContent":[{"text":"Each ","type":"text"},{"type":"codeVoice","code":"ParentalGateAction"},{"text":" case mutates the state slice as follows:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".request(reason:)","type":"codeVoice"}]},{"type":"text","text":" — If "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" already contains "},{"code":"reason","type":"codeVoice"},{"type":"text","text":", the plugin returns an effect that immediately dispatches "},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"type":"text","text":" and leaves "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":" unchanged. Otherwise, it sets "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":", generates a fresh "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", and resets "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":" to "},{"code":"0","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".dismiss","type":"codeVoice"}]},{"type":"text","text":" — Clears "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":", "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", and "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":". Does not modify "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".regenerateChallenge","type":"codeVoice"}]},{"type":"text","text":" — Replaces "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":" with a freshly generated one. Useful for a “new question” button."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".submitAnswer(Int)","type":"codeVoice"}]},{"type":"text","text":" — Compares against "},{"code":"challenge.expected","type":"codeVoice"},{"type":"text","text":". Returns an effect that dispatches either "},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"type":"text","text":" (with the current "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":") or "},{"code":".answerRejected","type":"codeVoice"},{"type":"text","text":". No-op if "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":" or "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":" is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".answerAccepted(reason:)","type":"codeVoice"}]},{"type":"text","text":" — Inserts "},{"code":"reason","type":"codeVoice"},{"type":"text","text":" into "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":", clears "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":", "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", and "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".answerRejected","type":"codeVoice"}]},{"type":"text","text":" — Increments "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":" and regenerates "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":" so the user faces a new problem."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Session-pass-behavior","level":3,"text":"Session-pass behavior","type":"heading"},{"inlineContent":[{"text":"Once a reason is in ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":", subsequent ","type":"text"},{"type":"codeVoice","code":".request(reason:)"},{"text":" calls for that same reason short-circuit: the plugin dispatches ","type":"text"},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"Set<String>"},{"text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate ","type":"text"},{"type":"codeVoice","code":"state.parentalGate.passedReasons"},{"text":" from your own reducer (for example, in response to an ","type":"text"},{"type":"codeVoice","code":"app\/lock"},{"text":" action).","type":"text"}],"type":"paragraph"},{"anchor":"Customizing-the-challenge","level":2,"text":"Customizing the challenge","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource"},{"text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"],"type":"codeListing"},{"inlineContent":[{"text":"The generator runs synchronously each time the plugin needs a new challenge (on ","type":"text"},{"type":"codeVoice","code":".request"},{"text":", ","type":"text"},{"type":"codeVoice","code":".regenerateChallenge"},{"text":", and ","type":"text"},{"type":"codeVoice","code":".answerRejected"},{"text":"). Keep it cheap and pure — no I\/O.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginparentalgatereference"]}],"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"SwiduxParentalGate Reference"},"sections":[],"references":{"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"url":"\/documentation\/swidux\/howtoaddaparentalgate","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"kind":"article","title":"Add a Parental Gate","role":"article","type":"topic"},"doc://Swidux/documentation/Swidux/UndoRedo":{"abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":".","type":"text"}],"title":"Undo \/ Redo","kind":"article","url":"\/documentation\/swidux\/undoredo","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"title":"UndoPlugin","kind":"symbol","url":"\/documentation\/swidux\/undop