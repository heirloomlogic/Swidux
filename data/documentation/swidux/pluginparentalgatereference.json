{"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"metadata":{"roleHeading":"Article","title":"SwiduxParentalGate Reference","modules":[{"name":"Swidux"}],"role":"article"},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"anchor":"Reference","title":"Reference","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" ships as a separate library target alongside ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":". It provides a single domain plugin (","type":"text"},{"code":"ParentalGatePlugin","type":"codeVoice"},{"text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","type":"reference","isActive":true},{"text":". For the underlying plugin contract, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Library target","type":"heading","anchor":"Library-target"},{"inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"text":" product as a target dependency, then import it where you wire the store and present the gate sheet:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import SwiduxParentalGate"]},{"inlineContent":[{"text":"The package vends three library products: ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":". Pull in only what you use.","type":"text"}],"type":"paragraph"},{"anchor":"Types","text":"Types","type":"heading","level":2},{"anchor":"ParentalGatePlugin","text":"ParentalGatePlugin","type":"heading","level":3},{"inlineContent":[{"text":"A ","type":"text"},{"code":"MainActor","type":"codeVoice"},{"text":"-bound domain plugin generic over the host app’s root state and action types.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"],"type":"codeListing"},{"inlineContent":[{"text":"The three wiring closures follow the standard domain-plugin shape described in ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true},{"text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action.","type":"text"}],"type":"paragraph"},{"anchor":"ParentalGateState","text":"ParentalGateState","type":"heading","level":3},{"inlineContent":[{"text":"The state slice the plugin owns.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"pendingReason"},{"text":" — non-","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" while a challenge is active. Drives sheet presentation.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"challenge"},{"text":" — the currently-presented arithmetic problem.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"attempts"},{"text":" — count of incorrect submissions against the current challenge.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"text":" — reasons already cleared this session (see action semantics below).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"ParentalGateAction","text":"ParentalGateAction","level":3,"type":"heading"},{"syntax":"swift","code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"],"type":"codeListing"},{"anchor":"MathChallenge","text":"MathChallenge","level":3,"type":"heading"},{"syntax":"swift","code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"expected","type":"codeVoice"},{"text":" computes the correct answer from ","type":"text"},{"code":"left","type":"codeVoice"},{"text":", ","type":"text"},{"code":"right","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"op","type":"codeVoice"},{"text":". ","type":"text"},{"code":"Op.symbol","type":"codeVoice"},{"text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7).","type":"text"}],"type":"paragraph"},{"anchor":"ParentalChallengeSource","text":"ParentalChallengeSource","level":3,"type":"heading"},{"inlineContent":[{"text":"A value-type holder for a challenge generator closure.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"type":"text","text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"type":"text","text":" — always returns the supplied challenge. Use this in tests."}]}]}],"type":"unorderedList"},{"anchor":"Action-semantics","text":"Action semantics","level":2,"type":"heading"},{"inlineContent":[{"text":"Each ","type":"text"},{"code":"ParentalGateAction","type":"codeVoice"},{"text":" case mutates the state slice as follows:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".request(reason:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — If "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" already contains "},{"code":"reason","type":"codeVoice"},{"type":"text","text":", the plugin returns an effect that immediately dispatches "},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"type":"text","text":" and leaves "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":" unchanged. Otherwise, it sets "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":", generates a fresh "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", and resets "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":" to "},{"code":"0","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".dismiss","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Clears "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":", "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", and "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":". Does not modify "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".regenerateChallenge","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Replaces "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":" with a freshly generated one. Useful for a “new question” button."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".submitAnswer(Int)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Compares against "},{"code":"challenge.expected","type":"codeVoice"},{"type":"text","text":". Returns an effect that dispatches either "},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"type":"text","text":" (with the current "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":") or "},{"code":".answerRejected","type":"codeVoice"},{"type":"text","text":". No-op if "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":" or "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":" is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".answerAccepted(reason:)","type":"codeVoice"}],"type":"strong"},{"text":" — Inserts ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":" into ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", clears ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":", ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".answerRejected","type":"codeVoice"}],"type":"strong"},{"text":" — Increments ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":" and regenerates ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":" so the user faces a new problem.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Session-pass-behavior","text":"Session-pass behavior","level":3,"type":"heading"},{"inlineContent":[{"text":"Once a reason is in ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", subsequent ","type":"text"},{"code":".request(reason:)","type":"codeVoice"},{"text":" calls for that same reason short-circuit: the plugin dispatches ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"Set<String>","type":"codeVoice"},{"text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate ","type":"text"},{"code":"state.parentalGate.passedReasons","type":"codeVoice"},{"text":" from your own reducer (for example, in response to an ","type":"text"},{"code":"app\/lock","type":"codeVoice"},{"text":" action).","type":"text"}],"type":"paragraph"},{"anchor":"Customizing-the-challenge","text":"Customizing the challenge","level":2,"type":"heading"},{"inlineContent":[{"code":"ParentalChallengeSource","type":"codeVoice"},{"text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"],"type":"codeListing"},{"inlineContent":[{"text":"The generator runs synchronously each time the plugin needs a new challenge (on ","type":"text"},{"code":".request","type":"codeVoice"},{"text":", ","type":"text"},{"code":".regenerateChallenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":".answerRejected","type":"codeVoice"},{"text":"). Keep it cheap and pure — no I\/O.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginparentalgatereference"]}],"references":{"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}],"title":"EntityStore","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","url":"\/documentation\/swidux\/entitystoreguide","role":"article"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"title":"SwiduxAnalytics Reference","kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","url":"\/documentation\/swidux\/pluginanalyticsreference","role":"article"},"doc://Swidux/documentation/Swidux/MacrosReference":{"kind":"article","title":"Macros","abstract":[{"text":"Reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" (