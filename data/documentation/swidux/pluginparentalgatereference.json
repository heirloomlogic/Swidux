{"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference","anchor":"Reference"}],"kind":"article","variants":[{"paths":["\/documentation\/swidux\/pluginparentalgatereference"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article","title":"SwiduxParentalGate Reference"},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" ships as a separate library target alongside "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":". It provides a single domain plugin ("},{"code":"ParentalGatePlugin","type":"codeVoice"},{"type":"text","text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","type":"reference","isActive":true},{"type":"text","text":". For the underlying plugin contract, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Library target","anchor":"Library-target","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" product as a target dependency, then import it where you wire the store and present the gate sheet:"}],"type":"paragraph"},{"code":["import SwiduxParentalGate"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The package vends three library products: "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":", and "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":". Pull in only what you use."}],"type":"paragraph"},{"level":2,"text":"Types","anchor":"Types","type":"heading"},{"level":3,"text":"ParentalGatePlugin","anchor":"ParentalGatePlugin","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"code":"MainActor","type":"codeVoice"},{"type":"text","text":"-bound domain plugin generic over the host app’s root state and action types."}],"type":"paragraph"},{"code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The three wiring closures follow the standard domain-plugin shape described in "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"type":"text","text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action."}],"type":"paragraph"},{"level":3,"text":"ParentalGateState","anchor":"ParentalGateState","type":"heading"},{"inlineContent":[{"type":"text","text":"The state slice the plugin owns."}],"type":"paragraph"},{"code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" — non-"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" while a challenge is active. Drives sheet presentation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"challenge"},{"type":"text","text":" — the currently-presented arithmetic problem."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"attempts"},{"type":"text","text":" — count of incorrect submissions against the current challenge."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" — reasons already cleared this session (see action semantics below)."}]}]}],"type":"unorderedList"},{"level":3,"text":"ParentalGateAction","anchor":"ParentalGateAction","type":"heading"},{"code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"],"syntax":"swift","type":"codeListing"},{"level":3,"text":"MathChallenge","anchor":"MathChallenge","type":"heading"},{"code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"expected"},{"text":" computes the correct answer from ","type":"text"},{"type":"codeVoice","code":"left"},{"text":", ","type":"text"},{"type":"codeVoice","code":"right"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"op"},{"text":". ","type":"text"},{"type":"codeVoice","code":"Op.symbol"},{"text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7).","type":"text"}],"type":"paragraph"},{"level":3,"text":"ParentalChallengeSource","anchor":"ParentalChallengeSource","type":"heading"},{"inlineContent":[{"text":"A value-type holder for a challenge generator closure.","type":"text"}],"type":"paragraph"},{"code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"],"syntax":"swift","type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.standard"},{"type":"text","text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.fixed(_:)"},{"type":"text","text":" — always returns the supplied challenge. Use this in tests."}]}]}],"type":"unorderedList"},{"level":2,"text":"Action semantics","anchor":"Action-semantics","type":"heading"},{"inlineContent":[{"text":"Each ","type":"text"},{"type":"codeVoice","code":"ParentalGateAction"},{"text":" case mutates the state slice as follows:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".request(reason:)"}],"type":"strong"},{"type":"text","text":" — If "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" already contains "},{"type":"codeVoice","code":"reason"},{"type":"text","text":", the plugin returns an effect that immediately dispatches "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" and leaves "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" unchanged. Otherwise, it sets "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", generates a fresh "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and resets "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" to "},{"type":"codeVoice","code":"0"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".dismiss"}],"type":"strong"},{"type":"text","text":" — Clears "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":". Does not modify "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".regenerateChallenge"}],"type":"strong"},{"type":"text","text":" — Replaces "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" with a freshly generated one. Useful for a “new question” button."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".submitAnswer(Int)"}],"type":"strong"},{"type":"text","text":" — Compares against "},{"type":"codeVoice","code":"challenge.expected"},{"type":"text","text":". Returns an effect that dispatches either "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" (with the current "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":") or "},{"type":"codeVoice","code":".answerRejected"},{"type":"text","text":". No-op if "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" or "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".answerAccepted(reason:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Inserts "},{"type":"codeVoice","code":"reason"},{"type":"text","text":" into "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".answerRejected","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Increments "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" so the user faces a new problem."}]}]}],"type":"unorderedList"},{"level":3,"text":"Session-pass behavior","anchor":"Session-pass-behavior","type":"heading"},{"inlineContent":[{"text":"Once a reason is in ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":", subsequent ","type":"text"},{"type":"codeVoice","code":".request(reason:)"},{"text":" calls for that same reason short-circuit: the plugin dispatches ","type":"text"},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"Set<String>"},{"text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate ","type":"text"},{"type":"codeVoice","code":"state.parentalGate.passedReasons"},{"text":" from your own reducer (for example, in response to an ","type":"text"},{"type":"codeVoice","code":"app\/lock"},{"text":" action).","type":"text"}],"type":"paragraph"},{"level":2,"text":"Customizing the challenge","anchor":"Customizing-the-challenge","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource"},{"text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:","type":"text"}],"type":"paragraph"},{"code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The generator runs synchronously each time the plugin needs a new challenge (on ","type":"text"},{"type":"codeVoice","code":".request"},{"text":", ","type":"text"},{"type":"codeVoice","code":".regenerateChallenge"},{"text":", and ","type":"text"},{"type":"codeVoice","code":".answerRejected"},{"text":"). Keep it cheap and pure — no I\/O.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"references":{"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","role":"article","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"url":"\/documentation\/swidux\/persistencemiddlewareguide","kind":"article","type":"topic","title":"Persistence Middleware"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","title":"SwiduxFeatureFlags Reference","role":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxFeatureFlags","type":"codeVoice"},{"text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format.","type":"text"}],"url":"\/documentation\/swidux\/pluginfeatureflagsreference"},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","role":"article","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}],"type":"topic","url":"\/documentation\/swidux\/pluginarchitecture","kind":"article","title":"Plugin Architecture"},"doc://Swidux/documentation/Swidux/UndoRedo":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","title":"Undo \/ Redo","role":"article","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":".","type":"text"}],"url":"\/documentation\/swidux\/undoredo"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","title":"Troubleshooting","role":"article","abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"url":"\/documentation\/swidux\/troubleshooting"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"kind":"article","abstract":[{"type":"text","text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","role":"collectionGroup","type":"topic","title":"KeyValueStore","url":"\/documentation\/swidux\/keyvaluestoreguide"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","role":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","type":"topic","title":"Add a Parental Gate"},"doc://Swidux/documentation/Swidux/MacrosReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","role":"article","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":")."}],"url":"\/documentation\/swidux\/macrosreference","kind":"article","type":"topic","title":"Macros"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","role":"article","abstract":[{"type":"text","text":"Public API surface for the "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"type":"topic","url":"\/documentation\/swidux\/pluginkillswitchreference","kind":"article","title":"SwiduxKillswitch Reference"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"kind":"article","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","title":"SwiduxPaywall Reference","role":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"url":"\/documentation\/swidux\/pluginpaywallreference"},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","role":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"url":"\/documentation\/swidux\/entitystoreguide","kind":"article","type":"topic","title":"EntityStore"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"UndoPlugin","kind":"identifier"}],"abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","role":"symbol","url":"\/documentation\/swidux\/undoplugin","title":"UndoPlugin","type":"topic","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}]},"doc://Swidux/documentation/Swidux":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux","role":"collection","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"kind":"symbol","type":"topic","url":"\/documentation\/swidux","title":"Swidux"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","role":"article","type":"topic","url":"\/documentation\/swidux\/pluginanalyticsreference","title":"SwiduxAnalytics Reference"},"doc://Swidux/documentation/Swidux/GettingStarted":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","role":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"url":"\/documentation\/swidux\/gettingstarted","kind":"article","type":"topic","title":"Getting Started with Swidux"}}}