ityStoreGuide"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"title":"Troubleshooting","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","role":"article","kind":"article","abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}],"url":"\/documentation\/swidux\/troubleshooting"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","url":"\/documentation\/swidux\/pluginanalyticsreference","type":"topic","title":"SwiduxAnalytics Reference","role":"article","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}],"title":"Getting Started with Swidux","type":"topic","url":"\/documentation\/swidux\/gettingstarted","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},"doc://Swidux/documentation/Swidux/MacrosReference":{"role":"article","abstract":[{"type":"text","text":"Reference for "},{"code":"@Swidux","type":"codeVoice"},{"type":"text","text":" and "},{"code":"@Slice","type":"codeVoice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":")."}],"title":"Macros","kind":"article","type":"topic","url":"\/documentation\/swidux\/macrosreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"title":"SwiduxKillswitch Reference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","role":"article","kind":"article","abstract":[{"type":"text","text":"Public API surface for the "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}],"url":"\/documentation\/swidux\/pluginkillswitchreference"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"role":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"title":"Add a Parental Gate","type":"topic","url":"\/documentation\/swidux\/howtoaddaparentalgate","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"title":"Persistence Middleware","type":"topic","url":"\/documentation\/swidux\/persistencemiddlewareguide","abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes."}],"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","kind":"symbol","title":"UndoPlugin","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"type":"topic","url":"\/documentation\/swidux\/undoplugin"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"title":"KeyValueStore","type":"topic","identifier":"doc:\/\/Sw