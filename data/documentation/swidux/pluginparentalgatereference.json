 reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"title":"SwiduxAnalytics Reference"},"doc://Swidux/documentation/Swidux/UndoRedo":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","role":"article","kind":"article","url":"\/documentation\/swidux\/undoredo","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","type":"reference"},{"text":".","type":"text"}],"title":"Undo \/ Redo"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","role":"article","kind":"article","url":"\/documentation\/swidux\/troubleshooting","abstract":[{"text":"Symptoms you may hit while adopting Swidux, and what each one actually means.","type":"text"}],"title":"Troubleshooting"},"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","role":"article","kind":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"title":"Add a Parental Gate"},"doc://Swidux/documentation/Swidux/MacrosReference":{"url":"\/documentation\/swidux\/macrosreference","role":"article","title":"Macros","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","abstract":[{"text":"Reference for ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"code":"@Persist