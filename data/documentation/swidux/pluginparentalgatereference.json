{"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"anchor":"Reference","title":"Reference","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" ships as a separate library target alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":". It provides a single domain plugin ("},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","type":"reference","isActive":true},{"type":"text","text":". For the underlying plugin contract, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"type":"text","text":"."}]},{"level":2,"type":"heading","text":"Library target","anchor":"Library-target"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"SwiduxParentalGate"},{"text":" product as a target dependency, then import it where you wire the store and present the gate sheet:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxParentalGate"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package vends three library products: "},{"code":"Swidux","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":", and "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":". Pull in only what you use."}]},{"text":"Types","anchor":"Types","type":"heading","level":2},{"text":"ParentalGatePlugin","anchor":"ParentalGatePlugin","type":"heading","level":3},{"inlineContent":[{"text":"A ","type":"text"},{"code":"MainActor","type":"codeVoice"},{"text":"-bound domain plugin generic over the host app’s root state and action types.","type":"text"}],"type":"paragraph"},{"code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The three wiring closures follow the standard domain-plugin shape described in ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action.","type":"text"}],"type":"paragraph"},{"text":"ParentalGateState","anchor":"ParentalGateState","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"The state slice the plugin owns."}],"type":"paragraph"},{"code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"],"type":"codeListing","syntax":"swift"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" — non-"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" while a challenge is active. Drives sheet presentation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"challenge","type":"codeVoice"},{"text":" — the currently-presented arithmetic problem.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"attempts"},{"type":"text","text":" — count of incorrect submissions against the current challenge."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" — reasons already cleared this session (see action semantics below)."}]}]}],"type":"unorderedList"},{"text":"ParentalGateAction","level":3,"type":"heading","anchor":"ParentalGateAction"},{"type":"codeListing","syntax":"swift","code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"]},{"text":"MathChallenge","level":3,"type":"heading","anchor":"MathChallenge"},{"type":"codeListing","syntax":"swift","code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"]},{"inlineContent":[{"type":"codeVoice","code":"expected"},{"type":"text","text":" computes the correct answer from "},{"type":"codeVoice","code":"left"},{"type":"text","text":", "},{"type":"codeVoice","code":"right"},{"type":"text","text":", and "},{"type":"codeVoice","code":"op"},{"type":"text","text":". "},{"type":"codeVoice","code":"Op.symbol"},{"type":"text","text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7)."}],"type":"paragraph"},{"text":"ParentalChallengeSource","level":3,"type":"heading","anchor":"ParentalChallengeSource"},{"inlineContent":[{"text":"A value-type holder for a challenge generator closure.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.standard"},{"text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.fixed(_:)"},{"type":"text","text":" — always returns the supplied challenge. Use this in tests."}]}]}]},{"text":"Action semantics","level":2,"type":"heading","anchor":"Action-semantics"},{"inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"ParentalGateAction"},{"type":"text","text":" case mutates the state slice as follows:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".request(reason:)","type":"codeVoice"}]},{"type":"text","text":" — If "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" already contains "},{"type":"codeVoice","code":"reason"},{"type":"text","text":", the plugin returns an effect that immediately dispatches "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" and leaves "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" unchanged. Otherwise, it sets "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", generates a fresh "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and resets "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" to "},{"type":"codeVoice","code":"0"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".dismiss","type":"codeVoice"}]},{"text":" — Clears ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":", ","type":"text"},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":". Does not modify "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".regenerateChallenge"}]},{"text":" — Replaces ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":" with a freshly generated one. Useful for a “new question” button.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".submitAnswer(Int)"}],"type":"strong"},{"text":" — Compares against ","type":"text"},{"code":"challenge.expected","type":"codeVoice"},{"text":". Returns an effect that dispatches either ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" (with the current ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":") or ","type":"text"},{"code":".answerRejected","type":"codeVoice"},{"text":". No-op if ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".answerAccepted(reason:)","type":"codeVoice"}],"type":"strong"},{"text":" — Inserts ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":" into ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", clears ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":", ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".answerRejected","type":"codeVoice"}]},{"type":"text","text":" — Increments "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" so the user faces a new problem."}]}]}]},{"type":"heading","anchor":"Session-pass-behavior","level":3,"text":"Session-pass behavior"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once a reason is in "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", subsequent "},{"type":"codeVoice","code":".request(reason:)"},{"type":"text","text":" calls for that same reason short-circuit: the plugin dispatches "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"Set<String>"},{"type":"text","text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate "},{"type":"codeVoice","code":"state.parentalGate.passedReasons"},{"type":"text","text":" from your own reducer (for example, in response to an "},{"type":"codeVoice","code":"app\/lock"},{"type":"text","text":" action)."}]},{"type":"heading","anchor":"Customizing-the-challenge","level":2,"text":"Customizing the challenge"},{"inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource"},{"type":"text","text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:"}],"type":"paragraph"},{"code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The generator runs synchronously each time the plugin needs a new challenge (on "},{"code":".request","type":"codeVoice"},{"type":"text","text":", "},{"code":".regenerateChallenge","type":"codeVoice"},{"type":"text","text":", and "},{"code":".answerRejected","type":"codeVoice"},{"type":"text","text":"). Keep it cheap and pure — no I\/O."}],"type":"paragraph"}]}],"kind":"article","identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Article","role":"article","title":"SwiduxParentalGate Reference"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginparentalgatereference"]}],"sections":[],"references":{"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"role":"article","kind":"article","url":"\/documentation\/swidux\/howtoaddaparentalgate","title":"Add a Parental Gate","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","type":"topic"},"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"url":"\/documentation\/swidux\/pluginfeatureflagsreference","role":"article","kind":"article","title":"SwiduxFeatureFlags Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","type":"topic","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}]},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","url":"\/documentation\/swidux\/pluginpaywallreference","title":"SwiduxPaywall Reference","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"UndoPlugin"}],"url":"\/documentation\/swidux\/undoplugin","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","role":"symbol","kind":"symbol","type":"topic","title":"UndoPlugin","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}],"abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}]},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"url":"\/documentation\/swidux\/persistencemiddlewareguide","role":"article","kind":"article","title":"Persistence Middleware","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","type":"topic","abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}]},"doc://Swidux/documentation/Swidux/UndoRedo":{"url":"\/documentation\/swidux\/undoredo","role":"article","kind":"article","title":"Undo \/ Redo","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","type":"topic","abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"},{"text":".","type":"text"}]},"doc://Swidux/documentation/Swidux/GettingStarted":{"url":"\/documentation\/swidux\/gettingstarted","role":"article","kind":"article","title":"Getting Started with Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","type":"topic","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"url":"\/documentation\/swidux\/pluginarchitecture","role":"article","kind":"article","title":"Plugin Architecture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"topic","abstract":[{"type":"text","text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features."}]},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"url":"\/documentation\/swidux\/pluginanalyticsreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","role":"article","kind":"article","type":"topic","title":"SwiduxAnalytics Reference","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}]},"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"url":"\/documentation\/swidux\/entitystoreguide","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","role":"article","kind":"article","type":"topic","title":"EntityStore","abstract":[{"text":"An ordered, keyed collection with built-in change tracking.","type":"text"}]},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"url":"\/documentation\/swidux\/pluginkillswitchreference","role":"article","kind":"article","title":"SwiduxKillswitch Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","type":"topic","abstract":[{"type":"text","text":"Public API surface for the "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives."}]},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","role":"collection","kind":"symbol","title":"Swidux","identifier":"doc:\/\/Swidux\/documentation\/Swidux","type":"topic","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}]},"doc://Swidux/documentation/Swidux/MacrosReference":{"url":"\/documentation\/swidux\/macrosreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","role":"article","kind":"article","type":"topic","title":"Macros","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" — the two macros that generate the observation bridge between value-type state and SwiftUI."}]},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"url":"\/documentation\/swidux\/keyvaluestoreguide","role":"collectionGroup","kind":"article","title":"KeyValueStore","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","type":"topic","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}]}}}