{"kind":"article","hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"Swidux"}],"title":"SwiduxParentalGate Reference"},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference","generated":true,"anchor":"Reference"}],"sections":[],"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" ships as a separate library target alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":". It provides a single domain plugin ("},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},{"type":"text","text":". For the underlying plugin contract, see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}]},{"anchor":"Library-target","type":"heading","level":2,"text":"Library target"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" product as a target dependency, then import it where you wire the store and present the gate sheet:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxParentalGate"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package vends three library products: "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":", and "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":". Pull in only what you use."}]},{"anchor":"Types","type":"heading","level":2,"text":"Types"},{"anchor":"ParentalGatePlugin","type":"heading","level":3,"text":"ParentalGatePlugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"MainActor"},{"type":"text","text":"-bound domain plugin generic over the host app’s root state and action types."}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The three wiring closures follow the standard domain-plugin shape described in "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action."}]},{"anchor":"ParentalGateState","type":"heading","level":3,"text":"ParentalGateState"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The state slice the plugin owns."}]},{"type":"codeListing","syntax":"swift","code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"pendingReason","type":"codeVoice"},{"text":" — non-","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" while a challenge is active. Drives sheet presentation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"challenge","type":"codeVoice"},{"text":" — the currently-presented arithmetic problem.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"attempts","type":"codeVoice"},{"text":" — count of incorrect submissions against the current challenge.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"text":" — reasons already cleared this session (see action semantics below).","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"ParentalGateAction","type":"heading","level":3,"text":"ParentalGateAction"},{"type":"codeListing","syntax":"swift","code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"]},{"anchor":"MathChallenge","type":"heading","level":3,"text":"MathChallenge"},{"type":"codeListing","syntax":"swift","code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expected"},{"type":"text","text":" computes the correct answer from "},{"type":"codeVoice","code":"left"},{"type":"text","text":", "},{"type":"codeVoice","code":"right"},{"type":"text","text":", and "},{"type":"codeVoice","code":"op"},{"type":"text","text":". "},{"type":"codeVoice","code":"Op.symbol"},{"type":"text","text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7)."}]},{"anchor":"ParentalChallengeSource","type":"heading","level":3,"text":"ParentalChallengeSource"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A value-type holder for a challenge generator closure."}]},{"type":"codeListing","syntax":"swift","code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"]},{"items":[{"content":[{"inlineContent":[{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"type":"text","text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"type":"text","text":" — always returns the supplied challenge. Use this in tests."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Action-semantics","type":"heading","level":2,"text":"Action semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"ParentalGateAction"},{"type":"text","text":" case mutates the state slice as follows:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".request(reason:)","type":"codeVoice"}]},{"type":"text","text":" — If "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" already contains "},{"code":"reason","type":"codeVoice"},{"type":"text","text":", the plugin returns an effect that immediately dispatches "},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"type":"text","text":" and leaves "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":" unchanged. Otherwise, it sets "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":", generates a fresh "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", and resets "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":" to "},{"code":"0","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".dismiss","type":"codeVoice"}]},{"type":"text","text":" — Clears "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":", "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", and "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":". Does not modify "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".regenerateChallenge","type":"codeVoice"}]},{"type":"text","text":" — Replaces "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":" with a freshly generated one. Useful for a “new question” button."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".submitAnswer(Int)","type":"codeVoice"}]},{"type":"text","text":" — Compares against "},{"code":"challenge.expected","type":"codeVoice"},{"type":"text","text":". Returns an effect that dispatches either "},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"type":"text","text":" (with the current "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":") or "},{"code":".answerRejected","type":"codeVoice"},{"type":"text","text":". No-op if "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":" or "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":" is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".answerAccepted(reason:)"}],"type":"strong"},{"text":" — Inserts ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":" into ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", clears ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":", ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".answerRejected"}],"type":"strong"},{"text":" — Increments ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":" and regenerates ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":" so the user faces a new problem.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anch