{"sections":[],"kind":"article","identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/swidux\/pluginparentalgatereference"],"traits":[{"interfaceLanguage":"swift"}]}],"seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"]},{"generated":true,"anchor":"Reference","title":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"]}],"metadata":{"modules":[{"name":"Swidux"}],"title":"SwiduxParentalGate Reference","roleHeading":"Article","role":"article"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" ships as a separate library target alongside ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":". It provides a single domain plugin (","type":"text"},{"code":"ParentalGatePlugin","type":"codeVoice"},{"text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","type":"reference","isActive":true},{"text":". For the underlying plugin contract, see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference","isActive":true},{"text":".","type":"text"}]},{"anchor":"Library-target","level":2,"type":"heading","text":"Library target"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" product as a target dependency, then import it where you wire the store and present the gate sheet:","type":"text"}]},{"type":"codeListing","code":["import SwiduxParentalGate"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The package vends three library products: ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":". Pull in only what you use."}]},{"anchor":"Types","level":2,"type":"heading","text":"Types"},{"anchor":"ParentalGatePlugin","level":3,"type":"heading","text":"ParentalGatePlugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"MainActor"},{"type":"text","text":"-bound domain plugin generic over the host app’s root state and action types."}]},{"type":"codeListing","code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The three wiring closures follow the standard domain-plugin shape described in ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action.","type":"text"}]},{"level":3,"type":"heading","text":"ParentalGateState","anchor":"ParentalGateState"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The state slice the plugin owns."}]},{"type":"codeListing","code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"pendingReason"},{"text":" — non-","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" while a challenge is active. Drives sheet presentation.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"challenge","type":"codeVoice"},{"text":" — the currently-presented arithmetic problem.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"attempts"},{"type":"text","text":" — count of incorrect submissions against the current challenge."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" — reasons already cleared this session (see action semantics below)."}]}]}]},{"text":"ParentalGateAction","anchor":"ParentalGateAction","type":"heading","level":3},{"code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"],"type":"codeListing","syntax":"swift"},{"text":"MathChallenge","anchor":"MathChallenge","type":"heading","level":3},{"code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"expected"},{"type":"text","text":" computes the correct answer from "},{"type":"codeVoice","code":"left"},{"type":"text","text":", "},{"type":"codeVoice","code":"right"},{"type":"text","text":", and "},{"type":"codeVoice","code":"op"},{"type":"text","text":". "},{"type":"codeVoice","code":"Op.symbol"},{"text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7).","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"ParentalChallengeSource","text":"ParentalChallengeSource"},{"type":"paragraph","inlineContent":[{"text":"A value-type holder for a challenge generator closure.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"type":"text","text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.fixed(_:)"},{"type":"text","text":" — always returns the supplied challenge. Use this in tests."}],"type":"paragraph"}]}]},{"text":"Action semantics","level":2,"type":"heading","anchor":"Action-semantics"},{"inlineContent":[{"type":"text","text":"Each "},{"code":"ParentalGateAction","type":"codeVoice"},{"type":"text","text":" case mutates the state slice as follows:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".request(reason:)","type":"codeVoice"}]},{"text":" — If ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":" already contains ","type":"text"},{"type":"codeVoice","code":"reason"},{"text":", the plugin returns an effect that immediately dispatches ","type":"text"},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"text":" and leaves ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":" unchanged. Otherwise, it sets ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":", generates a fresh ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":", and resets ","type":"text"},{"type":"codeVoice","code":"attempts"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"0"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".dismiss"}]},{"type":"text","text":" — Clears "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":". Does not modify "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".regenerateChallenge","type":"codeVoice"}]},{"text":" — Replaces ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":" with a freshly generated one. Useful for a “new question” button.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".submitAnswer(Int)"}],"type":"strong"},{"text":" — Compares against ","type":"text"},{"code":"challenge.expected","type":"codeVoice"},{"text":". Returns an effect that dispatches either ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" (with the current ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":") or ","type":"text"},{"code":".answerRejected","type":"codeVoice"},{"text":". No-op if ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".answerAccepted(reason:)"}]},{"text":" — Inserts ","type":"text"},{"code":"reason","type":"codeVoice"},{"type":"text","text":" into "},{"code":"passedReasons","type":"codeVoice"},{"text":", clears ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":", "},{"code":"challenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":".answerRejected"}]},{"type":"text","text":" — Increments "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" so the user faces a new problem."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"Session-pass behavior","type":"heading","anchor":"Session-pass-behavior"},{"inlineContent":[{"type":"text","text":"Once a reason is in "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", subsequent "},{"type":"codeVoice","code":".request(reason:)"},{"text":" calls for that same reason short-circuit: the plugin dispatches ","type":"text"},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"text":" is a ","type":"text"},{"type":"codeVoice","code":"Set<String>"},{"text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate ","type":"text"},{"type":"codeVoice","code":"state.parentalGate.passedReasons"},{"text":" from your own reducer (for example, in response to an ","type":"text"},{"type":"codeVoice","code":"app\/lock"},{"text":" action).","type":"text"}]},{"level":2,"text":"Customizing the challenge","anchor":"Customizing-the-challenge","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource"},{"type":"text","text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:"}]},{"type":"codeListing","code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The generator runs synchronously each time the plugin needs a new challenge (on "},{"type":"codeVoice","code":".request"},{"type":"text","text":", "},{"type":"codeVoice","code":".regenerateChallenge"},{"type":"text","text":", and "},{"type":"codeVoice","code":".answerRejected"},{"type":"text","text":"). Keep it cheap and pure — no I\/O."}]}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"type":"topic","kind":"article","title":"SwiduxAnalytics Reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","role":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxAnalytics","type":"codeVoice"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t cover.","type":"text"}],"url":"\/documentation\/swidux\/pluginanalyticsreference"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"url":"\/documentation\/swidux\/undoplugin","title":"UndoPlugin"},"doc://Swidux/documentation/Swidux/PersistenceMiddlewareGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Persiste