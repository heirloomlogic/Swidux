{"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"title":"Reference","anchor":"Reference","generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginparentalgatereference"]}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},"sections":[],"metadata":{"role":"article","title":"SwiduxParentalGate Reference","modules":[{"name":"Swidux"}],"roleHeading":"Article"},"abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" ships as a separate library target alongside "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":". It provides a single domain plugin ("},{"code":"ParentalGatePlugin","type":"codeVoice"},{"type":"text","text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},{"type":"text","text":". For the underlying plugin contract, see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Library-target","level":2,"text":"Library target","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" product as a target dependency, then import it where you wire the store and present the gate sheet:"}],"type":"paragraph"},{"syntax":"swift","code":["import SwiduxParentalGate"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The package vends three library products: "},{"code":"Swidux","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxKillswitch","type":"codeVoice"},{"type":"text","text":", "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":", and "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":". Pull in only what you use."}],"type":"paragraph"},{"anchor":"Types","level":2,"text":"Types","type":"heading"},{"anchor":"ParentalGatePlugin","level":3,"text":"ParentalGatePlugin","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"code":"MainActor","type":"codeVoice"},{"type":"text","text":"-bound domain plugin generic over the host app’s root state and action types."}],"type":"paragraph"},{"syntax":"swift","code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The three wiring closures follow the standard domain-plugin shape described in "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"type":"text","text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action."}],"type":"paragraph"},{"anchor":"ParentalGateState","level":3,"text":"ParentalGateState","type":"heading"},{"inlineContent":[{"type":"text","text":"The state slice the plugin owns."}],"type":"paragraph"},{"syntax":"swift","code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"pendingReason","type":"codeVoice"},{"text":" — non-","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" while a challenge is active. Drives sheet presentation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"challenge","type":"codeVoice"},{"text":" — the currently-presented arithmetic problem.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"attempts","type":"codeVoice"},{"text":" — count of incorrect submissions against the current challenge.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"text":" — reasons already cleared this session (see action semantics below).","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"ParentalGateAction","level":3,"text":"ParentalGateAction","type":"heading"},{"syntax":"swift","code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"],"type":"codeListing"},{"anchor":"MathChallenge","level":3,"text":"MathChallenge","type":"heading"},{"syntax":"swift","code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"expected","type":"codeVoice"},{"type":"text","text":" computes the correct answer from "},{"code":"left","type":"codeVoice"},{"type":"text","text":", "},{"code":"right","type":"codeVoice"},{"type":"text","text":", and "},{"code":"op","type":"codeVoice"},{"type":"text","text":". "},{"code":"Op.symbol","type":"codeVoice"},{"type":"text","text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7)."}],"type":"paragraph"},{"anchor":"ParentalChallengeSource","level":3,"text":"ParentalChallengeSource","type":"heading"},{"inlineContent":[{"type":"text","text":"A value-type holder for a challenge generator closure."}],"type":"paragraph"},{"syntax":"swift","code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"text":" — always returns the supplied challenge. Use this in tests.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Action-semantics","level":2,"text":"Action semantics","type":"heading"},{"inlineContent":[{"type":"text","text":"Each "},{"code":"ParentalGateAction","type":"codeVoice"},{"type":"text","text":" case mutates the state slice as follows:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".request(reason:)"}],"type":"strong"},{"text":" — If ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":" already contains ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":", the plugin returns an effect that immediately dispatches ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" and leaves ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":" unchanged. Otherwise, it sets ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":", generates a fresh ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", and resets ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"0","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".dismiss"}],"type":"strong"},{"text":" — Clears ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":", ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":". Does not modify ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".regenerateChallenge"}],"type":"strong"},{"text":" — Replaces ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":" with a freshly generated one. Useful for a “new question” button.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".submitAnswer(Int)"}],"type":"strong"},{"text":" — Compares against ","type":"text"},{"code":"challenge.expected","type":"codeVoice"},{"text":". Returns an effect that dispatches either ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" (with the current ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":") or ","type":"text"},{"code":".answerRejected","type":"codeVoice"},{"text":". No-op if ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".answerAccepted(reason:)"}],"type":"strong"},{"text":" — Inserts ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":" into ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", clears ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":", ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".answerRejected"}],"type":"strong"},{"text":" — Increments ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":" and regenerates ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":" so the user faces a new problem.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Session-pass-behavior","level":3,"text":"Session-pass behavior","type":"heading"},{"inlineContent":[{"type":"text","text":"Once a reason is in "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":", subsequent "},{"code":".request(reason:)","type":"codeVoice"},{"type":"text","text":" calls for that same reason short-circuit: the plugin dispatches "},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"type":"text","text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session."}],"type":"paragraph"},{"inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" is a "},{"code":"Set<String>","type":"codeVoice"},{"type":"text","text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate "},{"code":"state.parentalGate.passedReasons","type":"codeVoice"},{"type":"text","text":" from your own reducer (for example, in response to an "},{"code":"app\/lock","type":"codeVoice"},{"type":"text","text":" action)."}],"type":"paragraph"},{"anchor":"Customizing-the-challenge","level":2,"text":"Customizing the challenge","type":"heading"},{"inlineContent":[{"code":"ParentalChallengeSource","type":"codeVoice"},{"type":"text","text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:"}],"type":"paragraph"},{"syntax":"swift","code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The generator runs synchronously each time the plugin needs a new challenge (on "},{"code":".request","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":".regenerateChallenge"},{"type":"text","text":", and "},{"code":".answerRejected","type":"codeVoice"},{"text":"). Keep it cheap and pure — no I\/O.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://Swidux/documentation/Swidux/EntityStoreGuide":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","type":"topic","kind":"article","abstract":[{"type":"text","text":"An ordered, keyed collection with built-in change tracking."}],"role":"article","url":"\/documentation\/swidux\/entitystoreguide","title":"EntityStore"},"doc://Swidux/documentation/Swidux/PluginPaywallReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"topic","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":" library — paywall presentation, entitlement observation, and purchase orchestration.","type":"text"}],"role":"article","url":"\/documentation\/swidux\/pluginpaywallreference","title":"SwiduxPaywall Reference"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","navigatorTitle":[{"kind":"identifier","text":"UndoPlugin"}],"type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Snapshot-based undo\/redo plugin."}],"role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identif