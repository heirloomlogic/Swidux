{"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" ships as a separate library target alongside ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":". It provides a single domain plugin (","type":"text"},{"code":"ParentalGatePlugin","type":"codeVoice"},{"text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},{"text":". For the underlying plugin contract, see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}]},{"type":"heading","level":2,"text":"Library target","anchor":"Library-target"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" product as a target dependency, then import it where you wire the store and present the gate sheet:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxParentalGate"]},{"type":"paragraph","inlineContent":[{"text":"The package vends three library products: ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":". Pull in only what you use.","type":"text"}]},{"type":"heading","level":2,"text":"Types","anchor":"Types"},{"type":"heading","level":3,"text":"ParentalGatePlugin","anchor":"ParentalGatePlugin"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"MainActor","type":"codeVoice"},{"text":"-bound domain plugin generic over the host app’s root state and action types.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"]},{"type":"paragraph","inlineContent":[{"text":"The three wiring closures follow the standard domain-plugin shape described in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action.","type":"text"}]},{"type":"heading","level":3,"text":"ParentalGateState","anchor":"ParentalGateState"},{"type":"paragraph","inlineContent":[{"text":"The state slice the plugin owns.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"pendingReason"},{"text":" — non-","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" while a challenge is active. Drives sheet presentation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"challenge"},{"text":" — the currently-presented arithmetic problem.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"attempts"},{"text":" — count of incorrect submissions against the current challenge.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"text":" — reasons already cleared this session (see action semantics below).","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","level":3,"text":"ParentalGateAction","anchor":"ParentalGateAction"},{"type":"codeListing","syntax":"swift","code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"]},{"type":"heading","level":3,"text":"MathChallenge","anchor":"MathChallenge"},{"type":"codeListing","syntax":"swift","code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"expected","type":"codeVoice"},{"text":" computes the correct answer from ","type":"text"},{"code":"left","type":"codeVoice"},{"text":", ","type":"text"},{"code":"right","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"op","type":"codeVoice"},{"text":". ","type":"text"},{"code":"Op.symbol","type":"codeVoice"},{"text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7).","type":"text"}]},{"type":"heading","level":3,"text":"ParentalChallengeSource","anchor":"ParentalChallengeSource"},{"type":"paragraph","inlineContent":[{"text":"A value-type holder for a challenge generator closure.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.standard"},{"text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.fixed(_:)"},{"text":" — always returns the supplied challenge. Use this in tests.","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Action semantics","anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"code":"ParentalGateAction","type":"codeVoice"},{"text":" case mutates the state slice as follows:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".request(reason:)","type":"codeVoice"}],"type":"strong"},{"text":" — If ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":" already contains ","type":"text"},{"type":"codeVoice","code":"reason"},{"text":", the plugin returns an effect that immediately dispatches ","type":"text"},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"text":" and leaves ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":" unchanged. Otherwise, it sets ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":", generates a fresh ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":", and resets ","type":"text"},{"type":"codeVoice","code":"attempts"},{"text":" to ","type":"text"},{"type":"codeVoice","code":"0"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".dismiss","type":"codeVoice"}],"type":"strong"},{"text":" — Clears ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":", ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"attempts"},{"text":". Does not modify ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".regenerateChallenge","type":"codeVoice"}],"type":"strong"},{"text":" — Replaces ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":" with a freshly generated one. Useful for a “new question” button.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".submitAnswer(Int)","type":"codeVoice"}],"type":"strong"},{"text":" — Compares against ","type":"text"},{"type":"codeVoice","code":"challenge.expected"},{"text":". Returns an effect that dispatches either ","type":"text"},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"text":" (with the current ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":") or ","type":"text"},{"type":"codeVoice","code":".answerRejected"},{"text":". No-op if ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".answerAccepted(reason:)","type":"codeVoice"}],"type":"strong"},{"text":" — Inserts ","type":"text"},{"type":"codeVoice","code":"reason"},{"text":" into ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"text":", clears ","type":"text"},{"type":"codeVoice","code":"pendingReason"},{"text":", ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"attempts"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".answerRejected","type":"codeVoice"}],"type":"strong"},{"text":" — Increments ","type":"text"},{"type":"codeVoice","code":"attempts"},{"text":" and regenerates ","type":"text"},{"type":"codeVoice","code":"challenge"},{"text":" so the user faces a new problem.","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","level":3,"text":"Session-pass behavior","anchor":"Session-pass-behavior"},{"type":"paragraph","inlineContent":[{"text":"Once a reason is in ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", subsequent ","type":"text"},{"code":".request(reason:)","type":"codeVoice"},{"text":" calls for that same reason short-circuit: the plugin dispatches ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"Set<String>","type":"codeVoice"},{"text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate ","type":"text"},{"code":"state.parentalGate.passedReasons","type":"codeVoice"},{"text":" from your own reducer (for example, in response to an ","type":"text"},{"code":"app\/lock","type":"codeVoice"},{"text":" action).","type":"text"}]},{"type":"heading","level":2,"text":"Customizing the challenge","anchor":"Customizing-the-challenge"},{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource","type":"codeVoice"},{"text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"]},{"type":"paragraph","inlineContent":[{"text":"The generator runs synchronously each time the plugin needs a new challenge (on ","type":"text"},{"code":".request","type":"codeVoice"},{"text":", ","type":"text"},{"code":".regenerateChallenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":".answerRejected","type":"codeVoice"},{"text":"). Keep it cheap and pure — no I\/O.","type":"text"}]}]}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","title":"SwiduxParentalGate Reference","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation","anchor":"Related-Documentation"},{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAna