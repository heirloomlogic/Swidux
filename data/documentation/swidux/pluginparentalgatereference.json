"},{"type":"paragraph","inlineContent":[{"text":"The three wiring closures follow the standard domain-plugin shape described in ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action.","type":"text"}]},{"type":"heading","level":3,"text":"ParentalGateState","anchor":"ParentalGateState"},{"type":"paragraph","inlineContent":[{"text":"The state slice the plugin owns.","type":"text"}]},{"type":"codeListing","code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" — non-"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" while a challenge is active. Drives sheet presentation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"challenge"},{"type":"text","text":" — the currently-presented arithmetic problem."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"attempts"},{"type":"text","text":" — count of incorrect submissions against the current challenge."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" — reasons already cleared this session (see action semantics below)."}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"ParentalGateAction","anchor":"ParentalGateAction"},{"type":"codeListing","code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"],"syntax":"swift"},{"type":"heading","level":3,"text":"MathChallenge","anchor":"MathChallenge"},{"type":"codeListing","code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"code":"expected","type":"codeVoice"},{"text":" computes the correct answer from ","type":"text"},{"code":"left","type":"codeVoice"},{"text":", ","type":"text"},{"code":"right","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"op","type":"codeVoice"},{"text":". ","type":"text"},{"code":"Op.symbol","type":"codeVoice"},{"text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7).","type":"text"}]},{"type":"heading","level":3,"text":"ParentalChallengeSource","anchor":"ParentalChallengeSource"},{"type":"paragraph","inlineContent":[{"text":"A value-type holder for a challenge generator closure.","type":"text"}]},{"type":"codeListing","code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"],"syntax":"swift"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.standard"},{"type":"text","text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource.fixed(_:)"},{"type":"text","text":" — always returns the supplied challenge. Use this in tests."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Action semantics","anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"code":"ParentalGateAction","type":"codeVoice"},{"text":" case mutates the state slice as follows:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"code":".request(reason:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — If "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" already contains "},{"type":"codeVoice","code":"reason"},{"type":"text","text":", the plugin returns an effect that immediately dispatches "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" and leaves "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" unchanged. Otherwise, it sets "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", generates a fresh "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and resets "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" to "},{"type":"codeVoice","code":"0"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".dismiss","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Clears "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":". Does not modify "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".regenerateChallenge","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Replaces "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" with a freshly generated one. Useful for a “new question” button."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".submitAnswer(Int)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Compares against "},{"type":"codeVoice","code":"challenge.expected"},{"type":"text","text":". Returns an effect that dispatches either "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" (with the current "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":") or "},{"type":"codeVoice","code":".answerRejected"},{"type":"text","text":". No-op if "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" or "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":" is "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".answerAccepted(reason:)","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Inserts "},{"type":"codeVoice","code":"reason"},{"type":"text","text":" into "},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"code":".answerRejected","type":"codeVoice"}],"type":"strong"},{"type":"text","text":" — Increments "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" so the user faces a new problem."}],"type":"paragraph"}]}]},{"type":"heading","level":3,"text":"Session-pass behavior","anchor":"Session-pass-behavior"},{"type":"paragraph","inlineContent":[{"text":"Once a reason is in ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", subsequent ","type":"text"},{"code":".request(reason:)","type":"codeVoice"},{"text":" calls for that same reason short-circuit: the plugin dispatches ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"Set<String>","type":"codeVoice"},{"text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate ","type":"text"},{"code":"state.parentalGate.passedReasons","type":"codeVoice"},{"text":" from your own reducer (for example, in response to an ","type":"text"},{"code":"app\/lock","type":"codeVoice"},{"text":" action).","type":"text"}]},{"type":"heading","level":2,"text":"Customizing the challenge","anchor":"Customizing-the-challenge"},{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource","type":"codeVoice"},{"text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:","type":"text"}]},{"type":"codeListing","code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The generator runs synchronously each time the plugin needs a new challenge (on ","type":"text"},{"code":".request","type":"codeVoice"},{"text":", ","type":"text"},{"code":".regenerateChallenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":".answerRejected","type":"codeVoice"},{"text":"). Keep it cheap and pure — no I\/O.","type":"text"}]}]}],"sections":[],"metadata":{"role":"article","modules":[{"name":"Swidux"}],"roleHeading":"Article","title":"SwiduxParentalGate Reference"},"abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"references":{"doc://Swidux/documentation/Swidux/PluginFeatureFlagsReference":{"kind":"article","role":"article","url":"\/documentation\/swidux\/pluginfeatureflagsreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","title":"SwiduxFeatureFlags Reference","abstract":[{"type":"text","text":"API reference for the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" library — typed feature flags, A\/B variants, and remote-tunable scalar values backed by a Swidux-defined JSON wire format."}],"type":"topic"},"doc://Swidux/documentation/Swidux/MacrosReference":{"kind":"article","role":"article","url":"\/documentation\/swidux\/macrosreference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","type":"topic","title":"Macros","abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Slice"},{"text":" (the observation bridge between value-type state and SwiftUI), and for ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"Swi