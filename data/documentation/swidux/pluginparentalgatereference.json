"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":".","type":"text"}]},{"anchor":"Library-target","type":"heading","level":2,"text":"Library target"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" product as a target dependency, then import it where you wire the store and present the gate sheet:","type":"text"}]},{"syntax":"swift","code":["import SwiduxParentalGate"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The package vends three library products: ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"SwiduxPaywall","type":"codeVoice"},{"text":". Pull in only what you use.","type":"text"}]},{"anchor":"Types","type":"heading","level":2,"text":"Types"},{"anchor":"ParentalGatePlugin","type":"heading","level":3,"text":"ParentalGatePlugin"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"MainActor","type":"codeVoice"},{"text":"-bound domain plugin generic over the host app’s root state and action types.","type":"text"}]},{"syntax":"swift","code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The three wiring closures follow the standard domain-plugin shape described in ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"},{"text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action.","type":"text"}]},{"anchor":"ParentalGateState","type":"heading","level":3,"text":"ParentalGateState"},{"type":"paragraph","inlineContent":[{"text":"The state slice the plugin owns.","type":"text"}]},{"syntax":"swift","code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"],"type":"codeListing"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":" — non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" while a challenge is active. Drives sheet presentation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"challenge","type":"codeVoice"},{"type":"text","text":" — the currently-presented arithmetic problem."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"attempts","type":"codeVoice"},{"type":"text","text":" — count of incorrect submissions against the current challenge."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" — reasons already cleared this session (see action semantics below)."}],"type":"paragraph"}]}]},{"anchor":"ParentalGateAction","type":"heading","level":3,"text":"ParentalGateAction"},{"syntax":"swift","code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"],"type":"codeListing"},{"anchor":"MathChallenge","type":"heading","level":3,"text":"MathChallenge"},{"syntax":"swift","code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"expected","type":"codeVoice"},{"text":" computes the correct answer from ","type":"text"},{"code":"left","type":"codeVoice"},{"text":", ","type":"text"},{"code":"right","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"op","type":"codeVoice"},{"text":". ","type":"text"},{"code":"Op.symbol","type":"codeVoice"},{"text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7).","type":"text"}]},{"anchor":"ParentalChallengeSource","type":"heading","level":3,"text":"ParentalChallengeSource"},{"type":"paragraph","inlineContent":[{"text":"A value-type holder for a challenge generator closure.","type":"text"}]},{"syntax":"swift","code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"],"type":"codeListing"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"type":"text","text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"type":"text","text":" — always returns the supplied challenge. Use this in tests."}],"type":"paragraph"}]}]},{"anchor":"Action-semantics","type":"heading","level":2,"text":"Action semantics"},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"code":"ParentalGateAction","type":"codeVoice"},{"text":" case mutates the state slice as follows:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".request(reason:)","type":"codeVoice"}]},{"type":"text","text":" — If "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":" already contains "},{"code":"reason","type":"codeVoice"},{"type":"text","text":", the plugin returns an effect that immediately dispatches "},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"type":"text","text":" and leaves "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":" unchanged. Otherwise, it sets "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":", generates a fresh "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", and resets "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":" to "},{"code":"0","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".dismiss","type":"codeVoice"}]},{"type":"text","text":" — Clears "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":", "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", and "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":". Does not modify "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".regenerateChallenge","type":"codeVoice"}]},{"type":"text","text":" — Replaces "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":" with a freshly generated one. Useful for a “new question” button."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".submitAnswer(Int)","type":"codeVoice"}]},{"type":"text","text":" — Compares against "},{"code":"challenge.expected","type":"codeVoice"},{"type":"text","text":". Returns an effect that dispatches either "},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"type":"text","text":" (with the current "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":") or "},{"code":".answerRejected","type":"codeVoice"},{"type":"text","text":". No-op if "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":" or "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":" is "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".answerAccepted(reason:)","type":"codeVoice"}]},{"type":"text","text":" — Inserts "},{"code":"reason","type":"codeVoice"},{"type":"text","text":" into "},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":", clears "},{"code":"pendingReason","type":"codeVoice"},{"type":"text","text":", "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":", and "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":".answerRejected","type":"codeVoice"}]},{"type":"text","text":" — Increments "},{"code":"attempts","type":"codeVoice"},{"type":"text","text":" and regenerates "},{"code":"challenge","type":"codeVoice"},{"type":"text","text":" so the user faces a new problem."}],"type":"paragraph"}]}]},{"anchor":"Session-pass-behavior","type":"heading","level":3,"text":"Session-pass behavior"},{"type":"paragraph","inlineContent":[{"text":"Once a reason is in ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", subsequent ","type":"text"},{"code":".request(reason:)","type":"codeVoice"},{"text":" calls for that same reason short-circuit: the plugin dispatches ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"Set<String>","type":"codeVoice"},{"text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate ","type":"text"},{"code":"state.parentalGate.passedReasons","type":"codeVoice"},{"text":" from your own reducer (for example, in response to an ","type":"text"},{"code":"app\/lock","type":"codeVoice"},{"text":" action).","type":"text"}]},{"anchor":"Customizing-the-challenge","type":"heading","level":2,"text":"Customizing the challenge"},{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource","type":"codeVoice"},{"text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:","type":"text"}]},{"syntax":"swift","code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The generator runs synchronously each time the plugin needs a new challenge (on ","type":"text"},{"code":".request","type":"codeVoice"},{"text":", ","type":"text"},{"code":".regenerateChallenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":".answerRejected","type":"codeVoice"},{"text":"). Keep it cheap and pure — no I\/O.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"type":"text","text":"API surface for the "},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"references":{"doc://Swidux/documentation/Swidux/GettingStarted":{"url":"\/documentation\/swidux\/gettingstarted","role":"article","kind":"article","title":"Getting Started with Swidux","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","abstract":[{"type":"text","text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence."}]},"doc://Swidux/documentation/Swidux/PluginArchitecture":{"title":"Plugin Architecture","abstract":[{"text":"Extend the dispatch cycle with lifecycle hooks — from invisible infrastructure to domain-specific features.","type":"text"}],"kind":"article","type":"topic","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","url":"\/documentation\/swidux\/pluginarchitecture"},"doc://Swidux/documentation/Swidux/Troubleshooting":{"url":"\/documentation\/swidux\/troubleshooting","role":"article","kind":"article","title":"Troubleshooting","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting","abstract":[{"type":"text","text":"Symptoms you may hit while adopting Swidux, and what each one actually means."}]},"doc:/