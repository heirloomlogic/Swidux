{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference"},"sections":[],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"generated":true,"anchor":"Reference","title":"Reference"}],"abstract":[{"type":"text","text":"API surface for the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" library — a domain plugin that guards actions behind a math challenge."}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" ships as a separate library target alongside "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":". It provides a single domain plugin ("},{"type":"codeVoice","code":"ParentalGatePlugin"},{"type":"text","text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","isActive":true,"type":"reference"},{"type":"text","text":". For the underlying plugin contract, see "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Library target","anchor":"Library-target"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":" product as a target dependency, then import it where you wire the store and present the gate sheet:"}]},{"type":"codeListing","syntax":"swift","code":["import SwiduxParentalGate"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The package vends three library products: "},{"type":"codeVoice","code":"Swidux"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxKillswitch"},{"type":"text","text":", "},{"type":"codeVoice","code":"SwiduxParentalGate"},{"type":"text","text":", and "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":". Pull in only what you use."}]},{"type":"heading","level":2,"text":"Types","anchor":"Types"},{"type":"heading","level":3,"text":"ParentalGatePlugin","anchor":"ParentalGatePlugin"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"MainActor"},{"type":"text","text":"-bound domain plugin generic over the host app’s root state and action types."}]},{"type":"codeListing","syntax":"swift","code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The three wiring closures follow the standard domain-plugin shape described in "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","isActive":true,"type":"reference"},{"type":"text","text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action."}]},{"type":"heading","level":3,"text":"ParentalGateState","anchor":"ParentalGateState"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The state slice the plugin owns."}]},{"type":"codeListing","syntax":"swift","code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"pendingReason","type":"codeVoice"},{"text":" — non-","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" while a challenge is active. Drives sheet presentation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"challenge","type":"codeVoice"},{"text":" — the currently-presented arithmetic problem.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"attempts","type":"codeVoice"},{"text":" — count of incorrect submissions against the current challenge.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"text":" — reasons already cleared this session (see action semantics below).","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","level":3,"text":"ParentalGateAction","anchor":"ParentalGateAction"},{"type":"codeListing","syntax":"swift","code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"]},{"type":"heading","level":3,"text":"MathChallenge","anchor":"MathChallenge"},{"type":"codeListing","syntax":"swift","code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"expected"},{"type":"text","text":" computes the correct answer from "},{"type":"codeVoice","code":"left"},{"type":"text","text":", "},{"type":"codeVoice","code":"right"},{"type":"text","text":", and "},{"type":"codeVoice","code":"op"},{"type":"text","text":". "},{"type":"codeVoice","code":"Op.symbol"},{"type":"text","text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7)."}]},{"type":"heading","level":3,"text":"ParentalChallengeSource","anchor":"ParentalChallengeSource"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A value-type holder for a challenge generator closure."}]},{"type":"codeListing","syntax":"swift","code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"text":" — always returns the supplied challenge. Use this in tests.","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Action semantics","anchor":"Action-semantics"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"ParentalGateAction"},{"type":"text","text":" case mutates the state slice as follows:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".request(reason:)"}],"type":"strong"},{"text":" — If ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":" already contains ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":", the plugin returns an effect that immediately dispatches ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" and leaves ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":" unchanged. Otherwise, it sets ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":", generates a fresh ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", and resets ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"0","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".dismiss"}],"type":"strong"},{"text":" — Clears ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":", ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":". Does not modify ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".regenerateChallenge"}],"type":"strong"},{"text":" — Replaces ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":" with a freshly generated one. Useful for a “new question” button.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".submitAnswer(Int)"}],"type":"strong"},{"text":" — Compares against ","type":"text"},{"code":"challenge.expected","type":"codeVoice"},{"text":". Returns an effect that dispatches either ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" (with the current ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":") or ","type":"text"},{"code":".answerRejected","type":"codeVoice"},{"text":". No-op if ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":".answerAccepted(reason:)"}],"type":"strong"},{"text":" — Inserts ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":" into ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"type":"text","text":", clears "},{"type":"codeVoice","code":"pendingReason"},{"type":"text","text":", "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":", and "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":".answerRejected","type":"codeVoice"}]},{"type":"text","text":" — Increments "},{"type":"codeVoice","code":"attempts"},{"type":"text","text":" and regenerates "},{"type":"codeVoice","code":"challenge"},{"type":"text","text":" so the user faces a new problem."}]}]}],"type":"unorderedList"},{"text":"Session-pass behavior","level":3,"type":"heading","anchor":"Session-pass-behavior"},{"type":"paragraph","inlineContent":[{"text":"Once a reason is in ","type":"text"},{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":", subsequent "},{"type":"codeVoice","code":".request(reason:)"},{"type":"text","text":" calls for that same reason short-circuit: the plugin dispatches "},{"type":"codeVoice","code":".answerAccepted(reason:)"},{"type":"text","text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"passedReasons"},{"type":"text","text":" is a "},{"type":"codeVoice","code":"Set<String>"},{"type":"text","text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate "},{"type":"codeVoice","code":"state.parentalGate.passedReasons"},{"type":"text","text":" from your own reducer (for example, in response to an "},{"type":"codeVoice","code":"app\/lock"},{"type":"text","text":" action)."}]},{"text":"Customizing the challenge","level":2,"type":"heading","anchor":"Customizing-the-challenge"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ParentalChallengeSource"},{"text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The generator runs synchronously each time the plugin needs a new challenge (on "},{"type":"codeVoice","code":".request"},{"type":"text","text":", "},{"type":"codeVoice","code":".regenerateChallenge"},{"type":"text","text":", and "},{"type":"codeVoice","code":".answerRejected"},{"text":"). Keep it cheap and pure — no I\/O.","type":"text"}]}]}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article","title":"SwiduxParentalGate Reference"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginparentalgatereference"]}],"references":{"doc://Swidux/documentation/Swidux/GettingStarted":{"abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"role":"article","kind":"article","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"},"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"role":"collectionGroup","kind":"article","title":"KeyValueStore","url":"\/documentation\/swidux\/keyvaluestoreguide","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide"},"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"abstract":[{"text":"Public API surface for the ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison primitives.","type":"text"}],"role":"article","kind":"article","title":"SwiduxKillswitch 