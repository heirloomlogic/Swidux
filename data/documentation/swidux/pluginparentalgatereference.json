{"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture"],"title":"Related Documentation"},{"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"generated":true,"title":"Reference"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/pluginparentalgatereference"]}],"sections":[],"abstract":[{"text":"API surface for the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" library — a domain plugin that guards actions behind a math challenge.","type":"text"}],"metadata":{"roleHeading":"Article","role":"article","title":"SwiduxParentalGate Reference","modules":[{"name":"Swidux"}]},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" ships as a separate library target alongside ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":". It provides a single domain plugin (","type":"text"},{"code":"ParentalGatePlugin","type":"codeVoice"},{"text":"), a state slice, an action enum, and a pluggable challenge generator. For task-oriented integration, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","type":"reference"},{"text":". For the underlying plugin contract, see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":".","type":"text"}]},{"text":"Library target","type":"heading","level":2,"anchor":"Library-target"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"text":" product as a target dependency, then import it where you wire the store and present the gate sheet:","type":"text"}]},{"code":["import SwiduxParentalGate"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"text":"The package vends three library products: ","type":"text"},{"code":"Swidux","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":", ","type":"text"},{"code":"SwiduxParentalGate","type":"codeVoice"},{"type":"text","text":", and "},{"code":"SwiduxPaywall","type":"codeVoice"},{"type":"text","text":". Pull in only what you use."}],"type":"paragraph"},{"text":"Types","level":2,"anchor":"Types","type":"heading"},{"text":"ParentalGatePlugin","level":3,"anchor":"ParentalGatePlugin","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"code":"MainActor","type":"codeVoice"},{"type":"text","text":"-bound domain plugin generic over the host app’s root state and action types."}],"type":"paragraph"},{"syntax":"swift","code":["@MainActor","public struct ParentalGatePlugin<RootState, RootAction>: SwiduxPlugin {","    public typealias State = RootState","    public typealias Action = RootAction","","    public init(","        state: WritableKeyPath<RootState, ParentalGateState>,","        action toRootAction: @escaping @Sendable (ParentalGateAction) -> RootAction,","        extractAction: @escaping @Sendable (RootAction) -> ParentalGateAction?,","        challengeSource: ParentalChallengeSource = .standard","    )","","    public func reduce(state: inout RootState, action: RootAction) -> Effect<RootAction>?","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The three wiring closures follow the standard domain-plugin shape described in ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","type":"reference"},{"text":": a keypath into the host’s state, a lifter from local to root action, and an extractor from root to local action.","type":"text"}]},{"level":3,"type":"heading","text":"ParentalGateState","anchor":"ParentalGateState"},{"inlineContent":[{"text":"The state slice the plugin owns.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct ParentalGateState: Sendable, Equatable {","    public var pendingReason: String?","    public var challenge: MathChallenge?","    public var attempts: Int","    public var passedReasons: Set<String>","","    public init(","        pendingReason: String? = nil,","        challenge: MathChallenge? = nil,","        attempts: Int = 0,","        passedReasons: Set<String> = []","    )","}"],"type":"codeListing"},{"items":[{"content":[{"inlineContent":[{"code":"pendingReason","type":"codeVoice"},{"text":" — non-","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" while a challenge is active. Drives sheet presentation.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"challenge"},{"text":" — the currently-presented arithmetic problem.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"attempts","type":"codeVoice"},{"text":" — count of incorrect submissions against the current challenge.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"text":" — reasons already cleared this session (see action semantics below).","type":"text"}]}]}],"type":"unorderedList"},{"text":"ParentalGateAction","level":3,"anchor":"ParentalGateAction","type":"heading"},{"syntax":"swift","code":["public enum ParentalGateAction: Sendable {","    case request(reason: String)","    case dismiss","    case regenerateChallenge","    case submitAnswer(Int)","    case answerAccepted(reason: String)","    case answerRejected","}"],"type":"codeListing"},{"text":"MathChallenge","level":3,"anchor":"MathChallenge","type":"heading"},{"syntax":"swift","code":["public struct MathChallenge: Sendable, Equatable {","    public let left: Int","    public let right: Int","    public let op: Op","","    public init(left: Int, right: Int, op: Op)","","    public var expected: Int","","    public enum Op: String, Sendable, CaseIterable {","        case plus, minus, times","","        public var symbol: String  \/\/ \"+\", \"−\", \"×\"","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"expected","type":"codeVoice"},{"text":" computes the correct answer from ","type":"text"},{"code":"left","type":"codeVoice"},{"text":", ","type":"text"},{"code":"right","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"op","type":"codeVoice"},{"text":". ","type":"text"},{"code":"Op.symbol","type":"codeVoice"},{"text":" returns a display-friendly Unicode glyph (minus sign U+2212, multiplication sign U+00D7).","type":"text"}],"type":"paragraph"},{"text":"ParentalChallengeSource","level":3,"anchor":"ParentalChallengeSource","type":"heading"},{"inlineContent":[{"text":"A value-type holder for a challenge generator closure.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["public struct ParentalChallengeSource: Sendable {","    public var generate: @Sendable () -> MathChallenge","","    public init(generate: @escaping @Sendable () -> MathChallenge)","","    public static let standard: ParentalChallengeSource","    public static func fixed(_ challenge: MathChallenge) -> ParentalChallengeSource","}"],"type":"codeListing"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource.standard","type":"codeVoice"},{"text":" — random, age-appropriate challenges. Plus and minus use operands in the 10–40 range; times uses 3–9. Subtraction is always non-negative.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ParentalChallengeSource.fixed(_:)","type":"codeVoice"},{"text":" — always returns the supplied challenge. Use this in tests.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Action semantics","level":2,"anchor":"Action-semantics","type":"heading"},{"inlineContent":[{"text":"Each ","type":"text"},{"code":"ParentalGateAction","type":"codeVoice"},{"text":" case mutates the state slice as follows:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".request(reason:)","type":"codeVoice"}],"type":"strong"},{"text":" — If ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":" already contains ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":", the plugin returns an effect that immediately dispatches ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" and leaves ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":" unchanged. Otherwise, it sets ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":", generates a fresh ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", and resets ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":" to ","type":"text"},{"code":"0","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".dismiss","type":"codeVoice"}],"type":"strong"},{"text":" — Clears ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":", ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":". Does not modify ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".regenerateChallenge","type":"codeVoice"}],"type":"strong"},{"text":" — Replaces ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":" with a freshly generated one. Useful for a “new question” button.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".submitAnswer(Int)","type":"codeVoice"}],"type":"strong"},{"text":" — Compares against ","type":"text"},{"code":"challenge.expected","type":"codeVoice"},{"text":". Returns an effect that dispatches either ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" (with the current ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":") or ","type":"text"},{"code":".answerRejected","type":"codeVoice"},{"text":". No-op if ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".answerAccepted(reason:)","type":"codeVoice"}],"type":"strong"},{"text":" — Inserts ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":" into ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", clears ","type":"text"},{"code":"pendingReason","type":"codeVoice"},{"text":", ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":".answerRejected","type":"codeVoice"}],"type":"strong"},{"text":" — Increments ","type":"text"},{"code":"attempts","type":"codeVoice"},{"text":" and regenerates ","type":"text"},{"code":"challenge","type":"codeVoice"},{"text":" so the user faces a new problem.","type":"text"}]}]}],"type":"unorderedList"},{"text":"Session-pass behavior","level":3,"anchor":"Session-pass-behavior","type":"heading"},{"inlineContent":[{"text":"Once a reason is in ","type":"text"},{"code":"passedReasons","type":"codeVoice"},{"text":", subsequent ","type":"text"},{"code":".request(reason:)","type":"codeVoice"},{"text":" calls for that same reason short-circuit: the plugin dispatches ","type":"text"},{"code":".answerAccepted(reason:)","type":"codeVoice"},{"text":" immediately without presenting a challenge. This is intentional — it lets feature reducers re-issue the gate request after re-entering a flow, while only prompting the user once per session.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"passedReasons","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"Set<String>","type":"codeVoice"},{"text":", so use distinct reason keys per gated action when you want them to clear independently. To force a re-challenge, mutate ","type":"text"},{"code":"state.parentalGate.passedReasons","type":"codeVoice"},{"text":" from your own reducer (for example, in response to an ","type":"text"},{"code":"app\/lock","type":"codeVoice"},{"text":" action).","type":"text"}],"type":"paragraph"},{"text":"Customizing the challenge","level":2,"anchor":"Customizing-the-challenge","type":"heading"},{"inlineContent":[{"code":"ParentalChallengeSource","type":"codeVoice"},{"text":" is a single-closure container. To plug in your own generator — different operand ranges, alternative operations, locale-specific phrasing of operands — construct one directly:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let source = ParentalChallengeSource {","    let left = Int.random(in: 50...99)","    let right = Int.random(in: 50...99)","    return MathChallenge(left: left, right: right, op: .plus)","}","","let plugin = ParentalGatePlugin<AppState, AppAction>(","    state: \\.parentalGate,","    action: AppAction.parentalGate,","    extractAction: { if case .parentalGate(let a) = $0 { return a }; return nil },","    challengeSource: source",")"],"type":"codeListing"},{"inlineContent":[{"text":"The generator runs synchronously each time the plugin needs a new challenge (on ","type":"text"},{"code":".request","type":"codeVoice"},{"text":", ","type":"text"},{"code":".regenerateChallenge","type":"codeVoice"},{"text":", and ","type":"text"},{"code":".answerRejected","type":"codeVoice"},{"text":"). Keep it cheap and pure — no I\/O.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","interfaceLanguage":"swift"},"kind":"article","references":{"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"url":"\/documentation\/swidux\/howtoaddaparentalgate","title":"Add a Parental Gate","kind":"article","abstract":[{"text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge.","type":"text"}],"type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate","role":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"role":"article","type":"topic","kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","url":"\/documentation\/swidux\/gettingstarted","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"title":"Getting Started with Swidux"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"url":"\/documentation\/swidux\/pluginanalyticsreference","title":"SwiduxAnalytics Reference","kind":"article","abstract":[{"type":"text","text":"API reference for the "},{"code":"SwiduxAnalytics","type":"codeVoice"},{"type":"text","text":" library — provider-agnostic analytics with declarative event 