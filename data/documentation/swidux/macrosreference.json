rticle"},"doc://Swidux/documentation/Swidux":{"url":"\/documentation\/swidux","role":"collection","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux","kind":"symbol","abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"title":"Swidux"},"doc://Swidux/documentation/Swidux/UndoPlugin":{"abstract":[{"text":"Snapshot-based undo\/redo plugin.","type":"text"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"UndoPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"UndoPlugin","kind":"identifier"}],"title":"UndoPlugin","kind":"symbol","url":"\/documentation\/swidux\/undoplugin","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","role":"symbol"},"doc://Swidux/documentation/Swidux/SwiduxObservable":{"url":"\/documentation\/swidux\/swiduxobservable","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxObservable","abstract":[{"type":"text","text":"Bridges a value-type state struct to an "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" class tree for"},{"type":"text","text":" "},{"type":"text","text":"per-property SwiftUI observation granularity."}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiduxObservable","kind":"identifier"}],"navigatorTitle":[{"text":"SwiduxObservable","kind":"identifier"}],"kind":"symbol","title":"SwiduxObservable","role":"symbol","type":"topic"},"doc://Swidux/documentation/Swidux/UndoRedo":{"abstract":[{"text":"Add stack-based undo\/redo to your app with ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin","isActive":true,"type":"reference"},{"text":".","type":"text"}],"title":"Undo \/ Redo","kind":"article","url":"\/documentation\/swidux\/undoredo","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/UndoR