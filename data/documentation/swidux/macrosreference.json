{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Reference for "},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" — the two macros that generate the observation bridge between value-type state and SwiftUI."}],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/SwiduxObservable","doc:\/\/Swidux\/documentation\/Swidux\/BuildingYourFirstApp","doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide"],"title":"Related Documentation"},{"anchor":"Reference","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted"],"generated":true,"title":"Reference"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","primaryContentSections":[{"content":[{"anchor":"Why-these-macros-exist","level":2,"text":"Why these macros exist","type":"heading"},{"inlineContent":[{"text":"SwiftUI’s ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" requires a class. Reducers want a value type so mutation is predictable: a struct passed ","type":"text"},{"code":"inout","type":"codeVoice"},{"text":" is the canonical state, easy to snapshot, easy to diff, easy to undo. The two requirements are in tension. Hand-written code resolves it by maintaining a struct ","type":"text"},{"inlineContent":[{"text":"and","type":"text"}],"type":"emphasis"},{"text":" a parallel ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" class tree, then pack-and-unpack between them on every dispatch. The boilerplate is mechanical and error-prone — every new property has to be wired in three places.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"@Swidux","type":"codeVoice"},{"text":" writes that boilerplate for you. Applied to a struct, it peer-emits an ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" companion class and an extension making the struct conform to ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxObservable","isActive":true,"type":"reference"},{"text":". The struct stays the source of truth; the generated class is a projection that fires per-property observation notifications when individual fields change. ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" is a one-property marker that tells ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" “this property is itself a ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" struct — wire it as a nested observer instead of a leaf.”","type":"text"}],"type":"paragraph"},{"anchor":"Swidux","level":2,"text":"`@Swidux`","type":"heading"},{"inlineContent":[{"text":"Annotate a state struct to generate its observer class and ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxObservable","isActive":true,"type":"reference"},{"text":" conformance.","type":"text"}],"type":"paragraph"},{"anchor":"Signature","level":3,"text":"Signature","type":"heading"},{"syntax":"swift","code":["@attached(peer, names: suffixed(Observer))","@attached(extension, conformances: SwiduxObservable, names: arbitrary)","public macro Swidux()"],"type":"codeListing"},{"anchor":"What-it-generates","level":3,"text":"What it generates","type":"heading"},{"inlineContent":[{"text":"For a struct named ","type":"text"},{"code":"MyState","type":"codeVoice"},{"text":", the macro emits:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"A peer class "},{"code":"MyStateObserver","type":"codeVoice"}],"type":"strong"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"@Observable"},{"text":", ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":", ","type":"text"},{"type":"codeVoice","code":"final class … : @unchecked Sendable"},{"text":". One stored property per stored property of the struct.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"An extension "},{"code":"MyState: SwiduxObservable","type":"codeVoice"}],"type":"strong"},{"text":" — providing:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"typealias Observer = MyStateObserver"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"init(observer:)"},{"type":"text","text":" — pack: read the observer tree into a struct snapshot."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static func makeObserver(from:) -> MyStateObserver"},{"type":"text","text":" — factory."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static func apply(_:to:)"},{"type":"text","text":" — unpack: assign struct fields back onto the observer. "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" only fires notifications for fields whose values actually change."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"static func applyRestore(from:to:)"},{"type":"text","text":" — used during undo\/redo. For "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":" properties it calls "},{"type":"codeVoice","code":".restore(from:)"},{"type":"text","text":" instead of plain assignment, so change tracking stays consistent."}]}]}],"type":"unorderedList"}]}],"type":"orderedList"},{"anchor":"Requirements-on-the-annotated-struct","level":3,"text":"Requirements on the annotated struct","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Must be a struct."}],"type":"strong"},{"text":" Applying ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":" to a class or enum emits a diagnostic.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Should declare "},{"code":"Equatable","type":"codeVoice"},{"type":"text","text":" and "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":"."}],"type":"strong"},{"text":" The protocol requires both. The example projects also mark the struct ","type":"text"},{"type":"codeVoice","code":"nonisolated"},{"text":" so it can cross the ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":" boundary inside ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Stored "},{"code":"var","type":"codeVoice"},{"type":"text","text":" properties only."}],"type":"strong"},{"text":" Computed properties, ","type":"text"},{"type":"codeVoice","code":"let"},{"text":" properties, and properties with explicit accessors are ignored.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Property-handling-rules","level":3,"text":"Property handling rules","type":"heading"},{"inlineContent":[{"text":"The macro classifies each stored property into one of three kinds and generates code accordingly:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Property","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Kind","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Treatment","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"var name: String","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"leaf","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Mirrored as ","type":"text"},{"code":"var name: String","type":"codeVoice"},{"text":" on the observer; assigned directly in ","type":"text"},{"code":"apply","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"var counters: EntityStore<Counter>","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"entityStore","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Mirrored as a ","type":"text"},{"code":"var","type":"codeVoice"},{"text":" on the observer; restored via ","type":"text"},{"code":"restore(from:)","type":"codeVoice"},{"text":" during undo.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"@Slice var ui: UIState","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"nested","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Stored as ","type":"text"},{"code":"let ui: UIStateObserver","type":"codeVoice"},{"text":" on the parent observer; recursive calls to the child’s ","type":"text"},{"code":"apply","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"makeObserver","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"applyRestore","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]]],"type":"table"},{"inlineContent":[{"text":"Static properties, computed properties, and ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" constants are skipped entirely.","type":"text"}],"type":"paragraph"},{"anchor":"Example-expansion","level":3,"text":"Example expansion","type":"heading"},{"inlineContent":[{"text":"Given:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var counters: EntityStore<Counter> = .init()","    @Slice var ui: UIState = .init()","}"],"type":"codeListing"},{"inlineContent":[{"text":"The macro generates:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Observable","@MainActor","final class AppStateObserver: @unchecked Sendable {","    var counters: EntityStore<Counter>","    let ui: UIStateObserver","","    init(counters: EntityStore<Counter> = .init(), ui: UIStateObserver = UIStateObserver()) {","        self.counters = counters","        self.ui = ui","    }","}","","extension AppState: SwiduxObservable {","    typealias Observer = AppStateObserver","","    @MainActor","    init(observer: AppStateObserver) {","        self.counters = observer.counters","        self.ui = UIState(observer: observer.ui)","    }","","    @MainActor","    static func makeObserver(from state: AppState) -> AppStateObserver {","        AppStateObserver(","            counters: state.counters,","            ui: UIState.makeObserver(from: state.ui)","        )","    }","","    @MainActor","    static func apply(_ snapshot: AppState, to observer: AppStateObserver) {","        observer.counters = snapshot.counters","        UIState.apply(snapshot.ui, to: observer.ui)","    }","","    @MainActor","    static func applyRestore(from snapshot: AppState, to current: inout AppState) {","        current.counters.restore(from: snapshot.counters)","        UIState.applyRestore(from: snapshot.ui, to: &current.ui)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Two things worth noticing. First, the nested ","type":"text"},{"code":"ui","type":"codeVoice"},{"text":" property is ","type":"text"},{"code":"let","type":"codeVoice"},{"text":" on the observer — the child observer instance never changes, only its properties do. That’s how SwiftUI gets per-field granularity across the boundary. Second, ","type":"text"},{"code":"applyRestore","type":"codeVoice"},{"text":" calls ","type":"text"},{"code":"EntityStore.restore(from:)","type":"codeVoice"},{"text":" on the entity-store property rather than assigning, because plain assignment would discard pending change-tracking metadata.","type":"text"}],"type":"paragraph"},{"anchor":"Slice","level":2,"text":"`@Slice`","type":"heading"},{"inlineContent":[{"text":"Marks a property whose type is itself a ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" struct.","type":"text"}],"type":"paragraph"},{"name":"Note for Redux users","style":"note","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" is not the same as Redux Toolkit’s ","type":"text"},{"code":"createSlice","type":"codeVoice"},{"text":". In Redux, a slice owns its own reducer; in Swidux, all reducers operate on the full ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" is purely a structural marker telling the parent’s ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" macro to embed the child as an observer class for per-property observation. Apologies for the term overload — we picked it for memorability and conceptual proximity, not literal equivalence.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"anchor":"Signature","level":3,"text":"Signature","type":"heading"},{"syntax":"swift","code":["@attached(peer)","public macro Slice()"],"type":"codeListing"},{"anchor":"Purpose","level":3,"text":"Purpose","type":"heading"},{"inlineContent":[{"code":"@Slice","type":"codeVoice"},{"text":" is a syntactic marker — it generates no code on its own. The parent’s ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" macro reads the marker and changes how it generates the parent observer. Without the marker, a nested struct would be treated as a leaf: copied wholesale on every dispatch, firing notifications even when only one inner field changed. With the marker, the parent observer holds the child’s observer class instance and recurses into it. SwiftUI observers attached to the inner field only fire when that inner field changes.","type":"text"}],"type":"paragraph"},{"anchor":"When-to-use","level":3,"text":"When to use","type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":" on any property whose type is also annotated ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":". Typical case: a UI-state slice nested inside ","type":"text"},{"code":"AppState","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@Swidux","nonisolated struct AppState: Equatable, Sendable {","    var counters: EntityStore<Counter> = .init()","    @Slice var ui: UIState = .init()","}","","@Swidux","nonisolated struct UIState: Equatable, Sendable {","    var selectedCounterID: UUID? = nil","}"],"type":"codeListing"},{"anchor":"When-NOT-to-use","level":3,"text":"When NOT to use","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"On ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"text":" properties — they have specialized handling already.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"On plain value types (","type":"text"},{"type":"codeVoice","code":"Int"},{"text":", ","type":"text"},{"type":"codeVoice","code":"String"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Date"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Set<UUID>"},{"text":", custom ","type":"text"},{"type":"codeVoice","code":"Equatable"},{"text":" value types). These are correctly treated as leaves.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"On any type that isn’t itself ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"text":". The parent will fail to compile because it expects the child to provide ","type":"text"},{"type":"codeVoice","code":"Observer"},{"text":", ","type":"text"},{"type":"codeVoice","code":"apply"},{"text":", ","type":"text"},{"type":"codeVoice","code":"makeObserver"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"applyRestore"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Common-errors","level":2,"text":"Common errors","type":"heading"},{"inlineContent":[{"text":"If you see ","type":"text"},{"inlineContent":[{"text":"”@Swidux can only be applied to structs”","type":"text"}],"type":"strong"},{"text":", you’ve put the macro on a class or enum. The generated extension assumes value-type semantics (snapshot, mutate, copy back); classes break that. Convert the type to a struct.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you see ","type":"text"},{"inlineContent":[{"text":"“cannot find ‘ChildStateObserver’ in scope”","type":"text"}],"type":"strong"},{"text":" in the generated code for a parent struct, the property’s type isn’t annotated ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":", but you marked it ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":". Either annotate the child type or remove the marker.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you see ","type":"text"},{"inlineContent":[{"text":"“Type ‘X’ does not conform to protocol ‘Sendable’”","type":"text"}],"type":"strong"},{"text":" or ","type":"text"},{"inlineContent":[{"text":"”… ‘Equatable’”","type":"text"}],"type":"strong"},{"text":" in the generated extension, the protocol requires both. Add the conformances on the struct.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If your view doesn’t update when you change a nested field, you probably forgot ","type":"text"},{"code":"@Slice","type":"codeVoice"},{"text":". Without it, the nested struct is treated as an opaque leaf and observers higher up the tree fire on every dispatch instead of only when their own slice changes.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you see ","type":"text"},{"inlineContent":[{"text":"“call to main actor-isolated initializer … in a synchronous nonisolated context”","type":"text"}],"type":"strong"},{"text":" pointing at a ","type":"text"},{"code":"@Swidux","type":"codeVoice"},{"text":" struct, your target is building in ","type":"text"},{"inlineContent":[{"text":"Swift 5 language mode","type":"text"}],"type":"strong"},{"text":" with ","type":"text"},{"code":"SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor","type":"codeVoice"},{"text":". In that combination the struct’s synthesized memberwise init is treated as MainActor-isolated, so the macro’s nonisolated reconstruction code can’t call it. Adding an explicit ","type":"text"},{"code":"nonisolated init","type":"codeVoice"},{"text":" does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" fix it — set ","type":"text"},{"code":"SWIFT_VERSION = 6.0","type":"codeVoice"},{"text":" (both Debug and Release). Under Swift 6 language mode, a ","type":"text"},{"code":"nonisolated struct","type":"codeVoice"},{"text":" gets a nonisolated synthesized init automatically. (See the ","type":"text"},{"code":"nonisolated","type":"codeVoice"},{"text":" restriction below.)","type":"text"}],"type":"paragraph"},{"anchor":"Restrictions","level":2,"text":"Restrictions","type":"heading"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"The struct must be "},{"code":"nonisolated","type":"codeVoice"}],"type":"strong"},{"text":" in practice. The generated extension methods are ","type":"text"},{"type":"codeVoice","code":"@MainActor"},{"text":", but reducers run with the struct passed ","type":"text"},{"type":"codeVoice","code":"inout"},{"text":" from non-isolated contexts inside ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"text":". Marking the struct ","type":"text"},{"type":"codeVoice","code":"nonisolated"},{"text":" lets it cross that boundary.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Properties must be "},{"code":"Sendable","type":"codeVoice"},{"type":"text","text":"."}],"type":"strong"},{"text":" The struct itself declares ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":", so the compiler will reject any non-","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" field.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Computed properties are not observed."}],"type":"strong"},{"text":" If you want a derived value to participate in observation, store it (and update it inside the reducer) — or compute it inline in the view.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"You can opt out."}],"type":"strong"},{"text":" For exotic shapes (collections of state slices, generic state), hand-write conformance to ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SwiduxObservable"},{"text":" instead of using the macro. The protocol requires four methods; the macro just removes the boilerplate.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swidux\/macrosreference"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"title":"Macros","roleHeading":"Article","modules":[{"name":"Swidux"}],"role":"article"},"references":{"doc://Swidux/documentation/Swidux/PluginKillswitchReference":{"abstract":[{"text":"Public API surface for the ","type":"text"},{"code":"SwiduxKillswitch","type":"codeVoice"},{"text":" library — the plugin, its state and actions, the service abstraction, and the version-comparison pri