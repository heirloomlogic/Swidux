":"SwiduxPersistence"}]},{"type":"text","text":" product turns it into a declare-and-register concern:"},{"type":"text","text":" "},{"type":"text","text":"annotate a domain entity with "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" and the macro generates its "},{"code":"@Model","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"shadow, the "},{"code":"init(from:)","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"toDomain()","type":"codeVoice"},{"type":"text","text":"\/"},{"code":"update(from:)","type":"codeVoice"},{"type":"text","text":" converters, and a"},{"type":"text","text":" "},{"code":"PersistableEntity","type":"codeVoice"},{"type":"text","text":" conformance. A generic "},{"type":"codeVoice","code":"EntityDB"},{"type":"text","text":" actor and a"},{"type":"text","text":" "},{"code":"PersistenceCoordinator","type":"codeVoice"},{"text":" build the container, synthesize the writers, and reuse","type":"text"},{"text":" ","type":"text"},{"text":"this ","type":"text"},{"type":"codeVoice","code":"PersistencePlugin"},{"text":" under the hood — exposing only a merge-based","type":"text"},{"text":" ","type":"text"},{"text":"re-hydration path so a “refresh from disk” can’t clobber unflushed writes or","type":"text"},{"text":" ","type":"text"},{"text":"live edits.","type":"text"}]},{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"SwiduxCloudKitSync"}],"type":"strong"},{"text":" layers opt-in iCloud sync on top: a runtime opt-out","type":"text"},{"text":" ","type":"text"},{"text":"toggle, launch-time entitlement\/account detection, and a merge-based","type":"text"},{"text":" ","type":"text"},{"text":"remote-change observer. Linking it is the single signal that an app needs the","type":"text"},{"text":" ","type":"text"},{"text":"iCloud\/CloudKit\/Push entitlements.","type":"text"}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlew