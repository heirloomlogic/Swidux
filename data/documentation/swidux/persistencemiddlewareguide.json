{"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true},{"type":"text","text":" is configured with one "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/StateWriter","isActive":true},{"text":" per ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","isActive":true},{"text":":","type":"text"}]},{"code":["PersistencePlugin<AppState, AppAction>(","    writers: [","        StateWriter(keyPath: \\.items) { writes, deletes in","            for item in writes { try? await db.upsert(item) }","            for id in deletes  { try? await db.delete(id: id) }","        },","    ],","    debounce: .milliseconds(250)  \/\/ Default; configurable",")"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"When using ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference","isActive":true},{"type":"text","text":", "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" is called automatically through the plugin lifecycle — no manual invocation needed. Register the "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true},{"type":"text","text":" with "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","isActive":true},{"text":" and pass it to ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","isActive":true},{"text":"’s initializer.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"await store.flush()"},{"type":"text","text":" on shutdown ("},{"type":"codeVoice","code":"scenePhase == .background"},{"type":"text","text":", "},{"code":"applicationWillTerminate","type":"codeVoice"},{"type":"text","text":") to ensure buffered writes aren’t lost. This delegates to each registered plugin’s "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" method."}]},{"anchor":"Writer-Ordering","level":2,"text":"Writer Ordering","type":"heading"},{"style":"warning","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"strong","inlineContent":[{"text":"Writers flush sequentially in registration order.","type":"text"}]},{"text":" If entity B references entity A via foreign key, A’s writer ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"must"}]},{"text":" come first. Otherwise B’s upsert looks up A’s row before it exists.","type":"text"}]}],"type":"aside"},{"inlineContent":[{"text":"Register leaf entities first, aggregates last. Include a defensive fallback in upsert methods — if a referenced entity isn’t found, create it inline rather than setting the relationship to ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Skip-the-boilerplate-SwiduxPersistence","text":"Skip the boilerplate: `SwiduxPersistence`","type":"heading","level":2},{"inlineContent":[{"text":"The hand-wired form above (a ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"type":"text","text":" per "},{"type":"codeVoice","code":"EntityStore"},{"text":", plus a SwiftData","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":" shadow and a DB actor you write yourself) is the low-level path. The","type":"text"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"}]},{"text":" product turns it into a declare-and-register concern:","type":"text"},{"text":" ","type":"text"},{"text":"annotate a domain entity with ","type":"text"},{"type":"codeVoice","code":"@Persisted"},{"text":" and the macro generates its ","type":"text"},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" "},{"type":"text","text":"shadow, the "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"toDomain()"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"update(from:)"},{"type":"text","text":" converters, and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"PersistableEntity"},{"type":"text","text":" conformance. A generic "},{"type":"codeVoice","code":"EntityDB"},{"type":"text","text":" actor and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"PersistenceCoordinator"},{"type":"text","text":" build the container, synthesize the writers, and reuse"},{"type":"text","text":" "},{"type":"text","text":"this "},{"type":"codeVoice","code":"PersistencePlugin"},{"type":"text","text":" under the hood — exposing only a merge-based"},{"type":"text","text":" "},{"type":"text","text":"re-hydration path so a “refresh from disk” can’t clobber unflushed writes or"},{"type":"text","text":" "},{"type":"text","text":"live edits."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"SwiduxCloudKitSync"}]},{"type":"text","text":" layers opt-in iCloud sync on top: a runtime opt-out"},{"type":"text","text":" "},{"type":"text","text":"toggle, launch-time entitlement\/account detection, and a merge-based"},{"type":"text","text":" "},{"type":"text","text":"remote-change observer. Linking it is the single signal that an app needs the"},{"type":"text","text":" "},{"type":"text","text":"iCloud\/CloudKit\/Push entitlements."}],"type":"paragraph"}]}],"metadata":{"modules":[{"name":"Swidux"}],"role":"article","roleHeading":"Article","title":"Persistence Middleware"},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/S