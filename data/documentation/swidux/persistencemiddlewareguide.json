{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/persistencemiddlewareguide"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginKillswitchReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginParentalGateReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","doc:\/\/Swidux\/documentation\/Swidux\/PluginFeatureFlagsReference","doc:\/\/Swidux\/documentation\/Swidux\/EntityStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","doc:\/\/Swidux\/documentation\/Swidux\/UndoRedo","doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","doc:\/\/Swidux\/documentation\/Swidux\/Troubleshooting"],"title":"Reference","generated":true,"anchor":"Reference"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide","interfaceLanguage":"swift"},"sections":[],"kind":"article","metadata":{"role":"article","modules":[{"name":"Swidux"}],"title":"Persistence Middleware","roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"type":"text","text":" is configured with one "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/StateWriter"},{"type":"text","text":" per "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["PersistencePlugin<AppState, AppAction>(","    writers: [","        StateWriter(keyPath: \\.items) { writes, deletes in","            for item in writes { try? await db.upsert(item) }","            for id in deletes  { try? await db.delete(id: id) }","        },","    ],","    debounce: .milliseconds(250)  \/\/ Default; configurable",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"When using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"type":"text","text":", "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" is called automatically through the plugin lifecycle — no manual invocation needed. Register the "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"type":"text","text":" with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"type":"text","text":" and pass it to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"type":"text","text":"’s initializer."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"await store.flush()"},{"type":"text","text":" on shutdown ("},{"type":"codeVoice","code":"scenePhase == .background"},{"type":"text","text":", "},{"type":"codeVoice","code":"applicationWillTerminate"},{"type":"text","text":") to ensure buffered writes aren’t lost. This delegates to each registered plugin’s "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" method."}],"type":"paragraph"},{"level":2,"text":"Writer Ordering","anchor":"Writer-Ordering","type":"heading"},{"name":"Warning","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Writers flush sequentially in registration order."}]},{"text":" If entity B references entity A via foreign key, A’s writer ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"must"}]},{"text":" come first. Otherwise B’s upsert looks up A’s row before it exists.","type":"text"}]}],"style":"warning","type":"aside"},{"inlineContent":[{"type":"text","text":"Register leaf entities first, aggregates last. Include a defensive fallback in upsert methods — if a referenced entity isn’t found, create it inline rather than setting the relationship to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Skip the boilerplate: `SwiduxPersistence`","anchor":"Skip-the-boilerplate-SwiduxPersistence","type":"heading"},{"inlineContent":[{"type":"text","text":"The hand-wired form above (a "},{"type":"codeVoice","code":"StateWriter"},{"type":"text","text":" per "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":", plus a SwiftData"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" shadow and a DB actor you write yourself) is the low-level path. The"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"}]},{"type":"text","text":" product turns it into a declare-and-register concern:"},{"type":"text","text":" "},{"type":"text","text":"annotate a domain entity with "},{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" and the macro generates its "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" "},{"type":"text","text":"shadow, the "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"toDomain()"},{"type":"text","text":"\/"},{"type":"codeVoice","code":"update(from:)"},{"type":"text","text":" converters, and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"PersistableEntity"},{"type":"text","text":" conformance. A generic "},{"type":"codeVoice","code":"EntityDB"},{"type":"text","text":" actor and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"PersistenceCoordinator"},{"type":"text","text":" build the container, synthesize the writers, and reuse"},{"type":"text","text":" "},{"type":"text","text":"this "},{"type":"codeVoice","code":"PersistencePlugin"},{"type":"text","text":" under the hood — exposing only a merge-based"},{"type":"text","text":" "},{"type":"text","text":"re-hydration path so a “refresh from disk” can’t clobber unflushed writes or"},{"type":"text","text":" "},{"type":"text","text":"live edits."}],"type":"paragraph"},{"inlineContent":[{"type":"strong","inlineContent":[{"code":"SwiduxCloudKitSync","type":"codeVoice"}]},{"type":"text","text":" layers opt-in iCloud sync on top: a runtime opt-out"},{"type":"text","text":" "},{"type":"text","text":"toggle, launch-time entitlement\/account detection, and a merge-based"},{"type":"text","text":" "},{"type":"text","text":"remote-change observer. Linking it is the single signal that an app needs the"},{"type":"text","text":" "},{"type":"text","text":"iCloud\/CloudKit\/Push entitlements."}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"references":{"doc://Swidux/documentation/Swidux/KeyValueStoreGuide":{"title":"KeyValueStore","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStoreGuide","role":"collectionGroup","kind":"article","abstract":[{"text":"Persist scalar preferences like theme, sort order, or last-seen version — testably, with type-safe keys.","type":"text"}],"url":"\/documentation\/swidux\/keyvaluestoreguide"},"doc://Swidux/documentation/Swidux/PluginAnalyticsReference":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","url":"\/documentation\/swidux\/pluginanalyticsreference","type":"topic","title":"SwiduxAnalytics Reference","role":"article","kind":"article","abstract":[{"text":"API reference for the ","type":"text"},{"type":"codeVoice","code":"SwiduxAnalytics"},{"text":" library — provider-agnostic analytics with declarative event mapping, auto-identify, and explicit dispatch for the cases the mapper can’t 