{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"type":"text","text":" is configured with one "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/StateWriter","type":"reference","isActive":true},{"type":"text","text":" per "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["PersistencePlugin<AppState, AppAction>(","    writers: [","        StateWriter(keyPath: \\.items) { writes, deletes in","            for item in writes { try? await db.upsert(item) }","            for id in deletes  { try? await db.delete(id: id) }","        },","    ],","    debounce: .milliseconds(250)  \/\/ Default; configurable",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"When using "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","isActive":true},{"type":"text","text":", "},{"type":"codeVoice","code":"afterReduce"},{"type":"text","text":" is called automatically through the plugin lifecycle — no manual invocation needed. Register the "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference","isActive":true},{"type":"text","text":" with "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost","type":"reference","isActive":true},{"type":"text","text":" and pass it to "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"reference","isActive":true},{"type":"text","text":"’s initializer."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"await store.flush()"},{"type":"text","text":" on shutdown ("},{"type":"codeVoice","code":"scenePhase == .background"},{"type":"text","text":", "},{"type":"codeVoice","code":"applicationWillTerminate"},{"type":"text","text":") to ensure buffered writes aren’t lost. This delegates to each registered plugin’s "},{"type":"codeVoice","code":"flush()"},{"type":"text","text":" method."}],"type":"paragraph"},{"anchor":"Writer-Ordering","level":2,"text":"Writer Ordering","type":"heading"},{"name":"Warning","style":"warning","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"inlineContent":[{"text":"Writers flush sequentially in registration order.","type":"text"}],"type":"strong"},{"type":"text","text":" If entity B references entity A via foreign key, A’s writer "},{"inlineContent":[{"text":"must","type":"text"}],"type":"strong"},{"type":"text","text":" come first. Otherwise B’s upsert looks up A’s row before it exists."}]}],"type":"aside"},{"inlineContent":[{"text":"Register leaf entities first, aggregates last. Include a defensive fallback in upsert methods — if a referenced entity isn’t found, create it inline rather than setting the relationship to ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Skip-the-boilerplate-SwiduxPersistence","text":"Skip the boilerplate: `SwiduxPersistence`"},{"inlineContent":[{"text":"The hand-wired form above (a ","type":"text"},{"code":"StateWriter","type":"codeVoice"},{"text":" per ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":", plus a SwiftData","type":"text"},{"text":" ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" shadow and a DB actor you write yourself) is the low-level path. The","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"codeVoice","code":"SwiduxPersistence"}],"type":"strong"},{"text":" product turns it into a declare-and-register concern:","type":"text"},{"text":" ","type":"text"},{"text":"annotate a domain entity with ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" and the macro generates its ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" ","type":"text"},{"text":"shadow, the ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"toDomain()","type":"codeVoice"},{"text":"\/","type":"text"},{"code":"update(from:)","type":"codeVoice"},{"text":" converters, and a","type":"text"},{"text":" ","type":"text"},{"code":"PersistableEntity","type":"codeVoice"},{"text":" conformance. A generic ","type":"text"},{"code":"EntityDB","type":"codeVoice"},{"text":" actor and a","type":"text"},{"text":" ","type":"text"},{"code":"PersistenceCoordinator","type":"codeVoice"},{"text":" build the container, synthesize the writers, and reuse","type":"text"},{"text":" ","type":"text"},{"text":"this ","type":"text"},{"code":"PersistencePlugin","type":"codeVoice"},{"text":" under the hood — exposing only a merge-based","type":"text"},{"text":" ","type":"text"},{"text":"re-hydration path so a “refresh from disk” can’t clobber unflushed writes or","type":"text"},{"text":" ","type":"text"},{"text":"live edits.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"SwiduxCloudKitSync"}],"type":"strong"},{"text":" layers opt-in iCloud sync on top: a runtime opt-out","type":"text"},{"text":" ","type":"text"},{"text":"toggle, launch-time entitlement\/account detection, and a merge-based","type":"text"},{"text":" ","type":"text"},{"text":"remote-change observer. Linking it is the single signal that an app needs the","type":"text"},{"text":" ","type":"text"},{"text":"iCloud\/CloudKit\/Push entitlements.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"role":"article","modules":[{"name":"Swidux"}],"title":"Persistence Middleware","roleHeading":"Article"},"abstract":[{"type":"text","text":"Configure automatic persistence that drains entity changes and batches database writes