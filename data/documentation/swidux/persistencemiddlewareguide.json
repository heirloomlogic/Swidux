{"abstract":[{"text":"Configure automatic persistence that drains entity changes and batches database writes.","type":"text"}],"sections":[],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","type":"reference"},{"text":" is configured with one ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/StateWriter","type":"reference"},{"text":" per ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","type":"reference"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["PersistencePlugin<AppState, AppAction>(","    writers: [","        StateWriter(keyPath: \\.items) { writes, deletes in","            for item in writes { try await db.upsert(item) }","            for id in deletes  { try await db.delete(id: id) }","        },","    ],","    debounce: .milliseconds(250),  \/\/ Default; configurable","    retry: .default                \/\/ Default; configurable",")"],"type":"codeListing"},{"content":[{"inlineContent":[{"type":"text","text":"Let the persist closure "},{"inlineContent":[{"text":"throw","type":"text"}],"type":"strong"},{"type":"text","text":". The flush clears its buffers before the save runs, so an error you swallow with "},{"code":"try?","type":"codeVoice"},{"type":"text","text":" takes the write with it — the plugin never learns to put the batch back, and the value reaches storage only if the user happens to touch the same entity again. Throwing is what turns that into a retry. See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"style":"important","name":"Important","type":"aside"},{"inlineContent":[{"text":"When using ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"text":", ","type":"text"},{"code":"afterReduce","type":"codeVoice"},{"text":" is called automatically through the plugin lifecycle — no manual invocation needed. Register the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"text":" with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"},{"text":" and pass it to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"text":"’s initializer.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Call ","type":"text"},{"code":"await store.flush()","type":"codeVoice"},{"text":" on shutdown (","type":"text"},{"code":"scenePhase == .background","type":"codeVoice"},{"text":", ","type":"text"},{"code":"applicationWillTerminate","type":"codeVoice"},{"text":") to ensure buffered writes aren’t lost. This delegates to each registered plugin’s ","type":"text"},{"code":"flush()","type":"codeVoice"},{"text":" method.","type":"text"}],"type":"paragraph"},{"anchor":"Writer-Ordering","text":"Writer Ordering","level":2,"type":"heading"},{"content":[{"inlineContent":[{"type":"text","text":""},{"inlineContent":[{"text":"Writers flush sequentially in registration order.","type":"text"}],"type":"strong"},{"type":"text","text":" If entity B references entity A via foreign key, A’s writer "},{"inlineContent":[{"text":"must","type":"text"}],"type":"strong"},{"type":"text","text":" come first. Otherwise B’s upsert looks up A’s row before it exists."}],"type":"paragraph"}],"style":"warning","name":"Warning","type":"aside"},{"inlineContent":[{"text":"Register leaf entities first, aggregates last. Include a defensive fallback in upsert methods — if a referenced entity isn’t found, create it inline rather than setting the relationship to ","type":"text"},{"co