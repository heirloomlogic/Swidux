entSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RetryPolicy","kind":"identifier"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"]},{"content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrying matters because the buffers are cleared at flush time: without it a"},{"type":"text","text":" "},{"type":"text","text":"failed save only ever reaches disk if the user happens to touch the same"},{"type":"text","text":" "},{"type":"text","text":"entity again, which is silent data loss. Retrying "},{"type":"emphasis","inlineContent":[{"text":"forever","type":"text"}]},{"type":"text","text":" matters just as"},{"type":"text","text":" "},{"type":"text","text":"much in the other direction — a write that can never succeed (disk full, a"},{"type":"text","text":" "},{"type":"text","text":"model the container can’t encode, a schema mismatch) must not keep the stack"},{"type":"text","text":" "},{"type":"text","text":"busy indefinitely. So attempts are bounded, and running out is an event the"},{"type":"text","text":" "},{"type":"text","text":"app can see rather than a silence."}]}],"kind":"content"}],"references":{"doc://Swidux/documentation/Swidux/RetryPolicy":{"type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"RetryPolicy","kind":"identifier"}],"kind":"symbol","title":"RetryPolicy","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy","role":"symbol","url":"\/documentation\/swidux\/retrypolicy","abstract":[{"type":"text","text":"How "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true},{"text":" retries a flush whose save failed.","type":"text"}],"navigatorTitle":[{"text":"RetryPolicy","kind":"identif