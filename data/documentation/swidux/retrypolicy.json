{"metadata":{"roleHeading":"Structure","title":"RetryPolicy","role":"symbol","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"RetryPolicy"}],"externalID":"s:6Swidux11RetryPolicyV","modules":[{"name":"Swidux"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RetryPolicy"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/retrypolicy"]}],"abstract":[{"type":"text","text":"How "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"type":"text","text":" retries a flush whose save failed."}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/init(maxAttempts:baseDelay:maxDelay:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/baseDelay","doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/maxAttempts","doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/maxDelay"],"generated":true},{"anchor":"Type-Properties","title":"Type Properties","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/default","doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/never"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/Equatable-Implementations"],"generated":true}],"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/Swidux\/SQ","doc:\/\/Swidux\/s8SendableP","doc:\/\/Swidux\/s16SendableMetatypeP"],"type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RetryPolicy"}]}],"kind":"declarations"},{"kind":"mentions","mentions":["doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"]},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrying matters because the buffers are cleared at flush time: without it a"},{"type":"text","text":" "},{"type":"text","text":"failed save only ever reaches disk if the user happens to touch the same"},{"type":"text","text":" "},{"type":"text","text":"entity again, which is silent data loss. Retrying "},{"type":"emphasis","inlineContent":[{"type":"text","text":"forever"}]},{"type":"text","text":" matters just as"},{"type":"text","text":" "},{"type":"text","text":"much in the other direction — a write that can never succeed (disk full, a"},{"type":"text","text":" "},{"type":"text","text":"model the container can’t encode, a schema mismatch) must not keep the stack"},{"type":"text","text":" "},{"type":"text","text":"busy indefinitely. So attempts are bounded, and running out is an event the"},{"type":"text","text":" "},{"type":"text","text":"app can see rather than a silence."}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy","interfaceLanguage":"swift"},"references":{"doc://Swidux/documentation/Swidux/RetryPolicy":{"url":"\/documentation\/swidux\/retrypolicy","title":"RetryPolicy","abstract":[{"type":"text","text":"How "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"type":"text","text":" retries a flush whose save failed."}],"kind":"symbol","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RetryPolicy"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RetryPolicy"}]},"doc://Swidux/documentation/Swidux/RetryPolicy/maxDelay":{"url":"\/documentation\/swidux\/retrypolicy\/maxdelay","title":"maxDelay","abstract":[{"type":"text","text":"The ceiling on that doubling."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/maxDelay","type":"topic","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"maxDelay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"}]},"doc://Swidux/documentation/Swidux/RetryPolicy/Equatable-Implementations":{"url":"\/documentation\/swidux\/retrypolicy\/equatable-implementations","title":"Equatable Implementations","abstract":[],"kind":"article","role":"collectionGroup","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/Equatable-Implementations","type":"topic"},"doc://Swidux/documentation/Swidux/RetryPolicy/default":{"url":"\/documentation\/swidux\/retrypolicy\/default","title":"default","abstract":[{"type":"text","text":"Five attempts over roughly seven seconds, then give up: long enough to"},{"type":"text","text":" "},{"type":"text","text":"ride out a transient lock or a busy disk, short enough that a genuinely"},{"type":"text","text":" "},{"type":"text","text":"doomed write is reported while the user is still in the session that"},{"type":"text","text":" "},{"type":"text","text":"made it."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/default","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"`default`"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"RetryPolicy","preciseIdentifier":"s:6Swidux11RetryPolicyV"}]},"doc://Swidux/documentation/Swidux/RetryPolicy/baseDelay":{"url":"\/documentation\/swidux\/retrypolicy\/basedelay","title":"baseDelay",