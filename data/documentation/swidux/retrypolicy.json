{"sections":[],"abstract":[{"type":"text","text":"How "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","isActive":true},{"text":" retries a flush whose save failed.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"kind":"symbol","metadata":{"externalID":"s:6Swidux11RetryPolicyV","roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"text":"RetryPolicy","kind":"identifier"}],"symbolKind":"struct","role":"symbol","modules":[{"name":"Swidux"}],"title":"RetryPolicy","navigatorTitle":[{"text":"RetryPolicy","kind":"identifier"}]},"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/init(maxAttempts:baseDelay:maxDelay:)"]},{"generated":true,"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/baseDelay","doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/maxAttempts","doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/maxDelay"]},{"generated":true,"title":"Type Properties","anchor":"Type-Properties","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/default","doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/never"]},{"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/Equatable-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations","generated":true}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy","interfaceLanguage":"swift"},"relationshipsSections":[{"title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/Swidux\/SQ","doc:\/\/Swidux\/s8SendableP","doc:\/\/Swidux\/s16SendableMetatypeP"],"kind":"relationships"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"kind":"text","text":" "},{"text":"RetryPolicy","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"mentions":["doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddlewareGuide"],"kind":"mentions"},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrying matters because the buffers are cleared at flush time: without it a"},{"type":"text","text":" "},{"type":"text","text":"failed save only ever reaches disk if the user happens to touch the same"},{"type":"text","text":" "},{"type":"text","text":"entity again, which is silent data loss. Retrying "},{"type":"emphasis","inlineContent":[{"text":"forever","type":"text"}]},{"type":"text","text":" matters just as"},{"type":"text","text":" "},{"type":"text","text":"much in the other direction — a write that can never succeed (disk full, a"},{"type":"text","text":" "},{"type":"text","text":"model the container can’t encode, a schema mismatch) must not keep the stack"},{"type":"text","text":" "},{"type":"text","text":"busy indefinitely. So attempts are bounded, and running out is an event the"},{"type":"text","text":" "},{"type":"text","text":"app can see rather than a silence."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux\/retrypolicy"]}],"references":{"doc://Swidux/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/Swidux\/SQ"},"doc://Swidux/documentation/Swidux/PersistencePlugin":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistencePlugin","kind":"identifier"}],"url":"\/documentation\/swidux\/persistenceplugin","abstract":[{"text":"Coalescing persistence plugin.","type":"text"}],"role":"symbol","title":"PersistencePlugin","type":"topic","kind":"symbol","navigatorTitle":[{"text":"PersistencePlugin","kind":"identifier"}],"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"}