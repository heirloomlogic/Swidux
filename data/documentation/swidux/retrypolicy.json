{"hierarchy":{"paths":[["doc:\/\/Swidux\/documentation\/Swidux"]]},"abstract":[{"type":"text","text":"How "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin"},{"type":"text","text":" retries a flush whose save failed."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy"},"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RetryPolicy"}],"modules":[{"name":"Swidux"}],"roleHeading":"Structure","externalID":"s:6Swidux11RetryPolicyV","role":"symbol","title":"RetryPolicy","symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"RetryPolicy"}]},"kind":"symbol","topicSections":[{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/init(maxAttempts:baseDelay:maxDelay:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/baseDelay","doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/maxAttempts","doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/maxDelay"],"anchor":"Instance-Properties","title":"Instance Properties"},{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/default","doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/never"],"anchor":"Type-Properties","title":"Type Properties"},{"generated":true,"identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/Equatable-Implementations"],"anchor":"Default-Implementations","title":"Default Implementations"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/Swidux\/SQ","doc:\/\/Swidux\/s8SendableP","doc:\/\/Swidux\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens