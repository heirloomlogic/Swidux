/documentation\/Swidux\/RetryPolicy\/default","url":"\/documentation\/swidux\/retrypolicy\/default","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"`default`","kind":"identifier"},{"text":": ","kind":"text"},{"text":"RetryPolicy","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux11RetryPolicyV"}],"abstract":[{"text":"Five attempts over roughly seven seconds, then give up: long enough to","type":"text"},{"text":" ","type":"text"},{"text":"ride out a transient lock or a busy disk, short enough that a genuinely","type":"text"},{"text":" ","type":"text"},{"text":"doomed write is reported while the user is still in the session that","type":"text"},{"text":" ","type":"text"},{"text":"made it.","type":"text"}],"title":"default","kind":"symbol","role":"symbol"},"doc://Swidux/documentation/Swidux":{"kind":"symbol","type":"topic","url":"\/documentation\/swidux","abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"title":"Swidux","role":"collection","identifier":"doc:\/\/Swidux\/documentation\/Swidux"},"doc://Swidux/s16SendableMetatypeP":{"identifier":"doc:\/\/Swidux\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://Swidux/documentation/Swidux/RetryPolicy/init(maxAttempts:baseDelay:maxDelay:)":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy\/init(maxAttempts:baseDelay:maxDelay:)","type":"topic","url":"\/documentation\/swidux\/retrypolicy\/init(maxattempts:basedelay:maxdelay:)","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"maxAttempts"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"baseDelay"},{"kind":"text"