","text":"KillswitchService"}],"title":"KillswitchService","url":"\/documentation\/swiduxkillswitch\/killswitchservice","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"KillswitchService"}],"abstract":[{"type":"text","text":"A provider-agnostic service for fetching and caching the remote"},{"type":"text","text":" "},{"type":"text","text":"killswitch configuration."}],"type":"topic","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService","role":"symbol"},"doc://SwiduxKillswitch/documentation/SwiduxKillswitch":{"role":"collection","kind":"symbol","type":"topic","title":"SwiduxKillswitch","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch","abstract":[],"url":"\/documentation\/swiduxkillswitch"},"doc://SwiduxKillswitch/documentation/SwiduxKillswitch/KillswitchService/loadCached":{"role":"symbol","url":"\/documentation\/swiduxkillswitch\/killswitchservice\/loadcached","abstract":[{"type":"text","text":"Loads the last persisted config from local cache, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"title":"loadCached","type":"topic","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService\/loadCached","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"loadCached","kind":"identifier"},{"kind":"text","text":": () -> "},{"text":"KillswitchConfig","kind":"typeIdentifier","preciseIdentifier":"s:16SwiduxKillswitch0B6ConfigV"},{"kind":"text","text":"?"}]},"doc://SwiduxKillswitch/documentation/SwiduxKillswitch/KillswitchService/live(endpoint:fetchTimeout:cacheLifetime:session:)":{"type":"topic","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService\/live(endpoint:fetchTimeout:cacheLifetime:session:)","title":"live(endpoint:fetchTimeout:cacheLifetime:session:)","kind":"symbol","role":"symbol","url":"\/documentation\/swiduxkillswitch\/killswitchservice\/live(endpoint:fetchtim