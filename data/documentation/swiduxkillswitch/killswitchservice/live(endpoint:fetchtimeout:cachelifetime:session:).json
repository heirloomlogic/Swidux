{"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch","doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService"]]},"metadata":{"modules":[{"name":"SwiduxKillswitch"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"live","kind":"identifier"},{"text":"(","kind":"text"},{"text":"endpoint","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":", ","kind":"text"},{"text":"fetchTimeout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":", ","kind":"text"},{"text":"cacheLifetime","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":", ","kind":"text"},{"text":"session","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URLSession","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSURLSession"},{"text":") -> ","kind":"text"},{"text":"KillswitchService","kind":"typeIdentifier","preciseIdentifier":"s:16SwiduxKillswitch0B7ServiceV"}],"title":"live(endpoint:fetchTimeout:cacheLifetime:session:)","roleHeading":"Type Method","externalID":"s:16SwiduxKillswitch0B7ServiceV4live8endpoint12fetchTimeout13cacheLifetime7sessionAC10Foundation3URLV_S2dSo12NSURLSessionCtFZ","role":"symbol","symbolKind":"method"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"live","kind":"identifier"},{"text":"(","kind":"text"},{"text":"endpoint","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":", ","kind":"text"},{"text":"fetchTimeout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":" = 10, ","kind":"text"},{"text":"cacheLifetime","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":" = 3600, ","kind":"text"},{"text":"session","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URLSession","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSURLSession"},{"text":" = .shared) -> ","kind":"text"},{"text":"KillswitchService","kind":"typeIdentifier","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService","preciseIdentifier":"s:16SwiduxKillswitch0B7ServiceV"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The endpoint must be HTTPS (","type":"text"},{"code":"http","type":"codeVoice"},{"text":" is allowed only for ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":"127.0.0.1","type":"codeVoice"},{"text":" development servers) — the killswitch is a remote control","type":"text"},{"text":" ","type":"text"},{"text":"channel and must not be tamperable in transit, regardless of the host","type":"text"},{"text":" ","type":"text"},{"text":"app’s ATS configuration. The transfer is aborted the moment the response","type":"text"},{"text":" ","type":"text"},{"text":"body exceeds 1 MB (it is streamed, never fully buffered past the cap),","type":"text"},{"text":" ","type":"text"},{"text":"and non-2xx statuses are treated as fetch failures (the plugin then","type":"text"},{"text":" ","type":"text"},{"text":"falls back to its cache).","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"fetchTimeout","type":"codeVoice"},{"text":" bounds the whole fetch, headers and body together — not","type":"text"},{"text":" ","type":"text"},{"text":"just the gap between packets. A response trickled in a byte at a time","type":"text"},{"text":" ","type":"text"},{"text":"still fails at ","type":"text"},{"code":"fetchTimeout","type":"codeVoice"},{"text":", so the plugin reaches its cached verdict","type":"text"},{"text":" ","type":"text"},{"text":"on schedule instead of waiting on a transfer that never ends. A","type":"text"},{"text":" ","type":"text"},{"code":"fetchTimeout","type":"codeVoice"},{"text":" that isn’t finite and positive (","type":"text"},{"code":".infinity","type":"codeVoice"},{"text":", say) sets","type":"text"},{"text":" ","type":"text"},{"text":"no deadline, leaving only the session’s own timeouts.","type":"text"}]},{"anchor":"The-cache-is-the-other-input-path","level":2,"type":"heading","text":"The cache is the other input path"},{"type":"paragraph","inlineContent":[{"text":"A cached config produces a verdict with exactly the authority a fetched","type":"text"},{"text":" ","type":"text"},{"text":"one has, and it is reached without any successful fetch ever having","type":"text"},{"text":" ","type":"text"},{"text":"happened — launch offline and the failure path loads it directly. So it","type":"text"},{"text":" ","type":"text"},{"text":"is scoped and checked rather than trusted:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"It lives in a ","type":"text"},{"inlineContent":[{"text":"bundle-scoped subdirectory","type":"text"}],"type":"strong"},{"text":" of the caches directory.","type":"text"},{"text":" ","type":"text"},{"text":"On a non-sandboxed macOS build ","type":"text"},{"code":".cachesDirectory","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"~\/Library\/Caches","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"shared by the whole user account, so a bare filename would have every","type":"text"},{"text":" ","type":"text"},{"text":"Swidux app reading every other’s blocked verdict.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"It records the ","type":"text"},{"inlineContent":[{"text":"endpoint it came from","type":"text"}],"type":"strong"},{"text":", and ","type":"text"},{"identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService\/loadCached","isActive":true,"type":"reference"},{"text":" treats a","type":"text"},{"text":" ","type":"text"},{"text":"payload written for a different one as absent. Repointing the endpoint","type":"text"},{"text":" ","type":"text"},{"text":"therefore invalidates the cache rather than inheriting it.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Neither of those makes the file authenticated. A process running as the","type":"text"},{"text":" ","type":"text"},{"text":"user can still write it on a platform where the caches directory isn’t","type":"text"},{"text":" ","type":"text"},{"text":"sandboxed — see ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService\/live(endpoint:fetchTimeout:cacheLifetime:session:)"},"kind":"symbol","variants":[{"paths":["\/documentation\/swiduxkillswitch\/killswitchservice\/live(endpoint:fetchtimeout:cachelifetime:session:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Production factory that fetches from a URL endpoint and caches to"},{"type":"text","text":" "},{"type":"text","text":"the system Caches directory."}],"references":{"doc://SwiduxKillswitch/documentation/SwiduxKillswitch/KillswitchService/loadCached":{"url":"\/documentation\/swiduxkillswitch\/killswitchservice\/loadcached","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService\/loadCached","type":"topic","abstract":[{"type":"text","text":"Loads the last persisted config from local cache, or "},{"code":"nil","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"loadCached"},{"kind":"text","text":": () -> "},{"preciseIdentifier":"s:16SwiduxKillswitch0B6ConfigV","kind":"typeIdentifier","text":"KillswitchConfig"},{"kind":"text","text":"?"}],"role":"symbol","title":"loadCached"},"doc://SwiduxKillswitch/documentation/SwiduxKillswitch":{"url":"\/documentation\/swiduxkillswitch","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch","type":"topic","abstract":[],"kind":"symbol","role":"collection","title":"SwiduxKillswitch"},"doc://SwiduxKillswitch/documentation/SwiduxKillswitch/KillswitchService":{"url":"\/documentation\/swiduxkillswitch\/killswitchservice","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService","type":"topic","navigatorTitle":[{"kind":"identifier","text":"KillswitchService"}],"abstract":[{"type":"text","text":"A provider-agnostic service for fetching and caching the remote"},{"type":"text","text":" "},{"type":"text","text":"killswitch configuration."}],"kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KillswitchService"}],"role":"symbol","title":"KillswitchService"},"doc://Swidux/documentation/Swidux/SecurityPosture":{"url":"\/documentation\/swidux\/securityposture","title":"Security Posture","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","kind":"article","type":"topic","role":"collectionGroup","abstract":[{"type":"text","text":"What Swidux’s soft controls actually guarantee, and what to do when you need a hard one."}]},"doc://SwiduxKillswitch/documentation/SwiduxKillswitch/KillswitchService/live