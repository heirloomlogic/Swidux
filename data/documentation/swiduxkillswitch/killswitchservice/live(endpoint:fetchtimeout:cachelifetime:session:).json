aryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"live"},{"kind":"text","text":"("},{"kind":"externalParam","text":"endpoint"},{"kind":"text","text":": "},{"preciseIdentifier":"s:10Foundation3URLV","kind":"typeIdentifier","text":"URL"},{"kind":"text","text":", "},{"kind":"externalParam","text":"fetchTimeout"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@T@NSTimeInterval","kind":"typeIdentifier","text":"TimeInterval"},{"kind":"text","text":" = 10, "},{"kind":"externalParam","text":"cacheLifetime"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@T@NSTimeInterval","kind":"typeIdentifier","text":"TimeInterval"},{"kind":"text","text":" = 3600, "},{"kind":"externalParam","text":"session"},{"kind":"text","text":": "},{"preciseIdentifier":"c:objc(cs)NSURLSession","kind":"typeIdentifier","text":"URLSession"},{"kind":"text","text":" = .shared) -> "},{"text":"KillswitchService","preciseIdentifier":"s:16SwiduxKillswitch0B7ServiceV","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService","kind":"typeIdentifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The endpoint must be HTTPS (","type":"text"},{"code":"http","type":"codeVoice"},{"text":" is allowed only for ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":"127.0.0.1","type":"codeVoice"},{"text":" development servers) — the killswitch is a remote control","type":"text"},{"text":" ","type":"text"},{"text":"channel and must not be tamperable in transit, regardless of the host","type":"text"},{"text":" ","type":"text"},{"text":"app’s ATS configuration. The transfer is aborted the moment the response","type":"text"},{"text":" ","type":"text"},{"text":"body exceeds 1 MB (it is streamed, never fully buffered past the cap),","type":"text"},{"text":" ","type":"text"},{"text":"and non-2xx statuses are treated as fetch failures (the plugin then","type":"text"},{"text":" ","type":"text"},{"text":"falls back to its cache).","type":"text"}]},{"type":"heading","level":2,"text":"The cache is the other input path","anchor":"The-cache-is-the-other-input-path"},{"type":"paragraph","inlineContent":[{"text":"A cached config produces a verdict with exactly the authority a fetched","type":"text"},{"type":"text","text":" "},{"type":"text","text":"one has, and it is reached without any successful fetch ever having"},{"type":"text","text":" "},{"text":"happened — launch offline and the failure path loads it directly. So it","type":"text"},{"type":"text","text":" "},{"text":"is scoped and checked rather than trusted:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"It lives in a ","type":"text"},{"inlineContent":[{"type":"text","text":"bundle-scoped subdirectory"}],"type":"strong"},{"text":" of the caches directory.","type":"text"},{"text":" ","type":"text"},{"text":"On a non-sandboxed macOS build ","type":"text"},{"code":".cachesDirectory","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"~\/Library\/Caches","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"shared by the whole user account, so a bare filename would have every","type":"text"},{"text":" ","type":"text"},{"text":"Swidux app reading every other’s blocked verdict.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"It records the ","type":"text"},{"inlineContent":[{"type":"text","text":"endpoint it came from"}],"type":"strong"},{"text":", and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService\/loadCached"},{"text":" treats a","type":"text"},{"text":" ","type":"text"},{"text":"payload written for a different one as absent. Repointing the endpoint","type":"text"},{"text":" ","type":"text"},{"text":"therefore invalidates the cache rather than inheriting it.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Neither of those makes the file authenticated. A process running as the"},{"type":"text","text":" "},{"type":"text","text":"user can still write it on a platform where the caches directory isn’t"},{"type":"text","text":" "},{"type":"text","text":"sandboxed — see "},{"type":"text","text":"doc:SecurityPosture"},{"type":"text","text":"."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiduxkillswitch\/killswitchservice\/live(endpoint:fetchtimeout:cachelifetime:session:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiduxKillswitch/documentation/SwiduxKillswitch":{"type":"topic","abstract":[],"kind":"symbol","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch","title":"SwiduxKillswitch","role":"collection","url":"\/documentation\/swiduxkillswitch"},"doc://SwiduxKillswitch/documentation/SwiduxKillswitch/KillswitchService":{"kind":"symbol","url":"\/documentation\/swiduxkillswitch\/killswitchservice","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"KillswitchService"}],"title":"KillswitchService","type":"topic","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KillswitchService"}],"abstract":[{"type":"text","text":"A provider-agnostic service for fetching and caching the remote"},{"type":"text","text":" "},{"type":"text","text":"killswitch configuration."}]},"doc://SwiduxKillswitch/documentation/SwiduxKillswitch/KillswitchService/live(endpoint:fetchTimeout:cacheLifetime:session:)":{"kind":"symbol","url":"\/documentation\/swiduxkillswitch