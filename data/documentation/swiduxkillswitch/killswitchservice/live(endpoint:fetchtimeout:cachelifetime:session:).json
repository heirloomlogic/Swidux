{"variants":[{"paths":["\/documentation\/swiduxkillswitch\/killswitchservice\/live(endpoint:fetchtimeout:cachelifetime:session:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Production factory that fetches from a URL endpoint and caches to","type":"text"},{"text":" ","type":"text"},{"text":"the system Caches directory.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService\/live(endpoint:fetchTimeout:cacheLifetime:session:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"live","kind":"identifier"},{"text":"(","kind":"text"},{"text":"endpoint","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":", ","kind":"text"},{"text":"fetchTimeout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":" = 10, ","kind":"text"},{"text":"cacheLifetime","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":" = 3600, ","kind":"text"},{"text":"session","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URLSession","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSURLSession"},{"text":" = .shared) -> ","kind":"text"},{"text":"KillswitchService","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService","kind":"typeIdentifier","preciseIdentifier":"s:16SwiduxKillswitch0B7ServiceV"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The endpoint must be HTTPS ("},{"code":"http","type":"codeVoice"},{"type":"text","text":" is allowed only for "},{"code":"localhost","type":"codeVoice"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"code":"127.0.0.1","type":"codeVoice"},{"type":"text","text":" development servers) — the killswitch is a remote control"},{"text":" ","type":"text"},{"text":"channel and must not be tamperable in transit, regardless of the host","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"app’s ATS configuration. The transfer is aborted the moment the response"},{"type":"text","text":" "},{"type":"text","text":"body exceeds 1 MB (it is streamed, never fully buffered past the cap),"},{"type":"text","text":" "},{"type":"text","text":"and non-2xx statuses are treated as fetch failures (the plugin then"},{"type":"text","text":" "},{"type":"text","text":"falls back to its cache)."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"fetchTimeout"},{"type":"text","text":" bounds the whole fetch, headers and body together — not"},{"type":"text","text":" "},{"type":"text","text":"just the gap between packets. A response trickled in a byte at a time"},{"type":"text","text":" "},{"type":"text","text":"still fails at "},{"type":"codeVoice","code":"fetchTimeout"},{"type":"text","text":", so the plugin reaches its cached verdict"},{"type":"text","text":" "},{"type":"text","text":"on schedule instead of waiting on a transfer that never ends. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"fetchTimeout"},{"type":"text","text":" that isn’t finite and positive ("},{"type":"codeVoice","code":".infinity"},{"type":"text","text":", say) sets"},{"type":"text","text":" "},{"type":"text","text":"no deadline, leaving only the session’s own timeouts."}]},{"level":2,"text":"The cache is the other input path","type":"heading","anchor":"The-cache-is-the-other-input-path"},{"type":"paragraph","inlineContent":[{"text":"A cached config produces a verdict with exactly the authority a fetched","type":"text"},{"text":" ","type":"text"},{"text":"one has, and it is reached without any successful fetch ever having","type":"text"},{"text":" ","type":"text"},{"text":"happened — launch offline and the failure path loads it directly. So it","type":"text"},{"text":" ","type":"text"},{"text":"is scoped and checked rather than trusted:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It lives in a "},{"inlineContent":[{"text":"bundle-scoped subdirectory","type":"text"}],"type":"strong"},{"type":"text","text":" of the caches directory."},{"type":"text","text":" "},{"type":"text","text":"On a non-sandboxed macOS build "},{"code":".cachesDirectory","type":"codeVoice"},{"type":"text","text":" is "},{"code":"~\/Library\/Caches","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"shared by the whole user account, so a bare filename would have every"},{"type":"text","text":" "},{"type":"text","text":"Swidux app reading every other’s blocked verdict."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"It records the "},{"type":"strong","inlineContent":[{"text":"endpoint it came from","type":"text"}]},{"type":"text","text":", and "},{"type":"reference","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService\/loadCached","isActive":true},{"type":"text","text":" treats a"},{"type":"text","text":" "},{"type":"text","text":"payload written for a different one as absent. Repointing the endpoint"},{"type":"text","text":" "},{"type":"text","text":"therefore invalidates the cache rather than inheriting it."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Neither of those makes the file authenticated. A process running as the","type":"text"},{"text":" ","type":"text"},{"text":"user can still write it on a platform where the caches directory isn’t","type":"text"},{"text":" ","type":"text"},{"text":"sandboxed — see ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"},{"text":".","type":"text"}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch","doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService"]]},"metadata":{"modules":[{"name":"SwiduxKillswitch"}],"fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"live"},{"kind":"text","text":"("},{"text":"endpoint","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","preciseIdentifier":"s:10Foundation3URLV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"fetchTimeout","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"cacheLifetime","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"session","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSURLSession","text":"URLSession"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16SwiduxKillswitch0B7ServiceV","text":"KillswitchService"}],"role":"symbol","symbolKind":"method","externalID":"s:16SwiduxKillswitch0B7ServiceV4live8endpoint12fetchTimeout13cacheLifetime7sessionAC10Foundation3URLV_S2dSo12NSURLSessionCtFZ","roleHeading":"Type Method","title":"live(endpoint:fetchTimeout:cacheLifetime:session:)"},"sections":[],"references":{"doc://SwiduxKillswitch/documentation/SwiduxKillswitch/KillswitchService":{"title":"KillswitchService","url":"\/documentation\/swiduxkillswitch\/killswitchservice","abst