{"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch","doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService"]]},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"live","kind":"identifier"},{"text":"(","kind":"text"},{"text":"endpoint","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":", ","kind":"text"},{"text":"fetchTimeout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":" = 10, ","kind":"text"},{"text":"cacheLifetime","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":" = 3600, ","kind":"text"},{"text":"session","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URLSession","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSURLSession"},{"text":" = .shared) -> ","kind":"text"},{"text":"KillswitchService","kind":"typeIdentifier","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService","preciseIdentifier":"s:16SwiduxKillswitch0B7ServiceV"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"The endpoint must be HTTPS (","type":"text"},{"code":"http","type":"codeVoice"},{"text":" is allowed only for ","type":"text"},{"code":"localhost","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":"127.0.0.1","type":"codeVoice"},{"text":" development servers) — the killswitch is a remote control","type":"text"},{"text":" ","type":"text"},{"text":"channel and must not be tamperable in transit, regardless of the host","type":"text"},{"text":" ","type":"text"},{"text":"app’s ATS configuration. The transfer is aborted the moment the response","type":"text"},{"text":" ","type":"text"},{"text":"body exceeds 1 MB (it is streamed, never fully buffered past the cap),","type":"text"},{"text":" ","type":"text"},{"text":"and non-2xx statuses are treated as fetch failures (the plugin then","type":"text"},{"text":" ","type":"text"},{"text":"falls back to its cache).","type":"text"}]},{"type":"heading","level":2,"anchor":"The-cache-is-the-other-input-path","text":"The cache is the other input path"},{"type":"paragraph","inlineContent":[{"text":"A cached config produces a verdict with exactly the authority a fetched","type":"text"},{"text":" ","type":"text"},{"text":"one has, and it is reached without any successful fetch ever having","type":"text"},{"text":" ","type":"text"},{"text":"happened — launch offline and the failure path loads it directly. So it","type":"text"},{"text":" ","type":"text"},{"text":"is scoped and checked rather than trusted:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"It lives in a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"bundle-scoped subdirectory"}]},{"text":" of the caches directory.","type":"text"},{"text":" ","type":"text"},{"text":"On a non-sandboxed macOS build ","type":"text"},{"code":".cachesDirectory","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"~\/Library\/Caches","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"shared by the whole user account, so a bare filename would have every","type":"text"},{"text":" ","type":"text"},{"text":"Swidux app reading every other’s blocked verdict.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"It records the ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"endpoint it came from"}]},{"text":", and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService\/loadCached","type":"reference"},{"text":" treats a","type":"text"},{"text":" ","type":"text"},{"text":"payload written for a different one as absent. Repointing the endpoint","type":"text"},{"text":" ","type":"text"},{"text":"therefore invalidates the cache rather than inheriting it.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Neither of those makes the file authenticated. A process running as the","type":"text"},{"text":" ","type":"text"},{"text":"user can still write it on a platform where the caches directory isn’t","type":"text"},{"text":" ","type":"text"},{"text":"sandboxed — see ","type":"text"},{"text":"doc:SecurityPosture","type":"text"},{"text":".","type":"text"}]}],"kind":"content"}],"kind":"symbol","sections":[],"abstract":[{"type":"text","text":"Production factory that fetches from a URL endpoint and caches to"},{"type":"text","text":" "},{"type":"text","text":"the system Caches directory."}],"metadata":{"externalID":"s:16SwiduxKillswitch0B7ServiceV4live8endpoint12fetchTimeout13cacheLifetime7sessionAC10Foundation3URLV_S2dSo12NSURLSessionCtFZ","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"live","kind":"identifier"},{"text":"(","kind":"text"},{"text":"endpoint","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":", ","kind":"text"},{"text":"fetchTimeout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":", ","kind":"text"},{"text":"cacheLifetime","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTi