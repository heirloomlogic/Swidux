{"hierarchy":{"paths":[["doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch","doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService"]]},"abstract":[{"text":"Production factory that fetches from a URL endpoint and caches to","type":"text"},{"text":" ","type":"text"},{"text":"the system Caches directory.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService\/live(endpoint:fetchTimeout:cacheLifetime:session:)"},"sections":[],"metadata":{"role":"symbol","externalID":"s:16SwiduxKillswitch0B7ServiceV4live8endpoint12fetchTimeout13cacheLifetime7sessionAC10Foundation3URLV_S2dSo12NSURLSessionCtFZ","roleHeading":"Type Method","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"live","kind":"identifier"},{"text":"(","kind":"text"},{"text":"endpoint","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:10Foundation3URLV","text":"URL","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"fetchTimeout","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"cacheLifetime","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"session","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"c:objc(cs)NSURLSession","text":"URLSession","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:16SwiduxKillswitch0B7ServiceV","text":"KillswitchService","kind":"typeIdentifier"}],"modules":[{"name":"SwiduxKillswitch"}],"symbolKind":"method","title":"live(endpoint:fetchTimeout:cacheLifetime:session:)"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"live","kind":"identifier"},{"text":"(","kind":"text"},{"text":"endpoint","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":", ","kind":"text"},{"text":"fetchTimeout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":" = 10, ","kind":"text"},{"text":"cacheLifetime","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":" = 3600, ","kind":"text"},{"text":"session","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URLSession","kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSURLSession"},{"text":" = .shared) -> ","kind":"text"},{"preciseIdentifier":"s:16SwiduxKillswitch0B7ServiceV","text":"KillswitchService","kind":"typeIdentifier","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The endpoint must be HTTPS ("},{"type":"codeVoice","code":"http"},{"type":"text","text":" is allowed only for "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":"127.0.0.1"},{"type":"text","text":" development servers) — the killswitch is a remote control"},{"type":"text","text":" "},{"type":"text","text":"channel and must not be tamperable in transit, regardless of the host"},{"type":"text","text":" "},{"type":"text","text":"app’s ATS configuration. The transfer is aborted the moment the response"},{"type":"text","text":" "},{"type":"text","text":"body exceeds 1 MB (it is streamed, never fully buffered past the cap),"},{"type":"text","text":" "},{"type":"text","text":"and non-2xx statuses are treated as fetch failures (the plugin then"},{"type":"text","text":" "},{"type":"text","text":"falls back to its cache)."}]},{"level":2,"text":"The cache is the other input path","type":"heading","anchor":"The-cache-is-the-other-input-path"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A cached config produces a verdict with exactly the authority a fetched"},{"type":"text","text":" "},{"type":"text","text":"one has, and it is reached without any successful fetch ever having"},{"type":"text","text":" "},{"type":"text","text":"happened — launch offline and the failure path loads it directly. So it"},{"type":"text","text":" "},{"type":"text","text":"is scoped and checked rather than trusted:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"It lives in a "},{"type":"strong","inlineContent":[{"type":"text","text":"bundle-scoped subdirectory"}]},{"type":"text","text":" of the caches directory."},{"type":"text","text":" "},{"type":"text","text":"On a non-sandboxed macOS build "},{"type":"codeVoice","code":".cachesDirectory"},{"type":"text","text":" is "},{"type":"codeVoice","code":"~\/Library\/Caches"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"shared by the whole user account, so a bare filename would have every"},{"type":"text","text":" "},{"type":"text","text":"Swidux app reading every other’s blocked verdict."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"It records the "},{"type":"strong","inlineContent":[{"type":"text","text":"endpoint it came from"}]},{"type":"text","text":", and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService\/loadCached"},{"type":"text","text":" treats a"},{"type":"text","text":" "},{"type":"text","text":"payload written for a different one as absent. Repointing the endpoint"},{"type":"text","text":" "},{"type":"text","text":"therefore invalidates the cache rather than inheriting it."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Neither of those makes the file authenticated. A process running as the","type":"text"},{"text":" ","type":"text"},{"text":"user can still write it on a platform where the caches directory isn’t","type":"text"},{"text":" ","type":"text"},{"text":"sandboxed — see ","type":"text"},{"text":"doc:SecurityPosture","type":"text"},{"text":".","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxkillswitch\/killswitchservice\/live(endpoint:fetchtimeout:cachelifetime:session:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","references":{"doc://SwiduxKillswitch/documentation/SwiduxKillswitch/KillswitchService/live(endpoint:fetchTimeout:cacheLifetime:session:)":{"type":"topic","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService\/live(endpoint:fetchTimeout:cacheLifetime:session:)","abstract":[{"text":"Production factory that fetches from a URL endpoint and caches to","type":"text"},{"text":" ","type":"text"},{"text":"the system Caches directory.","type":"text"}],"kind":"symbol","title":"live(endpoint:fetchTimeout:cacheLifetime:session:)","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"live"},{"kind":"text","text":"("},{"kind":"externalParam","text":"endpoint"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV","text":"URL"},{"kind":"text","text":", "},{"kind":"externalParam","text":"fetchTimeout"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"kind":"text","text":", "},{"kind":"externalParam","text":"cacheLifetime"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval","text":"TimeInterval"},{"text":", ","kind":"text"},{"text":"session","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSURLSession","text":"URLSession"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:16SwiduxKillswitch0B7ServiceV","text":"KillswitchService"}],"url":"\/documentation\/swiduxkillswitch\/killswitchservice\/live(endpoint:fetchtimeout:cachelifetime:session:)"},"doc://SwiduxKillswitch/documentation/SwiduxKillswitch":{"type":"topic","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch","abstract":[],"kind":"symbol","title":"SwiduxKillswitch","role":"collection","url":"\/documentation\/swiduxkillswitch"},"doc://SwiduxKillswitch/documentation/SwiduxKillswitch/KillswitchService":{"url":"\/documentation\/swiduxkillswitch\/killswitchservice","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService","navigatorTitle":[{"text":"KillswitchService","kind":"identifier"}],"abstract":[{"text":"A provider-agnostic service for fetching and caching the remote","type":"text"},{"text":" ","type":"text"},{"text":"killswitch configuration.","type":"text"}],"kind":"symbol","title":"KillswitchService","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KillswitchService","kind":"identifier"}],"type":"topic"},"doc://SwiduxKillswitch/documentation/SwiduxKillswitch/KillswitchService/loadCached":{"kind":"symbol","abstract":[{"type":"text","text":"Loads the last persisted config from local cache, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService\/loadCached","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"