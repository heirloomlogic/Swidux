{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"live","kind":"identifier"},{"text":"(","kind":"text"},{"text":"endpoint","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"URL","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation3URLV"},{"text":", ","kind":"text"},{"text":"fetchTimeout","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":" = 10, ","kind":"text"},{"text":"cacheLifetime","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"TimeInterval","kind":"typeIdentifier","preciseIdentifier":"c:@T@NSTimeInterval"},{"text":" = 3600, ","kind":"text"},{"kind":"externalParam","text":"session"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"URLSession","preciseIdentifier":"c:objc(cs)NSURLSession"},{"kind":"text","text":" = .shared) -> "},{"kind":"typeIdentifier","identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService","text":"KillswitchService","preciseIdentifier":"s:16SwiduxKillswitch0B7ServiceV"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The endpoint must be HTTPS ("},{"type":"codeVoice","code":"http"},{"type":"text","text":" is allowed only for "},{"type":"codeVoice","code":"localhost"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":"127.0.0.1"},{"type":"text","text":" development servers) — the killswitch is a remote control"},{"type":"text","text":" "},{"type":"text","text":"channel and must not be tamperable in transit, regardless of the host"},{"type":"text","text":" "},{"type":"text","text":"app’s ATS configuration. The transfer is aborted the moment the response"},{"type":"text","text":" "},{"type":"text","text":"body exceeds 1 MB (it is streamed, never fully buffered past the cap),"},{"type":"text","text":" "},{"type":"text","text":"and non-2xx statuses are treated as fetch failures (the plugin then"},{"type":"text","text":" "},{"type":"text","text":"falls back to its cache)."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"fetchTimeout"},{"type":"text","text":" bounds the whole fetch, headers and body together — not"},{"type":"text","text":" "},{"type":"text","text":"just the gap between packets. A response trickled in a byte at a time"},{"type":"text","text":" "},{"text":"still fails at ","type":"text"},{"code":"fetchTimeout","type":"codeVoice"},{"type":"text","text":", so the plugin reaches its cached verdict"},{"type":"text","text":" "},{"type":"text","text":"on schedule instead of waiting on a transfer that never ends. A"},{"type":"text","text":" "},{"code":"fetchTimeout","type":"codeVoice"},{"type":"text","text":" that isn’t finite and positive ("},{"code":".infinity","type":"codeVoice"},{"type":"text","text":", say) sets"},{"type":"text","text":" "},{"type":"text","text":"no deadline, leaving only the session’s own timeouts."}],"type":"paragraph"},{"anchor":"The-cache-is-the-other-input-path","text":"The cache is the other input path","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A cached config produces a verdict with exactly the authority a fetched"},{"type":"text","text":" "},{"type":"text","text":"one has, and it is reached without any successful fetch ever having"},{"text":" ","type":"text"},{"type":"text","text":"happened — launch offline and the failure path loads it directly. So it"},{"text":" ","type":"text"},{"type":"text","text":"is scoped and checked rather than trusted:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It lives in a "},{"type":"strong","inlineContent":[{"type":"text","text":"bundle-scoped subdirectory"}]},{"type":"text","text":" of the caches directory."},{"type":"text","text":" "},{"type":"text","text":"On a non-sandboxed macOS build "},{"type":"codeVoice","code":".cachesDirectory"},{"type":"text","text":" is "},{"type":"codeVoice","code":"~\/Library\/Caches"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"shared by the whole user account, so a bare filename would have every"},{"type":"text","text":" "},{"type":"text","text":"Swidux app reading every other’s blocked verdict."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"It records the ","type":"text"},{"type":"strong","inlineContent":[{"text":"endpoint it came from","type":"text"}]},{"text":", and ","type":"text"},{"identifier":"doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService\/loadCached","isActive":true,"type":"reference"},{"text":" treats a","type":"text"},{"text":" ","type":"text"},{"text":"payload written for a different one as absent. Repointing the endpoint","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"therefore invalidates the cache rather than inheriting it."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Neither of those makes the file authenticated. A process running as the"},{"type":"text","text":" "},{"type":"text","text":"user can still write it on a platform where the caches directory isn’t"},{"type":"text","text":" "},{"text":"sandboxed — see ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch","doc:\/\/SwiduxKillswitch\/documentation\/SwiduxKillswitch\/KillswitchService"]]},"metadata":{"modules":[{"name":"SwiduxKillswitch"}],"fragments":[{"kind":"keyword","text":"static"},{"kind"