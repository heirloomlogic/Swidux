{"kind":"symbol","abstract":[{"type":"text","text":"Live probe backed by the process’s entitlements and "},{"code":"CKContainer","type":"codeVoice"},{"type":"text","text":"."}],"variants":[{"paths":["\/documentation\/swiduxcloudkitsync\/syncpreflightservice\/live(containerid:isentitled:)"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync","doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/SyncPreflightService"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/SyncPreflightService\/live(containerID:isEntitled:)"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"live"},{"kind":"text","text":"("},{"kind":"externalParam","text":"containerID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"isEntitled"},{"kind":"text","text":": ("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"},{"text":")? = nil) -> ","kind":"text"},{"preciseIdentifier":"s:18SwiduxCloudKitSync0D16PreflightServiceV","text":"SyncPreflightService","kind":"typeIdentifier","identifier":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/SyncPreflightService"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"containerID","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The CloudKit container to probe, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"text":"default container. Pass the id you build the container with.","type":"text"}]}]},{"name":"isEntitled","content":[{"type":"paragraph","inlineContent":[{"text":"Your own entitlement check, replacing the built-in one —","type":"text"},{"type":"text","text":" "},{"type":"text","text":"for instance a flag set by the build configuration that sets"},{"type":"text","text":" "},{"type":"codeVoice","code":"CODE_SIGN_ENTITLEMENTS"},{"type":"text","text":"."}]}]}]},{"content":[{"type":"heading","level":2,"anchor":"return-value","text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A preflight service that probes this process and account."}]}],"kind":"content"},{"content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On macOS the entitlement check is definitive. It reads this process’s"},{"type":"text","text":" "},{"type":"text","text":"own code-signing entitlements, and requires "},{"code":"CloudKit","type":"codeVoice"},{"type":"text","text":" among"},{"type":"text","text":" "},{"code":"com.apple.developer.icloud-services","type":"codeVoice"},{"type":"text","text":" and a"},{"type":"text","text":" "},{"code":"com.apple.developer.icloud-container-identifiers","type":"codeVoice"},{"type":"text","text":" list that is"},{"type":"text","text":" "},{"type":"text","text":"non-empty and, when "},{"code":"containerID","type":"codeVoice"},{"type":"text","text":" is given, names it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS, tvOS, watchOS, and visionOS offer no public API for a process to"},{"type":"text","text":" "},{"type":"text","text":"read its own entitlements, so there the build is trusted unless you pass"},{"type":"text","text":" "},{"type":"codeVoice","code":"isEntitled"},{"type":"text","text":". That trust is narrower than it sounds: those platforms"},{"type":"text","text":" "},{"type":"text","text":"refuse to launch a binary claiming entitlements its profile doesn’t"},{"type":"text","text":" "},{"type":"text","text":"grant, so a running build lacks CloudKit only if its entitlements file"},{"type":"text","text":" "},{"type":"text","text":"never asked for it — a fact fixed at build time, which surfaces on the"},{"type":"text","text":" "},{"type":"text","text":"first "},{"type":"codeVoice","code":".iCloud"},{"type":"text","text":" probe in development. A build that is entitled but"},{"type":"text","text":" "},{"type":"text","text":"pointed at the wrong container is still caught, from the"},{"type":"text","text":" "},{"type":"codeVoice","code":"CKError.badContainer"},{"type":"text","text":" or "},{"type":"codeVoice","code":".missingEntitlement"},{"type":"text","text":" the account probe gets."}]}],"kind":"content"}],"metadata":{"modules":[{"name":"SwiduxCloudKitSync"}],"symbolKind":"method","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"live"},{"kind":"text","text":"("},{"kind":"externalParam","text":"containerID"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"isEntitled"},{"kind":"text","text":": (() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":")?) -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:18SwiduxCloudKitSync0D16PreflightServiceV","text":"SyncPreflightService"}],"role":"symbol","externalID":"s:18SwiduxCloudKitSync0D16PreflightServiceV4live11containerID10isEntitledACSSSg_SbyYbcSgtFZ","title":"live(containerID:isEntitled:)","roleHeading":"Type Method"},"references":{"doc://SwiduxCloudKitSync/documentation/SwiduxCloudKitSync/SyncPreflightService/live(containerID:isEntitled:)":{"kind":"symbol","abstract":[{"type":"text","text":"Live probe backed by the process’s entitlements and "},{"code":"CKContainer","type":"codeVoice"},{"type":"text","text":"."}]