{"hierarchy":{"paths":[["doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync","doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/SyncPreflightService"]]},"sections":[],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"SwiduxCloudKitSync"}],"title":"live(containerID:isEntitled:)","roleHeading":"Type Method","externalID":"s:18SwiduxCloudKitSync0D16PreflightServiceV4live11containerID10isEntitledACSSSg_SbyYbcSgtFZ","symbolKind":"method","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"live"},{"kind":"text","text":"("},{"text":"containerID","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":"?, ","kind":"text"},{"text":"isEntitled","kind":"externalParam"},{"kind":"text","text":": (() -> "},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"kind":"text","text":")?) -> "},{"text":"SyncPreflightService","kind":"typeIdentifier","preciseIdentifier":"s:18SwiduxCloudKitSync0D16PreflightServiceV"}]},"abstract":[{"type":"text","text":"Live probe backed by the process’s entitlements and "},{"type":"codeVoice","code":"CKContainer"},{"type":"text","text":"."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/SyncPreflightService\/live(containerID:isEntitled:)"},"variants":[{"paths":["\/documentation\/swiduxcloudkitsync\/syncpreflightservice\/live(containerid:isentitled:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"live","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"containerID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"isEntitled"},{"kind":"text","text":": ("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")? = nil) -> ","kind":"text"},{"preciseIdentifier":"s:18SwiduxCloudKitSync0D16PreflightServiceV","identifier":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/SyncPreflightService","text":"SyncPreflightService","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The CloudKit container to probe, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for the"},{"text":" ","type":"text"},{"type":"text","text":"default container. Pass the id you build the container with."}]}],"name":"containerID"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Your own entitlement check, replacing the built-in one —"},{"type":"text","text":" "},{"type":"text","text":"for instance a flag set by the build configuration that sets"},{"type":"text","text":" "},{"type":"codeVoice","code":"CODE_SIGN_ENTITLEMENTS"},{"type":"text","text":"."}]}],"name":"isEntitled"}],"kind":"parameters"},{"content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A preflight service that probes this process and account."}]}],"kind":"content"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On macOS the entitlement check is definitive. It reads this process’s"},{"type":"text","text":" "},{"type":"text","text":"own code-signing entitlements, and requires "},{"type":"codeVoice","code":"CloudKit"},{"type":"text","text":" among"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.developer.icloud-services"},{"type":"text","text":" and a"},{"type":"text","text":" "},{"type":"codeVoice","code":"com.apple.developer.icloud-container-identifiers"},{"type":"text","text":" list that is"},{"type":"text","text":" "},{"type":"text","text":"non-empty and, when "},{"type":"codeVoice","code":"containerID"},{"type":"text","text":" is given, names it."}]},{"type":"paragraph","inlineContent":[{"text":"iOS, tvOS, watchOS, and visionOS offer no public API for a process to","type":"text"},{"text":" ","type":"text"},{"text":"read its own entitlements, so there the build is trusted unless you pass","type":"text"},{"text":" ","type":"text"},{"code":"isEntitled","type":"codeVoice"},{"text":". That trust is narrower than it sounds: those platforms","type":"text"},{"text":" ","type":"text"},{"text":"refuse to launch a binary claiming entitlements its profile doesn’t","type":"text"},{"text":" ","type":"text"},{"text":"grant, so a running build lacks CloudKit only if its entitlements file","type":"text"},{"text":" ","type":"text"},{"text":"never asked for it — a fact fixed at build time, which surfaces on the","type":"text"},{"text":" ","type":"text"},{"text":"first ","type":"text"},{"type":"codeVoice","code":".iCloud"},{"text":" probe in development. A build that is entitled but","type":"text"},{"text":" ","type":"text"},{"text":"pointed at the wrong container is still caught, from the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"CKError.badContainer"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".missingEntitlement"},{"text":" the account probe gets.","type":"text"}]}],"kind":"content"}],"references":{"doc://SwiduxCloudKitSync/documentation/SwiduxCloudKitSync/SyncPreflightService":{"abstract":[{"text":"Probes iCloud availability. Inject ","type":"text"},{"type":"codeVoice","code":".mock(...)"},{"text":" in tests.","type":"text"}],"identifier":"doc:\/\/SwiduxCloudKitSync\/documentatio