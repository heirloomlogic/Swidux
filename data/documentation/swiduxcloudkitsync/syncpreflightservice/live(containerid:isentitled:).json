{"hierarchy":{"paths":[["doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync","doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/SyncPreflightService"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/SyncPreflightService\/live(containerID:isEntitled:)"},"sections":[],"kind":"symbol","abstract":[{"type":"text","text":"Live probe backed by the process’s entitlements and "},{"type":"codeVoice","code":"CKContainer"},{"type":"text","text":"."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"live"},{"kind":"text","text":"("},{"kind":"externalParam","text":"containerID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"? = nil, "},{"kind":"externalParam","text":"isEntitled"},{"kind":"text","text":": ("},{"kind":"attribute","text":"@Sendable"},{"kind":"text","text":" () -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":")? = nil) -> "},{"identifier":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/SyncPreflightService","preciseIdentifier":"s:18SwiduxCloudKitSync0D16PreflightServiceV","kind":"typeIdentifier","text":"SyncPreflightService"}]}],"kind":"declarations"},{"kind":"parameters","parameters":[{"name":"containerID","content":[{"inlineContent":[{"type":"text","text":"The CloudKit container to probe, or "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" for the"},{"type":"text","text":" "},{"type":"text","text":"default container. Pass the id you build the container with."}],"type":"paragraph"}]},{"name":"isEntitled","content":[{"inlineContent":[{"type":"text","text":"Your own entitlement check, replacing the built-in one —"},{"type":"text","text":" "},{"type":"text","text":"for instance a flag set by the build configuration that sets"},{"type":"text","text":" "},{"type":"codeVoice","code":"CODE_SIGN_ENTITLEMENTS"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"content":[{"type":"heading","text":"Return Value","anchor":"return-value","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A preflight service that probes this process and account."}]}],"kind":"content"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"On macOS the entitlement check is definitive. It reads this process’s"},{"type":"text","text":" "},{"type":"text","text":"own code-signing entitlements, and requires "},{"code":"CloudKit","type":"codeVoice"},{"type":"text","text":" among"},{"type":"text","text":" "},{"code":"com.apple.developer.icloud-services","type":"codeVoice"},{"type":"text","text":" and a"},{"type":"text","text":" "},{"code":"com.apple.developer.icloud-container-identifiers","type":"codeVoice"},{"type":"text","text":" list that is"},{"type":"text","text":" "},{"type":"text","text":"non-empty and, when "},{"code":"containerID","type":"codeVoice"},{"type":"text","text":" is given, names it."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS, tvOS, watchOS, and visionOS offer no public API for a process to"},{"type":"text","text":" "},{"type":"text","text":"read its own entitlements, so there the build is trusted unless you pass"},{"type":"text","text":" "},{"code":"isEntitled","type":"codeVoice"},{"type":"text","text":". That trust is narrower than it sounds: those platforms"},{"type":"text","text":" "},{"type":"text","text":"refuse to launch a binary claiming entitlements its profile doesn’t"},{"type":"text","text":" "},{"type":"text","text":"grant, so a running build lacks CloudKit only if its entitlements file"},{"type":"text","text":" "},{"type":"text","text":"never asked for it — a fact fixed at build time, which surfaces on the"},{"type":"text","text":" "},{"type":"text","text":"first "},{"code":".iCloud","type":"codeVoice"},{"type":"text","text":" probe in development. A build that is entitled but"},{"type":"text","text":" "},{"type":"text","text":"pointed at the wrong container is still caught, from the"},{"type":"text","text":" "},{"code":"CKError.badContainer","type":"codeVoice"},{"type":"text","text":" or "},{"code":".missingEntitlement","type":"codeVoice"},{"type":"text","text":" the account probe gets."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxcloudkitsync\/syncpreflightservice\/live(containerid:isentitled:)"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"externalID":"s:18SwiduxCloudKitSync0D16PreflightServiceV4live11containerID10isEntitledACSSSg_SbyYbcSgtFZ","role":"symbol","title":"live(containerID:isEntitled:)","modules":[{"name":"SwiduxCloudKitSync"}],"roleHeading":"Type Method","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"live"},{"kind":"text","text":"("},{"kind":"externalParam","text":"containerID"},{"kind":"text","text":": "},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":"?, "},{"kind":"externalParam","text":"isEntitled"},{"kind":"text","text":": (() -> "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":")?) -> "},{"preciseIdentifier":"s:18SwiduxCloudKitSync0D16PreflightServiceV","kind":"typeIdentifier","text":"SyncPreflightService"}],"symbolKind":"method"},"references":{"doc://SwiduxCloudKitSync/documentation/SwiduxCloudKitSync":{"title":"SwiduxCloudKitSync","type":"topic","identifier":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync","url":"\/documentation\/swiduxcloudkitsync","abstract":[],"kind":"symbol","role":"collection"},"doc://Swi