{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"The stores one coalesced burst of remote-change notifications named."}],"relationshipsSections":[{"identifiers":["doc:\/\/SwiduxCloudKitSync\/s8SendableP","doc:\/\/SwiduxCloudKitSync\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RemoteChange","kind":"identifier"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Every field describes the whole burst, not its last notification. A burst is","type":"text"},{"text":" ","type":"text"},{"text":"one window as far as the merge is concerned, and “the last one wins” would","type":"text"},{"text":" ","type":"text"},{"text":"silently drop every notification but one — on a debounce that exists","type":"text"},{"text":" ","type":"text"},{"text":"precisely because bursts are expected, that is a change quietly going","type":"text"},{"text":" ","type":"text"},{"text":"missing rather than a visible failure.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only notifications the observer "},{"type":"emphasis","inlineContent":[{"text":"accepted","type":"text"}]},{"type":"text","text":" are represented. A notification"},{"type":"text","text":" "},{"type":"text","text":"from a store the observer was told it doesn’t own is dropped before it gets"},{"text":" ","type":"text"},{"text":"here; one whose store can’t be identified is always accepted, and sets","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChang