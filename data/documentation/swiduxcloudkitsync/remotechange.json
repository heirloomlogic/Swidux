{"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync"]]},"identifier":{"url":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiduxcloudkitsync\/remotechange"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"The stores one coalesced burst of remote-change notifications named.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RemoteChange","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Every field describes the whole burst, not its last notification. A burst is","type":"text"},{"text":" ","type":"text"},{"text":"one window as far as the merge is concerned, and “the last one wins” would","type":"text"},{"text":" ","type":"text"},{"text":"silently drop every notification but one — on a debounce that exists","type":"text"},{"text":" ","type":"text"},{"text":"precisely because bursts are expected, that is a change quietly going","type":"text"},{"text":" ","type":"text"},{"text":"missing rather than a visible failure.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Only notifications the observer "},{"type":"emphasis","inlineContent":[{"type":"text","text":"accepted"}]},{"type":"text","text":" are represented. A notification"},{"type":"text","text":" "},{"type":"text","text":"from a store the observer was told it doesn’t own is dropped before it gets"},{"type":"text","text":" "},{"type":"text","text":"here; one whose store can’t be identified is always accepted, and sets"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange\/includesUnidentifiedStore"},{"type":"text","text":"."}]},{"level":2,"text":"Why there is no history token","anchor":"Why-there-is-no-history-token","type":"heading"},{"inlineContent":[{"text":"The underlying notification carries ","type":"text"},{"type":"codeVoice","code":"NSPersistentHistoryTokenKey"},{"text":", and it is","type":"text"},{"text":" ","type":"text"},{"text":"deliberately not surfaced. That value is a CoreData ","type":"text"},{"type":"codeVoice","code":"NSPersistentHistoryToken"},{"text":";","type":"text"},{"text":" ","type":"text"},{"text":"the watermark in ","type":"text"},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":" is a SwiftData ","type":"text"},{"type":"codeVoice","code":"DefaultHistoryToken"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"whose only public initializer is ","type":"text"},{"type":"codeVoice","code":"init(from:)"},{"text":" — there is no supported","type":"text"},{"text":" ","type":"text"},{"text":"conversion between the two, and SwiftData’s interface names no CoreData type","type":"text"},{"text":" ","type":"text"},{"text":"at all. Publishing a token that neither Swidux nor an app author can act on","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"would be an invitation to misuse it."}],"type":"paragraph"},{"inlineContent":[{"text":"Nothing is lost by leaving it out: ","type":"text"},{"code":"PersistenceCoordinator.mergeChanges(into:policy:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"anchors its watermark on the highest token in the window it just scanned, so","type":"text"},{"text":" ","type":"text"},{"text":"the token it needs is one it already holds.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"title":"RemoteChange","modules":[{"name":"SwiduxCloudKitSync"}],"role":"symbol","externalID":"s:18SwiduxCloudKitSync12RemoteChangeV","symbolKind":"struct","navigatorTitle":[{"text":"RemoteChange","kind":"id