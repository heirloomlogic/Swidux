{"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/SwiduxCloudKitSync\/s8SendableP","doc:\/\/SwiduxCloudKitSync\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RemoteChange"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every field describes the whole burst, not its last notification. A burst is"},{"type":"text","text":" "},{"type":"text","text":"one window as far as the merge is concerned, and “the last one wins” would"},{"type":"text","text":" "},{"type":"text","text":"silently drop every notification but one — on a debounce that exists"},{"type":"text","text":" "},{"text":"precisely because bursts are expected, that is a change quietly going","type":"text"},{"text":" ","type":"text"},{"text":"missing rather than a visible failure.","type":"text"}]},{"inlineContent":[{"text":"Only notifications the observer ","type":"text"},{"inlineContent":[{"type":"text","text":"accepted"}],"type":"emphasis"},{"text":" are represented. A notification","type":"text"},{"text":" ","type":"text"},{"text":"from a store the observer was told it doesn’t own is dropped before it gets","type":"text"},{"text":" ","type":"text"},{"text":"here; one whose store can’t be identified is always accepted, and sets","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange\/includesUnidentifiedStore","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Why there is no history token","anchor":"Why-there-is-no-history-token","type":"heading"},{"inlineContent":[{"text":"The underlying notification carries ","type":"text"},{"code":"NSPersistentHistoryTokenKey","type":"codeVoice"},{"text":", and it is","type":"text"},{"text":" ","type":"text"},{"text":"deliberately not surfaced. That value is a CoreData ","type":"text"},{"code":"NSPersistentHistoryToken","type":"codeVoice"},{"text":";","type":"text"},{"text":" ","type":"text"},{"text":"the watermark in ","type":"text"},{"code":"SwiduxPersistence","type":"codeVoice"},{"text":" is a SwiftData ","type":"text"},{"code":"DefaultHistoryToken","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"whose only public initializer is ","type":"text"},{"code":"init(from:)","type":"codeVoice"},{"text":" — there is no supported","type":"text"},{"type":"text","text":" "},{"type":"text","text":"conversion between the two, and SwiftData’s interface names no CoreData type"},{"type":"text","text":" "},{"type":"text","text":"at all. Publishing a token that neither Swidux nor an app author can act on"},{"type":"text","text":" "},{"type":"text","text":"would be an invitation to misuse it."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Nothing is lost by leaving it out: "},{"type":"codeVoice","code":"PersistenceCoordinator.mergeChanges(into:policy:)"},{"type":"text","text":" "},{"type":"text","text":"anchors its watermark on the highest token in the window it just scanned, so"},{"type":"text","text":" "},{"type":"text","text":"the token it needs is one it already holds."}]}]}],"abstract":[{"text":"The stores one coalesced burst of remote-change notifications named.","type":"text"}],"variants":[{"paths":["\/documentation\/swiduxcloudkitsync\/remotechange"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync"]]},"metadata":{"symbolKind":"struct","modules":[{"name":"SwiduxCloudKitSync"}],"title":"RemoteChange","fragments":[{"text":"struct","kind":"keyword