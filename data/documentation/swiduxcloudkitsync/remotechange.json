{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync"]]},"identifier":{"url":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The stores one coalesced burst of remote-change notifications named."}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange\/init(storeURLs:storeUUIDs:includesUnidentifiedStore:notificationCount:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange\/includesUnidentifiedStore","doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange\/notificationCount","doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange\/storeURLs","doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange\/storeUUIDs"],"generated":true,"anchor":"Instance-Properties"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxcloudkitsync\/remotechange"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"RemoteChange"}]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"Every field describes the whole burst, not its last notification. A burst is"},{"type":"text","text":" "},{"type":"text","text":"one window as far as the merge is concerned, and “the last one wins” would"},{"type":"text","text":" "},{"type":"text","text":"silently drop every notification but one — on a debounce that exists"},{"type":"text","text":" "},{"type":"text","text":"precisely because bursts are expected, that is a change quietly going"},{"type":"text","text":" "},{"type":"text","text":"missing rather than a visible failure."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Only notifications the observer "},{"type":"emphasis","inlineContent":[{"type":"text","text":"accepted"}]},{"type":"text","text":" are represented. A notification"},{"type":"text","text":" "},{"type":"text","text":"from a store the observer was told it doesn’t own is dropped before it gets"},{"type":"text","text":" "},{"type":"text","text":"here; one whose store can’t be identified is always accepted, and sets"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange\/includesUnidentifiedStore"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Why there is no history token","level":2,"anchor":"Why-there-is-no-history-token"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The underlying notification carries "},{"type":"codeVoice","code":"NSPersistentHistoryTokenKey"},{"type":"text","text":", and it is"},{"type":"text","text":" "},{"type":"text","text":"deliberately not surfaced. That value is a CoreData "},{"type":"codeVoice","code":"NSPersistentHistoryToken"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"the watermark in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"type":"text","text":" is a SwiftData "},{"type":"codeVoice","code":"DefaultHistoryToken"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whose only public initializer is "},{"type":"codeVoice","code":"init(from:)"},{"type":"text","text":" — there is no supported"},{"type":"text","text":" "},{"type":"text","text":"conversion between the two, and SwiftData’s interface names no CoreData type"},{"type":"text","text":" "},{"type":"text","text":"at all. Publishing a token that neither Swidux nor an app author can act on"},{"type":"text","text":" "},{"type":"text","text":"would be an invitation to misuse it."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PersistenceCoordinator.mergeChanges(into:policy:)"},{"type":"text","text":" anchors its watermark on the last transaction in the window it just scanned, so it already holds the token it needs."}]}]}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/SwiduxCloudKitSync\/s8SendableP","doc:\/\/SwiduxCloudKitSync\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RemoteChange"}],"externalID":"s:18SwiduxCloudKitSync12RemoteChangeV","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"RemoteChange"}],"roleHeading":"Structure","symbolKind":"struct","modules":[{"name":"SwiduxCloudKitSync"}],"title":"RemoteChange"},"references":{"doc://SwiduxCloudKitSync/documentation/SwiduxCloudKitSync":{"title":"SwiduxCloudKitSync","type":"topic","identifier":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync","url":"\/documentation\/swiduxcloudkitsync","abstract":[],"kind":"symbol","role":"collection"},"doc://SwiduxCloudKitSync/s8SendableP":{"title":"Swift.Sendable","identifier":"doc:\/\/SwiduxCloudKitSync\/s8SendableP","type":"unresolvable"},"doc://SwiduxCloudKitSync/documentation/SwiduxCloudKitSync/RemoteChange/storeUUIDs":{"url":"\/documentation\/swiduxcloudkitsync\/remotechange\/storeuuids","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"The store UUIDs the burst named, from "},{"type":"codeVoice","code":"NSStoreUUIDKey"},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange\/storeUUIDs","title":"storeUUIDs","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"storeUUIDs","kind":"identifier"},{"text":": ","kind":"text"},{"