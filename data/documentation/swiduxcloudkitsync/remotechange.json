{"topicSections":[{"generated":true,"identifiers":["doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange\/init(storeURLs:storeUUIDs:includesUnidentifiedStore:notificationCount:)"],"title":"Initializers","anchor":"Initializers"},{"generated":true,"identifiers":["doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange\/includesUnidentifiedStore","doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange\/notificationCount","doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange\/storeURLs","doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange\/storeUUIDs"],"title":"Instance Properties","anchor":"Instance-Properties"}],"relationshipsSections":[{"type":"conformsTo","identifiers":["doc:\/\/SwiduxCloudKitSync\/s8SendableP","doc:\/\/SwiduxCloudKitSync\/s16SendableMetatypeP"],"title":"Conforms To","kind":"relationships"}],"identifier":{"url":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","abstract":[{"text":"The stores one coalesced burst of remote-change notifications named.","type":"text"}],"variants":[{"paths":["\/documentation\/swiduxcloudkitsync\/remotechange"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"roleHeading":"Structure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RemoteChange"}],"role":"symbol","title":"RemoteChange","externalID":"s:18SwiduxCloudKitSync12RemoteChangeV","symbolKind":"struct","modules":[{"name":"SwiduxCloudKitSync"}],"navigatorTitle":[{"text":"RemoteChange","kind":"identifier"}]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RemoteChange"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Overview","type":"heading","anchor":"overview","level":2},{"inlineContent":[{"type":"text","text":"Every field describes the whole burst, not its last notification. A burst is"},{"type":"text","text":" "},{"type":"text","text":"one window as far as the merge is concerned, and “the last one wins” would"},{"type":"text","text":" "},{"type":"text","text":"silently drop every notification but one — on a debounce that exists"},{"type":"text","text":" "},{"type":"text","text":"precisely because bursts are expected, that is a change quietly going"},{"type":"text","text":" "},{"type":"text","text":"missing rather than a visible failure."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Only notifications the observer "},{"type":"emphasis","inlineContent":[{"type":"text","text":"accepted"}]},{"type":"text","text":" are represented. A notification"},{"type":"text","text":" "},{"type":"text","text":"from a store the observer was told it doesn’t own is dropped before it gets"},{"type":"text","text":" "},{"type":"text","text":"here; one whose store can’t be identified is always accepted, and sets"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange\/includesUnidentifiedStore","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Why there is no history token","type":"heading","anchor":"Why-there-is-no-history-token","level":2},{"inlineContent":[{"type":"text","text":"The underlying notification carries "},{"code":"NSPersistentHistoryTokenKey","type":"codeVoice"},{"type":"text","text":", and it is"},{"type":"text","text":" "},{"type":"text","text":"deliberately not surfaced. That value is a CoreData "},{"code":"NSPersistentHistoryToken","type":"codeVoice"},{"type":"text","text":";"},{"type":"text","text":" "},{"type":"text","text":"the watermark in "},{"code":"SwiduxPersistence","type":"codeVoice"},{"type":"text","text":" is a SwiftData "},{"code":"DefaultHistoryToken","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"whose only public initializer is "},{"code":"init(from:)","type":"codeVoice"},{"type":"text","text":" — there is no supported"},{"type":"text","text":" "},{"type":"text","text":"conversion between the two, and SwiftData’s interface names no CoreData type"},{"type":"text","text":" "},{"type":"text","text":"at all. Publishing a token that neither Swidux nor an app author can act on"},{"type":"text","text":" "},{"type":"text","text":"would be an invitation to misuse it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Nothing is lost by leaving it out: "},{"code":"PersistenceCoordinator.mergeChanges(into:policy:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"anchors its watermark on the highest token in the window it just scanned, so"},{"type":"text","text":" "},{"type":"text","text":"the token it needs is one it already holds."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"references":{"doc://SwiduxCloudKitSync/documentation/SwiduxCloudKitSync/RemoteChange/includesUnidentifiedStore":{"type":"topic","abstract":[{"type":"text","text":"Whether any notification in the burst named no store this observer could"},{"type":"text","text":" "},{"type":"text","text":"identify."}],"title":"includesUnidentifiedStore","kind":"symbol","identifier":"doc:\/\/SwiduxCloudKitSync\/documentation\/SwiduxCloudKitSync\/RemoteChange\/includesUnidentifiedStore","role":"symbol","url":"\/documentation\/swiduxcloudkitsync\/remotechange\/includesunidentifiedstore","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"includesUnidentifiedStore","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]},"doc://SwiduxCloudKitSync/documentation/SwiduxCloudKitSync":{"type":"topic","abstract":[],"title