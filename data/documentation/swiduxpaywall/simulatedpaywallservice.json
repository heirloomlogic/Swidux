{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SimulatedPaywallService","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use this as the "},{"type":"codeVoice","code":"service:"},{"type":"text","text":" while the paywall vendor decision is still open."},{"type":"text","text":" "},{"type":"text","text":"It behaves like a micro version of the real thing: entitlement changes are"},{"type":"text","text":" "},{"type":"text","text":"pushed through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/SimulatedPaywallService\/customerInfoStream()"},{"type":"text","text":" so they flow through the real"},{"text":" ","type":"text"},{"type":"codeVoice","code":"PaywallPlugin"},{"type":"text","text":" pipeline and survive later refresh\/restore — exactly as a"},{"type":"text","text":" "},{"type":"text","text":"RevenueCat\/StoreKit service would."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The simulation surface ("},{"type":"codeVoice","code":"grantPro()"},{"type":"text","text":", "},{"type":"codeVoice","code":"setRestoreShouldFail(_:)"},{"type":"text","text":", …) is not"},{"type":"text","text":" "},{"type":"text","text":"part of "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService"},{"type":"text","text":"; the dev paywall UI in "},{"type":"codeVoice","code":"SwiduxDevPaywallUI"},{"text":" ","type":"text"},{"text":"drives it. Hold a single instance and pass it to both ","type":"text"},{"type":"codeVoice","code":"Store.configured()"},{"text":" ","type":"text"},{"text":"and the ","type":"text"},{"code":".devPaywall(...)","type":"codeVoice"},{"text":" view.","type":"text"