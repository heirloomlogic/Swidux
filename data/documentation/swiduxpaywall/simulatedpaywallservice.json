{"abstract":[{"type":"text","text":"A stateful, fully driveable "},{"isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","type":"reference"},{"type":"text","text":" for development and QA."}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/SimulatedPaywallService\/init(isPro:hasPermanentLicense:subsystem:category:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Methods","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/SimulatedPaywallService\/customerInfo()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/SimulatedPaywallService\/customerInfoStream()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/SimulatedPaywallService\/grantPermanentLicense()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/SimulatedPaywallService\/grantPro()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/SimulatedPaywallService\/grantTrial()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/SimulatedPaywallService\/restorePurchases()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/SimulatedPaywallService\/setArtificialDelay(_:)","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/SimulatedPaywallService\/setEntitlement(isPro:hasPermanentLicense:)","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/SimulatedPaywallService\/setFree()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/SimulatedPaywallService\/setRefreshShouldFail(_:)","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/SimulatedPaywallService\/setRestoreShouldFail(_:)"],"generated":true,"anchor":"Instance-Methods"},{"title":"Default Implementations","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/SimulatedPaywallService\/Actor-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"sections":[],"metadata":{"externalID":"s:13SwiduxPaywall09SimulatedB7ServiceC","title":"SimulatedPaywallService","role":"sym