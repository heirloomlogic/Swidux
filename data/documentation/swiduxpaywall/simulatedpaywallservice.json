{"abstract":[{"type":"text","text":"A stateful, fully driveable "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true},{"type":"text","text":" for development and QA."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"SimulatedPaywallService"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"inlineContent":[{"type":"text","text":"Use this as the "},{"type":"codeVoice","code":"service:"},{"type":"text","text":" while the paywall vendor decision is still open."},{"type":"text","text":" "},{"type":"text","text":"It behaves like a micro version of the real thing: entitlement changes are"},{"type":"text","text":" "},{"type":"text","text":"pushed through "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/SimulatedPaywallService\/customerInfoStream()","isActive":true},{"type":"text","text":" so they flow through the real"},{"type":"text","text":" "},{"type":"codeVoice","code":"PaywallPlugin"},{"type":"text","text":" pipeline and survive later refresh\/restore — exactly as a"},{"type":"text","text":" "},{"type":"text","text":"RevenueCat\/StoreKit service would."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The simulation surface ("},{"type":"codeVoice","code":"grantPro()"},{"type":"text","text":", "},{"type":"codeVoice","code":"setRestoreShouldFail(_:)"},{"type":"text","text":", …) is not"},{"type":"text","text":" "},{"type":"text","text":"part of "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true},{"type":"text","text":"; the dev paywall UI in "},{"type":"codeVoice","code":"SwiduxDevPaywallUI"},{"type":"text","text":" "},{"type":"text","text":"drives it. Hold a single instance and pass it to both "},{"type":"codeVoice","code":"Store.configured()"},{"type":"text","text":" "},{"type":"text","text":"and the "},{"type":"codeVoice","code":".devPaywall(...)"},{"type":"text","text":" view."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EntitlementSnapshot"},{"type":"text","text":" only models "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":", so a"},{"type":"text","text":" "},{"type":"text","text":"“trial” yields "},{"type":"codeVoice","code":"isPro == true"},{"type":"text","text":" and is distinguished only in the log line."}]},{"style":"warning","type":"aside","name":"Warning","content":[{"type":"paragraph","inlineContent":[{"text":"This service simulates purchases — nothing is charged and no","type":"text"},{"text":" ","type":"text"},{"text":"receipt exists. Release builds are supported so TestFlight\/QA can drive","type":"text"},{"text":" ","type":"text"},{"text":"the paywall vendor-free, but the service logs a fault at init in Release","type":"text"},{"text":" ","type":"text"},{"text":"as a submission tripwire: replace it with a real ","type":"text"},{"type":"codeVoice","code":"PaywallService"},{"text":" before","type":"text"},{"text":" ","type":"text"},{"text":"shipping to the App Store.","type":"text"}]}]}]}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","doc:\/\/SwiduxPaywall\/s8SendableP","doc:\/\/SwiduxPaywall\/s16SendableMetatypeP","doc:\/\/SwiduxPaywall\/ScA"],"title":"Conforms To","type":"conformsTo"}],"variants":[{"paths":["\/documentation\/swiduxpaywall\/simulatedpaywallservice"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/SimulatedPaywallService","interfaceLanguage":"swift"},"metadata":{"symbolKind":"class","fragments":[{"kind":"key