{"abstract":[{"type":"text","text":"Forgets the persisted last-known-good entitlement."}],"sections":[],"metadata":{"externalID":"s:13SwiduxPaywall09ResilientB7ServiceV10clearCacheSbyF","title":"clearCache()","role":"symbol","roleHeading":"Instance Method","modules":[{"name":"SwiduxPaywall"}],"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearCache","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"identifier":{"url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/clearCache()","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@discardableResult","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearCache","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"anchor":"return-value","type":"heading","level":2,"text":"Return Value"},{"inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"true"},{"type":"text","text":" if the cache is now empty. A Keychain-backed store"},{"type":"text","text":" "},{"type":"text","text":"returns "},{"type":"codeVoice","code":"false"},{"type":"text","text":" when the keychain is unreachable."}],"type":"paragraph"}],"kind":"content"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"The cache is not scoped to an account. Call this when the user signs"},{"type":"text","text":" "},{"type":"text","text":"out or switches accounts, or an offline launch keeps vouching for the"},{"type":"text","text":" "},{"type":"text","text":"previous user’s entitlement (for up to "},{"type":"codeVoice","code":"maxCacheAge"},{"type":"text","text":", or indefinitely"},{"type":"text","text":" "},{"type":"text","text":"for a permanent license). Reads and restores still in flight are"},{"type":"text","text":" "},{"type":"text","text":"superseded, so one begun for the previous account cannot write its"},{"type":"text","text":" "},{"type":"text","text":"result back. Base-stream events carry no account, and one produced"},{"type":"text","text":" "},{"type":"text","text":"before the sign-out can arrive after it, so the stream keeps"},{"type":"text","text":" "},{"type":"text","text":"forwarding but stops writing the cache until a read or restore begun"},{"type":"text","text":" "},{"type":"text","text":"after the clear succeeds. "},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","isActive":true,"type":"reference"},{"type":"text","text":" is not touched: dispatch"},{"type":"text","text":" "},{"type":"codeVoice","code":".refreshCustomerInfo"},{"type":"text","text":" afterwards to re-read the new account (which"},{"type":"text","text":" "},{"type":"text","text":"also reopens the cache to the stream)."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice\/clearcache()"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallState":{"abstract":[{"type":"text","text":"Current paywall state — entitlement status, sheet presentation, and async progress."}],"url":"\/documentation\/swiduxpaywall\/paywallstate","type":"topic","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","title":"PaywallState","navigatorTitle":[{"kind":"identifier","text":"PaywallState"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text