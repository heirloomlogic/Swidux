{"identifier":{"url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Restores previously completed purchases, forwarding to the base service."},{"type":"text","text":" "},{"type":"text","text":"Persists on success; rethrows on failure (a restore is an explicit user"},{"type":"text","text":" "},{"type":"text","text":"action, so the plugin keeps the prior state)."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"restorePurchases","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","text":"EntitlementSnapshot","kind":"typeIdentifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A restore is a write: its result is the account’s state as of its"},{"type":"text","text":" "},{"type":"text","text":"completion, newer than any read that resolved while it ran — even one"},{"type":"text","text":" "},{"type":"text","text":"that started later. So it is persisted like a stream event, superseding"},{"type":"text","text":" "},{"type":"text","text":"every read still in flight, rather than ordered by when it started."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two things outrank it: a base-stream event persisted after the restore"},{"type":"text","text":" "},{"type":"text","text":"began (the provider’s feed is at least as new), and "},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/clearCache()","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"(the restore began for an account the app has since signed out of)."},{"type":"text","text":" "},{"type":"text","text":"Either way it returns what the cache now holds, as a superseded read"},{"type":"text","text":" "},{"type":"text","text":"does, or throws if nothing usable is cached."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice\/restorepurchases()"]}],"metadata":{"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"restorePurchases","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","text":"EntitlementSnapshot","kind":"typeIdentifier"}],"title":"restorePurchases()","externalID":"s:13SwiduxPaywall09ResilientB7ServiceV16restorePurchasesAA19EntitlementSnapshotVyYaKF","modules":[{"name":"SwiduxPaywall"}],"role":"symbol"},"kind":"symbol","sections":[],"references":{"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService":{"abstract":[{"text":"Wraps a ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true,"type":"reference"},{"type":"text","text":" so a transient failure to read entitlements never"},{"text":" ","type":"text"},{"text":"presents a previously-seen paid user as free.","type":"text"}],"type":"topic","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","kind":"symbol","url":"\/documentation\/swid