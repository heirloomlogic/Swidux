{"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice\/restorepurchases()"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"restorePurchases"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/EntitlementSnapshot"}]}],"kind":"declarations"},{"content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"A restore is a write: its result is the account’s state as of its","type":"text"},{"text":" ","type":"text"},{"text":"completion, newer than any read that resolved while it ran — even one","type":"text"},{"text":" ","type":"text"},{"text":"that started later. So it is persisted like a stream event, superseding","type":"text"},{"text":" ","type":"text"},{"text":"every read still in flight, rather than ordered by when it started.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Two things outrank it: a base-stream event persisted after the restore","type":"text"},{"text":" ","type":"text"},{"text":"began (the provider’s feed is at least as new), and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/clearCache()"},{"text":" ","type":"text"},{"text":"(the restore began for an account the app has since signed out of).","type":"text"},{"text":" ","type":"text"},{"text":"Either way it returns what the cache now holds, as a superseded read","type":"text"},{"text":" ","type":"text"},{"text":"does, or throws if nothing usable is cached.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","metadata":{"modules":[{"name":"SwiduxPaywall"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"restorePurchases"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"externalID":"s:13SwiduxPaywall09ResilientB7ServiceV16restorePurchasesAA19EntitlementSnapshotVyYaKF","title":"restorePurchases()","symbolKind":"method","roleHeading":"Instance Method"},"abstract":[{"text":"Restores previously completed purchases, forwarding to the base service.","type":"text"},{"text":" ","type":"text"},{"text":"Persists on success; rethrows on failure (a restore is an explicit user","type":"text"},{"text":" ","type":"text"},{"text":"action, so the plugin keeps the prior state).","type":"text"}],"references":{"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/restorePurchases()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"restorePurchases"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","text":"EntitlementSnapshot"}],"title":"restorePurchases()","abstract":[{"type":"text","text":"Restores previously completed purchases, forwarding to the base service."},{"type":"text","text":" "},{"type":"text","text":"Persists on success; rethrows on failure (a restore is an explicit user"},{"type":"text","text":" "},{"type":"text","text":"action, so the plugin keeps the prior state)."}],"role":"symbol","type":"topic","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()","kind":"symbol","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/restorepurchases()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallService":{"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallService","kind":"identifier"}],"navigatorTitle":[{"text":"PaywallService","kind":"identifier"}],"title":"PaywallService","abstract":[{"text":"Provider-agnostic paywall service protocol.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","url":"\/documentation\/swiduxpaywall\/paywallservice"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"title":"ResilientPaywallService","abstract":[{"type":"text","text":"Wraps a "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true},{"type":"text","text":" so a transient failure to read entitlements never"},{"type":"text","text":" "},{"type":"text","text":"presents a previously-seen paid user as free."}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice"},"doc://SwiduxPaywall/documentation/SwiduxPaywall":{"title":"Swidux