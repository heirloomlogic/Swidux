pe":"text","text":" "},{"type":"text","text":"Persists on success; rethrows on failure (a restore is an explicit user"},{"type":"text","text":" "},{"type":"text","text":"action, so the plugin keeps the prior state)."}],"type":"topic","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/restorepurchases()","title":"restorePurchases()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"restorePurchases"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","kind":"typeIdentifier","text":"EntitlementSnapshot"}],"kind":"symbol","role":"symbol"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/clearCache()":{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/clearCache()","abstract":[{"type":"text","text":"Forgets the persisted last-known-good entitlement."}],"type":"topic","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/clearcache()","title":"clearCache()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clearCache"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"kind":"symbol","role":"symbol"}}}