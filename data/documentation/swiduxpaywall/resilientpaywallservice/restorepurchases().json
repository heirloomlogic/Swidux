{"abstract":[{"type":"text","text":"Restores previously completed purchases, forwarding to the base service."},{"type":"text","text":" "},{"type":"text","text":"Persists on success; rethrows on failure (a restore is an explicit user"},{"type":"text","text":" "},{"type":"text","text":"action, so the plugin keeps the prior state)."}],"sections":[],"metadata":{"externalID":"s:13SwiduxPaywall09ResilientB7ServiceV16restorePurchasesAA19EntitlementSnapshotVyYaKF","title":"restorePurchases()","roleHeading":"Instance Method","role":"symbol","modules":[{"name":"SwiduxPaywall"}],"symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"restorePurchases"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}]},"identifier":{"url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"restorePurchases","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/EntitlementSnapshot","text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"A restore is a write: its result is the account’s state as of its"},{"type":"text","text":" "},{"type":"text","text":"completion, newer than any read that resolved while it ran — even one"},{"type":"text","text":" "},{"type":"text","text":"that started later. So it is persisted like a stream event, superseding"},{"type":"text","text":" "},{"type":"text","text":"every read still in flight, rather than ordered by when it started."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two things outrank it: a base-stream event persisted after the restore"},{"type":"text","text":" "},{"type":"text","text":"began (the provider’s feed is at least as new), and "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/clearCache()","isActive":true},{"type":"text","text":" "},{"type":"text","text":"(the restore began for an account the app has since signed out of)."},{"type":"text","text":" "},{"type":"text","text":"Either way it returns what the cache now holds, as a superseded read"},{"type":"text","text":" "},{"type":"text","text":"does, or throws if nothing usable is cached."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice\/restorepurchases()"]}],"references":{"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService":{"abstract":[{"type":"text","text":"Wraps a "},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","type":"reference","isActive":true},{"type":"text","text":" so a transient failure to read entitlements never"},{"type":"text","text":" "},{"type":"text","text":"presents a previously-seen paid user as free."}],"title":"ResilientPaywallService","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","kind":"symbol","navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"url":"\/documentation\/swiduxpaywall\/resilientpaywallservice","type":"topic"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/EntitlementSnapshot":{"abstract":[{"type":"text","text":"Provider-agnostic snapshot of the user’s entitlement status."}],"title":"EntitlementSnapshot","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/EntitlementSnapshot","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"EntitlementSnapshot"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntitlementSnapshot"}],"url":"\/documentation\/swiduxpaywall\/entitlementsnapshot","type":"topic"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallService":{"abstract":[{"type":"text","text":"Provider-agnostic paywall service protocol."}],"url":"\/documentation\/swiduxpaywall\/paywallservice","type":"topic","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","title":"PaywallService","navigatorTitle":[{"kind":"identifier","text":"PaywallService"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallService"}],"kind":"symbol"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/clearCache()":{"abstract":[{"type":"text","text":"Forgets the persisted last-known-good entitlement."}],"title":"clearCache()","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/clearCache()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clearCache"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"url":"\/docum