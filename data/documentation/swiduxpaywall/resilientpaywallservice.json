{"abstract":[{"type":"text","text":"Wraps a "},{"isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","type":"reference"},{"type":"text","text":" so a transient failure to read entitlements never"},{"type":"text","text":" "},{"type":"text","text":"presents a previously-seen paid user as free."}],"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)"],"generated":true,"anchor":"Initializers"},{"title":"Instance Methods","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/clearCache()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()"],"generated":true,"anchor":"Instance-Methods"}],"sections":[],"metadata":{"externalID":"s:13SwiduxPaywall09ResilientB7ServiceV","title":"ResilientPaywallService","role":"symbol","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"ResilientPaywallService"}],"modules":[{"name":"SwiduxPaywall"}],"symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}]},"identifier":{"url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","isActive":true},{"type":"text","text":" populates "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","isActive":true},{"type":"text","text":" — and therefore the feature gate,"},{"type":"text","text":" "},{"type":"text","text":"account display, and whether the paywall sheet is shown — entirely from the"},{"type":"text","text":" "},{"type":"text","text":"snapshots its wrapped service emits. A slow, silent, or throwing entitlement"},{"type":"text","text":" "},{"type":"text","text":"read at cold launch leaves that state at its "},{"type":"codeVoice","code":"free"},{"type":"text","text":" default. This decorator"},{"type":"text","text":" "},{"type":"text","text":"keeps a persisted last-known-good so the gate never collapses to free on a"},{"type":"text","text":" "},{"type":"text","text":"transient failure, while the server remains the authoritative gate: a later"},{"type":"text","text":" "},{"type":"text","text":"live snapshot always overwrites the cache, so a genuine lapse is honoured."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The cache is bounded by "},{"type":"codeVoice","code":"maxCacheAge"},{"type":"text","text":" (72 hours by default): a stale cache"},{"type":"text","text":" "},{"type":"text","text":"stops vouching for "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" — subscriptions lapse, and an install that stays"},{"type":"text","text":" "},{"type":"text","text":"offline past the bound must not keep pro forever — but keeps"},{"type":"text","text":" "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":", because lifetime purchases don’t expire."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Provider-agnostic by construction — it speaks only "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true},{"type":"text","text":", so it"},{"type":"text","text":" "},{"type":"text","text":"wraps any base (simulated, RevenueCat, StoreKit, …). Feed the wrapped instance"},{"type":"text","text":" "},{"type":"text","text":"to "},{"inlineContent":[{"type":"text","text":"both"}],"type":"emphasis"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","isActive":true},{"type":"text","text":" and any app-side reader that builds a"},{"type":"text","text":" "},{"type":"text","text":"monetization\/context payload from entitlements."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Back the cache with "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" rather than "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"cache vouches for a paid entitlement offline, and "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" is a plist"},{"type":"text","text":" "},{"type":"text","text":"a user can edit or restore from a doctored backup, whereas the Keychain is"},{"type":"text","text":" "},{"type":"text","text":"encrypted and not plist-editable. (On unsigned macOS dev builds the Keychain"},{"type":"text","text":" "},{"type":"text","text":"can return "},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"type":"text","text":" \/ −34018 — see "},{"inlineContent":[{"type":"text","text":"Sandboxing &"},{"type":"text","text":" "},{"type":"text","text":"entitlements (macOS)"}],"type":"emphasis"},{"type":"text","text":" on "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true},{"type":"text","text":".)"}],"type":"paragraph"},{"code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")","\/\/ PaywallPlugin(..., service: resilient)   \/\/ gate + account display","\/\/ await resilient.currentSnapshot()        \/\/ server payload, off-main"],"type":"codeListing","syntax":"swift"},{"anchor":"Threat-model","type":"heading","level":2,"text":"Threat model"},{"inlineContent":[{"type":"text","text":"Backed by "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true},{"type":"text","text":", the cache defends against casual plist"},{"type":"text","text":" "},{"type":"text","text":"editing and a doctored-backup restore: the persisted last-known-good is"},{"type":"text","text":" "},{"type":"text","text":"encrypted and not a user-editable file. It does "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" defend against a"},{"type":"text","text":" "},{"type":"text","text":"jailbroken device — nothing client-side does; entitlements can always be"},{"type":"text","text":" "},{"type":"text","text":"forged on a device the attacker fully controls. The live provider stays"},{"type":"text","text":" "},{"type":"text","text":"authoritative whenever the app is online: any live snapshot overwrites the"},{"type":"text","text":" "},{"type":"text","text":"cache, so a genuine lapse or downgrade is honoured on the next successful"},{"type":"text","text":" "},{"type":"text","text":"read. "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" deliberately never expires — a lifetime purchase"},{"type":"text","text":" "},{"type":"text","text":"must keep working offline indefinitely."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The cache holds one entitlement, not one per account. An app with sign-in"},{"type":"text","text":" "},{"type":"text","text":"must call "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/clearCache()","isActive":true},{"type":"text","text":" on sign-out and account switch; otherwise the"},{"type":"text","text":" "},{"type":"text","text":"next user inherits the previous user’s entitlement whenever the live read"},{"type":"text","text":" "},{"type":"text","text":"fails."}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","doc:\/\/SwiduxPaywall\/s8SendableP","doc:\/\/SwiduxPaywall\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice"]}],"references":{"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/currentSnapshot()":{"abstract":[{"type":"text","text":"Non-throwing read for callers that always want a snapshot, degrading to"},{"type":"text","text":" "},{"type":"text","text":"free only for a genuinely-unknown user. Convenient for building a"},{"type":"text","text":" "},{"type":"text","text":"per-request monetization context off the main actor."}],"title":"currentSnapshot()","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"currentSnapshot"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","text":"EntitlementSnapshot"}],"type":"topic","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/currentsnapshot()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/clearCache()":{"abstract":[{"type":"text","text":"Forgets the persisted last-known-good entitlement."}],"title":"clearCache()","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/clearCache()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clearCache"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/clearcache()","type":"topic"},"doc://SwiduxPaywall/documentation/SwiduxPaywall":{"abstract":[],"url":"\/documentation\/swiduxpaywall","type":"topic","role":"collection","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall","title":"SwiduxPaywall","kind":"symbol"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/restorePurchases()":{"abstract":[{"type":"text","text":"Restores previously completed purchases, forwarding to the base service."},{"type":"text","text":" "},{"type":"text","text":"Persists on success; rethrows on failure (a restore is an explicit user"},{"type":"text","text":" "},{"type":"text","text":"action, so the plugin keeps the prior state)."}],"title":"restorePurchases()","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"restorePurchases"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","text":"EntitlementSnapshot"}],"type":"topic","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/restorepurchases()"},"doc://SwiduxPaywall/s8SendableP":{"identifier":"doc:\/\/SwiduxPaywall\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfo()":{"abstract":[{"type":"text","text":"Fetches the current entitlement status, retrying up to "},{"code":"maxAttempts","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"with exponential backoff. On success persists and returns; if every"},{"type":"text","text":" "},{"type":"text","text":"attempt fails, returns the cached last-known-good when present and"},{"type":"text","text":" "},{"type":"text","text":"usable, otherwise rethrows (so the plugin’s honest "},{"code":".refreshFailed","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"path is preserved for a genuinely-unknown user). Cancellation stops"},{"type":"text","text":" "},{"type":"text","text":"retrying immediately and falls through to the cache."}],"title":"customerInfo()","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerInfo"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","text":"EntitlementSnapshot"}],"type":"topic","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfo()"},"doc://SwiduxPaywall/s16SendableMetatypeP":{"identifier":"doc:\/\/SwiduxPaywall\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService":{"abstract":[{"type":"text","text":"Wraps a "},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","type":"reference","isActive":true},{"type":"text","text":" so a transient failure to read entitlements never"},{"type":"text","text":" "},{"type":"text","text":"presents a previously-seen paid user as free."}],"title":"ResilientPaywallService","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","kind":"symbol","navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"url":"\/documentation\/swiduxpaywall\/resilientpaywallservice","type":"topic"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfoStream()":{"abstract":[{"type":"text","text":"Long-lived stream of entitlement updates. Yields the persisted"},{"type":"text","text":" "},{"type":"text","text":"last-known-good first (when "},{"type":"codeVoice","code":"seedsFromCache"},{"type":"text","text":" is on and the cache is"},{"type":"text","text":" "},{"type":"text","text":"still usable), then forwards and persists every snapshot the base"},{"type":"text","text":" "},{"type":"text","text":"stream emits. The seed has source "},{"type":"codeVoice","code":".cacheSeed"},{"type":"text","text":", so it can bootstrap the"},{"type":"text","text":" "},{"type":"text","text":"plugin’s gate without superseding a pending or completed live read."}],"title":"customerInfoStream()","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerInfoStream"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:ScS","text":"AsyncStream"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","text":"EntitlementSnapshot"},{"kind":"text","text":">"}],"url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfostream()","type":"topic"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallPlugin":{"type":"topic","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallPlugin","kind":"identifier"}],"abstract":[{"text":"A Swidux plugin that manages paywall state and entitlement checking.","type":"text"}],"title":"PaywallPlugin","url":"\/documentation\/swiduxpaywall\/paywallplugin","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"PaywallPlugin","kind":"identifier"}]},"doc://Swidux/documentation/Swidux/KeychainKeyValueStore":{"abstract":[{"type":"text","text":"A "},{"code":"KeyValueStore","type":"codeVoice"},{"type":"text","text":" backed by the system Keychain."}],"title":"KeychainKeyValueStore","role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"KeychainKeyValueStore"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"KeychainKeyValueStore"}],"type":"topic","url":"\/documentation\/swidux\/keychainkeyvaluestore"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallState":{"abstract":[{"type":"text","text":"Current paywall state — entitlement status, sheet presentation, and async progress."}],"url":"\/documentation\/swiduxpaywall\/paywallstate","type":"topic","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","title":"PaywallState","navigatorTitle":[{"kind":"identifier","text":"PaywallState"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallState"}],"kind":"symbol"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallService":{"abstract":[{"type":"text","text":"Provider-agnostic paywall service protocol."}],"url":"\/documentation\/swiduxpaywall\/paywallservice","type":"topic","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","title":"PaywallService","navigatorTitle":[{"kind":"identifier","text":"PaywallService"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallService"}],"kind":"symbol"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)":{"abstract":[{"type":"text","text":"Creates a resilient decorator around "},{"code":"base","type":"codeVoice"},{"type":"text","text":", persisting last-known-good"},{"type":"text","text":" "},{"type":"text","text":"through "},{"code":"store","type":"codeVoice"},{"type":"text","text":"."}],"title":"init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)","kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"base"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall0B7ServiceP","text":"PaywallService"},{"kind":"text","text":", "},{"kind":"externalParam","text":"store"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Swidux13KeyValueStoreP","text":"KeyValueStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxAttempts"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"seedsFromCache"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxCacheAge"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":", "},{"kind":"externalParam","text":"retryBaseDelay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV","text":"Duration"},{"kind":"text","text":", "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DateV","text":"Date"},{"kind":"text","text":")"}],"type":"topic","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/init(base:store:maxattempts:seedsfromcache:maxcacheage:retrybasedelay:now:)"}}}