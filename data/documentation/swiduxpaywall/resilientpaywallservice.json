xt":"Creates a resilient decorator around "},{"type":"codeVoice","code":"base"},{"type":"text","text":", persisting last-known-good"},{"type":"text","text":" "},{"type":"text","text":"through "},{"type":"codeVoice","code":"store"},{"type":"text","text":"."}]},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallState":{"url":"\/documentation\/swiduxpaywall\/paywallstate","type":"topic","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","title":"PaywallState","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallState","kind":"identifier"}],"navigatorTitle":[{"text":"PaywallState","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Current paywall state — entitlement status, sheet presentation, and async progress."}]},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfo()":{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","type":"topic","title":"customerInfo()","abstract":[{"type":"text","text":"Fetches the current entitlement status, retrying up to "},{"type":"codeVoice","code":"maxAttempts"},{"type":"text","text":" "},{"type":"text","text":"with exponential backoff. On success persists and returns; if every"},{"type":"text","text":" "},{"type":"text","text":"attempt fails, returns the cached last-known-good when present and"},{"type":"text","text":" "},{"type":"text","text":"usable, otherwise rethrows (so the plugin’s honest "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" "},{"type":"text","text":"path is preserved for a genuinely-unknown user). Cancellation stops"},{"type":"text","text":" "},{"type":"text","text":"retrying immediately and falls through to the cache."}],"url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfo()","role":"symbol","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"t