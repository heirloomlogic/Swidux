{"schemaVersion":{"patch":0,"minor":3,"major":0},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","doc:\/\/SwiduxPaywall\/s8SendableP","doc:\/\/SwiduxPaywall\/s16SendableMetatypeP"]}],"hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall"]]},"abstract":[{"type":"text","text":"Wraps a "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true},{"type":"text","text":" so a transient failure to read entitlements never"},{"type":"text","text":" "},{"type":"text","text":"presents a previously-seen paid user as free."}],"kind":"symbol","variants":[{"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","interfaceLanguage":"swift"},"metadata":{"title":"ResilientPaywallService","roleHeading":"Structure","modules":[{"name":"SwiduxPaywall"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResilientPaywallService"}],"navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"symbolKind":"struct","role":"symbol","externalID":"s:13SwiduxPaywall09ResilientB7ServiceV"},"topicSections":[{"generated":true,"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)"]},{"generated":true,"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResilientPaywallService"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","isActive":true,"type":"reference"},{"text":" populates ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","isActive":true,"type":"reference"},{"text":" — and therefore the feature gate,","type":"text"},{"text":" ","type":"text"},{"text":"account display, and whether the paywall sheet is shown — entirely from the","type":"text"},{"text":" ","type":"text"},{"text":"snapshots its wrapped service emits. A slow, silent, or throwing entitlement","type":"text"},{"text":" ","type":"text"},{"text":"read at cold launch leaves that state at its ","type":"text"},{"code":"free","type":"codeVoice"},{"text":" default. This decorator","type":"text"},{"text":" ","type":"text"},{"text":"keeps a persisted last-known-good so the gate never collapses to free on a","type":"text"},{"text":" ","type":"text"},{"text":"transient failure, while the server remains the authoritative gate: a later","type":"text"},{"text":" ","type":"text"},{"text":"live snapshot always overwrites the cache, so a genuine lapse is honoured.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The cache is bounded by ","type":"text"},{"code":"maxCacheAge","type":"codeVoice"},{"text":" (72 hours by default): a stale cache","type":"text"},{"text":" ","type":"text"},{"text":"stops vouching for ","type":"text"},{"code":"isPro","type":"codeVoice"},{"text":" — subscriptions lapse, and an install that stays","type":"text"},{"text":" ","type":"text"},{"text":"offline past the bound must not keep pro forever — but keeps","type":"text"},{"text":" ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":", because lifetime purchases don’t expire.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Provider-agnostic by construction — it speaks only ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true,"type":"reference"},{"text":", so it","type":"text"},{"text":" ","type":"text"},{"text":"wraps any base (simulated, RevenueCat, StoreKit, …). Feed the wrapped instance","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"inlineContent":[{"text":"both","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","isActive":true,"type":"reference"},{"text":" and any app-side reader that builds a","type":"text"},{"text":" ","type":"text"},{"text":"monetization\/context payload from entitlements.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Back the cache with ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" rather than "},{"type":"codeVoice","code":"UserDefaults"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"cache vouches for a paid entitlement offline, and ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" is a plist","type":"text"},{"text":" ","type":"text"},{"text":"a user can edit or restore from a doctored backup, whereas the Keychain is","type":"text"},{"text":" ","type":"text"},{"text":"encrypted and not plist-editable. (On unsigned macOS dev builds the Keychain","type":"text"},{"type":"text","text":" "},{"text":"can return ","type":"text"},{"code":"errSecMissingEntitlement","type":"codeVoice"},{"text":" \/ −34018 — see ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Sandboxing &","type":"text"},{"type":"text","text":" "},{"type":"text","text":"entitlements (macOS)"}]},{"text":" on ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":".)","type":"text"}]},{"type":"codeListing","code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")","\/\/ PaywallPlugin(..., service: resilient)   \/\/ gate + account display","\/\/ await resilient.currentSnapshot()        \/\/ server payload, off-main"],"syntax":"swift"},{"text":"Threat model","level":2,"anchor":"Threat-model","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Backed by ","type":"text"},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"text":", the cache defends against casual plist","type":"text"},{"text":" ","type":"text"},{"text":"editing and a doctored-backup restore: the persisted last-known-good is","type":"text"},{"text":" ","type":"text"},{"text":"encrypted and not a user-editable file. It does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" defend against a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"jailbroken device — nothing client-side does; entitlements can always be"},{"text":" ","type":"text"},{"type":"text","text":"forged on a device the attacker fully controls. The live provider stays"},{"text":" ","type":"text"},{"type":"text","text":"authoritative whenever the app is online: any live snapshot overwrites the"},{"type":"text","text":" "},{"type":"text","text":"cache, so a genuine lapse or downgrade is honoured on the next successful"},{"type":"text","text":" "},{"type":"text","text":"read. "},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":" deliberately never expires — a lifetime purchase","type":"text"},{"text":" ","type":"text"},{"text":"must keep working offline indefinitely.","type":"text"}]}],"kind":"content"}],"sections":[],"