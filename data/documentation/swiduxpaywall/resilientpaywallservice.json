":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"type":"topic","title":"ResilientPaywallService","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfoStream()":{"kind":"symbol","abstract":[{"type":"text","text":"Long-lived stream of entitlement updates. Yields the persisted"},{"type":"text","text":" "},{"type":"text","text":"last-known-good first (when "},{"type":"codeVoice","code":"seedsFromCache"},{"type":"text","text":" is on and the cache is"},{"type":"text","text":" "},{"type":"text","text":"still usable), then forwards and persists every snapshot the base"},{"type":"text","text":" "},{"type":"text","text":"stream emits."}],"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerInfoStream","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"},{"text":">","kind":"text"}],"type":"topic","title":"customerInfoStream()","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfostream()"},"doc://SwiduxPaywall/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/SwiduxPaywall\/s16SendableMetatypeP"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfo()":{"abstract":[{"type":"text","text":"Fetches the current entitlement status, retrying up to "},{"type":"codeVoice","code":"maxAttempts"},{"type":"text","text":" "},{"type":"text","text":"with exponential backoff. On success persists and returns; if every"},{"type":"text","text":" "},{"type":"text","text":"attempt fails, returns the cached last-known-good when present and"},{"type":"text","text":" "},{"type":"text","text":"usable, otherwise rethrows (so the plugin’s honest "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" "},{"type":"text","text":"path is preserved for a genuinely-unknown user). Cancellation stops"},{"type":"text","text":" "},{"type":"text","text":"retrying immediately and falls through to the cache."}],"type":"topic","kind":"symbol","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfo()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerInfo"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","kind":"typeIdentifier","text":"EntitlementSnapshot"}],"title":"customerInfo()","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","role":"symbol"},"doc://SwiduxPaywall/documentation/SwiduxPaywall":{"abstract":[],"url":"\/documentation\/swiduxpaywall","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall","role":"collection","type":"topic","title":"SwiduxPaywall","kind":"symbol"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallService":{"kind":"symbol","abstract":[{"text":"Provider-agnostic paywall service protocol.","type":"text"}],"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallService","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"PaywallService"}],"type":"topic","title":"PaywallService","url":"\/documentation\/swiduxpaywall\/paywallservice"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/Resil