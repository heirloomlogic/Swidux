{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResilientPaywallService"}],"platforms":["macOS"]}]},{"content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","isActive":true,"type":"reference"},{"text":" populates ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","isActive":true,"type":"reference"},{"text":" — and therefore the feature gate,","type":"text"},{"text":" ","type":"text"},{"text":"account display, and whether the paywall sheet is shown — entirely from the","type":"text"},{"text":" ","type":"text"},{"text":"snapshots its wrapped service emits. A slow, silent, or throwing entitlement","type":"text"},{"text":" ","type":"text"},{"text":"read at cold launch leaves that state at its ","type":"text"},{"code":"free","type":"codeVoice"},{"text":" default. This decorator","type":"text"},{"type":"text","text":" "},{"type":"text","text":"keeps a persisted last-known-good so the gate never collapses to free on a"},{"type":"text","text":" "},{"type":"text","text":"transient failure, while the server remains the authoritative gate: a later"},{"type":"text","text":" "},{"type":"text","text":"live snapshot always overwrites the cache, so a genuine lapse is honoured."}]},{"inlineContent":[{"type":"text","text":"The cache is bounded by "},{"type":"codeVoice","code":"maxCacheAge"},{"type":"text","text":" (72 hours by default): a stale cache"},{"type":"text","text":" "},{"type":"text","text":"stops vouching for "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" — subscriptions lapse, and an install that stays"},{"type":"text","text":" "},{"type":"text","text":"offline past the bound must not keep pro forever — but keeps"},{"type":"text","text":" "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":", because lifetime purchases don’t expire."}],"type":"paragraph"},{"inlineContent":[{"text":"Provider-agnostic by construction — it speaks only ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true,"type":"reference"},{"text":", so it","type":"text"},{"text":" ","type":"text"},{"text":"wraps any base (simulated, RevenueCat, StoreKit, …). Feed the wrapped instance","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"both"}]},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","type":"reference","isActive":true},{"type":"text","text":" and any app-side reader that builds a"},{"type":"text","text":" "},{"type":"text","text":"monetization\/context payload from entitlements."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Back the cache with ","type":"text"},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"text":" rather than ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"cache vouches for a paid entitlement offline, and ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"text":" is a plist","type":"text"},{"text":" ","type":"text"},{"text":"a user can edit or restore from a doctored backup, whereas the Keychain is","type":"text"},{"text":" ","type":"text"},{"text":"encrypted and not plist-editable. (On unsigned macOS dev builds the Keychain","type":"text"},{"text":" ","type":"text"},{"text":"can return ","type":"text"},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"text":" \/ −34018 — see ","type":"text"},{"inlineContent":[{"text":"Sandboxing &","type":"text"},{"text":" ","type":"text"},{"text":"entitlements (macOS)","type":"text"}],"type":"emphasis"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"text":".)","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")","\/\/ PaywallPlugin(..., service: resilient)   \/\/ gate + account display","\/\/ await resilient.currentSnapshot()        \/\/ server payload, off-main"]},{"anchor":"Threat-model","text":"Threat model","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Backed by ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":", the cache defends against casual plist"},{"type":"text","text":" "},{"type":"text","text":"editing and a doctored-backup restore: the persisted last-known-good is"},{"type":"text","text":" "},{"type":"text","text":"encrypted and not a user-editable file. It does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" defend against a"},{"type":"text","text":" "},{"type":"text","text":"jailbroken device — nothing client-side does; entitlements can always be"},{"type":"text","text":" "},{"type":"text","text":"forged on a device the attacker fully controls. The live provider stays"},{"type":"text","text":" "},{"type":"text","text":"authoritative whenever the app is online: any live snapshot overwrites the"},{"type":"text","text":" "},{"type":"text","text":"cache, so a genuine lapse or downgrade is honoured on the next successful"},{"type":"text","text":" "},{"type":"text","text":"read. "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" deliberately never expires — a lifetime purchase"},{"type":"text","text":" "},{"type":"text","text":"must keep working offline indefinitely."}]}],"kind":"content"}],"kind":"symbol","identifier":{"url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"generated":true,"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)"]},{"generated":true,"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()"]}],"sections":[],"abstract":[{"type":"text","text":"Wraps a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService"},{"type":"text","text":" so a transient failure to read entitlements never"},{"type":"text","text":" "},{"type":"text","text":"presents a previously-seen paid user as free."}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","doc:\/\/SwiduxPaywall\/s8SendableP","doc:\/\/SwiduxPaywall\/s16SendableMetatypeP"]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice"]}],"metadata":{"title":"ResilientPaywallService","navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"modules":[{"name":"SwiduxPaywall"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"role":"symbol","symbolKind":"struct","externalID":"s:13SwiduxPaywall09ResilientB7ServiceV"},"references":{"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/currentSnapshot()":{"url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/currentsnapshot()","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"currentSnapshot","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"role":"symbol","title":"currentSnapshot()","abstract":[{"text":"Non-throwing read for callers that always want a snapshot, degrading to","type":"text"},{"text":" ","type":"text"},{"text":"free only for a genuinely-unknown user. Convenient for building a","type":"text"},{"text":" ","type":"text"},{"text":"per-request monetization context off the main actor.","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)":{"title":"init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)","kind":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"base","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"PaywallService","preciseIdentifier":"s:13SwiduxPaywall0B7ServiceP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"store","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"KeyValueStore","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux13KeyValueStoreP"},{"text":", ","kind":"text"},{"text":"maxAttempts","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"seedsFromCache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"maxCacheAge","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:s8DurationV","text":"Duration","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"retryBaseDelay","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Date","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DateV"},{"text":")","kind":"text"}],"role":"symbol","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/init(base:store:maxattempts:seedsfromcache:maxcacheage:retrybasedelay:now:)","abstract":[{"text":"Creates a resilient decorator around ","type":"text"},{"code":"base","type":"codeVoice"},{"text":", persisting last-known-good","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"type":"codeVoice","code":"store"},{"type":"text","text":"."}],"type":"topic"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallState":{"url":"\/documentation\/swiduxpaywall\/paywallstate","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallState"}],"role":"symbol","title":"PaywallState","abstract":[{"text":"Current paywall state — entitlement status, sheet presentation, and async progress.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"PaywallState"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallService":{"title":"PaywallService","navigatorTitle":[{"text":"PaywallService","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallService","kind":"identifier"}],"role":"symbol","abstract":[{"text":"Provider-agnostic paywall service protocol.","type":"text"}],"url":"\/documentation\/swiduxpaywall\/paywallservice","type":"topic"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService":{"url":"\/documentation\/swiduxpaywall\/resilientpaywallservice","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResilientPaywallService"}],"role":"symbol","title":"ResilientPaywallService","abstract":[{"text":"Wraps a ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true},{"text":" so a transient failure to read entitlements never","type":"text"},{"text":" ","type":"text"},{"text":"presents a previously-seen paid user as free.","type":"text"}],"navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfo()":{"type":"topic","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfo()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerInfo"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"role":"symbol","title":"customerInfo()","abstract":[{"type":"text","text":"Fetches the current entitlement status, retrying up to "},{"type":"codeVoice","code":"maxAttempts"},{"type":"text","text":" "},{"type":"text","text":"with exponential backoff. On success persists and returns; if every"},{"type":"text","text":" "},{"type":"text","text":"attempt fails, returns the cached last-known-good when present and"},{"type":"text","text":" "},{"type":"text","text":"usable, otherwise rethrows (so the plugin’s honest "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" "},{"type":"text","text":"path is preserved for a genuinely-unknown user). Cancellation stops"},{"type":"text","text":" "},{"type":"text","text":"retrying immediately and falls through to the cache."}],"kind":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/restorePurchases()":{"type":"topic","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/restorepurchases()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"restorePurchases","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"role":"symbol","title":"restorePurchases()","abstract":[{"text":"Restores previously completed purchases, forwarding to the base service.","type":"text"},{"text":" ","type":"text"},{"text":"Persists on success; rethrows on failure (a restore is an explicit user","type":"text"},{"text":" ","type":"text"},{"text":"action, so the plugin keeps the prior state).","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()"},"doc://SwiduxPaywall/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","type":"unresolvable","identifier":"doc:\/\/SwiduxPaywall\/s16SendableM