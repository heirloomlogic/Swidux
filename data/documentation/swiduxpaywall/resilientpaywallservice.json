paywall\/resilientpaywallservice\/customerinfostream()","abstract":[{"type":"text","text":"Long-lived stream of entitlement updates. Yields the persisted"},{"type":"text","text":" "},{"type":"text","text":"last-known-good first (when "},{"type":"codeVoice","code":"seedsFromCache"},{"type":"text","text":" is on and the cache is"},{"type":"text","text":" "},{"type":"text","text":"still usable), then forwards and persists every snapshot the base"},{"type":"text","text":" "},{"type":"text","text":"stream emits."}],"title":"customerInfoStream()","type":"topic"},"doc://SwiduxPaywall/s16SendableMetatypeP":{"identifier":"doc:\/\/SwiduxPaywall\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://SwiduxPaywall/s8SendableP":{"identifier":"doc:\/\/SwiduxPaywall\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"base"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:13SwiduxPaywall0B7ServiceP","kind":"typeIdentifier","text":"PaywallService"},{"kind":"text","text":", "},{"kind":"externalParam","text":"store"},{"kind":"text","text":": any "},{"preciseIdentifier":"s:6Swidux13KeyValueStoreP","kind":"typeIdentifier","text":"KeyValueStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxAttempts"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"seedsFromCache"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxCacheAge"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":", "}