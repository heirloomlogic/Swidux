fier","text":"Bool"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxCacheAge"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"retryBaseDelay"},{"kind":"text","text":": "},{"preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier","text":"Duration"},{"kind":"text","text":", "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","text":"Date","preciseIdentifier":"s:10Foundation4DateV"},{"kind":"text","text":")"}],"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/init(base:store:maxattempts:seedsfromcache:maxcacheage:retrybasedelay:now:)","type":"topic","kind":"symbol"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/restorePurchases()":{"abstract":[{"text":"Restores previously completed purchases, forwarding to the base service.","type":"text"},{"text":" ","type":"text"},{"text":"Persists on success; rethrows on failure (a restore is an explicit user","type":"text"},{"text":" ","type":"text"},{"text":"action, so the plugin keeps the prior state).","type":"text"}],"title":"restorePurchases()","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"restorePurchases"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","kind":"typeIdentifier","text":"EntitlementSnapshot"}],"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/restorepurchases(