{"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall"]]},"identifier":{"url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)"],"anchor":"Initializers","generated":true,"title":"Initializers"},{"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"}],"relationshipsSections":[{"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","doc:\/\/SwiduxPaywall\/s8SendableP","doc:\/\/SwiduxPaywall\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResilientPaywallService"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","type":"reference"},{"type":"text","text":" populates "},{"isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","type":"reference"},{"type":"text","text":" — and therefore the feature gate,"},{"type":"text","text":" "},{"type":"text","text":"account display, and whether the paywall sheet is shown — entirely from the"},{"type":"text","text":" "},{"type":"text","text":"snapshots its wrapped service emits. A slow, silent, or throwing entitlement"},{"type":"text","text":" "},{"type":"text","text":"read at cold launch leaves that state at its "},{"type":"codeVoice","code":"free"},{"type":"text","text":" default. This decorator"},{"type":"text","text":" "},{"type":"text","text":"keeps a persisted last-known-good so the gate never collapses to free on a"},{"type":"text","text":" "},{"type":"text","text":"transient failure, while the server remains the authoritative gate: a later"},{"type":"text","text":" "},{"type":"text","text":"live snapshot always overwrites the cache, so a genuine lapse is honoured."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cache is bounded by "},{"type":"codeVoice","code":"maxCacheAge"},{"type":"text","text":" (72 hours by default): a stale cache"},{"type":"text","text":" "},{"type":"text","text":"stops vouching for "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" — subscriptions lapse, and an install that stays"},{"type":"text","text":" "},{"type":"text","text":"offline past the bound must not keep pro forever — but keeps"},{"type":"text","text":" "},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":", because lifetime purchases don’t expire.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provider-agnostic by construction — it speaks only "},{"isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","type":"reference"},{"type":"text","text":", so it"},{"type":"text","text":" "},{"type":"text","text":"wraps any base (simulated, RevenueCat, StoreKit, …). Feed the wrapped instance"},{"type":"text","text":" "},{"type":"text","text":"to "},{"inlineContent":[{"text":"both","type":"text"}],"type":"emphasis"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","type":"reference"},{"type":"text","text":" and any app-side reader that builds a"},{"type":"text","text":" "},{"type":"text","text":"monetization\/context payload from entitlements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Back the cache with "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" rather than "},{"type":"codeVoice","code":"UserDefaults"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"cache vouches for a paid entitlement offline, and ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" is a plist"},{"text":" ","type":"text"},{"text":"a user can edit or restore from a doctored backup, whereas the Keychain is","type":"text"},{"text":" ","type":"text"},{"text":"encrypted and not plist-editable. (On unsigned macOS dev builds the Keychain","type":"text"},{"text":" ","type":"text"},{"text":"can return ","type":"text"},{"code":"errSecMissingEntitlement","type":"codeVoice"},{"type":"text","text":" \/ −34018 — see "},{"inlineContent":[{"text":"Sandboxing &","type":"text"},{"text":" ","type":"text"},{"text":"entitlements (macOS)","type":"text"}],"type":"emphasis"},{"text":" on ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":".)","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")","\/\/ PaywallPlugin(..., service: resilient)   \/\/ gate + account display","\/\/ await resilient.currentSnapshot()        \/\/ server payload, off-main"]},{"text":"Threat model","level":2,"anchor":"Threat-model","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Backed by ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":", the cache defends against casual plist","type":"text"},{"text":" ","type":"text"},{"text":"editing and a doctored-backup restore: the persisted last-known-good is","type":"text"},{"text":" ","type":"text"},{"text":"encrypted and not a user-editable file. It does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" defend against a","type":"text"},{"text":" ","type":"text"},{"text":"jailbroken device — nothing client-side does; entitlements can always be","type":"text"},{"text":" ","type":"text"},{"text":"forged on a device the attacker fully controls. The live provider stays","type":"text"},{"text":" ","type":"text"},{"text":"authoritative whenever the app is online: any live snapshot overwrites the","type":"text"},{"text":" ","type":"text"},{"text":"cache, so a genuine lapse or downgrade is honoured on the next successful","type":"text"},{"text":" ","type":"text"},{"text":"read. ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":" deliberately never expires — a lifetime purchase","type":"text"},{"text":" ","type":"text"},{"text":"must keep working offline indefinitely.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResilientPaywallService"}],"modules":[{"name":"SwiduxPaywall"}],"externalID":"s:13SwiduxPaywall09ResilientB7ServiceV","roleHeading":"Structure","role":"symbol","navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"symbolKind":"struct","title":"ResilientPaywallService"},"abstract":[{"text":"Wraps a ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","type":"reference","isActive":true},{"text":" so a transient failure to read entitlements never","type":"text"},{"text":" ","type":"text"},{"text":"presents a previously-seen paid user as free.","type":"text"}],"