{"kind":"symbol","schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService"},"hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall"]]},"abstract":[{"text":"Wraps a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","type":"reference"},{"text":" so a transient failure to read entitlements never","type":"text"},{"text":" ","type":"text"},{"text":"presents a previously-seen paid user as free.","type":"text"}],"metadata":{"externalID":"s:13SwiduxPaywall09ResilientB7ServiceV","role":"symbol","modules":[{"name":"SwiduxPaywall"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"symbolKind":"struct","navigatorTitle":[{"kind":"identifier","text":"ResilientPaywallService"}],"roleHeading":"Structure","title":"ResilientPaywallService"},"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)"],"generated":true},{"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/clearCache()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ResilientPaywallService"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","type":"reference"},{"type":"text","text":" populates "},{"isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","type":"reference"},{"type":"text","text":" — and therefore the feature gate,"},{"type":"text","text":" "},{"type":"text","text":"account display, and whether the paywall sheet is shown — entirely from the"},{"type":"text","text":" "},{"text":"snapshots its wrapped service emits. A slow, silent, or throwing entitlement","type":"text"},{"text":" ","type":"text"},{"text":"read at cold launch leaves that state at its ","type":"text"},{"type":"codeVoice","code":"free"},{"type":"text","text":" default. This decorator"},{"text":" ","type":"text"},{"text":"keeps a persisted last-known-good so the gate never collapses to free on a","type":"text"},{"text":" ","type":"text"},{"text":"transient failure, while the server remains the authoritative gate: a later","type":"text"},{"type":"text","text":" "},{"text":"live snapshot always overwrites the cache, so a genuine lapse is honoured.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The cache is bounded by "},{"type":"codeVoice","code":"maxCacheAge"},{"type":"text","text":" (72 hours by default): a stale cache"},{"type":"text","text":" "},{"type":"text","text":"stops vouching for "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" — subscriptions lapse, and an install that stays"},{"type":"text","text":" "},{"type":"text","text":"offline past the bound must not keep pro forever — but keeps"},{"type":"text","text":" "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":", because lifetime purchases don’t expire."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Provider-agnostic by construction — it speaks only "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true},{"type":"text","text":", so it"},{"type":"text","text":" "},{"type":"text","text":"wraps any base (simulated, RevenueCat, StoreKit, …). Feed the wrapped instance"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"both"}]},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","isActive":true},{"type":"text","text":" and any app-side reader that builds a"},{"type":"text","text":" "},{"type":"text","text":"monetization\/context payload from entitlements."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Back the cache with "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" rather than "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"cache vouches for a paid entitlement offline, and "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" is a plist"},{"type":"text","text":" "},{"type":"text","text":"a user can edit or restore from a doctored backup, whereas the Keychain is"},{"type":"text","text":" "},{"type":"text","text":"encrypted and not plist-editable. (On unsigned macOS dev builds the Keychain"},{"type":"text","text":" "},{"type":"text","text":"can return "},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"type":"text","text":" \/ −34018 — see "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Sandboxing &"},{"type":"text","text":" "},{"type":"text","text":"entitlements (macOS)"}]},{"type":"text","text":" on "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true},{"type":"text","text":".)"}],"type":"paragraph"},{"syntax":"swift","code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")","\/\/ PaywallPlugin(..., service: resilient)   \/\/ gate + account display","\/\/ await resilient.currentSnapshot()        \/\/ server payload, off-main"],"type":"codeListing"},{"level":2,"anchor":"Threat-model","text":"Threat model","type":"heading"},{"inlineContent":[{"type":"text","text":"Backed by "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true},{"type":"text","text":", the cache defends against casual plist"},{"type":"text","text":" "},{"type":"text","text":"editing and a doctored-backup restore: the persisted last-known-good is"},{"type":"text","text":" "},{"type":"text","text":"encrypted and not a user-editable file. It does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" defend against a"},{"type":"text","text":" "},{"type":"text","text":"jailbroken device — nothing client-side does; entitlements can always be"},{"type":"text","text":" "},{"type":"text","text":"forged on a device the attacker fully controls. The live provider stays"},{"type":"text","text":" "},{"type":"text","text":"authoritative whenever the app is online: any live snapshot overwrites the"},{"type":"text","text":" "},{"type":"text","text":"cache, so a genuine lapse or downgrade is honoured on the next successful"},{"type":"text","text":" "},{"type":"text","text":"read. "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" deliberately never expires — a lifetime purchase"},{"type":"text","text":" "},{"type":"text","text":"must keep working offline indefinitely."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The cache holds one entitlement, not one per account. An app with sign-in"},{"type":"text","text":" "},{"type":"text","text":"must call "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/clearCache()","isActive":true},{"type":"text","text":" on sign-out and account switch; otherwise the"},{"type":"text","text":" "},{"type":"text","text":"next user inherits the previous user’s entitlement whenever the live read"},{"type":"text","text":" "},{"type":"text","text":"fails."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"relationshipsSections":[{"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","doc:\/\/SwiduxPaywall\/s8SendableP","doc:\/\/SwiduxPaywall\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"references":{"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)":{"type":"topic","kind":"symbol","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/init(base:store:maxattempts:seedsfromcache:maxcacheage:retrybasedelay:now:)","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"base","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"PaywallService","preciseIdentifier":"s:13SwiduxPaywall0B7ServiceP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"store","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"KeyValueStore","preciseIdentifier":"s:6Swidux13KeyValueStoreP","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"maxAttempts","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","preciseIdentifier":"s:Si","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"seedsFromCache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"maxCacheAge","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"retryBaseDelay","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Duration","preciseIdentifier":"s:s8DurationV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"now","kind":"externalParam"},{"text":": () -> ","kind":"text"},{"text":"Date","preciseIdentifier":"s:10Foundation4DateV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"text":"Creates a resilient decorator around ","type":"text"},{"code":"base","type":"codeVoice"},{"text":", persisting last-known-good","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"code":"store","type":"codeVoice"},{"text":".","type":"text"}],"title":"init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallService":{"kind":"symbol","type":"topic","url":"\/documentation\/swiduxpaywall\/paywallservice","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallService"}],"abstract":[{"text":"Provider-agnostic paywall service protocol.","type":"text"}],"navigatorTitle":[{"text":"PaywallService","kind":"identifier"}],"title":"PaywallService"},"doc://Swidux/documentation/Swidux/KeychainKeyValueStore":{"type":"topic","kind":"symbol","url":"\/documentation\/swidux\/keychainkeyvaluestore","role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyValueStore","kind":"identifier"}],"abstract":[{"text":"A ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":" backed by the system Keychain.","type":"text"}],"navigatorTitle":[{"text":"KeychainKeyValueStore","kind":"identifier"}],"title":"KeychainKeyValueStore"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService":{"type":"topic","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"abstract":[{"text":"Wraps a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","type":"reference"},{"text":" so a transient failure to read entitlements never","type":"text"},{"text":" ","type":"text"},{"text":"presents a previously-seen paid user as free.","type":"text"}],"kind":"symbol","title":"ResilientPaywallService","navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}]},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallPlugin":{"type":"topic","kind":"symbol","url":"\/documentation\/swiduxpaywall\/paywallplugin","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallPlugin"}],"abstract":[{"text":"A Swidux plugin that manages paywall state and entitlement checking.","type":"text"}],"navigatorTitle":[{"kind":"identifier","text":"PaywallPlugin"}],"title":"PaywallPlugin"},"doc://SwiduxPaywall/documentation/SwiduxPaywall":{"type":"topic","url":"\/documentation\/swiduxpaywall","role":"collection","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall","abstract":[],"kind":"symbol","title":"SwiduxPaywall"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/currentSnapshot()":{"type":"topic","kind":"symbol","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/currentsnapshot()","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"currentSnapshot","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","kind":"typeIdentifier"}],"abstract":[{"text":"Non-throwing read for callers that always want a snapshot, degrading to","type":"text"},{"text":" ","type":"text"},{"text":"free only for a genuinely-unknown user. Convenient for building a","type":"text"},{"text":" ","type":"text"},{"text":"per-request monetization context off the main actor.","type":"text"}],"title":"currentSnapshot()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/clearCache()":{"type":"topic","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/clearcache()","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/clearCache()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearCache","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Forgets the persisted last-known-good entitlement."}],"kind":"symbol","title":"clearCache()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfoStream()":{"type":"topic","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfostream()","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerInfoStream","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AsyncStream","preciseIdentifier":"s:ScS","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","kind":"typeIdentifier"},{"text":">","kind":"text"}],"abstract":[{"text":"Long-lived stream of entitlement updates. Yields the persisted","type":"text"},{"text":" ","type":"text"},{"text":"last-known-good first (when ","type":"text"},{"code":"seedsFromCache","type":"codeVoice"},{"text":" is on and the cache is","type":"text"},{"text":" ","type":"text"},{"text":"still usable), then forwards and persists every snapshot the base","type":"text"},{"text":" ","type":"text"},{"text":"stream emits. The seed has source ","type":"text"},{"code":".cacheSeed","type":"codeVoice"},{"text":", so it can bootstrap the","type":"text"},{"text":" ","type":"text"},{"text":"plugin’s gate without superseding a pending or completed live read.","type":"text"}],"kind":"symbol","title":"customerInfoStream()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallState":{"type":"topic","url":"\/documentation\/swiduxpaywall\/paywallstate","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallState","kind":"identifier"}],"abstract":[{"type":"text","text":"Current paywall state — entitlement status, sheet presentation, and async progress."}],"kind":"symbol","title":"PaywallState","navigatorTitle":[{"text":"PaywallState","kind":"identifier"}]},"doc://SwiduxPaywall/s16SendableMetatypeP":{"identifier":"doc:\/\/SwiduxPaywall\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://SwiduxPaywall/s8SendableP":{"identifier":"doc:\/\/SwiduxPaywall\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/restorePurchases()":{"kind":"symbol","type":"topic","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/restorepurchases()","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"restorePurchases","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","text":"EntitlementSnapshot","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Restores previously completed purchases, forwarding to the base service."},{"type":"text","text":" "},{"type":"text","text":"Persists on success; rethrows on failure (a restore is an explicit user"},{"type":"text","text":" "},{"type":"text","text":"action, so the plugin keeps the prior state)."}],"title":"restorePurchases()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfo()":{"type":"topic","kind":"symbol","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfo()","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerInfo","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","kind":"typeIdentifier"}],"abstract":[{"text":"Fetches the current entitlement status, retrying up to ","type":"text"},{"code":"maxAttempts","type":"codeVoice"},{"text":" ","type":"text"},{"text":"with exponential backoff. On success persists and returns; if every","type":"text"},{"text":" ","type":"text"},{"text":"attempt fails, returns the cached last-known-good when present and","type":"text"},{"text":" ","type":"text"},{"text":"usable, otherwise rethrows (so the plugin’s honest ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" ","type":"text"},{"text":"path is preserved for a genuinely-unknown user). Cancellation stops","type":"text"},{"text":" ","type":"text"},{"text":"retrying immediately and falls through to the cache.","type":"text"}],"title":"customerInfo()"}}}