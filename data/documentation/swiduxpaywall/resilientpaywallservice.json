":"text","text":"attempt fails, returns the cached last-known-good when present and"},{"type":"text","text":" "},{"text":"usable, otherwise rethrows (so the plugin’s honest ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" ","type":"text"},{"text":"path is preserved for a genuinely-unknown user). Cancellation stops","type":"text"},{"text":" ","type":"text"},{"text":"retrying immediately and falls through to the cache.","type":"text"}],"type":"topic"},"doc://SwiduxPaywall/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/SwiduxPaywall\/s16SendableMetatypeP","type":"unresolvable"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService":{"role":"symbol","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","kind":"symbol","title":"ResilientPaywallService","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"abstract":[{"text":"Wraps a ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true,"type":"reference"},{"type":"text","text":" so a transient failure to read entitlements never"},{"text":" ","type":"text"},{"type":"text","text":"presents a previously-seen paid user as free."}],"type":"topic"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallPlugin":{"role":"symbol","url":"\/documentation\/swiduxpaywall\/paywallplugin","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","kind":"symbol","title":"PaywallPlugin","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallPlugin"}],"navigatorTitle":[{"kind":"identifier","text":"PaywallPlugin"}],"abstract":[{"text":"A Swidux plugin that manages paywall state