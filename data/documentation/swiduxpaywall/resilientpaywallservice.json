{"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)"],"anchor":"Initializers","generated":true},{"title":"Instance Methods","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()"],"anchor":"Instance-Methods","generated":true}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","doc:\/\/SwiduxPaywall\/s8SendableP","doc:\/\/SwiduxPaywall\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResilientPaywallService"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","isActive":true},{"type":"text","text":" populates "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","isActive":true},{"type":"text","text":" — and therefore the feature gate,"},{"type":"text","text":" "},{"type":"text","text":"account display, and whether the paywall sheet is shown — entirely from the"},{"type":"text","text":" "},{"type":"text","text":"snapshots its wrapped service emits. A slow, silent, or throwing entitlement"},{"type":"text","text":" "},{"type":"text","text":"read at cold launch leaves that state at its "},{"type":"codeVoice","code":"free"},{"type":"text","text":" default. This decorator"},{"type":"text","text":" "},{"type":"text","text":"keeps a persisted last-known-good so the gate never collapses to free on a"},{"type":"text","text":" "},{"type":"text","text":"transient failure, while the server remains the authoritative gate: a later"},{"type":"text","text":" "},{"type":"text","text":"live snapshot always overwrites the cache, so a genuine lapse is honoured."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cache is bounded by "},{"type":"codeVoice","code":"maxCacheAge"},{"type":"text","text":" (72 hours by default): a stale cache"},{"type":"text","text":" "},{"type":"text","text":"stops vouching for "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" — subscriptions lapse, and an install that stays"},{"type":"text","text":" "},{"type":"text","text":"offline past the bound must not keep pro forever — but keeps"},{"type":"text","text":" "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":", because lifetime purchases don’t expire."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provider-agnostic by construction — it speaks only "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true},{"type":"text","text":", so it"},{"type":"text","text":" "},{"type":"text","text":"wraps any base (simulated, RevenueCat, StoreKit, …). Feed the wrapped instance"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"emphasis","inlineContent":[{"text":"both","type":"text"}]},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","isActive":true},{"type":"text","text":" and any app-side reader that builds a"},{"type":"text","text":" "},{"type":"text","text":"monetization\/context payload from entitlements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Back the cache with "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" rather than "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"cache vouches for a paid entitlement offline, and "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" is a plist"},{"type":"text","text":" "},{"type":"text","text":"a user can edit or restore from a doctored backup, whereas the Keychain is"},{"type":"text","text":" "},{"type":"text","text":"encrypted and not plist-editable. (On unsigned macOS dev builds the Keychain"},{"type":"text","text":" "},{"type":"text","text":"can return "},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"type":"text","text":" \/ −34018 — see "},{"type":"emphasis","inlineContent":[{"text":"Sandboxing &","type":"text"},{"text":" ","type":"text"},{"text":"entitlements (macOS)","type":"text"}]},{"type":"text","text":" on "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":".)"}]},{"code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")","\/\/ PaywallPlugin(..., service: resilient)   \/\/ gate + account display","\/\/ await resilient.currentSnapshot()        \/\/ server payload, off-main"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Threat model","anchor":"Threat-model","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Backed by "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":", the cache defends against casual plist"},{"type":"text","text":" "},{"type":"text","text":"editing and a doctored-backup restore: the persisted last-known-good is"},{"type":"text","text":" "},{"type":"text","text":"encrypted and not a user-editable file. It does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" defend against a"},{"type":"text","text":" "},{"type":"text","text":"jailbroken device — nothing client-side does; entitlements can always be"},{"type":"text","text":" "},{"type":"text","text":"forged on a device the attacker fully controls. The live provider stays"},{"type":"text","text":" "},{"type":"text","text":"authoritative whenever the app is online: any live snapshot overwrites the"},{"type":"text","text":" "},{"type":"text","text":"cache, so a genuine lapse or downgrade is honoured on the next successful"},{"type":"text","text":" "},{"type":"text","text":"read. "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" deliberately never expires — a lifetime purchase"},{"type":"text","text":" "},{"type":"text","text":"must keep working offline indefinitely."}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService"},"metadata":{"externalID":"s:13SwiduxPaywall09ResilientB7ServiceV","modules":[{"name":"SwiduxPaywall"}],"roleHeading":"Structure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"title":"ResilientPaywallService","navigatorTitle":[{"kind":"identifier","text":"ResilientPaywallService"}],"role":"symbol","symbolKind":"struct"},"abstract":[{"type":"text","text":"Wraps a "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true},{"type":"text","text":" so a transient failure to read entitlements never"},{"type":"text","text":" "},{"type":"text","text":"presents a previously-seen paid user as free."}],"sections":[],"variants":[{"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/restorePurchases()":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"restorePurchases","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"title":"restorePurchases()","type":"topic","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/restorepurchases()","abstract":[{"text":"Restores previously completed purchases, forwarding to the base service.","type":"text"},{"text":" ","type":"text"},{"text":"Persists on success; rethrows on failure (a restore is an explicit user","type":"text"},{"text":" ","type":"text"},{"text":"action, so the plugin keeps the prior state).","type":"text"}],"role":"symbol"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)":{"kind":"symbol","fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"base"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall0B7ServiceP","text":"PaywallService"},{"kind":"text","text":", "},{"kind":"externalParam","text":"store"},{"kind":"text","text":": any "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Swidux13KeyValueStoreP","text":"KeyValueStore"},{"kind":"text","text":", "},{"kind":"externalParam","text":"maxAttempts"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":", "},{"kind":"externalParam","text":"seedsFromCache"},{"kind":"text","text":": "},{"kind":