{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice"]}],"topicSections":[{"title":"Initializers","generated":true,"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)"],"anchor":"Initializers"},{"title":"Instance Methods","generated":true,"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()"],"anchor":"Instance-Methods"}],"identifier":{"url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Wraps a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService"},{"type":"text","text":" so a transient failure to read entitlements never"},{"type":"text","text":" "},{"type":"text","text":"presents a previously-seen paid user as free."}],"relationshipsSections":[{"title":"Conforms To","kind":"relationships","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","doc:\/\/SwiduxPaywall\/s8SendableP","doc:\/\/SwiduxPaywall\/s16SendableMetatypeP"],"type":"conformsTo"}],"metadata":{"externalID":"s:13SwiduxPaywall09ResilientB7ServiceV","title":"ResilientPaywallService","modules":[{"name":"SwiduxPaywall"}],"roleHeading":"Structure","navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"role":"symbol"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ResilientPaywallService"}],"platforms":["macOS"]}]},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","type":"reference","isActive":true},{"type":"text","text":" populates "},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","type":"reference","isActive":true},{"type":"text","text":" — and therefore the feature gate,"},{"type":"text","text":" "},{"type":"text","text":"account display, and whether the paywall sheet is shown — entirely from the"},{"type":"text","text":" "},{"type":"text","text":"snapshots its wrapped service emits. A slow, silent, or throwing entitlement"},{"type":"text","text":" "},{"type":"text","text":"read at cold launch leaves that state at its "},{"code":"free","type":"codeVoice"},{"type":"text","text":" default. This decorator"},{"type":"text","text":" "},{"type":"text","text":"keeps a persisted last-known-good so the gate never collapses to free on a"},{"text":" ","type":"text"},{"text":"transient failure, while the server remains the authoritative gate: a later","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"live snapshot always overwrites the cache, so a genuine lapse is honoured."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cache is bounded by "},{"code":"maxCacheAge","type":"codeVoice"},{"text":" (72 hours by default): a stale cache","type":"text"},{"type":"text","text":" "},{"text":"stops vouching for ","type":"text"},{"code":"isPro","type":"codeVoice"},{"text":" — subscriptions lapse, and an install that stays","type":"text"},{"text":" ","type":"text"},{"text":"offline past the bound must not keep pro forever — but keeps","type":"text"},{"text":" ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":", because lifetime purchases don’t expire.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Provider-agnostic by construction — it speaks only ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","type":"reference","isActive":true},{"text":", so it","type":"text"},{"text":" ","type":"text"},{"text":"wraps any base (simulated, RevenueCat, StoreKit, …). Feed the wrapped instance","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"inlineContent":[{"type":"text","text":"both"}],"type":"emphasis"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","type":"reference","isActive":true},{"text":" and any app-side reader that builds a","type":"text"},{"text":" ","type":"text"},{"text":"monetization\/context payload from entitlements.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Back the cache with ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" rather than ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"cache vouches for a paid entitlement offline, and ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" is a plist","type":"text"},{"text":" ","type":"text"},{"text":"a user can edit or restore from a doctored backup, whereas the Keychain is","type":"text"},{"text":" ","type":"text"},{"text":"encrypted and not plist-editable. (On unsigned macOS dev builds the Keychain","type":"text"},{"text":" ","type":"text"},{"text":"can return ","type":"text"},{"code":"errSecMissingEntitlement","type":"codeVoice"},{"text":" \/ −34018 — see ","type":"text"},{"inlineContent":[{"type":"text","text":"Sandboxing &"},{"type":"text","text":" "},{"type":"text","text":"entitlements (macOS)"}],"type":"emphasis"},{"text":" on ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":".)","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")","\/\/ PaywallPlugin(..., service: resilient)   \/\/ gate + account display","\/\/ await resilient.currentSnapshot()        \/\/ server payload, off-main"]},{"type":"heading","text":"Threat model","level":2,"anchor":"Threat-model"},{"type":"paragraph","inlineContent":[{"text":"Backed by ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":", the cache defends against casual plist","type":"text"},{"text":" ","type":"text"},{"text":"editing and a doctored-backup restore: the persisted last-known-good is","type":"text"},{"text":" ","type":"text"},{"text":"encrypted and not a user-editable file. It does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" defend against a","type":"text"},{"text":" ","type":"text"},{"text":"jailbroken device — nothing client-side does; entitlements can always be","type":"text"},{"text":" ","type":"text"},{"text":"forged on a device the attacker fully controls. The live provider stays","type":"text"},{"text":" ","type":"text"},{"text":"authoritative whenever the app is online: any live snapshot overwrites the","type":"text"},{"text":" ","type":"text"},{"text":"cache, so a genuine lapse or downgrade is honoured on the next successful","type":"text"},{"text":" ","type":"text"},{"text":"read. ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":" deliberately never expires — a lifetime purchase","type":"text"},{"text":" ","type":"text"},{"text":"must keep working offline indefinitely.","type":"text"}]}],"kind":"content"}],"references":{"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallState":{"kind":"symbol","abstract":[{"type":"text","text":"Current paywall state — entitlement status, sheet presentation, and async progress."}],"url":"\/documentation\/swiduxpaywall\/paywallstate","type":"topic","title":"PaywallState","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","role":"symbol","navigatorTitle":[{"text":"PaywallState","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallState","kind":"identifier"}]},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallService":{"title":"PaywallService","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","abstract":[{"type":"text","text":"Provider-agnostic paywall service protocol."}],"kind":"symbol","navigatorTitle":[{"text":"PaywallService","kind":"identifier"}],"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"text":"PaywallService","kind":"identifier"}],"role":"symbol","url":"\/documentation\/swiduxpaywall\/paywallservice"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfo()":{"title":"customerInfo()","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","abstract":[{"type":"text","text":"Fetches the current entitlement status, retrying up to "},{"type":"codeVoice","code":"maxAttempts"},{"type":"text","text":" "},{"type":"text","text":"with exponential backoff. On success persists and returns; if every"},{"type":"text","text":" "},{"type":"text","text":"attempt fails, returns the cached last-known-good when present and"},{"type":"text","text":" "},{"type":"text","text":"usable, otherwise rethrows (so the plugin’s honest "},{"code":".refreshFailed","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"path is preserved for a genuinely-unknown user). Cancellation stops"},{"text":" ","type":"text"},{"text":"retrying immediately and falls through to the cache.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerInfo","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"role":"symbol","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfo()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfoStream()":{"title":"customerInfoStream()","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","abstract":[{"text":"Long-lived stream of entitlement updates. Yields the persisted","type":"text"},{"text":" ","type":"text"},{"text":"last-known-good first (when ","type":"text"},{"code":"seedsFromCache","type":"codeVoice"},{"text":" is on and the cache is","type":"text"},{"text":" ","type":"text"},{"text":"still usable), then forwards and persists every snapshot the base","type":"text"},{"text":" ","type":"text"},{"text":"stream emits.","type":"text"}],"kind":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerInfoStream","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"},{"text":">","kind":"text"}],"role":"symbol","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfostream()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallPlugin":{"title":"PaywallPlugin","identifier":"doc:\/\/SwiduxPaywall\/documentatio