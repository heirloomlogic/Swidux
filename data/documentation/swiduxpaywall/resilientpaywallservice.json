{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResilientPaywallService"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","isActive":true},{"type":"text","text":" populates "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","isActive":true},{"type":"text","text":" — and therefore the feature gate,"},{"type":"text","text":" "},{"type":"text","text":"account display, and whether the paywall sheet is shown — entirely from the"},{"type":"text","text":" "},{"type":"text","text":"snapshots its wrapped service emits. A slow, silent, or throwing entitlement"},{"type":"text","text":" "},{"type":"text","text":"read at cold launch leaves that state at its "},{"type":"codeVoice","code":"free"},{"type":"text","text":" default. This decorator"},{"type":"text","text":" "},{"type":"text","text":"keeps a persisted last-known-good so the gate never collapses to free on a"},{"type":"text","text":" "},{"type":"text","text":"transient failure, while the server remains the authoritative gate: a later"},{"type":"text","text":" "},{"type":"text","text":"live snapshot always overwrites the cache, so a genuine lapse is honoured."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cache is bounded by "},{"type":"codeVoice","code":"maxCacheAge"},{"type":"text","text":" (72 hours by default): a stale cache"},{"type":"text","text":" "},{"type":"text","text":"stops vouching for "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" — subscriptions lapse, and an install that stays"},{"type":"text","text":" "},{"type":"text","text":"offline past the bound must not keep pro forever — but keeps"},{"type":"text","text":" "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":", because lifetime purchases don’t expire."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provider-agnostic by construction — it speaks only "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true},{"type":"text","text":", so it"},{"type":"text","text":" "},{"type":"text","text":"wraps any base (simulated, RevenueCat, StoreKit, …). Feed the wrapped instance"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"emphasis","inlineContent":[{"text":"both","type":"text"}]},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","isActive":true},{"text":" and any app-side reader that builds a","type":"text"},{"text":" ","type":"text"},{"text":"monetization\/context payload from entitlements.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Back the cache with ","type":"text"},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"text":" rather than ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"cache vouches for a paid entitlement offline, and ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"text":" is a plist","type":"text"},{"text":" ","type":"text"},{"text":"a user can edit or restore from a doctored backup, whereas the Keychain is","type":"text"},{"text":" ","type":"text"},{"text":"encrypted and not plist-editable. (On unsigned macOS dev builds the Keychain","type":"text"},{"text":" ","type":"text"},{"text":"can return ","type":"text"},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"text":" \/ −34018 — see ","type":"text"},{"inlineContent":[{"type":"text","text":"Sandboxing &"},{"type":"text","text":" "},{"type":"text","text":"entitlements (macOS)"}],"type":"emphasis"},{"text":" on ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore"},{"type":"text","text":".)"}]},{"type":"codeListing","syntax":"swift","code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")","\/\/ PaywallPlugin(..., service: resilient)   \/\/ gate + account display","\/\/ await resilient.currentSnapshot()        \/\/ server payload, off-main"]},{"type":"heading","anchor":"Threat-model","level":2,"text":"Threat model"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Backed by "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","isActive":true},{"type":"text","text":", the cache defends against casual plist"},{"type":"text","text":" "},{"type":"text","text":"editing and a doctored-backup restore: the persisted last-known-good is"},{"type":"text","text":" "},{"type":"text","text":"encrypted and not a user-editable file. It does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" defend against a"},{"type":"text","text":" "},{"type":"text","text":"jailbroken device — nothing client-side does; entitlements can always be"},{"type":"text","text":" "},{"text":"forged on a device the attacker fully controls. The live provider stays","type":"text"},{"text":" ","type":"text"},{"text":"authoritative whenever the app is online: any live snapshot overwrites the","type":"text"},{"text":" ","type":"text"},{"text":"cache, so a genuine lapse or downgrade is honoured on the next successful","type":"text"},{"text":" ","type":"text"},{"text":"read. ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":" deliberately never expires — a lifetime purchase","type":"text"},{"text":" ","type":"text"},{"text":"must keep working offline indefinitely.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The cache holds one entitlement, not one per account. An app with sign-in","type":"text"},{"text":" ","type":"text"},{"text":"must call ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/clearCache()","type":"reference"},{"text":" on sign-out and account switch; otherwise the","type":"text"},{"text":" ","type":"text"},{"text":"next user inherits the previous user’s entitlement whenever the live read","type":"text"},{"text":" ","type":"text"},{"text":"fails.","type":"text"}]}]}],"variants":[{"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall"]]},"metadata":{"role":"symbol","modules":[{"name":"SwiduxPaywall"}],"symbolKind":"struct","externalID":"s:13SwiduxPaywall09ResilientB7ServiceV","roleHeading":"Structure","navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"title":"ResilientPaywallService","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResilientPaywallService"}]},"topicSections":[{"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)"],"anchor":"Initializers","title":"Initializers","generated":true},{"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/clearCache()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()"],"anchor":"Instance-Methods","title":"Instance Methods","generated":true}],"relationshipsSections":[{"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","doc:\/\/SwiduxPaywall\/s8SendableP","doc:\/\/SwiduxPaywall\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"abstract":[{"type":"text","text":"Wraps a "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true},{"type":"text","text":" so a transient failure to read entitlements never"},{"type":"text","text":" "},{"type":"text","text":"presents a previously-seen paid user as free."}],"references":{"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfoStream()":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerInfoStream","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"},{"text":">","kind":"text"}],"title":"customerInfoStream()","abstract":[{"type":"text","text":"Long-lived stream of entitlement updates. Yields the persisted"},{"type":"text","text":" "},{"type":"text","text":"last-known-good first (when "},{"type":"codeVoice","code":"seedsFromCache"},{"type":"text","text":" is on and the cache is"},{"type":"text","text":" "},{"type":"text","text":"still usable), then forwards and persists every snapshot the base"},{"type":"text","text":" "},{"type":"text","text":"stream emits. The seed has source "},{"type":"codeVoice","code":".cacheSeed"},{"type":"text","text":", so it can bootstrap the"},{"type":"text","text":" "},{"type":"text","text":"plugin’s gate without superseding a pending or completed live read."}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfostream()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallState":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallState"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","url":"\/documentation\/swiduxpaywall\/paywallstate","type":"topic","navigatorTitle":[{"kind":"identifier","text":"PaywallState"}],"title":"PaywallState","abstract":[{"type":"text","text":"Current paywall state — entitlement status, sheet presentation, and async progress."}]},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallPlugin":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallPlugin","kind":"identifier"}],"navigatorTitle":[{"text":"PaywallPlugin","kind":"identifier"}],"title":"PaywallPlugin","abstract":[{"text":"A Swidux plugin that manages paywall state and entitlement checking.","type":"text"}],"role":"symbol","type":"topic","kind":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","url":"\/documentation\/swiduxpaywall\/paywallplugin"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/currentSnapshot()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"currentSnapshot"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","text":"EntitlementSnapshot"}],"title":"currentSnapshot()","abstract":[{"type":"text","text":"Non-throwing read for callers that always want a snapshot, degrading to"},{"type":"text","text":" "},{"type":"text","text":"free only for a genuinely-unknown user. Convenient for building a"},{"type":"text","text":" "},{"type":"text","text":"per-request monetization context off the main actor."}],"role":"symbol","kind":"symbol","type":"topic","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/currentsnapshot()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/restorePurchases()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"restorePurchases"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","text":"EntitlementSnapshot"}],"title":"restorePurchases()","abstract":[{"type":"text","text":"Restores previously completed purchases, forwarding to the base service."},{"type":"text","text":" "},{"type":"text","text":"Persists on success; rethrows on failure (a restore is an explicit user"},{"type":"text","text":" "},{"type":"text","text":"action, so the plugin keeps the prior state)."}],"role":"symbol","type":"topic","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()","kind":"symbol","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/restorepurchases()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/clearCache()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"clearCache"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"title":"clearCache()","abstract":[{"type":"text","text":"Forgets the persisted last-known-good entitlement."}],"role":"symbol","type":"to