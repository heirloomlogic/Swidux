n success persists and returns; if every","type":"text"},{"text":" ","type":"text"},{"text":"attempt fails, returns the cached last-known-good when present and","type":"text"},{"text":" ","type":"text"},{"text":"usable, otherwise rethrows (so the plugin’s honest ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" ","type":"text"},{"text":"path is preserved for a genuinely-unknown user). Cancellation stops","type":"text"},{"text":" ","type":"text"},{"text":"retrying immediately and falls through to the cache.","type":"text"}],"title":"customerInfo()","type":"topic"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/currentSnapshot()":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"currentSnapshot"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","kind":"typeIdentifier","text":"EntitlementSnapshot"}],"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","role":"symbol","kind":"symbol","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/currentsnapshot()","abstract":[{"type":"text","text":"Non-throwing read for callers that always want a snapshot, degrading to"},{"type":"text","text":" "},{"type":"text","text":"free only for a genuinely-unknown user. Convenient for building a"},{"type":"text","text":" "},{"type":"text","text":"per-request monetization context off the main actor."}],"title":"currentSnapshot()","type":"topic"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallState":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallState","kind":"identifier"}],"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","role":"symbol","kind":"symbol","url":"\/documentation\/swiduxpaywall\/paywallstate","abstract":[{"type":"text","tex