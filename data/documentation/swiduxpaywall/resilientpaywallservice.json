{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin"},{"type":"text","text":" populates "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState"},{"type":"text","text":" — and therefore the feature gate,"},{"type":"text","text":" "},{"type":"text","text":"account display, and whether the paywall sheet is shown — entirely from the"},{"type":"text","text":" "},{"type":"text","text":"snapshots its wrapped service emits. A slow, silent, or throwing entitlement"},{"type":"text","text":" "},{"type":"text","text":"read at cold launch leaves that state at its "},{"type":"codeVoice","code":"free"},{"type":"text","text":" default. This decorator"},{"type":"text","text":" "},{"type":"text","text":"keeps a persisted last-known-good so the gate never collapses to free on a"},{"type":"text","text":" "},{"type":"text","text":"transient failure, while the server remains the authoritative gate: a later"},{"type":"text","text":" "},{"type":"text","text":"live snapshot always overwrites the cache, so a genuine lapse is honoured."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cache is bounded by "},{"type":"codeVoice","code":"maxCacheAge"},{"type":"text","text":" (72 hours by default): a stale cache"},{"type":"text","text":" "},{"type":"text","text":"stops vouching for "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" — subscriptions lapse, and an install that stays"},{"type":"text","text":" "},{"type":"text","text":"offline past the bound must not keep pro forever — but keeps"},{"type":"text","text":" "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":", because lifetime purchases don’t expire."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Provider-agnostic by construction — it speaks only "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService"},{"type":"text","text":", so it"},{"type":"text","text":" "},{"type":"text","text":"wraps any base (simulated, RevenueCat, StoreKit, …). Feed the wrapped instance"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"emphasis","inlineContent":[{"type":"text","text":"both"}]},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin"},{"type":"text","text":" and any app-side reader that builds a"},{"type":"text","text":" "},{"type":"text","text":"monetization\/context payload from entitlements."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Back the cache with "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" rather than "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"cache vouches for a paid entitlement offline, and "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" is a plist"},{"type":"text","text":" "},{"type":"text","text":"a user can edit or restore from a doctored backup, whereas the Keychain is"},{"type":"text","text":" "},{"type":"text","text":"encrypted and not plist-editable. (On unsigned macOS dev builds the Keychain"},{"type":"text","text":" "},{"type":"text","text":"can return "},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"type":"text","text":" \/ −34018 — see "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Sandboxing &"},{"type":"text","text":" "},{"type":"text","text":"entitlements (macOS)"}]},{"type":"text","text":" on "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":".)"}]},{"code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")","\/\/ PaywallPlugin(..., service: resilient)   \/\/ gate + account display","\/\/ await resilient.currentSnapshot()        \/\/ server payload, off-main"],"type":"codeListing","syntax":"swift"},{"text":"Threat model","type":"heading","level":2,"anchor":"Threat-model"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Backed by "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":", the cache defends against casual plist"},{"type":"text","text":" "},{"type":"text","text":"editing and a doctored-backup restore: the persisted last-known-good is"},{"type":"text","text":" "},{"type":"text","text":"encrypted and not a user-editable file. It does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" defend against a"},{"type":"text","text":" "},{"type":"text","text":"jailbroken device — nothing client-side does; entitlements can always be"},{"type":"text","text":" "},{"type":"text","text":"forged on a device the attacker fully controls. The live provider stays"},{"type":"text","text":" "},{"type":"text","text":"authoritative whenever the app is online: any live snapshot overwrites the"},{"type":"text","text":" "},{"type":"text","text":"cache, so a genuine lapse or downgrade is honoured on the next successful"},{"type":"text","text":" "},{"type":"text","text":"read. "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" deliberately never expires — a lifetime purchase"},{"type":"text","text":" "},{"type":"text","text":"must keep working offline indefinitely."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice"]}],"kind":"symbol","metadata":{"modules":[{"name":"SwiduxPaywall"}],"symbolKind":"struct","navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"roleHeading":"Structure","externalID":"s:13SwiduxPaywall09ResilientB7ServiceV","role":"symbol","title":"ResilientPaywallService"},"hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall"]]},"abstract":[{"text":"Wraps a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService"},{"text":" so a transient failure to read entitlements never","type":"text"},{"text":" ","type":"text"},{"text":"presents a previously-seen paid user as free.","type":"text"}],"identifier":{"url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"topicSections":[{"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","doc:\/\/SwiduxPaywall\/s8SendableP","doc:\/\/SwiduxPaywall\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"sections":[],"references":{"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallService":{"kind":"symbol","title":"PaywallService","url":"\/documentation\/swiduxpaywall\/paywallservice","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallService","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"PaywallService"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Provider-agnostic paywall service protocol."}]},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfo()":{"url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfo()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerInfo"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"type":"topic","abstract":[{"text":"Fetches the current entitlement status, retrying up to ","type":"text"},{"code":"maxAttempts","type":"codeVoice"},{"text":" ","type":"text"},{"text":"with exponential backoff. On success persists and returns; if every","type":"text"},{"text":" ","type":"text"},{"text":"attempt fails, returns the cached last-known-good when present and","type":"text"},{"text":" ","type":"text"},{"text":"usable, otherwise rethrows (so the plugin’s honest ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" ","type":"text"},{"text":"path is preserved for a genuinely-unknown user). Cancellation stops","type":"text"},{"text":" ","type":"text"},{"text":"retrying immediately and falls through to the cache.","type":"text"}],"role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","title":"customerInfo()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallPlugin":{"url":"\/documentation\/swiduxpaywall\/paywallplugin","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallPlugin"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"PaywallPlugin"}],"abstract":[{"type":"text","text":"A Swidux plugin that manages paywall state and entitlement checking."}],"role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","title":"PaywallPlugin"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallState":{"url":"\/documentation\/swiduxpaywall\/paywallstate","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallState"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"PaywallState"}],"abstract":[{"type":"text","text":"Current paywall state — entitlement status, sheet presentation, and async progress."}],"role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","title":"PaywallState"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/currentSnapshot()":{"url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/currentsnapshot()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"currentSnapshot"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"type":"topic","abstract":[{"text":"Non-throwing read for callers that always want a snapshot, degrading to","type":"text"},{"text":" ","type":"text"},{"text":"free only for a genuinely-unknown user. Convenient for building a","type":"text"},{"text":" ","type":"text"},{"text":"per-request monetization context off the main actor.","type":"text"}],"role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","title":"currentSnapshot()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService":{"url":"\/documentation\/swiduxpaywall\/resilientpaywallservice","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResilientPaywallService"}],"type":"topic","navigatorTitle":[{"kind":"identifier","text":"ResilientPaywallService"}],"abstract":[{"text":"Wraps a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService"},{"text":" so a transient failure to read entitlements never","type":"text"},{"text":" ","type":"text"},{"text":"presents a previously-seen paid user as free.","type":"text"}],"role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","title":"ResilientPaywallService"},"doc://SwiduxPaywall/documentation/SwiduxPaywall":{"kind":"symbol","title":"SwiduxPaywall","url":"\/documentation\/swiduxpaywall","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall","role":"collection","type":"topic","abstract":[]},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfoStream()":{"url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfostream()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerInfoStream"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"},{"kind":"text","text":">"}],"type":"topic","abstract":[{"text":"Long-lived stream of entitlement updates. Yields the persisted","type":"text"},{"text":" ","type":"text"},{"text":"last-known-good first (when ","type":"text"},{"code":"seedsFromCache","type":"codeVoice"},{"text":" is on and the cache is","type":"text"},{"text":" ","type":"text"},{"text":"still usable), then forwards and persists every snapshot the base","type":"text"},{"text":" ","type":"text"},{"text":"stream emits.","type":"text"}],"role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","title":"customerInfoStream()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/restorePurchases()":{"url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/restorepurchases()","kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"restorePurchases"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"type":"topic","abstract":[{"text":"Restores previously completed purchases, forwarding to the base service.","type":"text"},{"text":" ","type":"text"},{"text":"Persists on success; rethrows on failure (a restore is an explicit user","type":"text"},{"text":" ","type":"text"},{"text":"action, so the plugin keeps the prior state).","type":"text"}],"role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()","title":"restorePurchases()"},"doc://SwiduxPaywall/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/SwiduxPaywall\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://SwiduxPaywall/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/SwiduxPaywall\/s8SendableP","title":"Swift.Sendable"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/Resil