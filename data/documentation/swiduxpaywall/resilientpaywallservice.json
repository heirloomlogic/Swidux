{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","type":"reference","isActive":true},{"text":" populates ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","type":"reference","isActive":true},{"text":" — and therefore the feature gate,","type":"text"},{"text":" ","type":"text"},{"text":"account display, and whether the paywall sheet is shown — entirely from the","type":"text"},{"text":" ","type":"text"},{"text":"snapshots its wrapped service emits. A slow, silent, or throwing entitlement","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"read at cold launch leaves that state at its "},{"type":"codeVoice","code":"free"},{"type":"text","text":" default. This decorator"},{"type":"text","text":" "},{"type":"text","text":"keeps a persisted last-known-good so the gate never collapses to free on a"},{"type":"text","text":" "},{"type":"text","text":"transient failure, while the server remains the authoritative gate: a later"},{"type":"text","text":" "},{"type":"text","text":"live snapshot always overwrites the cache, so a genuine lapse is honoured."}],"type":"paragraph"},{"inlineContent":[{"text":"The cache is bounded by ","type":"text"},{"type":"codeVoice","code":"maxCacheAge"},{"text":" (72 hours by default): a stale cache","type":"text"},{"text":" ","type":"text"},{"text":"stops vouching for ","type":"text"},{"type":"codeVoice","code":"isPro"},{"text":" — subscriptions lapse, and an install that stays","type":"text"},{"text":" ","type":"text"},{"text":"offline past the bound must not keep pro forever — but keeps","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":", because lifetime purchases don’t expire.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Provider-agnostic by construction — it speaks only ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService"},{"text":", so it","type":"text"},{"text":" ","type":"text"},{"text":"wraps any base (simulated, RevenueCat, StoreKit, …). Feed the wrapped instance","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"both"}]},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin"},{"text":" and any app-side reader that builds a","type":"text"},{"text":" ","type":"text"},{"text":"monetization\/context payload from entitlements.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Back the cache with ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" rather than ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"cache vouches for a paid entitlement offline, and ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" is a plist","type":"text"},{"text":" ","type":"text"},{"text":"a user can edit or restore from a doctored backup, whereas the Keychain is","type":"text"},{"text":" ","type":"text"},{"text":"encrypted and not plist-editable. (On unsigned macOS dev builds the Keychain","type":"text"},{"text":" ","type":"text"},{"text":"can return ","type":"text"},{"code":"errSecMissingEntitlement","type":"codeVoice"},{"text":" \/ −34018 — see ","type":"text"},{"inlineContent":[{"type":"text","text":"Sandboxing &"},{"type":"text","text":" "},{"type":"text","text":"entitlements (macOS)"}],"type":"emphasis"},{"text":" on ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":".)","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")","\/\/ PaywallPlugin(..., service: resilient)   \/\/ gate + account display","\/\/ await resilient.currentSnapshot()        \/\/ server payload, off-main"]},{"type":"heading","level":2,"text":"Threat model","anchor":"Threat-model"},{"type":"paragraph","inlineContent":[{"text":"Backed by ","type":"text"},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"text":", the cache defends against casual plist","type":"text"},{"text":" ","type":"text"},{"text":"editing and a doctored-backup restore: the persisted last-known-good is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"encrypted and not a user-editable file. It does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" defend against a"},{"type":"text","text":" "},{"type":"text","text":"jailbroken device — nothing client-side does; entitlements can always be"},{"type":"text","text":" "},{"type":"text","text":"forged on a device the attacker fully controls. The live provider stays"},{"type":"text","text":" "},{"type":"text","text":"authoritative whenever the app is online: any live snapshot overwrites the"},{"type":"text","text":" "},{"type":"text","text":"cache, so a genuine lapse or downgrade is honoured on the next successful"},{"type":"text","text":" "},{"type":"text","text":"read. "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" deliberately never expires — a lifetime purchase"},{"type":"text","text":" "},{"type":"text","text":"must keep working offline indefinitely."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice"]}],"kind":"symbol","schemaVersion":{"pa