{"relationshipsSections":[{"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","doc:\/\/SwiduxPaywall\/s8SendableP","doc:\/\/SwiduxPaywall\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships","title":"Conforms To"}],"hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","metadata":{"role":"symbol","modules":[{"name":"SwiduxPaywall"}],"externalID":"s:13SwiduxPaywall09ResilientB7ServiceV","roleHeading":"Structure","title":"ResilientPaywallService","navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}]},"identifier":{"url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)"],"generated":true,"anchor":"Initializers","title":"Initializers"},{"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()"],"generated":true,"anchor":"Instance-Methods","title":"Instance Methods"}],"variants":[{"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Wraps a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService"},{"type":"text","text":" so a transient failure to read entitlements never"},{"type":"text","text":" "},{"type":"text","text":"presents a previously-seen paid user as free."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","type":"reference"},{"text":" populates ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","type":"reference"},{"text":" — and therefore the feature gate,","type":"text"},{"text":" ","type":"text"},{"text":"account display, and whether the paywall sheet is shown — entirely from the","type":"text"},{"text":" ","type":"text"},{"text":"snapshots its wrapped service emits. A slow, silent, or throwing entitlement","type":"text"},{"text":" ","type":"text"},{"text":"read at cold launch leaves that state at its ","type":"text"},{"code":"free","type":"codeVoice"},{"text":" default. This decorator","type":"text"},{"text":" ","type":"text"},{"text":"keeps a persisted last-known-good so the gate never collapses to free on a","type":"text"},{"text":" ","type":"text"},{"text":"transient failure, while the server remains the authoritative gate: a later","type":"text"},{"text":" ","type":"text"},{"text":"live snapshot always overwrites the cache, so a genuine lapse is honoured.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The cache is bounded by ","type":"text"},{"code":"maxCacheAge","type":"codeVoice"},{"text":" (72 hours by default): a stale cache","type":"text"},{"text":" ","type":"text"},{"text":"stops vouching for ","type":"text"},{"code":"isPro","type":"codeVoice"},{"text":" — subscriptions lapse, and an install that stays","type":"text"},{"type":"text","text":" "},{"type":"text","text":"offline past the bound must not keep pro forever — but keeps"},{"type":"text","text":" "},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":", because lifetime purchases don’t expire.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Provider-agnostic by construction — it speaks only ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true,"type":"reference"},{"text":", so it","type":"text"},{"text":" ","type":"text"},{"text":"wraps any base (simulated, RevenueCat, StoreKit, …). Feed the wrapped instance","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"both","type":"text"}]},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","isActive":true},{"type":"text","text":" and any app-side reader that builds a"},{"type":"text","text":" "},{"type":"text","text":"monetization\/context payload from entitlements."}]},{"type":"paragraph","inlineContent":[{"text":"Back the cache with ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"type":"text","text":" rather than "},{"code":"UserDefaults","type":"codeVoice"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"cache vouches for a paid entitlement offline, and "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" is a plist"},{"text":" ","type":"text"},{"text":"a user can edit or restore from a doctored backup, whereas the Keychain is","type":"text"},{"text":" ","type":"text"},{"text":"encrypted and not plist-editable. (On unsigned macOS dev builds the Keychain","type":"text"},{"type":"text","text":" "},{"type":"text","text":"can return "},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"type":"text","text":" \/ −34018 — see "},{"type":"emphasis","inlineContent":[{"text":"Sandboxing &","type":"text"},{"text":" ","type":"text"},{"text":"entitlements (macOS)","type":"text"}]},{"type":"text","text":" on "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":".)"}]},{"syntax":"swift","code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")","\/\/ PaywallPlugin(..., service: resilient)   \/\/ gate + account display","\/\/ await resilient.currentSnapshot()        \/\/ server payload, off-main"],"type":"codeListing"},{"level":2,"text":"Threat model","anchor":"Threat-model","type":"heading"},{"inlineContent":[{"text":"Backed by ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":", the cache defends against casual plist","type":"text"},{"text":" ","type":"text"},{"text":"editing and a doctored-backup restore: the persisted last-known-good is","type":"text"},{"text":" ","type":"text"},{"text":"encrypted and not a user-editable file. It does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" defend against a","type":"text"},{"text":" ","type":"text"},{"text":"jailbroken device — nothing client-side does; entitlements can always be","type":"text"},{"text":" ","type":"text"},{"text":"forged on a device the attacker fully controls. The live provider stays","type":"text"},{"text":" ","type":"text"},{"text":"authoritative whenever the app is online: any live snapshot overwrites the","type":"text"},{"text":" ","type":"text"},{"text":"cache, so a genuine lapse or downgrade is honoured on the next successful","type":"text"},{"text":" ","type":"text"},{"text":"read. ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":" deliberately never expires — a lifetime purchase","type":"text"},{"text":" ","type":"text"},{"text":"must keep working offline indefinitely.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"