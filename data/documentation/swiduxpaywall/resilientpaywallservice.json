dentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","text":"EntitlementSnapshot"}],"title":"customerInfo()","abstract":[{"type":"text","text":"Fetches the current entitlement status, retrying up to "},{"type":"codeVoice","code":"maxAttempts"},{"type":"text","text":" "},{"type":"text","text":"with exponential backoff. On success persists and returns; if every"},{"type":"text","text":" "},{"type":"text","text":"attempt fails, returns the cached last-known-good when present and"},{"type":"text","text":" "},{"type":"text","text":"usable, otherwise rethrows (so the plugin’s honest "},{"type":"codeVoice","code":".refreshFailed"},{"type":"text","text":" "},{"type":"text","text":"path is preserved for a genuinely-unknown user). Cancellation stops"},{"type":"text","text":" "},{"type":"text","text":"retrying immediately and falls through to the cache."}],"role":"symbol","type":"topic","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","kind":"symbol","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfo()"},"doc://Swidux/documentation/Swidux/KeychainKeyValueStore":{"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainKeyValueStore","kind":"identifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/KeychainKeyValueStore","url":"\/documentation\/swidux\/keychainkeyvaluestore","type":"topic","navigatorTitle":[{"kind":"identifier","text":"KeychainKeyValueStore"}],"title":"KeychainKeyValueStore","abstract":[{"text":"A ","type":"text"},{"code":"KeyValueStore","type":"codeVoice"},{"text":" backed by the system Keychain.","type":"text"}]},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)":{"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"base"},{"kind":"text","text":": an