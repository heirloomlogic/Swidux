{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"topicSections":[{"title":"Initializers","generated":true,"anchor":"Initializers","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)"]},{"title":"Instance Methods","generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()"]}],"metadata":{"navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"modules":[{"name":"SwiduxPaywall"}],"title":"ResilientPaywallService","roleHeading":"Structure","symbolKind":"struct","externalID":"s:13SwiduxPaywall09ResilientB7ServiceV"},"hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall"]]},"relationshipsSections":[{"title":"Conforms To","kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","doc:\/\/SwiduxPaywall\/s8SendableP","doc:\/\/SwiduxPaywall\/s16SendableMetatypeP"]}],"identifier":{"url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","interfaceLanguage":"swift"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","isActive":true,"type":"reference"},{"text":" populates ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","isActive":true,"type":"reference"},{"text":" — and therefore the feature gate,","type":"text"},{"text":" ","type":"text"},{"text":"account display, and whether the paywall sheet is shown — entirely from the","type":"text"},{"text":" ","type":"text"},{"text":"snapshots its wrapped service emits. A slow, silent, or throwing entitlement","type":"text"},{"text":" ","type":"text"},{"text":"read at cold launch leaves that state at its ","type":"text"},{"code":"free","type":"codeVoice"},{"text":" default. This decorator","type":"text"},{"text":" ","type":"text"},{"text":"keeps a persisted last-known-good so the gate never collapses to free on a","type":"text"},{"text":" ","type":"text"},{"text":"transient failure, while the server remains the authoritative gate: a later","type":"text"},{"text":" ","type":"text"},{"text":"live snapshot always overwrites the cache, so a genuine lapse is honoured.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The cache is bounded by ","type":"text"},{"code":"maxCacheAge","type":"codeVoice"},{"text":" (72 hours by default): a stale cache","type":"text"},{"text":" ","type":"text"},{"text":"stops vouching for ","type":"text"},{"code":"isPro","type":"codeVoice"},{"text":" — subscriptions lapse, and an install that stays","type":"text"},{"text":" ","type":"text"},{"text":"offline past the bound must not keep pro forever — but keeps","type":"text"},{"text":" ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":", because lifetime purchases don’t expire.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Provider-agnostic by construction — it speaks only ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true,"type":"reference"},{"text":", so it","type":"text"},{"text":" ","type":"text"},{"text":"wraps any base (simulated, RevenueCat, StoreKit, …). Feed the wrapped instance","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"inlineContent":[{"text":"both","type":"text"}],"type":"emphasis"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","isActive":true,"type":"reference"},{"text":" and any app-side reader that builds a","type":"text"},{"text":" ","type":"text"},{"text":"monetization\/context payload from entitlements.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Back the cache with ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":" rather than ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"cache vouches for a paid entitlement offline, and ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" is a plist","type":"text"},{"text":" ","type":"text"},{"text":"a user can edit or restore from a doctored backup, whereas the Keychain is","type":"text"},{"text":" ","type":"text"},{"text":"encrypted and not plist-editable. (On unsigned macOS dev builds the Keychain","type":"text"},{"text":" ","type":"text"},{"text":"can return ","type":"text"},{"code":"errSecMissingEntitlement","type":"codeVoice"},{"text":" \/ −34018 — see ","type":"text"},{"inlineContent":[{"text":"Sandboxing &","type":"text"},{"text":" ","type":"text"},{"text":"entitlements (macOS)","type":"text"}],"type":"emphasis"},{"text":" on ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":".)","type":"text"}],"type":"paragraph"},{"code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")","\/\/ PaywallPlugin(..., service: resilient)   \/\/ gate + account display","\/\/ await resilient.currentSnapshot()        \/\/ server payload, off-main"],"type":"codeListing","syntax":"swift"},{"anchor":"Threat-model","level":2,"text":"Threat model","type":"heading"},{"inlineContent":[{"text":"Backed by ","type":"text"},{"code":"KeychainKeyValueStore","type":"codeVoice"},{"text":", the cache defends against casual plist","type":"text"},{"text":" ","type":"text"},{"text":"editing and a doctored-backup restore: the persisted last-known-good is","type":"text"},{"text":" ","type":"text"},{"text":"encrypted and not a user-editable file. It does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" defend against a","type":"text"},{"text":" ","type":"text"},{"text":"jailbroken device — nothing client-side does; entitlements can always be","type":"text"},{"text":" ","type":"text"},{"text":"forged on a device the attacker fully controls. The live provider stays","type":"text"},{"text":" ","type":"text"},{"text":"authoritative whenever the app is online: any live snapshot overwrites the","type":"text"},{"text":" ","type":"text"},{"text":"cache, so a genuine lapse or downgrade is honoured on the next successful","type":"text"},{"text":" ","type":"text"},{"text":"read. ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":" deliberately never expires — a lifetime purchase","type":"text"},{"text":" ","type":"text"},{"text":"must keep working offline indefinitely.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice"]}],"abstract":[{"text":"Wraps a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService"},{"text":" so a transient failure to read entitlements never","type":"text"},{"text":" ","type":"text"},{"text":"presents a previously-seen paid user as free.","type":"text"}],"references":{"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfoStream()":{"title":"customerInfoStream()","type":"topic","abstract":[{"text":"Long-lived stream of entitlement updates. Yields the persisted","type":"text"},{"text":" ","type":"text"},{"text":"last-known-good first (when ","type":"text"},{"code":"seedsFromCache","type":"codeVoice"},{"text":" is on and the cache is","type":"text"},{"text":" ","type":"text"},{"text":"still usable), then forwards and persists every snapshot the base","type":"text"},{"text":" ","type":"text"},{"text":"stream emits.","type":"text"}],"url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfostream()","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerInfoStream","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"AsyncStream","kind":"typeIdentifier","preciseIdentifier":"s:ScS"},{"text":"<","kind":"text"},{"text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"},{"text":">","kind":"text"}],"kind":"symbol"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService":{"kind":"symbol","type":"topic","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice","abstract":[{"text":"Wraps a ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","type":"reference","isActive":true},{"text":" so a transient failure to read entitlements never","type":"text"},{"text":" ","type":"text"},{"text":"presents a previously-seen paid user as free.","type":"text"}],"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"title":"ResilientPaywallService"},"doc://SwiduxPaywall/s8SendableP":{"identifier":"doc:\/\/SwiduxPaywall\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/restorePurchases()":{"kind":"symbol","type":"topic","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/restorepurchases()","abstract":[{"text":"Restores previously completed purchases, forwarding to the base service.","type":"text"},{"text":" ","type":"text"},{"text":"Persists on success; rethrows on failure (a restore is an explicit user","type":"text"},{"text":" ","type":"text"},{"text":"action, so the plugin keeps the prior state).","type":"text"}],"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"restorePurchases","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","kind":"typeIdentifier"}],"title":"restorePurchases()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfo()":{"url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfo()","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"customerInfo","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"title":"customerInfo()","kind":"symbol","abstract":[{"text":"Fetches the current entitlement status, retrying up to ","type":"text"},{"code":"maxAttempts","type":"codeVoice"},{"text":" ","type":"text"},{"text":"with exponential backoff. On success persists and returns; if every","type":"text"},{"text":" ","type":"text"},{"text":"attempt fails, returns the cached last-known-good when present and","type":"text"},{"text":" ","type":"text"},{"text":"usable, otherwise rethrows (so the plugin’s honest ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" ","type":"text"},{"text":"path is preserved for a genuinely-unknown user). Cancellation stops","type":"text"},{"text":" ","type":"text"},{"text":"retrying immediately and falls through to the cache.","type":"text"}],"type":"topic"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallState":{"navigatorTitle":[{"text":"PaywallState","kind":"identifier"}],"url":"\/documentation\/swiduxpaywall\/paywallstate","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PaywallState","kind":"identifier"}],"title":"PaywallState","kind":"symbol","abstract":[{"text":"Current paywall state — entitlement status, sheet presentation, and async progress.","type":"text"}],"type":"topic"},"doc://SwiduxPaywall/documentation/SwiduxPaywall":{"kind":"symbol","type":"topic","url":"\/documentation\/swiduxpaywall","abstract":[],"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall","role":"collection","title":"SwiduxPaywall"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/currentSnapshot()":{"url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/currentsnapshot()","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","fragments":[{"text":"func","kind":"keyword"},{"te