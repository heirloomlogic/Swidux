{"hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall"]]},"kind":"symbol","metadata":{"role":"symbol","roleHeading":"Structure","symbolKind":"struct","externalID":"s:13SwiduxPaywall09ResilientB7ServiceV","modules":[{"name":"SwiduxPaywall"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResilientPaywallService"}],"navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"title":"ResilientPaywallService"},"identifier":{"url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","doc:\/\/SwiduxPaywall\/s8SendableP","doc:\/\/SwiduxPaywall\/s16SendableMetatypeP"]}],"topicSections":[{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)"]},{"anchor":"Instance-Methods","generated":true,"title":"Instance Methods","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()"]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResilientPaywallService"}],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Overview","anchor":"overview","level":2,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","type":"reference","isActive":true},{"type":"text","text":" populates "},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","type":"reference","isActive":true},{"type":"text","text":" — and therefore the feature gate,"},{"type":"text","text":" "},{"type":"text","text":"account display, and whether the paywall sheet is shown — entirely from the"},{"type":"text","text":" "},{"type":"text","text":"snapshots its wrapped service emits. A slow, silent, or throwing entitlement"},{"type":"text","text":" "},{"type":"text","text":"read at cold launch leaves that state at its "},{"type":"codeVoice","code":"free"},{"type":"text","text":" default. This decorator"},{"type":"text","text":" "},{"type":"text","text":"keeps a persisted last-known-good so the gate never collapses to free on a"},{"type":"text","text":" "},{"type":"text","text":"transient failure, while the server remains the authoritative gate: a later"},{"type":"text","text":" "},{"type":"text","text":"live snapshot always overwrites the cache, so a genuine lapse is honoured."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The cache is bounded by "},{"type":"codeVoice","code":"maxCacheAge"},{"type":"text","text":" (72 hours by default): a stale cache"},{"type":"text","text":" "},{"type":"text","text":"stops vouching for "},{"type":"codeVoice","code":"isPro"},{"type":"text","text":" — subscriptions lapse, and an install that stays"},{"type":"text","text":" "},{"type":"text","text":"offline past the bound must not keep pro forever — but keeps"},{"type":"text","text":" "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":", because lifetime purchases don’t expire."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Provider-agnostic by construction — it speaks only "},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","type":"reference","isActive":true},{"type":"text","text":", so it"},{"type":"text","text":" "},{"type":"text","text":"wraps any base (simulated, RevenueCat, StoreKit, …). Feed the wrapped instance"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"emphasis","inlineContent":[{"text":"both","type":"text"}]},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","type":"reference","isActive":true},{"type":"text","text":" and any app-side reader that builds a"},{"type":"text","text":" "},{"type":"text","text":"monetization\/context payload from entitlements."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Back the cache with "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":" rather than "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"cache vouches for a paid entitlement offline, and "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" is a plist"},{"type":"text","text":" "},{"type":"text","text":"a user can edit or restore from a doctored backup, whereas the Keychain is"},{"type":"text","text":" "},{"type":"text","text":"encrypted and not plist-editable. (On unsigned macOS dev builds the Keychain"},{"type":"text","text":" "},{"type":"text","text":"can return "},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"type":"text","text":" \/ −34018 — see "},{"type":"emphasis","inlineContent":[{"text":"Sandboxing &","type":"text"},{"text":" ","type":"text"},{"text":"entitlements (macOS)","type":"text"}]},{"type":"text","text":" on "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":".)"}],"type":"paragraph"},{"code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")","\/\/ PaywallPlugin(..., service: resilient)   \/\/ gate + account display","\/\/ await resilient.currentSnapshot()        \/\/ server payload, off-main"],"syntax":"swift","type":"codeListing"},{"text":"Threat model","anchor":"Threat-model","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Backed by "},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":", the cache defends against casual plist"},{"type":"text","text":" "},{"type":"text","text":"editing and a doctored-backup restore: the persisted last-known-good is"},{"type":"text","text":" "},{"type":"text","text":"encrypted and not a user-editable file. It does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" defend against a"},{"type":"text","text":" "},{"type":"text","text":"jailbroken device — nothing client-side does; entitlements can always be"},{"type":"text","text":" "},{"type":"text","text":"forged on a device the attacker fully controls. The live provider stays"},{"type":"text","text":" "},{"type":"text","text":"authoritative whenever the app is online: any live snapshot overwrites the"},{"type":"text","text":" "},{"type":"text","text":"cache, so a genuine lapse or downgrade is honoured on the next successful"},{"type":"text","text":" "},{"type":"text","text":"read. "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" deliberately never expires — a lifetime purchase"},{"type":"text","text":" "},{"type":"text","text":"must keep working offline indefinitely."}],"type":"paragraph"}]}],"abstract":[{"text":"Wraps a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","type":"reference"},{"text":" so a transient failure to read entitlements never","type":"text"},{"text":" ","type":"text"},{"text":"presents a previously-seen paid user as free.","type":"text"}],"references":{"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallState":{"abstract":[{"text":"Current paywall state — entitlement status, sheet presentation, and async progress.","type":"text"}],"kind":"symbol","url":"\/documentation\/swiduxpaywall\/paywallstate","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallState"}],"navigatorTitle":[{"kind":"identifier","text":"PaywallState"}],"title":"PaywallState"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfo()":{"abstract":[{"text":"Fetches the current entitlement status, retrying up to ","type":"text"},{"code":"maxAttempts","type":"codeVoice"},{"text":" ","type":"text"},{"text":"with exponential backoff. On success persists and returns; if every","type":"text"},{"text":" ","type":"text"},{"text":"attempt fails, returns the cached last-known-good when present and","type":"text"},{"text":" ","type":"text"},{"text":"usable, otherwise rethrows (so the plugin’s honest ","type":"text"},{"code":".refreshFailed","type":"codeVoice"},{"text":" ","type":"text"},{"text":"path is preserved for a genuinely-unknown user). Cancellation stops","type":"text"},{"text":" ","type":"text"},{"text":"retrying immediately and falls through to the cache.","type":"text"}],"kind":"symbol","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfo()","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerInfo"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"title":"customerInfo()"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)":{"type":"topic","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/init(base:store:maxattempts:seedsfromcache:maxcacheage:retrybasedelay:now:)","abstract":[{"text":"Creates a resilient decorator around ","type":"text"},{"code":"base","type":"codeVoice"},{"text":", persisting last-known-good","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"type":"codeVoice","code":"store"},{"type":"text","text":"."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)","fragments":[{"text":"init","kind":"identifier"},{"text":"(","kind":"text"},{"text":"base","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"PaywallService","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall0B7ServiceP"},{"text":", ","kind":"text"},{"text":"store","kind":"externalParam"},{"text":": any ","kind":"text"},{"text":"KeyValueStore","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux13KeyValueStoreP"},{"text":", ","kind":"text"},{"text":"maxAttempts","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":", ","kind":"text"},{"text":"seedsFromCache","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", ","kind":"text"},{"text":"maxCacheAge","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Duration","kind":"typeIdentifier","preciseIdentifier":"s:s8DurationV"},{"text":", ","kind":"text"},{"kind":"externalParam","text":"retryBaseDelay"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Duration","preciseIdentifier":"s:s8DurationV"},{"kind":"text","text":", "},{"kind":"externalParam","text":"now"},{"kind":"text","text":": () -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DateV","text":"Date"},{"kind":"text","text":")"}],"title":"init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService":{"type":"topic","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice","navigatorTitle":[{"kind":"identifier","text":"ResilientPaywallService"}],"abstract":[{"text":"Wraps a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","type":"reference"},{"text":" so a transient failure to read entitlements never","type":"text"},{"text":" ","type":"text"},{"text":"presents a previously-seen paid user as free.","type":"text"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ResilientPaywallService"}],"title":"ResilientPaywallService"},"doc://SwiduxPaywall/s8SendableP":{"identifier":"doc:\/\/SwiduxPaywall\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://SwiduxPaywall/s16SendableMetatypeP":{"title":"Swift.SendableMetatype","identifier":"doc:\/\/SwiduxPaywall\/s16SendableMetatypeP","type":"unresolvable"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfoStream()":{"title":"customerInfoStream()","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfostream()","abstract":[{"type":"text","text":"Long-lived stream of entitlement updates. Yields the persisted"},{"type":"text","text":" "},{"type":"text","text":"last-known-good first (when "},{"type":"codeVoice","code":"seedsFromCache"},{"type":"text","text":" is on and the cache is"},{"type":"text","text":" "},{"type":"text","text":"still usable), then forwards and persists every snapshot the base"},{"type":"text","text":" "},{"type":"text","text":"stream emits."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerInfoStream"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","text":"AsyncStream","preciseIdentifier":"s:ScS"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"},{"kind":"text","text":">"}],"type":"topic"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/currentSnapshot()":{"title":"currentSnapshot()","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/currentsnapshot()","abstract":[{"type":"text","text":"Non-throwing read for callers that always want a snapshot, degrading to"},{"type":"text","text":" "},{"type":"text","text":"free only for a genuinely-unknown user. Convenient for building a"},{"type":"text","text":" "},{"type":"text","text":"per-request monetization context off the main actor."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"currentSnapshot"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"type":"topic"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/restorePurchases()":{"title":"restorePurchases()","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/restorepurchases()","abstract":[{"type":"text","text":"Restores previously completed purchases, forwarding to the base service."},{"type":"text","text":" "},{"type":"text","text":"Persists on success; rethrows on failure (a restore is an explicit user"},{"type":"text","text":" "},{"type":"text","text":"action, so the plugin keeps the prior state)."}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"restorePurchases"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","text":"EntitlementSnapshot","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"type":"topic"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallPlugin":{"abstract":[{"type":"text","text":"A Swidux plugin that manages paywall state and entitlement checking."}],"kind":"symbol","url":"\/documentation\/swiduxpaywall\/paywallplugin","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallPlugin"}],"navigatorTitle":[{"kind":"identifier","text":"PaywallPlugin"}],"title":"PaywallPlugin"},"doc://SwiduxPaywall/documentation/SwiduxPaywall":{"abstract":[],"kind":"symbol","url":"\/documentation\/swiduxpaywall","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall","role":"collection","type":"topic","title":"SwiduxPaywall"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallService":{"abstract":[{"type":"text","text":"Provider-agnostic paywall service protocol."}],"kind":"symbol","url":"\/documentation\/swiduxpaywall\/paywallservice","identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","role":"symbol","type":"topic","fragments":[{"kind":"