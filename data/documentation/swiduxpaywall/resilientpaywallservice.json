presents a previously-seen paid user as free."}],"role":"symbol","type":"topic","title":"ResilientPaywallService","kind":"symbol"},"doc://SwiduxPaywall/documentation/SwiduxPaywall":{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall","title":"SwiduxPaywall","kind":"symbol","role":"collection","type":"topic","abstract":[],"url":"\/documentation\/swiduxpaywall"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/customerInfo()":{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/customerinfo()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"customerInfo"},{"kind":"text","text":"() "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV","kind":"typeIdentifier","text":"EntitlementSnapshot"}],"abstract":[{"text":"Fetches the current entitlement status, retrying up to ","type":"text"},{"type":"codeVoice","code":"maxAttempts"},{"text":" ","type":"text"},{"text":"with exponential backoff. On success persists and returns; if every","type":"text"},{"text":" ","type":"text"},{"text":"attempt fails, returns the cached last-known-good when present and","type":"text"},{"text":" ","type":"text"},{"text":"usable, otherwise rethrows (so the plugin’s honest ","type":"text"},{"type":"codeVoice","code":".refreshFailed"},{"text":" ","type":"text"},{"text":"path is preserved for a genuinely-unknown user). Cancellation stops","type":"text"},{"text":" ","type":"text"},{"text":"retrying immediately and falls through to the cache.","type":"text"}],"role":"symbol","type":"topic","title":"customerInfo()","kind":"symbol"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallState":{"abstract":[{"text":"Current paywall state — entitlement status, sheet presentation, and async progress.","type":"text"}],"title":"PaywallState","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PaywallState"}],"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","url":"\/documentation\/swiduxpaywall\/paywallstate","type":"topic","navigatorTitle":[{"kind":"identifier","text":"PaywallState"}],"kind":"symbol"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/ResilientPaywallService/currentSnapshot()":{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","title":"currentSnapshot()","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"currentSnapshot","kind":"identifier"},{"text":"() ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" -> ","kind":"text"},{"text":"EntitlementSnapshot","kind":"typeIdentifier","preciseIdentifier":"s:13SwiduxPaywall19EntitlementSnapshotV"}],"role":"symbol","type":"topic","abstract":[{"text":"Non-throwing read for callers that always want a snapshot, degrading to","type":"text"},{"text":" ","type":"text"},{"text":"free only for a genuinely-unknown user. Convenient for building a","type":"text"},{"text":" ","type":"text"},{"text":"per-request monetization context off the main actor.","type":"text"}],"url":"\/documentation\/swiduxpaywall\/resilientpaywallservice\/currentsnapshot()"},"doc://SwiduxPaywall/s16SendableMetatypeP":{"identifier":"doc:\/\/SwiduxPaywall\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"},"doc://SwiduxPaywall/documentation/SwiduxPaywall/PaywallPlugin":{"navigatorTitle":[{"kind":"identifier","text":"PaywallPlugin"}],"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","url":"\/documentation\/swiduxpaywall\/paywallplugin","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Pay