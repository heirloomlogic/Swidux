pted and not a user-editable file. It does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" defend against a","type":"text"},{"text":" ","type":"text"},{"text":"jailbroken device — nothing client-side does; entitlements can always be","type":"text"},{"text":" ","type":"text"},{"text":"forged on a device the attacker fully controls. The live provider stays","type":"text"},{"text":" ","type":"text"},{"text":"authoritative whenever the app is online: any live snapshot overwrites the","type":"text"},{"text":" ","type":"text"},{"text":"cache, so a genuine lapse or downgrade is honoured on the next successful","type":"text"},{"text":" ","type":"text"},{"text":"read. ","type":"text"},{"code":"hasPermanentLicense","type":"codeVoice"},{"text":" deliberately never expires — a lifetime purchase","type":"text"},{"text":" ","type":"text"},{"text":"must keep working offline indefinitely.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall"]]},"metadata":{"role":"symbol","externalID":"s:13SwiduxPaywall09ResilientB7ServiceV","symbolKind":"struct","roleHeading":"Structure","navigatorTitle":[{"text":"ResilientPaywallService","kind":"identifier"}],"modules":[{"name":"SwiduxPaywall"}],"title":"ResilientPaywallService","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}]},"relationshipsSections":[{"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","doc:\/\/SwiduxPaywall\/s8SendableP","doc:\/\/SwiduxPaywall\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice"]}],"