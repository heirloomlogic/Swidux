{"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"url":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService","interfaceLanguage":"swift"},"sections":[],"topicSections":[{"generated":true,"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/init(base:store:maxAttempts:seedsFromCache:maxCacheAge:retryBaseDelay:now:)"],"anchor":"Initializers","title":"Initializers"},{"generated":true,"identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/currentSnapshot()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfo()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/customerInfoStream()","doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/ResilientPaywallService\/restorePurchases()"],"anchor":"Instance-Methods","title":"Instance Methods"}],"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","doc:\/\/SwiduxPaywall\/s8SendableP","doc:\/\/SwiduxPaywall\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}]}]},{"content":[{"anchor":"overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","isActive":true,"type":"reference"},{"text":" populates ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallState","isActive":true,"type":"reference"},{"text":" — and therefore the feature gate,","type":"text"},{"text":" ","type":"text"},{"text":"account display, and whether the paywall sheet is shown — entirely from the","type":"text"},{"text":" ","type":"text"},{"text":"snapshots its wrapped service emits. A slow, silent, or throwing entitlement","type":"text"},{"text":" ","type":"text"},{"text":"read at cold launch leaves that state at its ","type":"text"},{"type":"codeVoice","code":"free"},{"text":" default. This decorator","type":"text"},{"text":" ","type":"text"},{"text":"keeps a persisted last-known-good so the gate never collapses to free on a","type":"text"},{"text":" ","type":"text"},{"text":"transient failure, while the server remains the authoritative gate: a later","type":"text"},{"text":" ","type":"text"},{"text":"live snapshot always overwrites the cache, so a genuine lapse is honoured.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The cache is bounded by ","type":"text"},{"type":"codeVoice","code":"maxCacheAge"},{"text":" (72 hours by default): a stale cache","type":"text"},{"text":" ","type":"text"},{"text":"stops vouching for ","type":"text"},{"type":"codeVoice","code":"isPro"},{"text":" — subscriptions lapse, and an install that stays","type":"text"},{"text":" ","type":"text"},{"text":"offline past the bound must not keep pro forever — but keeps","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"hasPermanentLicense"},{"text":", because lifetime purchases don’t expire.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Provider-agnostic by construction — it speaks only ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","isActive":true,"type":"reference"},{"text":", so it","type":"text"},{"text":" ","type":"text"},{"text":"wraps any base (simulated, RevenueCat, StoreKit, …). Feed the wrapped instance","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"both"}]},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallPlugin","isActive":true,"type":"reference"},{"text":" and any app-side reader that builds a","type":"text"},{"text":" ","type":"text"},{"text":"monetization\/context payload from entitlements.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Back the cache with ","type":"text"},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"text":" rather than ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"cache vouches for a paid entitlement offline, and ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"text":" is a plist","type":"text"},{"text":" ","type":"text"},{"text":"a user can edit or restore from a doctored backup, whereas the Keychain is","type":"text"},{"text":" ","type":"text"},{"text":"encrypted and not plist-editable. (On unsigned macOS dev builds the Keychain","type":"text"},{"text":" ","type":"text"},{"text":"can return ","type":"text"},{"type":"codeVoice","code":"errSecMissingEntitlement"},{"text":" \/ −34018 — see ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"Sandboxing &"},{"type":"text","text":" "},{"type":"text","text":"entitlements (macOS)"}]},{"text":" on ","type":"text"},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"type":"text","text":".)"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let resilient = ResilientPaywallService(","    base: paywallService,","    store: KeychainKeyValueStore(service: \"com.example.myapp\")",")","\/\/ PaywallPlugin(..., service: resilient)   \/\/ gate + account display","\/\/ await resilient.currentSnapshot()        \/\/ server payload, off-main"]},{"anchor":"Threat-model","type":"heading","level":2,"text":"Threat model"},{"type":"paragraph","inlineContent":[{"text":"Backed by ","type":"text"},{"type":"codeVoice","code":"KeychainKeyValueStore"},{"text":", the cache defends against casual plist","type":"text"},{"text":" ","type":"text"},{"text":"editing and a doctored-backup restore: the persisted last-known-good is","type":"text"},{"text":" ","type":"text"},{"text":"encrypted and not a user-editable file. It does ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" defend against a","type":"text"},{"text":" ","type":"text"},{"text":"jailbroken device — nothing client-side does; entitlements can always be","type":"text"},{"text":" ","type":"text"},{"text":"forged on a device the attacker fully controls. The live provider stays","type":"text"},{"text":" ","type":"text"},{"text":"authoritative whenever the app is online: any live snapshot overwrites the","type":"text"},{"text":" ","type":"text"},{"text":"cache, so a genuine lapse or downgrade is honoured on the next successful","type":"text"},{"type":"text","text":" "},{"type":"text","text":"read. "},{"type":"codeVoice","code":"hasPermanentLicense"},{"type":"text","text":" deliberately never expires — a lifetime purchase"},{"text":" ","type":"text"},{"text":"must keep working offline indefinitely.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpaywall\/resilientpaywallservice"]}],"metadata":{"modules":[{"name":"SwiduxPaywall"}],"navigatorTitle":[{"kind":"identifier","text":"ResilientPaywallService"}],"roleHeading":"Structure","symbolKind":"struct","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ResilientPaywallService","kind":"identifier"}],"role":"symbol","externalID":"s:13SwiduxPaywall09ResilientB7ServiceV","title":"ResilientPaywallService"},"hierarchy":{"paths":[["doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall"]]},"abstract":[{"text":"Wraps a ","type":"text"},{"identifier":"doc:\/\/SwiduxPaywall\/documentation\/SwiduxPaywall\/PaywallService","type":"reference","isActive":true},{"text":" so a transient failure to read entitlements never","type":"text"},{"text":" ","type":"text"},{"text":"presents a previously-seen paid user as free.","type":"text"}],"kind":"symbol","