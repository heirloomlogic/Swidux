Actor send"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Your domain types and database stay in your app. Swidux provides the contracts, observability, and dispatch loop."}]},{"level":2,"type":"heading","text":"Companion Packages","anchor":"Companion-Packages"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Vendor-specific adapters live in their own repositories so a third-party SDK never enters the core dependency graph. Each ships a drop-in service conformer plus a preview mock, and publishes its own DocC reference:"}]},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","isActive":true},{"text":" — RevenueCat adapter for the paywall plugin (","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":", ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":", and the ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" sheet). See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/"},{"type":"text","text":" — Mixpanel adapter for the analytics plugin ("},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":", "},{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":"). See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier