tion","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/ArchitectureGuide","doc:\/\/Swidux\/documentation\/Swidux\/PluginArchitecture","doc:\/\/Swidux\/documentation\/Swidux\/DesignPrinciples","doc:\/\/Swidux\/documentation\/Swidux\/SecurityPosture"]},{"anchor":"Store","title":"Store","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/Store","doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","doc:\/\/Swidux\/documentation\/Swidux\/SwiduxObservable","doc:\/\/Swidux\/documentation\/Swidux\/SwiduxReducer","doc:\/\/Swidux\/documentation\/Swidux\/SwiduxDispatcher","doc:\/\/Swidux\/documentation\/Swidux\/Effect","doc:\/\/Swidux\/documentation\/Swidux\/Send","doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)","doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)"]},{"anchor":"Data","title":"Data","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet"]},{"anchor":"Persistence--Undo","title":"Persistence & Undo","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","doc:\/\/Swidux\/documentation\/Swidux\/StateWriter","doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"]},{"anchor":"Preferences","title":"Preferences","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/KVKey","doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore"]},{"anchor":"Plugin-Protocol","title":"Plugin Protocol","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"]},{"anchor":"Structures","generated":true,"title":"Structures","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy"]},{"anchor":"Macros","generated":true,"title":"Macros","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/Slice()","doc:\/\/Swidux\/documentation\/Swidux\/Swidux()"]},{"anchor":"Ty