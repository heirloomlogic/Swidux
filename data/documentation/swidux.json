primaryContentSections":[{"kind":"content","content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Swidux is a Redux-style state-management library for SwiftUI. State lives in one observable store, mutations go through reducers, and side effects run as async effects. Macros generate the observability boilerplate. Built-in plugins handle persistence and undo\/redo. Four optional plugins ship ready-made paywalls (RevenueCat or StoreKit-shaped), version killswitches, parental gates, and analytics (Mixpanel or any backend).","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The dispatch cycle:","type":"text"}]},{"code":["View → store.send(.action)","  → willReduce hooks (UndoPlugin snapshots here)","  → reducer mutates state in place, optionally returns Effect","  → plugin reducers handle their own actions","  → afterReduce hooks (PersistencePlugin drains EntityStore changelogs here)","  → observer tree updates only changed properties (per-property observation)","  → effects run on a background actor; results dispatch back via @MainActor send"],"syntax":null,"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Your domain types and database stay in your app. Swidux provides the contracts, observability, and dispatch loop.","type":"text"}]}]}],"references":{"doc://Swidux/documentation/Swidux/HowToAddAParentalGate":{"type":"topic","url":"\/documentation\/swidux\/howtoaddaparentalgate","title":"Add a Parental Gate","kind":"article","abstract":[{"type":"text","text":"Gate sensitive actions — purchases, settings changes, leaving a kid-mode area — behind a math challenge."}],"role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAParentalGate"},"doc://Swidux/documentation/Swidux/Store":{"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Store"}],"url":"\/documen