ore","doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","doc:\/\/Swidux\/documentation\/Swidux\/SwiduxObservable","doc:\/\/Swidux\/documentation\/Swidux\/SwiduxReducer","doc:\/\/Swidux\/documentation\/Swidux\/SwiduxDispatcher","doc:\/\/Swidux\/documentation\/Swidux\/Effect","doc:\/\/Swidux\/documentation\/Swidux\/Send","doc:\/\/Swidux\/documentation\/Swidux\/cancellable(id:cancelInFlight:_:)","doc:\/\/Swidux\/documentation\/Swidux\/cancel(id:)"]},{"anchor":"Data","title":"Data","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/EntityStore","doc:\/\/Swidux\/documentation\/Swidux\/ChangeSet"]},{"anchor":"Persistence--Undo","title":"Persistence & Undo","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PersistencePlugin","doc:\/\/Swidux\/documentation\/Swidux\/StateWriter","doc:\/\/Swidux\/documentation\/Swidux\/UndoPlugin"]},{"anchor":"Preferences","title":"Preferences","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/KeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/KVKey","doc:\/\/Swidux\/documentation\/Swidux\/UserDefaultsKeyValueStore","doc:\/\/Swidux\/documentation\/Swidux\/InMemoryKeyValueStore"]},{"anchor":"Plugin-Protocol","title":"Plugin Protocol","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/SwiduxPlugin","doc:\/\/Swidux\/documentation\/Swidux\/PluginHost"]},{"generated":true,"title":"Structures","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/RetryPolicy"],"anchor":"Structures"},{"generated":true,"title":"Macros","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/Slice()","doc:\/\/Swidux\/documentation\/Swidux\/Swidux()"],"anchor":"Macros"},{"generated":true,"title":"Type Aliases","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/PersistenceMiddleware","doc:\/\/Swidux\/documentation\/Swidux\/UndoMiddleware"],"anchor":"Type-Aliases"},{"generated":true,"title":"Enumerations","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/FlushOutcome"],"anchor":"Enumerations"},{"generated":true,"title":"Extended Modules","identifiers":["doc:\/\/Swidux\/documentation\/Swidux\/Foundation"],"anchor":"Extended-Modules"}],"sections":[],"variants":[{"paths":["\/documentation\/swidux"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","metadata":{"modules":[{"name":"Swidux"}],"role":"collection","externalID":"Swidux","symbolKind":"module","roleHeading":"Framework","title":"Swidux"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"Swidux-logo","type":"image"}]},{"type":"paragraph","inlineContent":[{"text":"Swidux is a Redux-style state-management library for SwiftUI. State lives in one observable store, mutations go through reducers, and side effects run as async effects. Macros generate the observability boilerplate. Built-in plugins handle persistence and undo\/redo. Optional plugins ship ready-made paywalls (RevenueCat or StoreKit-shaped), version killswitches, parental gates, analytics (Mixpanel or any backend), feature flags, and SwiftData\/iCloud persistence.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The dispatch cycle:","type":"text"}]},{"syntax":null,"code":["View → store.send(.action)","  → willReduce hooks (UndoPlugin snapshots here)","  → reducer mutates state in place, optionally returns Effect","  → plugin reducers handle their own actions","  → afterReduce hooks (PersistencePlugin drains EntityStore changelogs here)","  → observer tree updates only changed properties (per-property observation)","  → effects run on a background actor; results dispatch back via @MainActor send"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Your domain types and database stay in your app. Swidux provides the contracts, observability, and dispatch loop.","type":"text"}]},{"anchor":"Companion-Packages","type":"heading","level":2,"text":"Companion Packages"},{"type":"paragraph","inlineContent":[{"text":