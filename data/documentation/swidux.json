-Packages","text":"Companion Packages","type":"heading"},{"inlineContent":[{"text":"Vendor-specific adapters live in their own repositories so a third-party SDK never enters the core dependency graph. Each ships a drop-in service conformer plus a preview mock, and publishes its own DocC reference:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/"},{"text":" — RevenueCat adapter for the paywall plugin (","type":"text"},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"text":", ","type":"text"},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"text":", and the ","type":"text"},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"text":" sheet). See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/"},{"type":"text","text":" — Mixpanel adapter for the analytics plugin ("},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":", "},{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":"). See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference"},{"text":".","type":"text"}]}]}],"type":"unorderedList"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":