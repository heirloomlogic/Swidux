evenueCatPaywallUI"},{"type":"text","text":" sheet). See "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","type":"reference","isActive":true},{"type":"text","text":" — Mixpanel adapter for the analytics plugin ("},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":", "},{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":"). See "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","type":"reference","isActive":true},{"type":"text","text":"."}]}]}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swidux"]}],"kind":"symbol","metadata":{"externalID":"Swidux","symbolKind":"module","modules":[{"name":"Swidux"}],"roleHeading":"Framework","role":"collection","title":"Swidux"},"references":{"doc://Swidux/documentation/Swidux/Slice()":{"role":"symbol","title":"Slice()","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Slice()","abstract":[],"fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Slice","kind":"identifier"},{"text":"()","kind":"text"}],"type":"topic","kind":"symbol","url":"\/documentation\/swidux\/slice()"},"doc://Swidux/documentation/Swidux/PersistencePlug