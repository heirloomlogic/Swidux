ux\/documentation\/Swidux\/PluginAnalyticsReference","isActive":true},{"type":"text","text":"."}]}]}]}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux"},"references":{"doc://Swidux/documentation/Swidux/HowToAddFeatureFlags":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddFeatureFlags","title":"Add Feature Flags","url":"\/documentation\/swidux\/howtoaddfeatureflags","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxFeatureFlags"},{"type":"text","text":" plugin into a Swidux app for typed feature flags, A\/B variants, and remote-tunable scalar values from a single JSON config."}],"role":"article"},"doc://Swidux/documentation/Swidux/HowToAddAPaywall":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","title":"Add a Paywall","url":"\/documentation\/swidux\/howtoaddapaywall","type":"topic","abstract":[{"type":"text","text":"Wire the "},{"type":"codeVoice","code":"SwiduxPaywall"},{"type":"text","text":" plugin into a Swidux app to gate features behind a subscription or lifetime purchase."}],"role":"article"},"doc://Swidux/documentation/Swidux/GettingStarted":{"kind":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/GettingStarted","title":"Getting Started with Swidux","url":"\/documentation\/swidux\/gettingstarted","type":"topic","abstract":[{"text":"Add Swidux to your project and wire up unidirectional data flow with automatic persistence.","type":"text"}],"role":"article"},"doc://Swidux/documentation/Swidux/Store/mutate(awaiting:merging:)":{"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store\/mutate(awaiting:merging:)","title":"mutate(awaiting:merging:)","url":"\/documentation\/swidux\/store\/mutate(awaiting:merging:)","type":"topic","abstract":[{"text":"Runs async work that must not hold state across its suspensions, then","type":"text"},{"text":" ","type":"text"}