ainActor send"],"syntax":null},{"inlineContent":[{"text":"Your domain types and database stay in your app. Swidux provides the contracts, observability, and dispatch loop.","type":"text"}],"type":"paragraph"},{"text":"Companion Packages","type":"heading","anchor":"Companion-Packages","level":2},{"inlineContent":[{"text":"Vendor-specific adapters live in their own repositories so a third-party SDK never enters the core dependency graph. Each ships a drop-in service conformer plus a preview mock, and publishes its own DocC reference:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","type":"reference"},{"text":" — RevenueCat adapter for the paywall plugin (","type":"text"},{"type":"codeVoice","code":"RevenueCatPaywallService"},{"text":", ","type":"text"},{"type":"codeVoice","code":"MockRevenueCatPaywallService"},{"text":", and the ","type":"text"},{"type":"codeVoice","code":"SwiduxRevenueCatPaywallUI"},{"type":"text","text":" sheet). See "},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","type":"reference","isActive":true},{"type":"text","text":" — Mixpanel adapter for the analytics plugin ("},{"type":"codeVoice","code":"MixpanelAnalyticsService"},{"type":"text","text":", "},{"type":"codeVoice","code":"MockMixpanelAnalyticsService"},{"type":"text","text":"). See "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","type":"reference","isActive":true},{"t