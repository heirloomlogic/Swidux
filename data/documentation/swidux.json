ifiers":["doc:\/\/Swidux\/documentation\/Swidux\/Foundation"],"anchor":"Extended-Modules","title":"Extended Modules"}],"kind":"symbol","variants":[{"paths":["\/documentation\/swidux"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"modules":[{"name":"Swidux"}],"roleHeading":"Framework","title":"Swidux","externalID":"Swidux","symbolKind":"module","role":"collection"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Swidux\/documentation\/Swidux"},"abstract":[{"text":"Redux-style state management for SwiftUI, with macros for observability and ready-made plugins for persistence, undo, paywalls, version killswitches, and parental gates.","type":"text"}],"hierarchy":{"paths":[[]]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"identifier":"Swidux-logo","type":"image"}],"type":"paragraph"},{"inlineContent":[{"text":"Swidux is a Redux-style state-management library for SwiftUI. State lives in one observable store, mutations go through reducers, and side effects run as async effects. Macros generate the observability boilerplate. Built-in plugins handle persistence and undo\/redo. Optional plugins ship ready-made paywalls (RevenueCat or StoreKit-shaped), version killswitches, parental gates, analytics (Mixpanel or any backend), feature flags, and SwiftData\/iCloud persistence.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The dispatch cycle:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":null,"code":["View → store.send(.action)","  → willReduce hooks (UndoPlugin snapshots here)","  → reducer mutates state in place, optionally returns Effect","  → plugin reducers handle their own actions","  → afterReduce hooks (PersistencePlugin drains EntityStore changelogs here)","  → observer tree updates only changed properties (per-property observation)","  → effects run on a background actor; results dispatch back via @MainActor send"]},{"inlineContent":[{"text":"Your domain types and database stay in your app. Swidux provides the contracts, observability, and dispatch loop.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Companion Packages","type":"heading","anchor":"Companion-Packages"},{"inlineContent":[{"text":"Vendor-specific adapters live in their own repositories so a third-party SDK never enters the core dependency graph. Each ships a drop-in service conformer plus a preview mock, and publishes its own DocC reference:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxRevenueCatPaywall\/documentation\/swiduxrevenuecatpaywall\/","isActive":true},{"type":"text","text":" — RevenueCat adapter for the paywall plugin ("},{"code":"RevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":", "},{"code":"MockRevenueCatPaywallService","type":"codeVoice"},{"type":"text","text":", and the "},{"code":"SwiduxRevenueCatPaywallUI","type":"codeVoice"},{"type":"text","text":" sheet). See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAPaywall","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginPaywallReference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"https:\/\/heirloomlogic.github.io\/SwiduxMixpanelAnalytics\/documentation\/swiduxmixpanelanalytics\/","isActive":true},{"type":"text","text":" — Mixpanel adapter for the analytics plugin ("},{"code":"MixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":", "},{"code":"MockMixpanelAnalyticsService","type":"codeVoice"},{"type":"text","text":"). See "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddAnalytics","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/PluginAnalyticsReference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}]}]}]}],"references":{"doc://Swidux/documentation/Swidux/MacrosReference":{"kind":"article","url":"\/documentation\/swidux\/macrosreference","type":"topic","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/MacrosReference","abstract":[{"text":"Reference for ","type":"text"},{"type":"codeVoice","code":"@Swidux"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Slice"},{"type":"text","text":" (the observation bridge between value-type state and SwiftUI), and for "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" and its property markers (the SwiftData persistence bridge, shipped in "},{"type":"codeVoice","code":"SwiduxPersistence"},{"text":").","type":"text"}],"title":"Macros","role":"article"},"doc://Swidux/documentation/Swidux/AgentSkill":{"url":"\/documentation\/swidux\/agentskill","kind":"article","abstract":[{"type":"text","text":"Install the bundled "},{"code":"swidux-ref","type":"codeVoice"},{"type":"text","text":" skill so your AI coding assistant has Swidux’s architecture rules and code templates on hand."}],"title":"Using the Swidux Agent Skill","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/AgentSkill","type":"topic","role":"article"},"doc://Swidux/documentation/Swidux/BuildingADomainPlugin":{"title":"Building a Domain Plugin","url":"\/documentation\/swidux\/buildingadomainplugin","role":"article","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/BuildingADomainPlugin","abstract":[{"type":"text","text":"Create a self-contained feature plugin with its own state, actions, and effects."}],"kind":"article","type":"topic"},"doc://Swidux/documentation/Swidux/BuildingYourFirstApp":{"url":"\/documentation\/swidux\/buildingyourfirstapp","kind":"article","abstract":[{"text":"Build a counter app from scratch and meet the four mov