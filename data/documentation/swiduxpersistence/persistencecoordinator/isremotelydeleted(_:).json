sion re-infers deletions"},{"type":"text","text":" "},{"type":"text","text":"on every call instead of carrying them, so it records nothing here."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/isremotelydeleted(_:)"]}],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"kind":"symbol","abstract":[{"text":"Whether a deletion made elsewhere is waiting on ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" — read from history","type":"text"},{"text":" ","type":"text"},{"text":"or declared to ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)","type":"reference","isActive":true},{"text":", deferred by an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","type":"reference","isActive":true},{"text":" hold, and not applied yet.","type":"text"}],"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/isRemotelyDeleted(_:)","interfaceLanguage":"swift"},"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/mergeRemote(into:ids:deleted:policy:)":{"title":"mergeRemote(into:ids:deleted:policy:)","kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)","url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/mergeremote(into:ids:deleted:policy:)","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mergeRemote","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},