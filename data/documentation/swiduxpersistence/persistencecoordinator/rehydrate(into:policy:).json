{"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"kind":"text","text":": "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","kind":"typeIdentifier","text":"Store","preciseIdentifier":"s:6Swidux5StoreC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"text":"The live store to reconcile.","type":"text"}],"type":"paragraph"}],"name":"store"},{"content":[{"inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only. Pass"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive","isActive":true},{"type":"text","text":" after a container rebuild,"},{"type":"text","text":" "},{"type":"text","text":"where a row’s absence says nothing about whether it was deleted."}],"type":"paragraph"}],"name":"policy"}]},{"kind":"content","content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Takes the store rather than ","type":"text"},{"code":"inout State","type":"codeVoice"},{"text":" on purpose. Re-hydration is a","type":"text"},{"text":" ","type":"text"},{"text":"mid-session operation with two ","type":"text"},{"code":"await","type":"codeVoice"},{"text":"s in it (the flush, then the","type":"text"},{"text":" ","type":"text"},{"text":"fetches), and any caller holding a state snapshot across those would","type":"text"},{"text":" ","type":"text"},{"text":"overwrite everything dispatched in between. Here the flush and every","type":"text"},{"text":" ","type":"text"},{"text":"fetch complete first; only then does one suspension-free step pack a","type":"text"},{"text":" ","type":"text"},{"text":"fresh snapshot, merge, and unpack.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Under the default ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","isActive":true},{"text":", remote edits and remote","type":"text"},{"text":" ","type":"text"},{"text":"deletions surface mid-session. An ID is exempt whenever the local side","type":"text"},{"text":" ","type":"text"},{"text":"still has something to say about it — a drained-but-unflushed write, an","type":"text"},{"text":" ","type":"text"},{"text":"un-drained edit, a pending deletion, or a write whose save failed. Those","type":"text"},{"text":" ","type":"text"},{"text":"always win, and that guarantee is not configurable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pending writes and deletions are flushed to disk "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the merge, so a"},{"type":"text","text":" "},{"type":"text","text":"remote-change refresh that fires during the debounce window can’t read a"},{"type":"text","text":" "},{"type":"text","text":"stale disk row for an entity the user just edited or deleted and resurrect"},{"type":"text","text":" "},{"type":"text","text":"it. The flush closes most of the window; the dirty set closes what the"},{"type":"text","text":" "},{"type":"text","text":"remaining suspension points let through."}]},{"name":"Important","style":"important","content":[{"inlineContent":[{"type":"text","text":"One case is beyond reach — an edit that is still in a view’s"},{"type":"text","text":" "},{"type":"text","text":"local "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" and has not been dispatched yet is invisible to the"},{"type":"text","text":" "},{"type":"text","text":"store, so a remote value can land underneath it. Bindings made with"},{"type":"text","text":" "},{"type":"codeVoice","code":"store.binding(_:sending:)"},{"type":"text","text":" dispatch on write and are therefore"},{"type":"text","text":" "},{"type":"text","text":"covered. For a store backing a live text editor, register it with"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside"},{"type":"paragraph","inlineContent":[{"text":"If a fetch fails, the corresponding ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":" is left untouched","type":"text"},{"text":" ","type":"text"},{"text":"and the failure is reported via ","type":"text"},{"code":"onFailure","type":"codeVoice"},{"text":".","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},"schemaVersion":{"minor":3,"major":0,"patch":0},"ki