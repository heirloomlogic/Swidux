{"variants":[{"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Re-hydration that reconciles stored rows into the live ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":"s","type":"text"},{"text":" ","type":"text"},{"text":"without dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"kind":"symbol","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE9rehydrate4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","extendedModule":"SwiduxPersistence","symbolKind":"method","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"State"},{"text":" conforms to ","type":"text"},{"code":"SwiduxObservable","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Store","preciseIdentifier":"s:6Swidux5StoreC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier","text":"MergePolicy"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"}],"modules":[{"name":"SwiduxPersistence"}],"title":"rehydrate(into:policy:)","role":"symbol","roleHeading":"Instance Method"},"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","text":"Store","preciseIdentifier":"s:6Swidux5StoreC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The live store to reconcile."}]}],"name":"store"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only. Pass"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive"},{"type":"text","text":" after a container rebuild,"},{"type":"text","text":" "},{"type":"text","text":"where a row’s absence says nothing about whether it was deleted."}]}],"name":"policy"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"Takes the store rather than "},{"code":"inout State","type":"codeVoice"},{"type":"text","text":" on purpose. Re-hydration is a"},{"type":"text","text":" "},{"type":"text","text":"mid-session operation with two "},{"code":"await","type":"codeVoice"},{"type":"text","text":"s in it (the flush, then the"},{"type":"text","text":" "},{"type":"text","text":"fetches), and any caller holding a state snapshot across those would"},{"type":"text","text":" "},{"type":"text","text":"overwrite everything dispatched in between. Here the flush and every"},{"type":"text","text":" "},{"type":"text","text":"fetch complete first; only then does one suspension-free step pack a"},{"type":"text","text":" "},{"type":"text","text":"fresh snapshot, merge, and unpack."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Under the default "},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","type":"reference"},{"type":"text","text":", remote edits and remote"},{"type":"text","text":" "},{"type":"text","text":"deletions surface mid-session. An ID is exempt whenever the local side"},{"type":"text","text":" "},{"type":"text","text":"still has something to say about it — a drained-but-unflushed write, an"},{"type":"text","text":" "},{"type":"text","text":"un-drained edit, a pending deletion, or a write whose save failed. Those"},{"type":"text","text":" "},{"type":"text","text":"always win, and that guarantee is not configurable."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Pending writes and deletions are flushed to disk "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" the merge, so a"},{"type":"text","text":" "},{"type":"text","text":"remote-change refresh that fires during the debounce window can’t read a"},{"type":"text","text":" "},{"type":"text","text":"stale disk row for an entity the user just edited or deleted and resurrect"},{"type":"text","text":" "},{"type":"text","text":"it. The flush closes most of the window; the dirty set closes what the"},{"type":"text","text":" "},{"type":"text","text":"remaining suspension points let through."}],"type":"paragraph"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"One case is beyond reach — an edit that is still in a view’s"},{"type":"text","text":" "},{"type":"text","text":"local "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" and has not been dispatched yet is invisible to the"},{"type":"text","text":" "},{"type":"text","text":"store, so a remote value can land underneath it. Bindings made with"},{"type":"text","text":" "},{"code":"store.binding(_:sending:)","type":"codeVoice"},{"type":"text","text":" dispatch on write and are therefore"},{"type":"text","text":" "},{"type":"text","text":"covered. For a store backing a live text editor, register it with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory"},{"type":"text","text":"."}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"If a fetch fails, the corresponding "},{"code":"EntityStore","type":"codeVoice"},{"type":"text","text":" is left untouched"},{"type":"text","text":" "},{"type":"text","text":"and the failure is reported via "},{"code":"onFailure","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/rehydrate(into:policy:)":{"role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Swidux5StoreC","text":"Store","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)","title":"rehydrate(into:policy:)","abstract":[{"text":"Re-hydration that reconciles stored rows into the live ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":"s","type":"text"},{"text":" ","type":"text"},{"text":"without dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferInMemory":{"role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"preferInMemory","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy","kind":"typeIdentifier"}],"url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferinmemory","title":"preferInMemory","abstract":[{"text":"Additive-only: the in-memory value wins for every ID already held, and","type":"text"},{"text":" ","type":"text"},{"text":"nothing is ever removed.","type":"text"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory"},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"url":"\/documentation\/swiduxpersistence","abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","title":"SwiduxPersistence","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferRemoteAdditive":{"role":"symbol","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"kind":"identifier","text":"preferRemoteAdditive"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"}],"url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferremoteadditive","title":"preferRemoteAdditive","abstract":[{"text":"Remote edits surface, but absence from the snapshot never removes a live","type":"text"},{"type":"text","text":" "},{"text":"entity.","type":"text"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferRemote":{"role":"symbol","type":"topic","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"kind":"text","text":" "},{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"preferRemote","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy","kind":"typeIdentifier"}],"url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferremote","title":"preferRemote","abstract":[{"text":"Remote edits and deletions surface mid-session; a pending local write","type":"text"},{"text":" ","type":"text"},{"text":"still wins. The default.","type":"text"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"role":"symbol","title":"EntityDB","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityDB","kind":"identifier"}],"url":"\/documentation\/swiduxpersistence\/entitydb","abstract":[{"text":"A generic ","type":"text"},{"code":"@ModelActor","type":"codeVoice"},{"text":" that reads and writes any ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","isActive":true,"type":"reference"},{"text":".","type":"text"}],"navigatorTitle":[{"text":"EntityDB","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator":{"role":"symbol","title":"PersistenceCoordinator","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistenceCoordinator"}],"url":"\/documentation\/swiduxpersistence\/persistencecoordinator","abstract":[{"type":"text","text":"Owns the "},{"code":"ModelContainer","type":"codeVoice"},{"type":"text","text":" + generic "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB"},{"type":"text","text":" and wires the registered"},{"type":"text","text":" "},{"type":"text","text":"entities into a "},{"code":"Swidux.PersistencePlugin","type":"codeVoice"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"PersistenceCoordinator"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","type":"topic"},"doc://Swidux/documentation/Swidux/Store":{"role":"symbol","title":"Store","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"Store"}],"url":"\/documentation\/swidux\/store","abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"type":"text","text":"observation layer."}],"navigatorTitle":[{"kind":"identifier","text":"Store"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy":{"role":"symbol","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"MergePolicy"}],"url":"\/documentation\/swiduxpersistence\/mergepolicy","title":"MergePolicy","navigatorTitle":[{"text":"MergePolicy","kind":"identifier"}],"abstract":[{"text":"How ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true,"type":"reference"},{"text":" resolves a storage","type":"text"},{"text":" ","type":"text"},{"text":"snapshot against live in-memory state.","type":"text"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy"}}}