{"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"store","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","text":"Store","preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"}],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"store","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The live store to reconcile."}]}]},{"name":"policy","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only. Pass"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive"},{"type":"text","text":" after a container rebuild,"},{"type":"text","text":" "},{"type":"text","text":"where a row’s absence says nothing about whether it was deleted."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"Takes the store rather than ","type":"text"},{"code":"inout State","type":"codeVoice"},{"text":" on purpose. Re-hydration is a","type":"text"},{"text":" ","type":"text"},{"text":"mid-session operation with two ","type":"text"},{"code":"await","type":"codeVoice"},{"text":"s in it (the flush, then the","type":"text"},{"text":" ","type":"text"},{"text":"fetches), and any caller holding a state snapshot across those would","type":"text"},{"text":" ","type":"text"},{"text":"overwrite everything dispatched in between. Here the flush and every","type":"text"},{"text":" ","type":"text"},{"text":"fetch complete first; only then does one suspension-free step pack a","type":"text"},{"text":" ","type":"text"},{"text":"fresh snapshot, merge, and unpack.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Under the default "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote"},{"type":"text","text":", remote edits and remote"},{"type":"text","text":" "},{"type":"text","text":"deletions surface mid-session. An ID is exempt whenever the local side"},{"text":" ","type":"text"},{"text":"still has something to say about it — a drained-but-unflushed write, an","type":"text"},{"text":" ","type":"text"},{"text":"un-drained edit, a pending deletion, or a write whose save failed. Those","type":"text"},{"text":" ","type":"text"},{"text":"always win, and that guarantee is not configurable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Pending writes and deletions are flushed to disk "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" the merge, so a"},{"type":"text","text":" "},{"type":"text","text":"remote-change refresh that fires during the debounce window can’t read a"},{"type":"text","text":" "},{"type":"text","text":"stale disk row for an entity the user just edited or deleted and resurrect"},{"type":"text","text":" "},{"type":"text","text":"it. The flush closes most of the window; the dirty set closes what the"},{"type":"text","text":" "},{"type":"text","text":"remaining suspension points let through."}],"type":"paragraph"},{"name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"One case is beyond reach — an edit that is still in a view’s"},{"type":"text","text":" "},{"type":"text","text":"local "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" and has not been dispatched yet is invisible to the"},{"type":"text","text":" "},{"type":"text","text":"store, so a remote value can land underneath it. Bindings made with"},{"text":" ","type":"text"},{"code":"store.binding(_:sending:)","type":"codeVoice"},{"type":"text","text":" dispatch on write and are therefore"},{"type":"text","text":" "},{"type":"text","text":"covered. For a store backing a live text editor, register it with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","isActive":true},{"type":"text","text":"."}]}],"type":"aside"},{"type":"paragraph","inlineContent":[{"text":"If a fetch fails, the corresponding ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":" is left untouched","type":"text"},{"text":" ","type":"text"},{"text":"and the failure is reported via ","type":"text"},{"type":"codeVoice","code":"onFailure"},{"text":".","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"symbol","metadata":{"title":"rehydrate(into:policy:)","extendedModule":"SwiduxPersistence","role":"symbol","roleHeading":"Instance Method","conformance":{"constraints":[{"type":"codeVoice","code":"State"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"SwiduxObservable"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Store","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE9rehydrate4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","modules":[{"name":"SwiduxPersistence"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)"]}],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"abstract":[{"text":"Re-hydration that reconciles stored rows into the live ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":"s","type":"text"},{"text":" ","type":"text"},{"text":"without dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"abstract":[{"text":"A generic ","type":"text"},{"type":"codeVoice","code":"@ModelActor"},{"text":" that reads and writes any ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityDB","kind":"identifier"}],"navigatorTitle":[{"text":"EntityDB","kind":"identifier"}],"type":"topic","role":"symbol","title":"EntityDB","kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","url":"\/documentation\/swiduxpersistence\/entitydb"},"doc://Swidux/documentation/Swidux/Store":{"url":"\/documentation\/swidux\/store","abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"type":"text","text":"observation layer."}],"type":"topic","title":"Store","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"navigatorTitle":[{"text":"Store","kind":"identifier"}],"kind":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"abstract":[],"type":"topic","role":"collection","title":"SwiduxPersistence","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","kind":"symbol","url":"\/documentation\/swiduxpersistence"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferRemoteAdditive":{"kind":"symbol","abstract":[{"text":"Remote edits surface, but absence from the snapshot never removes a live","type":"text"},{"text":" ","type":"text"},{"text":"entity.","type":"text"}],"title":"preferRemoteAdditive","type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"preferRemoteAdditive"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy"}],"role":"symbol","url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferremoteadditive"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferRemote":{"abstract":[{"type":"text","text":"Remote edits and deletions surface mid-session; a pending local write"},{"type":"text","text":" "},{"type":"text","text":"still wins. The default."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"preferRemote","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy","kind":"typeIdentifier"}],"type":"topic","role":"symbol","title":"preferRemote","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","kind":"symbol","url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferremote"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator":{"title":"PersistenceCoordinator","url":"\/documentation\/swiduxpersistence\/persistencecoordinator","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","role":"symbol","kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistenceCoordinator","kind":"identifier"}],"navigatorTitle":[{"text":"PersistenceCoordinator","kind":"identifier"}],"abstract":[{"type":"text","text":"Owns the "},{"code":"ModelContainer","type":"codeVoice"},{"type":"text","text":" + generic "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB"},{"type":"text","text":" and wires the registered"},{"type":"text","text":" "},{"type":"text","text":"entities into a "},{"code":"Swidux.PersistencePlugin","type":"codeVoice"},{"type":"text","text":"."}],"type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy":{"abstract":[{"text":"How ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"reference"},{"text":" resolves a storage","type":"text"},{"text":" ","type":"text"},{"text":"snapshot against live in-memory state.","type":"text"}],"kind":"symbol","title":"MergePolicy","type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MergePolicy"}],"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"MergePolicy"}],"url":"\/documentation\/swiduxpersistence\/mergepolicy"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/rehydrate(into:policy:)":{"kind":"symbol","abstract":[{"type":"text","text":"Re-hydration that reconciles stored rows into the live "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"without dropping unflushed writes or in-progress edits (rule #8)."}],"type":"topic","title":"rehydrate(into:policy:)","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC","text":"Store"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"}],"role":"symbol","url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferInMemory":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","type":"topic","kind":"symbol","url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferinmemory","title":"preferInMemory","abstract":[{"type":"text","text":"Additive-only: the in-memory value wins for every ID already held, and"},{"type":"text","text":" "},{"type":"text","text":"nothing is ever removed."}],"role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"preferInMemory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy"}]}}}