{"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)"]}],"metadata":{"extendedModule":"SwiduxPersistence","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"rehydrate"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"into"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier","text":"Store"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"title":"rehydrate(into:policy:)","externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE9rehydrate4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","conformance":{"constraints":[{"code":"State","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"SwiduxObservable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"role":"symbol","roleHeading":"Instance Method","modules":[{"name":"SwiduxPersistence"}]},"abstract":[{"type":"text","text":"Re-hydration that reconciles stored rows into the live "},{"code":"EntityStore","type":"codeVoice"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"without dropping unflushed writes or in-progress edits (rule #8)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","preciseIdentifier":"s:6Swidux5StoreC","text":"Store"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The live store to reconcile.","type":"text"}]}],"name":"store"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Narrows the configured policy for this call only. Pass","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive","isActive":true},{"text":" after a container rebuild,","type":"text"},{"type":"text","text":" "},{"text":"where a row’s absence says nothing about whether it was deleted.","type":"text"}]}],"name":"policy"}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Takes the store rather than "},{"code":"inout State","type":"codeVoice"},{"type":"text","text":" on purpose. Re-hydration is a"},{"type":"text","text":" "},{"type":"text","text":"mid-session operation with two "},{"code":"await","type":"codeVoice"},{"type":"text","text":"s in it (the flush, then the"},{"type":"text","text":" "},{"type":"text","text":"fetches), and any caller holding a state snapshot across those would"},{"type":"text","text":" "},{"text":"overwrite everything dispatched in between. Here the flush and every","type":"text"},{"text":" ","type":"text"},{"text":"fetch complete first; only then does one suspension-free step pack a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"fresh snapshot, merge, and unpack."}]},{"type":"paragraph","inlineContent":[{"text":"Under the default ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","type":"reference","isActive":true},{"text":", remote edits and remote","type":"text"},{"text":" ","type":"text"},{"text":"deletions surface mid-session. An ID is exempt whenever the local side","type":"text"},{"type":"text","text":" "},{"type":"text","text":"still has something to say about it — a drained-but-unflushed write, an"},{"text":" ","type":"text"},{"text":"un-drained edit, a pending deletion, or a write whose save failed. Those","type":"text"},{"text":" ","type":"text"},{"text":"always win, and that guarantee is not configurable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Pending writes and deletions are flushed to disk ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"emphasis"},{"text":" the merge, so a","type":"text"},{"text":" ","type":"text"},{"text":"remote-change refresh that fires during the debounce window can’t read a","type":"text"},{"text":" ","type":"text"},{"text":"stale disk row for an entity the user just edited or deleted and resurrect","type":"text"},{"text":" ","type":"text"},{"text":"it. The flush closes most of the window; the dirty set closes what the","type":"text"},{"text":" ","type":"text"},{"text":"remaining suspension points let through.","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":"One case can’t be inferred — an edit still sitting in a"},{"type":"text","text":" "},{"type":"text","text":"view’s local "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" has never reached the store, so a remote value"},{"type":"text","text":" "},{"text":"can land underneath it. Bindings made with ","type":"text"},{"code":"store.binding(_:sending:)","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"dispatch on write and are covered already. Otherwise declare the edit"},{"type":"text","text":" "},{"type":"text","text":"with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing"},{"text":" (see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds"},{"type":"text","text":"), which exempts one ID for as"},{"type":"text","text":" "},{"type":"text","text":"long as it is being edited, or register a whole collection with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside","style":"important","name":"Important"},{"type":"paragraph","inlineContent":[{"text":"If a fetch fails, the corresponding ","type":"text"},{"type":"codeVoice","code":"EntityStore"},{"text":" is left untouched","type":"text"},{"text":" ","type":"text"},{"text":"and the failure is reported via ","type":"text"},{"type":"codeVoice","code":"onFailure"},{"text":".","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/Persi