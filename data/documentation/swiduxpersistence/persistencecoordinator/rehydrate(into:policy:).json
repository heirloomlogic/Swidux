eVoice","code":"EntityStore"},{"type":"text","text":"s"},{"text":" ","type":"text"},{"type":"text","text":"without dropping unflushed writes or in-progress edits (rule #8)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","preciseIdentifier":"s:6Swidux5StoreC","text":"Store"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"}]}]},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The live store to reconcile."}],"type":"paragraph"}],"name":"store"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only. Pass"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive","isActive":true},{"type":"text","text":" after a container rebuild,"},{"type":"text","text":" "},{"type":"text","text":"where a row’s absence says nothing about whether it was deleted."}]}],"name":"policy"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"Takes the store rather than ","type":"text"},{"code":"inout State","type":"codeVoice"},{"text":" on purpose. Re-hydration is a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"mid-session operation with two "},{"type":"codeVoice","code":"await"},{"type":"text","text":"s in it (the flush, then the"},{"type":"text","text":" "},{"type":"text","text":"fetches), and any caller holding a state snapshot across those would"},{"type":"text","text":" "},{"type":"text","text":"overwrite everything dispatched in between. Here the flush and every"},{"type":"text","text":" "},{"type":"text","text":"fetch complete first; only then does one suspension-free step pack a"},{"type":"text","text":" "},{"text":"fresh snapshot, merge, and unpack.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Under the default ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote"},{"type":"text","text":", remote edits and remote"},{"type":"text","text":" "},{"type":"text","text":"deletions surface mid-session. An ID is exempt whenever the local side"},{"type":"text","text":" "},{"type":"text","text":"still has something to say about it — a drained-but-unflushed write, an"},{"type":"text","text":" "},{"type":"text","text":"un-drained edit, a pending deletion, or a write whose save failed. Those"},{"type":"text","text":" "},{"type":"text","text":"always win, and that guarantee is not configurable."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pending writes and deletions are flushed to disk "},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"type":"text","text":" the merge, so a"},{"type":"text","text":" "},{"type":"text","text":"remote-change refresh that fires during the debounce window can’t read a"},{"type":"text","text":" "},{"type":"text","text":"stale disk row for an entity the user just edited or deleted and resurrect"},{"type":"text","text":" "},{"type":"text","text":"it. The flush closes most of the window; the dirty set closes what the"},{"text":" ","type":"text"},{"text":"remaining suspension points let through.","type":"text"}]},{"type":"aside","style":"important","content":[{"inlineContent":[{"text":"One case can’t be inferred — an edit still sitting in a","type":"text"},{"text":" ","type":"text"},{"text":"view’s local ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" has never reached the store, so a remote value","type":"text"},{"text":" ","type":"text"},{"text":"can land underneath it. Bindings made with ","type":"text"},{"type":"codeVoice","code":"store.binding(_:sending:)"},{"text":" ","type":"text"},{"text":"dispatch on write and are covered already. Otherwise declare the edit","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","isActive":true},{"type":"text","text":" (see "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds","isActive":true},{"type":"text","text":"), which exempts one ID for as"},{"type":"text","text":" "},{"type":"text","text":"long as it is being edited, or register a whole collection with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Important"},{"inlineContent":[{"text":"If a fetch fails, the corresponding ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":" is left untouched","type":"text"},{"text":" ","type":"text"},{"text":"and the failure is reported via ","type":"text"},{"code":"onFailure","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If another merge commits during a read, the operation re-reads against"},{"type":"text","text":" "},{"type":"text","text":"that newer state before applying anything. Replacing the database"},{"type":"text","text":" "},{"type":"text","text":"discards any reads still in flight against the previous container."}],"type":"paragraph"}]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","url":"\/documentation\/swiduxpersistence\/mergepolicy","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MergePolicy"}],"title":"MergePolicy","role":"symbol","navigatorTitle":[{"text":"MergePolicy","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"How "},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"reference"},{"text":" resolves a storage","type":"text"},{"text":" ","type":"text"},{"text":"snapshot against live in-memory state.","type":"text"}],"type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferInMemory":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferinmemory","title":"preferInMemory","kind":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"preferInMemory","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy","kind":"typeIdentifier"}],"abstract":[{"type":"text","text":"Additive-only: the in-memory value wins for every ID already held, and"},{"type":"text","text":" "},{"type":"text","text":"nothing is ever removed."}],"role":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"role":"symbol","navigatorTitle":[{"text":"EntityDB","kind":"identifier"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityDB","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","abstract":[{"type":"text","text":"A generic "},{"type":"codeVoice","code":"@ModelActor"},{"type":"text","text":" that reads and writes any "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","type":"reference","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/swiduxpersistence\/entitydb","type":"topic","title":"EntityDB"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/rehydrate(into:policy:)":{"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Store","preciseIdentifier":"s:6Swidux5StoreC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"kind":"text","text":"?) "},{"text":"async","kind":"keyword"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","abstract":[{"text":"Re-hydration that reconciles stored rows into the live ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":"s","type":"text"},{"text":" ","type":"text"},{"text":"without dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)","type":"topic","title":"rehydrate(into:policy:)"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EditingHolds":{"role":"symbol","navigatorTitle":[{"text":"EditingHolds","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EditingHolds","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds","abstract":[{"text":"IDs an app has declared it is editing, exempt from a re-hydration merge for","type":"text"},{"text":" ","type":"text"},{"text":"as long as the hold is in force.","type":"text"}],"url":"\/documentation\/swiduxpersistence\/editingholds","type":"topic","title":"EditingHolds"},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"url":"\/documentation\/swiduxpersistence","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","role":"collection","kind":"symbol","title":"SwiduxPersistence","abstract":[],"type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferRemote":{"title":"preferRemote","url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferremote","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","kind":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"preferRemote","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy","kind":"typeIdentifier"}],"abstract":[{"text":"Remote edits and deletions surface mid-session; a pending local write","type":"text"},{"text":" ","type":"text"},{"text":"still wins. The default.","type":"text"}],"role":"symbol"},"doc://Swidux/documentation/Swidux/Store":{"url":