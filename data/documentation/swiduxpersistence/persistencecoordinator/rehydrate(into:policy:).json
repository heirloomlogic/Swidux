:"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","text":"Store"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","text":"MergePolicy"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The live store to reconcile.","type":"text"}]}],"name":"store"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Narrows the configured policy for this call only. Pass","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive","type":"reference","isActive":true},{"text":" after a container rebuild,","type":"text"},{"text":" ","type":"text"},{"text":"where a row’s absence says nothing about whether it was deleted.","type":"text"}]}],"name":"policy"}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Takes the store rather than "},{"code":"inout State","type":"codeVoice"},{"type":"text","text":" on purpose. Re-hydration is a"},{"type":"text","text":" "},{"type":"text","text":"mid-session operation with two "},{"code":"await","type":"codeVoice"},{"type":"text","text":"s in it (the flush, then the"},{"type":"text","text":" "},{"type":"text","text":"fetches), and any caller holding a state snapshot across those would"},{"type":"text","text":" "},{"type":"text","text":"overwrite everything dispatched in between. Here the flush and every"},{"type":"text","text":" "},{"type":"text","text":"fetch complete first; only then does one suspension-free step pack a"},{"type":"text","text":" "},{"type":"text","text":"fresh snapshot, merge, and unpack."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Under the default "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","isActive":true},{"type":"text","text":", remote edits and remote"},{"type":"text","text":" "},{"type":"text","text":"deletions surface mid-session. An ID is exempt whenever the local side"},{"type":"text","text":" "},{"type":"text","text":"still has something to say about it — a drained-but-unflushed write, an"},{"type":"text","text":" "},{"type":"text","text":"un-drained edit, a pending deletion, or a write whose save failed. Those"},{"type":"text","text":" "},{"type":"text","text":"always win, and that guarantee is not configurable."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pending writes and deletions are flushed to disk "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the merge, so a"},{"type":"text","text":" "},{"type":"text","text":"remote-change refresh that fires during the debounce window can’t read a"},{"type":"text","text":" "},{"type":"text","text":"stale disk row for an entity the user just edited or deleted and resurrect"},{"type":"text","text":" "},{"type":"text","text":"it. The flush closes most of the window; the dirty set closes what the"},{"type":"text","text":" "},{"type":"text","text":"remaining suspension points let through."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"One case can’t be inferred — an edit still sitting in a","type":"text"},{"text":" ","type":"text"},{"text":"view’s local ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" has never reached the store, so a remote value","type":"text"},{"text":" ","type":"text"},{"text":"can land underneath it. Bindings made with ","type":"text"},{"code":"store.binding(_:sending:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"dispatch on write and are covered already. Otherwise declare the edit","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","type":"reference","isActive":true},{"text":" (see ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds","type":"reference","isActive":true},{"text":"), which exempts one ID for as","type":"text"},{"text":" ","type":"text"},{"text":"long as it is being edited, or register a whole collection with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","type":"reference","isActive":true},{"text":".","type":"text"}]}],"style":"important","name":"Important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If a fetch fails, the corresponding "},{"code":"EntityStore","type":"codeVoice"},{"type":"text","text":" is left untouched"},{"type":"text","text":" "},{"type":"text","text":"and the failure is reported via "},{"code":"onFailure","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"If another merge commits during a read, the operation re-reads against"},{"type":"text","text":" "},{"type":"text","text":"that newer state before applying anything. Replacing the database"},{"type":"text","text":" "},{"type":"text","text":"discards any reads still in flight against the previous container."}]}]}],"abstract":[{"type":"text","text":"Re-hydration that reconciles stored rows into the live "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"without dropping unflushed writes or in-progress edits (rule #8)."}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/editing":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"editing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence12EditingHoldsC","text":"EditingHolds"}],"url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/editing","abstract":[{"type":"text","text":"Entities the app has declared it is editing, exempt from the merge until"},{"type":"text","text":" "},{"type":"text","text":"released."}],"title":"editing","kind":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","url":"\/documentation\/swiduxpersistence","title":"SwiduxPersistence","role":"collection","abstract":[],"kind":"symbol","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","url":"\/documentation\/swiduxpersistence\/entitydb","title":"EntityDB","role":"symbol","abstract":[{"text":"A generic ","type":"text"},{"code":"@ModelActor","type":"codeVoice"},{"text":" that reads and writes any ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","type":"reference"},{"text":".","type":"text"}],"navigat