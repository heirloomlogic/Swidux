nd":"keyword"},{"text":" ","kind":"text"},{"text":"preferRemote","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"}],"type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","kind":"symbol","role":"symbol","title":"preferRemote"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferInMemory":{"url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferinmemory","abstract":[{"type":"text","text":"Additive-only: the in-memory value wins for every ID already held, and"},{"type":"text","text":" "},{"type":"text","text":"nothing is ever removed."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"preferInMemory","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"}],"type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","kind":"symbol","role":"symbol","title":"preferInMemory"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy":{"url":"\/documentation\/swiduxpersistence\/mergepolicy","abstract":[{"type":"text","text":"How "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true,"type":"reference"},{"type":"text","text":" resolves a storage"},{"type":"text","text":" "},{"type":"text","text":"snapshot against live in-memory state."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MergePolicy","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","kind":"symbol","navigatorTitle":[{"text":"MergePolicy","kind":"identifier"}],"role":"symbol","title":"MergePolicy"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferRemoteAdditive":{"url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferremoteadditive","abstract":[{"type":"text","text":"Remote edits surface, but absence from the snapshot never removes a live"},{"type":"text","text":" "},{"type":"text","text":"entity."}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"preferRemoteAdditive","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"}],"type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive","kind":"symbol","role":"symbol","title":"preferRemoteAdditive"}}}