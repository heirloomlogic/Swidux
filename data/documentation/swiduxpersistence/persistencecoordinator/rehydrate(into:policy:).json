r","text":"PersistenceCoordinator"}],"kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistenceCoordinator"}],"url":"\/documentation\/swiduxpersistence\/persistencecoordinator","abstract":[{"type":"text","text":"Owns the "},{"code":"ModelContainer","type":"codeVoice"},{"type":"text","text":" + generic "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","isActive":true,"type":"reference"},{"text":" and wires the registered","type":"text"},{"text":" ","type":"text"},{"text":"entities into a ","type":"text"},{"type":"codeVoice","code":"Swidux.PersistencePlugin"},{"text":".","type":"text"}]}}}