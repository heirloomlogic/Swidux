{"sections":[],"abstract":[{"text":"Re-hydration that reconciles stored rows into the live ","type":"text"},{"type":"codeVoice","code":"EntityStore"},{"text":"s","type":"text"},{"text":" ","type":"text"},{"text":"without dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"metadata":{"roleHeading":"Instance Method","role":"symbol","title":"rehydrate(into:policy:)","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Store","preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"type":"codeVoice","code":"State"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":"."}]},"externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE9rehydrate4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","extendedModule":"SwiduxPersistence","modules":[{"name":"SwiduxPersistence"}]},"kind":"symbol","identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"preciseIdentifier":"s:ScM","kind":"attribute","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","text":"Store"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","text":"MergePolicy"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"}]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The live store to reconcile."}],"type":"paragraph"}],"name":"store"},{"content":[{"inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only. Pass"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive"},{"type":"text","text":" after a container rebuild,"},{"type":"text","text":" "},{"type":"text","text":"where a row’s absence says nothing about whether it was deleted."}],"type":"paragraph"}],"name":"policy"}]},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Takes the store rather than "},{"type":"codeVoice","code":"inout State"},{"type":"text","text":" on purpose. Re-hydration is a"},{"type":"text","text":" "},{"type":"text","text":"mid-session operation with two "},{"type":"codeVoice","code":"await"},{"type":"text","text":"s in it (the flush, then the"},{"type":"text","text":" "},{"type":"text","text":"fetches), and any caller holding a state snapshot across those would"},{"type":"text","text":" "},{"type":"text","text":"overwrite everything dispatched in between. Here the flush and every"},{"type":"text","text":" "},{"type":"text","text":"fetch complete first; only then does one suspension-free step pack a"},{"type":"text","text":" "},{"type":"text","text":"fresh snapshot, merge, and unpack."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Under the default "},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","type":"reference"},{"type":"text","text":", remote edits and remote"},{"type":"text","text":" "},{"type":"text","text":"deletions surface mid-session. An ID is exempt whenever the local side"},{"type":"text","text":" "},{"type":"text","text":"still has something to say about it — a drained-but-unflushed write, an"},{"type":"text","text":" "},{"type":"text","text":"un-drained edit, a pending deletion, or a write whose save failed. Those"},{"type":"text","text":" "},{"type":"text","text":"always win, and that guarantee is not configurable."}],"type":"paragraph"},{"inlineContent":[{"text":"Pending writes and deletions are flushed to disk ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"emphasis"},{"text":" the merge, so a","type":"text"},{"text":" ","type":"text"},{"text":"remote-change refresh that fires during the debounce window can’t read a","type":"text"},{"text":" ","type":"text"},{"text":"stale disk row for an entity the user just edited or deleted and resurrect","type":"text"},{"text":" ","type":"text"},{"text":"it. The flush closes most of the window; the dirty set closes what the","type":"text"},{"text":" ","type":"text"},{"text":"remaining suspension points let through.","type":"text"}],"type":"paragraph"},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"type":"text","text":"One case is beyond reach — an edit that is still in a view’s"},{"type":"text","text":" "},{"type":"text","text":"local "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" and has not been dispatched yet is invisible to the"},{"type":"text","text":" "},{"type":"text","text":"store, so a remote value can land underneath it. Bindings made with"},{"type":"text","text":" "},{"type":"codeVoice","code":"store.binding(_:sending:)"},{"type":"text","text":" dispatch on write and are therefore"},{"type":"text","text":" "},{"type":"text","text":"covered. For a store backing a live text editor, register it with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory"},{"type":"text","text":"."}],"type":"paragraph"}]},{"inlineContent":[{"text":"If a fetch fails, the corresponding ","type":"text"},{"type":"codeVoice","code":"EntityStore"},{"text":" is left untouched","type":"text"},{"text":" ","type":"text"},{"text":"and the failure is reported via ","type":"text"},{"type":"codeVoice","code":"onFailure"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)"]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"type":"topic","title":"SwiduxPersistence","abstract":[],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","url":"\/documentation\/swiduxpersistence","role":"collection"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferInMemory":{"url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferinmemory","title":"preferInMemory","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","abstract":[{"text":"Additive-only: the in-memory value wins for every ID already held, and","type":"text"},{"text":" ","type":"text"},{"text":"nothing is ever removed.","type":"text"}],"kind":"symbol","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"preferInMemory","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"}],"type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/rehydrate(into:policy:)":{"type":"topic","title":"rehydrate(into:policy:)","abstract":[{"text":"Re-hydration that reconciles stored rows into the live ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":"s","type":"text"},{"text":" ","type":"text"},{"text":"without dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Store","preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)","role":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferRemoteAdditive":{"abstract":[{"text":"Remote edits surface, but absence from the snapshot never removes a live","type":"text"},{"text":" ","type":"text"},{"text":"entity.","type":"text"}],"title":"preferRemoteAdditive","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive","url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferremoteadditive","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"preferRemoteAdditive"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy"}],"type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"abstract":[{"text":"A generic ","type":"text"},{"type":"codeVoice","code":"@ModelActor"},{"type":"text","text":" that reads and writes any "},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","type":"reference"},{"type":"text","text":"."}],"title":"EntityDB","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","url":"\/documentation\/swiduxpersistence\/entitydb","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityDB"}],"navigatorTitle":[{"kind":"identifier","text":"EntityDB"}],"type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy":{"type":"topic","title":"MergePolicy","abstract":[{"text":"How ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"text":" resolves a storage","type":"text"},{"text":" ","type":"text"},{"text":"snapshot against live in-memory state.","type":"text"}],"navigatorTitle":[{"text":"MergePolicy","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MergePolicy","kind":"identifier"}],"url":"\/documentation\/swiduxpersistence\/mergepolicy","role":"symbol"},"doc://Swidux/documentation/Swidux/Store":{"type":"topic","title":"Store","abstract":[{"text":"Generic store that owns the dispatch cycle, plugin lifecycle, and","type":"text"},{"text":" ","type":"text"},{"text":"observation layer.","type":"text"}],"navigatorTitle":[{"text":"Store","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"url":"\/documentation\/swidux\/store","role":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator":{"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistenceCoordinator"}],"kind":"symbol","url":"\/documentation\/swiduxpersistence\/persistencecoordinator","navigatorTitle":[{"kind":"identifier","text":"PersistenceCoordinator"}],"abstract":[{"type":"text","text":"Owns the "},{"type":"codeVoice","code":"ModelContainer"},{"type":"text","text":" + generic "},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","type":"reference"},{"type":"text","text":" and wires the registered"},{"type":"text","text":" "},{"type":"text","text":"entities into a "},{"type":"codeVoice","code":"Swidux.PersistencePlugin"},{"type":"text","text":"."}],"title":"PersistenceCoordinator","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","type":"topic","role":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferRemote":{"url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferremote","title":"preferRemote","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","abstract":[{"type":"text","text":"Remote edits and deletions surface mid-session; a pending local write"},{"type":"text","text":" "},{"type":"text","text":"still wins. The default."}],"kind":"symbol","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"preferRemote","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"}],"type":"topic"}}}