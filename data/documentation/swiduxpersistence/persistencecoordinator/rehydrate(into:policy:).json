{"abstract":[{"type":"text","text":"Re-hydration that reconciles stored rows into the live "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"without dropping unflushed writes or in-progress edits (rule #8)."}],"variants":[{"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"kind":"text","text":": "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","kind":"typeIdentifier","text":"Store","preciseIdentifier":"s:6Swidux5StoreC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","kind":"typeIdentifier","text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The live store to reconcile.","type":"text"}]}],"name":"store"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Narrows the configured policy for this call only. Pass","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive","isActive":true},{"text":" after a container rebuild,","type":"text"},{"text":" ","type":"text"},{"text":"where a row’s absence says nothing about whether it was deleted.","type":"text"}]}],"name":"policy"}],"kind":"parameters"},{"content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Takes the store rather than ","type":"text"},{"type":"codeVoice","code":"inout State"},{"text":" on purpose. Re-hydration is a","type":"text"},{"text":" ","type":"text"},{"text":"mid-session operation with two ","type":"text"},{"type":"codeVoice","code":"await"},{"text":"s in it (the flush, then the","type":"text"},{"text":" ","type":"text"},{"text":"fetches), and any caller holding a state snapshot across those would","type":"text"},{"text":" ","type":"text"},{"text":"overwrite everything dispatched in between. Here the flush and every","type":"text"},{"text":" ","type":"text"},{"text":"fetch complete first; only then does one suspension-free step pack a","type":"text"},{"text":" ","type":"text"},{"text":"fresh snapshot, merge, and unpack.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Under the default ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","type":"reference","isActive":true},{"text":", remote edits and remote","type":"text"},{"text":" ","type":"text"},{"text":"deletions surface mid-session. An ID is exempt whenever the local side","type":"text"},{"type":"text","text":" "},{"type":"text","text":"still has something to say about it — a drained-but-unflushed write, an"},{"type":"text","text":" "},{"type":"text","text":"un-drained edit, a pending deletion, or a write whose save failed. Those"},{"type":"text","text":" "},{"type":"text","text":"always win, and that guarantee is not configurable."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pending writes and deletions are flushed to disk "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"text":" the merge, so a","type":"text"},{"text":" ","type":"text"},{"text":"remote-change refresh that fires during the debounce window can’t read a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"stale disk row for an entity the user just edited or deleted and resurrect"},{"text":" ","type":"text"},{"text":"it. The flush closes most of the window; the dirty set closes what the","type":"text"},{"text":" ","type":"text"},{"text":"remaining suspension points let through.","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":"One case can’t be inferred — an edit still sitting in a"},{"type":"text","text":" "},{"text":"view’s local ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" has never reached the store, so a remote value","type":"text"},{"text":" ","type":"text"},{"text":"can land underneath it. Bindings made with ","type":"text"},{"code":"store.binding(_:sending:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"dispatch on write and are covered already. Otherwise declare the edit","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","type":"reference","isActive":true},{"text":" (see ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds","isActive":true},{"text":"), which exempts one ID for as","type":"text"},{"text":" ","type":"text"},{"text":"long as it is being edited, or register a whole collection with","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","name":"Important","style":"important"},{"inlineContent":[{"type":"text","text":"If a fetch fails, the corresponding "},{"type":"codeVoice","code":"EntityStore"},{"text":" is left untouched","type":"text"},{"text":" ","type":"text"},{"text":"and the failure is reported via ","type":"text"},{"type":"codeVoice","code":"onFailure"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"metadata":{"modules":[{"name":"SwiduxPersistence"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"text":"into","kind":"externalParam"},{"kind":"text","text":": "},{"text":"Store","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC"},{"kind":"text","text":"<"},{"text":"State","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"Action","kind":"typeIdentifier"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"role":"symbol","extendedModule":"SwiduxPersistence","title":"rehydrate(into:policy:)","symbolKind":"method","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"type":"codeVoice","code":"State"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"SwiduxObservable"},{"text":".","type":"text"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE9rehydrate4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","roleHeading":"Instance Method"},"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","interfaceLang