dedModule":"SwiduxPersistence","role":"symbol","roleHeading":"Instance Method","title":"rehydrate(into:policy:)"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"store","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","text":"Store","preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"name":"store","content":[{"type":"paragraph","inlineContent":[{"text":"The live store to reconcile.","type":"text"}]}]},{"name":"policy","content":[{"type":"paragraph","inlineContent":[{"text":"Narrows the configured policy for this call only. Pass","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive","type":"reference"},{"text":" after a container rebuild,","type":"text"},{"text":" ","type":"text"},{"text":"where a row’s absence says nothing about whether it was deleted.","type":"text"}]}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Takes the store rather than "},{"type":"codeVoice","code":"inout State"},{"type":"text","text":" on purpose. Re-hydration is a"},{"type":"text","text":" "},{"text":"mid-session operation with two ","type":"text"},{"code":"await","type":"codeVoice"},{"type":"text","text":"s in it (the flush, then the"},{"text":" ","type":"text"},{"text":"fetches), and any caller holding a state snapshot across those would","type":"text"},{"type":"text","text":" "},{"type":"text","text":"overwrite everything dispatched in between. Here the flush and every"},{"type":"text","text":" "},{"type":"text","text":"fetch complete first; only then does one suspension-free step pack a"},{"type":"text","text":" "},{"type":"text","text":"fresh snapshot, merge, and unpack."}]},{"inlineContent":[{"type":"text","text":"Under the default "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote"},{"type":"text","text":", remote edits and remote"},{"type":"text","text":" "},{"type":"text","text":"deletions surface mid-session. An ID is exempt whenever the local side"},{"type":"text","text":" "},{"type":"text","text":"still has something to say about it — a drained-but-unflushed write, an"},{"type":"text","text":" "},{"type":"text","text":"un-drained edit, a pending deletion, or a write whose save failed. Those"},{"type":"text","text":" "},{"type":"text","text":"always win, and that guarantee is not configurable."}],"type":"paragraph"},{"inlineContent":[{"text":"Pending writes and deletions are flushed to disk ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"text":" the merge, so a","type":"text"},{"text":" ","type":"text"},{"text":"remote-change refresh that fires during the debounce window can’t read a","type":"text"},{"text":" ","type":"text"},{"text":"stale disk row for an entity the user just edited or deleted and resurrect","type":"text"},{"text":" ","type":"text"},{"text":"it. The flush closes most of the window; the dirty set closes what the","type":"text"},{"text":" ","type":"text"},{"text":"remaining suspension points let through.","type":"text"}],"type":"paragraph"},{"style":"important","name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"One case can’t be inferred — an edit still sitting in a","type":"text"},{"text":" ","type":"text"},{"text":"view’s local ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" has never reached the store, so a remote value","type":"text"},{"text":" ","type":"text"},{"text":"can land underneath it. Bindings made with ","type":"text"},{"code":"store.binding(_:sending:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"dispatch on write and are covered already. Otherwise declare the edit","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing"},{"type":"text","text":" (see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds"},{"type":"text","text":"), which exempts one ID for as"},{"text":" ","type":"text"},{"text":"long as it is being edited, or register a whole collection with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory"},{"text":".","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"text":"If a fetch fails, the corresponding ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":" is left untouched","type":"text"},{"text":" ","type":"text"},{"text":"and the failure is reported via ","type":"text"},{"code":"onFailure","type":"codeVoice"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"If another merge commits during a read, the operation re-reads against"},{"type":"text","text":" "},{"type":"text","text":"that newer state before applying anything. Replacing the database"},{"type":"text","text":" "},{"type":"text","text":"discards any reads still in flight against the previous container."}]}],"kind":"content"}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferRemote":{"kind":"symbol","abstract":[{"text":"Remote edits and deletions surface mid-session; a pending local write","type":"text"},{"type":"text","text":" "},{"type":"text","text":"still wins. The default."}],"type":"topic","url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferremote","title":"preferRemote","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"preferRemote"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EditingHolds":{"kind":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EditingHolds","kind":"identifier"}],"url":"\/documentation\/swiduxpersistence\/editingholds","role":"symbol","title":"EditingHolds","type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds","navigatorTitle":[{"text":"EditingHolds","kind":"identifier"}],"abstract":[{"text":"IDs an app has declared it is editing, exempt from a re-hydration merge for","type":"text"},{"text":" ","type":"text"},{"text":"as long as the hold is in force.","type":"text"}]},"doc://Swidux/documentation/Swidux/Store":{"abstract":[{"type":"text","text":"Generic s