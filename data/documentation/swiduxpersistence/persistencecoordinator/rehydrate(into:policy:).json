"kind":"keyword"},{"text":" ","kind":"text"},{"text":"preferRemote","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy","kind":"typeIdentifier"}],"title":"preferRemote","url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferremote","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator":{"title":"PersistenceCoordinator","navigatorTitle":[{"kind":"identifier","text":"PersistenceCoordinator"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","role":"symbol","abstract":[{"text":"Owns the ","type":"text"},{"type":"codeVoice","code":"ModelContainer"},{"text":" + generic ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB"},{"text":" and wires the registered","type":"text"},{"text":" ","type":"text"},{"text":"entities into a ","type":"text"},{"type":"codeVoice","code":"Swidux.PersistencePlugin"},{"text":".","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistenceCoordinator"}],"url":"\/documentation\/swiduxpersistence\/persistencecoordinator","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EditingHolds":{"title":"EditingHolds","navigatorTitle":[{"kind":"identifier","text":"EditingHolds"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds","role":"symbol","abstract":[{"text":"IDs an app has declared it is editing, exempt from a re-hydration merge for","type":"text"},{"text":" ","type":"text"},{"text":"as long as the hold is in force.","type":"text"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EditingHolds"}],"url":"\/documentation\/swiduxpersistence\/editingholds","type":"topic"},"doc://Swidux