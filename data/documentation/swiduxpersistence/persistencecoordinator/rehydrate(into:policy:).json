{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","interfaceLanguage":"swift"},"sections":[],"kind":"symbol","metadata":{"externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE9rehydrate4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","modules":[{"name":"SwiduxPersistence"}],"role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC","text":"Store"},{"kind":"text","text":"<"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"typeIdentifier","text":"Action"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"roleHeading":"Instance Method","extendedModule":"SwiduxPersistence","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"State","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"SwiduxObservable","type":"codeVoice"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"symbolKind":"method","title":"rehydrate(into:policy:)"},"abstract":[{"type":"text","text":"Re-hydration that reconciles stored rows into the live "},{"code":"EntityStore","type":"codeVoice"},{"text":"s","type":"text"},{"text":" ","type":"text"},{"text":"without dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"variants":[{"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"store","kind":"internalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","text":"Store"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","text":"MergePolicy"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"}],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The live store to reconcile."}],"type":"paragraph"}],"name":"store"},{"content":[{"inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only. Pass"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive","type":"reference","isActive":true},{"type":"text","text":" after a container rebuild,"},{"type":"text","text":" "},{"type":"text","text":"where a row’s absence says nothing about whether it was deleted."}],"type":"paragraph"}],"name":"policy"}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"discussion","level":2,"text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Takes the store rather than "},{"type":"codeVoice","code":"inout State"},{"type":"text","text":" on purpose. Re-hydration is a"},{"type":"text","text":" "},{"type":"text","text":"mid-session operation with two "},{"type":"codeVoice","code":"await"},{"type":"text","text":"s in it (the flush, then the"},{"type":"text","text":" "},{"type":"text","text":"fetches), and any caller holding a state snapshot across those would"},{"type":"text","text":" "},{"type":"text","text":"overwrite everything dispatched in between. Here the flush and every"},{"type":"text","text":" "},{"type":"text","text":"fetch complete first; only then does one suspension-free step pack a"},{"type":"text","text":" "},{"type":"text","text":"fresh snapshot, merge, and unpack."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Under the default "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote"},{"type":"text","text":", remote edits and remote"},{"type":"text","text":" "},{"type":"text","text":"deletions surface mid-session. An ID is exempt whenever the local side"},{"type":"text","text":" "},{"type":"text","text":"still has something to say about it — a drained-but-unflushed write, an"},{"type":"text","text":" "},{"type":"text","text":"un-drained edit, a pending deletion, or a write whose save failed. Those"},{"type":"text","text":" "},{"type":"text","text":"always win, and that guarantee is not configurable."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pending writes and deletions are flushed to disk "},{"inlineContent":[{"type":"text","text":"before"}],"type":"emphasis"},{"type":"text","text":" the merge, so a"},{"type":"text","text":" "},{"type":"text","text":"remote-change refresh that fires during the debounce window can’t read a"},{"type":"text","text":" "},{"type":"text","text":"stale disk row for an entity the user just edited or deleted and resurrect"},{"type":"text","text":" "},{"type":"text","text":"it. The flush closes most of the window; the dirty set closes what the"},{"type":"text","text":" "},{"type":"text","text":"remaining suspension points let through."}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"One case can’t be inferred — an edit still sitting in a"},{"type":"text","text":" "},{"type":"text","text":"view’s local "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" has never reached the store, so a remote value"},{"type":"text","text":" "},{"type":"text","text":"can land underneath it. Bindings made with "},{"code":"store.binding(_:sending:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"dispatch on write and are covered already. Otherwise declare the edit"},{"type":"text","text":" "},{"type":"text","text":"with "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","type":"reference","isActive":true},{"type":"text","text":" (see "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds","type":"reference","isActive":true},{"type":"text","text":"), which exempts one ID for as"},{"type":"text","text":" "},{"type":"text","text":"long as it is being edited, or register a whole collection with"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","type":"reference","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"name":"Important","style":"important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If a fetch fails, the corresponding "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":" is left untouched"},{"type":"text","text":" "},{"type":"text","text":"and the failure is reported via "},{"type":"codeVoice","code":"onFailure"},{"type":"text","text":"."}]}],"kind":"content"}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferRemote":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","role":"symbol","url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferremote","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"preferRemote"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier","text":"MergePolicy"}],"abstract":[{"type":"text","text":"Remote edits and deletions surface mid-session; a pending local write"},{"type":"text","text":" "},{"type":"text","text":"still wins. The default."}],"title":"preferRemote"},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","abstract":[],"url":"\/documentation\/swiduxpersistence","title":"SwiduxPersistence","role":"collection","kind":"symbol","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"navigatorTitle":[{"kind":"identifier","text":"EntityDB"}],"url":"\/documentation\/swiduxpersistence\/entitydb","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityDB"}],"abstract":[{"type":"text","text":"A generic "},{"type":"codeVoice","code":"@ModelActor"},{"type":"text","text":" that reads and writes any "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","isActive":true},{"type":"text","text":"."}],"title":"EntityDB","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferRemoteAdditive":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive","role":"symbol","url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferremoteadditive","type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"preferRemoteAdditive"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier","text":"MergePolicy"}],"abstract":[{"type":"text","text":"Remote edits surface, but absence from the snapshot never removes a live"},{"type":"text","text":" "},{"type":"text","text":"entity."}],"title":"preferRemoteAdditive"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferInMemory":{"role":"symbol","title":"preferInMemory","url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferinmemory","abstract":[{"text":"Additive-only: the in-memory value wins for every ID already held, and","type":"text"},{"text":" ","type":"text"},{"text":"nothing is ever removed.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"preferInMemory"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier","text":"MergePolicy"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/editing":{"kind":"symbol","abstract":[{"text":"Entities the app has declared it is editing, exempt from the merge until","type":"text"},{"text":" ","type":"text"},{"text":"released.","type":"text"}],"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"editing","kind":"identifier"},{"text":": ","kind":"text"},{"text":"EditingHolds","preciseIdentifier":"s:17SwiduxPersistence12EditingHoldsC","kind":"typeIdentifier"}],"url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/editing","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","role":"symbol","title":"editing"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EditingHolds":{"role":"symbol","title":"EditingHolds","url":"\/documentation\/swiduxpersistence\/editingholds","abstract":[{"text":"IDs an app has declared it is editing, exempt from a re-hydration merge for","type":"text"},{"text":" ","type":"text"},{"text":"as long as the hold is in force.","type":"text"}],"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds","navigatorTitle":[{"text":"EditingHolds","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"EditingHolds","kind":"identifier"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator":{"role":"symbol","title":"PersistenceCoordinator","url":"\/documentation\/swiduxpersistence\/persistencecoordinator","abstract":[{"type":"text","text":"Owns the "},{"code":"ModelContainer","type":"codeVoice"},{"type":"text","text":" + generic "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","isActive":true},{"type":"text","text":" and wires the registered"},{"type":"text","text":" "},{"type":"text","text":"entities into a "},{"code":"Swidux.PersistencePlugin","type":"codeVoice"},{"type":"text","text":"."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","navigatorTitle":[{"text":"PersistenceCoordinator","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"PersistenceCoordinator","kind":"identifier"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/rehydrate(into:policy:)":{"role":"symbol","title":"rehydrate(into:policy:)","url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)","abstract":[{"type":"text","text":"Re-hydration that reconciles stored rows into the live "},{"code":"EntityStore","type":"codeVoice"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"without dropping unflushed writes or in-progress edits (rule #8)."}],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Store","preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}]},"doc://Swidux/documentation/Swidux/Store":{"navigatorTitle":[{"text":"Store","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"type":"text","text":"observation layer."}],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"url":"\/documentation\/swidux\/store","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","role":"symbol","title":"Store"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy":{"role":"symbol","title":"MergePolicy","url":"\/documentation\/swiduxpersistence\/mergepolicy","abstract":[{"type":"text","text":"How "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true},{"type":"text","text":" resolves a storage"},{"type":"text","text":" "},{"type":"text","text":"snapshot against live in-memory state."}],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","type":"topic","navigatorTitle":[{"text":"MergePolicy","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MergePolicy","kind":"identifier"}]}}}