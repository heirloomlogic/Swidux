{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC","text":"Store","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","text":"MergePolicy"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"store","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The live store to reconcile."}]}]},{"name":"policy","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only. Pass"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive","isActive":true},{"type":"text","text":" after a container rebuild,"},{"type":"text","text":" "},{"text":"where a row’s absence says nothing about whether it was deleted.","type":"text"}]}]}],"kind":"parameters"},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"Takes the store rather than ","type":"text"},{"type":"codeVoice","code":"inout State"},{"text":" on purpose. Re-hydration is a","type":"text"},{"text":" ","type":"text"},{"text":"mid-session operation with two ","type":"text"},{"type":"codeVoice","code":"await"},{"text":"s in it (the flush, then the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"fetches), and any caller holding a state snapshot across those would"},{"type":"text","text":" "},{"type":"text","text":"overwrite everything dispatched in between. Here the flush and every"},{"type":"text","text":" "},{"type":"text","text":"fetch complete first; only then does one suspension-free step pack a"},{"type":"text","text":" "},{"type":"text","text":"fresh snapshot, merge, and unpack."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Under the default "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote"},{"type":"text","text":", remote edits and remote"},{"type":"text","text":" "},{"type":"text","text":"deletions surface mid-session. An ID is exempt whenever the local side"},{"type":"text","text":" "},{"type":"text","text":"still has something to say about it — a drained-but-unflushed write, an"},{"type":"text","text":" "},{"type":"text","text":"un-drained edit, a pending deletion, or a write whose save failed. Those"},{"type":"text","text":" "},{"type":"text","text":"always win, and that guarantee is not configurable."}]},{"type":"paragraph","inlineContent":[{"text":"Pending writes and deletions are flushed to disk ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"text":" the merge, so a","type":"text"},{"text":" ","type":"text"},{"text":"remote-change refresh that fires during the debounce window can’t read a","type":"text"},{"text":" ","type":"text"},{"text":"stale disk row for an entity the user just edited or deleted and resurrect","type":"text"},{"text":" ","type":"text"},{"text":"it. The flush closes most of the window; the dirty set closes what the","type":"text"},{"text":" ","type":"text"},{"text":"remaining suspension points let through.","type":"text"}]},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"text":"One case is beyond reach — an edit that is still in a view’s","type":"text"},{"text":" ","type":"text"},{"text":"local ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" and has not been dispatched yet is invisible to the","type":"text"},{"text":" ","type":"text"},{"text":"store, so a remote value can land underneath it. Bindings made with","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"store.binding(_:sending:)"},{"type":"text","text":" dispatch on write and are therefore"},{"type":"text","text":" "},{"type":"text","text":"covered. For a store backing a live text editor, register it with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory"},{"type":"text","text":"."}],"type":"paragraph"}]},{"inlineContent":[{"text":"If a fetch fails, the corresponding ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":" is left untouched","type":"text"},{"text":" ","type":"text"},{"text":"and the failure is reported via ","type":"text"},{"code":"onFailure","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"sections":[],"metadata":{"symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"rehydrate","kind":"identifier"},{"kind"