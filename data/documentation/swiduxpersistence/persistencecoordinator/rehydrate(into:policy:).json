{"abstract":[{"text":"Re-hydration that reconciles stored rows into the live ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":"s","type":"text"},{"text":" ","type":"text"},{"text":"without dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"sections":[],"metadata":{"extendedModule":"SwiduxPersistence","conformance":{"constraints":[{"type":"codeVoice","code":"State"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Store","preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"modules":[{"name":"SwiduxPersistence"}],"symbolKind":"method","roleHeading":"Instance Method","title":"rehydrate(into:policy:)","externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE9rehydrate4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","role":"symbol"},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"variants":[{"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"kind":"text","text":": "},{"text":"Store","preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"}]}]},{"kind":"parameters","parameters":[{"name":"store","content":[{"inlineContent":[{"type":"text","text":"The live store to reconcile."}],"type":"paragraph"}]},{"name":"policy","content":[{"type":"paragraph","inlineContent":[{"text":"Narrows the configured policy for this call only. Pass","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive"},{"text":" after a container rebuild,","type":"text"},{"text":" ","type":"text"},{"text":"where a row’s absence says nothing about whether it was deleted.","type":"text"}]}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"text":"Takes the store rather than ","type":"text"},{"code":"inout State","type":"codeVoice"},{"text":" on purpose. Re-hydration is a","type":"text"},{"text":" ","type":"text"},{"text":"mid-session operation with two ","type":"text"},{"code":"await","type":"codeVoice"},{"text":"s in it (the flush, then the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"fetches), and any caller holding a state snapshot across those would"},{"type":"text","text":" "},{"text":"overwrite everything dispatched in between. Here the flush and every","type":"text"},{"text":" ","type":"text"},{"text":"fetch complete first; only then does one suspension-free step pack a","type":"text"},{"text":" ","type":"text"},{"text":"fresh snapshot, merge, and unpack.","type":"text"}]},{"inlineContent":[{"text":"Under the default ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","isActive":true,"type":"reference"},{"text":", remote edits and remote","type":"text"},{"text":" ","type":"text"},{"text":"deletions surface mid-session. An ID is exempt whenever the local side","type":"text"},{"text":" ","type":"text"},{"text":"still has something to say about it — a drained-but-unflushed write, an","type":"text"},{"text":" ","type":"text"},{"text":"un-drained edit, a pending deletion, or a write whose save failed. Those","type":"text"},{"text":" ","type":"text"},{"text":"always win, and that guarantee is not configurable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Pending writes and deletions are flushed to disk "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" the merge, so a"},{"type":"text","text":" "},{"type":"text","text":"remote-change refresh that fires during the debounce window can’t read a"},{"type":"text","text":" "},{"type":"text","text":"stale disk row for an entity the user just edited or deleted and resurrect"},{"type":"text","text":" "},{"type":"text","text":"it. The flush closes most of the window; the dirty set closes what the"},{"type":"text","text":" "},{"type":"text","text":"remaining suspension points let through."}],"type":"paragraph"},{"name":"Important","style":"important","content":[{"inlineContent":[{"type":"text","text":"One case can’t be inferred — an edit still sitting in a"},{"type":"text","text":" "},{"type":"text","text":"view’s local "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" has never reached the store, so a remote value"},{"type":"text","text":" "},{"type":"text","text":"can land underneath it. Bindings made with "},{"type":"codeVoice","code":"store.binding(_:sending:)"},{"type":"text","text":" "},{"type":"text","text":"dispatch on write and are covered already. Otherwise declare the edit"},{"type":"text","text":" "},{"type":"text","text":"with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing"},{"type":"text","text":" (see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds"},{"type":"text","text":"), which exempts one ID for as"},{"type":"text","text":" "},{"type":"text","text":"long as it is being edited, or register a whole collection with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside"},{"inlineContent":[{"text":"If a fetch fails, the corresponding ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":" is left untouched","type":"text"},{"text":" ","type":"text"},{"text":"and the failure is reported via ","type":"text"},{"code":"onFailure","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"If another merge commits during a read, the operation re-reads against","type":"text"},{"text":" ","type":"text"},{"text":"that newer state before applying anything. Replacing the database","type":"text"},{"text":" ","type":"text"},{"text":"discards any reads still in flight against the previous container.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"title":"SwiduxPersistence","url":"\/documentation\/swiduxpersistence","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","abstract":[],"type":"topic","role":"collection","kind":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy":{"navigatorTitle":[{"text":"MergePolicy","kind":"identifier"}],"title":"MergePolicy","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","role":"symbol","url":"\/documentation\/swiduxpersistence\/mergepolicy","abstract":[{"type":"text","text":"How "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"text":" resolves a storage","type":"text"},{"text":" ","type":"text"},{"text":"snapshot against live in-memory state.","type":"text"}],"type":"topic","kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MergePolicy","kind":"identifier"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator":{"abstract":[{"type":"text","text":"Owns the "},{"code":"ModelContainer","type":"codeVoice"},{"type":"text","text":" + generic "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB"},{"type":"text","text":" and wires the registered"},{"type":"text","text":" "},{"type":"text","text":"entities into a "},{"code":"Swidux.PersistencePlugin","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","title":"PersistenceCoordinator","role":"symbol","kind":"symbol","url":"\/documentation\/swiduxpersistence\/persistencecoordinator","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistenceCoordinator"}],"navigatorTitle":[{"kind":"identifier","text":"PersistenceCoordinator"}],"type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"abstract":[{"type":"text","text":"A generic "},{"code":"@ModelActor","type":"codeVoice"},{"type":"text","text":" that reads and writes any "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel"},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","title":"EntityDB","role":"symbol","kind":"symbol","url":"\/documentation\/swiduxpersistence\/entitydb","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityDB"}],"navigatorTitle":[{"kind":"identifier","text":"EntityDB"}],"type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/rehydrate(into:policy:)":{"url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Store","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"topic","abstract":[{"type":"text","text":"Re-hydration that reconciles stored rows into the live "},{"code":"EntityStore","type":"codeVoice"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"without dropping unflushed writes or in-progress edits (rule #8)."}],"title":"rehydrate(into:policy:)","kind":"symbol","role":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferRemote":{"title":"preferRemote","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","role":"symbol","url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferremote","abstract":[{"type":"text","text":"Remote edits and deletions surface mid-session; a pending local write"},{"type":"text","text":" "},{"type":"text","text":"still wins. The default."}],"type":"topic","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"preferRemote","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier","text":"MergePolicy"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferInMemory":{"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"preferInMemory","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier","text":"MergePolicy"}],"kind":"symbol","abstract":[{"type":"text","text":"Additive-only: the in-memory value wins for every ID already held, and"},{"type":"text","text":" "},{"type":"text","text":"nothing is ever removed."}],"type":"topic","role":"symbol","title":"preferInMemory","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferinmemory"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/editing":{"title":"editing","url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/editing","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"editing","kind":"identifier"},{"text":": ","kind":"text"},{"text":"EditingHolds","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence12EditingHoldsC"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","abstract":[{"type":"text","text":"Entities the app has declared it is editing, exempt from the merge until"},{"text":" ","type":"text"},{"text":"released.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferRemoteAdditive":{"title":"preferRemoteAdditive","url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferremoteadditive","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"preferRemoteAdditive","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive","abstract":[{"text":"Remote edits surface, but absence from the snapshot never removes a live","type":"text"},{"text":" ","type":"text"},{"text":"entity.","type":"text"}],"type":"topic","role":"symbol","kind":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EditingHolds":{"navigatorTitle":[{"text":"EditingHolds","kind":"identifier"}],"title":"EditingHolds","url":"\/documentation\/swiduxpersistence\/editingholds","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"text":"EditingHolds","kind":"identifier"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds","abstract":[{"type":"text","text":"IDs an app has declared it is editing, exempt from a re-hydration merge for"},{"type":"text","text":" "},{"type":"text","text":"as long as the hold is in force."}],"type":"topic","role":"symbol","kind":"symbol"},"doc://Swidux/documentation/Swidux/Store":{"navigatorTitle":[{"text":"Store","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"kind":"symbol","abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"type":"text","text":"observation layer."}],"type":"topic","role":"symbol","title":"Store","url":"\/documentation\/swidux\/store","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"}}}