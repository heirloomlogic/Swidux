","text":"preferRemoteAdditive"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier","text":"MergePolicy"}],"kind":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator":{"url":"\/documentation\/swiduxpersistence\/persistencecoordinator","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistenceCoordinator"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","navigatorTitle":[{"kind":"identifier","text":"PersistenceCoordinator"}],"title":"PersistenceCoordinator","abstract":[{"type":"text","text":"Owns the "},{"code":"ModelContainer","type":"codeVoice"},{"text":" + generic ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB"},{"type":"text","text":" and wires the registered"},{"text":" ","type":"text"},{"type":"text","text":"entities into a "},{"code":"Swidux.PersistencePlugin","type":"codeVoice"},{"text":".","type":"text"}],"kind":"symbol","role":"symbol","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy":{"url":"\/documentation\/swiduxpersistence\/mergepolicy","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"MergePolicy"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","navigatorTitle":[{"kind":"identifier","text":"MergePolicy"}],"title":"MergePolicy","abstract":[{"type":"text","text":"How "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" resolves a storage"},{"type":"text","text":" "},{"type":"text","text":"snapshot against live in-memory state."}],"kind":"symbol","role":"symbol","type":"topic"},"doc://SwiduxPersistence/