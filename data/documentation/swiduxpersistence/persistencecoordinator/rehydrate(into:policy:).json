{"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","interfaceLanguage":"swift"},"metadata":{"externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE9rehydrate4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","title":"rehydrate(into:policy:)","conformance":{"constraints":[{"type":"codeVoice","code":"State"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"modules":[{"name":"SwiduxPersistence"}],"role":"symbol","extendedModule":"SwiduxPersistence","roleHeading":"Instance Method","symbolKind":"method","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Swidux5StoreC","text":"Store","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}]},"abstract":[{"type":"text","text":"Re-hydration that reconciles stored rows into the live "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"without dropping unflushed writes or in-progress edits (rule #8)."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)"]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","preciseIdentifier":"s:6Swidux5StoreC","text":"Store"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"}],"languages":["swift"],"platforms":["macOS"]}]},{"parameters":[{"name":"store","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The live store to reconcile."}]}]},{"name":"policy","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only. Pass"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive","type":"reference","isActive":true},{"type":"text","text":" after a container rebuild,"},{"type":"text","text":" "},{"type":"text","text":"where a row’s absence says nothing about whether it was deleted."}]}]}],"kind":"parameters"},{"content":[{"type":"heading","anchor":"discussion","text":"Discussion","level":2},{"inlineContent":[{"type":"text","text":"Takes the store rather than "},{"type":"codeVoice","code":"inout State"},{"type":"text","text":" on purpose. Re-hydration is a"},{"type":"text","text":" "},{"type":"text","text":"mid-session operation with two "},{"type":"codeVoice","code":"await"},{"type":"text","text":"s in it (the flush, then the"},{"type":"text","text":" "},{"type":"text","text":"fetches), and any caller holding a state snapshot across those would"},{"type":"text","text":" "},{"type":"text","text":"overwrite everything dispatched in between. Here the flush and every"},{"type":"text","text":" "},{"type":"text","text":"fetch complete first; only then does one suspension-free step pack a"},{"type":"text","text":" "},{"type":"text","text":"fresh snapshot, merge, and unpack."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Under the default "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","isActive":true},{"type":"text","text":", remote edits and remote"},{"type":"text","text":" "},{"type":"text","text":"deletions surface mid-session. An ID is exempt whenever the local side"},{"type":"text","text":" "},{"type":"text","text":"still has something to say about it — a drained-but-unflushed write, an"},{"type":"text","text":" "},{"type":"text","text":"un-drained edit, a pending deletion, or a write whose save failed. Those"},{"type":"text","text":" "},{"type":"text","text":"always win, and that guarantee is not configurable."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Pending writes and deletions are flushed to disk "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" the merge, so a"},{"type":"text","text":" "},{"type":"text","text":"remote-change refresh that fires during the debounce window can’t read a"},{"type":"text","text":" "},{"type":"text","text":"stale disk row for an entity the user just edited or deleted and resurrect"},{"type":"text","text":" "},{"type":"text","text":"it. The flush closes most of the window; the dirty set closes what the"},{"type":"text","text":" "},{"type":"text","text":"remaining suspension points let through."}],"type":"paragraph"},{"name":"Important","type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"One case can’t be inferred — an edit still sitting in a"},{"type":"text","text":" "},{"type":"text","text":"view’s local "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" has never reached the store, so a remote value"},{"type":"text","text":" "},{"type":"text","text":"can land underneath it. Bindings made with "},{"type":"codeVoice","code":"store.binding(_:sending:)"},{"type":"text","text":" "},{"type":"text","text":"dispatch on write and are covered already. Otherwise declare the edit"},{"type":"text","text":" "},{"type":"text","text":"with "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","type":"reference","isActive":true},{"type":"text","text":" (see "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds","type":"reference","isActive":true},{"type":"text","text":"), which exempts one ID for as"},{"type":"text","text":" "},{"type":"text","text":"long as it is being edited, or register a whole collection with"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","type":"reference","isActive":true},{"type":"text","text":"."}]}]},{"inlineContent":[{"type":"text","text":"If a fetch fails, the corresponding "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":" is left untouched"},{"type":"text","text":" "},{"type":"text","text":"and the failure is reported via "},{"type":"codeVoice","code":"onFailure"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","kind":"symbol","type":"topic","abstract":[{"text":"How ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"text":" resolves a storage","type":"text"},{"text":" ","type":"text"},{"text":"snapshot against live in-memory state.","type":"text"}],"role":"symbol","navigatorTitle":[{"text":"MergePolicy","kind":"identifier"}],"url":"\/documentation\/swiduxpersistence\/mergepolicy","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MergePolicy","kind":"identifier"}],"title":"MergePolicy"},"doc://Swidux/documentation/Swidux/Store":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"kind":"symbol","title":"Store","role":"symbol","navigatorTitle":[{"text":"Store","kind":"identifier"}],"type":"topic","abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"type":"text","text":"observation layer."}],"url":"\/documentation\/swidux\/store"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/rehydrate(into:policy:)":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Re-hydration that reconciles stored rows into the live "},{"code":"EntityStore","type":"codeVoice"},{"type":"text","text":"s"},{"text":" ","type":"text"},{"text":"without dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"role":"symbol","url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)","fragments":[{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Store","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"title":"rehydrate(into:policy:)"},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"abstract":[],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","title":"SwiduxPersistence","url":"\/documentation\/swiduxpersistence","kind":"symbol","role":"collection","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferRemoteAdditive":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive","abstract":[{"text":"Remote edits surface, but absence from the snapshot never removes a live","type":"text"},{"text":" ","type":"text"},{"text":"entity.","type":"text"}],"title":"preferRemoteAdditive","url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferremoteadditive","kind":"symbol","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"preferRemoteAdditive"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier","text":"MergePolicy"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/editing