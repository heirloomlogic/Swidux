{"sections":[],"abstract":[{"text":"Re-hydration that reconciles stored rows into the live ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":"s","type":"text"},{"text":" ","type":"text"},{"text":"without dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"kind":"text","text":": "},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier","text":"Store"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier","text":"MergePolicy"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"store","content":[{"type":"paragraph","inlineContent":[{"text":"The live store to reconcile.","type":"text"}]}]},{"name":"policy","content":[{"type":"paragraph","inlineContent":[{"text":"Narrows the configured policy for this call only. Pass","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemoteAdditive","type":"reference","isActive":true},{"text":" after a container rebuild,","type":"text"},{"text":" ","type":"text"},{"text":"where a row’s absence says nothing about whether it was deleted.","type":"text"}]}]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"inlineContent":[{"type":"text","text":"Takes the store rather than "},{"type":"codeVoice","code":"inout State"},{"type":"text","text":" on purpose. Re-hydration is a"},{"type":"text","text":" "},{"type":"text","text":"mid-session operation with two "},{"type":"codeVoice","code":"await"},{"type":"text","text":"s in it (the flush, then the"},{"type":"text","text":" "},{"type":"text","text":"fetches), and any caller holding a state snapshot across those would"},{"type":"text","text":" "},{"type":"text","text":"overwrite everything dispatched in between. Here the flush and every"},{"type":"text","text":" "},{"type":"text","text":"fetch complete first; only then does one suspension-free step pack a"},{"type":"text","text":" "},{"type":"text","text":"fresh snapshot, merge, and unpack."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Under the default "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","type":"reference","isActive":true},{"type":"text","text":", remote edits and remote"},{"type":"text","text":" "},{"type":"text","text":"deletions surface mid-session. An ID is exempt whenever the local side"},{"type":"text","text":" "},{"type":"text","text":"still has something to say about it — a drained-but-unflushed write, an"},{"type":"text","text":" "},{"type":"text","text":"un-drained edit, a pending deletion, or a write whose save failed. Those"},{"type":"text","text":" "},{"type":"text","text":"always win, and that guarantee is not configurable."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Pending writes and deletions are flushed to disk "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the merge, so a"},{"type":"text","text":" "},{"type":"text","text":"remote-change refresh that fires during the debounce window can’t read a"},{"type":"text","text":" "},{"type":"text","text":"stale disk row for an entity the user just edited or deleted and resurrect"},{"type":"text","text":" "},{"type":"text","text":"it. The flush closes most of the window; the dirty set closes what the"},{"type":"text","text":" "},{"type":"text","text":"remaining suspension points let through."}],"type":"paragraph"},{"style":"important","name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"One case can’t be inferred — an edit still sitting in a","type":"text"},{"text":" ","type":"text"},{"text":"view’s local ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" has never reached the store, so a remote value","type":"text"},{"text":" ","type":"text"},{"text":"can land underneath it. Bindings made with ","type":"text"},{"type":"codeVoice","code":"store.binding(_:sending:)"},{"text":" ","type":"text"},{"text":"dispatch on write and are covered already. Otherwise declare the edit","type":"text"},{"text":" ","type":"text"},{"text":"with ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","type":"reference","isActive":true},{"text":" (see ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds","type":"reference","isActive":true},{"text":"), which exempts one ID for as","type":"text"},{"text":" ","type":"text"},{"text":"long as it is being edited, or register a whole collection with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","type":"reference","isActive":true},{"text":".","type":"text"}]}]},{"inlineContent":[{"type":"text","text":"If a fetch fails, the corresponding "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":" is left untouched"},{"type":"text","text":" "},{"type":"text","text":"and the failure is reported via "},{"type":"codeVoice","code":"onFailure"},{"type":"text","text":"."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"title":"rehydrate(into:policy:)","modules":[{"name":"SwiduxPersistence"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Store","preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy"},{"text":"?) ","kind":"text"},{"kind":"keyword","text":"async"}],"roleHeading":"Instance Method","externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE9rehydrate4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","extendedModule":"SwiduxPersistence","role":"symbol","symbolKind":"method","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"State","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"SwiduxObservable","type":"codeVoice"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]}},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persist