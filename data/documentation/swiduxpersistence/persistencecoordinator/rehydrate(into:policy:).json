ype":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" resolves a storage"},{"type":"text","text":" "},{"type":"text","text":"snapshot against live in-memory state."}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EditingHolds":{"url":"\/documentation\/swiduxpersistence\/editingholds","navigatorTitle":[{"text":"EditingHolds","kind":"identifier"}],"kind":"symbol","type":"topic","role":"symbol","title":"EditingHolds","abstract":[{"type":"text","text":"IDs an app has declared it is editing, exempt from a re-hydration merge for"},{"type":"text","text":" "},{"type":"text","text":"as long as the hold is in force."}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EditingHolds","kind":"identifier"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferInMemory":{"url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferinmemory","kind":"symbol","type":"topic","role":"symbol","title":"preferInMemory","abstract":[{"text":"Additive-only: the in-memory value wins for every ID already held, and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"nothing is ever removed."}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"preferInMemory","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/preferRemote":{"url":"\/documentation\/swiduxpersistence\/mergepolicy\/preferremote","kind":"symbol","type":"topic","role":"symbol","title":"preferRemote","abstract":[{"type":"text","text":"Remote edits and deletions surface mid-session; a pending local write"},{"type":"text","text":" "},{"type":"text","text":"still wins. The default."}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"preferRemote","kind":"identifier"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/rehydrate(into:policy:)":{"url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Store","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"kind":"symbol","title":"rehydrate(into:policy:)","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Re-hydration that reconciles stored rows into the live "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"without dropping unflushed writes or in-progress edits (rule #8)."}]},"doc://Swidux