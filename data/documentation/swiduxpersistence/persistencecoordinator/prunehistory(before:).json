pe":"text"},{"text":" ","type":"text"},{"type":"text","text":"app’s."}],"type":"paragraph"},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"A "},{"type":"strong","inlineContent":[{"type":"text","text":"CloudKit-mirrored store is never pruned"}]},{"text":", by this or by","type":"text"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/historyRetention"},{"type":"text","text":", and calling this on one returns 0. Mirroring reads"},{"type":"text","text":" "},{"type":"text","text":"the same transaction log to decide what to export, there is no API to"},{"type":"text","text":" "},{"type":"text","text":"ask how far it has got, and deleting a transaction it has not yet"},{"text":" ","type":"text"},{"type":"text","text":"exported resets the sync state and forces a full re-upload. Apple’s own"},{"type":"text","text":" "},{"type":"text","text":"samples don’t prune mirrored stores either. Unpruned history is the"},{"text":" ","type":"text"},{"type":"text","text":"status quo; a broken export is not."}],"type":"paragraph"}]},{"inlineContent":[{"type":"text","text":"The transaction the current watermark names, and everything after it,"},{"type":"text","text":" "},{"type":"text","text":"is kept whatever its age. On a store nobody has written to for longer"},{"type":"text","text":" "},{"text":"than the retention window, the launch anchor ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"is","type":"text"}]},{"type":"text","text":" one of the doomed"},{"type":"text","text":" "},{"type":"text","text":"transactions, and pruning it would expire the watermark hydration just"},{"type":"text","text":" "},{"text":"installed.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Otherwise pruning is best-effort housekeeping, and a failure is not"},{"type":"text","text":" "},{"type":"tex