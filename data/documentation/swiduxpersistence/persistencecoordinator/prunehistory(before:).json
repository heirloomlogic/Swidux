 "},{"type":"text","text":"ask how far it has got, and deleting a transaction it has not yet"},{"type":"text","text":" "},{"type":"text","text":"exported resets the sync state and forces a full re-upload. Apple’s own"},{"type":"text","text":" "},{"type":"text","text":"samples don’t prune mirrored stores either. Unpruned history is the"},{"type":"text","text":" "},{"type":"text","text":"status quo; a broken export is not."}]}]},{"inlineContent":[{"type":"text","text":"Pruning is best-effort housekeeping: nothing here is load-bearing for"},{"type":"text","text":" "},{"type":"text","text":"correctness, because the watermark lasts one session and any expiry falls"},{"type":"text","text":" "},{"type":"text","text":"back to a full read. A failure is therefore not reported as one."}],"type":"paragraph"}]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"navigatorTitle":[{"kind":"identifier","text":"EntityDB"}],"url":"\/documentation\/swiduxpersistence\/entitydb","type":"topic","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityDB"}],"abstract":[{"type":"text","text":"A generic "},{"type":"codeVoice","code":"@ModelActor"},{"type":"text","text":" that reads and writes any "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","isActive":true},{"type":"text","text":"."}],"title":"EntityDB","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/pruneHistory(before:)":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/pruneHistory(before:)","abstract":[{"type":"text","text":"Deletes persistent-history transactions recorded before "},{"code":"cutoff","type":"codeVoice"},{"type":"text","text":"."}],"url":"\/documentation\/swiduxpersistence\