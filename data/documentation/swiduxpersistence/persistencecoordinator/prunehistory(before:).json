ne mirrored stores either. Unpruned history is the"},{"type":"text","text":" "},{"text":"status quo; a broken export is not.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The transaction the current watermark names, and everything after it,"},{"type":"text","text":" "},{"type":"text","text":"is kept whatever its age. On a store nobody has written to for longer"},{"type":"text","text":" "},{"type":"text","text":"than the retention window, the launch anchor "},{"type":"emphasis","inlineContent":[{"text":"is","type":"text"}]},{"type":"text","text":" one of the doomed"},{"text":" ","type":"text"},{"type":"text","text":"transactions, and pruning it would expire the watermark hydration just"},{"type":"text","text":" "},{"type":"text","text":"installed."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Otherwise pruning is best-effort housekeeping, and a failure is not"},{"type":"text","text":" "},{"text":"reported as one.","type":"text"}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/prunehistory(before:)"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/pruneHistory(before:)","interfaceLanguage":"swift"},"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"title":"SwiduxPersistence","url":"\/documentation\/swiduxpersistence","abstract":[],"role":"collection","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","kind":"symbol","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"abstract":[{"text":"A generic ","type":"text"},{"code":"@ModelActor","type":"codeVoice"},{"text":" that reads and writes any ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","type":"reference","isActive":true},{"text":".","type":"text"}],"kind":"symbol","title