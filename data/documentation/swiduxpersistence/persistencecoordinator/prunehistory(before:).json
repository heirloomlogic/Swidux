{"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@discardableResult"},{"kind":"text","text":" "},{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"pruneHistory"},{"kind":"text","text":"("},{"kind":"externalParam","text":"before"},{"kind":"text","text":" "},{"kind":"internalParam","text":"cutoff"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4DateV","text":"Date"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"}]}],"kind":"declarations"},{"content":[{"text":"Return Value","anchor":"return-value","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"How many transactions were deleted."}],"type":"paragraph"}],"kind":"content"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Runs automatically once per launch from "},{"code":"hydrate(into:)-(Store)","type":"codeVoice"},{"type":"text","text":", using"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/historyRetention","type":"reference","isActive":true},{"type":"text","text":". History is on by default for any file-backed"},{"type":"text","text":" "},{"type":"text","text":"SwiftData store and nothing else trims it, so left alone it grows for the"},{"type":"text","text":" "},{"type":"text","text":"life of the app — deciding that policy is the library’s job, not each"},{"type":"text","text":" "},{"type":"text","text":"app’s."}],"type":"paragraph"},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"inlineContent":[{"text":"CloudKit-mirrored store is never pruned","type":"text"}],"type":"strong"},{"type":"text","text":", by this or by"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/historyRetention","type":"reference","isActive":true},{"type":"text","text":", and calling this on one returns 0. Mirroring reads"},{"type":"text","text":" "},{"type":"text","text":"the same transaction log to decide what to export, there is no API to"},{"type":"text","text":" "},{"type":"text","text":"ask how far it has got, and deleting a transaction it has not yet"},{"type":"text","text":" "},{"type":"text","text":"exported resets the sync state and forces a full re-upload. Apple’s own"},{"type":"text","text":" "},{"type":"text","text":"samples don’t prune mirrored stores either. Unpruned history is the"},{"type":"text","text":" "},{"type":"text","text":"status quo; a broken export is not."}]}]},{"inlineContent":[{"type":"text","text":"Pruning is best-effort housekeeping: nothing here is load-bearing for"},{"type":"text","text":" "},{"type":"text","text":"correctness, because the watermark lasts one session and any expiry falls"},{"type":"text","text":" "},{"type":"text","text":"back to a full read. A failure is therefore not reported as one."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"sections":[],"metadata":{"roleHeading":"Instance Method","modules":[{"name":"SwiduxPersistence"}],"externalID":"s:17SwiduxPersistence0B11CoordinatorC12pruneHistory6beforeSi10Foundation4DateV_tYaF","title":"pruneHistory(before:)","symbolKind":"method","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"pruneHistory"},{"kind":"te