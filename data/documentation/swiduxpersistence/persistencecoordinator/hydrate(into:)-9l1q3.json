{"abstract":[{"text":"First-load hydration: replaces each ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":" with the on-disk rows.","type":"text"}],"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/hydrate(into:)-9l1q3","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":" "},{"kind":"internalParam","text":"state"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Takes "},{"type":"codeVoice","code":"inout State"},{"type":"text","text":" because it runs "},{"type":"emphasis","inlineContent":[{"text":"before the store exists","type":"text"}]},{"type":"text","text":" — the"},{"type":"text","text":" "},{"type":"text","text":"canonical launch sequence hydrates a plain value and hands the result to"},{"type":"text","text":" "},{"type":"codeVoice","code":"Store(initialState:)"},{"type":"text","text":". There is no observer to race with, so there is"},{"type":"text","text":" "},{"type":"text","text":"no lost-write hazard here. Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/hydrate(into:)-2f2yq"},{"type":"text","text":" if the store"},{"text":" ","type":"te