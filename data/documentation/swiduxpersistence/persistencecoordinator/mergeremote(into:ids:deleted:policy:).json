"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"}]},"kind":"symbol","sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"abstract":[{"text":"Re-hydration restricted to the rows a caller already knows changed.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeRemote"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Store","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","preciseIdentifier":"s:6Swidux5StoreC"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"ids","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:10Foundation4UUIDV","text":"UUID","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"deleted","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:10Foundation4UUIDV","text":"UUID","kind":"typeIdentifier"},{"text":"> = [], ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"}],"platforms":["macOS"]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The live store to reconcile.","type":"text"}]}],"name":"store"},{"content":[{"inlineContent":[{"text":"The identities to re-read. IDs matching no row, and IDs","type":"text"},{"text":" ","type":"text"},{"text":"belonging to another entity type, are harmless.","type":"text"}],"type":"paragraph"}],"name":"ids"},{"content":[{"inlineContent":[{"text":"Identities known to have been deleted elsewhere.","type":"text"}],"type":"paragraph"}],"name":"deleted"},{"content":[{"inlineContent":[{"text":"Narrows the configured policy for this call only.","type":"text"}],"type":"paragraph"}],"name":"policy"}],"kind":"parameters"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The O(k) counterpart to "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true},{"type":"text","text":", which re-reads every"},{"type":"text","text":" "},{"type":"text","text":"row of every registered entity on every tick. Where a sync signal carries"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"which"}]},{"type":"text","text":" identities changed, this spends that knowledge: one batched fetch"},{"type":"text","text":" "},{"type":"text","text":"per 500 IDs instead of a full-table scan, and only the named entities are"},{"type":"text","text":" "},{"type":"text","text":"reconciled. Everything else in state is left exactly as it was."}]},{"type":"paragraph","inlineContent":[{"text":"Every guarantee ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true,"type":"reference"},{"text":" makes holds here. Pending","type":"text"},{"text":" ","type":"text"},{"text":"writes are flushed first; an ID with unflushed local intent — a","type":"text"},{"text":" ","type":"text"},{"text":"drained-but-unflushed write, an un-drained edit, a pending deletion, a","type":"text"},{"text":" ","type":"text"},{"text":"write whose save failed, or an ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","isActive":true,"type":"reference"},{"text":" hold — always wins, and that is","type":"text"},{"text":" ","type":"text"},{"text":"not configurable.","type":"text"}]},{"name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"A partial read cannot tell a deleted row from one that was"},{"type":"text","text":" "},{"type":"text","text":"never asked about, so this "},{"type":"strong","inlineContent":[{"type":"text","text":"never"}]},{"type":"text","text":" infers a deletion. An ID vanishes"},{"type":"text","text":" "},{"type":"text","text":"only if you name it in "},{"type":"codeVoice","code":"deleted"},{"type":"text","text":", and only if the resolved policy grants"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/removesMissingEntities"},{"type":"text","text":". Name only what you have positive"},{"type":"text","text":" "},{"type":"text","text":"evidence for — a history tombstone, not an empty fetch. In exchange,"},{"type":"text","text":" "},{"type":"text","text":"there is no empty-snapshot guard to work around: this can remove the"},{"type":"text","text":" "},{"type":"text","text":"last surviving entity, which "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" cannot."}],"type":"paragraph"}],"style":"important"},{"inlineContent":[{"text":"An ID named in ","type":"text"},{"code":"deleted","type":"codeVoice"},{"text":" that storage ","type":"text"},{"inlineContent":[{"type":"text","text":"still holds"}],"type":"emphasis"},{"text":" is not removed. A live","type":"text"},{"text":" ","type":"text"},{"text":"row is evidence the deletion was itself undone elsewhere; a tombstone can","type":"text"},{"text":" ","type":"text"},{"text":"be stale.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Deferred rows are re-offered","anchor":"Deferred-rows-are-re-offered","type":"heading"},{"inlineContent":[{"type":"text","text":"A tick may read a row and decline to apply it — an "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","type":"reference","isActive":true},{"type":"text","text":" hold is the"},{"text":" ","type":"text"},{"text":"one exemption that leaves no other trace. Those rows are remembered by","type":"text"},{"text":" ","type":"text"},{"text":"identity and re-offered on the next call, on top of whatever ","type":"text"},{"code":"ids","type":"codeVoice"},{"text":" names,","type":"text"},{"text":" ","type":"text"},{"text":"so a caller does not have to re-queue them against its own signal. That","type":"text"},{"text":" ","type":"text"},{"text":"matters here because a sync signal is generally not resent and releasing a","type":"text"},{"text":" ","type":"text"},{"text":"hold writes no transaction of its own, so without it a hold would quietly","type":"text"},{"text":" ","type":"text"},{"text":"become a veto. A call whose read throws is remembered the same way: the","type":"text"},{"text":" ","type":"text"},{"text":"identities it was handed are owed, not dropped with the read.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeChanges(into:policy:)","type":"reference"},{"text":" shares the same debt, so","type":"text"},{"text":" ","type":"text"},{"text":"either path settles what the other deferred. Both discard it when the","type":"text"},{"text":" ","type":"text"},{"text":"container is swapped.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Registered ","type":"text"},{"code":"collapse:","type":"codeVoice"},{"text":" resolvers do not run here — a resolver is handed","type":"text"},{"text":" ","type":"text"},{"text":"the whole table and asked which rows survive, and a subset would have it","type":"text"},{"text":" ","type":"text"},{"text":"judge a world it cannot see. Duplicate rows are still collapsed on read","type":"text"},{"text":" ","type":"text"},{"text":"and still reported. Use ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/collapseDuplicates(into:)-7d2no","isActive":true,"type":"reference"},{"text":" or a full","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true,"type":"reference"},{"text":" to reclaim them.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy/removesMissingEntities":{"abstract":[{"type":"text","text":"Whether an ID held in memory but absent from the snapshot — and with no"},{"type":"text","text":" "},{"type":"text","text":"pending local write — is removed as a deletion made elsewhere."}],"kind":"symbol","title":"removesMissingEntities","role":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/removesMissingEntities","type":"topic","url":"\/documentation\/swiduxpersistence\/mergepolicy\/removesmissingentities","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"removesMissingEntities","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","kind":"symbol","title":"PersistenceCoordinator","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"PersistenceCoordinator"}],"abstract":[{"type":"text","text":"Owns the "},{"type":"codeVoice","code":"ModelContainer"},{"type":"text","text":" + generic "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","isActive":true},{"type":"text","text":" and wires the registered"},{"type":"text","text":" "},{"type":"text","text":"entities into a "},{"type":"codeVoice","code":"Swidux.PersistencePlugin"},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/swiduxpersistence\/persistencecoordinator","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistenceCoordinator"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/mergeRemote(into:ids:deleted:policy:)":{"title":"mergeRemote(into:ids:deleted:policy:)","kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)","url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/mergeremote(into:ids:deleted:policy:)","role":"symbol","type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mergeRemote","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Swidux5StoreC","text":"Store","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","k