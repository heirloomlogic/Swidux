t"},{"text":"async","kind":"keyword"}],"extendedModule":"SwiduxPersistence","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"type":"codeVoice","code":"State"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"SwiduxObservable"},{"text":".","type":"text"}]},"roleHeading":"Instance Method","modules":[{"name":"SwiduxPersistence"}]},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mergeRemote","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"store","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Store","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"ids","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"UUID","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4UUIDV"},{"text":">, ","kind":"text"},{"text":"deleted","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"UUID","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4UUIDV"},{"text":"> = [], ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The live store to reconcile."}]}],"name":"store"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The identities to re-read. IDs matching no row, and IDs"},{"type":"text","text":" "},{"type":"text","text":"belonging to another entity type, are harmless."}]}],"name":"ids"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Identities known to have been deleted elsewhere."}]}],"name":"deleted"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only."}]}],"name":"policy"}]},{"kind":"content","content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"text":"The O(k) counterpart to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"text":", which re-reads every","type":"text"},{"text":" ","type":"text"},{"text":"row of every registered entity on every tick. Where a sync signal carries","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"which"}]},{"text":" identities changed, this spends that knowledge: one batched fetch","type":"text"},{"text":" ","type":"text"},{"text":"per 500 IDs instead of a full-table scan, and only the named entities are","type":"text"},{"text":" ","type":"text"},{"text":"reconciled. Everything else in state is left exactly as it was.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Every guarantee ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"text":" makes holds here. Pending","type":"text"},{"text":" ","type":"text"},{"text":"writes are flushed first; an ID with unflushed local intent — a","type":"text"},{"text":" ","type":"text"},{"text":"drained-but-unflushed write, an un-drained edit, a pending deletion, a","type":"text"},{"text":" ","type":"text"},{"text":"write whose save failed, or an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing"},{"text":" hold — always wins, and that is","type":"text"},{"text":" ","type":"text"},{"text":"not configurable.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A partial read cannot tell a deleted row from one that was"},{"type":"text","text":" "},{"type":"text","text":"never asked about, so this "},{"inlineContent":[{"type":"text","text":"never"}],"type":"strong"},{"type":"text","text":" infers a deletion. An ID vanishes"},{"type":"text","text":" "},{"type":"text","text":"only if you name it in "},{"code":"deleted","type":"codeVoice"},{"type":"text","text":", and only if the resolved policy grants"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/removesMissingEntities","type":"reference"},{"type":"text","text":". Name only what you have positive"},{"type":"text","text":" "},{"type":"text","text":"evidence for — a history tombstone, not an empty fetch. In exchange,"},{"type":"text","text":" "},{"type":"text","text":"there is no empty-snapshot guard to work around: this can remove the"},{"type":"text","text":" "},{"type":"text","text":"last surviving entity, which "},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"reference"},{"type":"text","text":" cannot."}]}],"style":"important","name":"Important"},{"type":"paragraph","inlineContent":[{"text":"An ID named in ","type":"text"},{"type":"codeVoice","code":"deleted"},{"text":" that storage ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"still holds"}]},{"text":" is not removed. A live","type":"text"},{"text":" ","type":"text"},{"text":"row is evidence the deletion was itself undone elsewhere; a tombstone can","type":"text"},{"text":" ","type":"text"},{"text":"be stale.","type":"text"}]},{"type":"heading","text":"Deferred rows are re-offered","anchor":"Deferred-rows-are-re-offered","level":2},{"type":"paragraph","inlineContent":[{"text":"A tick may read a row and decline to apply it — an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing"},{"text":" hold is the","type":"text"},{"text":" ","type":"text"},{"text":"one exemption that leaves no other trace. Those rows are remembered by","type":"text"},{"text":" ","type":"text"},{"text":"identity and re-offered on the next call, on top of whatever ","type":"text"},{"type":"codeVoice","code":"ids"},{"text":" names,","type":"text"},{"text":" ","type":"text"},{"text":"so a caller does not have to re-queue them against its own signal. That","type":"text"},{"text":" ","type":"text"},{"text":"matters here because a sync signal is generally not resent and releasing a","type":"text"},{"text":" ","type":"text"},{"text":"hold writes no transaction of its own, so without it a hold would quietly","type":"text"},{"text":" ","type":"text"},{"text":"become a veto. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeChanges(into:policy:)"},{"text":" shares the same debt, so","type":"text"},{"text":" ","type":"text"},{"text":"either path settles what the other deferred. Both discard it when the","type":"text"},{"text":" ","type":"text"},{"text":"container is swapped.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Registered ","type":"text"},{"type":"codeVoice","code":"collapse:"},{"text":" resolvers do not run here — a resolver is handed","type":"text"},{"text":" ","type":"text"},{"text":"the whole table and asked which rows survive, and a subset would have it","type":"text"},{"text":" ","type":"text"},{"text":"judge a world it cannot see. Duplicate rows are still collapsed on read","type":"text"},{"text":" ","type":"text"},{"text":"and still reported. Use ","type":"text"},{"type":"codeVoice","code":"collapseDuplicates(into:)-(Store)"},{"text":" or a full","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"text":" to reclaim them.","type":"text"}]}]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/rehydrate(into:policy:)":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","title":"rehydrate(into:policy:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Re-hydration that reconciles stored rows into the live "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"without dropping unflushed writes or in-progress edits (rule #8)."}],"url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"into"},{"text":": ","kind":"text"},{"t