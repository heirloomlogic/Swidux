dentifier"},{"text":"<","kind":"text"},{"text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"roleHeading":"Instance Method","modules":[{"name":"SwiduxPersistence"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/mergeremote(into:ids:deleted:policy:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeRemote"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Store","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","preciseIdentifier":"s:6Swidux5StoreC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"ids"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"deleted"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV"},{"kind":"text","text":"> = [], "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MergePolicy","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"name":"store","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The live store to reconcile."}]}]},{"name":"ids","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The identities to re-read. IDs matching no row, and IDs"},{"type":"text","text":" "},{"type":"text","text":"belonging to another entity type, are harmless."}]}]},{"name":"deleted","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Identities known to have been deleted elsewhere."}]}]},{"name":"policy","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only."}]}]}],"kind":"parameters"},{"content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"The O(k) counterpart to "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true},{"type":"text","text":", which re-reads every"},{"type":"text","text":" "},{"type":"text","text":"row of every registered entity on every tick. Where a sync signal carries"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"which"}]},{"type":"text","text":" identities changed, this spends that knowledge: one batched fetch"},{"type":"text","text":" "},{"type":"text","text":"per 500 IDs instead of a full-table scan, and only the named entities are"},{"type":"text","text":" "},{"type":"text","text":"reconciled. Everything else in state is left exactly as it was."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every guarantee "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true},{"type":"text","text":" makes holds here. Pending"},{"type":"text","text":" "},{"type":"text","text":"writes are flushed first; an ID with unflushed local intent — a"},{"type":"text","text":" "},{"type":"text","text":"drained-but-unflushed write, an un-drained edit, a pending deletion, a"},{"type":"text","text":" "},{"type":"text","text":"write whose save failed, or an "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","isActive":true},{"type":"text","text":" hold — always wins, and that is"},{"type":"text","text":" "},{"type":"text","text":"not configurable."}],"type":"paragraph"},{"name":"Important","style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A partial read cannot tell a deleted row from one that was"},{"type":"text","text":" "},{"type":"text","text":"never asked about, so this "},{"type":"strong","inlineContent":[{"type":"text","text":"never"}]},{"type":"text","text":" infers a deletion. An ID vanishes"},{"type":"text","text":" "},{"type":"text","text":"only if you name it in "},{"type":"codeVoice","code":"deleted"},{"type":"text","text":", and only if the resolved policy grants"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/removesMissingEntities"},{"type":"text","text":". Name only what you have positive"},{"type":"text","text":" "},{"type":"text","text":"evidence for — a history tombstone, not an empty fetch. In exchange,"},{"type":"text","text":" "},{"type":"text","text":"there is no empty-snapshot guard to work around: this can remove the"},{"type":"text","text":" "},{"type":"text","text":"last surviving entity, which "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" cannot."}]}]},{"inlineContent":[{"type":"text","text":"An ID named in "},{"code":"deleted","type":"codeVoice"},{"type":"text","text":" that storage "},{"type":"emphasis","inlineContent":[{"type":"text","text":"still holds"}]},{"type":"text","text":" is not removed. A live"},{"type":"text","text":" "},{"type":"text","text":"row is evidence the deletion was itself undone elsewhere; a tombstone can"},{"type":"text","text":" "},{"type":"text","text":"be stale."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Registered "},{"code":"collapse:","type":"codeVoice"},{"type":"text","text":" resolvers do not run here — a resolver is handed"},{"type":"text","text":" "},{"type":"text","text":"the whole table and asked which rows survive, and a subset would have it"},{"type":"text","text":" "},{"type":"text","text":"judge a world it cannot see. Duplicate rows are still collapsed on read"},{"type":"text","text":" "},{"type":"text","text":"and still reported. Use "},{"code":"collapseDuplicates(into:)-(Store)","type":"codeVoice"},{"type":"text","text":" or a full"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true},{"type":"text","text":" to reclaim them."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","abstract":[],"url":"\/documentation\/swiduxpersistence","title":"SwiduxPersistence","role":"collection","kind":"symbol","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/mergeRemote(into:ids:deleted:policy:)":{"conformance":{"availabilityPrefix":[{"type":"text","text":"Available 