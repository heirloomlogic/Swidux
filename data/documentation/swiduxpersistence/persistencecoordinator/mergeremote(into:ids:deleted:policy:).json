doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/mergeremote(into:ids:deleted:policy:)"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"abstract":[{"type":"text","text":"Re-hydration restricted to the rows a caller already knows changed."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"mergeRemote"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"into"},{"text":" ","kind":"text"},{"text":"store","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Store","preciseIdentifier":"s:6Swidux5StoreC","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"kind":"externalParam","text":"ids"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4UUIDV","text":"UUID"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"deleted"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sh","text":"Set"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4UUIDV","text":"UUID"},{"kind":"text","text":"> = [], "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","text":"MergePolicy"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"}],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"name":"store","content":[{"type":"paragraph","inlineContent":[{"text":"The live store to reconcile.","type":"text"}]}]},{"name":"ids","content":[{"type":"paragraph","inlineContent":[{"text":"The identities to re-read. IDs matching no row, and IDs","type":"text"},{"text":" ","type":"text"},{"text":"belonging to another entity type, are harmless.","type":"text"}]}]},{"name":"deleted","content":[{"type":"paragraph","inlineContent":[{"text":"Identities known to have been deleted elsewhere.","type":"text"}]}]},{"name":"policy","content":[{"type":"paragraph","inlineContent":[{"text":"Narrows the configured policy for this call only.","type":"text"}]}]}]},{"kind":"content","content":[{"anchor":"discussion","type":"heading","text":"Discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The O(k) counterpart to "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true},{"type":"text","text":", which re-reads every"},{"type":"text","text":" "},{"type":"text","text":"row of every registered entity on every tick. Where a sync signal carries"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"which","type":"text"}]},{"type":"text","text":" identities changed, this spends that knowledge: one batched fetch"},{"type":"text","text":" "},{"type":"text","text":"per 500 IDs instead of a full-table scan, and only the named entities are"},{"type":"text","text":" "},{"type":"text","text":"reconciled. Everything else in state is left exactly as it was."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every guarantee "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true},{"type":"text","text":" makes holds here. Pending"},{"type":"text","text":" "},{"type":"text","text":"writes are flushed first; an ID with unflushed local intent — a"},{"type":"text","text":" "},{"type":"text","text":"drained-but-unflushed write, an un-drained edit, a pending deletion, a"},{"type":"text","text":" "},{"type":"text","text":"write whose save failed, or an "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","isActive":true},{"type":"text","text":" hold — always wins, and that is"},{"type":"text","text":" "},{"type":"text","text":"not configurable."}]},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"A partial read cannot tell a deleted row from one that was","type":"text"},{"text":" ","type":"text"},{"text":"never asked about, so this ","type":"text"},{"inlineContent":[{"text":"never","type":"text"}],"type":"strong"},{"text":" infers a deletion. An ID vanishes","type":"text"},{"text":" ","type":"text"},{"text":"only if you name it in ","type":"text"},{"code":"deleted","type":"codeVoice"},{"text":", and only if the resolved policy grants","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/removesMissingEntities","type":"reference"},{"text":". Name only what you have positive","type":"text"},{"text":" ","type":"text"},{"text":"evidence for — a history tombstone, not an empty fetch. In exchange,","type":"text"},{"text":" ","type":"text"},{"text":"there is no empty-snapshot guard to work around: this can remove the","type":"text"},{"text":" ","type":"text"},{"text":"last surviving entity, which ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"reference"},{"text":" cannot.","type":"text"}]}],"style":"important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An ID named in "},{"code":"deleted","type":"codeVoice"},{"type":"text","text":" that storage "},{"type":"emphasis","inlineContent":[{"text":"still holds","type":"text"}]},{"type":"text","text":" is not removed. A live"},{"type":"text","text":" "},{"type":"text","text":"row is evidence the deletion was itself undone elsewhere; a tombstone can"},{"type":"text","text":" "},{"type":"text","text":"be stale."}]},{"anchor":"Deferred-rows-are-re-offered","type":"heading","text":"Deferred rows are re-offered","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A tick may read a row and decline to apply it — an "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","isActive":true},{"type":"text","text":" hold is the"},{"type":"text","text":" "},{"type":"text","text":"one exemption that leaves no other trace. Those rows are remembered by"},{"type":"text","text":" "},{"type":"text","text":"identity and re-offered on the next call, on top of whatever "},{"code":"ids","type":"codeVoice"},{"type":"text","text":" names,"},{"type":"text","text":" "},{"type":"text","text":"so a caller does not have to re-queue them against its own signal. That"},{"type":"text","text":" "},{"type":"text","text":"matters here because a sync signal is generally not resent and releasing a"},{"type":"text","text":" "},{"type":"text","text":"hold writes no transaction of its own, so without it a hold would quietly"},{"type":"text","text":" "},{"type":"text","text":"become a veto. "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeChanges(into:policy:)","isActive":true},{"type":"text","text":" shares the same debt, so"},{"type":"text","text":" "},{"type":"text","text":"either path settles what the other deferred. Both discard it when the"},{"type":"text","text":" "},{"type":"text","text":"container is swapped."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Registered "},{"code":"collapse:","type":"codeVoice"},{"type":"text","text":" resolvers do not run here — a resolver is handed"},{"type":"text","text":" "},{"type":"text","text":"the whole table and asked which rows survive, and a subset would have it"},{"type":"text","text":" "},{"type":"text","text":"judge a world it cannot see. Duplicate rows are still collapsed on read"},{"type":"text","text":" "},{"type":"text","text":"and still reported. Use "},{"code":"collapseDuplicates(into:)-(Store)","type":"codeVoice"},{"type":"text","text":" or a full"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true},{"type":"text","text":" to reclaim them."}]}]}],"kind":"symbol","references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/mergeChanges(into:policy:)":{"conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"State"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeChanges(into:policy:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"mergeChanges","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:6Swidux5StoreC","text":"Store","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"tex