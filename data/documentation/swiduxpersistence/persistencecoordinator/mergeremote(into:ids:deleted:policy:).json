ersistence\/MergePolicy","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"}],"platforms":["macOS"],"languages":["swift"]}]},{"parameters":[{"name":"store","content":[{"inlineContent":[{"text":"The live store to reconcile.","type":"text"}],"type":"paragraph"}]},{"name":"ids","content":[{"inlineContent":[{"text":"The identities to re-read. IDs matching no row, and IDs","type":"text"},{"text":" ","type":"text"},{"text":"belonging to another entity type, are harmless.","type":"text"}],"type":"paragraph"}]},{"name":"deleted","content":[{"inlineContent":[{"text":"Identities known to have been deleted elsewhere.","type":"text"}],"type":"paragraph"}]},{"name":"policy","content":[{"inlineContent":[{"text":"Narrows the configured policy for this call only.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The O(k) counterpart to ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true,"type":"reference"},{"text":", which re-reads every","type":"text"},{"text":" ","type":"text"},{"text":"row of every registered entity on every tick. Where a sync signal carries","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"which","type":"text"}],"type":"emphasis"},{"text":" identities changed, this spends that knowledge: one batched fetch","type":"text"},{"text":" ","type":"text"},{"text":"per 500 IDs instead of a full-table scan, and only the named entities are","type":"text"},{"text":" ","type":"text"},{"text":"reconciled. Everything else in state is left exactly as it was.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Every guarantee ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true,"type":"reference"},{"text":" makes holds here. Pending","type":"text"},{"text":" ","type":"text"},{"text":"writes are flushed first; an ID with unflushed local intent — a","type":"text"},{"text":" ","type":"text"},{"text":"drained-but-unflushed write, an un-drained edit, a pending deletion, a","type":"text"},{"text":" ","type":"text"},{"text":"write whose save failed, or an ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","isActive":true,"type":"reference"},{"text":" hold — always wins, and that is","type":"text"},{"text":" ","type":"text"},{"text":"not configurable.","type":"text"}]},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"text":"A partial read cannot tell a deleted row from one that was","type":"text"},{"text":" ","type":"text"},{"text":"never asked about, so this ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"never"}]},{"text":" infers a deletion. An ID vanishes","type":"text"},{"text":" ","type":"text"},{"text":"only if you name it in ","type":"text"},{"type":"codeVoice","code":"deleted"},{"text":", and only if the resolved policy grants","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/removesMissingEntities","type":"reference","isActive":true},{"text":". Name only what you have positive","type":"text"},{"text":" ","type":"text"},{"text":"evidence for — a history tombstone, not an empty fetch. In exchange,","type":"text"},{"text":" ","type":"text"},{"text":"there is no empty-snapshot guard to work around: this can remove the","type":"text"},{"text":" ","type":"text"},{"text":"last surviving entity, which ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"reference","isActive":true},{"text":" cannot.","type":"text"}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"An ID named in ","type":"text"},{"type":"codeVoice","code":"deleted"},{"text":" that storage ","type":"text"},{"inlineContent":[{"text":"still holds","type":"text"}],"type":"emphasis"},{"text":" is not removed. A live","type":"text"},{"text":" ","type":"text"},{"text":"row is evidence the deletion was itself undone elsewhere; a tombstone can","type":"text"},{"text":" ","type":"text"},{"text":"be stale.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Registered ","type":"text"},{"type":"codeVoice","code":"collapse:"},{"text":" resolvers do not run here — a resolver is handed","type":"text"},{"text":" ","type":"text"},{"text":"the whole table and asked which rows survive, and a subset would have it","type":"text"},{"text":" ","type":"text"},{"text":"judge a world it cannot see. Duplicate rows are still collapsed on read","type":"text"},{"text":" ","type":"text"},{"text":"and still reported. Use ","type":"text"},{"type":"codeVoice","code":"collapseDuplicates(into:)-(Store)"},{"text":" or a full","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true,"type":"reference"},{"text":" to reclaim them.","type":"text"}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/mergeremote(into:ids:deleted:policy:)"]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","abstract":[{"type":"text","text":"Owns the "},{"type":"codeVoice","code":"ModelContainer"},{"type":"text","text":" + generic "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","isActive":true},{"type":"text","text":" and w