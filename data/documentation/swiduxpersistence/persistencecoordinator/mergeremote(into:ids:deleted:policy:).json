Coordinator\/rehydrate(into:policy:)","isActive":true},{"text":" makes holds here. Pending","type":"text"},{"text":" ","type":"text"},{"text":"writes are flushed first; an ID with unflushed local intent — a","type":"text"},{"text":" ","type":"text"},{"text":"drained-but-unflushed write, an un-drained edit, a pending deletion, a","type":"text"},{"text":" ","type":"text"},{"text":"write whose save failed, or an ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","isActive":true},{"type":"text","text":" hold — always wins, and that is"},{"type":"text","text":" "},{"text":"not configurable.","type":"text"}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A partial read cannot tell a deleted row from one that was"},{"type":"text","text":" "},{"type":"text","text":"never asked about, so this "},{"type":"strong","inlineContent":[{"text":"never","type":"text"}]},{"type":"text","text":" infers a deletion. An ID vanishes"},{"type":"text","text":" "},{"type":"text","text":"only if you name it in "},{"type":"codeVoice","code":"deleted"},{"type":"text","text":", and only if the resolved policy grants"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/removesMissingEntities","isActive":true,"type":"reference"},{"type":"text","text":". Name only what you have positive"},{"type":"text","text":" "},{"type":"text","text":"evidence for — a history tombstone, not an empty fetch. In exchange,"},{"type":"text","text":" "},{"type":"text","text":"there is no empty-snapshot guard to work around: this can remove the"},{"type":"text","text":" "},{"type":"text","text":"last surviving entity, which "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" cannot."}]}],"n