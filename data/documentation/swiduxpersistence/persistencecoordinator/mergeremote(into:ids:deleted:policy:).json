"type":"reference","isActive":true},{"type":"text","text":" makes holds here. Pending"},{"text":" ","type":"text"},{"type":"text","text":"writes are flushed first; an ID with unflushed local intent — a"},{"type":"text","text":" "},{"text":"drained-but-unflushed write, an un-drained edit, a pending deletion, a","type":"text"},{"text":" ","type":"text"},{"text":"write whose save failed, or an ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","isActive":true},{"text":" hold — always wins, and that is","type":"text"},{"text":" ","type":"text"},{"text":"not configurable.","type":"text"}],"type":"paragraph"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A partial read cannot tell a deleted row from one that was"},{"text":" ","type":"text"},{"text":"never asked about, so this ","type":"text"},{"inlineContent":[{"type":"text","text":"never"}],"type":"strong"},{"text":" infers a deletion. An ID vanishes","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"only if you name it in "},{"type":"codeVoice","code":"deleted"},{"type":"text","text":", and only if the resolved policy grants"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/removesMissingEntities"},{"type":"text","text":". Name only what you have positive"},{"type":"text","text":" "},{"type":"text","text":"evidence for — a history tombstone, not an empty fetch. In exchange,"},{"text":" ","type":"text"},{"text":"there is no empty-snapshot guard to work around: this can remove the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"last surviving entity, which "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true},{"type":"text","text":" cannot."}]}],"type":"aside","name":"Important"},{"inlineContent":[{"type":"text","text":"An ID named in "},{"type":"codeVoice","code":"deleted"},{"type":"text","text":" that storage "},{"type":"emphasis","inlineContent":[{"type":"text","text":"still holds"}]},{"type":"text","text":" is not removed. A live"},{"type":"text","text":" "},{"type":"text","text":"row is evidence the deletion was itself undone elsewhere; a tombstone can"},{"type":"text","text":" "},{"type":"text","text":"be stale."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Registered "},{"type":"codeVoice","code":"collapse:"},{"type":"text","text":" resolvers do not run here — a resolver is handed"},{"type":"text","text":" "},{"type":"text","text":"the whole table and asked which rows survive, and a subset would have it"},{"type":"text","text":" "},{"type":"text","text":"judge a world it cannot see. Duplicate rows are still collapsed on read"},{"type":"text","text":" "},{"type":"text","text":"and still reported. Use "},{"type":"codeVoice","code":"collapseDuplicates(into:)-(Store)"},{"type":"text","text":" or a full"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" to reclaim them."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/mergeremote(into:ids:deleted:policy:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/mergeRemote(into:ids:deleted:policy:)":{"title":"mergeRemote(into:ids:deleted:policy:)","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"State","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"SwiduxObservable","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"text":"Available when","type