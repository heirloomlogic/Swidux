Re-hydration restricted to the rows a caller already knows changed.","type":"text"}],"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mergeRemote","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"store","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","preciseIdentifier":"s:6Swidux5StoreC","text":"Store","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"ids","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:10Foundation4UUIDV","text":"UUID","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"deleted","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:10Foundation4UUIDV","text":"UUID","kind":"typeIdentifier"},{"text":"> = [], ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"}]}]},{"parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The live store to reconcile."}]}],"name":"store"},{"content":[{"inlineContent":[{"type":"text","text":"The identities to re-read. IDs matching no row, and IDs"},{"type":"text","text":" "},{"type":"text","text":"belonging to another entity type, are harmless."}],"type":"paragraph"}],"name":"ids"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Identities known to have been deleted elsewhere."}]}],"name":"deleted"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Narrows the configured policy for this call only.","type":"text"}]}],"name":"policy"}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"inlineContent":[{"text":"The O(k) counterpart to ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"reference","isActive":true},{"text":", which re-reads every","type":"text"},{"text":" ","type":"text"},{"text":"row of every registered entity on every tick. Where a sync signal carries","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"which","type":"text"}],"type":"emphasis"},{"text":" identities changed, this spends that knowledge: one batched fetch","type":"text"},{"text":" ","type":"text"},{"text":"per 500 IDs instead of a full-table scan, and only the named entities are","type":"text"},{"text":" ","type":"text"},{"text":"reconciled. Everything else in state is left exactly as it was.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every guarantee "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" makes holds here. Pending"},{"type":"text","text":" "},{"type":"text","text":"writes are flushed first; an ID with unflushed local intent — a"},{"type":"text","text":" "},{"type":"text","text":"drained-but-unflushed write, an un-drained edit, a pending deletion, a"},{"type":"text","text":" "},{"type":"text","text":"write whose save failed, or an "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","isActive":true},{"text":" hold — always wins, and that is","type":"text"},{"text":" ","type":"text"},{"text":"not configurable.","type":"text"}],"type":"paragraph"},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"text":"A partial read cannot tell a deleted row from one that was","type":"text"},{"text":" ","type":"text"},{"text":"never asked about, so this ","type":"text"},{"inlineContent":[{"type":"text","text":"never"}],"type":"strong"},{"text":" infers a deletion. An ID vanishes","type":"text"},{"text":" ","type":"text"},{"text":"only if you name it in ","type":"text"},{"code":"deleted","type":"codeVoice"},{"text":", and only if the resolved policy grants","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/removesMissingEntities","type":"reference"},{"text":". Name only what you have positive","type":"text"},{"text":" ","type":"text"},{"text":"evidence for — a history tombstone, not an empty fetch. In exchange,","type":"text"},{"text":" ","type":"text"},{"text":"there is no empty-snapshot guard to work around: this can remove the","type":"text"},{"text":" ","type":"text"},{"text":"last surviving entity, which ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"reference"},{"text":" cannot.","type":"text"}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"An ID named in ","type":"text"},{"code":"deleted","type":"codeVoice"},{"text":" that storage ","type":"text"},{"inlineContent":[{"type":"text","text":"still holds"}],"type":"emphasis"},{"text":" is not removed. A live","type":"text"},{"text":" ","type":"text"},{"text":"row is evidence the deletion was itself undone elsewhere; a tombstone can","type":"text"},{"text":" ","type":"text"},{"text":"be stale.","type":"text"}]},{"level":2,"text":"Deferred rows are re-offered","type":"heading","anchor":"Deferred-rows-are-re-offered"},{"type":"paragraph","inlineContent":[{"text":"A tick may read a row and decline to apply it — an ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","isActive":true},{"text":" hold is the","type":"text"},{"text":" ","type":"text"},{"text":"one exemption that leaves no other trace. Those rows are remembered by","type":"text"},{"text":" ","type":"text"},{"text":"identity and re-offered on the next call, on top of whatever ","type":"text"},{"code":"ids","type":"codeVoice"},{"text":" names,","type":"text"},{"text":" ","type":"text"},{"text":"so a caller does not have to re-queue them against its own signal. That","type":"text"},{"text":" ","type":"text"},{"text":"matters here because a sync signal is generally not resent and releasing a","type":"text"},{"text":" ","type":"text"},{"text":"hold writes no transaction of its own, so without it a hold would quietly","type":"text"},{"text":" ","type":"text"},{"text":"become a veto. A call whose read throws is remembered the same way: the","type":"text"},{"text":" ","type":"text"},{"text":"identities it was handed are owed, not dropped with the read.","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeChanges(into:policy:)","isActive":true},{"text":" shares the same debt, so","type":"text"},{"text":" ","type":"text"},{"text":"either path settles what the other deferred. Both discard it when the","type":"text"},{"text":" ","type":"text"},{"text":"container is swapped.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Registered "},{"type":"codeVoice","code":"collapse:"},{"type":"text","text":" resolvers do not run here — a resolver is handed"},{"text":" ","type":"text"},{"text":"the whole table and asked which rows survive, and a subset would have it","type":"text"},{"type":"text","text":" "},{"type":"text","text":"judge a world it cannot see. Duplicate rows are still collapsed on read"},{"type":"text","text":" "},{"type":"text","text":"and still reported. Use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/collapseDuplicates(into:)-7d2no"},{"type":"text","text":" or a full"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" to reclaim them."}]}]}],"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/mergeremote(into:ids:deleted:policy:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"title":"SwiduxPersistence","url":"\/documentation\/swiduxpersistence","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","abstract":[],"type":"topic","role":"collection","kind":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy":{"navigatorTitle":[{"text":"MergePolicy","kind":"identifier"}],"title":"MergePolicy","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","role":"symbol","url":"\/documentation\/swiduxpersistence\/mergepolicy","abstra