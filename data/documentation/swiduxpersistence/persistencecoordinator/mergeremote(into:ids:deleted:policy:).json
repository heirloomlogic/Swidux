ePolicyV","text":"MergePolicy","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE11mergeRemote4into3ids7deleted6policyyAD5StoreCyxq_G_Shy10Foundation4UUIDVGAqA11MergePolicyVSgtYaF","role":"symbol","extendedModule":"SwiduxPersistence"},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"abstract":[{"type":"text","text":"Re-hydration restricted to the rows a caller already knows changed."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeRemote"},{"text":"(","kind":"text"},{"kind":"externalParam","text":"into"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Store","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","preciseIdentifier":"s:6Swidux5StoreC"},{"kind":"text","text":"<"},{"text":"State","kind":"typeIdentifier"},{"kind":"text","text":", "},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"ids","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","preciseIdentifier":"s:Sh","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"deleted","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","preciseIdentifier":"s:Sh","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV","kind":"typeIdentifier"},{"text":"> = [], ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"store","content":[{"inlineContent":[{"type":"text","text":"The live store to reconcile."}],"type":"paragraph"}]},{"name":"ids","content":[{"inlineContent":[{"type":"text","text":"The identities to re-read. IDs matching no row, and IDs"},{"type":"text","text":" "},{"type":"text","text":"belonging to another entity type, are harmless."}],"type":"paragraph"}]},{"name":"deleted","content":[{"type":"paragraph","inlineContent":[{"text":"Identities known to have been deleted elsewhere.","type":"text"}]}]},{"name":"policy","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only."}]}]}]},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The O(k) counterpart to ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"reference","isActive":true},{"text":", which re-reads every","type":"text"},{"text":" ","type":"text"},{"text":"row of every registered entity on every tick. Where a sync signal carries","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"which"}]},{"text":" identities changed, this spends that knowledge: one batched fetch","type":"text"},{"text":" ","type":"text"},{"text":"per 500 IDs instead of a full-table scan, and only the named entities are","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"reconciled. Everything else in state is left exactly as it was."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every guarantee "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" makes holds here. Pending"},{"type":"text","text":" "},{"type":"text","text":"writes are flushed first; an ID with unflushed local intent — a"},{"type":"text","text":" "},{"type":"text","text":"drained-but-unflushed write, an un-drained edit, a pending deletion, a"},{"type":"text","text":" "},{"type":"text","text":"write whose save failed, or an "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","isActive":true},{"type":"text","text":" hold — always wins, and that is"},{"type":"text","text":" "},{"type":"text","text":"not configurable."}]},{"content":[{"inlineContent":[{"type":"text","text":"A partial read cannot tell a deleted row from one that was"},{"type":"text","text":" "},{"type":"text","text":"never asked about, so this "},{"type":"strong","inlineContent":[{"type":"text","text":"never"}]},{"text":" infers a deletion. An ID vanishes","type":"text"},{"text":" ","type":"text"},{"text":"only if you name it in ","type":"text"},{"type":"codeVoice","code":"deleted"},{"type":"text","text":", and only if the resolved policy grants"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/removesMissingEntities"},{"type":"text","text":". Name only what you have positive"},{"type":"text","text":" "},{"type":"text","text":"evidence for — a history tombstone, not an empty fetch. In exchange,"},{"type":"text","text":" "},{"text":"there is no empty-snapshot guard to work around: this can remove the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"last surviving entity, which "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" cannot."}],"type":"paragraph"}],"style":"important","type":"aside","name":"Important"},{"inlineContent":[{"type":"text","text":"An ID named in "},{"type":"codeVoice","code":"deleted"},{"type":"text","text":" that storage "},{"type":"emphasis","inlineContent":[{"text":"still holds","type":"text"}]},{"type":"text","text":" is not removed. A live"},{"type":"text","text":" "},{"type":"text","text":"row is evidence the deletion was itself undone elsewhere; a tombstone can"},{"type":"text","text":" "},{"type":"text","text":"be stale."}],"type":"paragraph"},{"text":"Deferred rows are re-offered","anchor":"Deferred-rows-are-re-offered","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A tick may read a row and decline to apply it — an "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing"},{"type":"text","text":" hold is the"},{"type":"text","text":" "},{"type":"text","text":"one exemption that leaves no other trace. Those rows are remembered by"},{"type":"text","text":" "},{"type":"text","text":"identity and re-offered on the next call, on top of whatever "},{"type":"codeVoice","code":"ids"},{"type":"text","text":" names,"},{"text":" ","type":"text"},{"text":"so a caller does not have to re-queue them against its own signal. That","type":"text"},{"text":" ","type":"text"},{"text":"matters here because a sync signal is generally not resent and releasing a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"hold writes no transaction of its own, so without it a hold would quietly"},{"type":"text","text":" "},{"type":"text","text":"become a veto. A call whose read throws is remembered the same way: the"},{"type":"text","text":" "},{"type":"text","text":"identities it was handed are owed, not dropped with the read."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeChanges(into:policy:)"},{"type":"text","text":" shares the same debt, so"},{"type":"text","text":" "},{"type":"text","text":"either path settles what the other deferred. Both discard it when the"},{"type":"text","text":" "},{"type":"text","text":"container is swapped."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Registered "},{"type":"codeVoice","code":"collapse:"},{"type":"text","text":" resolvers do not run here — a resolver is handed"},{"type":"text","text":" "},{"type":"text","text":"the whole table and asked which rows survive, and a subset would have it"},{"type":"text","text":" "},{"type":"text","text":"judge a world it cannot see. Duplicate rows are still collapsed on read"},{"type":"text","text":" "},{"type":"text","text":"and still reported. Use "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/collapseDuplicates(into:)-7d2no","type":"reference","isActive":true},{"type":"text","text":" or a full"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"reference","isActive":true},{"type":"text","text":" to reclaim them."}]}],"kind":"content"}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/rehydrate(into:policy:)":{"title":"rehydrate(into:policy:)","url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"State","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"SwiduxObservable","type":"codeVoice"},{"type":"text","text":".