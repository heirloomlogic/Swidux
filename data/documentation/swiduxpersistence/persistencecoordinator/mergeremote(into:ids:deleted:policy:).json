{"abstract":[{"type":"text","text":"Re-hydration restricted to the rows a caller already knows changed."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"kind":"symbol","variants":[{"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/mergeremote(into:ids:deleted:policy:)"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"extendedModule":"SwiduxPersistence","title":"mergeRemote(into:ids:deleted:policy:)","externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE11mergeRemote4into3ids7deleted6policyyAD5StoreCyxq_G_Shy10Foundation4UUIDVGAqA11MergePolicyVSgtYaF","modules":[{"name":"SwiduxPersistence"}],"role":"symbol","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeRemote"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier","text":"Store"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"ids"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:10Foundation4UUIDV","kind":"typeIdentifier","text":"UUID"},{"kind":"text","text":">, "},{"text":"deleted","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"roleHeading":"Instance Method","conformance":{"constraints":[{"type":"codeVoice","code":"State"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"SwiduxObservable"},{"text":".","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]}},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"text":"mergeRemote","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"store","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Store","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"kind":"text","text":">, "},{"text":"ids","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"preciseIdentifier":"s:10Foundation4UUIDV","text":"UUID","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"deleted","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sh","text":"Set","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:10Foundation4UUIDV","kind":"typeIdentifier","text":"UUID"},{"text":"> = [], ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy"},{"kind":"text","text":"? = nil) "},{"text":"async","kind":"keyword"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The live store to reconcile.","type":"text"}]}],"name":"store"},{"content":[{"inlineContent":[{"type":"text","text":"The identities to re-read. IDs matching no row, and IDs"},{"text":" ","type":"text"},{"text":"belonging to another entity type, are harmless.","type":"text"}],"type":"paragraph"}],"name":"ids"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Identities known to have been deleted elsewhere.","type":"text"}]}],"name":"deleted"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only."}]}],"name":"policy"}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"The O(k) counterpart to "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":", which re-reads every"},{"type":"text","text":" "},{"type":"text","text":"row of every registered entity on every tick. Where a sync signal carries"},{"type":"text","text":" "},{"inlineContent":[{"text":"which","type":"text"}],"type":"emphasis"},{"type":"text","text":" identities changed, this spends that knowledge: one batched fetch"},{"text":" ","type":"text"},{"text":"per 500 IDs instead of a full-table scan, and only the named entities are","type":"text"},{"type":"text","text":" "},{"text":"reconciled. Everything else in state is left exactly as it was.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Every guarantee ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"reference"},{"type":"text","text":" makes holds here. Pending"},{"type":"text","text":" "},{"type":"text","text":"writes are flushed first; an ID with unflushed local intent — a"},{"text":" ","type":"text"},{"text":"drained-but-unflushed write, an un-drained edit, a pending deletion, a","type":"text"},{"text":" ","type":"text"},{"text":"write whose save failed, or an ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","type":"reference"},{"text":" hold — always wins, and that is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"not configurable."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A partial read cannot tell a deleted row from one that was"},{"type":"text","text":" "},{"type":"text","text":"never asked about, so this "},{"type":"strong","inlineContent":[{"type":"text","text":"never"}]},{"type":"text","text":" infers a deletion. An ID vanishes"},{"type":"text","text":" "},{"type":"text","text":"only if you name it in "},{"type":"codeVoice","code":"deleted"},{"type":"text","text":", and only if the resolved policy grants"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/removesMissingEntities","isActive":true},{"type":"text","text":". Name only what you have positive"},{"type":"text","text":" "},{"type":"text","text":"evidence for — a history tombstone, not an empty fetch. In exchange,"},{"type":"text","text":" "},{"type":"text","text":"there is no empty-snapshot guard to work around: this can remove the"},{"type":"text","text":" "},{"type":"text","text":"last surviving entity, which "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true},{"type":"text","text":" cannot."}]}],"type":"aside","style":"important","name":"Important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An ID named in "},{"type":"codeVoice","code":"deleted"},{"type":"text","text":" that storage "},{"inlineContent":[{"text":"still holds","type":"text"}],"type":"emphasis"},{"text":" is not removed. A live","type":"text"},{"type":"text","text":" "},{"type":"text","text":"row is evidence the deletion was itself undone elsewhere; a tombstone can"},{"type":"text","text":" "},{"text":"be stale.","type":"text"}]},{"anchor":"Deferred-rows-are-re-offered","text":"Deferred rows are re-offered","level":2,"type":"heading"},{"inlineContent":[{"text":"A tick may read a row and decline to apply it — an ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","isActive":true,"type":"reference"},{"text":" hold is the","type":"text"},{"text":" ","type":"text"},{"text":"one exemption that leaves no other trace. Those rows are remembered by","type":"text"},{"text":" ","type":"text"},{"text":"identity and re-offered on the next call, on top of whatever ","type":"text"},{"code":"ids","type":"codeVoice"},{"text":" names,","type":"text"},{"text":" ","type":"text"},{"text":"so a caller does not have to re-queue them against its own signal. That","type":"text"},{"text":" ","type":"text"},{"text":"matters here because a sync signal is generally not resent and releasing a","type":"text"},{"text":" ","type":"text"},{"text":"hold writes no transaction of its own, so without it a hold would quietly","type":"text"},{"text":" ","type":"text"},{"text":"become a veto. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeChanges(into:policy:)","type":"reference"},{"type":"text","text":" shares the same debt, so"},{"type":"text","text":" "},{"type":"text","text":"either path settles what the other deferred. Both discard it when the"},{"type":"text","text":" "},{"type":"text","text":"container is swapped."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Registered "},{"code":"collapse:","type":"codeVoice"},{"type":"text","text":" resolvers do not run here — a resolver is handed"},{"type":"text","text":" "},{"text":"the whole table and asked which rows survive, and a subset would have it","type":"text"},{"text":" ","type":"text"},{"text":"judge a world it cannot see. Duplicate rows are still collapsed on read","type":"text"},{"text":" ","type":"text"},{"text":"and still reported. Use ","type":"text"},{"type":"codeVoice","code":"collapseDuplicates(into:)-(Store)"},{"text":" or a full","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"reference"},{"text":" to reclaim them.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)"},"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/MergePolicy":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","url":"\/documentation\/swiduxpersistence\/mergepolicy","title":"MergePolicy","type":"topic","role":"symbol","abstract":[{"type":"text","text":"How "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true},{"type":"text","text":" resolves a storage"},{"type":"text","text":" "},{"text":"snapshot against live in-memory state.","type":"text"}],"navigatorTitle":[{"text":"MergePolicy","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"MergePolicy","kind":"identifier"}],"kind":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"url":"\/documentation\/swidux