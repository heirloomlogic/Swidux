{"abstract":[{"type":"text","text":"Merges only the rows persistent history says changed, falling back to a"},{"text":" ","type":"text"},{"text":"full ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true},{"text":" whenever history can’t answer.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/mergechanges(into:policy:)"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeChanges"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","text":"Store"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"text":", ","kind":"text"},{"kind":"typeIdentifier","text":"Action"},{"text":">, ","kind":"text"},{"kind":"externalParam","text":"policy"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","text":"MergePolicy"},{"kind":"text","text":"? = nil) "},{"text":"async","kind":"keyword"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The live store to reconcile.","type":"text"}]}],"name":"store"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only."}]}],"name":"policy"}]},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"This is what a remote-change observer should call. Where","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"text":" re-reads every row of every registered entity","type":"text"},{"text":" ","type":"text"},{"text":"on every tick, this reads the store’s transaction log since the last","type":"text"},{"text":" ","type":"text"},{"text":"merge and spends the result through ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)"},{"text":" ","type":"text"},{"text":"— so a tick on an N-row table where k rows changed costs O(k). A tick with","type":"text"},{"text":" ","type":"text"},{"text":"no transactions behind it costs one history fetch and nothing else.","type":"text"}]},{"inlineContent":[{"text":"Every guarantee the other two make holds here. Deletions come from history","type":"text"},{"type":"text","text":" "},{"text":"tombstones, which are positive evidence, so unlike a full re-hydration this","type":"text"},{"type":"text","text":" "},{"inlineContent":[{"text":"can","type":"text"}],"type":"emphasis"},{"text":" remove the last surviving row. Pending local writes and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","type":"reference"},{"text":" ","type":"text"},{"text":"holds still win, and that is not configurable.","type":"text"}],"type":"paragraph"},{"level":2,"text":"When it re-reads everything instead","type":"heading","anchor":"When-it-re-reads-everything-instead"},{"inlineContent":[{"text":"The narrow path is an optimisation, never a weakening: anything that","type":"text"},{"text":" ","type":"text"},{"text":"leaves a window unaccounted for falls back to the full read, and the","type":"text"},{"text":" ","type":"text"},{"text":"fallback keeps its empty-snapshot guard. It happens on the first tick","type":"text"},{"text":" ","type":"text"},{"text":"after launch or a container rebuild, when the watermark has expired or the","type":"text"},{"text":" ","type":"text"},{"text":"history fetch fails, when a deletion’s tombstone carries no identity","type":"text"},{"text":" ","type":"text"},{"text":"(every row deleted before ","type":"text"},{"code":"@Attribute(.preserveValueOnDeletion)","type":"codeVoice"},{"text":" shipped),","type":"text"},{"type":"text","text":" "},{"type":"text","text":"when a changed row can’t be resolved, and when more than one store sits"},{"type":"text","text":" "},{"type":"text","text":"behind the container."}],"type":"paragraph"},{"inlineContent":[{"text":"The watermark advances whenever a tick read every registered entity","type":"text"},{"text":" ","type":"text"},{"text":"successfully — including a tick that declined to apply some of what it","type":"text"},{"text":" ","type":"text"},{"text":"read. A row an editing hold defers is carried forward by identity and","type":"text"},{"text":" ","type":"text"},{"text":"re-offered next tick, which is what keeps a hold from quietly becoming a","type":"text"},{"text":" ","type":"text"},{"text":"veto without costing a full table read per tick to prevent. See","type":"text"},{"text":" ","type":"text"},{"text":"doc:HowToAddICloudSync","type":"text"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Both outcomes are reported: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/remoteChangesMerged","type":"reference"},{"text":" ","type":"text"},{"text":"for a narrowed tick, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/historyUnavailable","type":"reference"},{"text":" ","type":"text"},{"text":"with a reason for a fallback.","type":"text"}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeChanges(into:policy:)"},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"metadata":{"externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE12mergeChanges4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeChanges"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Store","preciseIdentifier":"s:6Swidux5StoreC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"}],"roleHeading":"Instance Method","role":"symbol","title":"mergeChanges(into:policy:)","extendedModule":"SwiduxPersistence","modules":[{"name":"SwiduxPersistence"}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"State"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":"."}]},"symbolKind":"method"},"kind":"symbol","sections":[]