{"sections":[],"variants":[{"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/mergechanges(into:policy:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeChanges(into:policy:)","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Instance Method","symbolKind":"method","modules":[{"name":"SwiduxPersistence"}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"State"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":"."}]},"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mergeChanges","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Store","preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"extendedModule":"SwiduxPersistence","externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE12mergeChanges4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","role":"symbol","title":"mergeChanges(into:policy:)"},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"abstract":[{"text":"Merges only the rows persistent history says changed, falling back to a","type":"text"},{"text":" ","type":"text"},{"text":"full ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true,"type":"reference"},{"type":"text","text":" whenever history can’t answer."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mergeChanges","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"store","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Store","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"}]}]},{"kind":"parameters","parameters":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The live store to reconcile."}]}],"name":"store"},{"content":[{"inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only."}],"type":"paragraph"}],"name":"policy"}]},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"This is what a remote-change observer should call. Where","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" re-reads every row of every registered entity"},{"type":"text","text":" "},{"type":"text","text":"on every tick, this reads the store’s transaction log since the last"},{"type":"text","text":" "},{"type":"text","text":"merge and spends the result through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)"},{"type":"text","text":" "},{"type":"text","text":"— so a tick on an N-row table where k rows changed costs O(k). A tick with"},{"type":"text","text":" "},{"type":"text","text":"no transactions behind it costs one history fetch and nothing else."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every guarantee the other two make holds here. Deletions come from history"},{"type":"text","text":" "},{"type":"text","text":"tombstones, which are positive evidence, so unlike a full re-hydration this"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"can"}]},{"type":"text","text":" remove the last surviving row. Pending local writes and "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","isActive":true},{"type":"text","text":" "},{"type":"text","text":"holds still win, and that is not configurable."}],"type":"paragraph"},{"anchor":"When-it-re-reads-everything-instead","level":2,"type":"heading","text":"When it re-reads everything instead"},{"inlineContent":[{"text":"The narrow path is an optimisation, never a weakening: anything that","type":"text"},{"text":" ","type":"text"},{"text":"leaves a window unaccounted for falls back to the full read, and the","type":"text"},{"text":" ","type":"text"},{"text":"fallback keeps its empty-snapshot guard — which stops it ","type":"text"},{"inlineContent":[{"text":"inferring","type":"text"}],"type":"emphasis"},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"deletion from an empty table, never applying one a tombstone already","type":"text"},{"text":" ","type":"text"},{"text":"proved. It happens on a tick with no watermark (hydration and a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"re-hydration after a container rebuild both leave one), when the watermark has expired or the"},{"type":"text","text":" "},{"type":"text","text":"history fetch fails, when a deletion’s tombstone carries no identity"},{"type":"text","text":" "},{"type":"text","text":"(every row deleted before "},{"type":"codeVoice","code":"@Attribute(.preserveValueOnDeletion)"},{"type":"text","text":" shipped),"},{"type":"text","text":" "},{"type":"text","text":"when a changed row can’t be resolved, when another writer deleted a"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Relation"},{"type":"text","text":" child without changing any row that embeds it — a deleted"},{"type":"text","text":" "},{"type":"text","text":"child can’t be traced to its parent — and when more than one store sits"},{"type":"text","text":" "},{"type":"text","text":"behind the container. A child that was inserted or edited is traced"},{"type":"text","text":" "},{"type":"text","text":"through its relationships to the registered row holding it, and only"},{"type":"text","text":" "},{"type":"text","text":"that row is read."}],"type":"paragraph"},{"name":"Note","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"A parent’s save writes its whole subtree from memory, so it is","type":"text"},{"text":" ","type":"text"},{"text":"last-writer-wins for its children too. A local edit to the parent that","type":"text"},{"text":" ","type":"text"},{"text":"flushes before the tick that would have delivered a peer’s edit to one","type":"text"},{"text":" ","type":"text"},{"text":"of its children writes the older child back over it.","type":"text"}]}],"type":"aside"},{"type":"paragraph","inlineContent":[{"text":"The watermark advances whenever a tick read every registered entity","type":"text"},{"text":" ","type":"text"},{"text":"successfully — including a tick that declined to apply some of what it","type":"text"},{"text":" ","type":"text"},{"text":"read. A row an editing hold defers is carried forward by identity and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"re-offered next tick, which is what keeps a hold from quietly becoming a"},{"type":"text","text":" "},{"type":"text","text":"veto without costing a full table read per tick to prevent. See"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both outcomes are reported: "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/remoteChangesMerged","isActive":true},{"type":"text","text":" "},{"type":"text","text":"for a narrowed tick, "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/historyUnavailable","isActive":true},{"type":"text","text":" "},{"type":"text","text":"with a reason for a fallback. A narrowed tick counts what it re-offered"},{"type":"text","text":" "},{"type":"text","text":"separately from what it merged, so a hold that is never released — which"},{"type":"text","text":" "},{"type":"text","text":"makes every tick re-offer the same rows forever — reads as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/carriedOverCount","isActive":true},{"type":"text","text":" equal to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/mergedCount","isActive":true},{"type":"text","text":", rather than as healthy traffic."}]}],"kind":"content"}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/mergeRemote(into:ids:deleted:policy:)":{"title":"mergeRemote(into:ids:deleted:policy:)","url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/mergeremote(into:ids:deleted:policy:)","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)","conformance":{"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"type":"codeVoice","code":"State"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeRemote"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Store","preciseIdentifier":"s:6Swidux5StoreC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"ids"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"deleted"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"}],"abstract":[{"text":"Re-hydration restricted to the rows a caller already knows changed.","type":"text"}],"role":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/rehydrate(into:policy:)":{"title":"rehydrate(into:policy:)","url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"constraints":[{"code":"State","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"SwiduxObservable","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Store","preciseIdentifier":"s:6Swidux5StoreC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"}],"abstract":[{"text":"Re-hydration that reconciles stored rows into the live ","type":"text"},{"type":"codeVoice","code":"EntityStore"},{"text":"s","type":"text"},{"text":" ","type":"text"},{"text":"without dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"role":"symbol"},"doc://Swidu