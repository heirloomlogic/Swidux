a"},{"type":"text","text":" "},{"type":"text","text":"full "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true},{"type":"text","text":" whenever history can’t answer."}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeChanges"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Store","preciseIdentifier":"s:6Swidux5StoreC","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The live store to reconcile."}],"type":"paragraph"}],"name":"store"},{"content":[{"inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only."}],"type":"paragraph"}],"name":"policy"}],"kind":"parameters"},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"text":"This is what a remote-change observer should call. Where","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"reference"},{"text":" re-reads every row of every registered entity","type":"text"},{"text":" ","type":"text"},{"text":"on every tick, this reads the store’s transaction log since the last","type":"text"},{"text":" ","type":"text"},{"text":"merge and spends the result through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)","type":"reference"},{"text":" ","type":"text"},{"text":"— so a tick on an N-row table where k rows changed costs O(k). A tick with","type":"text"},{"text":" ","type":"text"},{"text":"no transactions behind it costs one history fetch and nothing else.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Every guarantee the other two make holds here. Deletions come from history","type":"text"},{"text":" ","type":"text"},{"text":"tombstones, which are positive evidence, so unlike a full re-hydration this","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"can"}],"type":"emphasis"},{"text":" remove the last surviving row. Pending local writes and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","type":"reference"},{"text":" ","type":"text"},{"text":"holds still win, and that is not configurable.","type":"text"}]},{"type":"heading","level":2,"anchor":"When-it-re-reads-everything-instead","text":"When it re-reads everything instead"},{"type":"paragraph","inlineContent":[{"text":"The narrow path is an optimisation, never a weakening: anything that","type":"text"},{"text":" ","type":"text"},{"text":"leaves a window unaccounted for falls back to the full read, and the","type":"text"},{"text":" ","type":"text"},{"text":"fallback keeps its empty-snapshot guard. It happens on the first tick","type":"text"},{"text":" ","type":"text"},{"text":"after launch or a container rebuild, when the watermark has expired or the","type":"text"},{"text":" ","type":"text"},{"text":"history fetch fails, when a deletion’s tombstone carries no identity","type":"text"},{"text":" ","type":"text"},{"text":"(every row deleted before ","type":"text"},{"code":"@Attribute(.preserveValueOnDeletion)","type":"codeVoice"},{"text":" shipped),","type":"text"},{"text":" ","type":"text"},{"text":"when a changed row can’t be resolved, and when more than one store sits","type":"text"},{"text":" ","type":"text"},{"text":"behind the container.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The watermark advances whenever a tick read every registered entity","type":"text"},{"text":" ","type":"text"},{"text":"successfully — including a tick that declined to apply some of what it","type":"text"},{"text":" ","type":"text"},{"text":"read. A row an editing hold defers is carried forward by identity and","type":"text"},{"text":" ","type":"text"},{"text":"re-offered next tick, which is what keeps a hold from quietly becoming a","type":"text"},{"text":" ","type":"text"},{"text":"veto without costing a full table read per tick to prevent. See","type":"text"},{"text":" ","type":"text"},{"text":"doc:HowToAddICloudSync","type":"text"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Both outcomes are reported: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/remoteChangesMerged","type":"reference"},{"text":" ","type":"text"},{"text":"for a narrowed tick, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/historyUnavailable","type":"reference"},{"text":" ","type":"text"},{"text":"with a reason for a fallback. A narrowed tick counts what it re-offered","type":"text"},{"text":" ","type":"text"},{"text":"separately from what it merged, so a hold that is never released — which","type":"text"},{"text":" ","type":"text"},{"text":"makes every tick re-offer the same rows forever — reads as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/carriedOverCount","type":"reference"},{"text":" equal to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/mergedCount","type":"reference"},{"text":", rather than as healthy traffic.","type":"text"}]}]}],"kind":"symbol","references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","url":"\/documentation\/swiduxpersistence","title":"SwiduxPersistence","role":"collection","abstract":[],"kind":"symbol","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","url":"\/documentation\/swiduxpersistence\/persistencecoordinator","title":"PersistenceCoordinator","role":"symbol","abstract":[{"type":"text","text":"Owns the "},{"type":"codeVoice","code":"ModelContainer"},{"type":"text","text":" + generic "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","isActive":true},{"type":"text","text":" and wires the registered"},{"type":"text","text":" "},{"type":"text","text":"entities into a "},{"type":"codeVoice","code":"Swidux.PersistencePlugin"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"PersistenceCoordinator"}],"kind":"symbol","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistenceCoordinator","kind":"identifier"}]},"d