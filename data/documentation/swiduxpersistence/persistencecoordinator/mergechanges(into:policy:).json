{"abstract":[{"type":"text","text":"Merges only the rows persistent history says changed, falling back to a"},{"type":"text","text":" "},{"type":"text","text":"full "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" whenever history can’t answer."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/mergechanges(into:policy:)"]}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mergeChanges","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"store","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Store","kind":"typeIdentifier","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","preciseIdentifier":"s:6Swidux5StoreC"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"parameters":[{"name":"store","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The live store to reconcile."}]}]},{"name":"policy","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only."}]}]}],"kind":"parameters"},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"This is what a remote-change observer should call. Where","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"reference"},{"text":" re-reads every row of every registered entity","type":"text"},{"text":" ","type":"text"},{"text":"on every tick, this reads the store’s transaction log since the last","type":"text"},{"text":" ","type":"text"},{"text":"merge and spends the result through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)","type":"reference"},{"text":" ","type":"text"},{"text":"— so a tick on an N-row table where k rows changed costs O(k). A tick with","type":"text"},{"text":" ","type":"text"},{"text":"no transactions behind it costs one history fetch and nothing else.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every guarantee the other two make holds here. Deletions come from history","type":"text"},{"text":" ","type":"text"},{"text":"tombstones, which are positive evidence, so unlike a full re-hydration this","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"can"}]},{"text":" remove the last surviving row. Pending local writes and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","type":"reference"},{"text":" ","type":"text"},{"text":"holds still win, and that is not configurable.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"When it re-reads everything instead","anchor":"When-it-re-reads-everything-instead"},{"inlineContent":[{"text":"The narrow path is an optimisation, never a weakening: anything that","type":"text"},{"text":" ","type":"text"},{"text":"leaves a window unaccounted for falls back to the full read, and the","type":"text"},{"text":" ","type":"text"},{"text":"fallback keeps its empty-snapshot guard. It happens on the first tick","type":"text"},{"text":" ","type":"text"},{"text":"after launch or a container rebuild, when the watermark has expired or the","type":"text"},{"text":" ","type":"text"},{"text":"history fetch fails, when a deletion’s tombstone carries no identity","type":"text"},{"text":" ","type":"text"},{"text":"(every row deleted before ","type":"text"},{"type":"codeVoice","code":"@Attribute(.preserveValueOnDeletion)"},{"text":" shipped),","type":"text"},{"text":" ","type":"text"},{"text":"when a changed row can’t be resolved, and when more than one store sits","type":"text"},{"text":" ","type":"text"},{"text":"behind the container.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The watermark only advances when a tick both read every registered entity","type":"text"},{"text":" ","type":"text"},{"text":"successfully ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"and"}]},{"text":" applied everything it read. That is what makes evidence","type":"text"},{"text":" ","type":"text"},{"text":"safe to consume once. A full re-hydration re-offers a withheld change on","type":"text"},{"text":" ","type":"text"},{"text":"the next tick because it re-reads everything; a watermark would step past","type":"text"},{"text":" ","type":"text"},{"text":"it forever, so a tick that withheld anything — an editing hold on a row a","type":"text"},{"text":" ","type":"text"},{"text":"peer deleted, say — leaves the anchor where it is and re-reads the same","type":"text"},{"text":" ","type":"text"},{"text":"window next time.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Both outcomes are reported: ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/remoteChangesMerged","type":"reference"},{"text":" ","type":"text"},{"text":"for a narrowed tick, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/historyUnavailable","type":"reference"},{"text":" ","type":"text"},{"text":"with a reason for a fallback.","type":"text"}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeChanges(into:policy:)"},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"kind":"symbol","sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"SwiduxPersistence"}],"extendedModule":"SwiduxPersistence","externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE12mergeChanges4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","conformance":{"constraints":[{"type":"codeVoice","code":"State"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"SwiduxObservable"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeChanges"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC","text":"Store"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"}],"roleHeading":"Instance Method","title":"mergeChanges(into:policy:)","role":"symbol","symbolKind":"method"},"references":{"doc://Swidux/documentation/Swidux/Store":{"url":"\/documentation\/swidux\/store","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"Store","kind":"identifier"}],"title":"Store","type":"topic","role":"symbol","abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"type":"text","text":"observation layer."}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"url":"\/documentation\/swiduxpersistence\/entitydb","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityDB","kind":"identifier"}],"kind":"symbol","navigatorTitle":[{"text":"EntityDB","kind":"identifier"}],"title":"EntityDB","type":"topic","role":"symbol","abstract":[{"type":"text","text":"A generic "},{"type":"codeVoice","code":"@ModelActor"},{"type":"text","text":" that reads and writes any "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel"},{"type":"text","text":"."}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator":{"navigatorTitle":[{"kind":"identifier","text":"PersistenceCoordinator"}],"title":"PersistenceCoordinator","type":"topic","role":"symbol","kind":"symbol","abstract":[{"text":"Owns the ","type":"text"},{"code":"ModelContainer","type":"codeVoice"},{"type":"text","text":" + generic "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB"