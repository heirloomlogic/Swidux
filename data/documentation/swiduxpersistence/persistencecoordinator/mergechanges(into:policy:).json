{"abstract":[{"text":"Merges only the rows persistent history says changed, falling back to a","type":"text"},{"text":" ","type":"text"},{"text":"full ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"reference"},{"text":" whenever history can’t answer.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeChanges(into:policy:)"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"variants":[{"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/mergechanges(into:policy:)"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE12mergeChanges4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","extendedModule":"SwiduxPersistence","title":"mergeChanges(into:policy:)","symbolKind":"method","roleHeading":"Instance Method","modules":[{"name":"SwiduxPersistence"}],"role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeChanges"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier","text":"Store"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","kind":"typeIdentifier","text":"MergePolicy"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"}],"conformance":{"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"constraints":[{"code":"State","type":"codeVoice"},{"type":"text","text":" conforms to "},{"code":"SwiduxObservable","type":"codeVoice"},{"type":"text","text":"."}]}},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mergeChanges","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"store","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","preciseIdentifier":"s:6Swidux5StoreC","text":"Store","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","text":"MergePolicy","kind":"typeIdentifier"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"}],"platforms":["macOS"]}]},{"parameters":[{"name":"store","content":[{"type":"paragraph","inlineContent":[{"text":"The live store to reconcile.","type":"text"}]}]},{"name":"policy","content":[{"inlineContent":[{"text":"Narrows the configured policy for this call only.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This is what a remote-change observer should call. Where"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" re-reads every row of every registered entity"},{"type":"text","text":" "},{"type":"text","text":"on every tick, this reads the store’s transaction log since the last"},{"type":"text","text":" "},{"type":"text","text":"merge and spends the result through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)"},{"type":"text","text":" "},{"type":"text","text":"— so a tick on an N-row table where k rows changed costs O(k). A tick with"},{"type":"text","text":" "},{"type":"text","text":"no transactions behind it costs one history fetch and nothing else."}],"type":"paragraph"},{"inlineContent":[{"text":"Every guarantee the other two make holds here. Deletions come from history","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"tombstones, which are positive evidence, so unlike a full re-hydration this"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"can"}]},{"type":"text","text":" remove the last surviving row. Pending local writes and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing"},{"type":"text","text":" "},{"type":"text","text":"holds still win, and that is not configurable."}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"When-it-re-reads-everything-instead","text":"When it re-reads everything instead"},{"inlineContent":[{"text":"The narrow path is an optimisation, never a weakening: anything that","type":"text"},{"text":" ","type":"text"},{"text":"leaves a window unaccounted for falls back to the full read, and the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"fallback keeps its empty-snapshot guard — which stops it "},{"type":"emphasis","inlineContent":[{"text":"inferring","type":"text"}]},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"deletion from an empty table, never applying one a tombstone already"},{"type":"text","text":" "},{"type":"text","text":"proved. It happens on a tick with no watermark (hydration and a"},{"type":"text","text":" "},{"type":"text","text":"re-hydration after a container rebuild both leave one), when the watermark has expired or the"},{"type":"text","text":" "},{"type":"text","text":"history fetch fails, when a deletion’s tombstone carries no identity"},{"type":"text","text":" "},{"type":"text","text":"(every row deleted before "},{"type":"codeVoice","code":"@Attribute(.preserveValueOnDeletion)"},{"type":"text","text":" shipped),"},{"type":"text","text":" "},{"type":"text","text":"when a changed row can’t be resolved, when another writer deleted a"},{"text":" ","type":"text"},{"code":"@Relation","type":"codeVoice"},{"type":"text","text":" child without changing any row that embeds it — a deleted"},{"type":"text","text":" "},{"type":"text","text":"child can’t be traced to its parent — and when more than one store sits"},{"text":" ","type":"text"},{"text":"behind the container. A child that was inserted or edited is traced","type":"text"},{"text":" ","type":"text"},{"text":"through its relationships to the registered row holding it, and only","type":"text"},{"text":" ","type":"text"},{"text":"that row is read.","type":"text"}],"type":"paragraph"},{"style":"note","content":[{"inlineContent":[{"text":"A parent’s save writes its whole subtree from memory, so it is","type":"text"},{"text":" ","type":"text"},{"text":"last-writer-wins for its children too. A local edit to the parent that","type":"text"},{"text":" ","type":"text"},{"text":"flushes before the tick that would have delivered a peer’s edit to one","type":"text"},{"text":" ","type":"text"},{"text":"of its children writes the older child back over it.","type":"text"}],"type":"paragraph"}],"name":"Note","type":"aside"},{"inlineContent":[{"text":"The watermark advances whenever a tick read every registered entity","type":"text"},{"text":" ","type":"text"},{"text":"successfully — including a tick that declined to apply some of what it","type":"text"},{"text":" ","type":"text"},{"text":"read. A row an editing hold defers is carried forward by identity and","type":"text"},{"text":" ","type":"text"},{"text":"re-offered next tick, which is what keeps a hold from quietly becoming a","type":"text"},{"text":" ","type":"text"},{"text":"veto without costing a full table read per tick to prevent. See","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Both outcomes are reported: ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/remoteChangesMerged","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"for a narrowed tick, "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/historyUnavailable","isActive":true},{"type":"text","text":" "},{"type":"text","text":"with a reason for a fallback. A narrowed tick counts what it re-offered"},{"type":"text","text":" "},{"type":"text","text":"separately from what it merged, so a hold that is never released — which"},{"type":"text","text":" "},{"type":"text","text":"makes every tick re-offer the same rows forever — reads as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/carriedOverCount","isActive":true},{"type":"text","text":" equal to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/mergedCount","isActive":true},{"type":"text","text":", rather than as healthy traffic."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"title":"EntityDB","url":"\/documentation\/swiduxpersistence\/entitydb","kind":"symbol","navigatorTitle":[{"text":"EntityDB","kind":"identifier"}],"abstract":[{"text":"A generic ","type":"text"},{"code":"@ModelActor","type":"codeVoice"},{"text":" that reads and writes any ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","type":"reference"},{"text":".","type":"text"}],"type":"topic","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityDB","kind":"identifier"}],"role":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceDiagnostic/Kind-swift.struct/historyUnavailable":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/historyUnavailable","kind":"symbol","title":"historyUnavailable","role":"symbol","type":"topic","url":"\/documentation\/swiduxpersistence\/persistencediagnostic\/kind-swift.struct\/historyunavailable","abstract":[{"text":"A tick could not narrow its work from persistent history and re-read","type":"text"},{"text":" ","type":"text"},{"text":"every registered entity instead.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"historyUnavailable","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence0B10DiagnosticV","text":"PersistenceDiagnostic"},{"kind":"text","text":"."},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence0B10Diagn