{"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeChanges(into:policy:)","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"roleHeading":"Instance Method","conformance":{"constraints":[{"type":"codeVoice","code":"State"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":"."}],"conformancePrefix":[{"type":"text","text":"Conforms when"}],"availabilityPrefix":[{"type":"text","text":"Available when"}]},"title":"mergeChanges(into:policy:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mergeChanges","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Store","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE12mergeChanges4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","extendedModule":"SwiduxPersistence","modules":[{"name":"SwiduxPersistence"}],"role":"symbol","symbolKind":"method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mergeChanges","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"store","kind":"internalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","text":"Store","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"}],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"content":[{"inlineContent":[{"type":"text","text":"The live store to reconcile."}],"type":"paragraph"}],"name":"store"},{"content":[{"inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only."}],"type":"paragraph"}],"name":"policy"}]},{"kind":"content","content":[{"level":2,"text":"Discussion","type":"heading","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"This is what a remote-change observer should call. Where"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true},{"type":"text","text":" re-reads every row of every registered entity"},{"type":"text","text":" "},{"type":"text","text":"on every tick, this reads the store’s transaction log since the last"},{"type":"text","text":" "},{"type":"text","text":"merge and spends the result through "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"— so a tick on an N-row table where k rows changed costs O(k). A tick with"},{"type":"text","text":" "},{"type":"text","text":"no transactions behind it costs one history fetch and nothing else."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every guarantee the other two make holds here. Deletions come from history"},{"type":"text","text":" "},{"type":"text","text":"tombstones, which are positive evidence, so unlike a full re-hydration this"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"can"}],"type":"emphasis"},{"type":"text","text":" remove the last surviving row. Pending local writes and "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","isActive":true},{"type":"text","text":" "},{"type":"text","text":"holds still win, and that is not configurable."}],"type":"paragraph"},{"level":2,"text":"When it re-reads everything instead","type":"heading","anchor":"When-it-re-reads-everything-instead"},{"inlineContent":[{"type":"text","text":"The narrow path is an optimisation, never a weakening: anything that"},{"type":"text","text":" "},{"type":"text","text":"leaves a window unaccounted for falls back to the full read, and the"},{"type":"text","text":" "},{"type":"text","text":"fallback keeps its empty-snapshot guard. It happens on the first tick"},{"type":"text","text":" "},{"type":"text","text":"after launch or a container rebuild, when the watermark has expired or the"},{"type":"text","text":" "},{"type":"text","text":"history fetch fails, when a deletion’s tombstone carries no identity"},{"type":"text","text":" "},{"type":"text","text":"(every row deleted before "},{"type":"codeVoice","code":"@Attribute(.preserveValueOnDeletion)"},{"type":"text","text":" shipped),"},{"type":"text","text":" "},{"type":"text","text":"when a changed row can’t be resolved, and when more than one store sits"},{"type":"text","text":" "},{"type":"text","text":"behind the container."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The watermark advances whenever a tick read every registered entity"},{"type":"text","text":" "},{"type":"text","text":"successfully — including a tick that declined to apply some of what it"},{"type":"text","text":" "},{"type":"text","text":"read. A row an editing hold defers is carried forward by identity and"},{"type":"text","text":" "},{"type":"text","text":"re-offered next tick, which is what keeps a hold from quietly becoming a"},{"type":"text","text":" "},{"type":"text","text":"veto without costing a full table read per tick to prevent. See"},{"type":"text","text":" "},{"type":"text","text":"doc:HowToAddICloudSync"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both outcomes are reported: "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/remoteChangesMerged","isActive":true},{"type":"text","text":" "},{"type":"text","text":"for a narrowed tick, "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/historyUnavailable","isActive":true},{"type":"text","text":" "},{"type":"text","text":"with a reason for a fallback."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/mergechanges(into:policy:)"]}],"kind":"symbol","abstract":[{"text":"Merges only the rows persistent history says changed, falling back to a","type":"text"},{"text":" ","type":"text"},{"text":"full ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"reference"},{"text":" whenever history can’t answer.","type":"text"}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/rehydrate(into:policy:)":{"kind":"symbol","url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:policy:)","conformance":{"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"State","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"SwiduxObservable","type":"codeVoice"},{"type":"text","text":"."}],"availabilityPrefix":[{"text":"Available when","type":"text"}]},"fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"text":"rehydrate","kind":"identifier"},{"kind":"text","text":"("},{"text":"into","kind":"externalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Swidux5StoreC","text":"Store","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"}],"type":"topic","abstract":[{"text":"Re-hydration that reconciles stored rows into the live ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":"s","type":"text"},{"text":" ","type":"text"},{"text":"without dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"title":"rehydrate(into:policy:)","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","role":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/mergeRemote(into:ids:deleted:policy:)":{"abstract":[{"type":"text","text":"Re-hydration restricted to the rows a caller already knows changed."}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/P