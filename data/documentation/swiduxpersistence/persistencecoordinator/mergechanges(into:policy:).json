{"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"abstract":[{"type":"text","text":"Merges only the rows persistent history says changed, falling back to a"},{"type":"text","text":" "},{"type":"text","text":"full "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" whenever history can’t answer."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"mergeChanges"},{"kind":"text","text":"("},{"text":"into","kind":"externalParam"},{"kind":"text","text":" "},{"text":"store","kind":"internalParam"},{"kind":"text","text":": "},{"preciseIdentifier":"s:6Swidux5StoreC","text":"Store","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"kind":"typeIdentifier","text":"Action"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","kind":"typeIdentifier"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"store","content":[{"type":"paragraph","inlineContent":[{"text":"The live store to reconcile.","type":"text"}]}]},{"name":"policy","content":[{"type":"paragraph","inlineContent":[{"text":"Narrows the configured policy for this call only.","type":"text"}]}]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"This is what a remote-change observer should call. Where"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" re-reads every row of every registered entity"},{"type":"text","text":" "},{"type":"text","text":"on every tick, this reads the store’s transaction log since the last"},{"type":"text","text":" "},{"type":"text","text":"merge and spends the result through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)"},{"type":"text","text":" "},{"type":"text","text":"— so a tick on an N-row table where k rows changed costs O(k). A tick with"},{"type":"text","text":" "},{"type":"text","text":"no transactions behind it costs one history fetch and nothing else."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Every guarantee the other two make holds here. Deletions come from history"},{"type":"text","text":" "},{"type":"text","text":"tombstones, which are positive evidence, so unlike a full re-hydration this"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"can","type":"text"}]},{"type":"text","text":" remove the last surviving row. Pending local writes and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing"},{"type":"text","text":" "},{"type":"text","text":"holds still win, and that is not configurable."}],"type":"paragraph"},{"level":2,"type":"heading","text":"When it re-reads everything instead","anchor":"When-it-re-reads-everything-instead"},{"inlineContent":[{"type":"text","text":"The narrow path is an optimisation, never a weakening: anything that"},{"type":"text","text":" "},{"type":"text","text":"leaves a window unaccounted for falls back to the full read, and the"},{"type":"text","text":" "},{"type":"text","text":"fallback keeps its empty-snapshot guard. It happens on the first tick"},{"type":"text","text":" "},{"type":"text","text":"after launch or a container rebuild, when the watermark has expired or the"},{"type":"text","text":" "},{"type":"text","text":"history fetch fails, when a deletion’s tombstone carries no identity"},{"type":"text","text":" "},{"type":"text","text":"(every row deleted before "},{"type":"codeVoice","code":"@Attribute(.preserveValueOnDeletion)"},{"type":"text","text":" shipped),"},{"type":"text","text":" "},{"type":"text","text":"when a changed row can’t be resolved, and when more than one store sits"},{"type":"text","text":" "},{"type":"text","text":"behind the container."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The watermark only advances when a tick both read every registered entity"},{"type":"text","text":" "},{"type":"text","text":"successfully "},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"type":"text","text":" applied everything it read. That is what makes evidence"},{"type":"text","text":" "},{"type":"text","text":"safe to consume once. A full re-hydration re-offers a withheld change on"},{"type":"text","text":" "},{"type":"text","text":"the next tick because it re-reads everything; a watermark would step past"},{"type":"text","text":" "},{"type":"text","text":"it forever, so a tick that withheld anything — an editing hold on a row a"},{"type":"text","text":" "},{"type":"text","text":"peer deleted, say — leaves the anchor where it is and re-reads the same"},{"type":"text","text":" "},{"type":"text","text":"window next time."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both outcomes are reported: "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/remoteChangesMerged"},{"type":"text","text":" "},{"type":"text","text":"for a narrowed tick, "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/historyUnavailable"},{"type":"text","text":" "},{"type":"text","text":"with a reason for a fallback."}],"type":"paragraph"}]}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeChanges(into:policy:)"},"metadata":{"roleHeading":"Instance Method","modules":[{"name":"SwiduxPersistence"}],"externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE12mergeChanges4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","extendedModule":"SwiduxPersistence","symbolKind":"method","role":"symbol","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"State","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"SwiduxObservable","type":"codeVoice"},{"text":".","type":"text"}]},"title":"mergeChanges(into:policy:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeChanges"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC","text":"Store"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"}]},"variants":[{"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/mergechanges(into:policy:)"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","abstract":[{"type":"text","text":"Owns the "},{"type":"codeVoice","code":"ModelContainer"},{"type":"text","text":" + generic "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","isActive":true},{"type":"text","text":" and wires the registered"},{"type":"text","text":" "},{"type":"text","text":"entities into a "},{"type":"codeVoice","code":"Swidux.PersistencePlugin"},{"type":"text","text":"."}],"title":"PersistenceCoordinator","url":"\/documentation\/swiduxpersistence\/persistencecoordinator","kind":"symbol","navigatorTitle":[{"text":"PersistenceCoordinator","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistenceCoordinator","kind":"identifier"}],"role":"symbol","type":"topic"},"doc://Swidux/documentation/Swidux/Store":{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","abstract":[{"type":"text","text":"Generic store that owns the dispatch cycle, plugin lifecycle, and"},{"type":"text","text":" "},{"type":"text","text":"observation layer."}],"title":"Store","url":"\/documentation\/swidux\/store","kind":"symbol","navigatorTitle":[{"text":"Store","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Store","kind":"identifier"}],"role":"symbol","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceDiagnostic/Kind-swift.struct/historyUnavailable":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/historyUnava