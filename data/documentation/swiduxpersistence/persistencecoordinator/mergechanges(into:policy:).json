{"metadata":{"externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE12mergeChanges4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","title":"mergeChanges(into:policy:)","modules":[{"name":"SwiduxPersistence"}],"role":"symbol","roleHeading":"Instance Method","symbolKind":"method","extendedModule":"SwiduxPersistence","conformance":{"constraints":[{"type":"codeVoice","code":"State"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeChanges"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC","text":"Store"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"}]},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mergeChanges","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"store","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Store","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier"},{"kind":"text","text":"<"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","text":"MergePolicy","kind":"typeIdentifier","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy"},{"kind":"text","text":"? = nil) "},{"text":"async","kind":"keyword"}],"languages":["swift"]}]},{"parameters":[{"name":"store","content":[{"type":"paragraph","inlineContent":[{"text":"The live store to reconcile.","type":"text"}]}]},{"name":"policy","content":[{"inlineContent":[{"type":"text","text":"Narrows the configured policy for this call only."}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"This is what a remote-change observer should call. Where","type":"text"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" re-reads every row of every registered entity"},{"type":"text","text":" "},{"text":"on every tick, this reads the store’s transaction log since the last","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"merge and spends the result through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)"},{"text":" ","type":"text"},{"type":"text","text":"— so a tick on an N-row table where k rows changed costs O(k). A tick with"},{"type":"text","text":" "},{"type":"text","text":"no transactions behind it costs one history fetch and nothing else."}]},{"inlineContent":[{"type":"text","text":"Every guarantee the other two make holds here. Deletions come from history"},{"type":"text","text":" "},{"type":"text","text":"tombstones, which are positive evidence, so unlike a full re-hydration this"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"can"}]},{"type":"text","text":" remove the last surviving row. Pending local writes and "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","isActive":true},{"text":" ","type":"text"},{"text":"holds still win, and that is not configurable.","type":"text"}],"type":"paragraph"},{"text":"When it re-reads everything instead","anchor":"When-it-re-reads-everything-instead","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The narrow path is an optimisation, never a weakening: anything that"},{"type":"text","text":" "},{"type":"text","text":"leaves a window unaccounted for falls back to the full read, and the"},{"type":"text","text":" "},{"type":"text","text":"fallback keeps its empty-snapshot guard. It happens on the first tick"},{"type":"text","text":" "},{"type":"text","text":"after launch or a container rebuild, when the watermark has expired or the"},{"type":"text","text":" "},{"text":"history fetch fails, when a deletion’s tombstone carries no identity","type":"text"},{"type":"text","text":" "},{"type":"text","text":"(every row deleted before "},{"code":"@Attribute(.preserveValueOnDeletion)","type":"codeVoice"},{"text":" shipped),","type":"text"},{"type":"text","text":" "},{"type":"text","text":"when a changed row can’t be resolved, and when more than one store sits"},{"text":" ","type":"text"},{"type":"text","text":"behind the container."}],"type":"paragraph"},{"inlineContent":[{"text":"The watermark only advances when a tick both read every registered entity","type":"text"},{"text":" ","type":"text"},{"text":"successfully ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"and","type":"text"}]},{"text":" applied everything it read. That is what makes evidence","type":"text"},{"type":"text","text":" "},{"type":"text","text":"safe to consume once. A full re-hydration re-offers a withheld change on"},{"type":"text","text":" "},{"type":"text","text":"the next tick because it re-reads everything; a watermark would step past"},{"text":" ","type":"text"},{"text":"it forever, so a tick that withheld anything — an editing hold on a row a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"peer deleted, say — leaves the anchor where it is and re-reads the same"},{"type":"text","text":" "},{"type":"text","text":"window next time."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both outcomes are reported: "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/remoteChangesMerged","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"for a narrowed tick, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/historyUnavailable"},{"text":" ","type":"text"},{"type":"text","text":"with a reason for a fallback."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeChanges(into:policy:)","interfaceLanguage":"swift"},"kind":"symbol","abstract":[{"type":"text","text":"Merges only the rows persistent history says changed, falling back to a"},{"type":"text","text":" "},{"type":"text","text":"full "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":