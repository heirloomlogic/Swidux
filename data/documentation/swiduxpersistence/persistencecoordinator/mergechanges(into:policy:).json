falling back to a"},{"type":"text","text":" "},{"type":"text","text":"full "},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","type":"reference"},{"type":"text","text":" whenever history can’t answer."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"text":"mergeChanges","kind":"identifier"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":" "},{"kind":"internalParam","text":"store"},{"kind":"text","text":": "},{"kind":"typeIdentifier","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store","preciseIdentifier":"s:6Swidux5StoreC","text":"Store"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Action"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"policy"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"MergePolicy","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV"},{"kind":"text","text":"? = nil) "},{"kind":"keyword","text":"async"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"parameters","parameters":[{"name":"store","content":[{"inlineContent":[{"text":"The live store to reconcile.","type":"text"}],"type":"paragraph"}]},{"name":"policy","content":[{"type":"paragraph","inlineContent":[{"text":"Narrows the configured policy for this call only.","type":"text"}]}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"This is what a remote-change observer should call. Where"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)","isActive":true,"type":"reference"},{"type":"text","text":" re-reads every row of every registered entity"},{"type":"text","text":" "},{"type":"text","text":"on every tick, this reads the store’s transaction log since the last"},{"type":"text","text":" "},{"type":"text","text":"merge and spends the result through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)"},{"type":"text","text":" "},{"type":"text","text":"— so a tick on an N-row table where k rows changed costs O(k). A tick with"},{"type":"text","text":" "},{"type":"text","text":"no transactions behind it costs one history fetch and nothing else."}],"type":"paragraph"},{"inlineContent":[{"text":"Every guarantee the other two make holds here. Deletions come from history","type":"text"},{"text":" ","type":"text"},{"text":"tombstones, which are positive evidence, so unlike a full re-hydration this","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"can"}],"type":"emphasis"},{"type":"text","text":" remove the last surviving row. Pending local writes and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing"},{"type":"text","text":" "},{"type":"text","text":"holds still win, and that is not configurable."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"When-it-re-reads-everything-instead","text":"When it re-reads everything instead"},{"inlineContent":[{"type":"text","text":"The narrow path is an optimisation, never a weakening: anything that"},{"type":"text","text":" "},{"type":"text","text":"leaves a window unaccounted for falls back to the full read, and the"},{"text":" ","type":"text"},{"text":"fallback keeps its empty-snapshot guard — which stops it ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"inferring"}]},{"text":" a","type":"text"},{"type":"text","text":" "},{"text":"deletion from an empty table, never applying one a tombstone already","type":"text"},{"type":"text","text":" "},{"text":"proved. It happens on a tick with no watermark (hydration and a","type":"text"},{"text":" ","type":"text"},{"text":"re-hydration after a container rebuild both leave one), when the watermark has expired or the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"history fetch fails, when a deletion’s tombstone carries no identity"},{"text":" ","type":"text"},{"text":"(every row deleted before ","type":"text"},{"code":"@Attribute(.preserveValueOnDeletion)","type":"codeVoice"},{"text":" shipped),","type":"text"},{"text":" ","type":"text"},{"text":"when a changed row can’t be resolved, when another writer deleted a","type":"text"},{"text":" ","type":"text"},{"code":"@Relation","type":"codeVoice"},{"text":" child without changing any row that embeds it — a deleted","type":"text"},{"text":" ","type":"text"},{"text":"child can’t be traced to its parent — and when more than one store sits","type":"text"},{"text":" ","type":"text"},{"text":"behind the container. A child that was inserted or edited is traced","type":"text"},{"text":" ","type":"text"},{"text":"through its relationships to the registered row holding it, and only","type":"text"},{"text":" ","type":"text"},{"text":"that row is read.","type":"text"}],"type":"paragraph"},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A parent’s save writes its whole subtree from memory, so it is"},{"type":"text","text":" "},{"type":"text","text":"last-writer-wins for its children too. A local edit to the parent that"},{"type":"text","text":" "},{"type":"text","text":"flushes before the tick that would have delivered a peer’s edit to one"},{"type":"text","text":" "},{"type":"text","text":"of its children writes the older child back over it."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The watermark advances whenever a tick read every registered entity"},{"type":"text","text":" "},{"type":"text","text":"successfully — including a tick that declined to apply some of what it"},{"type":"text","text":" "},{"type":"text","text":"read. A row an editing hold defers is carried forward by identity and"},{"type":"text","text":" "},{"type":"text","text":"re-offered next tick, which is what keeps a hold from quietly becoming a"},{"type":"text","text":" "},{"text":"veto without costing a full table read per tick to prevent. See","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","type":"reference","isActive":true},{"text":".","type":"text"}]},{"inlineContent":[{"text":"Both outcomes are reported: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/remoteChangesMerged"},{"text":" ","type":"text"},{"text":"for a narrowed tick, ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/historyUnavailable","isActive":true},{"text":" ","type":"text"},{"text":"with a reason for a fallback. A narrowed tick counts what it re-offered","type":"text"},{"text":" ","type":"text"},{"text":"separately from what it merged, so a hold that is never released — which","type":"text"},{"text":" ","type":"text"},{"text":"makes every tick re-offer the same rows forever — reads as","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/carriedOverCount","type":"reference"},{"text":" equal to","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/mergedCount","type":"reference"},{"text":", rather than as healthy traffic.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/editing":{"url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/editing","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","type":"topic","title":"editing","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"editing"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence12EditingHoldsC","text":"EditingHolds"}],"abstract":[{"type":"text","text":"Entities the app has declared it is editing, exempt from the merge until"},{"type":"text","text":" "},{"type":"text","text":"released."}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceDiagnostic/Kind-swift.struct/remoteChangesMerged":{"abstract":[{"text":"A remote-change tick resolved persistent history into a bounded set","type":"text"},{"text":" ","type":"text"},{"text":"of identities and merged only those.","type":"text"}],"title":"remoteChangesMerged","kind":"symbol","role":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/remoteChangesMerged","url":"\/documentation\/swiduxpersistence\/persistencediagnostic\/kind-swift.struct\/remotechangesmerged","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"remoteChangesMerged","kind":"identifier"},{"text":": ","kind":"text"},{"text":"PersistenceDiagnostic","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence0B10DiagnosticV"},{"text":".","kind":"text"},{"text":"Kind","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxP