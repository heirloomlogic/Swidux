{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeChanges"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"store","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"Store","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/Store"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"policy","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"MergePolicy","kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence11MergePolicyV","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy"},{"text":"? = nil) ","kind":"text"},{"text":"async","kind":"keyword"}],"platforms":["macOS"]}]},{"parameters":[{"name":"store","content":[{"inlineContent":[{"text":"The live store to reconcile.","type":"text"}],"type":"paragraph"}]},{"name":"policy","content":[{"inlineContent":[{"text":"Narrows the configured policy for this call only.","type":"text"}],"type":"paragraph"}]}],"kind":"parameters"},{"content":[{"text":"Discussion","anchor":"discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is what a remote-change observer should call. Where"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:policy:)"},{"type":"text","text":" re-reads every row of every registered entity"},{"type":"text","text":" "},{"type":"text","text":"on every tick, this reads the store’s transaction log since the last"},{"type":"text","text":" "},{"type":"text","text":"merge and spends the result through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeRemote(into:ids:deleted:policy:)"},{"type":"text","text":" "},{"type":"text","text":"— so a tick on an N-row table where k rows changed costs O(k). A tick with"},{"type":"text","text":" "},{"type":"text","text":"no transactions behind it costs one history fetch and nothing else."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every guarantee the other two make holds here. Deletions come from history"},{"type":"text","text":" "},{"type":"text","text":"tombstones, which are positive evidence, so unlike a full re-hydration this"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"can"}],"type":"emphasis"},{"type":"text","text":" remove the last surviving row. Pending local writes and "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/editing","isActive":true},{"type":"text","text":" "},{"type":"text","text":"holds still win, and that is not configurable."}]},{"level":2,"anchor":"When-it-re-reads-everything-instead","text":"When it re-reads everything instead","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The narrow path is an optimisation, never a weakening: anything that"},{"type":"text","text":" "},{"type":"text","text":"leaves a window unaccounted for falls back to the full read, and the"},{"type":"text","text":" "},{"type":"text","text":"fallback keeps its empty-snapshot guard — which stops it "},{"type":"emphasis","inlineContent":[{"type":"text","text":"inferring"}]},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"deletion from an empty table, never applying one a tombstone already"},{"type":"text","text":" "},{"type":"text","text":"proved. It happens on a tick with no watermark (hydration and a"},{"type":"text","text":" "},{"type":"text","text":"re-hydration after a container rebuild both leave one), when the watermark has expired or the"},{"type":"text","text":" "},{"type":"text","text":"history fetch fails, when a deletion’s tombstone carries no identity"},{"type":"text","text":" "},{"type":"text","text":"(every row deleted before "},{"code":"@Attribute(.preserveValueOnDeletion)","type":"codeVoice"},{"type":"text","text":" shipped),"},{"type":"text","text":" "},{"type":"text","text":"when a changed row can’t be resolved, and when more than one store sits"},{"type":"text","text":" "},{"type":"text","text":"behind the container."}]},{"type":"paragraph","inlineContent":[{"text":"The watermark advances whenever a tick read every registered entity","type":"text"},{"text":" ","type":"text"},{"text":"successfully — including a tick that declined to apply some of what it","type":"text"},{"text":" ","type":"text"},{"text":"read. A row an editing hold defers is carried forward by identity and","type":"text"},{"text":" ","type":"text"},{"text":"re-offered next tick, which is what keeps a hold from quietly becoming a","type":"text"},{"text":" ","type":"text"},{"text":"veto without costing a full table read per tick to prevent. See","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/HowToAddICloudSync","isActive":true,"type":"reference"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"Both outcomes are reported: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/remoteChangesMerged"},{"text":" ","type":"text"},{"text":"for a narrowed tick, ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/Kind-swift.struct\/historyUnavailable"},{"text":" ","type":"text"},{"text":"with a reason for a fallback. A narrowed tick counts what it re-offered","type":"text"},{"text":" ","type":"text"},{"text":"separately from what it merged, so a hold that is never released — which","type":"text"},{"text":" ","type":"text"},{"text":"makes every tick re-offer the same rows forever — reads as","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/carriedOverCount","isActive":true},{"text":" equal to","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/mergedCount","isActive":true},{"text":", rather than as healthy traffic.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/mergeChanges(into:policy:)","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"metadata":{"extendedModule":"SwiduxPersistence","title":"mergeChanges(into:policy:)","conformance":{"constraints":[{"type":"codeVoice","code":"State"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"SwiduxObservable"},{"type":"text","text":"."}],"availabilityPrefix":[{"type":"text","text":"Available when"}],"conformancePrefix":[{"type":"text","text":"Conforms when"}]},"role":"symbol","roleHeading":"Instance Method","modules":[{"name":"SwiduxPersistence"}],"externalID":"s:17SwiduxPersistence0B11CoordinatorCAA0A00A10ObservableRzrlE12mergeChanges4into6policyyAD5StoreCyxq_G_AA11MergePolicyVSgtYaF","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"mergeChanges"},{"