{"metadata":{"role":"symbol","symbolKind":"method","modules":[{"name":"SwiduxPersistence"}],"externalID":"s:17SwiduxPersistence0B11CoordinatorC9rehydrate4intoyxz_tYaF","title":"rehydrate(into:)","roleHeading":"Instance Method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}]},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:)","interfaceLanguage":"swift"},"abstract":[{"text":"Re-hydration that merges disk rows into the live ","type":"text"},{"type":"codeVoice","code":"EntityStore"},{"text":"s without","type":"text"},{"text":" ","type":"text"},{"text":"dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"state","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The merge prefers the in-memory value for "},{"type":"strong","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" ID"},{"type":"text","text":" "},{"type":"text","text":"already in memory, and never removes entities. Mid-session, remote"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"edits","type":"text"}]},{"type":"text","text":" to entities you already hold and remote "},{"type":"emphasis","inlineContent":[{"text":"deletions","type":"text"}]},{"type":"text","text":" therefore"},{"type":"text","text":" "},{"type":"text","text":"do not surface until the next launch — re-hydration is additive-only"},{"type":"text","text":" "},{"type":"text","text":"by design. That is the price of never clobbering unflushed writes or"},{"type":"text","text":" "},{"type":"text","text":"live UI edits; per-ID dirty tracking that relaxes this is a possible"},{"text":" ","type":"text"},{"text":"future refinement.","type":"text"}]}],"type":"aside"},{"inlineContent":[{"type":"text","text":"Pending writes and deletions are flushed to disk "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the merge, so a"},{"type":"text","text":" "},{"type":"text","text":"remote-change refresh that fires during the debounce window can’t read a"},{"type":"text","text":" "},{"type":"text","text":"stale disk row for an entity the user just edited or deleted and resurrect"},{"type":"text","text":" "},{"type":"text","text":"it. This mirrors "},{"type":"codeVoice","code":"SyncCoordinator.setSyncEnabled"},{"type":"text","text":"’s flush-first discipline"},{"type":"text","text":" "},{"type":"text","text":"and makes every "},{"type":"codeVoice","code":"rehydrate"},{"type":"text","text":" caller safe by construction."}],"type":"paragraph"},{"inlineContent":[{"text":"If a fetch fails, the cor