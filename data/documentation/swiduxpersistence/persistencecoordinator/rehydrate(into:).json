{"abstract":[{"text":"Re-hydration that merges disk rows into the live ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":"s without","type":"text"},{"text":" ","type":"text"},{"text":"dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:)","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:)"]}],"metadata":{"externalID":"s:17SwiduxPersistence0B11CoordinatorC9rehydrate4intoyxz_tYaF","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}],"roleHeading":"Instance Method","modules":[{"name":"SwiduxPersistence"}],"title":"rehydrate(into:)","symbolKind":"method"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"kind":"internalParam","text":"state"},{"kind":"text","text":": "},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"languages":["swift"]}]},{"content":[{"text":"Discussion","level":2,"type":"heading","anchor":"discussion"},{"style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"The merge prefers the in-memory value for ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" ID"},{"type":"text","text":" "},{"type":"text","text":"already in memory, and never removes entities. Mid-session, remote"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"edits"}]},{"type":"text","text":" to entities you already hold and remote "},{"type":"emphasis","inlineContent":[{"type":"text","text":"deletions"}]},{"text":" therefore","type":"text"},{"text":" ","type":"text"},{"text":"do not surface until the next launch — re-hydration is additive-only","type":"text"},{"text":" ","type":"text"},{"text":"by design. That is the price of never clobbering unflushed writes or","type":"text"},{"text":" ","type":"text"},{"text":"live UI edits; per-ID dirty tracking that relaxes this is a possible","type":"text"},{"text":" ","type":"text"},{"text":"future refinement.","type":"text"}]}],"name":"Important"},{"inlineContent":[{"type":"text","text":"Pending writes and deletions are flushed to disk "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the merge, so a"},{"type":"text","text":" "},{"type":"text","text":"remote-change refresh that fires during the debounce window can’t read a"},{"type":"text","text":" "},{"type":"text","text":"stale disk row for an entity the user just edited or deleted and resurrect"},{"type":"text","text":" "},{"type":"text","text":"it. This mirrors "},{"type":"codeVoice","code":"SyncCoordinator.setSyncEnabled"},{"type":"text","text":"’s flush-first discipline"},{"type":"text","text":" "},{"type":"text","text":"and makes every "},{"type":"codeVoice","code":"rehydrate"},{"type":"text","text":" caller safe by construction."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If a fetch fails, the corresponding "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":" is left untouched"},{"type":"text","text":" "},{"type":"text","text":"and the failure is reported via "},{"type":"codeVoice","code":"onFailure"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"kind":"symbol","references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistenceCoordinator"}],"navigatorTitle":[{"kind":"identifier","text":"PersistenceCoordinator"}],"url":"\/documentation\/swiduxpersistence\/persistencecoordinator","title":"PersistenceCoordinator","role":"symbol","type":"topic","abstract":[{"text":"Owns the ","type":"text"},{"type":"codeVoice","code":"ModelContainer"},{"text":" + generic ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB"},{"text":" and wires the registered","type":"text"},{"text":" ","type":"text"},{"text":"entities into a ","type":"text"},{"type":"codeVoice","code":"Swidux.PersistencePlugin"},{"text":".","type":"text"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"type":"topic","url":"\/documentation\/swiduxpersistence","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","kind":"symbol","abstract":[],"role":"collection","title":"SwiduxPersistence"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"abstract":[{"type":"text","text":"A generic "},{"type":"codeVoice","code":"@ModelActor"},{"text":" that reads and writes any ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentatio