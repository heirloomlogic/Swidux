n\/SwiduxPersistence\/EntityDB","isActive":true},{"type":"text","text":" and wires the registered"},{"type":"text","text":" "},{"type":"text","text":"entities into a "},{"code":"Swidux.PersistencePlugin","type":"codeVoice"},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","url":"\/documentation\/swiduxpersistence\/persistencecoordinator","title":"PersistenceCoordinator","kind":"symbol","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/rehydrate(into:)":{"kind":"symbol","url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:)","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:)","title":"rehydrate(into:)","abstract":[{"type":"text","text":"Re-hydration that merges disk rows into the live "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":"s without"},{"type":"text","text":" "},{"type":"text","text":"dropping unflushed writes or in-progress edits (rule #8)."}],"type":"topic"}}}