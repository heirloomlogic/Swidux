{"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:)","interfaceLanguage":"swift"},"sections":[],"abstract":[{"text":"Re-hydration that merges disk rows into the live ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":"s without","type":"text"},{"text":" ","type":"text"},{"text":"dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"metadata":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}],"title":"rehydrate(into:)","role":"symbol","modules":[{"name":"SwiduxPersistence"}],"roleHeading":"Instance Method","symbolKind":"method","externalID":"s:17SwiduxPersistence0B11CoordinatorC9rehydrate4intoyxz_tYaF"},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":" "},{"kind":"internalParam","text":"state"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","text":"Discussion","type":"heading"},{"style":"important","name":"Important","content":[{"inlineContent":[{"text":"The merge prefers the in-memory value for ","type":"text"},{"type":"strong","inlineContent":[{"text":"every","type":"text"}]},{"text":" ID","type":"text"},{"text":" ","type":"text"},{"text":"already in memory, and never removes entities. Mid-session, remote","type":"text"},{"text":" ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"edits","type":"text"}]},{"text":" to entities you already hold and remote ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"deletions","type":"text"}]},{"text":" therefore","type":"text"},{"text":" ","type":"text"},{"text":"do not surface until the next launch — re-hydration is additive-only","type":"text"},{"text":" ","type":"text"},{"text":"by design. That is the price of never clobbering unflushed writes or","type":"text"},{"text":" ","type":"text"},{"text":"live UI edits; per-ID dirty tracking that relaxes this is a possible","type":"text"},{"text":" ","type":"text"},{"text":"future refinement.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"inlineContent":[{"type":"text","text":"Pending writes and deletions are flushed to disk "},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"type":"text","text":" the merge, so a"},{"type":"text","text":" "},{"type":"text","text":"remote-change refresh that fires during the debounce window can’t read a"},{"type":"text","text":" "},{"type":"text","text":"stale disk row for an entity the user just edited or deleted and resurrect"},{"type":"text","text":" "},{"type":"text","text":"it. This mirrors "},{"code":"SyncCoordinator.setSyncEnabled","type":"codeVoice"},{"type":"text","text":"’s flush-first discipline"},{"type":"text","text":" "},{"type":"text","text":"and makes every "},{"code":"rehydrate","type":"codeVoice"},{"type":"text","text":" caller safe by construction."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If a fetch fails, the corresponding "},{"code":"EntityStore","type":"codeVoice"},{"type":"text","text":" is left untouched"},{"type":"text","text":" "},{"type":"text","text":"and the failure is reported via "},{"code":"onFailure","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"abstract":[],"title":"SwiduxPersistence","role":"collection","kind":"symbol","url":"\/documentation\/swiduxpersistence","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistenceCoordinator","kind":"identifier"}],"title":"PersistenceCoordinator","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","type":"topic","url":"\/documentation\/swiduxpersistence\/persistencecoordinator","abstract":[{"type":"text","text":"Owns the "},{"code":"ModelContainer","type":"codeVoice"},{"type":"text","text":" + generic "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","isActive":true},{"type":"text","text":" and wires the registered"},{"type":"text","text":" "},{"type":"text","text":"entities into a "},{"type":"codeVoice","code":"Swidux.PersistencePlugin"},{"type":"text","text":"."}],"role":"symbol","navigatorTitle":[{"text":"PersistenceCoordinator","kind":"identifier"}],"kind":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/rehydrate(into:)":{"url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:)","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/Persis