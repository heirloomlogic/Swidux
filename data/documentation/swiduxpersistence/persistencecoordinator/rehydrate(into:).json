{"abstract":[{"text":"Re-hydration that merges disk rows into the live ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":"s without","type":"text"},{"text":" ","type":"text"},{"text":"dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"state","kind":"internalParam"},{"text":": ","kind":"text"},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"text":"State","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"}],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","level":2,"type":"heading","text":"Discussion"},{"name":"Important","type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The merge prefers the in-memory value for "},{"type":"strong","inlineContent":[{"type":"text","text":"every"}]},{"type":"text","text":" ID"},{"type":"text","text":" "},{"type":"text","text":"already in memory, and never removes entities. Mid-session, remote"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"text":"edits","type":"text"}]},{"type":"text","text":" to entities you already hold and remote "},{"type":"emphasis","inlineContent":[{"type":"text","text":"deletions"}]},{"type":"text","text":" therefore"},{"type":"text","text":" "},{"type":"text","text":"do not surface until the next launch — re-hydration is additive-only"},{"type":"text","text":" "},{"type":"text","text":"by design. That is the price of never clobbering unflushed writes or"},{"type":"text","text":" "},{"type":"text","text":"live UI edits; per-ID dirty tracking that relaxes this is a possible"},{"type":"text","text":" "},{"type":"text","text":"future refinement."}]}]},{"inlineContent":[{"type":"text","text":"Pending writes and deletions are flushed to disk "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" the merge, so a"},{"text":" ","type":"text"},{"text":"remote-change refresh that fires during the debounce window can’t read a","type":"text"},{"text":" ","type":"text"},{"text":"stale disk row for an entity the user just edited or deleted and resurrect","type":"text"},{"text":" ","type":"text"},{"text":"it. This mirrors ","type":"text"},{"code":"SyncCoordinator.setSyncEnabled","type":"codeVoice"},{"text":"’s flush-first discipline","type":"text"},{"text":" ","type":"text"},{"text":"and makes every ","type":"text"},{"code":"rehydrate","type":"codeVoice"},{"text":" caller safe by construction.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If a fetch fails, the corresponding "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":" is left untouched"},{"type":"text","text":" "},{"type":"text","text":"and the failure is reported via "},{"type":"codeVoice","code":"onFailure"},{"type":"text","text":"."}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"externalID":"s:17SwiduxPersistence0B11CoordinatorC9rehydrate4intoyxz_tYaF","roleHeading":"Instance Method","role":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}],"title":"rehydrate(into:)","symbolKind":"method","modules":[{"name":"SwiduxPersistence"}]},"sections":[],"hierarchy":{"paths":[[