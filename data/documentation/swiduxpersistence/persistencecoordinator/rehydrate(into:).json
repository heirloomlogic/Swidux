{"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:)","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator"]]},"metadata":{"roleHeading":"Instance Method","symbolKind":"method","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}],"modules":[{"name":"SwiduxPersistence"}],"title":"rehydrate(into:)","externalID":"s:17SwiduxPersistence0B11CoordinatorC9rehydrate4intoyxz_tYaF","role":"symbol"},"kind":"symbol","abstract":[{"type":"text","text":"Re-hydration that merges disk rows into the live "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":"s without"},{"type":"text","text":" "},{"type":"text","text":"dropping unflushed writes or in-progress edits (rule #8)."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"rehydrate","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":" ","kind":"text"},{"text":"state","kind":"internalParam"},{"text":": ","kind":"text"},{"text":"inout","kind":"keyword"},{"text":" ","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"kind":"text","text":") "},{"text":"async","kind":"keyword"}]}]},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"type":"aside","name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The merge prefers the in-memory value for "},{"type":"strong","inlineContent":[{"text":"every","type":"text"}]},{"type":"text","text":" ID"},{"type":"text","text":" "},{"type":"text","text":"already in memory, and never removes entities. Mid-session, remote"},{"type":"text","text":" "},{"type":"emphasis","inlineContent":[{"type":"text","text":"edits"}]},{"type":"text","text":" to entities you already hold and remote "},{"type":"emphasis","inlineContent":[{"type":"text","text":"deletions"}]},{"type":"text","text":" therefore"},{"text":" ","type":"text"},{"type":"text","text":"do not surface until the next launch — re-hydration is additive-only"},{"type":"text","text":" "},{"type":"text","text":"by design. That is the price of never clobbering unflushed writes or"},{"type":"text","text":" "},{"type":"text","text":"live UI edits; per-ID dirty tracking that relaxes this is a possible"},{"text":" ","type":"text"},{"type":"text","text":"future refinement."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pending writes and deletions are flushed to disk "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the merge, so a"},{"type":"text","text":" "},{"type":"text","text":"remote-change refresh that fires during the debounce window can’t read a"},{"type":"text","text":" "},{"type":"text","text":"stale disk row for an entity the user just edited or deleted and resurrect"},{"type":"text","text":" "},{"type":"text","text":"it. This mirrors "},{"type":"codeVoice","code":"SyncCoordinator.setSyncEnabled"},{"type":"text","text":"’s flush-first discipline"},{"type":"text","text":" "},{"type":"text","text":"and makes every "},{"type":"codeVoice","code":"rehydrate"},{"text":" caller safe by construction.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If a fetch fails, the corresponding "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":" is left untouched"},{"type":"text","text":" "},{"type":"text","text":"and the failure is reported via "},{"type":"codeVoice","code":"onFailure"},{"type":"text","text":"."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:)"]}],"sections":[],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/rehydrate(into:)":{"url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:)","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Re-hydration that merges disk rows into the live "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":"s without"},{"type":"text","text":" "},{"type":"text","text":"dropping unflushed writes or in-progress edits (rule #8)."}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}],"title":"rehydrate(into:)","role":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:)"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator":{"abstract":[{"type":"text","text":"Owns the "},{"type":"codeVoice","code":"ModelContainer"},{"type":"text","text":" + generic "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB"},{"type":"text","text":" and wires the registered"},{"type":"text","text":" "},{"type":"text","text":"entities into a "},{"type":"codeVoice","code":"Swidux.PersistencePlugin"},{"type":"text","text":"."}],"type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistenceCoordinator","kind":"identifier"}],"title":"PersistenceCoordinator","navigatorTitle":[{"text":"PersistenceCoordinator","kind":"identifier"}],"url":"\/documentation\/swiduxpersistence\/persistencecoordinator","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","kind":"symbol","role":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"abstract":[],"type":"topic","title":"SwiduxPersistence","url":"\/documentation\/swiduxpersistence","kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","role":"collection"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"abstract":[{"type":"text","text":"A generic "},{"type":"codeVoice","code":"@ModelActor"},{"type":"text","text":" that reads and writes any "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","isActive":true},{"type":"text","text":"."}],"type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityDB"}],"title":"EntityDB","navigatorTitle":[{"kind":"identifier","text":"EntityDB"}],"url":"\/documentation\/swiduxpersistence\/entitydb","kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","role":"symbol"}}}