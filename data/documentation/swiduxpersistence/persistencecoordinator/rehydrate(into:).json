text":"and makes every "},{"type":"codeVoice","code":"rehydrate"},{"type":"text","text":" caller safe by construction."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If a fetch fails, the corresponding "},{"type":"codeVoice","code":"EntityStore"},{"type":"text","text":" is left untouched"},{"type":"text","text":" "},{"type":"text","text":"and the failure is reported via "},{"type":"codeVoice","code":"onFailure"},{"type":"text","text":"."}]}]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/rehydrate(into:)":{"role":"symbol","kind":"symbol","url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/rehydrate(into:)","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/rehydrate(into:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"rehydrate"},{"kind":"text","text":"("},{"kind":"externalParam","text":"into"},{"kind":"text","text":": "},{"kind":"keyword","text":"inout"},{"kind":"text","text":" "},{"kind":"typeIdentifier","text":"State"},{"kind":"text","text":") "},{"kind":"keyword","text":"async"}],"title":"rehydrate(into:)","abstract":[{"text":"Re-hydration that merges disk rows into the live ","type":"text"},{"code":"EntityStore","type":"codeVoice"},{"text":"s without","type":"text"},{"text":" ","type":"text"},{"text":"dropping unflushed writes or in-progress edits (rule #8).","type":"text"}],"type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"role":"symbol","kind":"symbol","url":"\/documentation\/swiduxpersistence\/entitydb","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityDB"}],"navigatorTitle":[{"kind":"identifier","text":"EntityDB"}],"title":"EntityDB","abstract":[{"text":"A generic ","type":"text"},{"code":"@ModelAct