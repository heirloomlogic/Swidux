{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/Relation(deleteRule:)"},"metadata":{"title":"Relation(deleteRule:)","modules":[{"name":"SwiduxPersistence"}],"symbolKind":"macro","roleHeading":"Macro","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Relation"},{"kind":"text","text":"("},{"kind":"externalParam","text":"deleteRule"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:17SwiduxPersistence0A10DeleteRuleO","text":"SwiduxDeleteRule"},{"kind":"text","text":")"}],"externalID":"s:17SwiduxPersistence8Relation10deleteRuleyAA0a6DeleteE0O_tcfm","role":"symbol"},"sections":[],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@attached"},{"kind":"text","text":"(peer) "},{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Relation"},{"kind":"text","text":"("},{"kind":"externalParam","text":"deleteRule"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiduxPersistence0A10DeleteRuleO","kind":"typeIdentifier","text":"SwiduxDeleteRule","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/SwiduxDeleteRule"},{"kind":"text","text":")"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The current implementation embeds child values in the parent and reconciles"},{"type":"text","text":" "},{"type":"text","text":"them when the parent is saved. Its converters do not support back-references"},{"type":"text","text":" "},{"type":"text","text":"or bidirectional relationships. Give the child a "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/ForeignKey()","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" if"},{"type":"text","text":" "},{"type":"text","text":"it needs to name its parent; this marker adds no referential constraint."},{"type":"text","text":" "},{"type":"text","text":"For independently addressable entities, use "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/BelongsTo(_:inverse:)","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/HasMany(_:inverse:)","type":"reference","isActive":true},{"type":"text","text":" to generate storage references from scalar IDs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That also makes the relationship "},{"inlineContent":[{"text":"local-only","type":"text"}],"type":"strong"},{"type":"text","text":". CloudKit mirroring requires"},{"type":"text","text":" "},{"type":"text","text":"an inverse on every relationship, so a model that declares a "},{"type":"codeVoice","code":"@Relation"},{"type":"text","text":" "},{"type":"text","text":"can’t be synced: "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/ContainerFactory"},{"type":"text","text":" refuses to build a mirrored container"},{"type":"text","text":" "},{"type":"text","text":"over it and throws "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/CloudKitIncompatibleSchema"},{"type":"text","text":". In a synced app, store an"},{"type":"text","text":" "},{"type":"text","text":"owned value with "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/Inline()"},{"type":"text","text":", or register the child as an entity of its own"},{"type":"text","text":" "},{"type":"text","text":"with a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/ForeignKey()"},{"type":"text","text":" to its parent."}]},{"inlineContent":[{"type":"text","text":"A to-many relation is "},{"type":"strong","inlineContent":[{"text":"unordered","type":"text"}]},{"type":"text","text":": SwiftData stores it as a set, so the"},{"type":"text","text":" "},{"type":"text","text":"array comes back from storage in no particular order, and a change that only"},{"type":"text","text":" "},{"type":"text","text":"reorders it is not saved. Sort in the domain (or store an explicit position)"},{"type":"text","text":" "},{"type":"text","text":"when order matters."}],"type":"paragraph"}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"kind":"symbol","abstract":[{"text":"Marks a property as a SwiftData relationship to another ","type":"text"},{"code":"@Persisted","type":"codeVoice"},{"text":" entity.","type":"text"},{"text":" ","type":"text"},{"text":"The property’s type must reference the related ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"domain"}]},{"text":" type (","type":"text"},{"code":"[Card]","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"Card?","type":"codeVoice"},{"text":"); the generated model substitutes the ","type":"text"},{"code":"…Model","type":"codeVoice"},{"text":" shadow.","type":"text"}],"variants":[{"paths":["\/documentation\/swiduxpersistence\/relation(deleterule:)"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/Inline()":{"url":"\/documentation\/swiduxpersistence\/inline()","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/Inline()","fragments":[{"kind":"keyword","text":"macro"},{"kind":"text","text":" "},{"kind":"identifier","text":"Inline"},{"kind":"text","text":"()"}],"role":"symbol","kind":"symbol","title":"Inline()","abstract":[{"text":"Forces a ","type":"text"},{"type":"co