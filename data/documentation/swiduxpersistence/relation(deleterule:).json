{"abstract":[{"type":"text","text":"Marks a property as a SwiftData relationship to another "},{"code":"@Persisted","type":"codeVoice"},{"type":"text","text":" entity."},{"type":"text","text":" "},{"type":"text","text":"The property’s type must reference the related "},{"type":"emphasis","inlineContent":[{"type":"text","text":"domain"}]},{"type":"text","text":" type ("},{"code":"[Card]","type":"codeVoice"},{"type":"text","text":" or"},{"type":"text","text":" "},{"code":"Card?","type":"codeVoice"},{"type":"text","text":"); the generated model substitutes the "},{"code":"…Model","type":"codeVoice"},{"type":"text","text":" shadow."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/Relation(deleteRule:)"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/relation(deleterule:)"]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"externalID":"s:17SwiduxPersistence8Relation10deleteRuleyAA0a6DeleteE0O_tcfm","title":"Relation(deleteRule:)","symbolKind":"macro","roleHeading":"Macro","modules":[{"name":"SwiduxPersistence"}],"role":"symbol","fragments":[{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Relation","kind":"identifier"},{"text":"(","kind":"text"},{"text":"deleteRule","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SwiduxDeleteRule","preciseIdentifier":"s:17SwiduxPersistence0A10DeleteRuleO","kind":"typeIdentifier"},{"kind":"text","text":")"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(peer) ","kind":"text"},{"text":"macro","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"Relation"},{"kind":"text","text":"("},{"kind":"externalParam","text":"deleteRule"},{"kind":"text","text":": "},{"preciseIdentifier":"s:17SwiduxPersistence0A10DeleteRuleO","kind":"typeIdentifier","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/SwiduxDeleteRule","text":"SwiduxDeleteRule"},{"kind":"text","text":")"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"The current implementation embeds child values in the parent and reconciles","type":"text"},{"text":" ","type":"text"},{"text":"them when the parent is saved. Its converters do not support back-references","type":"text"},{"text":" ","type":"text"},{"text":"or bidirectional relationships. Give the child a ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/ForeignKey()","type":"reference","isActive":true},{"text":" ","type":"text"},{"type":"codeVoice","code":"UUID"},{"text":" if","type":"text"},{"text":" ","type":"text"},{"text":"it needs to name its parent; this marker adds no referential constraint.","type":"text"},{"text":" ","type":"text"},{"text":"For independently addressable entities, use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/BelongsTo(_:inverse:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/HasMany(_:inverse:)","type":"reference"},{"text":" to generate storage references from scalar IDs.","type":"text"}]},{"inlineContent":[{"type":"text","text":"That also makes the relationship "},{"type":"strong","inlineContent":[{"text":"local-only","type":"text"}]},{"type":"text","text":". CloudKit mirroring requires"},{"type":"text","text":" "},{"type":"text","text":"an inverse on every relationship, so a model that declares a "},{"code":"@Relation","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"can’t be synced: "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/ContainerFactory","isActive":true,"type":"reference"},{"type":"text","text":" refuses to build a mirrored container"},{"type":"text","text":" "},{"type":"text","text":"over it and throws "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/CloudKitIncompatibleSchema","isActive":true,"type":"reference"},{"type":"text","text":". In a synced app, store an"},{"type":"text","text":" "},{"type":"text","text":"owned value with "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/Inline()","isActive":true,"type":"reference"},{"type":"text","text":", or register the child as an entity of its own"},{"type":"text","text":" "},{"type":"text","text":"with a "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/ForeignKey()","isActive":true,"type":"reference"},{"type":"text","text":" to its parent."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A to-many relation is "},{"type":"strong","inlineContent":[{"type":"text","text":"unordered"}]},{"type":"text","text":": SwiftData stores it as a set, so the"},{"type":"text","text":" "},{"type":"text","text":"array comes back from storage in no particular order, and a change that only"},{"type":"text","text":" "},{"type":"text","text":"reorders it is not saved. Sort in the domain (or store an explicit position)"},{"type":"text","text":" "},{"type":"text","text":"when order matters."}],"type":"paragraph"}]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/CloudKitIncompatibleSchema":{"navigatorTitle":[{"kind":"identifier","text":"CloudKitIncompatibleSchema"}],"title":"CloudKitIncompatibleSchema","kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/CloudKitIncompatibleSchema","url":"\/documentation\/swiduxpersistence\/cloudkitincompatibleschema","role":"symbol","type":"topic","fragments":[{"kind":"keyword","tex