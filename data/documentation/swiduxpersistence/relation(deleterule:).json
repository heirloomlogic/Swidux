{"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"@attached","kind":"attribute"},{"text":"(peer) ","kind":"text"},{"text":"macro","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Relation","kind":"identifier"},{"text":"(","kind":"text"},{"text":"deleteRule","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"SwiduxDeleteRule","preciseIdentifier":"s:17SwiduxPersistence0A10DeleteRuleO","kind":"typeIdentifier","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/SwiduxDeleteRule"},{"text":")","kind":"text"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"overview","text":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The current implementation embeds child values in the parent and reconciles"},{"type":"text","text":" "},{"type":"text","text":"them when the parent is saved. Its converters do not support back-references"},{"type":"text","text":" "},{"type":"text","text":"or bidirectional relationships. Give the child a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/ForeignKey()"},{"type":"text","text":" "},{"code":"UUID","type":"codeVoice"},{"type":"text","text":" if"},{"type":"text","text":" "},{"type":"text","text":"it needs to name its parent; this marker adds no referential constraint."},{"type":"text","text":" "},{"type":"text","text":"For independently addressable entities, use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/BelongsTo(_:inverse:)"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/HasMany(_:inverse:)","type":"reference"},{"type":"text","text":" to generate storage references from scalar IDs."}],"type":"paragraph"},{"type":"paragrap