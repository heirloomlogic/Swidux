{"abstract":[{"type":"text","text":"IDs an app has declared it is editing, exempt from a re-hydration merge for"},{"type":"text","text":" "},{"type":"text","text":"as long as the hold is in force."}],"relationshipsSections":[{"identifiers":["doc:\/\/SwiduxPersistence\/s8SendableP","doc:\/\/SwiduxPersistence\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/editingholds"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds"},"metadata":{"symbolKind":"class","roleHeading":"Class","navigatorTitle":[{"kind":"identifier","text":"EditingHolds"}],"title":"EditingHolds","modules":[{"name":"SwiduxPersistence"}],"role":"symbol","externalID":"s:17SwiduxPersistence12EditingHoldsC","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EditingHolds","kind":"identifier"}]},"topicSections":[{"identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/init()"],"title":"Initializers","generated":true,"anchor":"Initializers"},{"identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/ids","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/isEmpty"],"title":"Instance Properties","generated":true,"anchor":"Instance-Properties"},{"identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/hold(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/isHolding(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/release(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/releaseAll()"],"title":"Instance Methods","generated":true,"anchor":"Instance-Methods"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EditingHolds","kind":"identifier"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"inlineContent":[{"text":"Every other exemption is inferred: ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/changes"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"writer’s drained-but-unflushed buffers, and the failed-flush ledger all","type":"text"},{"text":" ","type":"text"},{"text":"describe writes the ","type":"text"},{"inlineContent":[{"text":"store","type":"text"}],"type":"emphasis"},{"text":" has seen. A value still sitting in a view’s local","type":"text"},{"text":" ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":" is in none of them, so under","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote"},{"type":"text","text":" a remote edit can land underneath a half-typed"},{"type":"text","text":" "},{"type":"text","text":"field and the user’s next keystroke dispatches against a value that changed"},{"type":"text","text":" "},{"type":"text","text":"out from under them."}],"type":"paragraph"},{"inlineContent":[{"text":"A hold closes exactly that window, and nothing wider:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["TextEditor(text: $draft)","    .holdsEntity(note.id, in: persistence.editing)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Prefer that modifier — it takes the hold when the editor appears and gives it"},{"type":"text","text":" "},{"type":"text","text":"back when the editor goes away, so there is no release to forget. Reach for"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/hold(_:)","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/release(_:)","isActive":true,"type":"reference"},{"type":"text","text":" directly only where the editing session"},{"type":"text","text":" "},{"type":"text","text":"isn’t a view’s lifetime."}],"type":"paragraph"},{"anchor":"What-a-hold-is-not","level":2,"text":"What a hold is not","type":"heading"},{"inlineContent":[{"type":"text","text":"A hold "},{"type":"strong","inlineContent":[{"type":"text","text":"defers a remote change; it does not veto one."}]},{"type":"text","text":" Release it and the"},{"type":"text","text":" "},{"type":"text","text":"next merge applies whatever storage holds, including a deletion made"},{"type":"text","text":" "},{"type":"text","text":"elsewhere — provided nothing writes the row first. Committing a draft for a"},{"type":"text","text":" "},{"type":"text","text":"row a peer deleted re-creates it, and a live row outranks the tombstone, so"},{"type":"text","text":" "},{"type":"text","text":"the edit wins. Check"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/isRemotelyDeleted(_:)","type":"reference","isActive":true},{"text":" before committing when that","type":"text"},{"text":" ","type":"text"},{"text":"is not what you want. The worst a leaked hold can do is strand one row at a stale","type":"text"},{"text":" ","type":"text"},{"text":"value, which is what ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","type":"reference"},{"text":" does on purpose. It is","type":"text"},{"text":" ","type":"text"},{"text":"not data loss, and it is not silent either: a merge that actually withheld a","type":"text"},{"text":" ","type":"text"},{"text":"differing value reports","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/mergeWithheld(entityType:ids:)","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two alternatives cost less and are often enough. "},{"code":"store.binding(_:sending:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"dispatches on write, which makes the value a drained-but-unflushed one and"},{"type":"text","text":" "},{"type":"text","text":"covers it already. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory"},{"type":"text","text":" exempts a whole collection"},{"type":"text","text":" "},{"type":"text","text":"permanently. A hold sits between them: remote-wins stays on everywhere else,"},{"type":"text","text":" "},{"type":"text","text":"and here only while the user is actually typing."}],"type":"paragraph"}]}],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceDiagnostic/mergeWithheld(entityType:ids:)":{"url":"\/documentation\/swiduxpersistence\/persistencediagnostic\/mergewithheld(entitytype:ids:)","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/mergeWithheld(entityType:ids:)","title":"mergeWithheld(entityType:ids:)","type":"topic","role":"symbol","kind":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mergeWithheld","kind":"identifier"},{"text":"(","kind":"text"},{"text":"e