{"sections":[],"topicSections":[{"title":"Initializers","anchor":"Initializers","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/init()"],"generated":true},{"title":"Instance Properties","anchor":"Instance-Properties","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/ids","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/isEmpty"],"generated":true},{"title":"Instance Methods","anchor":"Instance-Methods","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/hold(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/isHolding(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/release(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/releaseAll()"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/editingholds"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"role":"symbol","navigatorTitle":[{"text":"EditingHolds","kind":"identifier"}],"symbolKind":"class","modules":[{"name":"SwiduxPersistence"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EditingHolds"}],"externalID":"s:17SwiduxPersistence12EditingHoldsC","roleHeading":"Class","title":"EditingHolds"},"kind":"symbol","identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"abstract":[{"text":"IDs an app has declared it is editing, exempt from a re-hydration merge for","type":"text"},{"text":" ","type":"text"},{"text":"as long as the hold is in force.","type":"text"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EditingHolds"}]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"Every other exemption is inferred: ","type":"text"},{"identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/changes","isActive":true,"type":"reference"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"writer’s drained-but-unflushed buffers, and the failed-flush ledger all","type":"text"},{"text":" ","type":"text"},{"text":"describe writes the ","type":"text"},{"inlineContent":[{"text":"store","type":"text"}],"type":"emphasis"},{"text":" has seen. A value still sitting in a view’s local","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@State"},{"type":"text","text":" is in none of them, so under"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","type":"reference"},{"type":"text","text":" a remote edit can land underneath a half-typed"},{"type":"text","text":" "},{"type":"text","text":"field and the user’s next keystroke dispatches against a value that changed"},{"type":"text","text":" "},{"type":"text","text":"out from under them."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A hold closes exactly that window, and nothing wider:"}]},{"type":"codeListing","code":["TextEditor(text: $draft)","    .holdsEntity(note.id, in: persistence.editing)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefer that modifier — it takes the hold when the editor appears and gives it"},{"type":"text","text":" "},{"type":"text","text":"back when the editor goes away, so there is no release to forget. Reach for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/hold(_:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/release(_:)","isActive":true},{"type":"text","text":" directly only where the editing session"},{"type":"text","text":" "},{"text":"isn’t a view’s lifetime.","type":"text"}]},{"level":2,"anchor":"What-a-hold-is-not","type":"heading","text":"What a hold is not"},{"inlineContent":[{"type":"text","text":"A hold "},{"type":"strong","inlineContent":[{"text":"defers a remote change; it does not veto one.","type":"text"}]},{"type":"text","text":" Release it and the"},{"type":"text","text":" "},{"type":"text","text":"next merge applies whatever storage holds, including a deletion made"},{"type":"text","text":" "},{"type":"text","text":"elsewhere — provided nothing writes the row first. Committing a draft for a"},{"type":"text","text":" "},{"type":"text","text":"row a peer deleted re-creates it, and a live row outranks the tombstone, so"},{"type":"text","text":" "},{"type":"text","text":"the edit wins. Check"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/isRemotelyDeleted(_:)"},{"type":"text","text":" before committing when that"},{"type":"text","text":" "},{"type":"text","text":"is not what you want. The worst a leaked hold can do is strand one row at a stale"},{"type":"text","text":" "},{"type":"text","text":"value, which is what "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory"},{"type":"text","text":" does on purpose. It is"},{"type":"text","text":" "},{"type":"text","text":"not data loss, and it is not silent either: a merge that actually withheld a"},{"type":"text","text":" "},{"type":"text","text":"differing value reports"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/mergeWithheld(entityType:ids:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two alternatives cost less and are often enough. "},{"type":"codeVoice","code":"store.binding(_:sending:)"},{"text":" ","type":"text"},{"type":"text","text":"dispatches on write, which makes the value a drained-but-unflushed one and"},{"type":"text","text":" "},{"type":"text","text":"covers it already. "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","isActive":true},{"type":"text","text":" exempts a whole collection"},{"type":"text","text":" "},{"type":"text","text":"permanently. A hold sits between them: remote-wins stays on everywhere else,"},{"type":"text","text":" "},{"type":"text","text":"and here only while the user is actually typing."}],"type":"paragraph"}],"kind":"content"}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/SwiduxPersistence\/s8SendableP","doc:\/\/SwiduxPersistence\/s16SendableMetatypeP"],"kind":"relationships","type":"conformsTo"}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/mergeRemote(into:ids:deleted:policy:)":{"abstract":[{"text":"Re-hydration restricted to the rows a caller already knows changed.","type":"text"}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mergeRemote","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Store","preciseIdentifier":"s:6Swidux5StoreC","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIden