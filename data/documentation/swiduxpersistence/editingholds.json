ing:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"dispatches on write, which makes the value a drained-but-unflushed one and","type":"text"},{"text":" ","type":"text"},{"text":"covers it already. ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","isActive":true},{"text":" exempts a whole collection","type":"text"},{"text":" ","type":"text"},{"text":"permanently. A hold sits between them: remote-wins stays on everywhere else,","type":"text"},{"text":" ","type":"text"},{"text":"and here only while the user is actually typing.","type":"text"}]}]}],"sections":[],"metadata":{"modules":[{"name":"SwiduxPersistence"}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EditingHolds"}],"externalID":"s:17SwiduxPersistence12EditingHoldsC","title":"EditingHolds","symbolKind":"class","roleHeading":"Class","role":"symbol","navigatorTitle":[{"text":"EditingHolds","kind":"identifier"}]},"topicSections":[{"title":"Initializers","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/init()"],"generated":true,"anchor":"Initializers"},{"title":"Instance Properties","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/ids","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/isEmpty"],"generated":true,"anchor":"Instance-Properties"},{"title":"Instance Methods","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/hold(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/isHolding(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/release(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/releaseAll()"],"generated":true,"anchor":"Instance-Methods"}],"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/Swidux