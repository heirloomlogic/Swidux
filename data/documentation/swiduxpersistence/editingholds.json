{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"kind":"symbol","sections":[],"variants":[{"paths":["\/documentation\/swiduxpersistence\/editingholds"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"symbolKind":"class","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EditingHolds","kind":"identifier"}],"title":"EditingHolds","navigatorTitle":[{"kind":"identifier","text":"EditingHolds"}],"externalID":"s:17SwiduxPersistence12EditingHoldsC","role":"symbol","roleHeading":"Class","modules":[{"name":"SwiduxPersistence"}]},"abstract":[{"type":"text","text":"IDs an app has declared it is editing, exempt from a re-hydration merge for"},{"type":"text","text":" "},{"type":"text","text":"as long as the hold is in force."}],"topicSections":[{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/init()"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/ids","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/isEmpty"],"generated":true},{"anchor":"Instance-Methods","title":"Instance Methods","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/hold(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/isHolding(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/release(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/releaseAll()"],"generated":true}],"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/SwiduxPersistence\/s8SendableP","doc:\/\/SwiduxPersistence\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EditingHolds","kind":"identifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"Every other exemption is inferred: "},{"type":"codeVoice","code":"Swidux\/EntityStore\/changes"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"writer’s drained-but-unflushed buffers, and the failed-flush ledger all"},{"type":"text","text":" "},{"type":"text","text":"describe writes the "},{"type":"emphasis","inlineContent":[{"text":"store","type":"text"}]},{"type":"text","text":" has seen. A value still sitting in a view’s local"},{"type":"text","text":" "},{"type":"codeVoice","code":"@State"},{"type":"text","text":" is in none of them, so under"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","isActive":true},{"type":"text","text":" a remote edit can land underneath a half-typed"},{"type":"text","text":" "},{"type":"text","text":"field and the user’s next keystroke dispatches against a value that changed"},{"type":"text","text":" "},{"type":"text","text":"out from under them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A hold closes exactly that window, and nothing wider:"}],"type":"paragraph"},{"syntax":"swift","code":["TextEditor(text: $draft)","    .holdsEntity(note.id, in: persistence.editing)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Prefer that modifier — it takes the hold when the editor appears and gives it"},{"type":"text","text":" "},{"type":"text","text":"back when the editor goes away, so there is no release to forget. Reach for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/hold(_:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/release(_:)","isActive":true},{"type":"text","text":" directly only where the editing session"},{"type":"text","text":" "},{"type":"text","text":"isn’t a view’s lifetime."}],"type":"paragraph"},{"type":"heading","level":2,"text":"What a hold is not","anchor":"What-a-hold-is-not"},{"inlineContent":[{"type":"text","text":"A hold "},{"type":"strong","inlineContent":[{"text":"defers a remote change; it does not veto one.","type":"text"}]},{"type":"text","text":" Release it and the"},{"type":"text","text":" "},{"type":"text","text":"next merge applies whatever storage holds, including a deletion made"},{"type":"text","text":" "},{"type":"text","text":"elsewhere. The worst a leaked hold can do is strand one row at a stale"},{"type":"text","text":" "},{"type":"text","text":"value, which is what "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","isActive":true},{"type":"text","text":" does on purpose. It is"},{"type":"text","text":" "},{"type":"text","text":"not data loss, and it is not silent either: a merge that actually withheld a"},{"type":"text","text":" "},{"type":"text","text":"differing value reports"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/mergeWithheld(entityType:ids:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two alternatives cost less and are often enough. "},{"type":"codeVoice","code":"store.binding(_:sending:)"},{"type":"text","text":" "},{"type":"text","text":"dispatches on write, which makes the value a drained-but-unflushed one and"},{"type":"text","text":" "},{"type":"text","text":"covers it already. "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","isActive":true},{"type":"text","text":" exempts a whole collection"},{"type":"text","text":" "},{"type":"text","text":"permanently. A hold sits between them: remote-wins stays on everywhere else,"},{"type":"text","text":" "},{"type":"text","text":"and here only while the user is actually typing."}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds","interfaceLanguage":"swift"},"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/EditingHolds/hold(_:)":{"kind":"symbol","title":"hold(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hold","kind":"identifier"},{"text":"(","kind":"text"},{"text":"UUID","preciseIdentifier":"s:10Foundation4UUIDV","kind":"typeIdentifier"},{"text":")","kind":"text"}],"abstract":[{"type":"text","text":"Exempts "},{"code":"id","type":"codeVoice"},{"type":"text","text":" from the merge until a matching "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/release(_:)","isActive":true},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/swiduxpersistence\/editingholds\/hold(_:)","role":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/hold(_:)"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EditingHolds/release(_:)":{"kind":"symbol","title":"release(_:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"release"},{"kind":"text","text":"("},{"preciseIdentifier":"s:10Foundation4UUIDV","kind":"typeIdentifier","text":"UUID"},{"kind":"text","text":")"}],"abstract":[{"text":"Gives back one hold