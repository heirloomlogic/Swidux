{"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","text":"MainActor","preciseIdentifier":"s:ScM"},{"kind":"text","text":" "},{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EditingHolds"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"Every other exemption is inferred: "},{"code":"Swidux\/EntityStore\/changes","type":"codeVoice"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"writer’s drained-but-unflushed buffers, and the failed-flush ledger all"},{"type":"text","text":" "},{"type":"text","text":"describe writes the "},{"inlineContent":[{"type":"text","text":"store"}],"type":"emphasis"},{"type":"text","text":" has seen. A value still sitting in a view’s local"},{"type":"text","text":" "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" is in none of them, so under"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","isActive":true,"type":"reference"},{"type":"text","text":" a remote edit can land underneath a half-typed"},{"type":"text","text":" "},{"type":"text","text":"field and the user’s next keystroke dispatches against a value that changed"},{"type":"text","text":" "},{"type":"text","text":"out from under them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A hold closes exactly that window, and nothing wider:"}],"type":"paragraph"},{"code":["TextEditor(text: $draft)","    .holdsEntity(note.id, in: persistence.editing)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Prefer that modifier — it takes the hold when the editor appears and gives it"},{"type":"text","text":" "},{"type":"text","text":"back when the editor goes away, so there is no release to forget. Reach for"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/hold(_:)","isActive":true,"type":"reference"},{"type":"text","text":" and "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/release(_:)","isActive":true,"type":"reference"},{"type":"text","text":" directly only where the editing session"},{"type":"text","text":" "},{"type":"text","text":"isn’t a view’s lifetime."}],"type":"paragraph"},{"anchor":"What-a-hold-is-not","level":2,"text":"What a hold is not","type":"heading"},{"inlineContent":[{"type":"text","text":"A hold "},{"inlineContent":[{"type":"text","text":"defers a remote change; it does not veto one."}],"type":"strong"},{"type":"text","text":" Release it and the"},{"type":"text","text":" "},{"type":"text","text":"next merge applies whatever storage holds, including a deletion made"},{"type":"text","text":" "},{"type":"text","text":"elsewhere. The worst a leaked hold can do is strand one row at a stale"},{"type":"text","text":" "},{"type":"text","text":"value, which is what "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","isActive":true,"type":"reference"},{"type":"text","text":" does on purpose. It is"},{"type":"text","text":" "},{"type":"text","text":"not data loss, and it is not silent either: a merge that actually withheld a"},{"type":"text","text":" "},{"type":"text","text":"differing value reports"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/mergeWithheld(entityType:ids:)","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Two alternatives cost less and are often enough. "},{"code":"store.binding(_:sending:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"dispatches on write, which makes the value a drained-but-unflushed one and"},{"type":"text","text":" "},{"type":"text","text":"covers it already. "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","isActive":true,"type":"reference"},{"type":"text","text":" exempts a whole collection"},{"type":"text","text":" "},{"type":"text","text":"permanently. A hold sits between them: remote-wins stays on everywhere else,"},{"type":"text","text":" "},{"type":"text","text":"and here only while the user is actually typing."}],"type":"paragraph"}]}],"metadata":{"symbolKind":"class","externalID":"s:17SwiduxPersistence12EditingHoldsC","title":"EditingHolds","modules":[{"name":"SwiduxPersistence"}],"roleHeading":"Class","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"EditingHolds"}],"navigatorTitle":[{"kind":"identifier","text":"EditingHolds"}]},"variants":[{"paths":["\/documentation\/swiduxpersistence\/editingholds"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"generated":true,"anchor":"Initializers","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/init()"],"title":"Initializers"},{"generated":true,"anchor":"Instance-Properties","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/ids","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/isEmpty"],"title":"Instance Properties"},{"generated":true,"anchor":"Instance-Methods","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/hold(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/isHolding(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/release(_:)","doc:\/\/Swidu