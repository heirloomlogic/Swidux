{"abstract":[{"text":"IDs an app has declared it is editing, exempt from a re-hydration merge for","type":"text"},{"text":" ","type":"text"},{"text":"as long as the hold is in force.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/init()"],"title":"Initializers","anchor":"Initializers","generated":true},{"identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/ids","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/isEmpty"],"title":"Instance Properties","anchor":"Instance-Properties","generated":true},{"identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/hold(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/isHolding(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/release(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/releaseAll()"],"title":"Instance Methods","anchor":"Instance-Methods","generated":true}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds"},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"preciseIdentifier":"s:ScM","text":"MainActor","kind":"attribute"},{"text":" ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EditingHolds","kind":"identifier"}]}]},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"Every other exemption is inferred: ","type":"text"},{"type":"reference","identifier":"doc:\/\/Swidux\/documentation\/Swidux\/EntityStore\/changes","isActive":true},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"writer’s drained-but-unflushed buffers, and the failed-flush ledger all"},{"type":"text","text":" "},{"text":"describe writes the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"store"}]},{"text":" has seen. A value still sitting in a view’s local","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" is in none of them, so under","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","type":"reference","isActive":true},{"text":" a remote edit can land underneath a half-typed","type":"text"},{"text":" ","type":"text"},{"text":"field and the user’s next keystroke dispatches against a value that changed","type":"text"},{"text":" ","type":"text"},{"text":"out from under them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A hold closes exactly that window, and nothing wider:"}],"type":"paragraph"},{"code":["TextEditor(text: $draft)","    .holdsEntity(note.id, in: persistence.editing)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Prefer that modifier — it takes the hold when the editor appears and gives it"},{"type":"text","text":" "},{"type":"text","text":"back when the editor goes away, so there is no release to forget. Reach for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/hold(_:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/release(_:)","isActive":true},{"type":"text","text":" directly only where the editing session"},{"type":"text","text":" "},{"type":"text","text":"isn’t a view’s lifetime."}],"type":"paragraph"},{"text":"What a hold is not","anchor":"What-a-hold-is-not","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A hold "},{"type":"strong","inlineContent":[{"text":"defers a remote change; it does not veto one.","type":"text"}]},{"type":"text","text":" Release it and the"},{"type":"text","text":" "},{"type":"text","text":"next merge applies whatever storage holds, including a deletion made"},{"type":"text","text":" "},{"type":"text","text":"elsewhere — provided nothing writes the row first. Committing a draft for a"},{"type":"text","text":" "},{"type":"text","text":"row a peer deleted re-creates it, and a live row outranks the tombstone, so"},{"type":"text","text":" "},{"type":"text","text":"the edit wins. Check"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator\/isRemotelyDeleted(_:)","isActive":true},{"type":"text","text":" before committing when that"},{"type":"text","text":" "},{"type":"text","text":"is not what you want. The worst a leaked hold can do is strand one row at a stale"},{"type":"text","text":" "},{"type":"text","text":"value, which is what "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","isActive":true},{"type":"text","text":" does on purpose. It is"},{"type":"text","text":" "},{"type":"text","text":"not data loss, and it is not silent either: a merge that actually withheld a"},{"type":"text","text":" "},{"type":"text","text":"differing value reports"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/mergeWithheld(entityType:ids:)","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Two alternatives cost less and are often enough. ","type":"text"},{"type":"codeVoice","code":"store.binding(_:sending:)"},{"text":" ","type":"text"},{"text":"dispatches on write, which makes the value a drained-but-unflushed one and","type":"text"},{"text":" ","type":"text"},{"text":"covers it already. ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory"},{"text":" exempts a whole collection","type":"text"},{"text":" ","type":"text"},{"text":"permanently. A hold sits between them: remote-wins stays on everywhere else,","type":"text"},{"text":" ","type":"text"},{"text":"and here only while the user is actually typing.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/editingholds"]}],"metadata":{"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EditingHolds","kind":"identifier"}],"modules":[{"name":"SwiduxPersistence"}],"roleHeading":"Class","symbolKind":"class","navigatorTitle":[{"text":"EditingHolds","kind":"identifier"}],"role":"symbol","externalID":"s:17SwiduxPersistence12EditingHoldsC","title":"EditingHolds"},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"relationshipsSections":[{"kind":"relationships","title":"Conforms To","identifiers":["doc:\/\/SwiduxPersistence\/s8SendableP","doc:\/\/SwiduxPersistence\/s16SendableMetatypeP"],"type":"conformsTo"}],"sections":[],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/EditingHolds/init()":{"abstract":[{"type":"text","text":"Creates an empty ledger. "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","isActive":true},{"type":"text","text":" makes its own; an app"},{"type":"text","text":" "},{"type":"text","text":"normally uses that one rather than building this directly."}],"kind":"symbol","type":"topic","url":"\/documentation\/swiduxpersistence\/editingholds\/init()","title":"init()","role":"symbol","fragments":[{"text":"init","kind":"identifier"},{"text":"()","kind":"text"}],