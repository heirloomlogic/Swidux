ityDB","type":"reference","isActive":true},{"type":"text","text":" and wires the registered"},{"type":"text","text":" "},{"type":"text","text":"entities into a "},{"code":"Swidux.PersistencePlugin","type":"codeVoice"},{"type":"text","text":"."}],"role":"symbol","title":"PersistenceCoordinator","kind":"symbol","url":"\/documentation\/swiduxpersistence\/persistencecoordinator"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EditingHolds/isEmpty":{"url":"\/documentation\/swiduxpersistence\/editingholds\/isempty","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/isEmpty","type":"topic","title":"isEmpty","role":"symbol","kind":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isEmpty"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"abstract":[{"text":"Whether nothing at all is held.","type":"text"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceCoordinator/mergeRemote(into:ids:deleted:policy:)":{"url":"\/documentation\/swiduxpersistence\/persistencecoordinator\/mergeremote(into:ids:deleted:policy:)","kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"mergeRemote","kind":"identifier"},{"text":"(","kind":"text"},{"text":"into","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Store","kind":"typeIdentifier","preciseIdentifier":"s:6Swidux5StoreC"},{"text":"<","kind":"text"},{"text":"State","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"Action","kind":"typeIdentifier"},{"text":">, ","kind":"text"},{"text":"ids","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"UUID","kind":"typeIdentifier","preciseIdentifier":"s:10Foundation4UUIDV"},{"text":">, ","kind":"text"},{"text":"deleted","kind":"externalParam"},{"kind":"text","text":