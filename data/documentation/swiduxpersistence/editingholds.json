{"relationshipsSections":[{"kind":"relationships","identifiers":["doc:\/\/SwiduxPersistence\/s8SendableP","doc:\/\/SwiduxPersistence\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To"}],"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"attribute","text":"@"},{"kind":"attribute","preciseIdentifier":"s:ScM","text":"MainActor"},{"kind":"text","text":" "},{"kind":"keyword","text":"final"},{"kind":"text","text":" "},{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"EditingHolds"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every other exemption is inferred: "},{"code":"Swidux\/EntityStore\/changes","type":"codeVoice"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"writer’s drained-but-unflushed buffers, and the failed-flush ledger all"},{"type":"text","text":" "},{"type":"text","text":"describe writes the "},{"type":"emphasis","inlineContent":[{"text":"store","type":"text"}]},{"type":"text","text":" has seen. A value still sitting in a view’s local"},{"type":"text","text":" "},{"code":"@State","type":"codeVoice"},{"type":"text","text":" is in none of them, so under"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","isActive":true},{"type":"text","text":" a remote edit can land underneath a half-typed"},{"type":"text","text":" "},{"type":"text","text":"field and the user’s next keystroke dispatches against a value that changed"},{"type":"text","text":" "},{"type":"text","text":"out from under them."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A hold closes exactly that window, and nothing wider:"}]},{"syntax":"swift","type":"codeListing","code":["TextEditor(text: $draft)","    .holdsEntity(note.id, in: persistence.editing)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefer that modifier — it takes the hold when the editor appears and gives it"},{"type":"text","text":" "},{"type":"text","text":"back when the editor goes away, so there is no release to forget. Reach for"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/hold(_:)","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/release(_:)","isActive":true},{"type":"text","text":" directly only where the editing session"},{"type":"text","text":" "},{"type":"text","text":"isn’t a view’s lifetime."}]},{"level":2,"text":"What a hold is not","type":"heading","anchor":"What-a-hold-is-not"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A hold "},{"type":"strong","inlineContent":[{"text":"defers a remote change; it does not veto one.","type":"text"}]},{"type":"text","text":" Release it and the"},{"type":"text","text":" "},{"type":"text","text":"next merge applies whatever storage holds, including a deletion made"},{"type":"text","text":" "},{"type":"text","text":"elsewhere. The worst a leaked hold can do is strand one row at a stale"},{"type":"text","text":" "},{"type":"text","text":"value, which is what "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","isActive":true},{"type":"text","text":" does on purpose. It is"},{"type":"text","text":" "},{"type":"text","text":"not data loss, and it is not silent either: a merge that actually withheld a"},{"type":"text","text":" "},{"type":"text","text":"differing value reports"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceDiagnostic\/mergeWithheld(entityType:ids:)","isActive":true},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two alternatives cost less and are often enough. "},{"code":"store.binding(_:sending:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"dispatches on write, which makes the value a drained-but-unflushed one and"},{"type":"text","text":" "},{"type":"text","text":"covers it already. "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferInMemory","isActive":true},{"type":"text","text":" exempts a whole collection"},{"type":"text","text":" "},{"type":"text","text":"permanently. A hold sits between them: remote-wins stays on everywhere else,"},{"type":"text","text":" "},{"type":"text","text":"and here only while the user is actually typing."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/editingholds"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"externalID":"s:17SwiduxPersistence12EditingHoldsC","navigatorTitle":[{"kind":"identifier","text":"EditingHolds"}],"title":"EditingHolds","roleHeading":"Class","symbolKind":"class","modules":[{"name":"SwiduxPersistence"}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"kind":"text","text":" "},{"text":"EditingHolds","kind":"identifier"}]},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds","interfaceLanguage":"swift"},"topicSections":[{"identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/init()"],"anchor":"Initializers","title":"Initializers","generated":true},{"anchor":"Instance-Properties","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/ids","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHol