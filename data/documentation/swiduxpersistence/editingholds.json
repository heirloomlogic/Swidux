{"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/init()"],"generated":true,"title":"Initializers","anchor":"Initializers"},{"identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/ids","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/isEmpty"],"generated":true,"title":"Instance Properties","anchor":"Instance-Properties"},{"identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/hold(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/isHolding(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/release(_:)","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/releaseAll()"],"generated":true,"title":"Instance Methods","anchor":"Instance-Methods"}],"relationshipsSections":[{"identifiers":["doc:\/\/SwiduxPersistence\/s8SendableP","doc:\/\/SwiduxPersistence\/s16SendableMetatypeP"],"kind":"relationships","title":"Conforms To","type":"conformsTo"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","preciseIdentifier":"s:ScM","kind":"attribute"},{"text":" ","kind":"text"},{"text":"final","kind":"keyword"},{"text":" ","kind":"text"},{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EditingHolds","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"overview"},{"inlineContent":[{"text":"Every other exemption is inferred: ","type":"text"},{"code":"Swidux\/EntityStore\/changes","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"writer’s drained-but-unflushed buffers, and the failed-flush ledger all","type":"text"},{"text":" ","type":"text"},{"text":"describe writes the ","type":"text"},{"inlineContent":[{"text":"store","type":"text"}],"type":"emphasis"},{"text":" has seen. A value still sitting in a view’s local","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@State"},{"text":" is in none of them, so under","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/MergePolicy\/preferRemote","isActive":true},{"text":" a remote edit can land underneath a half-typed","type":"text"},{"text":" ","type":"text"},{"text":"field and the user’s next keystroke dispatches against a value that changed","type":"text"},{"text":" ","type":"text"},{"text":"out from under them.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"A hold closes exactly that window, and nothing wider:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["TextEditor(text: $draft)","    .holdsEntity(note.id, in: persistence.editing)"]},{"type":"paragraph","inlineContent":[{"text":"Prefer that modifier — it takes the hold when the editor appears and gives it","type":"text"},{"text":" ","type":"text"},{"text":"back when the editor goes away, so there is no release to forget. Reach for","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/hold(_:)","type":"reference","isActive":true},{"text":" and ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EditingHolds\/release(_:)","type":"reference","isActive":true},{"text":" directly only where the editing session","type":"text"},{"text":" ","type":"text"},{"text":"isn’t a view’s lifetime.","type":"text"}]},{"type":"heading","level":2,"anchor":"What-a-hold-is-not","text":"What a hold is not"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A hold "},{