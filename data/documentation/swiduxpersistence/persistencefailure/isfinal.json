{"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal"},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFinal","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A failed save is retried on a bounded backoff, so most "},{"type":"codeVoice","code":".save"},{"type":"text","text":" failures"},{"type":"text","text":" "},{"type":"text","text":"arrive with this "},{"type":"codeVoice","code":"false"},{"type":"text","text":" and are followed by a successful attempt the"},{"type":"text","text":" "},{"type":"text","text":"app never hears about. "},{"type":"codeVoice","code":"true"},{"type":"text","text":" means the retry budget is spent: the value"},{"type":"text","text":" "},{"type":"text","text":"is still in memory and still protected from being overwritten by the"},{"type":"text","text":" "},{"type":"text","text":"stale stored row, but it is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" on disk and nothing further will be"},{"type":"text","text":" "},{"type":"text","text":"attempted until the entity is edited again or the app flushes"},{"type":"text","text":" "},{"type":"text","text":"explicitly. This is the one worth telling the user about."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Always "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":", which is not retried."}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiduxpersistence\/persistencefailure\/isfinal"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Whether the stack has stopped retrying this write."}],"metadata":{"title":"isFinal","roleHeading":"Instance Property","symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFinal","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"externalID":"s:17SwiduxPersistence0B7FailureV7isFinalSbvp","modules":[{"name":"SwiduxPersistence"}],"role":"symbol"},"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure"]]},"sections":[],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"abstract":[],"url":"\/documentation\/swiduxpersistence","kind":"symbol","title":"SwiduxPersistence","type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","role":"collection"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure/isFinal":{"title":"isFinal","url":"\/documentation\/swiduxpersistence\/persistencefailure\/isfinal","abstract":[{"type":"text","text":"Whether the stack has stopped retrying this write."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFinal","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"type":"topic","role":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal","kind":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure":{"navigatorTitle":[{"text":"PersistenceFailure","kind":"identifier"}],"type":"topic","title":"PersistenceFailure","abstract":[{"type":"text","text":"A persistence operation that failed."}],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\