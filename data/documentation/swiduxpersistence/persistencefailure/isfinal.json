{"sections":[],"abstract":[{"type":"text","text":"Whether the stack has stopped retrying this write."}],"metadata":{"title":"isFinal","externalID":"s:17SwiduxPersistence0B7FailureV7isFinalSbvp","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isFinal"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"symbolKind":"property","modules":[{"name":"SwiduxPersistence"}],"role":"symbol","roleHeading":"Instance Property"},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isFinal"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Discussion","anchor":"discussion"},{"inlineContent":[{"type":"text","text":"A failed save is retried on a bounded backoff, so most "},{"code":".save","type":"codeVoice"},{"type":"text","text":" failures"},{"type":"text","text":" "},{"type":"text","text":"arrive with this "},{"code":"false","type":"codeVoice"},{"type":"text","text":" and are followed by a successful attempt the"},{"type":"text","text":" "},{"type":"text","text":"app never hears about. "},{"code":"true","type":"codeVoice"},{"type":"text","text":" means the retry budget is spent: the value"},{"type":"text","text":" "},{"type":"text","text":"is still in memory and still protected from being overwritten by the"},{"type":"text","text":" "},{"type":"text","text":"stale stored row, but it is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" on disk and nothing further will be"},{"type":"text","text":" "},{"type":"text","text":"attempted until the entity is edited again or the app flushes"},{"type":"text","text":" "},{"type":"text","text":"explicitly. This is the one worth telling the user about."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Always "},{"code":"false","type":"codeVoice"},{"type":"text","text":" for "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":", which is not retried."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencefailure\/isfinal"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal","interfaceLanguage":"swift"},"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure/isFinal":{"kind":"symbol","title":"isFinal","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isFinal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"abstract":[{"text":"Whether the stack has stopped retrying this write.","type":"text"}],"type":"topic","url":"\/documentation\/swiduxpersistence\/persistencefailure\/isfinal","role":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal"},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"kind":"symbol","title":"SwiduxPersistence","abstract":[],"type":"topic","url":"\/documentation\/swiduxpersistence","role":"collection","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure":{"kind":"symbol","title":"PersistenceFailure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistenceFailure"}],"navigatorTitle":[{"kind":"identifier","text":"PersistenceFailure"}],"abs