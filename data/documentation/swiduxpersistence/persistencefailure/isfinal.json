{"sections":[],"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Whether the stack has stopped retrying this write."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure"]]},"kind":"symbol","metadata":{"externalID":"s:17SwiduxPersistence0B7FailureV7isFinalSbvp","symbolKind":"property","title":"isFinal","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isFinal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"roleHeading":"Instance Property","modules":[{"name":"SwiduxPersistence"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencefailure\/isfinal"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isFinal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"platforms":["macOS"]}]},{"kind":"content","content":[{"level":2,"type":"heading","text":"Discussion","anchor":"discussion"},{"inlineContent":[{"text":"A failed save is retried on a bounded backoff, so most ","type":"text"},{"code":".save","type":"codeVoice"},{"text":" failures","type":"text"},{"text":" ","type":"text"},{"text":"arrive with this ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" and are followed by a successful attempt the","type":"text"},{"text":" ","type":"text"},{"text":"app never hears about. ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" means the retry budget is spent: the value","type":"text"},{"text":" ","type":"text"},{"text":"is still in memory and still protected from being overwritten by the","type":"text"},{"text":" ","type":"text"},{"text":"stale stored row, but it is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" on disk and nothing further will be","type":"text"},{"text":" ","type":"text"},{"text":"attempted until the entity is edited again or the app flushes","type":"text"},{"text":" ","type":"text"},{"text":"explicitly. This is the one worth telling the user about.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Always ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":", which is not retried.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","abstract":[],"url":"\/documentation\/swiduxpersistence","title":"SwiduxPersistence","role":"collection","kind":"symbol","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure/isFinal":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal","abstract":[{"type":"text","text":"Whether the stack has stopped retrying this write."}],"url":"\/documentation\/swiduxpersistence\/persistencefailure\/isfinal","title":"isFinal","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFinal","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"kind":"symbol","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure":{"role":"symbol","title":"PersistenceFailure","url":"\/documentation\/swiduxpersistence\/persistencefailure","abstract":[{"type":"text","text":"A persistence operation that failed."}],"kind":"symbol","type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure","navigatorTitle":[{"text":"PersistenceFailure","kind":"identifier"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistenceFailure"}]}}}