,{"text":" ","type":"text"},{"text":"stale stored row, but it is ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" on disk and nothing further will be","type":"text"},{"text":" ","type":"text"},{"text":"attempted until the entity is edited again or the app flushes","type":"text"},{"text":" ","type":"text"},{"text":"explicitly. This is the one worth telling the user about.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Always ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":", which is not retried.","type":"text"}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Whether the stack has stopped retrying this write."}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","url":"\/documentation\/swiduxpersistence","title":"SwiduxPersistence","role":"collection","abstract":[],"kind":"symbol","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistenceFailure"}],"url":"\/documentation\/swiduxpersistence\/persistencefailure","navigatorTitle":[{"kind":"identifier","text":"PersistenceFailure"}],"abstract":[{"type":"text","text":"A persistence operation that failed."}],"title":"PersistenceFailure","kind":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure/isFinal":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFinal","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"type":"topic","url":"\/documentation\/swiduxpersistence\/persistencef