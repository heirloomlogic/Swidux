{"abstract":[{"type":"text","text":"Whether the stack has stopped retrying this write."}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isFinal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"discussion","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A failed save is retried on a bounded backoff, so most "},{"type":"codeVoice","code":".save"},{"type":"text","text":" failures"},{"type":"text","text":" "},{"type":"text","text":"arrive with this "},{"type":"codeVoice","code":"false"},{"type":"text","text":" and are followed by a successful attempt the"},{"type":"text","text":" "},{"type":"text","text":"app never hears about. "},{"type":"codeVoice","code":"true"},{"type":"text","text":" means the retry budget is spent: the value"},{"type":"text","text":" "},{"type":"text","text":"is still in memory and still protected from being overwritten by the"},{"type":"text","text":" "},{"type":"text","text":"stale stored row, but it is "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" on disk and nothing further will be"},{"type":"text","text":" "},{"type":"text","text":"attempted until the entity is edited again or the app flushes"},{"type":"text","text":" "},{"type":"text","text":"explicitly. This is the one worth telling the user about."}]},{"type":"paragraph","inlineContent":[{"text":"Always ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" for ","type":"text"},{"code":".fetch","type":"codeVoice"},{"text":", which is not retried.","type":"text"}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencefailure\/isfinal"]}],"metadata":{"symbolKind":"property","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFinal","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"externalID":"s:17SwiduxPersistence0B7FailureV7isFinalSbvp","role":"symbol","modules":[{"name":"SwiduxPersistence"}],"title":"isFinal","roleHeading":"Instance Property"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure"]]},"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal","interfaceLanguage":"swift"},"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"kind":"symbol","url":"\/documentation\/swiduxpersistence","role":"collection","title":"SwiduxPersistence","type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","abstract":[]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure/isFinal":{"kind":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFinal","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/swiduxpersistence\/persistencefailure\/isfinal","role":"symbol","title":"isFinal","type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal","abstract":[{"type":"text","text":"Whether the stack has stopped retrying this write."}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure":{"kind":"symbol","url":"\/documentation\/swiduxpersistence\/persistencefailure","abstract":[{"text":"A persistence operation that failed.","type":"text"}],"type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistenceFailure","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"PersistenceFailure","kind":"identifier"}],"title":"PersistenceFailure"}}}