 on disk and nothing further will be"},{"type":"text","text":" "},{"type":"text","text":"attempted until the entity is edited again or the app flushes"},{"type":"text","text":" "},{"type":"text","text":"explicitly. This is the one worth telling the user about."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Always "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":", which is not retried."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Whether the stack has stopped retrying this write."}],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure"]]},"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"url":"\/documentation\/swiduxpersistence","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","role":"collection","kind":"symbol","title":"SwiduxPersistence","abstract":[],"type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure":{"url":"\/documentation\/swiduxpersistence\/persistencefailure","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistenceFailure","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"PersistenceFailure"}],"role":"symbol","kind":"symbol","title":"PersistenceFailure","abstract":[{"text":"A persistence operation that failed.","type":"text"}],"type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure/isFinal":{"title":"isFinal","url":"\/documentation\/swiduxpersistence\/persistencefailure\/isfinal","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal","kind":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind"