{"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure"]]},"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Instance Property","symbolKind":"property","externalID":"s:17SwiduxPersistence0B7FailureV7isFinalSbvp","role":"symbol","modules":[{"name":"SwiduxPersistence"}],"fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isFinal"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"title":"isFinal"},"abstract":[{"type":"text","text":"Whether the stack has stopped retrying this write."}],"variants":[{"paths":["\/documentation\/swiduxpersistence\/persistencefailure\/isfinal"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"symbol","schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isFinal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"discussion","type":"heading","text":"Discussion"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A failed save is retried on a bounded backoff, so most "},{"type":"codeVoice","code":".save"},{"type":"text","text":" failures"},{"type":"text","text":" "},{"type":"text","text":"arrive with this "},{"type":"codeVoice","code":"false"},{"type":"text","text":" and are followed by a successful attempt the"},{"type":"text","text":" "},{"type":"text","text":"app never hears about. "},{"type":"codeVoice","code":"true"},{"type":"text","text":" means the retry budget is spent: the value"},{"type":"text","text":" "},{"type":"text","text":"is still in memory and still protected from being overwritten by the"},{"type":"text","text":" "},{"type":"text","text":"stale stored row, but it is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" on disk and nothing further will be"},{"type":"text","text":" "},{"type":"text","text":"attempted until the entity is edited again or the app flushes"},{"type":"text","text":" "},{"type":"text","text":"explicitly. This is the one worth telling the user about."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Always "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":", which is not retried."}]}],"kind":"content"}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"abstract":[],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","title":"SwiduxPersistence","url":"\/documentation\/swiduxpersistence","kind":"symbol","role":"collection","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure":{"kind":"symbol","navigatorTitle":[{"text":"PersistenceFailure","kind":"identifier"}],"abstract":[{"text":"A persistence operation that failed.","type":"text"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistenceFailure","kind":"identifier"}],"title":"PersistenceFailure","url":"\/documentation\/swiduxpersistence\/persistencefailure","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure/isFinal":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal","kind":"symbol","type":"topic","abstract":[{"type":"text","text":"Whether the stack has stopped retrying this write."}],"role":"symbol","url":"\/documentation\/swiduxpersist