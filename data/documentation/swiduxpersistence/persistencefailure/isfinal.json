xt","text":" on disk and nothing further will be"},{"type":"text","text":" "},{"type":"text","text":"attempted until the entity is edited again or the app flushes"},{"type":"text","text":" "},{"type":"text","text":"explicitly. This is the one worth telling the user about."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Always "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":", which is not retried."}],"type":"paragraph"}]}],"kind":"symbol","abstract":[{"type":"text","text":"Whether the stack has stopped retrying this write."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal"},"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"title":"SwiduxPersistence","type":"topic","role":"collection","kind":"symbol","abstract":[],"url":"\/documentation\/swiduxpersistence","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure":{"navigatorTitle":[{"text":"PersistenceFailure","kind":"identifier"}],"title":"PersistenceFailure","type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"A persistence operation that failed."}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistenceFailure","kind":"identifier"}],"url":"\/documentation\/swiduxpersistence\/persistencefailure","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure/isFinal":{"title":"isFinal","type":"topic","role":"symbol","kind":"symbol","abstract":[{"type":"text","text":"Whether the stack has stopped retrying this write."}],"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFinal","kind":"identifier"},{"text":": "