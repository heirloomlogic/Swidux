{"kind":"symbol","abstract":[{"type":"text","text":"Whether the stack has stopped retrying this write."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFinal","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Discussion","anchor":"discussion","level":2,"type":"heading"},{"inlineContent":[{"text":"A failed save is retried on a bounded backoff, so most ","type":"text"},{"code":".save","type":"codeVoice"},{"text":" failures","type":"text"},{"text":" ","type":"text"},{"text":"arrive with this ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" and are followed by a successful attempt the","type":"text"},{"text":" ","type":"text"},{"text":"app never hears about. ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":" means the retry budget is spent: the value"},{"type":"text","text":" "},{"type":"text","text":"is still in memory and still protected from being overwritten by the"},{"type":"text","text":" "},{"type":"text","text":"stale stored row, but it is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" on disk and nothing further will be"},{"type":"text","text":" "},{"type":"text","text":"attempted until the entity is edited again or the app flushes"},{"type":"text","text":" "},{"type":"text","text":"explicitly. This is the one worth telling the user about."}],"type":"paragraph"},{"inlineContent":[{"text":"Always ","type":"text"},{"code":"false","type":"codeVoice"},{"type":"text","text":" for "},{"code":".fetch","type":"codeVoice"},{"type":"text","text":", which is not retried."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal","interfaceLanguage":"swift"},"metadata":{"symbolKind":"property","modules":[{"name":"SwiduxPersistence"}],"roleHeading":"Instance Property","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"isFinal"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"}],"externalID":"s:17SwiduxPersistence0B7FailureV7isFinalSbvp","title":"isFinal"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencefailure\/isfinal"]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"title":"SwiduxPersistence","url":"\/documentation\/swiduxpersistence","abstract":[],"role":"collection","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","kind":"symbol","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure":{"title":"PersistenceFailure","kind":"symbol","url":"\/documentation\/swiduxpersistence\/persistencefailure","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure","abstract":[{"type":"text","text":"A persistence operation that failed."}],"type":"topic","fragments":[{"kind":"keyword","text":"struct"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PersistenceFailure"}],"role":"symbol","navigatorTitle":[{"text":"PersistenceFailure","kind":"identifier"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure/isFinal":{"title":"isFinal","kind":"symbol","url":"\/documentation\/swiduxpersistence\/persistencefailure\/isfinal","abstract":[{"text":"Whether the stack has stopped retrying this write.","type":"text"}],"type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersi