{"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal"},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFinal","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"discussion","text":"Discussion","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A failed save is retried on a bounded backoff, so most "},{"code":".save","type":"codeVoice"},{"type":"text","text":" failures"},{"type":"text","text":" "},{"type":"text","text":"arrive with this "},{"code":"false","type":"codeVoice"},{"type":"text","text":" and are followed by a successful attempt the"},{"type":"text","text":" "},{"type":"text","text":"app never hears about. "},{"code":"true","type":"codeVoice"},{"type":"text","text":" means the retry budget is spent: the value"},{"type":"text","text":" "},{"type":"text","text":"is still in memory and still protected from being overwritten by the"},{"type":"text","text":" "},{"type":"text","text":"stale stored row, but it is "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" on disk and nothing further will be","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"attempted until the entity is edited again or the app flushes"},{"type":"text","text":" "},{"type":"text","text":"explicitly. This is the one worth telling the user about."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Always "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":", which is not retried."}]}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/swiduxpersistence\/persistencefailure\/isfinal"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"SwiduxPersistence"}],"title":"isFinal","symbolKind":"property","roleHeading":"Instance Property","externalID":"s:17SwiduxPersistence0B7FailureV7isFinalSbvp","role":"symbol","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFinal","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}]},"abstract":[{"text":"Whether the stack has stopped retrying this write.","type":"text"}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure/isFinal":{"url":"\/documentation\/swiduxpersistence\/persistencefailure\/isfinal","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal","title":"isFinal","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isFinal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"kind":"symbol","type":"topic","role":"symbol","abstract":[{"text":"Whether the stack has stopped retrying this write.","type":"text"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"title":"SwiduxPersistence","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","url":"\/documentation\/swiduxpersistence","kind":"symbol","type":"topic","role":"collection","abstract":[]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure":{"title":"PersistenceFailure","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure","url":"\/documentation\/swiduxpersistence\/persistencefailure","fragments":[{"kind":"keyword","text":"struct"},{"kind":"