{"abstract":[{"text":"Whether the stack has stopped retrying this write.","type":"text"}],"metadata":{"roleHeading":"Instance Property","modules":[{"name":"SwiduxPersistence"}],"externalID":"s:17SwiduxPersistence0B7FailureV7isFinalSbvp","symbolKind":"property","role":"symbol","title":"isFinal","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"text":"isFinal","kind":"identifier"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}]},"primaryContentSections":[{"declarations":[{"tokens":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isFinal"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"text":"Discussion","level":2,"anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"A failed save is retried on a bounded backoff, so most ","type":"text"},{"type":"codeVoice","code":".save"},{"text":" failures","type":"text"},{"text":" ","type":"text"},{"text":"arrive with this ","type":"text"},{"type":"codeVoice","code":"false"},{"text":" and are followed by a successful attempt the","type":"text"},{"text":" ","type":"text"},{"text":"app never hears about. ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" means the retry budget is spent: the value","type":"text"},{"text":" ","type":"text"},{"text":"is still in memory and still protected from being overwritten by the","type":"text"},{"text":" ","type":"text"},{"text":"stale stored row, but it is ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"text":" on disk and nothing further will be","type":"text"},{"text":" ","type":"text"},{"text":"attempted until the entity is edited again or the app flushes","type":"text"},{"type":"text","text":" "},{"type":"text","text":"explicitly. This is the one worth telling the user about."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Always "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":".fetch"},{"text":", which is not retried.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"symbol","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal"},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/swiduxpersistence\/persistencefailure\/isfinal"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"abstract":[],"title":"SwiduxPersistence","role":"collection","url":"\/documentation\/swiduxpersistence","type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","kind":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure","title":"PersistenceFailure","abstract":[{"text":"A persistence operation that failed.","type":"text"}],"url":"\/documentation\/swiduxpersistence\/persistencefailure","kind":"symbol","navigatorTitle":[{"text":"PersistenceFailure","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistenceFailure","kind":"identifier"}],"role":"symbol","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure/isFinal":{"abstract":[{"text":"Whether the stack has stopped retrying this write.","type":"text"}],"type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal","kind":"symbol","role":"symbol","url":"\/documentation\/swiduxpersist