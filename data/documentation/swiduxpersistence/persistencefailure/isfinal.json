{"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencefailure\/isfinal"]}],"kind":"symbol","abstract":[{"type":"text","text":"Whether the stack has stopped retrying this write."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFinal","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"anchor":"discussion","type":"heading","level":2,"text":"Discussion"},{"inlineContent":[{"type":"text","text":"A failed save is retried on a bounded backoff, so most "},{"type":"codeVoice","code":".save"},{"type":"text","text":" failures"},{"type":"text","text":" "},{"type":"text","text":"arrive with this "},{"type":"codeVoice","code":"false"},{"type":"text","text":" and are followed by a successful attempt the"},{"type":"text","text":" "},{"type":"text","text":"app never hears about. "},{"type":"codeVoice","code":"true"},{"type":"text","text":" means the retry budget is spent: the value"},{"type":"text","text":" "},{"type":"text","text":"is still in memory and still protected from being overwritten by the"},{"type":"text","text":" "},{"type":"text","text":"stale stored row, but it is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" on disk and nothing further will be"},{"type":"text","text":" "},{"type":"text","text":"attempted until the entity is edited again or the app flushes"},{"type":"text","text":" "},{"type":"text","text":"explicitly. This is the one worth telling the user about."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Always "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":", which is not retried."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"roleHeading":"Instance Property","symbolKind":"property","title":"isFinal","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"text":"isFinal","kind":"identifier"},{"text":": ","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"modules":[{"name":"SwiduxPersistence"}],"externalID":"s:17SwiduxPersistence0B7FailureV7isFinalSbvp"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal"},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure"]]},"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure/isFinal":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal","title":"isFinal","type":"topic","kind":"symbol","abstract":[{"type":"text","text":"Whether the stack has stopped retrying this write."}],"url":"\/documentation\/swiduxpersistence\/persistencefailure\/isfinal","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"isFinal","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistenceFailure":{"url":"\/documentation\/swiduxpersistence\/persistencefailure","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure","abstract":[{"type":"text","text":"A persistence operation that failed."}],"navigatorTitle":[{"text":"PersistenceFailure","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistenceFailure"}],"role":"symbol","title":"PersistenceFailure"},"doc://Swi