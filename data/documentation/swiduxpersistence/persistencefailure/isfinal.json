{"sections":[],"abstract":[{"text":"Whether the stack has stopped retrying this write.","type":"text"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"isFinal","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:Sb","text":"Bool","kind":"typeIdentifier"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"inlineContent":[{"type":"text","text":"A failed save is retried on a bounded backoff, so most "},{"type":"codeVoice","code":".save"},{"type":"text","text":" failures"},{"type":"text","text":" "},{"type":"text","text":"arrive with this "},{"type":"codeVoice","code":"false"},{"type":"text","text":" and are followed by a successful attempt the"},{"type":"text","text":" "},{"type":"text","text":"app never hears about. "},{"type":"codeVoice","code":"true"},{"type":"text","text":" means the retry budget is spent: the value"},{"type":"text","text":" "},{"type":"text","text":"is still in memory and still protected from being overwritten by the"},{"type":"text","text":" "},{"type":"text","text":"stale stored row, but it is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" on disk and nothing further will be"},{"type":"text","text":" "},{"type":"text","text":"attempted until the entity is edited again or the app flushes"},{"type":"text","text":" "},{"type":"text","text":"explicitly. This is the one worth telling the user about."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Always "},{"type":"codeVoice","code":"false"},{"type":"text","text":" for "},{"type":"codeVoice","code":".fetch"},{"type":"text","text":", which is not retried."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure\/isFinal","interfaceLanguage":"swift"},"schemaVer