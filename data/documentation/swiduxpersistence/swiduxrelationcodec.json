{"kind":"symbol","metadata":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiduxRelationCodec"}],"modules":[{"name":"SwiduxPersistence"}],"navigatorTitle":[{"kind":"identifier","text":"SwiduxRelationCodec"}],"title":"SwiduxRelationCodec","roleHeading":"Enumeration","role":"symbol","symbolKind":"enum","externalID":"s:17SwiduxPersistence0A13RelationCodecO"},"sections":[],"topicSections":[{"title":"Type Methods","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/SwiduxRelationCodec\/reconcile(_:with:in:)-1wwve","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/SwiduxRelationCodec\/reconcile(_:with:in:)-5oivn"],"generated":true,"anchor":"Type-Methods"}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiduxRelationCodec","kind":"identifier"}],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"anchor":"Why-a-converter-cant-just-rebuild-its-children","type":"heading","text":"Why a converter can’t just rebuild its children"},{"inlineContent":[{"type":"text","text":"The obvious "},{"type":"codeVoice","code":"update(from:)"},{"type":"text","text":" body — "},{"type":"codeVoice","code":"self.chapters = try domain.chapters.map { try ChapterModel(from: $0) }"},{"type":"text","text":" — is a row leak. A relationship’s "},{"type":"codeVoice","code":"deleteRule"},{"type":"text","text":" "},{"type":"text","text":"fires when the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"parent"}]},{"type":"text","text":" is deleted, never when a child is dropped from the"},{"type":"text","text":" "},{"type":"text","text":"relationship, so the previously-related rows are detached rather than"},{"type":"text","text":" "},{"type":"text","text":"removed: they stay in the store with no owner, and nothing ever collects"},{"type":"text","text":" "},{"type":"text","text":"them. Every save of the parent leaves another full copy of its children"},{"type":"text","text":" "},{"type":"text","text":"behind, the store grows for the life of the app, and "},{"type":"codeVoice","code":"toDomain()"},{"type":"text","text":" — which"},{"type":"text","text":" "},{"type":"text","text":"only walks the current relationship — shows nothing wrong."}],"type":"paragraph"},{"inlineContent":[{"text":"So the write-back reconciles by ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" instead: rows whose identity survives","type":"text"},{"text":" ","type":"text"},{"text":"are updated in place, new identities are inserted, and identities that are","type":"text"},{"text":" ","type":"text"},{"text":"gone are deleted outright.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Identity-not-row-identity","type":"heading","text":"Identity, not row identity"},{"type":"paragraph","inlineContent":[{"text":"Reconciling in place also keeps ","type":"text"},{"code":"persistentModelID","type":"codeVoice"},{"text":" stable across a save.","type":"text"},{"text":" ","type":"text"},{"text":"That matters beyond tidiness: a rebuilt child is a delete plus an insert, so","type":"text"},{"text":" ","type":"text"},{"text":"under CloudKit mirroring every parent edit re-uploads its whole subtree, and","type":"text"},{"text":" ","type":"text"},{"text":"every one of those writes a history transaction that a remote-change tick","type":"text"},{"text":" ","type":"text"},{"text":"then has to resolve.","type":"text"}]},{"level":2,"anchor":"Duplicates-are-kept-as-everywhere-else","type":"heading","text":"Duplicates are kept, as everywhere else"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Persisted"},{"type":"text","text":" emits no "},{"type":"codeVoice","code":"@Attribute(.unique)"},{"type":"text","text":" on "},{"type":"codeVoice","code":"id"},{"type":"text","text":" (CloudKit forbids unique"},{"type":"text","text":" "},{"type":"text","text":"constraints), so several related rows may legitimately share one identity."},{"type":"text","text":" "},{"type":"text","text":"They are all updated and all kept, matching "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","isActive":true},{"type":"text","text":": converging every"},{"type":"text","text":" "},{"type":"text","text":"matching row is safe, while picking one survivor is not — two devices pick"},{"type":"text","text":" "},{"type":"text","text":"different rows, each tombstones the other’s, and both are lost."}]}],"kind":"content"}],"abstract":[{"type":"text","text":"Reconciles a generated model’s "},{"type":"codeVoice","code":"@Relation"},{"type":"text","text":" properties against the domain"},{"type":"text","text":" "},{"type":"text","text":"value being written. Not meant to be called directly."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/swiduxrelationcodec"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/SwiduxRelationCodec"},"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"title":"SwiduxPersistence","url":"\/documentation\/swiduxpersistence","abstract":[],"role":"collection","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","kind":"symbol","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"abstract":[{"text":"A generic ","type":"text"},{"code":"@ModelActor","type":"codeVoice"},{"text":" that reads and writes any ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","type":"reference","isActive":true},{"text":".","type":"text"}],"kind":"symbol","title":"EntityDB","navigatorTitle":[{"kind":"identifier","text":"EntityD