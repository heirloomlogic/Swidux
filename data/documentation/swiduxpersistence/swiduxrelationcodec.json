{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/SwiduxRelationCodec","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/swiduxpersistence\/swiduxrelationcodec"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Reconciles a generated model’s "},{"code":"@Relation","type":"codeVoice"},{"text":" properties against the domain","type":"text"},{"text":" ","type":"text"},{"text":"value being written. Not meant to be called directly.","type":"text"}],"metadata":{"role":"symbol","title":"SwiduxRelationCodec","externalID":"s:17SwiduxPersistence0A13RelationCodecO","symbolKind":"enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiduxRelationCodec"}],"roleHeading":"Enumeration","modules":[{"name":"SwiduxPersistence"}],"navigatorTitle":[{"kind":"identifier","text":"SwiduxRelationCodec"}]},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"SwiduxRelationCodec"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"anchor":"Why-a-converter-cant-just-rebuild-its-children","type":"heading","level":2,"text":"Why a converter can’t just rebuild its children"},{"inlineContent":[{"type":"text","text":"The obvious "},{"type":"codeVoice","code":"update(from:)"},{"type":"text","text":" body — "},{"type":"codeVoice","code":"self.chapters = domain.chapters.map { ChapterModel(from: $0) }"},{"type":"text","text":" — is a row leak. A relationship’s "},{"type":"codeVoice","code":"deleteRule"},{"type":"text","text":" "},{"type":"text","text":"fires when the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"parent"}]},{"type":"text","text":" is deleted, never when a child is dropped from the"},{"type":"text","text":" "},{"type":"text","text":"relationship, so the previously-related rows are detached rather than"},{"type":"text","text":" "},{"type":"text","text":"removed: they stay in the store with no owner, and nothing ever collects"},{"type":"text","text":" "},{"type":"text","text":"them. Every save of the parent leaves another full copy of its children"},{"type":"text","text":" "},{"type":"text","text":"behind, the store grows for the life of the app, and "},{"code":"toDomain()","type":"codeVoice"},{"type":"text","text":" — which"},{"type":"text","text":" "},{"type":"text","text":"only walks the current relationship — shows nothing wrong."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"So the write-back reconciles by "},{"code":"id","type":"codeVoice"},{"type":"text","text":" instead: rows whose identity survives"},{"type":"text","text":" "},{"type":"text","text":"are updated in place, new identities are inserted, and identities that are"},{"type":"text","text":" "},{"type":"text","text":"gone are deleted outright."}],"type":"paragraph"},{"text":"Identity, not row identity","anchor":"Identity-not-row-identity","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Reconciling in place also keeps "},{"type":"codeVoice","code":"persistentModelID"},{"type":"text","text":" stable across a save."},{"type":"text","text":" "},{"type":"text","text":"That matters beyond tidiness: a rebuilt child is a delete plus an insert, so"},{"type":"text","text":" "},{"type":"text","text":"under CloudKit mirroring every parent edit re-uploads its whole subtree, and"},{"type":"text","text":" "},{"type":"text","text":"every one of those writes a history transaction that a remote-change tick"},{"type":"text","text":" "},{"type":"text","text":"then has to resolve."}],"type":"paragraph"},{"anchor":"Duplicates-are-kept-as-everywhere-else","level":2,"text":"Duplicates are kept, as everywhere else","type":"heading"},{"inlineContent":[{"code":"@Persisted","type":"codeVoice"},{"text":" emits no ","type":"text"},{"code":"@Attribute(.unique)","type":"codeVoice"},{"type":"text","text":" on "},{"code":"id","type":"codeVoice"},{"text":" (CloudKit forbids unique","type":"text"},{"type":"text","text":" "},{"type":"text","text":"constraints), so several related rows may legitimately share one identity."},{"type":"text","text":" "},{"type":"text","text":"They are all updated and all kept, matching "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB"},{"type":"text","text":": converging every"},{"text":" ","type":"text"},{"type":"text","text":"matching row is safe, while picking one survivor is not — two devices pick"},{"type":"text","text":" "},{"type":"text","text":"different rows, each tombstones the other’s, and both are lost."}],"type":"paragraph"}]}],"topicSections":[{"anchor":"Type-Methods","generated":true,"title":"Type Methods","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/SwiduxRelationCodec\/reconcile(_:with:in:)-34utk","doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/SwiduxRelationCodec\/reconcile(_:with:in:)-9zflx"]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/SwiduxRelationCodec":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/SwiduxRelationCodec","url":"\/documentation\/swiduxpersistence\/swiduxrelationcodec","abstract":[{"text":"Reconciles a generated model’s ","type":"text"},{"type":"codeVoice","code":"@Relation"},{"text":" properties against the domain","type":"text"},{"text":" ","type":"text"},{"text":"value being written. Not meant to be called directly.","type":"text"}],"navigatorTitle":[{"text":"SwiduxRelationCodec","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SwiduxRelationCodec","kind":"identifier"}],