saction that a remote-change tick","type":"text"},{"text":" ","type":"text"},{"text":"then has to resolve.","type":"text"}]},{"level":2,"anchor":"Duplicates-are-kept-as-everywhere-else","type":"heading","text":"Duplicates are kept, as everywhere else"},{"type":"paragraph","inlineContent":[{"code":"@Persisted","type":"codeVoice"},{"text":" emits no ","type":"text"},{"code":"@Attribute(.unique)","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" (CloudKit forbids unique","type":"text"},{"text":" ","type":"text"},{"text":"constraints), so several related rows may legitimately share one identity.","type":"text"},{"text":" ","type":"text"},{"text":"They are all updated and all kept, matching ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","isActive":true,"type":"reference"},{"text":": converging every","type":"text"},{"text":" ","type":"text"},{"text":"matching row is safe, while picking one survivor is not — two devices pick","type":"text"},{"text":" ","type":"text"},{"text":"different rows, each tombstones the other’s, and both are lost.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistableModel":{"abstract":[{"text":"The generated SwiftData ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" shadow for a ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableEntity","isActive":true,"type":"reference"},{"text":".","type":"text"}],"kind":"symbol","title":"PersistableModel","role":"symbol","navigatorTitle":[{"text":"PersistableModel","kind":"identifier"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","type":"topic","url":"\/documentation\/swiduxpersistence\/persistablemodel","fragments":[{"text":"protocol","kind":"keyword"},{"text":" 