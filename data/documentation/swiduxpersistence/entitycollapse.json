{"topicSections":[{"identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)"],"generated":true,"anchor":"Type-Methods","title":"Type Methods"}],"abstract":[{"type":"text","text":"Ready-made collapse resolvers."}],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"primaryContentSections":[{"declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityCollapse"}],"platforms":["macOS"]}],"kind":"declarations"},{"kind":"content","content":[{"anchor":"Why-the-hook-takes-the-whole-collection","level":2,"type":"heading","text":"Why the hook takes the whole collection"},{"inlineContent":[{"text":"A per-ID resolver would only handle half the problem. Rows sharing an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are one failure mode; the other is a ","type":"text"},{"inlineContent":[{"text":"singleton","type":"text"}],"type":"strong"},{"text":" — an entity an app holds","type":"text"},{"text":" ","type":"text"},{"text":"exactly one of, such as a settings record. Created independently on two","type":"text"},{"text":" ","type":"text"},{"text":"fresh installs, two singletons have ","type":"text"},{"inlineContent":[{"type":"text","text":"different"}],"type":"emphasis"},{"text":" UUIDs, so nothing groups","type":"text"},{"text":" ","type":"text"},{"text":"them and no ID-keyed resolver can ever see the conflict. A","type":"text"},{"text":" ","type":"text"},{"code":"([E]) -> [E]","type":"codeVoice"},{"text":" hook covers both, plus general garbage collection, with one","type":"text"},{"text":" ","type":"text"},{"text":"API.","type":"text"}],"type":"paragraph"},{"anchor":"The-determinism-requirement","text":"The determinism requirement","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A resolver must be a pure function of "},{"type":"strong","inlineContent":[{"text":"replicated content","type":"text"}]},{"type":"text","text":" — never"},{"type":"text","text":" "},{"type":"codeVoice","code":"persistentModelID"},{"type":"text","text":", never a local timestamp, never array position. Every"},{"type":"text","text":" "},{"text":"device must compute the same survivor set from the same rows. A resolver","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that doesn’t reintroduces the mutual-tombstone loss the write path is"},{"type":"text","text":" "},{"type":"text","text":"designed to avoid: two devices pick different survivors, each tombstones the"},{"type":"text","text":" "},{"type":"text","text":"other’s, and after sync "},{"type":"emphasis","inlineContent":[{"type":"text","text":"both"}]},{"type":"text","text":" rows are gone."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It must also be idempotent — "},{"code":"collapse(collapse(rows))","type":"codeVoice"},{"type":"text","text":" must keep the same"},{"type":"text","text":" "},{"type":"text","text":"IDs as "},{"code":"collapse(rows)","type":"codeVoice"},{"type":"text","text":". This is checked with an "},{"code":"assert","type":"codeVoice"},{"type":"text","text":" in debug builds."}],"type":"paragraph"},{"anchor":"Collapse-removes-IDs-not-rows","level":2,"text":"Collapse removes IDs, not rows","type":"heading"},{"inlineContent":[{"text":"A resolver’s output is read as ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"the set of IDs that should exist and what","type":"text"},{"text":" ","type":"text"},{"text":"each should contain","type":"text"}]},{"text":". An ID the resolver drops is deleted, including every","type":"text"},{"text":" ","type":"text"},{"text":"row carrying it. Several rows that share a ","type":"text"},{"type":"strong","inlineContent":[{"text":"surviving","type":"text"}]},{"text":" ID are all updated","type":"text"},{"text":" ","type":"text"},{"text":"to the survivor’s value, and none of them is deleted.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"That asymmetry is deliberate, and it is the whole reason the singleton case","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is the one this hook really solves. Deleting an ID is safe because "},{"type":"codeVoice","code":"id"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"replicated: every device independently computes the same set of doomed IDs"},{"type":"text","text":" "},{"type":"text","text":"and issues the same deletions. Deleting one of several rows that share an ID"},{"type":"text","text":" "},{"type":"text","text":"is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"type":"text","text":" safe — nothing replicated distinguishes them, so two devices can"},{"type":"text","text":" "},{"type":"text","text":"pick different physical rows to keep, each tombstones the other’s, and both"},{"type":"text","text":" "},{"type":"text","text":"are lost."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Rows sharing an ID need no deletion anyway: writes already converge across"},{"type":"text","text":" "},{"type":"text","text":"every matching row and reads already collapse to one value per ID (see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","isActive":true},{"type":"text","text":"), so duplicates cost storage and nothing else."}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse","interfaceLanguage":"swift"},"kind":"symbol","metadata":{"roleHeading":"Enumeration","modules":[{"name":"SwiduxPersistence"}],"externalID":"s:17SwiduxPersistence14EntityCollapseO","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityCollapse"}],"navigatorTitle":[{"kind":"identifie