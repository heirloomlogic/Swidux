of"},{"type":"text","text":" "},{"type":"codeVoice","code":"choose"},{"type":"text","text":". Rows with unique IDs pass through untouched."}],"kind":"symbol","type":"topic","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"byID","kind":"identifier"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":">("},{"kind":"externalParam","text":"preferring"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> (["},{"kind":"typeIdentifier","text":"E"},{"text":"]) -> [","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"kind":"text","text":"]"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistableModel":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","url":"\/documentation\/swiduxpersistence\/persistablemodel","title":"PersistableModel","role":"symbol","abstract":[{"text":"The generated SwiftData ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" shadow for a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableEntity","type":"reference"},{"text":".","type":"text"}],"navigatorTitle":[{"text":"PersistableModel","kind":"identifier"}],"kind":"symbol","type":"topic","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistableModel","kind":"identifier"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","url":"\/documentation\/swiduxpersistence","title":"SwiduxPersistence","role":"collection","abstract":[],"kind":"symbol","type":"topic"}}}