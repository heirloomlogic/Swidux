{"abstract":[{"type":"text","text":"Ready-made collapse resolvers."}],"variants":[{"paths":["\/documentation\/swiduxpersistence\/entitycollapse"],"traits":[{"interfaceLanguage":"swift"}]}],"topicSections":[{"generated":true,"anchor":"Type-Methods","title":"Type Methods","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityCollapse"}]}],"kind":"declarations"},{"kind":"content","content":[{"level":2,"text":"Why the hook takes the whole collection","anchor":"Why-the-hook-takes-the-whole-collection","type":"heading"},{"inlineContent":[{"type":"text","text":"A per-ID resolver would only handle half the problem. Rows sharing an "},{"type":"codeVoice","code":"id"},{"type":"text","text":" "},{"type":"text","text":"are one failure mode; the other is a "},{"type":"strong","inlineContent":[{"text":"singleton","type":"text"}]},{"type":"text","text":" — an entity an app holds"},{"type":"text","text":" "},{"type":"text","text":"exactly one of, such as a settings record. Created independently on two"},{"type":"text","text":" "},{"type":"text","text":"fresh installs, two singletons have "},{"type":"emphasis","inlineContent":[{"text":"different","type":"text"}]},{"type":"text","text":" UUIDs, so nothing groups"},{"type":"text","text":" "},{"type":"text","text":"them and no ID-keyed resolver can ever see the conflict. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"([E]) -> [E]"},{"type":"text","text":" hook covers both, plus general garbage collection, with one"},{"type":"text","text":" "},{"type":"text","text":"API."}],"type":"paragraph"},{"level":2,"type":"heading","text":"The determinism requirement","anchor":"The-determinism-requirement"},{"inlineContent":[{"type":"text","text":"A resolver must be a pure function of "},{"type":"strong","inlineContent":[{"text":"replicated content","type":"text"}]},{"type":"text","text":" — never"},{"type":"text","text":" "},{"type":"codeVoice","code":"persistentModelID"},{"type":"text","text":", never a local timestamp, never array position. Every"},{"type":"text","text":" "},{"type":"text","text":"device must compute the same survivor set from the same rows. A resolver"},{"type":"text","text":" "},{"type":"text","text":"that doesn’t reintroduces the mutual-tombstone loss the write path is"},{"type":"text","text":" "},{"type":"text","text":"designed to avoid: two devices pick different survivors, each tombstones the"},{"type":"text","text":" "},{"type":"text","text":"other’s, and after sync "},{"type":"emphasis","inlineContent":[{"text":"both","type":"text"}]},{"type":"text","text":" rows are gone."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It must also be idempotent — "},{"type":"codeVoice","code":"collapse(collapse(rows))"},{"type":"text","text":" must keep the same"},{"type":"text","text":" "},{"type":"text","text":"IDs as "},{"type":"codeVoice","code":"collapse(rows)"},{"type":"text","text":". This is checked with an "},{"type":"codeVoice","code":"assert"},{"type":"text","text":" in debug builds."}],"type":"paragraph"},{"level":2,"text":"Collapse removes IDs, not rows","anchor":"Collapse-removes-IDs-not-rows","type":"heading"},{"inlineContent":[{"type":"text","text":"A resolver’s output is read as "},{"type":"emphasis","inlineContent":[{"text":"the set of IDs that should exist and what","type":"text"},{"text":" ","type":"text"},{"text":"each should contain","type":"text"}]},{"type":"text","text":". An ID the resolver drops is deleted, including every"},{"type":"text","text":" "},{"type":"text","text":"row carrying it. Several rows that share a "},{"type":"strong","inlineContent":[{"text":"surviving","type":"text"}]},{"type":"text","text":" ID are all updated"},{"type":"text","text":" "},{"type":"text","text":"to the survivor’s value, and none of them is deleted."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That asymmetry is deliberate, and it is the whole reason the singleton case"},{"type":"text","text":" "},{"type":"text","text":"is the one this hook really solves. Deleting an ID is safe because "},{"type":"codeVoice","code":"id"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"replicated: every device independently computes the same set of doomed IDs"},{"type":"text","text":" "},{"type":"text","text":"and issues the same deletions. Deleting one of several rows that share an ID"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" safe — nothing replicated distinguishes them, so two devices can"},{"type":"text","text":" "},{"type":"text","text":"pick different physical rows to keep, each tombstones the other’s, and both"},{"type":"text","text":" "},{"type":"text","text":"are lost."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Rows sharing an ID need no deletion anyway: writes already converge across"},{"type":"text","text":" "},{"type":"text","text":"every matching row and reads already collapse to one value per ID (see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","isActive":true},{"type":"text","text":"), so duplicates cost storage and nothing else."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"metadata":{"externalID":"s:17SwiduxPersistence14EntityCollapseO","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityCollapse","kind":"identifier"}],"roleHeading":"Enumeration","role":"symbol","title":"EntityCollapse","navigatorTitle":[{"kind":"identifier","text":"EntityCollapse"}],"modules":[{"name":"SwiduxPersistence"}],"symbolKind":"enum"},"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse","interfaceLanguage":"swift"},"kind":"symbol","sections":[],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse/byID(preferring:)":{"type":"topic","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"byID"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":">("},{"kind":"externalParam","text":"preferring"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> (["},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":"]) -> ["},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":"]"}],"url":"\/documentation\/swiduxpersistence\/entitycollapse\/byid(preferring:)","title":"byID(preferring:)","role":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)","kind":"symbol","abstract":[{"text":"Collapses rows sharing an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" down to one, keeping the winner of","type":"text"},{"text":" ","type":"text"},{"code":"choose","type":"codeVoice"},{"text":". Rows with unique IDs pass through untouched.","type":"text"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"type":"topic","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityDB"}],"url":"\/documentation\/swiduxpersistence\/entitydb","title":"EntityDB","role":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","navigatorTitle":[{"kind":"identifier","text":"EntityDB"}],"kind":"symbol","abstract":[{"type":"text","text":"A generic "},{"type":"codeVoice","code":"@ModelActor"},{"type":"text","text":" that reads and writes any "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","type":"reference","isActive":true},{"type":"text","text":"."}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse":{"abstract":[{"text":"Ready-made collapse resolvers.","type":"text"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityCollapse"}],"url":"\/documentation\/swiduxpersistence\/entitycollapse","title":"EntityCollapse","role":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse","navigatorTitle":[{"text":"EntityCollapse","kind":"identifier"}],"kind":"symbol","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistableModel":{"type":"topic","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistableModel"}],"url":"\/documentation\/swiduxpersistence\/persistablemodel","title":"PersistableModel","role":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","navigatorTitle":[{"kind":"identifier","text":"PersistableModel"}],"kind":"symbol","abstract":[{"text":"The generated SwiftData ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" shadow for a ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableEntity","isActive":true},{"text":".","type":"text"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"kind":"symbol","url":"\/documentation\/swiduxpersistence","abstract":[],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","role":"collection","title":"SwiduxPersistence","type":"topic"}}}