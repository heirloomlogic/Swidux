{"topicSections":[{"generated":true,"title":"Type Methods","anchor":"Type-Methods","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)"]}],"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse","interfaceLanguage":"swift"},"sections":[],"metadata":{"symbolKind":"enum","title":"EntityCollapse","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityCollapse","kind":"identifier"}],"externalID":"s:17SwiduxPersistence14EntityCollapseO","roleHeading":"Enumeration","role":"symbol","modules":[{"name":"SwiduxPersistence"}],"navigatorTitle":[{"text":"EntityCollapse","kind":"identifier"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityCollapse","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Why the hook takes the whole collection","type":"heading","anchor":"Why-the-hook-takes-the-whole-collection","level":2},{"inlineContent":[{"type":"text","text":"A per-ID resolver would only handle half the problem. Rows sharing an "},{"type":"codeVoice","code":"id"},{"type":"text","text":" "},{"type":"text","text":"are one failure mode; the other is a "},{"type":"strong","inlineContent":[{"text":"singleton","type":"text"}]},{"type":"text","text":" — an entity an app holds"},{"type":"text","text":" "},{"type":"text","text":"exactly one of, such as a settings record. Created independently on two"},{"type":"text","text":" "},{"type":"text","text":"fresh installs, two singletons have "},{"type":"emphasis","inlineContent":[{"text":"different","type":"text"}]},{"type":"text","text":" UUIDs, so nothing groups"},{"type":"text","text":" "},{"type":"text","text":"them and no ID-keyed resolver can ever see the conflict. A"},{"type":"text","text":" "},{"code":"([E]) -> [E]","type":"codeVoice"},{"type":"text","text":" hook covers both, plus general garbage collection, with one"},{"type":"text","text":" "},{"type":"text","text":"API."}],"type":"paragraph"},{"type":"heading","level":2,"text":"The determinism requirement","anchor":"The-determinism-requirement"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A resolver must be a pure function of "},{"type":"strong","inlineContent":[{"text":"replicated content","type":"text"}]},{"type":"text","text":" — never"},{"type":"text","text":" "},{"type":"codeVoice","code":"persistentModelID"},{"type":"text","text":", never a local timestamp, never array position. Every"},{"type":"text","text":" "},{"type":"text","text":"device must compute the same survivor set from the same rows. A resolver"},{"type":"text","text":" "},{"type":"text","text":"that doesn’t reintroduces the mutual-tombstone loss the write path is"},{"type":"text","text":" "},{"type":"text","text":"designed to avoid: two devices pick different survivors, each tombstones the"},{"type":"text","text":" "},{"type":"text","text":"other’s, and after sync "},{"type":"emphasis","inlineContent":[{"type":"text","text":"both"}]},{"type":"text","text":" rows are gone."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It must also be idempotent — "},{"code":"collapse(collapse(rows))","type":"codeVoice"},{"type":"text","text":" must keep the same"},{"type":"text","text":" "},{"type":"text","text":"IDs as "},{"code":"collapse(rows)","type":"codeVoice"},{"type":"text","text":". This is checked with an "},{"code":"assert","type":"codeVoice"},{"type":"text","text":" in debug builds."}]},{"text":"Collapse removes IDs, not rows","type":"heading","level":2,"anchor":"Collapse-removes-IDs-not-rows"},{"inlineContent":[{"text":"A resolver’s output is read as ","type":"text"},{"inlineContent":[{"text":"the set of IDs that should exist and what","type":"text"},{"text":" ","type":"text"},{"text":"each should contain","type":"text"}],"type":"emphasis"},{"text":". An ID the resolver drops is deleted, including every","type":"text"},{"text":" ","type":"text"},{"text":"row carrying it. Several rows that share a ","type":"text"},{"inlineContent":[{"type":"text","text":"surviving"}],"type":"strong"},{"text":" ID are all updated","type":"text"},{"text":" ","type":"text"},{"text":"to the survivor’s value, and none of them is deleted.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That asymmetry is deliberate, and it is the whole reason the singleton case"},{"type":"text","text":" "},{"type":"text","text":"is the one this hook really solves. Deleting an ID is safe because "},{"type":"codeVoice","code":"id"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"replicated: every device independently computes the same set of doomed IDs"},{"type":"text","text":" "},{"type":"text","text":"and issues the same deletions. Deleting one of several rows that share an ID"},{"type":"text","text":" "},{"type":"text","text":"is "},{"type":"emphasis","inlineContent":[{"text":"not","type":"text"}]},{"text":" safe — nothing replicated distinguishes them, so two devices can","type":"text"},{"text":" ","type":"text"},{"text":"pick different physical rows to keep, each tombstones the other’s, and both","type":"text"},{"text":" ","type":"text"},{"text":"are lost.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rows sharing an ID need no deletion anyway: writes already converge across"},{"type":"text","text":" "},{"type":"text","text":"every matching row and reads already collapse to one value per ID (see"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB"},{"type":"text","text":"), so duplicates cost storage and nothing else."}]}],"kind":"content"}],"kind":"symbol","abstract":[{"type":"text","text":"Ready-made collapse resolvers."}],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/entitycollapse"]}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse":{"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse","navigatorTitle":[{"kind":"identifier","text":"EntityCollapse"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityCollapse"}],"title":"EntityCollapse","type":"topic","abstract":[{"type":"text","text":"Ready-made collapse resolvers."}],"role":"symbol","url":"\/documentation\/swiduxpersistence\/entitycollapse"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistableModel":{"abstract":[{"text":"The generated SwiftData ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" shadow for a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableEntity"},{"text":".","type":"text"}],"type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","role":"symbol","url":"\/documentation\/swiduxpersistence\/persistablemodel","title":"PersistableModel","navigatorTitle":[{"text":"PersistableModel","kind":"identifier"}],"fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistableModel","kind":"identifier"}],"kind":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"title":"SwiduxPersistence","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","url":"\/documentation\/swiduxpersistence","kind":"symbol","type":"topic","role":"collection","abstract":[]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"navigatorTitle":[{"kind":"identifier","text":"EntityDB"}],"fragments":[{"kind":"keyword",