{"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Ready-made collapse resolvers."}],"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse","interfaceLanguage":"swift"},"metadata":{"externalID":"s:17SwiduxPersistence14EntityCollapseO","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityCollapse","kind":"identifier"}],"navigatorTitle":[{"text":"EntityCollapse","kind":"identifier"}],"role":"symbol","modules":[{"name":"SwiduxPersistence"}],"symbolKind":"enum","roleHeading":"Enumeration","title":"EntityCollapse"},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityCollapse"}]}]},{"content":[{"anchor":"Why-the-hook-takes-the-whole-collection","text":"Why the hook takes the whole collection","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A per-ID resolver would only handle half the problem. Rows sharing an "},{"code":"id","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are one failure mode; the other is a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"singleton"}]},{"type":"text","text":" — an entity an app holds"},{"type":"text","text":" "},{"type":"text","text":"exactly one of, such as a settings record. Created independently on two"},{"type":"text","text":" "},{"type":"text","text":"fresh installs, two singletons have "},{"inlineContent":[{"type":"text","text":"different"}],"type":"emphasis"},{"type":"text","text":" UUIDs, so nothing groups"},{"type":"text","text":" "},{"type":"text","text":"them and no ID-keyed resolver can ever see the conflict. A"},{"type":"text","text":" "},{"type":"codeVoice","code":"([E]) -> [E]"},{"type":"text","text":" hook covers both, plus general garbage collection, with one"},{"type":"text","text":" "},{"type":"text","text":"API."}],"type":"paragraph"},{"text":"The determinism requirement","anchor":"The-determinism-requirement","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"A resolver must be a pure function of "},{"type":"strong","inlineContent":[{"text":"replicated content","type":"text"}]},{"type":"text","text":" — never"},{"type":"text","text":" "},{"type":"codeVoice","code":"persistentModelID"},{"type":"text","text":", never a local timestamp, never array position. Every"},{"type":"text","text":" "},{"type":"text","text":"device must compute the same survivor set from the same rows. A resolver"},{"type":"text","text":" "},{"type":"text","text":"that doesn’t reintroduces the mutual-tombstone loss the write path is"},{"type":"text","text":" "},{"type":"text","text":"designed to avoid: two devices pick different survivors, each tombstones the"},{"type":"text","text":" "},{"type":"text","text":"other’s, and after sync "},{"type":"emphasis","inlineContent":[{"text":"both","type":"text"}]},{"text":" rows are gone.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It must also be idempotent — "},{"type":"codeVoice","code":"collapse(collapse(rows))"},{"type":"text","text":" must keep the same"},{"type":"text","text":" "},{"type":"text","text":"IDs as "},{"code":"collapse(rows)","type":"codeVoice"},{"text":". This is checked with an ","type":"text"},{"code":"assert","type":"codeVoice"},{"type":"text","text":" in debug builds."}]},{"text":"Collapse removes IDs, not rows","type":"heading","level":2,"anchor":"Collapse-removes-IDs-not-rows"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A resolver’s output is read as "},{"inlineContent":[{"text":"the set of IDs that should exist and what","type":"text"},{"text":" ","type":"text"},{"text":"each should contain","type":"text"}],"type":"emphasis"},{"text":". An ID the resolver drops is deleted, including every","type":"text"},{"text":" ","type":"text"},{"text":"row carrying it. Several rows that share a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"surviving"}]},{"text":" ID are all updated","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to the survivor’s value, and none of them is deleted."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That asymmetry is deliberate, and it is the whole reason the singleton case"},{"type":"text","text":" "},{"type":"text","text":"is the one this hook really solves. Deleting an ID is safe because "},{"type":"codeVoice","code":"id"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"replicated: every device independently computes the same set of doomed IDs"},{"type":"text","text":" "},{"type":"text","text":"and issues the same deletions. Deleting one of several rows that share an ID"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" safe — nothing replicated distinguishes them, so two devices can","type":"text"},{"type":"text","text":" "},{"type":"text","text":"pick different physical rows to keep, each tombstones the other’s, and both"},{"type":"text","text":" "},{"type":"text","text":"are lost."}]},{"inlineContent":[{"text":"Rows sharing an ID need no deletion anyway: writes already converge across","type":"text"},{"type":"text","text":" "},{"type":"text","text":"every matching row and reads already collapse to one value per ID (see"},{"type":"text","text":" "},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","isActive":true,"type":"reference"},{"type":"text","text":"), so duplicates cost storage and nothing else."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/entitycollapse"]}],"topicSections":[{"identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)"],"title":"Type Methods","generated":true,"anchor":"Type-Methods"}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse/byID(preferring:)":{"abstract":[{"text":"Collapses rows sharing an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" down to one, keeping the winner of","type":"text"},{"text":" ","type":"text"},{"code":"choose","type":"codeVoice"},{"text":". Rows with unique IDs pass through untouched.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"byID","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"preferring","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":") -> ([","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":"]) -> [","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"type":"topic","role":"symbol","title":"byID(preferring:)","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)","kind":"symbol","url":"\/documentation\/swiduxpersistence\/entitycollapse\/byid(preferring:)"},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"abstract":[],"type":"topic","role":"collection","title":"SwiduxPersistence","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","kind":"symbol","url":"\/documentation\/swiduxpersistence"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse":{"url":"\/documentation\/swiduxpersistence\/entitycollapse","abstract":[{"type":"text","text":"Ready-made collapse resolvers."}],"type":"topic","title":"EntityCollapse","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityCollapse"}],"navigatorTitle":[{"kind":"identifier","text":"EntityCollapse"}],"kind":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"abstract":[{"text":"A generic ","type":"text"},{"type":"codeVoice","code":"@ModelActor"},{"text":" that reads and writes any ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","isActive":true,"type":"reference"},{"text":".","type":"text"}],"fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityDB","kind":"identifier"}],"navigatorTitle":[{"text":"EntityDB","kind":"identifier"}],"type":"topic","role":"symbol","title":"EntityDB","kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","url":"\/documentation\/swiduxpersistence\/entitydb"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistableModel":{"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistableModel"}],"abstract":[{"text":"The generated SwiftData ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":" shadow for a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableEntity","type":"reference"},{"text":".","type":"text"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","type":"topic","url":"\/documentation\/swiduxpersistence\/persistablemodel","role":"symbol","kind":"symbol","title":"PersistableModel","navigatorTitle":[{"kind":"identifier","text":"PersistableModel"}]}}}