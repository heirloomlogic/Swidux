{"abstract":[{"type":"text","text":"Ready-made collapse resolvers."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/entitycollapse"]}],"identifier":{"url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Enumeration","role":"symbol","title":"EntityCollapse","navigatorTitle":[{"kind":"identifier","text":"EntityCollapse"}],"symbolKind":"enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"EntityCollapse"}],"externalID":"s:17SwiduxPersistence14EntityCollapseO","modules":[{"name":"SwiduxPersistence"}]},"kind":"symbol","topicSections":[{"title":"Type Methods","generated":true,"anchor":"Type-Methods","identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityCollapse"}]}]},{"content":[{"type":"heading","text":"Why the hook takes the whole collection","anchor":"Why-the-hook-takes-the-whole-collection","level":2},{"type":"paragraph","inlineContent":[{"text":"A per-ID resolver would only handle half the problem. Rows sharing an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are one failure mode; the other is a ","type":"text"},{"inlineContent":[{"type":"text","text":"singleton"}],"type":"strong"},{"text":" — an entity an app holds","type":"text"},{"text":" ","type":"text"},{"text":"exactly one of, such as a settings record. Created independently on two","type":"text"},{"text":" ","type":"text"},{"text":"fresh installs, two singletons have ","type":"text"},{"inlineContent":[{"type":"text","text":"different"}],"type":"emphasis"},{"text":" UUIDs, so nothing groups","type":"text"},{"text":" ","type":"text"},{"text":"them and no ID-keyed resolver can ever see the conflict. A","type":"text"},{"text":" ","type":"text"},{"code":"([E]) -> [E]","type":"codeVoice"},{"text":" hook covers both, plus general garbage collection, with one","type":"text"},{"text":" ","type":"text"},{"text":"API.","type":"text"}]},{"type":"heading","text":"The determinism requirement","anchor":"The-determinism-requirement","level":2},{"type":"paragraph","inlineContent":[{"text":"A resolver must be a pure function of ","type":"text"},{"inlineContent":[{"type":"text","text":"replicated content"}],"type":"strong"},{"text":" — never","type":"text"},{"text":" ","type":"text"},{"code":"persistentModelID","type":"codeVoice"},{"text":", never a local timestamp, never array position. Every","type":"text"},{"text":" ","type":"text"},{"text":"device must compute the same survivor set from the same rows. A resolver","type":"text"},{"text":" ","type":"text"},{"text":"that doesn’t reintroduces the mutual-tombstone loss the write path is","type":"text"},{"text":" ","type":"text"},{"text":"designed to avoid: two devices pick different survivors, each tombstones the","type":"text"},{"text":" ","type":"text"},{"text":"other’s, and after sync ","type":"text"},{"inlineContent":[{"type":"text","text":"both"}],"type":"emphasis"},{"text":" rows are gone.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It must also be idempotent — ","type":"text"},{"code":"collapse(collapse(rows))","type":"codeVoice"},{"text":" must keep the same","type":"text"},{"text":" ","type":"text"},{"text":"IDs as ","type":"text"},{"code":"collapse(rows)","type":"codeVoice"},{"text":". This is checked with an ","type":"text"},{"code":"assert","type":"codeVoice"},{"text":" in debug builds.","type":"text"}]},{"type":"heading","text":"Collapse removes IDs, not rows","anchor":"Collapse-removes-IDs-not-rows","level":2},{"type":"paragraph","inlineContent":[{"text":"A resolver’s output is read as ","type":"text"},{"inlineContent":[{"type":"text","text":"the set of IDs that should exist and what"},{"type":"text","text":" "},{"type":"text","text":"each should contain"}],"type":"emphasis"},{"text":". An ID the resolver drops is deleted, including every","type":"text"},{"text":" ","type":"text"},{"text":"row carrying it. Several rows that share a ","type":"text"},{"inlineContent":[{"type":"text","text":"surviving"}],"type":"strong"},{"text":" ID are all updated","type":"text"},{"text":" ","type":"text"},{"text":"to the survivor’s value, and none of them is deleted.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"That asymmetry is deliberate, and it is the whole reason the singleton case","type":"text"},{"text":" ","type":"text"},{"text":"is the one this hook really solves. Deleting an ID is safe because ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"replicated: every device independently computes the same set of doomed IDs","type":"text"},{"text":" ","type":"text"},{"text":"and issues the same deletions. Deleting one of several rows that share an ID","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" safe — nothing replicated distinguishes them, so two devices can","type":"text"},{"text":" ","type":"text"},{"text":"pick different physical rows to keep, each tombstones the other’s, and both","type":"text"},{"text":" ","type":"text"},{"text":"are lost.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Rows sharing an ID need no deletion anyway: writes already converge across","type":"text"},{"text":" ","type":"text"},{"text":"every matching row and reads already collapse to one value per ID (see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","isActive":true,"type":"reference"},{"text":"), so duplicates cost storage and nothing else.","type":"text"}]}],"kind":"content"}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"abstract":[{"text":"A generic ","type":"text"},{"type":"codeVoice","code":"@ModelActor"},{"type":"text","text":" that reads and writes any "},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","type":"reference"},{"type":"text","text":"."}],"title":"EntityDB","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","url":"\/documentation\/swiduxpersistence\/entitydb","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityDB"}],"navigatorTitle":[{"kind":"identifier","text":"EntityDB"}],"type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistableModel":{"url":"\/documentation\/swiduxpersistence\/persistablemodel","abstract":[{"type":"text","text":"The generated SwiftData "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" shadow for a "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableEntity","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","title":"PersistableModel","kind":"symbol","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"text":"PersistableModel","kind":"identifier"}],"navigatorTitle":[{"text":"PersistableModel","kind":"identifier"}],"type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"type":"topic","title":"SwiduxPersistence","abstract":[],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","url":"\/documentation\/swiduxpersistence","role":"collection"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse":{"type":"topic","title":"EntityCollapse","abstract":[{"type":"text","text":"Ready-made collapse resolvers."}],"navigatorTitle":[{"text":"EntityCollapse","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityCollapse","kind":"identifier"}],"url":"\/documentation\/swiduxpersistence\/entitycollapse","role":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse/byID(preferring:)":{"fragments":[{"kind":"keyword","text":"static"},{"text":" ","kind":"text"},{"kind":"keyword","text":"func"},{"text":" ","kind":"text"},{"kind":"identifier","text":"byID"},{"text":"<","kind":"text"},{"kind":"genericParameter","text":"E"},{"text":">(","kind":"text"},{"kind":"externalParam","text":"preferring"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> (["},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":"]) -> ["},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":"]"}],"kind":"symbol","url":"\/documentation\/swiduxpersistence\/entitycollapse\/byid(preferring:)","abstract":[{"text":"Collapses rows sharing an ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" down to one, keeping the winner of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"choose"},{"text":". Rows with unique IDs pass through untouched.","type":"text"}],"title":"byID(preferring:)","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)","type":"topic","role":"symbol"}}}