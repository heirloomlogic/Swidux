{"type":"text","text":" that reads and writes any "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","isActive":true},{"type":"text","text":"."}],"url":"\/documentation\/swiduxpersistence\/entitydb","kind":"symbol","role":"symbol","type":"topic","navigatorTitle":[{"text":"EntityDB","kind":"identifier"}],"title":"EntityDB","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"text":"EntityDB","kind":"identifier"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse/byID(preferring:)":{"kind":"symbol","url":"\/documentation\/swiduxpersistence\/entitycollapse\/byid(preferring:)","abstract":[{"type":"text","text":"Collapses rows sharing an "},{"type":"codeVoice","code":"id"},{"type":"text","text":" down to one, keeping the winner of"},{"type":"text","text":" "},{"type":"codeVoice","code":"choose"},{"type":"text","text":". Rows with unique IDs pass through untouched."}],"type":"topic","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"byID","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"preferring","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":") -> ([","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":"]) -> [","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"role":"symbol","title":"byID(preferring:)"}}}