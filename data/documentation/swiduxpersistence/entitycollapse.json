{"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/entitycollapse"]}],"kind":"symbol","abstract":[{"text":"Ready-made collapse resolvers.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)"],"title":"Type Methods","generated":true,"anchor":"Type-Methods"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityCollapse"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"text":"Why the hook takes the whole collection","anchor":"Why-the-hook-takes-the-whole-collection","type":"heading"},{"inlineContent":[{"text":"A per-ID resolver would only handle half the problem. Rows sharing an ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" ","type":"text"},{"text":"are one failure mode; the other is a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"singleton"}]},{"text":" — an entity an app holds","type":"text"},{"type":"text","text":" "},{"text":"exactly one of, such as a settings record. Created independently on two","type":"text"},{"type":"text","text":" "},{"text":"fresh installs, two singletons have ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"different"}]},{"text":" UUIDs, so nothing groups","type":"text"},{"text":" ","type":"text"},{"text":"them and no ID-keyed resolver can ever see the conflict. A","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"([E]) -> [E]"},{"type":"text","text":" hook covers both, plus general garbage collection, with one"},{"text":" ","type":"text"},{"type":"text","text":"API."}],"type":"paragraph"},{"type":"heading","text":"The determinism requirement","anchor":"The-determinism-requirement","level":2},{"inlineContent":[{"type":"text","text":"A resolver must be a pure function of "},{"inlineContent":[{"type":"text","text":"replicated content"}],"type":"strong"},{"type":"text","text":" — never"},{"type":"text","text":" "},{"type":"codeVoice","code":"persistentModelID"},{"type":"text","text":", never a local timestamp, never array position. Every"},{"type":"text","text":" "},{"type":"text","text":"device must compute the same survivor set from the same rows. A resolver"},{"type":"text","text":" "},{"type":"text","text":"that doesn’t reintroduces the mutual-tombstone loss the write path is"},{"type":"text","text":" "},{"type":"text","text":"designed to avoid: two devices pick different survivors, each tombstones the"},{"type":"text","text":" "},{"type":"text","text":"other’s, and after sync "},{"type":"emphasis","inlineContent":[{"type":"text","text":"both"}]},{"text":" rows are gone.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It must also be idempotent — "},{"code":"collapse(collapse(rows))","type":"codeVoice"},{"type":"text","text":" must keep the same"},{"text":" ","type":"text"},{"type":"text","text":"IDs as "},{"code":"collapse(rows)","type":"codeVoice"},{"type":"text","text":". This is checked with an "},{"code":"assert","type":"codeVoice"},{"type":"text","text":" in debug builds."}]},{"level":2,"anchor":"Collapse-removes-IDs-not-rows","type":"heading","text":"Collapse removes IDs, not rows"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A resolver’s output is read as "},{"inlineContent":[{"type":"text","text":"the set of IDs that should exist and what"},{"type":"text","text":" "},{"type":"text","text":"each should contain"}],"type":"emphasis"},{"text":". An ID the resolver drops is deleted, including every","type":"text"},{"type":"text","text":" "},{"type":"text","text":"row carrying it. Several rows that share a "},{"inlineContent":[{"type":"text","text":"surviving"}],"type":"strong"},{"type":"text","text":" ID are all updated"},{"type":"text","text":" "},{"type":"text","text":"to the survivor’s value, and none of them is deleted."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That asymmetry is deliberate, and it is the whole reason the singleton case"},{"text":" ","type":"text"},{"text":"is the one this hook really solves. Deleting an ID is safe because ","type":"text"},{"type":"codeVoice","code":"id"},{"type":"text","text":" is"},{"type":"text","text":" "},{"text":"replicated: every device independently computes the same set of doomed IDs","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and issues the same deletions. Deleting one of several rows that share an ID"},{"type":"text","text":" "},{"type":"text","text":"is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"type":"text","text":" safe — nothing replicated distinguishes them, so two devices can"},{"type":"text","text":" "},{"type":"text","text":"pick different physical rows to keep, each tombstones the other’s, and both"},{"type":"text","text":" "},{"type":"text","text":"are lost."}]},{"type":"paragraph","inlineContent":[{"text":"Rows sharing an ID need no deletion anyway: writes already converge across","type":"text"},{"text":" ","type":"text"},{"text":"every matching row and reads already collapse to one value per ID (see","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","type":"reference"},{"text":"), so duplicates cost storage and nothing else.","type":"text"}]}]}],"metadata":{"navigatorTitle":[{"text":"EntityCollapse","kind":"identifier"}],"roleHeading":"Enumeration","role":"symbol","title":"EntityCollapse","symbolKind":"enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityCollapse","kind":"identifier"}],"modules":[{"name":"SwiduxPersistence"}],"externalID":"s:17SwiduxPersistence14EntityCollapseO"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse"},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","url":"\/documentation\/swiduxpersistence\/entitydb","abstract":[{"type":"text","text":"A generic "},{"type":"codeVoice","code":"@ModelActor"},{"type":"text","text":" that reads and writes any "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","isActive":true},{"text":".","type":"text"}],"navigatorTitle":[{"text":"EntityDB","kind":"identifier"}],"type":"topic","kind":"symbol","fragments":[{"text":"actor","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityDB","kind":"identifier"}],"role":"symbol","title":"EntityDB"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistableModel":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","url":"\/documentation\/swiduxpersistence\/persistablemodel","abstract":[{"text":"The generated SwiftData ","type":"text"},{"type":"codeVoice","code":"@Model"},{"text":" shadow for a ","type":"text"},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableEntity","isActive":true},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"PersistableModel"}],"type":"topic","kind":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"text":" ","kind":"text"},{"kind":"identifier","text":"PersistableModel"}],"role":"symbol","title":"PersistableModel"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse":{"navigatorTitle":[{"kind":"identifier","text":"EntityCollapse"}],"type":"topic","kind":"symbol","abstract":[{"text":"Ready-made collapse resolvers.","type":"text"}],"title":"EntityCollapse","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityCollapse"}],"url":"\/documentation\/swiduxpersistence\/entitycollapse","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse/byID(preferring:)":{"type":"topic","kind":"symbol","abstract":[{"text":"Collapses rows sharing an ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" down to one, keeping the winner of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"choose"},{"text":". Rows with unique IDs pass through untouched.","type":"text"}],"title":"byID(preferring:)","role":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"byID"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":">("},{"kind":"externalParam","text":"preferring"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> (["},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":"]) -> ["},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":"]"}],"url":"\/documentation\/swiduxpersistence\/entitycollapse\/byid(preferring:)","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)"},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","url":"\/documentation\/swiduxpersistence","title":"SwiduxPersistence","type":"topic","kind":"symbol","role":"collection","abstract":[]}}}