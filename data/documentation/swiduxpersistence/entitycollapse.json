{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse"},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityCollapse","kind":"identifier"}]}]},{"kind":"content","content":[{"level":2,"anchor":"Why-the-hook-takes-the-whole-collection","text":"Why the hook takes the whole collection","type":"heading"},{"inlineContent":[{"text":"A per-ID resolver would only handle half the problem. Rows sharing an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are one failure mode; the other is a ","type":"text"},{"inlineContent":[{"type":"text","text":"singleton"}],"type":"strong"},{"text":" — an entity an app holds","type":"text"},{"text":" ","type":"text"},{"text":"exactly one of, such as a settings record. Created independently on two","type":"text"},{"text":" ","type":"text"},{"text":"fresh installs, two singletons have ","type":"text"},{"inlineContent":[{"type":"text","text":"different"}],"type":"emphasis"},{"text":" UUIDs, so nothing groups","type":"text"},{"text":" ","type":"text"},{"text":"them and no ID-keyed resolver can ever see the conflict. A","type":"text"},{"text":" ","type":"text"},{"code":"([E]) -> [E]","type":"codeVoice"},{"text":" hook covers both, plus general garbage collection, with one","type":"text"},{"text":" ","type":"text"},{"text":"API.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"The-determinism-requirement","text":"The determinism requirement","type":"heading"},{"inlineContent":[{"text":"A resolver must be a pure function of ","type":"text"},{"inlineContent":[{"type":"text","text":"replicated content"}],"type":"strong"},{"text":" — never","type":"text"},{"text":" ","type":"text"},{"code":"persistentModelID","type":"codeVoice"},{"type":"text","text":", never a local timestamp, never array position. Every"},{"type":"text","text":" "},{"type":"text","text":"device must compute the same survivor set from the same rows. A resolver"},{"type":"text","text":" "},{"type":"text","text":"that doesn’t reintroduces the mutual-tombstone loss the write path is"},{"type":"text","text":" "},{"type":"text","text":"designed to avoid: two devices pick different survivors, each tombstones the"},{"type":"text","text":" "},{"type":"text","text":"other’s, and after sync "},{"type":"emphasis","inlineContent":[{"type":"text","text":"both"}]},{"type":"text","text":" rows are gone."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It must also be idempotent — "},{"type":"codeVoice","code":"collapse(collapse(rows))"},{"type":"text","text":" must keep the same"},{"type":"text","text":" "},{"type":"text","text":"IDs as "},{"type":"codeVoice","code":"collapse(rows)"},{"type":"text","text":". This is checked with an "},{"type":"codeVoice","code":"assert"},{"type":"text","text":" in debug builds."}],"type":"paragraph"},{"type":"heading","text":"Collapse removes IDs, not rows","anchor":"Collapse-removes-IDs-not-rows","level":2},{"type":"paragraph","inlineContent":[{"text":"A resolver’s output is read as ","type":"text"},{"inlineContent":[{"type":"text","text":"the set of IDs that should exist and what"},{"type":"text","text":" "},{"type":"text","text":"each should contain"}],"type":"emphasis"},{"text":". An ID the resolver drops is deleted, including every","type":"text"},{"text":" ","type":"text"},{"text":"row carrying it. Several rows that share a ","type":"text"},{"inlineContent":[{"type":"text","text":"surviving"}],"type":"strong"},{"text":" ID are all updated","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"to the survivor’s value, and none of them is deleted."}]},{"type":"paragraph","inlineContent":[{"text":"That asymmetry is deliberate, and it is the whole reason the singleton case","type":"text"},{"text":" ","type":"text"},{"text":"is the one this hook really solves. Deleting an ID is safe because ","type":"text"},{"code":"id","type":"codeVoice"},{"type":"text","text":" is"},{"text":" ","type":"text"},{"type":"text","text":"replicated: every device independently computes the same set of doomed IDs"},{"type":"text","text":" "},{"type":"text","text":"and issues the same deletions. Deleting one of several rows that share an ID"},{"type":"text","text":" "},{"type":"text","text":"is "},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" safe — nothing replicated distinguishes them, so two devices can","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"pick different physical rows to keep, each tombstones the other’s, and both"},{"text":" ","type":"text"},{"type":"text","text":"are lost."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Rows sharing an ID need no deletion anyway: writes already converge across"},{"text":" ","type":"text"},{"type":"text","text":"every matching row and reads already collapse to one value per ID (see"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","type":"reference","isActive":true},{"text":"), so duplicates cost storage and nothing else.","type":"text"}]}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"metadata":{"modules":[{"name":"SwiduxPersistence"}],"title":"EntityCollapse","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EntityCollapse"}],"externalID":"s:17SwiduxPersistence14EntityCollapseO","roleHeading":"Enumeration","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityCollapse","kind":"identifier"}],"symbolKind":"enum"},"abstract":[{"text":"Ready-made collapse resolvers.","type":"text"}],"topicSections":[{"anchor":"Type-Methods","generated":true,"title":"Type Methods","identifiers":["doc:\/\/SwiduxPersistence\/documentati