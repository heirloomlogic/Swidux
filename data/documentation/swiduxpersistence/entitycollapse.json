{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse"},"kind":"symbol","primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityCollapse"}],"languages":["swift"]}],"kind":"declarations"},{"content":[{"text":"Why the hook takes the whole collection","anchor":"Why-the-hook-takes-the-whole-collection","type":"heading","level":2},{"inlineContent":[{"text":"A per-ID resolver would only handle half the problem. Rows sharing an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" ","type":"text"},{"text":"are one failure mode; the other is a ","type":"text"},{"inlineContent":[{"type":"text","text":"singleton"}],"type":"strong"},{"text":" — an entity an app holds","type":"text"},{"text":" ","type":"text"},{"text":"exactly one of, such as a settings record. Created independently on two","type":"text"},{"text":" ","type":"text"},{"text":"fresh installs, two singletons have ","type":"text"},{"inlineContent":[{"type":"text","text":"different"}],"type":"emphasis"},{"text":" UUIDs, so nothing groups","type":"text"},{"text":" ","type":"text"},{"text":"them and no ID-keyed resolver can ever see the conflict. A","type":"text"},{"text":" ","type":"text"},{"code":"([E]) -> [E]","type":"codeVoice"},{"text":" hook covers both, plus general garbage collection, with one","type":"text"},{"text":" ","type":"text"},{"text":"API.","type":"text"}],"type":"paragraph"},{"text":"The determinism requirement","anchor":"The-determinism-requirement","type":"heading","level":2},{"inlineContent":[{"text":"A resolver must be a pure function of ","type":"text"},{"inlineContent":[{"type":"text","text":"replicated content"}],"type":"strong"},{"text":" — never","type":"text"},{"text":" ","type":"text"},{"code":"persistentModelID","type":"codeVoice"},{"text":", never a local timestamp, never array position. Every","type":"text"},{"text":" ","type":"text"},{"text":"device must compute the same survivor set from the same rows. A resolver","type":"text"},{"text":" ","type":"text"},{"text":"that doesn’t reintroduces the mutual-tombstone loss the write path is","type":"text"},{"text":" ","type":"text"},{"text":"designed to avoid: two devices pick different survivors, each tombstones the","type":"text"},{"text":" ","type":"text"},{"text":"other’s, and after sync ","type":"text"},{"inlineContent":[{"type":"text","text":"both"}],"type":"emphasis"},{"text":" rows are gone.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It must also be idempotent — ","type":"text"},{"code":"collapse(collapse(rows))","type":"codeVoice"},{"text":" must keep the same","type":"text"},{"text":" ","type":"text"},{"text":"IDs as ","type":"text"},{"code":"collapse(rows)","type":"codeVoice"},{"text":". This is checked with an ","type":"text"},{"code":"assert","type":"codeVoice"},{"text":" in debug builds.","type":"text"}],"type":"paragraph"},{"text":"Collapse removes IDs, not rows","anchor":"Collapse-removes-IDs-not-rows","type":"heading","level":2},{"inlineContent":[{"text":"A resolver’s output is read as ","type":"text"},{"inlineContent":[{"type":"text","text":"the set of IDs that should exist and what"},{"type":"text","text":" "},{"type":"text","text":"each should contain"}],"type":"emphasis"},{"text":". An ID the resolver drops is deleted, including every","type":"text"},{"text":" ","type":"text"},{"text":"row carrying it. Several rows that share a ","type":"text"},{"inlineContent":[{"type":"text","text":"surviving"}],"type":"strong"},{"text":" ID are all updated","type":"text"},{"text":" ","type":"text"},{"text":"to the survivor’s value, and none of them is deleted.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"That asymmetry is deliberate, and it is the whole reason the singleton case","type":"text"},{"text":" ","type":"text"},{"text":"is the one this hook really solves. Deleting an ID is safe because ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"replicated: every device independently computes the same set of doomed IDs","type":"text"},{"text":" ","type":"text"},{"text":"and issues the same deletions. Deleting one of several rows that share an ID","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" safe — nothing replicated distinguishes them, so two devices can","type":"text"},{"text":" ","type":"text"},{"text":"pick different physical rows to keep, each tombstones the other’s, and both","type":"text"},{"text":" ","type":"text"},{"text":"are lost.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Rows sharing an ID need no deletion anyway: writes already converge across","type":"text"},{"text":" ","type":"text"},{"text":"every matching row and reads already collapse to one value per ID (see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","type":"reference","isActive":true},{"text":"), so duplicates cost storage and nothing else.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/swiduxpersistence\/entitycollapse"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Ready-made collapse resolvers.","type":"text"}],"metadata":{"roleHeading":"Enumeration","symbolKind":"enum","externalID":"s:17SwiduxPersistence14EntityCollapseO","role":"symbol","navigatorTitle":[{"text":"EntityCollapse","kind":"identifier"}],"modules":[{"name":"SwiduxPersistence"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityCollapse"}],"title":"EntityCollapse"},"topicSections":[{"generated":true,"identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)"],"title":"Type Methods","anchor":"Type-Methods"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse/byID(preferring:)":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)","kind":"symbol","type":"topic","abstract":[{"text":"Collapses rows sharing an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" down to one, keeping the winner of","type":"text"},{"text":" ","type":"text"},{"code":"choose","type":"codeVoice"},{"text":". Rows with unique IDs pass through untouched.","type":"text"}],"role":"symbol","url":"\/documentation\/swiduxpersistence\/entitycollapse\/byid(preferring:)","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"byID","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"preferring","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":") -> ([","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":"]) -> [","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"title":"byID(preferring:)"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistableModel":{"type":"topic","title":"PersistableModel","abstract":[{"type":"text","text":"The generated SwiftData "},{"type":"codeVoice","code":"@Model"},{"type":"text","text":" shadow for a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableEntity"},{"type":"text","text":"."}],"role":"symbol","kind":"symbol","url":"\/documentation\/swiduxpersistence\/persistablemodel","navigatorTitle":[{"text":"PersistableModel","kind":"identifier"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"PersistableModel","kind":"identifier"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"abstract":[],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","title":"SwiduxPersistence","url":"\/documentation\/swiduxpersistence","kind":"symbol","role":"collection","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"EntityCollapse"}],"abstract":[{"text":"Ready-made collapse resolvers.","type":"text"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse","role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityCollapse"}],"title":"EntityCollapse","url":"\/documentation\/swiduxpersistence\/entitycollapse","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityDB"}],"kind":"symbol","title":"EntityDB","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"EntityDB"}],"type":"topic","abstract":[{"type":"text","text":"A generic "},{"type":"codeVoice","code":"@ModelActor"},{"text":" that reads and writes any ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel"},{"text":".","type":"text"}],"url":"\/documentation\/swiduxpersistence\/entitydb"}}}