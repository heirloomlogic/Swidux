{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/entitycollapse"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityCollapse"}]}]},{"kind":"content","content":[{"text":"Why the hook takes the whole collection","level":2,"anchor":"Why-the-hook-takes-the-whole-collection","type":"heading"},{"inlineContent":[{"type":"text","text":"A per-ID resolver would only handle half the problem. Rows sharing an "},{"type":"codeVoice","code":"id"},{"type":"text","text":" "},{"type":"text","text":"are one failure mode; the other is a "},{"type":"strong","inlineContent":[{"type":"text","text":"singleton"}]},{"type":"text","text":" — an entity an app holds"},{"type":"text","text":" "},{"type":"text","text":"exactly one of, such as a settings record. Created independently on two"},{"type":"text","text":" "},{"type":"text","text":"fresh installs, two singletons have "},{"type":"emphasis","inlineContent":[{"type":"text","text":"different"}]},{"type":"text","text":" UUIDs, so nothing groups"},{"type":"text","text":" "},{"text":"them and no ID-keyed resolver can ever see the conflict. A","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"([E]) -> [E]"},{"text":" hook covers both, plus general garbage collection, with one","type":"text"},{"text":" ","type":"text"},{"text":"API.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"The-determinism-requirement","text":"The determinism requirement"},{"inlineContent":[{"text":"A resolver must be a pure function of ","type":"text"},{"inlineContent":[{"text":"replicated content","type":"text"}],"type":"strong"},{"text":" — never","type":"text"},{"text":" ","type":"text"},{"code":"persistentModelID","type":"codeVoice"},{"text":", never a local timestamp, never array position. Every","type":"text"},{"text":" ","type":"text"},{"text":"device must compute the same survivor set from the same rows. A resolver","type":"text"},{"text":" ","type":"text"},{"text":"that doesn’t reintroduces the mutual-tombstone loss the write path is","type":"text"},{"text":" ","type":"text"},{"text":"designed to avoid: two devices pick different survivors, each tombstones the","type":"text"},{"text":" ","type":"text"},{"text":"other’s, and after sync ","type":"text"},{"inlineContent":[{"text":"both","type":"text"}],"type":"emphasis"},{"text":" rows are gone.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It must also be idempotent — "},{"type":"codeVoice","code":"collapse(collapse(rows))"},{"type":"text","text":" must keep the same"},{"type":"text","text":" "},{"type":"text","text":"IDs as "},{"type":"codeVoice","code":"collapse(rows)"},{"type":"text","text":". This is checked with an "},{"type":"codeVoice","code":"assert"},{"type":"text","text":" in debug builds."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Collapse-removes-IDs-not-rows","text":"Collapse removes IDs, not rows"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A resolver’s output is read as "},{"type":"emphasis","inlineContent":[{"type":"text","text":"the set of IDs that should exist and what"},{"type":"text","text":" "},{"type":"text","text":"each should contain"}]},{"text":". An ID the resolver drops is deleted, including every","type":"text"},{"type":"text","text":" "},{"type":"text","text":"row carrying it. Several rows that share a "},{"type":"strong","inlineContent":[{"type":"text","text":"surviving"}]},{"type":"text","text":" ID are all updated"},{"type":"text","text":" "},{"type":"text","text":"to the survivor’s value, and none of them is deleted."}]},{"type":"paragraph","inlineContent":[{"text":"That asymmetry is deliberate, and it is the whole reason the singleton case","type":"text"},{"text":" ","type":"text"},{"text":"is the one this hook really solves. Deleting an ID is safe because ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" is","type":"text"},{"type":"text","text":" "},{"text":"replicated: every device independently computes the same set of doomed IDs","type":"text"},{"text":" ","type":"text"},{"text":"and issues the same deletions. Deleting one of several rows that share an ID","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"not"}]},{"text":" safe — nothing replicated distinguishes them, so two devices can","type":"text"},{"type":"text","text":" "},{"type":"text","text":"pick different physical rows to keep, each tombstones the other’s, and both"},{"type":"text","text":" "},{"text":"are lost.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Rows sharing an ID need no deletion anyway: writes already converge across"},{"type":"text","text":" "},{"text":"every matching row and reads already collapse to one value per ID (see","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","type":"reference"},{"type":"text","text":"), so duplicates cost storage and nothing else."}],"type":"paragraph"}]}],"topicSections":[{"identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)"],"generated":true,"title":"Type Methods","anchor":"Type-Methods"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"symbol","sections":[],"metadata":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityCollapse","kind":"identifier"}],"symbolKind":"enum","role":"symbol","modules":[{"name":"SwiduxPersistence"}],"externalID":"s:17SwiduxPersistence14EntityCollapseO","title":"EntityCollapse","navigatorTitle":[{"text":"EntityCollapse","kind":"identifier"}],"roleHeading":"Enumeration"},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse"},"abstract":[{"type":"text","text":"Ready-made collapse resolvers."}],"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse":{"title":"EntityCollapse","abstract":[{"type":"text","text":"Ready-made collapse resolvers."}],"navigatorTitle":[{"kind":"identifier","text":"EntityCollapse"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityCollapse"}],"type":"topic","url":"\/documentation\/swiduxpersistence\/entitycollapse","kind":"symbol","role":"symbol"},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"role":"collection","url":"\/documentation\/swiduxpersistence","abstract":[],"kind":"symbol","title":"SwiduxPersistence","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence","type":"topic"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistableModel":{"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"PersistableModel"}],"type":"topic","url":"\/documentation\/swiduxpersistence\/persistablemodel","title":"PersistableModel","abstract":[{"text":"The generated SwiftData ","type":"text"},{"code":"@Model","type":"codeVoice"},{"text":" shadow for a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableEntity","type":"reference"},{"text":".","type":"text"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","role":"symbol","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistableModel"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse/byID(preferring:)":{"kind":"symbol","url":"\/documentation\/swiduxpersistence\/entitycollapse\/byid(preferring:)","title":"byID(preferring:)","type":"topic","abstract":[{"text":"Collapses rows sharing an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" down to one, keeping the winner of","type":"text"},{"text":" ","type":"text"},{"code":"choose","type":"codeVoice"},{"text":". Rows with unique IDs pass through untouched.","type":"text"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)","role":"symbol","fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"byID","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"preferring","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":") -> ([","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":"]) -> [","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":"]","kind":"text"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"title":"EntityDB","abstract":[{"type":"text","text":"A generic "},{"type":"codeVoice","code":"@ModelActor"},{"type":"text","text":" that reads and writes any "},{"type":"reference","isActive":true,"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel"},{"type":"text","text":"."}],"navigatorTitle":[{"kind":"identifier","text":"EntityDB"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityDB"}],"type":"topic","url":"\/documentation\/swiduxpersistence\/entitydb","kind":"symbol","role":"symbol"}}}