xt":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"byID"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":">("},{"kind":"externalParam","text":"preferring"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> (["},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":"]) -> ["},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":"]"}],"abstract":[{"text":"Collapses rows sharing an ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" down to one, keeping the winner of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"choose"},{"text":". Rows with unique IDs pass through untouched.","type":"text"}],"kind":"symbol","type":"topic","role":"symbol","title":"byID(preferring:)","url":"\/documentation\/swiduxpersistence\/entitycollapse\/byid(preferring:)","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"abstract":[{"text":"A generic ","type":"text"},{"code":"@ModelActor","type":"codeVoice"},{"text":" that reads and writes any ","type":"text"},{"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","type":"reference","isActive":true},{"text":".","type":"text"}],"kind":"symbol","title":"EntityDB","navigatorTitle":[{"kind":"identifier","text":"EntityDB"}],"role":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","url":"\/documentation\/swiduxpersistence\/entitydb","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityDB"}],"type":"topic"}}}