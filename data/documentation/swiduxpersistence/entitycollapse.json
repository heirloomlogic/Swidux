ntation\/SwiduxPersistence\/EntityDB"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse":{"abstract":[{"type":"text","text":"Ready-made collapse resolvers."}],"kind":"symbol","title":"EntityCollapse","role":"symbol","navigatorTitle":[{"text":"EntityCollapse","kind":"identifier"}],"identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse","type":"topic","url":"\/documentation\/swiduxpersistence\/entitycollapse","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityCollapse","kind":"identifier"}]},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse/byID(preferring:)":{"title":"byID(preferring:)","url":"\/documentation\/swiduxpersistence\/entitycollapse\/byid(preferring:)","kind":"symbol","type":"topic","abstract":[{"text":"Collapses rows sharing an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" down to one, keeping the winner of","type":"text"},{"text":" ","type":"text"},{"code":"choose","type":"codeVoice"},{"text":". Rows with unique IDs pass through untouched.","type":"text"}],"fragments":[{"text":"static","kind":"keyword"},{"text":" ","kind":"text"},{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"byID","kind":"identifier"},{"text":"<","kind":"text"},{"text":"E","kind":"genericParameter"},{"text":">(","kind":"text"},{"text":"preferring","kind":"externalParam"},{"text":": (","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":") -> ","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":") -> ([","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":"]) -> [","kind":"text"},{"text":"E","kind":"typeIdentifier"},{"text":"]","kind":"text"}],"role":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)"}}}