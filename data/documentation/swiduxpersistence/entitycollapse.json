{"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"]]},"sections":[],"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/entitycollapse"]}],"metadata":{"symbolKind":"enum","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityCollapse","kind":"identifier"}],"title":"EntityCollapse","navigatorTitle":[{"kind":"identifier","text":"EntityCollapse"}],"externalID":"s:17SwiduxPersistence14EntityCollapseO","role":"symbol","roleHeading":"Enumeration","modules":[{"name":"SwiduxPersistence"}]},"abstract":[{"text":"Ready-made collapse resolvers.","type":"text"}],"topicSections":[{"identifiers":["doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)"],"generated":true,"title":"Type Methods","anchor":"Type-Methods"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityCollapse"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"Why-the-hook-takes-the-whole-collection","level":2,"text":"Why the hook takes the whole collection"},{"inlineContent":[{"type":"text","text":"A per-ID resolver would only handle half the problem. Rows sharing an "},{"code":"id","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"are one failure mode; the other is a "},{"inlineContent":[{"type":"text","text":"singleton"}],"type":"strong"},{"type":"text","text":" — an entity an app holds"},{"type":"text","text":" "},{"text":"exactly one of, such as a settings record. Created independently on two","type":"text"},{"type":"text","text":" "},{"text":"fresh installs, two singletons have ","type":"text"},{"inlineContent":[{"text":"different","type":"text"}],"type":"emphasis"},{"type":"text","text":" UUIDs, so nothing groups"},{"type":"text","text":" "},{"type":"text","text":"them and no ID-keyed resolver can ever see the conflict. A"},{"type":"text","text":" "},{"code":"([E]) -> [E]","type":"codeVoice"},{"type":"text","text":" hook covers both, plus general garbage collection, with one"},{"type":"text","text":" "},{"type":"text","text":"API."}],"type":"paragraph"},{"type":"heading","level":2,"text":"The determinism requirement","anchor":"The-determinism-requirement"},{"inlineContent":[{"text":"A resolver must be a pure function of ","type":"text"},{"inlineContent":[{"type":"text","text":"replicated content"}],"type":"strong"},{"text":" — never","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"persistentModelID"},{"text":", never a local timestamp, never array position. Every","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"device must compute the same survivor set from the same rows. A resolver"},{"type":"text","text":" "},{"type":"text","text":"that doesn’t reintroduces the mutual-tombstone loss the write path is"},{"type":"text","text":" "},{"type":"text","text":"designed to avoid: two devices pick different survivors, each tombstones the"},{"type":"text","text":" "},{"type":"text","text":"other’s, and after sync "},{"type":"emphasis","inlineContent":[{"text":"both","type":"text"}]},{"type":"text","text":" rows are gone."}],"type":"paragraph"},{"inlineContent":[{"text":"It must also be idempotent — ","type":"text"},{"type":"codeVoice","code":"collapse(collapse(rows))"},{"text":" must keep the same","type":"text"},{"text":" ","type":"text"},{"text":"IDs as ","type":"text"},{"type":"codeVoice","code":"collapse(rows)"},{"text":". This is checked with an ","type":"text"},{"type":"codeVoice","code":"assert"},{"text":" in debug builds.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Collapse removes IDs, not rows","anchor":"Collapse-removes-IDs-not-rows"},{"inlineContent":[{"text":"A resolver’s output is read as ","type":"text"},{"inlineContent":[{"type":"text","text":"the set of IDs that should exist and what"},{"type":"text","text":" "},{"type":"text","text":"each should contain"}],"type":"emphasis"},{"text":". An ID the resolver drops is deleted, including every","type":"text"},{"text":" ","type":"text"},{"text":"row carrying it. Several rows that share a ","type":"text"},{"inlineContent":[{"type":"text","text":"surviving"}],"type":"strong"},{"text":" ID are all updated","type":"text"},{"text":" ","type":"text"},{"text":"to the survivor’s value, and none of them is deleted.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"That asymmetry is deliberate, and it is the whole reason the singleton case","type":"text"},{"text":" ","type":"text"},{"text":"is the one this hook really solves. Deleting an ID is safe because ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"replicated: every device independently computes the same set of doomed IDs","type":"text"},{"text":" ","type":"text"},{"text":"and issues the same deletions. Deleting one of several rows that share an ID","type":"text"},{"text":" ","type":"text"},{"text":"is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"emphasis"},{"text":" safe — nothing replicated distinguishes them, so two devices can","type":"text"},{"text":" ","type":"text"},{"text":"pick different physical rows to keep, each tombstones the other’s, and both","type":"text"},{"text":" ","type":"text"},{"text":"are lost.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Rows sharing an ID need no deletion anyway: writes already converge across"},{"type":"text","text":" "},{"type":"text","text":"every matching row and reads already collapse to one value per ID (see"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","isActive":true},{"type":"text","text":"), so duplicates cost storage and nothing else."}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse"},"references":{"doc://SwiduxPersistence/documentation/SwiduxPersistence/PersistableModel":{"kind":"symbol","title":"PersistableModel","fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistableModel"}],"navigatorTitle":[{"kind":"identifier","text":"PersistableModel"}],"abstract":[{"type":"text","text":"The generated SwiftData "},{"code":"@Model","type":"codeVoice"},{"type":"text","text":" shadow for a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableEntity"},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/swiduxpersistence\/persistablemodel","role":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityDB":{"title":"EntityDB","abstract":[{"type":"text","text":"A generic "},{"code":"@ModelActor","type":"codeVoice"},{"type":"text","text":" that reads and writes any "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistableModel","isActive":true},{"text":".","type":"text"}],"fragments":[{"text":"actor","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"EntityDB"}],"type":"topic","navigatorTitle":[{"text":"EntityDB","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityDB","role":"symbol","url":"\/documentation\/swiduxpersistence\/entitydb"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse/byID(preferring:)":{"title":"byID(preferring:)","abstract":[{"text":"Collapses rows sharing an ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" down to one, keeping the winner of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"choose"},{"type":"text","text":". Rows with unique IDs pass through untouched."}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"byID"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"E"},{"kind":"text","text":">("},{"kind":"externalParam","text":"preferring"},{"kind":"text","text":": ("},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":") -> (["},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":"]) -> ["},{"kind":"typeIdentifier","text":"E"},{"kind":"text","text":"]"}],"type":"topic","kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse\/byID(preferring:)","role":"symbol","url":"\/documentation\/swiduxpersistence\/entitycollapse\/byid(preferring:)"},"doc://SwiduxPersistence/documentation/SwiduxPersistence/EntityCollapse":{"title":"EntityCollapse","abstract":[{"text":"Ready-made collapse resolvers.","type":"text"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"EntityCollapse","kind":"identifier"}],"type":"topic","navigatorTitle":[{"text":"EntityCollapse","kind":"identifier"}],"kind":"symbol","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/EntityCollapse","role":"symbol","url":"\/documentation\/swiduxpersistence\/entitycollapse"},"doc://SwiduxPersistence/documentation/SwiduxPersistence":{"kind":"symbol","title":"SwiduxPersistence","abstract":[],"type":"topic","url":"\/documentation\/swiduxpersistence","role":"collection","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence"}}}