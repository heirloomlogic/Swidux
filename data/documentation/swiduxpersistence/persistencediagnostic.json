{"abstract":[{"type":"text","text":"Something the persistence stack noticed that an app may want to act on, but"},{"type":"text","text":" "},{"type":"text","text":"which is "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" a failure."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/swiduxpersistence\/persistencediagnostic"]}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"PersistenceDiagnostic"}],"languages":["swift"],"platforms":["macOS"]}]},{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceFailure","isActive":true},{"type":"text","text":" is deliberately scoped to operations that failed."},{"type":"text","text":" "},{"type":"text","text":"Duplicate rows are not a failure — they are a legitimate on-disk state under"},{"type":"text","text":" "},{"type":"text","text":"CloudKit mirroring, which forbids unique constraints — and a probable"},{"type":"text","text":" "},{"type":"text","text":"dispatch loop is a bug in the app, not in a save. Both were previously"},{"type":"text","text":" "},{"type":"text","text":"visible only in Console. This is where they go instead."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Delivered to "},{"type":"reference","identifier":"doc:\/\/SwiduxPersistence\/documentation\/SwiduxPersistence\/PersistenceCoordinator","isActive":true},{"type":"text","text":"’s "},{"type":"codeVoice","code":"onDiagnostic"},{"type":"text","text":" handler, always"},{"type":"text","text":" "},{"type":"text","text":"after being logged."}]},{"type":"codeListing","syntax":"swift","code":["PersistenceCoordinator<AppState, AppAction>(","    entities: [.entity(\\.notes)],",